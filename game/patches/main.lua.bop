local FPS_CAP_VALUES = {30, 40, 60, 90, 120, 144, 165, 9999}
local function fps_cap_index(gr)
	if gr.fps_cap_v ~= 2 then
		if gr.fps_cap == 7 then gr.fps_cap = 8 end
		local r = gr._perf_mode_restore
		if type(r) == "table" and r.fps_cap == 7 then r.fps_cap = 8 end
		gr.fps_cap_v = 2
	end
	return gr.fps_cap
end
local frame_deadline = nil
local function pace_frame(cap)
	local target = 1 / cap
	local now = love.timer.getTime()
	if not frame_deadline or now - frame_deadline > target then
		frame_deadline = now + target
	else
		frame_deadline = frame_deadline + target
	end
	local left = frame_deadline - now
	if left > 0.002 then love.timer.sleep(left - 0.002) end
	while love.timer.getTime() < frame_deadline do end
end

local mobile_swap = {cap = nil, interval = 1, last = nil}
local function mobile_pace(cap)
	local vs = love.window.getVSync and love.window.getVSync() or 1
	if mobile_swap.cap ~= cap or vs ~= mobile_swap.interval then
		mobile_swap.cap = cap
		local interval = vs == 0 and 0 or 1
		local _, _, flags = love.window.getMode()
		local hz = flags and flags.refreshrate or 0
		if interval == 1 and hz > 0 and cap < 9999 then
			local n = hz / cap
			local r = math.floor(n + 0.5)
			if r >= 2 and math.abs(n - r) < 0.1 then interval = r end
		end
		if love.window.setVSync and interval ~= mobile_swap.interval then
			pcall(love.window.setVSync, interval)
			interval = love.window.getVSync and love.window.getVSync() or interval
		end
		mobile_swap.interval = interval
	end
	local now = love.timer.getTime()
	if cap < 9999 and mobile_swap.last then
		local left = mobile_swap.last + 1 / cap - 0.004 - now
		if left > 0.001 then love.timer.sleep(left) end
	end
	mobile_swap.last = love.timer.getTime()
end

