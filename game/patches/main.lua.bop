UI_SIZE_MIN = 0.8
UI_SIZE_OVER = 1.3
UI_SIZE_EDGE = 0.3
UI_SIZE_EDGE_W = 0.8

function ui_size_fit(w, h)
	local base
r 19 330 %09 -
l 71
		base = G.window_prev.orig_scale*w/G.window_prev.w
	else
		base = G.window_prev.orig_scale*h/G.window_prev.h
	end
	local uw, uh = w/(G.TILESIZE*base), h/(G.TILESIZE*base)
	return base, math.max(1, math.min(uw/(G.TILE_W + 2*UI_SIZE_EDGE_W), uh/(G.TILE_H + 2*UI_SIZE_EDGE)))
end

function ui_size_max(w, h)
	if not (G and G.window_prev) then return 1 end
	if not w then w, h = love.graphics.getDimensions() end
	local _, m = ui_size_fit(w, h)
	return math.floor(m*100)/100
end

function ui_size_wanted(w, h)
	local max = ui_size_max(w, h)
	local pct = G.SETTINGS and G.SETTINGS.GRAPHICS and tonumber(G.SETTINGS.GRAPHICS.ui_size)
	local s = pct and pct/100 or (_G._IS_DESKTOP and 1 or max)
	return math.min(max * UI_SIZE_OVER, math.max(UI_SIZE_MIN, s))
end

local WINDOW_FILL = {0, 0.75, 0.8, 0.85, 0.9, 0.95}

function window_fill()
	local i = G.SETTINGS and G.SETTINGS.GRAPHICS and G.SETTINGS.GRAPHICS.window_size
	if not WINDOW_FILL[i or 0] then i = _G._IS_DESKTOP == false and 6 or 4 end
	return WINDOW_FILL[i]
end

function menu_zoom_target(w, h)
	local o = G.OVERLAY_MENU
	local fill = window_fill()
	if not o and PORTRAIT and PORTRAIT.on() then return PORTRAIT.idle_zoom(w, h, ui_size_fit(w, h)) end
	local extra = G.UI_SIZE_EXTRA or 1
	if not o or (fill <= 0 and extra <= 1) then return 1 end
	local phone = _G._IS_DESKTOP == false
	local plain = fill <= 0 or (not phone and not (o.definition and o.definition.config and o.definition.config.uik_zoom))
	if plain and extra <= 1 then return 1 end
	local zr = PORTRAIT and PORTRAIT.read_check and PORTRAIT.read_check(o) or 0
	local t = o.T
	if t and t.w > G.TILE_W * 2 and o.UIRoot and o.UIRoot.children and o.UIRoot.children[1] then t = o.UIRoot.children[1].T end
	if o.infotip_node == nil and o.get_UIE_by_ID then o.infotip_node = o:get_UIE_by_ID('overlay_menu_infotip') or false end
	local tip = o.infotip_node and o.infotip_node.config.object
	if t and tip and tip.UIRoot and tip.T and tip.T.h > 0 then t = {w = math.max(t.w, tip.T.w), h = t.h + 2 * tip.T.h} end
	if PORTRAIT and PORTRAIT.on() then t = PORTRAIT.fit_target(t) end
	if not (t and t.w > 0 and t.h > 0) then return 1 end
	local base = ui_size_fit(w, h)
	local ui = G.UI_SIZE or 1
	local uw, uh = w / (G.TILESIZE * base), h / (G.TILESIZE * base)
	local z = math.min(0.95 * uw / (ui * t.w), 0.92 * uh / (ui * t.h))
	if plain then
		z = math.min(z, extra)
	else
		z = math.min(z, math.max(phone and 1.4 or 1.6, math.min(zr, PORTRAIT and PORTRAIT.READ_ZMAX or 1.6)) * extra, extra * uw * fill / t.w, extra * uh * math.min(fill, 0.92) / t.h)
	end
	if G.OVERLAY_TUTORIAL then z = math.min(z, 1) end
	return math.max(0.5, math.floor(z * 20) / 20)
end

function menu_zoom_update()
	if not (G and G.window_prev and G.UI_SIZE) then return end
	if G.CONTROLLER and G.CONTROLLER.dragging and G.CONTROLLER.dragging.target then return end
	local w, h = love.graphics.getDimensions()
	local z = menu_zoom_target(w, h)
	if math.abs(z - (G.MENU_ZOOM or 1)) > 0.01 then
		G.MENU_ZOOM = z
		love.resize(w, h)
	end
end

