[[patches]]
[patches.regex]
id = "auto.main.023"
requires = ["auto.game.093"]
target = "main.lua"
pattern = '''^(?<pre>[\t ]*function love\.quit\(\)\n)(?<post>)'''
position = "at"
payload = '''
${pre}	PERF_MON.shutdown()
	if G and G.send_saves and G.SAVE_MANAGER and G.SAVE_MANAGER.thread then
		if G.FILE_HANDLER and G.FILE_HANDLER.update_queued then G.FILE_HANDLER.force = true end
		pcall(G.send_saves, G)
		local t = G.SAVE_MANAGER.thread
		local ok, alive = pcall(t.isRunning, t)
		if ok and alive then
			G.SAVE_MANAGER.request_channel:push({type = 'kill'})
			local deadline = love.timer.getTime() + 5
			while love.timer.getTime() < deadline do
				local ok2, still = pcall(t.isRunning, t)
				if not (ok2 and still) then break end
				love.timer.sleep(0.01)
			end
		end
	end
	if MODLOADER and MODLOADER.clean_exit then pcall(MODLOADER.clean_exit) end
${post}'''
times = 1

