id = "auto.main.modded.005"
target = "main.lua"
pattern = '''^(?<pre>)(?<post>[\t ]*end\n[\t ]*\n[\t ]*if PORTRAIT and G\.ROOM then PORTRAIT\.after_resize\(_portrait_changed\) end\n[\t ]*if HUD_SCALE and G\.ROOM then HUD_SCALE\.check\(\) end\n[\t ]*G\.SHADER_CANVAS_A = SMODS\.create_canvas\(\)\n)'''
