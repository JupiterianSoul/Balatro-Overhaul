	G.CANV_SCALE = (_res == 2 and 0.75) or (_res == 3 and 0.5) or 1

	local _cw, _ch = math.floor(w*G.CANV_SCALE), math.floor(h*G.CANV_SCALE)
	if not (G.CANVAS and G.CANVAS:getWidth() == _cw and G.CANVAS:getHeight() == _ch) then
r 12 386 %09%09 -
r 12 387 %09%09 -
l 105
	end

	if PORTRAIT and G.ROOM then PORTRAIT.after_resize(_portrait_changed) end
	if HUD_SCALE and G.ROOM then HUD_SCALE.check() end
${post}'''
times = 1

[[patches]]
[patches.regex]
id = "auto.main.modded.001"
target = "main.lua"
pattern = '''^(?<pre>)[\t ]*if V and V\(MODDED_VERSION or '0\.0\.0'\) ~= V\(RELEASE_VERSION or '0\.0\.0'\) then\n[\t ]*table\.insert\(err, '\\n\\nDevelopment version of Steamodded detected! If you are not actively developing a mod, please try using the latest release instead\.\\n\\n'\)\n[\t ]*end\n(?<post>)'''
position = "at"
payload = '''
${pre}${post}'''
optional = true

