		end
	end

	local _mp_pm_t0 = PERF_MON.enabled and love.timer.getTime()
	local _mp_ok, _mp_err = xpcall(MP.update, debug.traceback, dt)
	if _mp_pm_t0 then PERF_MON.add_sub("MP", (love.timer.getTime() - _mp_pm_t0) * 1000) end
	if not _mp_ok then
