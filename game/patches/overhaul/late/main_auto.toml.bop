${pre}${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.main.modded.003"
requires = ["auto.main.modded.002"]
target = "main.lua"
pattern = '''^(?<pre>)(?<post>[\t ]*if \(jit\.arch == 'arm64' or jit\.arch == 'arm'\) then\n[\t ]*jit\.off\(\)\n)'''
position = "at"
payload = '''
${pre}if SMODS and SMODS.preflight_force_quit then if SMODS.preflight_quit_before then SMODS.preflight_quit_before() end return end
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.main.modded.004"
requires = ["auto.main.001"]
target = "main.lua"
pattern = '''^(?<pre>)[\t ]*--Steam integration\n[\t ]*local os = love\.system\.getOS\(\)\n[\t ]*if os == 'Android' or os == 'iOS' then love\.window\.updateMode\(2, 1\) end\n[\t ]*if os == 'OS X' or os == 'Windows' or os == 'Linux' then\n[\t ]*local st = nil\n[\t ]*--To control when steam communication happens, make sure to send updates to steam as little as possible\n[\t ]*local cwd = SMODS\.NFS\.getWorkingDirectory\(\)\n[\t ]*SMODS\.NFS\.setWorkingDirectory\(love\.filesystem\.getSourceBaseDirectory\(\)\)\n[\t ]*if os == 'OS X' or os == 'Linux' then\n[\t ]*local dir = love\.filesystem\.getSourceBaseDirectory\(\)\n[\t ]*local old_cpath = package\.cpath\n[\t ]*package\.cpath = package\.cpath \.\. ';' \.\. dir \.\. '/\?\.so'\n[\t ]*local success, _st = pcall\(require, 'luasteam'\)\n[\t ]*if success then st = _st else sendWarnMessage\(_st, "LuaSteam"\); st = \{\} end\n[\t ]*package\.cpath = old_cpath\n[\t ]*else\n[\t ]*local success, _st = pcall\(require, 'luasteam'\)\n[\t ]*if success then st = _st else sendWarnMessage\(_st, "LuaSteam"\); st = \{\} end\n[\t ]*end\n[\t ]*\n[\t ]*st\.send_control = \{\n[\t ]*last_sent_time = -200,\n[\t ]*last_sent_stage = -1,\n[\t ]*force = false,\n[\t ]*\}\n[\t ]*if not \(st\.init and st:init\(\)\) then\n[\t ]*st = nil\n[\t ]*end\n[\t ]*SMODS\.NFS\.setWorkingDirectory\(cwd\)\n[\t ]*--Set up the render window and the stage for the splash screen, then enter the gameloop with :update\n[\t ]*G\.STEAM = st\n[\t ]*else\n[\t ]*end\n[\t ]*\n[\t ]*--Set the mouse to invisible immediately, this visibility is handled in the G\.CONTROLLER\n[\t ]*love\.mouse\.setVisible\(false\)\n(?<post>)'''
position = "at"
payload = '''
${pre}	--Set the mouse to invisible immediately, this visibility is handled in the G.CONTROLLER
	if love.mouse then love.mouse.setVisible(false) end
	MP.init()
	if Extras and Extras.init then pcall(Extras.init) end
	if Controls and Controls.init then pcall(Controls.init) end
	if QOL and QOL.init then pcall(QOL.init) end

	if DeckCreatorHooks and DeckCreatorHooks.init then
		pcall(DeckCreatorHooks.init)
	end

${post}'''
optional = true

[[patches]]
