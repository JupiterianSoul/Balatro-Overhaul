[patches.regex]
id = "auto.main.modded.002"
target = "main.lua"
pattern = '''^(?<pre>)[\t ]*if SMODS and SMODS\.preflight_force_quit then if SMODS\.preflight_quit_before then SMODS\.preflight_quit_before\(\) end return end\n(?<post>)'''
position = "at"
