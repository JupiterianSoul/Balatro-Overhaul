[[patches]]
[patches.regex]
id = "auto.main.001"
target = "main.lua"
pattern = '''^(?<pre>)(?<post>[\t ]*if \(love\.system\.getOS\(\) == 'OS X' \) and \(jit\.arch == 'arm64' or jit\.arch == 'arm'\) then jit\.off\(\) end\n)'''
position = "at"
payload = '''
${pre}require "functions/release_flags";
pcall(require, "functions/linux_env")
local MP = require("multiplayer.init")
${post}'''
times = 1

[[patches]]
[patches.regex]
id = "auto.main.002"
target = "main.lua"
pattern = '''^(?<pre>)(?<post>[\t ]*(?:\([A-Za-z_][A-Za-z0-9_.]* or )?require\)?\(? ?"engine/object"\)?;?\n)'''
position = "at"
payload = '''
${pre}if (jit.arch == 'arm64' or jit.arch == 'arm') then
	jit.off()
else
	jit.opt.start("maxtrace=8000", "maxrecord=16000", "maxmcode=65536", "sizemcode=256", "maxside=400", "maxsnap=1000")
end

if not love.platform then
    love.platform = {
        earlyInit = function() end,
        hideSplashScreen = function() end,
        isArcade = function() return false end,
        isPremium = function() return true end,
        isOffline = function() return false end,
        anyButtonPressed = function() return false end,
        isFirstTimePlaying = function() return false end,
        getLocalPlayerName = function() return "" end,
        getLocalPlayerAvatar = function() return nil end,
        getPlatformId = function() return "" end,
        getNotchPosition = function() return 0 end,
        setProfileButtonActive = function() end,
        requestTrackingPermission = function() end,
        requestReview = function() end,
        authenticateLocalPlayer = function() end,
        setOnSaveInitializedCallback = function(cb) if cb then cb() end end,
        setOnPlatformStatusChangedCallback = function() end,
        setLoadGameCallback = function() end,
        resolveConflict = function() end,
        loadGameFile = function() end,
        unlockAchievement = function() end,
        unlockAward = function() end,
        init = function(success_cb) if success_cb then success_cb("", "") end return true end,
        update = function() end,
        shutdown = function() end,
        event = function() end,
    }
end

_G._IS_DESKTOP = (love.system.getOS() == 'Windows' or love.system.getOS() == 'OS X' or love.system.getOS() == 'Linux');
${post}'''
times = 1

