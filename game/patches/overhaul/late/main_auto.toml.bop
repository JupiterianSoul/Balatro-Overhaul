	if G.UI_SIZE_PENDING and not (G.CONTROLLER and G.CONTROLLER.dragging.target) and not love.mouse.isDown(1) then
		G.UI_SIZE_PENDING = nil
		if G.UI_SIZE_EDIT and G.SETTINGS and G.SETTINGS.GRAPHICS then
			G.SETTINGS.GRAPHICS[display_key('ui_size')] = math.floor(G.UI_SIZE_EDIT.value + 0.5)
			love.resize(love.graphics.getDimensions())
			G:save_settings()
		end
	end

	if AchievementManager and AchievementManager.update then
		AchievementManager.update(dt)
	end

	pcall(misc_update, dt)
	PERF_MON.checkpoint("misc", "update")

	_subsystem_frame = (_subsystem_frame or 0) + 1


	if OPTIMIZER and OPTIMIZER.update then
		local _pm_t0 = PERF_MON.enabled and love.timer.getTime()
		pcall(OPTIMIZER.update, dt)
		if _pm_t0 then PERF_MON.add_sub("OPTIMIZER", (love.timer.getTime() - _pm_t0) * 1000) end
	end

	if JIMBO_COMMENTS and (_subsystem_frame % 3 == 0) then
		local _pm_t0 = PERF_MON.enabled and love.timer.getTime()
		pcall(JIMBO_COMMENTS.update, dt * 3)
		if _pm_t0 then PERF_MON.add_sub("JIMBO_COMMENTS", (love.timer.getTime() - _pm_t0) * 1000) end
