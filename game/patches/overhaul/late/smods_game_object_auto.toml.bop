[[patches]]
[patches.regex]
id = "auto.smods_game_object.012"
requires = ["auto.smods_game_object.004"]
target = '=[SMODS _ "src/game_object.lua"]'
pattern = '''^(?<pre>)(?<post>[\t ]*pre_inject_class = function\(self\)\n[\t ]*G:set_render_settings\(\) -- restore originals first in case a texture pack was disabled\n)'''
position = "at"
payload = '''
${pre}        inject_class = function(self)
            local list = {}
            for _, key in ipairs(self.obj_buffer) do
                local o = self.obj_table[key]
                if o then list[#list + 1] = o end
            end
            pcall(atlas_prefetch_start, list)
            SMODS.GameObject.inject_class(self)
            atlas_prefetch_stop()
        end,
${post}'''
times = 1

[[patches]]
[patches.regex]
id = "auto.smods_game_object.013"
target = '=[SMODS _ "src/game_object.lua"]'
pattern = '''^(?<pre>)(?<post>[\t ]*-- until stakes_fixed\n)'''
position = "at"
payload = '''
${pre}            local overhaul_stake_orders = {}
            for _, stake in ipairs(G.P_CENTER_POOLS[self.set]) do overhaul_stake_orders[stake] = stake.order end
${post}'''
times = 1

[[patches]]
[patches.regex]
id = "auto.smods_game_object.014"
requires = ["auto.smods_game_object.013"]
target = '=[SMODS _ "src/game_object.lua"]'
pattern = '''^(?<pre>)(?<post>[\t ]*table\.sort\(G\.P_CENTER_POOLS\[self\.set\], function\(a, b\) return a\.order < b\.order end\)\n)'''
position = "at"
payload = '''
${pre}            local overhaul_stake_broken = false
            for _, stake in ipairs(G.P_CENTER_POOLS[self.set]) do
                for _, key in pairs(stake.applied_stakes or {}) do
                    local below = G.P_STAKES[key]
                    if below and below ~= stake and below.order >= stake.order then overhaul_stake_broken = true end
                end
            end
            if overhaul_stake_broken then
                for stake, order in pairs(overhaul_stake_orders or {}) do stake.order = order end
            end
${post}'''
times = 1

