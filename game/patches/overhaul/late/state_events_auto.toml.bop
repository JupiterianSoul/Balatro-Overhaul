[[patches]]
[patches.regex]
id = "auto.state_events.modded.005"
target = "functions/state_events.lua"
pattern = '''^(?<pre>[\t ]*-- TARGET: setting_blind effects\n)(?<post>)'''
position = "at"
payload = '''
${pre}            pcall(function()
                if G.GAME.modifiers and G.GAME.modifiers.random_joker_disable and #G.jokers.cards > 0 then
                    for _, card in ipairs(G.jokers.cards) do
                        if card.ability and card.ability.oblivion_debuffed then
                            card.ability.oblivion_debuffed = nil
                            card.debuff = false
                        end
                    end
                    local random_idx = math.ceil(pseudorandom(pseudoseed('oblivion')) * #G.jokers.cards)
                    local target = G.jokers.cards[random_idx]
                    if target and not target.ability.eternal then
                        target.debuff = true
                        target.ability.oblivion_debuffed = true
                        target:juice_up(0.3, 0.5)
                    end
                end
            end)
${post}'''
optional = true

