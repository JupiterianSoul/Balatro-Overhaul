[[patches]]
[patches.regex]
id = "auto.state_events.modded.002"
requires = ["auto.state_events.006"]
target = "functions/state_events.lua"
pattern = '''^(?<pre>)[\t ]*if not G\.GAME\.won and (?:to_[a-z_]+\()?G\.GAME\.round_resets\.ante\)? >= G\.GAME\.win_ante and G\.GAME\.blind_on_deck == 'Boss' then\n[\t ]*game_won = true\n[\t ]*G\.GAME\.won = true\n(?<post>)'''
position = "at"
payload = '''
${pre}            local win_ante = G.GAME.win_ante
            if is_creative_stake and is_creative_stake() then
                win_ante = get_creative_win_ante and get_creative_win_ante() or 10
            elseif is_insanity_stake and is_insanity_stake() then
                win_ante = get_insanity_win_ante and get_insanity_win_ante() or 10
            end
            if _is_mp then
                pcall(function()
                    if bom_match and bom_match.final_ante then win_ante = bom_match.final_ante() end
                end)
            end
            if _is_mp or win_ante ~= G.GAME.win_ante or G.GAME.mp_blind_loss_pending or G.GAME.mp_round_lost then
                if not G.GAME.won and G.GAME.round_resets.ante >= win_ante and G.GAME.blind_on_deck == 'Boss' and not G.GAME.mp_blind_loss_pending and not G.GAME.mp_round_lost then
                    game_won = true
                    G.GAME.won = true
                end
            else
r 15 111 %20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20 -
l 136
                    game_won = true
                    G.GAME.won = true
                end
            end

            if game_won and _is_mp then
                pcall(function()
                    if bom_match and bom_match.server_decides_final and bom_match.server_decides_final() then
                        game_won = false
                        G.GAME.won = false
                    end
                end)
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.state_events.modded.003"
target = "functions/state_events.lua"
pattern = '''^(?<pre>)[\t ]*delay\(0\.4\); SMODS\.ante_end = true; ease_ante\(1\); SMODS\.ante_end = nil; delay\(0\.4\); check_for_unlock\(\{type = 'ante_up', ante = (?:to_[a-z_]+\()?G\.GAME\.round_resets\.ante\)? \+ 1\}\)\n(?<post>)'''
position = "at"
