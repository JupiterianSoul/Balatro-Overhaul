${pre}                    delay(0.4); SMODS.ante_end = true; ease_ante(1); SMODS.ante_end = nil; delay(0.4);
                    if not G.GAME.mp_blind_loss_pending then
                        check_for_unlock({type = 'ante_up', ante = G.GAME.round_resets.ante + 1})
                        if progression_on_ante_cleared then
                            progression_on_ante_cleared()
                        end
                    end
${post}'''
optional = true

