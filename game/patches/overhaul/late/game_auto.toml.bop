end
${post}'''
times = 1

[[patches]]
[patches.regex]
id = "auto.game.modded.001"
target = "game.lua"
pattern = '''^(?<pre>)[\t ]*local shader = "resources/shaders/"\.\.filename\n[\t ]*local lovely = require "lovely"\n[\t ]*shader = assert\(lovely\.apply_patches\(filename, love\.filesystem\.read\(shader\)\)\)\n[\t ]*self\.SHADERS\[shader_name\] = love\.graphics\.newShader\(shader\)\n(?<post>)'''
position = "at"
payload = '''
${pre}            local ok, err = pcall(function()
                local shader = "resources/shaders/"..filename
                local lovely = require "lovely"
                shader = assert(lovely.apply_patches(filename, love.filesystem.read(shader)))
                self.SHADERS[shader_name] = love.graphics.newShader(shader)
            end)
            if not ok and shader_name == 'CRT' then
                self.SHADERS[shader_name] = nil
                self.SHADER_ERRORS = self.SHADER_ERRORS or {}
                self.SHADER_ERRORS[shader_name] = tostring(err)
                print("CRT shader failed, the screen effect is off: "..tostring(err))
            elseif not ok then
                error(err, 0)
            end
${post}'''
optional = true

