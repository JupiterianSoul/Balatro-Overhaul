[[patches]]
[patches.regex]
id = "auto.game.035"
target = "game.lua"
pattern = '''^(?<pre>)(?<post>[\t ]*\n[\t ]*function Game:load_profile\(_profile\)\n)'''
position = "at"
payload = '''
${pre}local function saved_big_to_number(v)
    if rawget(_G, 'Big') and type(rawget(_G, 'to_big')) == 'function' and type(v.array) == 'table' then
        local ok, b = pcall(to_big, v.array, v.sign == -1 and -1 or 1)
        if ok and b ~= nil then return b end
    end
    if type(v.val) == 'number' then return v.val end
    local sign = v.sign == -1 and -1 or 1
    if type(v.array) == 'table' and #v.array <= 1 then return sign * (tonumber(v.array[1]) or 0) end
    return sign * math.huge
end

local function plain_saved_numbers(t, seen)
    seen = seen or {}
    if seen[t] then return end
    seen[t] = true
r 13 131 %20%20%20%20 -
r 31 2162 %20%20%20%20%20%20%20%20 -
l 128
            if getmetatable(v) == nil and (v.__talisman or (type(v.array) == 'table' and v.sign ~= nil)) then
                t[k] = saved_big_to_number(v)
            else
                plain_saved_numbers(v, seen)
            end
        end
    end
end

function Game:plain_saved_numbers(t)
    if type(t) == 'table' then plain_saved_numbers(t) end
    return t
end

local AREA_BASE = {hand = 'hand_size', jokers = 'joker_slots', consumeables = 'consumable_slots'}

local function negative_slots(area)
    local n = 0
    for _, c in ipairs(type(area.cards) == 'table' and area.cards or {}) do
        local a = type(c) == 'table' and c.ability
        local e = type(c) == 'table' and c.edition
        if type(a) == 'table' and a.card_limit ~= nil then
            n = n + (tonumber(a.card_limit) or 0) - (tonumber(a.extra_slots_used) or 0)
        elseif type(e) == 'table' and (e.negative or e.type == 'negative') then
            n = n + 1
        end
    end
    return n
end

local function fit_card_limit(area, k, smods, sp)
    local cfg = area.config
    if type(cfg) ~= 'table' then return false end
    local limits = rawget(cfg, 'card_limits')
    local raw = rawget(cfg, 'card_limit')
    if smods then
        if raw ~= nil or type(limits) ~= 'table' then
            local n = tonumber(raw) or 0
            local handled = (cfg.type == 'joker' or cfg.type == 'hand') and not cfg.fixed_limit
            local extra = handled and negative_slots(area) or 0
            local base = n - extra
            local start = AREA_BASE[k] and type(sp) == 'table' and tonumber(sp[AREA_BASE[k]])
            if start then base = start end
            rawset(cfg, 'card_limits', {base = base, mod = n - extra - base, extra_slots = extra, extra_slots_used = 0, total_slots = n, old_slots = n})
            rawset(cfg, 'card_limit', nil)
            return true
        end
    elseif raw == nil and type(limits) == 'table' then
        local total = tonumber(limits.total_slots) or ((tonumber(limits.base) or 0) + (tonumber(limits.mod) or 0) + (tonumber(limits.extra_slots) or 0))
        rawset(cfg, 'card_limit', total - (tonumber(limits.extra_slots_used) or 0))
        rawset(cfg, 'card_limits', nil)
    end
    return false
end

local function fill_missing(t, defaults)
    if type(t) ~= 'table' or type(defaults) ~= 'table' then return end
    for k, v in pairs(defaults) do
        if t[k] == nil then t[k] = type(v) == 'table' and copy_table(v) or v end
    end
end

local function count_saved(area, key)
    local n = 0
    for _, c in ipairs(type(area) == 'table' and type(area.cards) == 'table' and area.cards or {}) do
        local f = type(c) == 'table' and c.save_fields
        if f and f.center == key then n = n + 1 end
    end
    return n
end

local function fit_card_ability(c)
    local a, e = c.ability, c.edition
    if type(a) ~= 'table' then return end
    if type(e) == 'table' and e.type and not e.key then e.key = 'e_'..tostring(e.type) end
    if a.card_limit == nil then
        local n = 0
        if type(e) == 'table' and (e.negative or e.type == 'negative') then
            e.card_limit = e.card_limit or 1
            n = e.card_limit
        end
        a.card_limit = n
    end
    if a.extra_slots_used == nil then a.extra_slots_used = 0 end
end

local SMODS_SAVED_ABILITY_ZERO = {
    'perma_x_chips', 'perma_mult', 'perma_x_mult', 'perma_h_chips', 'perma_h_x_chips', 'perma_h_mult', 'perma_h_x_mult',
    'perma_p_dollars', 'perma_h_dollars', 'perma_repetitions', 'perma_score', 'perma_h_score',
    'perma_x_score', 'perma_h_x_score', 'perma_blind_size', 'perma_h_blind_size', 'perma_x_blind_size', 'perma_h_x_blind_size',
}

local function fit_saved_cards(area, k, smods)
    if type(area) ~= 'table' or type(area.cards) ~= 'table' then return end
    local kept = {}
    for _, c in ipairs(area.cards) do
        if smods and type(c) == 'table' and type(c.ability) == 'table' then
            for _, f in ipairs(SMODS_SAVED_ABILITY_ZERO) do
                if c.ability[f] == nil then c.ability[f] = 0 end
            end
        end
        local f = type(c) == 'table' and c.save_fields
        local center = f and f.center
        local playing = f and f.card ~= nil
        if f and playing and not G.P_CARDS[f.card] then
            print('[LOAD] left out a playing card from a mod that is off: '..tostring(f.card))
        elseif f and not G.P_CENTERS[center] then
            if playing then
                f.center = 'c_base'
                if type(c.ability) == 'table' then c.ability.set = 'Default'; c.ability.name = 'Default Base'; c.ability.effect = nil end
                kept[#kept + 1] = c
                print('[LOAD] '..tostring(center)..' is not loaded, card kept as a plain card')
            else
                print('[LOAD] left out '..tostring(center)..' from '..tostring(k)..': its mod is not loaded')
            end
        elseif f then
            kept[#kept + 1] = c
        end
    end
    if smods then
        for _, c in ipairs(kept) do fit_card_ability(c) end
    end
    area.cards = kept
end

local function fallback_boss(ante, win_ante)
    local showdown = ante >= 2 and ante % math.max(win_ante or 8, 1) == 0
    local keys = {}
r 2 703 %20%20%20%20 -
l 47
        if type(v) == 'table' and v.boss and not v.mod and not v.blind_types and v.in_pool == nil and not v.no_collection and (not v.boss.showdown) == (not showdown) and (v.boss.min or 1) <= math.max(ante, 1) then keys[#keys + 1] = k end
    end
    table.sort(keys)
    if #keys == 0 then return 'bl_hook' end
    return keys[math.random(#keys)]
end

function Game:fit_save_to_mods(t)
    if type(t) ~= 'table' then return t end
    local smods_t = rawget(_G, 'SMODS')
    local smods = smods_t ~= nil
    local sp = type(t.GAME) == 'table' and t.GAME.starting_params
    local from_plain = false
    if type(t.cardAreas) == 'table' then
        for k, area in pairs(t.cardAreas) do
            if type(area) == 'table' then
                fit_saved_cards(area, k, smods)
                if fit_card_limit(area, k, smods, sp) then from_plain = true end
            end
        end
    end
    if smods and from_plain and type(t.GAME) == 'table' then
        local g = t.GAME
        local rr = g.round_resets
        if type(rr) == 'table' and rr.free_rerolls == nil then
            rr.free_rerolls = count_saved(type(t.cardAreas) == 'table' and t.cardAreas.jokers, 'j_chaos')
        end
        local ok, fresh = pcall(self.init_game_object, self)
        if ok and type(fresh) == 'table' then
            if type(rr) == 'table' and rr.ante_disp == nil and type(fresh.round_resets) == 'table' and fresh.round_resets.ante_disp ~= nil then
                rr.ante_disp = number_format and number_format(tonumber(rr.ante) or 1) or tostring(rr.ante)
            end
            fill_missing(g, fresh)
            fill_missing(rr, fresh.round_resets)
            fill_missing(g.starting_params, fresh.starting_params)
            if type(g.hands) == 'table' and type(fresh.hands) == 'table' then
                for name, h in pairs(g.hands) do fill_missing(h, fresh.hands[name]) end
            end
        end
    elseif not smods and type(t.GAME) == 'table' and type(t.GAME.bosses_used) == 'table' then
        local bu = t.GAME.bosses_used
        if type(bu.boss) == 'table' then
            local flat = {}
            for k, v in pairs(bu.boss) do flat[k] = tonumber(v) or 0 end
            t.GAME.bosses_used = flat
            bu = flat
        end
r 2 703 %20%20%20%20%20%20%20%20 -
l 115
            if type(v) == 'table' and v.boss and tonumber(bu[k]) == nil then bu[k] = 0 end
        end
    end
    if smods then
        local calcs = rawget(smods_t, 'Scoring_Calculations')
        local sc = t.SCORING_CALC
        if type(calcs) == 'table' and not (type(sc) == 'table' and sc.key and calcs[sc.key]) then
            t.SCORING_CALC = {key = 'multiply', config = {}}
        end
    end
    local game = t.GAME
    if type(game) ~= 'table' then return t end
    if smods then
        local ok, fresh = pcall(self.init_game_object, self)
        if ok and type(fresh) == 'table' then
            for k, v in pairs(fresh) do
                if game[k] == nil and type(v) == 'table' then
                    game[k] = v
                    print('[LOAD] '..tostring(k)..' was missing from the save (mod turned on after it), filled with a new one')
                end
            end
            if type(fresh.hands) == 'table' and type(game.hands) == 'table' then
                for k, v in pairs(fresh.hands) do
                    if game.hands[k] == nil then game.hands[k] = v end
                end
            end
        end
    end
    sp = game.starting_params
    if smods and type(sp) == 'table' then
        sp.play_limit = sp.play_limit or 5
        sp.discard_limit = sp.discard_limit or 5
    end
    local rr = game.round_resets
    local bc = type(rr) == 'table' and rr.blind_choices
    if type(bc) == 'table' then
        if bc.Small and not G.P_BLINDS[bc.Small] then bc.Small = 'bl_small' end
        if bc.Big and not G.P_BLINDS[bc.Big] then bc.Big = 'bl_big' end
        if bc.Boss and not G.P_BLINDS[bc.Boss] then
            local ante = tonumber(rr.ante) or 1
            bc.Boss = fallback_boss(ante, tonumber(game.win_ante))
        end
    end
    local bt = type(rr) == 'table' and rr.blind_tags
    if type(bt) == 'table' and G.P_TAGS then
        for k, v in pairs(bt) do
            if type(v) == 'string' and not G.P_TAGS[v] then bt[k] = 'tag_uncommon' end
        end
    end
    if type(t.tags) == 'table' and G.P_TAGS then
        for i = #t.tags, 1, -1 do
            local v = t.tags[i]
            if type(v) ~= 'table' or not G.P_TAGS[v.key] then table.remove(t.tags, i) end
        end
    end
    return t
end
