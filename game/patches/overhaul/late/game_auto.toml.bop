    local quest_ok = pcall(function()
        if QuestManager and type(QuestManager) == "table" then
            if QuestManager.init and type(QuestManager.init) == "function" then
                local init_result = QuestManager.init()
                print("[START_RUN] QuestManager.init result: " .. tostring(init_result))
            end
            if QuestManager.reset_run_stats and type(QuestManager.reset_run_stats) == "function" then
                QuestManager.reset_run_stats()
                print("[START_RUN] QuestManager.reset_run_stats completed")
            end
        else
            print("[START_RUN] QuestManager not available, skipping")
        end
    end)

    if not quest_ok then
        print("[START_RUN] WARNING: Quest initialization had issues, but continuing...")
    end
${post}'''
