${pre}        {card_limit = self.GAME.starting_params.hand_size, type = 'hand', negative_info = 'playing_card', sort = (G.SETTINGS.default_hand_sort == 2) and 'suit desc' or 'desc'})
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.game.modded.017"
target = "game.lua"
pattern = '''^(?<pre>)(?<post>[\t ]*local ai = 1\n[\t ]*local av = anims\[1\]\n[\t ]*while av ~= nil do\n[\t ]*av:animate\(anim_dt\)\n[\t ]*ai = ai \+ 1\n[\t ]*av = anims\[ai\]\n[\t ]*end\n[\t ]*timer_checkpoint\('animate', 'update'\)\n[\t ]*\n[\t ]*--move and update all other moveables\n[\t ]*G\.exp_times\.xy = math\.exp\(-50\*self\.real_dt\)\n[\t ]*G\.exp_times\.scale = math\.exp\(-60\*self\.real_dt\)\n[\t ]*G\.exp_times\.r = math\.exp\(-190\*self\.real_dt\)\n[\t ]*\n[\t ]*local move_dt = math\.min\(1/20, self\.real_dt\)\n[\t ]*\n[\t ]*G\.exp_times\.max_vel = 70\*move_dt\n[\t ]*\n[\t ]*local moveables = self\.MOVEABLES\n[\t ]*local frame_move = G\.FRAMES\.MOVE\n[\t ]*local mi = 1\n[\t ]*local mv = moveables\[1\]\n[\t ]*while mv ~= nil do\n[\t ]*if mv\.FRAME and mv\.FRAME\.MOVE < frame_move then mv:move\(move_dt\) end\n[\t ]*mi = mi \+ 1\n[\t ]*mv = moveables\[mi\]\n[\t ]*end\n[\t ]*timer_checkpoint\('move', 'update'\)\n[\t ]*\n[\t ]*for k, v in pairs\(self\.MOVEABLES\) do\n)'''
position = "at"
payload = '''
${pre}        do
        end
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.game.modded.018"
requires = ["auto.game.090"]
target = "game.lua"
pattern = '''^(?<pre>)[\t ]*for k, v in pairs\(self\.MOVEABLES\) do\n[\t ]*v:update\(dt\*self\.SPEEDFACTOR, self\.real_dt\)\n[\t ]*v\.states\.collide\.is = false\n(?<post>)'''
position = "at"
payload = '''
${pre}        local upd_dt = dt*self.SPEEDFACTOR
        mi = 1
        mv = moveables[1]
        while mv ~= nil do
            mv:update(upd_dt, self.real_dt)
            mv.states.collide.is = false
            mi = mi + 1
            mv = moveables[mi]
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.game.modded.019"
target = "game.lua"
