[[patches]]
[patches.regex]
id = "auto.game.017"
target = "game.lua"
pattern = '''^(?<pre>)[\t ]*self\.j_locked = \{unlocked = false, max = 1, name = "Locked", pos = \{x=8,y=9\}, set = "Joker", cost_mult = 1\.0,config = \{\}\}\n[\t ]*self\.v_locked = \{unlocked = false, max = 1, name = "Locked", pos = \{x=8,y=3\}, set = "Voucher", cost_mult = 1\.0,config = \{\}\}\n[\t ]*self\.c_locked = \{unlocked = false, max = 1, name = "Locked", pos = \{x=4,y=2\}, set = "Tarot", cost_mult = 1\.0,config = \{\}\}\n[\t ]*self\.j_undiscovered = \{unlocked = false, max = 1, name = "Locked", pos = \{x=9,y=9\}, set = "Joker", cost_mult = 1\.0,config = \{\}\}\n[\t ]*self\.t_undiscovered = \{unlocked = false, max = 1, name = "Locked", pos = \{x=6,y=2\}, set = "Tarot", cost_mult = 1\.0,config = \{\}\}\n[\t ]*self\.p_undiscovered = \{unlocked = false, max = 1, name = "Locked", pos = \{x=7,y=2\}, set = "Planet", cost_mult = 1\.0,config = \{\}\}\n[\t ]*self\.s_undiscovered = \{unlocked = false, max = 1, name = "Locked", pos = \{x=5,y=2\}, set = "Spectral", cost_mult = 1\.0,config = \{\}\}\n[\t ]*self\.v_undiscovered = \{unlocked = false, max = 1, name = "Locked", pos = \{x=8,y=2\}, set = "Voucher", cost_mult = 1\.0,config = \{\}\}\n[\t ]*self\.booster_undiscovered = \{unlocked = false, max = 1, name = "Locked", pos = \{x=0,y=5\}, set = "Booster", cost_mult = 1\.0,config = \{\}\}\n[\t ]*\n[\t ]*self\.P_CENTERS = \{\n[\t ]*c_base=\{max = 500, freq = 1, line = 'base', name = "Default Base", pos = \{x=1,y=0\}, set = "Default", label = 'Base Card', effect = "Base", cost_mult = 1\.0, config = \{\}\},\n(?<post>)'''
position = "at"
payload = '''
${pre}    self.j_locked = self.j_locked or {unlocked = true, max = 1, name = "Locked", pos = {x=8,y=9}, set = "Joker", cost_mult = 1.0,config = {}}
    self.v_locked = self.v_locked or {unlocked = true, max = 1, name = "Locked", pos = {x=8,y=3}, set = "Voucher", cost_mult = 1.0,config = {}}
    self.c_locked = self.c_locked or {unlocked = true, max = 1, name = "Locked", pos = {x=4,y=2}, set = "Tarot", cost_mult = 1.0,config = {}}
    self.j_undiscovered = self.j_undiscovered or {unlocked = true, max = 1, name = "Locked", pos = {x=9,y=9}, set = "Joker", cost_mult = 1.0,config = {}}
    self.t_undiscovered = self.t_undiscovered or {unlocked = true, max = 1, name = "Locked", pos = {x=6,y=2}, set = "Tarot", cost_mult = 1.0,config = {}}
    self.p_undiscovered = self.p_undiscovered or {unlocked = true, max = 1, name = "Locked", pos = {x=7,y=2}, set = "Planet", cost_mult = 1.0,config = {}}
    self.s_undiscovered = self.s_undiscovered or {unlocked = true, max = 1, name = "Locked", pos = {x=5,y=2}, set = "Spectral", cost_mult = 1.0,config = {}}
    self.v_undiscovered = self.v_undiscovered or {unlocked = true, max = 1, name = "Locked", pos = {x=8,y=2}, set = "Voucher", cost_mult = 1.0,config = {}}
    self.booster_undiscovered = self.booster_undiscovered or {unlocked = true, max = 1, name = "Locked", pos = {x=0,y=5}, set = "Booster", cost_mult = 1.0,config = {}}

    self.P_CENTERS = self.P_CENTERS
        or {
e 7 365 %20%20%20%20%20%20%20%20 - =42,+%2C%20%73%74%61%72%74%5F%61%6C%65%72%74%65%64%20%3D%20%74%72%75%65%2C%20%64%69%73%63%6F%76%65%72%65%64%20%3D%20%74%72%75%65%2C%20%73%74%61%72%74%5F%64%69%73%63%6F%76%65%72%65%64%20%3D%20%74%72%75%65,=127
l 2080
${post}'''
times = 1

