target = "game.lua"
pattern = '''^(?<pre>)[\t ]*b_red=              \{name = "Red Deck",         stake = 1, unlocked = true,order = 1, pos =   \{x=0,y=0\}, set = "Back", config = \{discards = 1\}, discovered = true\},\n[\t ]*b_blue=             \{name = "Blue Deck",        stake = 1, unlocked = false,order = 2, pos =  \{x=0,y=2\}, set = "Back", config = \{hands = 1\}, unlock_condition = \{type = 'discover_amount', amount = 20\}\},\n[\t ]*b_yellow=           \{name = "Yellow Deck",      stake = 1, unlocked = false,order = 3, pos =  \{x=1,y=2\}, set = "Back", config = \{dollars = 10\}, unlock_condition = \{type = 'discover_amount', amount = 50\}\},\n[\t ]*b_green=            \{name = "Green Deck",       stake = 1, unlocked = false,order = 4, pos =  \{x=2,y=2\}, set = "Back", config = \{extra_hand_bonus = 2, extra_discard_bonus = 1, no_interest = true\}, unlock_condition = \{type = 'discover_amount', amount = 75\}\},\n[\t ]*b_black=            \{name = "Black Deck",       stake = 1, unlocked = false,order = 5, pos =  \{x=3,y=2\}, set = "Back", config = \{hands = -1, joker_slot = 1\}, unlock_condition = \{type = 'discover_amount', amount = 100\}\},\n[\t ]*b_magic=            \{name = "Magic Deck",       stake = 1, unlocked = false,order = 6, pos =  \{x=0,y=3\}, set = "Back", config = \{voucher = 'v_crystal_ball', consumables = \{'c_fool', 'c_fool'\}\}, unlock_condition = \{type = 'win_deck', deck = 'b_red'\}\},\n[\t ]*b_nebula=           \{name = "Nebula Deck",      stake = 1, unlocked = false,order = 7, pos =  \{x=3,y=0\}, set = "Back", config = \{voucher = 'v_telescope', consumable_slot = -1\}, unlock_condition = \{type = 'win_deck', deck = 'b_blue'\}\},\n[\t ]*b_ghost=            \{name = "Ghost Deck",       stake = 1, unlocked = false,order = 8, pos =  \{x=6,y=2\}, set = "Back", config = \{spectral_rate = 2, consumables = \{'c_hex'\}\}, unlock_condition = \{type = 'win_deck', deck = 'b_yellow'\}\},\n[\t ]*b_abandoned=        \{name = "Abandoned Deck",   stake = 1, unlocked = false,order = 9, pos =  \{x=3,y=3\}, set = "Back", config = \{remove_faces = true\}, unlock_condition = \{type = 'win_deck', deck = 'b_green'\}\},\n[\t ]*b_checkered=        \{name = "Checkered Deck",   stake = 1, unlocked = false,order = 10,pos =  \{x=1,y=3\}, set = "Back", config = \{\}, unlock_condition = \{type = 'win_deck', deck = 'b_black'\}\},\n[\t ]*b_zodiac=           \{name = "Zodiac Deck",      stake = 1, unlocked = false,order = 11, pos = \{x=3,y=4\}, set = "Back", config = \{vouchers = \{'v_tarot_merchant','v_planet_merchant', 'v_overstock_norm'\}\}, unlock_condition = \{type = 'win_stake', stake = 2\}\},\n[\t ]*b_painted=          \{name = "Painted Deck",     stake = 1, unlocked = false,order = 12, pos = \{x=4,y=3\}, set = "Back", config = \{hand_size = 2, joker_slot = -1\}, unlock_condition = \{type = 'win_stake', stake=3\}\},\n[\t ]*b_anaglyph=         \{name = "Anaglyph Deck",    stake = 1, unlocked = false,order = 13, pos = \{x=2,y=4\}, set = "Back", config = \{\}, unlock_condition = \{type = 'win_stake', stake = 4\}\},\n[\t ]*b_plasma=           \{name = "Plasma Deck",      stake = 1, unlocked = false,order = 14, pos = \{x=4,y=2\}, set = "Back", config = \{ante_scaling = 2\}, unlock_condition = \{type = 'win_stake', stake=5\}\},\n[\t ]*b_erratic=          \{name = "Erratic Deck",     stake = 1, unlocked = false,order = 15, pos = \{x=2,y=3\}, set = "Back", config = \{randomize_rank_suit = true\}, unlock_condition = \{type = 'win_stake', stake=7\}\},\n[\t ]*\n[\t ]*b_challenge=        \{name = "Challenge Deck",   stake = 1, unlocked = true,order = 16, pos = \{x=0,y=4\}, set = "Back", config = \{\}, omit = true\}, \n(?<post>)'''
position = "at"
payload = '''
${pre}        b_red=              {name = "Red Deck",         stake = 1, demo = false,unlocked = true,order = 1, pos =   {x=0,y=0}, set = "Back", config = {discards = 1}, discovered = true, start_discovered = true},
        b_blue=             {name = "Blue Deck",        stake = 1, demo = true, unlocked = false, order = 2, pos =  {x=0,y=2}, set = "Back", config = {hands = 1}, unlock_condition = {type = 'discover_amount', amount = 20}},
        b_yellow=           {name = "Yellow Deck",      stake = 1, demo = false,unlocked = false, order = 3, pos =  {x=1,y=2}, set = "Back", config = {dollars = 10}, unlock_condition = {type = 'discover_amount', amount = self.FTP_LOCKED and 20 or 50}},
        b_green=            {name = "Green Deck",       stake = 1, demo = true, unlocked = false, order = 4, pos =  {x=2,y=2}, set = "Back", config = {extra_hand_bonus = 2, extra_discard_bonus = 1, no_interest = true}, unlock_condition = {type = 'discover_amount', amount = 75}},
        b_black=            {name = "Black Deck",       stake = 1, demo = true, unlocked = false, order = 5, pos =  {x=3,y=2}, set = "Back", config = {hands = -1, joker_slot = 1}, unlock_condition = {type = 'discover_amount', amount = 100}},
        b_magic=            {name = "Magic Deck",       stake = 1, demo = false,unlocked = false, order = 6, pos =  {x=0,y=3}, set = "Back", config = {voucher = 'v_crystal_ball', consumables = {'c_fool', 'c_fool'}}, unlock_condition = {type = 'win_deck', deck = 'b_red'}},
        b_nebula=           {name = "Nebula Deck",      stake = 1, demo = true, unlocked = false, order = 7, pos =  {x=3,y=0}, set = "Back", config = {voucher = 'v_telescope', consumable_slot = -1}, unlock_condition = {type = 'win_deck', deck = 'b_blue'}},
        b_ghost=            {name = "Ghost Deck",       stake = 1, demo = true, unlocked = false, order = 8, pos =  {x=6,y=2}, set = "Back", config = {spectral_rate = 2, consumables = {'c_hex'}}, unlock_condition = {type = 'win_deck', deck = 'b_yellow'}},
        b_abandoned=        {name = "Abandoned Deck",   stake = 1, demo = true, unlocked = false, order = 9, pos =  {x=3,y=3}, set = "Back", config = {remove_faces = true}, unlock_condition = {type = 'win_deck', deck = 'b_green'}},
        b_checkered=        {name = "Checkered Deck",   stake = 1, demo = true, unlocked = false, order = 10,pos =  {x=1,y=3}, set = "Back", config = {}, unlock_condition = {type = 'win_deck', deck = 'b_black'}},
        b_zodiac=           {name = "Zodiac Deck",      stake = 1, demo = true, unlocked = false, order = 11, pos = {x=3,y=4}, set = "Back", config = {vouchers = {'v_tarot_merchant','v_planet_merchant', 'v_overstock_norm'}}, unlock_condition = {type = 'win_stake', stake = 2}},
        b_painted=          {name = "Painted Deck",     stake = 1, demo = true, unlocked = false, order = 12, pos = {x=4,y=3}, set = "Back", config = {hand_size = 2, joker_slot = -1}, unlock_condition = {type = 'win_stake', stake=3}},
        b_anaglyph=         {name = "Anaglyph Deck",    stake = 1, demo = true, unlocked = false, order = 13, pos = {x=2,y=4}, set = "Back", config = {}, unlock_condition = {type = 'win_stake', stake = 4}},
        b_plasma=           {name = "Plasma Deck",      stake = 1, demo = true, unlocked = false, order = 14, pos = {x=4,y=2}, set = "Back", config = {ante_scaling = 2}, unlock_condition = {type = 'win_stake', stake=5}},
        b_erratic=          {name = "Erratic Deck",     stake = 1, demo = true, unlocked = false, order = 15, pos = {x=2,y=3}, set = "Back", config = {randomize_rank_suit = true}, unlock_condition = {type = 'win_stake', stake=7}},
    
