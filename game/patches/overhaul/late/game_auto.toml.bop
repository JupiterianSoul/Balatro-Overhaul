position = "at"
payload = '''
${pre}${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.game.modded.012"
requires = ["auto.game.035"]
target = "game.lua"
pattern = '''^(?<pre>[\t ]*if G\.SAVED_GAME then SMODS\.save_game = G\.SAVED_GAME\.GAME\.smods_version else SMODS\.save_game = nil end\n)(?<post>)'''
position = "at"
payload = '''
${pre}    if saveTable then self:plain_saved_numbers(saveTable); self:fit_save_to_mods(saveTable) end
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.game.modded.013"
target = "game.lua"
pattern = '''^(?<pre>)[\t ]*local selected_back = saveTable and saveTable\.BACK\.name or \(args\.challenge and args\.challenge\.deck and args\.challenge\.deck\.type\) or \(args\.back and args\.back\.name\) or \(args\.deck_choice and args\.deck_choice\.name\) or \(self\.GAME\.viewed_back and self\.GAME\.viewed_back\.name\) or self\.GAME\.selected_back and self\.GAME\.selected_back\.name or 'Red Deck'\n(?<post>)'''
position = "at"
payload = '''
${pre}    local selected_back = saveTable and saveTable.BACK.name or (args.challenge and args.challenge.deck and args.challenge.deck.type) or (args.deck_choice and args.deck_choice.name) or (args.back and args.back.name) or (self.GAME.viewed_back and self.GAME.viewed_back.name) or self.GAME.selected_back and self.GAME.selected_back.name or 'Red Deck'
${post}'''
optional = true

[[patches]]
