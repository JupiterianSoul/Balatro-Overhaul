id = "auto.game.027"
target = "game.lua"
pattern = '''^(?<pre>)[\t ]*if not love\.filesystem\.getInfo\(G\.SETTINGS\.profile\.\.''\) then love\.filesystem\.createDirectory\( G\.SETTINGS\.profile\.\.'' \) end\n[\t ]*if not love\.filesystem\.getInfo\(G\.SETTINGS\.profile\.\.'/'\.\.'meta\.jkr'\) then love\.filesystem\.append\( G\.SETTINGS\.profile\.\.'/'\.\.'meta\.jkr', 'return \{\}'\) end\n(?<metaextra>(?:[\t ]*if not love\.filesystem\.getInfo\([^\n]*\n)*)[\t ]*\n[\t ]*convert_save_to_meta\(\)\n[\t ]*\n[\t ]*local meta = STR_UNPACK\(get_compressed\(G\.SETTINGS\.profile\.\.'/'\.\.'meta\.jkr'\) or 'return \{\}'\)\n(?<post>)'''
position = "at"
payload = '''
${pre}    if not love.mod_filesystem.getInfo(G.SETTINGS.profile..'') then love.mod_filesystem.createDirectory( G.SETTINGS.profile..'' ) end

${metaextra}    local meta_file = G.SETTINGS.profile..'/meta.jkr'
    local meta = G.FILES[meta_file] or {}
${post}'''
times = 1

