[[patches]]
[patches.regex]
id = "auto.game.modded.007"
target = "game.lua"
pattern = '''^(?<pre>)[\t ]*self\.b_undiscovered = \{name = 'Undiscovered', debuff_text = 'Defeat this blind to discover', pos = \{x=0,y=30\}\}\n[\t ]*\n[\t ]*self\.P_CARDS = \{\n(?<post>)'''
position = "at"
payload = '''
${pre}    self.b_undiscovered = self.b_undiscovered or {name = 'Undiscovered', debuff_text = 'Defeat this blind to discover', pos = {x=0,y=30}}

    self.P_CARDS = self.P_CARDS
        or {
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.game.modded.008"
target = "game.lua"
pattern = '''^(?<pre>)(?<post>[\t ]*SMODS\._save_d_u\(v\)\n)'''
position = "at"
payload = '''
${pre}            if v._discovered_unlocked_overwritten then
                if v._saved_d_u then v.discovered, v.unlocked = v._d, v._u end
                v._discovered_unlocked_overwritten = false
            end
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.game.modded.009"
target = "game.lua"
pattern = '''^(?<pre>)[\t ]*\n(?<post>[\t ]*local counted = G\.SETTINGS\.profile_counters\[_profile\] or 0\n[\t ]*G\.PROFILES\[_profile\]\.ver = math\.max\(G\.PROFILES\[_profile\]\.ver or 0, counted\)\n[\t ]*\n[\t ]*if _profile == G\.SETTINGS\.profile and progression_init then\n[\t ]*progression_init\(\)\n[\t ]*end\n[\t ]*if convert_save_data and G\.P_STAKES then convert_save_data\(G\.PROFILES\[G\.SETTINGS\.profile\], true\) end\n)'''
position = "at"
payload = '''
${pre}    if convert_save_data and G.P_STAKES then convert_save_data(G.PROFILES[_profile], true) end
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.game.modded.010"
