pattern = '''^(?<pre>)[\t ]*if convert_save_data and G\.P_STAKES then convert_save_data\(G\.PROFILES\[G\.SETTINGS\.profile\], true\) end\n(?<post>)'''
position = "at"
payload = '''
${pre}${post}'''
optional = true

