[[patches]]
[patches.regex]
id = "auto.game.071"
target = "game.lua"
pattern = '''^(?<pre>)(?<post>[\t ]*\n[\t ]*function Game:start_run\(args\)\n)'''
position = "at"
payload = '''
${pre}function Game:fill_game_defaults()
    local ok, fresh = pcall(self.init_game_object, self)
    if not ok or type(fresh) ~= 'table' or type(self.GAME) ~= 'table' then return end
    for k, v in pairs(fresh) do
        local cur = self.GAME[k]
        if cur == nil then
            self.GAME[k] = v
        elseif type(cur) == 'table' and type(v) == 'table' and getmetatable(cur) == nil and getmetatable(v) == nil then
            for k2, v2 in pairs(v) do
                if cur[k2] == nil then cur[k2] = v2 end
            end
        end
    end
end
${post}'''
times = 1

