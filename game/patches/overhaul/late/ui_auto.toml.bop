        if cur and cur ~= self and not cur.REMOVED and cur.UIBox == self.UIBox then
            self.UIBox.draw_more = self.UIBox.draw_more or {}
            local more = self.UIBox.draw_more[self.config.draw_layer] or {}
            self.UIBox.draw_more[self.config.draw_layer] = more
