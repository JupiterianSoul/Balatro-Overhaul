id = "auto.ui.031"
target = "engine/ui.lua"
pattern = '''^(?<pre>[\t ]*return true\n[\t ]*end\n)(?<post>)'''
position = "at"
payload = '''
${pre}local function ui_set_recursive(node, recursive, apply)
  apply(node)
  if recursive and type(node.children) == 'table' then
    for _, child in pairs(node.children) do
      if type(child) == 'table' and child.is and child:is(UIElement) then ui_set_recursive(child, true, apply) end
    end
  end
end

function UIElement:set_zoom(zoom, recursive)
  ui_set_recursive(self, recursive, function(n) n.zoom = zoom end)
end

function UIElement:set_hover_state(state, recursive)
  ui_set_recursive(self, recursive, function(n) if n.states and n.states.hover then n.states.hover.is = state end end)
end

function UIElement:set_drag_state(state, recursive)
  ui_set_recursive(self, recursive, function(n) if n.states and n.states.drag then n.states.drag.is = state end end)
end

function UIElement:set_created_on_pause(state, recursive)
  ui_set_recursive(self, recursive, function(n) n.created_on_pause = state end)
end
${post}'''
times = 1

[[patches]]
[patches.regex]
id = "auto.ui.032"
target = "engine/ui.lua"
pattern = '''^(?<pre>[\t ]*function UIElement:click\(\)\n)(?<post>)'''
position = "at"
payload = '''
${pre}    if (self.config.button == 'select_blind' or self.config.button == 'skip_blind') and G.GAME and (G.GAME.STOP_USE or 0) > 0 then return end
${post}'''
times = 1

[[patches]]
[patches.regex]
id = "auto.ui.modded.001"
target = "engine/ui.lua"
pattern = '''^(?<pre>)[\t ]*if node\.config\.text_drawable_font ~= node\.config\.lang\.font\.FONT then\n(?<post>[\t ]*node\.config\.text_drawable = nil\n[\t ]*elseif node\.config\.text_drawable_text ~= node\.config\.text then\n[\t ]*td:set\(node\.config\.text\)\n[\t ]*node\.config\.text_drawable_text = node\.config\.text\n[\t ]*end\n[\t ]*end\n[\t ]*local tx = \(node\.config\.font or node\.config\.lang\.font\)\.FONT:getWidth\(node\.config\.text\)\*\(node\.config\.font or node\.config\.lang\.font\)\.squish\*scale\*G\.TILESCALE\*\(node\.config\.font or node\.config\.lang\.font\)\.FONTSCALE\n)'''
position = "at"
payload = '''
${pre}                if node.config.text_drawable_font ~= (node.config.font or node.config.lang.font).FONT then
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.ui.modded.002"
target = "engine/ui.lua"
pattern = '''^(?<pre>[\t ]*self\.config\.text_drawable = love\.graphics\.newText\(\(self\.config\.font or self\.config\.lang\.font\)\.FONT, \{G\.C\.WHITE,self\.config\.text\}\)\n)[\t ]*self\.config\.text_drawable_font = self\.config\.lang\.font\.FONT\n(?<post>)'''
position = "at"
payload = '''
${pre}        self.config.text_drawable_font = (self.config.font or self.config.lang.font).FONT
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.ui.modded.003"
target = "engine/ui.lua"
pattern = '''^(?<pre>)(?<post>[\t ]*if self\.config\.pulse_border then\n[\t ]*self\.border_pulse_timer = self\.border_pulse_timer or G\.TIMERS\.REAL\n[\t ]*local lw = math\.max\(0, math\.cos\(6\*\(G\.TIMERS\.REAL - self\.border_pulse_timer\)\) \+ 1\)\n[\t ]*prep_draw\(self, 1\)\n[\t ]*love\.graphics\.scale\(\(1\)/\(G\.TILESIZE\)\)\n[\t ]*love\.graphics\.setLineWidth\(lw \+ 1\)\n[\t ]*love\.graphics\.setColor\(adjust_alpha\(G\.C\.BLACK, 0\.2\*lw, true\)\)\n[\t ]*self:draw_pixellated_rect\('fill', parallax_dist\)\n[\t ]*love\.graphics\.setColor\(self\.config\.colour\[4\] > 0 and mix_colours\(G\.C\.WHITE, self\.config\.colour, 0\.8\) or G\.C\.WHITE\)\n[\t ]*self:draw_pixellated_rect\('line', parallax_dist\)\n[\t ]*love\.graphics\.pop\(\)\n[\t ]*end\n[\t ]*\n[\t ]*if old_outline_opacity then\n)'''
position = "at"
payload = '''
${pre}
${post}'''
optional = true
end
