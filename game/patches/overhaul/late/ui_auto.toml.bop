[[patches]]
[patches.regex]
id = "auto.ui.001"
target = "engine/ui.lua"
pattern = '''^(?<pre>)(?<post>[\t ]*self:calculate_xywh\(self\.UIRoot, self\.T\)\n)'''
position = "at"
payload = '''
${pre}    self.building = true
${post}'''
times = 1

[[patches]]
[patches.regex]
id = "auto.ui.002"
target = "engine/ui.lua"
pattern = '''^(?<pre>)(?<post>[\t ]*\n[\t ]*self:align_to_major\(\)\n)'''
position = "at"
payload = '''
${pre}    self.building = nil
    if self.recalc_pending then
        self.recalc_pending = nil
        self:recalculate()
    end
${post}'''
times = 1

[[patches]]
[patches.regex]
id = "auto.ui.003"
target = "engine/ui.lua"
pattern = '''^(?<pre>)(?<post>[\t ]*\n[\t ]*function UIBox:calculate_xywh\(node, _T, recalculate, _scale\)\n)'''
position = "at"
payload = '''
${pre}local ui_utf8_ok, ui_utf8 = pcall(require, 'utf8')
local function ui_valid_text(s)
    if type(s) ~= 'string' or not ui_utf8_ok then return s end
    local ok, pos = ui_utf8.len(s)
    local n = 0
    while not ok and pos and n < 256 do
        s = s:sub(1, pos - 1) .. '?' .. s:sub(pos + 1)
        ok, pos = ui_utf8.len(s)
        n = n + 1
    end
    return ok and s or '?'
end

local function ui_text_string(v)
    if type(v) ~= 'table' then return tostring(v) end
    local mt = getmetatable(v)
    if mt and mt.__tostring then return tostring(v) end
    if type(v.array) == 'table' and v.sign ~= nil then
        local n = #v.array <= 1 and (v.sign == -1 and -1 or 1) * (tonumber(v.array[1]) or 0) or math.huge
        return rawget(_G, 'number_format') and tostring(number_format(n)) or tostring(n)
    end
    local parts = {}
    for _, p in ipairs(v) do parts[#parts + 1] = ui_text_string(p) end
    return table.concat(parts, ' ')
end
${post}'''
times = 1

