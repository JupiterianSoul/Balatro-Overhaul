[[patches]]
[patches.regex]
id = "auto.button_callbacks.001"
target = "functions/button_callbacks.lua"
pattern = '''^(?<pre>[\t ]*G\.hand:sort\('desc'\)\n[\t ]*play_sound\('paper1'\)\n[\t ]*end\n)(?<post>)'''
position = "at"
payload = '''
${pre}function G.FUNCS.check_drag_target_active(e)
  local cfg, args = e.config, e.config.args
  local live = args.active_check(args.card)
  local changed = (live and not cfg.pulse_border) or (not live and cfg.pulse_border)
  if changed or not args.init then
    if live then
      cfg.pulse_border, cfg.colour, cfg.release_func = true, args.colour, args.release_func
      args.text_colour[4] = 1
    else
      cfg.pulse_border, cfg.colour, cfg.release_func = nil, adjust_alpha(G.C.L_BLACK, 0.9), nil
      args.text_colour[4] = 0.5
    end
  end
  args.init = true
end
${post}'''
times = 1

[[patches]]
[patches.regex]
id = "auto.button_callbacks.002"
target = "functions/button_callbacks.lua"
pattern = '''^(?<pre>)[\t ]*G\.FUNCS\.can_buy = function\(e\)\n[\t ]*if \((?:to_big\(e\.config\.ref_table\.cost\) > to_big\(G\.GAME\.dollars\) - to_big\(G\.GAME\.bankrupt_at\)|e\.config\.ref_table\.cost > G\.GAME\.dollars - G\.GAME\.bankrupt_at)\) and \(e\.config\.ref_table\.cost > 0\) then\n(?<post>)'''
position = "at"
payload = '''
${pre}G.FUNCS.shop_check_result = function(ok, e)
  if ok == nil then return e.config.button ~= nil end
  return ok and true or false
end

G.FUNCS.card_can_buy = function(_card)
  local e = {config = {ref_table = _card}}
  return G.FUNCS.shop_check_result(G.FUNCS.can_buy(e), e)
end

G.FUNCS.card_can_buy_and_use = function(_card)
  local e = {config = {ref_table = _card}}
  return G.FUNCS.shop_check_result(G.FUNCS.can_buy_and_use(e), e)
end

e 32 887 - - =8,-2,+%62%75,=8,+%5F%63%68%65%63%6B,=14
l 49
    if not G.FUNCS.shop_check_result(G.FUNCS.can_buy(e), e) then
${post}'''
times = 1

[[patches]]
[patches.regex]
id = "auto.button_callbacks.003"
target = "functions/button_callbacks.lua"
pattern = '''^(?<pre>[\t ]*end\n[\t ]*end\n)(?<post>[\t ]*\n[\t ]*--Checks if the cost of a non voucher card is greater than what the player can afford and changes the \n)'''
position = "at"
payload = '''
${pre}G.FUNCS.can_buy = function(_card)
  local e
  if _card and not _card.ability and _card.config and _card.config.ref_table then
    e, _card = _card, _card.config.ref_table
  end
  local big = rawget(_G, "to_big") or tonumber
  local ok = not (big(_card.cost) > big(G.GAME.dollars) - big(G.GAME.bankrupt_at) and big(_card.cost) > big(0))
  if e then
    e.config.colour = ok and G.C.ORANGE or G.C.UI.BACKGROUND_INACTIVE
    e.config.button = ok and 'buy_from_shop' or nil
  end
  return ok
end
${post}'''
times = 1

