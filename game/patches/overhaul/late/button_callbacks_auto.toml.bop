pattern = '''^(?<pre>)[\t ]*local OSkeyboard_e = e\.parent\.parent\.parent\n[\t ]*if G\.CONTROLLER\.text_input_hook == e and \(G\.CONTROLLER\.HID\.controller or G\.CONTROLLER\.HID\.touch\) then\n[\t ]*if not OSkeyboard_e\.children\.controller_keyboard then \n[\t ]*OSkeyboard_e\.children\.controller_keyboard = UIBox\{\n[\t ]*definition = create_keyboard_input\{backspace_key = true, return_key = true, space_key = false\},\n[\t ]*config = \{\n[\t ]*align= 'cm',\n[\t ]*offset = \{x = 0, y = G\.CONTROLLER\.text_input_hook\.config\.ref_table\.keyboard_offset or -4\},\n[\t ]*major = e\.UIBox, parent = OSkeyboard_e\}\n[\t ]*\}\n[\t ]*G\.CONTROLLER\.screen_keyboard = OSkeyboard_e\.children\.controller_keyboard\n[\t ]*G\.CONTROLLER:mod_cursor_context_layer\(1\)\n[\t ]*end\n[\t ]*elseif OSkeyboard_e\.children\.controller_keyboard then\n[\t ]*OSkeyboard_e\.children\.controller_keyboard:remove\(\)\n[\t ]*OSkeyboard_e\.children\.controller_keyboard = nil\n[\t ]*G\.CONTROLLER\.screen_keyboard = nil\n[\t ]*G\.CONTROLLER:mod_cursor_context_layer\(-1\)\n[\t ]*end\n(?<post>)'''
position = "at"
payload = '''
${pre}  do
r 32 911 %20%20%20%20 -
l 2
    if G.CONTROLLER.text_input_hook == e and G.CONTROLLER.kb_rebuild and OSkeyboard_e.children.controller_keyboard then
      G.CONTROLLER.kb_rebuild = nil
r 32 925 %20%20%20%20%20%20 -
r 32 926 %20%20%20%20%20%20 -
r 32 927 %20%20%20%20%20%20 -
r 29 972 %20%20%20%20%20%20 -
l 2
    end
    if G.CONTROLLER.text_input_hook == e and (G.F_MOBILE or (G.CONTROLLER.HID.controller and not G.CONTROLLER.HID.keyboard) or (Controls and Controls.screen_keyboard and Controls.screen_keyboard()) or (TouchInput and TouchInput.osk())) then
r 32 913 %20%20%20%20%20%20 -
l 3
        local wide = G.FUNCS.text_input_wide(args)
        if not wide then G.CONTROLLER.kb_accents, G.CONTROLLER.kb_symbols = nil, nil end
        if PORTRAIT then PORTRAIT._kb_args = args end
r 32 914 %20%20%20%20%20%20%20%20 -
l 3
          definition = create_keyboard_input{backspace_key = true, return_key = true, space_key = wide, wide = wide, accents = wide and G.CONTROLLER.kb_accents, lower_ok = not args.all_caps},
          config = {
            align= 'cm',
r 32 918 %20%20%20%20%20%20%20%20%20%20%20%20 -
l 2
            major = e.UIBox, parent = OSkeyboard_e, draw_layer = 'screen_keyboard'}
        }
r 32 921 %20%20%20%20%20%20%20%20 -
l 1
        if PORTRAIT and PORTRAIT.place_keyboard then pcall(PORTRAIT.place_keyboard, OSkeyboard_e.children.controller_keyboard, e.parent.parent) end
r 32 922 %20%20%20%20%20%20%20%20 -
l 1
      end
r 32 924 %20%20%20%20 -
r 32 925 %20%20%20%20%20%20 -
r 32 926 %20%20%20%20%20%20 -
r 32 927 %20%20%20%20%20%20 -
r 29 972 %20%20%20%20%20%20 -
l 17
    end
  end
end

G.FUNCS.ui_size_slide = function(rt)
  G.UI_SIZE_PENDING = true
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.button_callbacks.modded.003"
target = "functions/button_callbacks.lua"
pattern = '''^(?<pre>)[\t ]*fullscreentype = \(G\.SETTINGS\.WINDOW\.screenmode == 'Borderless' and 'desktop'\) or \(G\.SETTINGS\.WINDOW\.screenmode == 'Fullscreen' and 'exclusive'\) or nil,\n[\t ]*vsync = G\.SETTINGS\.WINDOW\.vsync,\n[\t ]*resizable = not \(love\.system\.getOS\(\) == 'Android' or love\.system\.getOS\(\) == 'iOS'\),\n[\t ]*display = G\.SETTINGS\.WINDOW\.selected_display,\n[\t ]*highdpi = \(love\.system\.getOS\(\) == 'OS X' or love\.system\.getOS\(\) == 'Android' or love\.system\.getOS\(\) == 'iOS'\)\n(?<post>)'''
position = "at"
payload = '''
${pre}      fullscreentype = (G.SETTINGS.WINDOW.screenmode == 'Borderless' and 'desktop') or (G.SETTINGS.WINDOW.screenmode == 'Fullscreen' and 'exclusive') or nil,
e 32 1179 %20%20%20%20%20%20 - =31,+%20%3D%3D%20%31%20%61%6E%64%20%31%20%6F%72%20%30,=1
l 1
      resizable = true,
r 32 1181 %20%20%20%20%20%20 -
l 24
      highdpi = love.system.getOS() == 'OS X'
${post}'''
optional = true

