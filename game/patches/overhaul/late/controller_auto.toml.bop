[[patches]]
[patches.regex]
id = "auto.controller.035"
target = "engine/controller.lua"
pattern = '''^(?<pre>)[\t ]*elseif math\.abs\(G\.ARGS\.focus_vec\.x\) < v\.T\.w/2 then eligible = true end\n[\t ]*end\n[\t ]*elseif math\.abs\(G\.ARGS\.focus_vec\.x\) > math\.abs\(G\.ARGS\.focus_vec\.y\) then\n[\t ]*if G\.ARGS\.focus_vec\.x > 0 and dir == 'R' then eligible = true\n[\t ]*elseif G\.ARGS\.focus_vec\.x < 0 and dir == 'L' then eligible = true end\n[\t ]*else\n[\t ]*if G\.ARGS\.focus_vec\.y > 0 and dir == 'D' then eligible = true\n[\t ]*elseif G\.ARGS\.focus_vec\.y < 0 and dir == 'U' then eligible = true end\n(?<post>)'''
position = "at"
payload = '''
${pre}                                elseif math.abs(G.ARGS.focus_vec.x) < v.T.w/2 and ((dir == 'D' and v.T.y + v.T.h > G.ARGS.focus_cursor_pos.y + 0.1) or (dir == 'U' and v.T.y < G.ARGS.focus_cursor_pos.y - 0.1)) then eligible = true end
                            end
                        else
                            local vx, vy = G.ARGS.focus_vec.x, G.ARGS.focus_vec.y
                            local horiz = dir == 'L' or dir == 'R'
                            local main = (dir == 'R' and vx) or (dir == 'L' and -vx) or (dir == 'D' and vy) or -vy
                            local off = horiz and math.abs(vy) or math.abs(vx)
                            local ft = self.focused.target and self.focused.target.T
                            if ft then
                                local overlap = horiz and (math.min(ft.y + ft.h, v.T.y + v.T.h) - math.max(ft.y, v.T.y))
                                    or (math.min(ft.x + ft.w, v.T.x + v.T.w) - math.max(ft.x, v.T.x))
                                if overlap > 0 then off = 0 end
                            end
                            if main > 0.05 and off <= main then
                                eligible = true
                                score = main + 2.5*off
                            end
${post}'''
times = 1

