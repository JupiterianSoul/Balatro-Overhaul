		if not love.graphics.isActive or love.graphics.isActive() then guarded(draw, text, note, buttons, pad, small, big) end
		if love.timer then love.timer.sleep(0.05) end
	end
end

function M.wrap(handler)
	if type(handler) ~= "function" or M.wrapped == handler then return handler end
	local safe = function(msg, ...)
		local trace = debug.traceback("", 2)
		if M.usable(rawget(_G, "G")) then
			local ok, err = pcall(handler, msg, ...)
			if ok then return err end
			return M.show(tostring(msg) .. "\n\nThe crash screen failed too: " .. tostring(err), trace)
		end
		return M.show(msg, trace)
	end
	M.wrapped = safe
	return safe
end

function M.guard()
	if getmetatable(love) or rawget(love, "errorhandler") then return end
	local h = rawget(love, "errhand")
	if type(h) == "function" and h ~= M.wrapped then
		rawset(love, "errhand", M.wrap(h))
	elseif h == nil then
		rawset(love, "errhand", function(msg) return M.show(msg, debug.traceback("", 2)) end)
	end
end

return M
end
