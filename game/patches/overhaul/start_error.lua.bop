end

local function guarded(fn, ...)
	local g = love.graphics
	local depth = g and g.getStackDepth and g.getStackDepth()
	local ok, r = pcall(fn, ...)
	if not ok and depth then
		while g.getStackDepth() > depth do g.pop() end
	end
	return ok, r
end

function M.show(msg, trace)
	if M.failed and M.failed.msg == msg then trace = M.failed.trace end
	local text = M.report_text(msg, trace)
	print(text)
	pcall(function()
		local ML = rawget(_G, "MODLOADER")
		if ML and ML.record_plain_crash then ML.record_plain_crash(msg, trace) end
	end)
	if not (love.window and love.graphics and love.event) then return end
	if not (love.graphics.isCreated and love.graphics.isCreated()) or not love.window.isOpen() then
		local ok, made = pcall(love.window.setMode, 800, 600)
		if not ok or not made then return end
	end
	if love.mouse then pcall(love.mouse.setVisible, true) pcall(love.mouse.setGrabbed, false) pcall(love.mouse.setRelativeMode, false) end
	if love.audio then pcall(love.audio.stop) end
	pcall(love.graphics.reset)
	local note
	while true do
		local w, h = love.graphics.getDimensions()
		local s = math.min(w, h)
		local small, big = font(s * 0.04), font(s * 0.06)
		local buttons, pad = M.layout(w, h, small)
		love.event.pump()
