local M = {}

M.FONT = "resources/fonts/m6x11plus.ttf"
M.DISCORD = "https://discord.gg/uu4pu8NySP"
M.TITLE = "Balatro Overhaul ran into an error"
M.HELP = "Copy the error and send it to me on Discord so I can fix it."
M.BUTTONS = {"Copy error", "Open Discord", "Quit"}

function M.version()
	local name, build = rawget(_G, "OVERHAUL_NAME"), rawget(_G, "OVERHAUL_VERSION")
	if name then return "Overhaul " .. tostring(name) .. " build " .. tostring(build or "?") end
	return tostring(rawget(_G, "VERSION") or "?")
end

function M.report_text(msg, trace)
	local os_name = love.system and love.system.getOS and love.system.getOS() or "?"
	return tostring(msg) .. "\n\n" .. M.version() .. " (" .. tostring(os_name) .. ")\n" .. tostring(trace or "")
end

function M.usable(G)
	return type(G) == "table" and not G.F_NO_ERROR_HAND and type(G.SETTINGS) == "table" and type(G.C) == "table" and G.C.BLACK ~= nil
end

local fonts = {}

local function font(px)
	px = math.max(8, math.floor(px + 0.5))
	if fonts[px] == nil then
		local ok, f = pcall(love.graphics.newFont, M.FONT, px)
		if not ok then ok, f = pcall(love.graphics.newFont, px) end
		fonts[px] = ok and f or false
	end
	return fonts[px] or love.graphics.getFont()
end

function M.layout(w, h, f)
	local s = math.min(w, h)
	local pad = math.floor(s * 0.05)
	local bh = math.floor(f:getHeight() * 2.2)
	local gap = math.floor(pad / 2)
	local n = #M.BUTTONS
	local bw = math.floor(math.min((w - pad * 2 - gap * (n - 1)) / n, s * 0.6))
	local total = bw * n + gap * (n - 1)
	local x0 = math.floor((w - total) / 2)
	local by = h - pad - bh
	local out = {}
	for i = 1, n do out[i] = {x = x0 + (i - 1) * (bw + gap), y = by, w = bw, h = bh} end
	return out, pad
end

function M.hit(buttons, x, y)
	for i, b in ipairs(buttons) do
		if x >= b.x and x <= b.x + b.w and y >= b.y and y <= b.y + b.h then return i end
	end
	return nil
end

local function draw(text, note, buttons, pad, small, big)
	local w, h = love.graphics.getDimensions()
	love.graphics.push("all")
