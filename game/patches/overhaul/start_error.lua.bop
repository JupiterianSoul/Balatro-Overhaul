	y = y + (#hl + 1) * small:getHeight()
	love.graphics.setColor(1, 1, 1, 1)
	love.graphics.setScissor(pad, y, w - pad * 2, math.max(0, buttons[1].y - pad - y))
	love.graphics.printf(text, pad, y, w - pad * 2, "left")
	love.graphics.setScissor()
	for i, b in ipairs(buttons) do
		love.graphics.setColor(i == 3 and {0.4, 0.42, 0.45, 1} or {0.996, 0.373, 0.333, 1})
		love.graphics.rectangle("fill", b.x, b.y, b.w, b.h, b.h / 5, b.h / 5)
		love.graphics.setColor(1, 1, 1, 1)
		local label = M.BUTTONS[i]
		love.graphics.print(label, math.floor(b.x + (b.w - small:getWidth(label)) / 2 + 0.5), math.floor(b.y + (b.h - small:getHeight()) / 2 + 0.5))
	end
	love.graphics.pop()
