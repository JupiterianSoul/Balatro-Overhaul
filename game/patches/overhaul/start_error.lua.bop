			local pick
			if e == "quit" then return end
			if e == "keypressed" and a == "escape" then return end
			if e == "keypressed" and (a == "c" or a == "return") then pick = 1 end
			if e == "mousereleased" then pick = M.hit(buttons, a, b) end
			if e == "touchreleased" then pick = M.hit(buttons, b, c) end
			if pick == 1 and love.system and love.system.setClipboardText then
				pcall(love.system.setClipboardText, text)
				note = "Error copied. Paste it in a message to me on Discord."
			elseif pick == 2 and love.system and love.system.openURL then
