BOP 1
eol lf
final 1
base 0
l 17
[manifest]
version = "1.0.0"
dump_lua = true
priority = -4

[[patches]]
[patches.pattern]
target = 'functions/state_events.lua'
pattern = "trigger = 'after',delay = score_time(0.4),"
position = 'at'
payload = "trigger = 'after',delay = 0.4,"
match_indent = true

[[patches]]
[patches.pattern]
target = 'functions/state_events.lua'
pattern = '''
r 16 1064 - -
l 5
}))
score_delay(0.3)
'''
position = 'at'
payload = '''
r 16 1064 - -
l 73
}))
delay(0.3)
'''
match_indent = true

[[patches]]
[patches.pattern]
target = 'game.lua'
pattern = '''v_overstock_norm =  {order = 1,     discovered = true, demo = true, unlocked = true , available = true, cost = 10, name = "Overstock", pos = {x=0,y=0}, set = "Voucher", config = {}},'''
position = 'at'
payload = '''v_overstock_norm =  {order = 1,     discovered = false, unlocked = true , available = true, cost = 10, name = "Overstock", pos = {x=0,y=0}, set = "Voucher", config = {}},'''
match_indent = true

[[patches]]
[patches.pattern]
target = 'game.lua'
pattern = '''v_crystal_ball=     {order = 9,     discovered = true, demo = true, unlocked = true , available = true, cost = 10, name = "Crystal Ball", pos = {x=2,y=2}, set = "Voucher", config = {extra = 3}},'''
position = 'at'
payload = '''v_crystal_ball=     {order = 9,    discovered = false, unlocked = true , available = true, cost = 10, name = "Crystal Ball", pos = {x=2,y=2}, set = "Voucher", config = {extra = 3}},'''
match_indent = true

[[patches]]
[patches.pattern]
target = 'game.lua'
pattern = '''v_overstock_plus=   {order = 2,     discovered = true, demo = true, unlocked = true, available = true, cost = 10, name = "Overstock Plus", pos = {x=0,y=1}, set = "Voucher", config = {}, requires = {'v_overstock_norm'},unlock_condition = {type = 'c_shop_dollars_spent', extra = 2500}},'''
position = 'at'
payload = '''v_overstock_plus=   {order = 2,     discovered = false, unlocked = false, available = true, cost = 10, name = "Overstock Plus", pos = {x=0,y=1}, set = "Voucher", config = {}, requires = {'v_overstock_norm'},unlock_condition = {type = 'c_shop_dollars_spent', extra = 2500}},'''
match_indent = true

[[patches]]
[patches.pattern]
target = 'game.lua'
pattern = '''v_antimatter=       {order = 24,    discovered = true, demo = true, unlocked = true, available = true, cost = 10, name = "Antimatter", pos = {x=7,y=1}, set = "Voucher", config = {extra = 15}, requires = {'v_blank'},unlock_condition = {type = 'blank_redeems', extra = 10}},'''
position = 'at'
payload = '''v_antimatter=       {order = 24,    discovered = false, unlocked = false, available = true, cost = 10, name = "Antimatter", pos = {x=7,y=1}, set = "Voucher", config = {extra = 15}, requires = {'v_blank'},unlock_condition = {type = 'blank_redeems', extra = 10}},'''
match_indent = true

[[patches]]
[patches.pattern]
target = 'game.lua'
pattern = '''v_tarot_tycoon=     {order = 18,    discovered = true, demo = true, unlocked = true, available = true,cost = 10, name = "Tarot Tycoon", pos = {x=1,y=1}, set = "Voucher", config = {extra = 32/4, extra_disp = 4}, requires = {'v_tarot_merchant'},unlock_condition = {type = 'c_tarots_bought', extra = 50}},'''
position = 'at'
payload = '''v_tarot_tycoon=     {order = 18,     discovered = false, unlocked = false, available = true,cost = 10, name = "Tarot Tycoon", pos = {x=1,y=1}, set = "Voucher", config = {extra = 32/4, extra_disp = 4}, requires = {'v_tarot_merchant'},unlock_condition = {type = 'c_tarots_bought', extra = 50}},'''
match_indent = true

[[patches]]
[patches.pattern]
target = 'game.lua'
pattern = '''v_planet_tycoon=    {order = 20,    discovered = true, demo = true, unlocked = true, available = true,cost = 10, name = "Planet Tycoon", pos = {x=2,y=1}, set = "Voucher", config = {extra = 32/4, extra_disp = 4}, requires = {'v_planet_merchant'},unlock_condition = {type = 'c_planets_bought', extra = 50}},'''
position = 'at'
payload = '''v_planet_tycoon=    {order = 20,     discovered = false, unlocked = false, available = true,cost = 10, name = "Planet Tycoon", pos = {x=2,y=1}, set = "Voucher", config = {extra = 32/4, extra_disp = 4}, requires = {'v_planet_merchant'},unlock_condition = {type = 'c_planets_bought', extra = 50}},'''
match_indent = true

[[patches]]
[patches.regex]
target = 'card.lua'
pattern = '''\(100-\(G\.GAME\.discount_percent or 0\)\)/100\)\)'''
position = 'at'
payload = '(100-G.GAME.discount_percent)/100))'

[[patches]]
[patches.regex]
target = 'functions/state_events.lua'
pattern = '''handname ~= disp_text and score_time\(0\.4\) or 0\}, \{handname=disp_text'''
position = 'at'
payload = 'handname ~= disp_text and 0.4 or 0}, {handname=disp_text'

[[patches]]
[patches.regex]
target = 'functions/UI_definitions.lua'
pattern = '''local challenge_unlocked = SMODS\.challenge_is_unlocked\(v, k\) or \(k > 20 and not v\.mod\)'''
position = 'at'
payload = 'local challenge_unlocked = SMODS.challenge_is_unlocked(v, k)'
end
