    for x = -1, 1 do
        for y = -1, 1 do
            if x ~= 0 or y ~= 0 then
                love.graphics.draw(
                    letter.letter,
                    0.5*(letter.dims.x - letter.offset.x + x*outline_scale)*self.font.FONTSCALE/G.TILESIZE + _shadow_norm.x,
                    0.5*(letter.dims.y - letter.offset.y + y*outline_scale)*self.font.FONTSCALE/G.TILESIZE + _shadow_norm.y, 
                    letter.r or 0,
r 32 304 %20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20 -
r 32 304 %20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20 -
