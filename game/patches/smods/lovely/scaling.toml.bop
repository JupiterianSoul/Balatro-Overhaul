# Turtle Bean
[[patches]]
[patches.pattern]
target = "card.lua"
pattern = '''
r 3 2926 - -
r 3 2927 - -
l 1
return {
r 3 2929 %20%20%20%20 -
l 24
    colour = G.C.FILTER
}
'''
position = 'at'
match_indent = true
payload = '''
SMODS.scale_card(self, {
    ref_table = self.ability.extra,
    ref_value = "h_size",
    scalar_value = "h_mod",
    message_key = 'a_handsize_minus',
    operation = function(ref_table, ref_value, initial, change)
        ref_table[ref_value] = initial - change
        G.hand:change_size(- change)
    end
})
return nil, true
'''

