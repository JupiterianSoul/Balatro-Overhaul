r 3 2982 %20%20%20%20%20%20%20%20 -
l 4
    }
end
'''
payload = '''
r 3 3552 - -
l 8
    SMODS.reset_card(self, {
        ref_table = self.ability,
        ref_value = 'x_mult',
        reset_value = 1
    })
    return nil, true
end
'''
end
