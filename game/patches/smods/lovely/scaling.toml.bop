BOP 1
eol lf
final 1
base 0
l 14
[manifest]
version = "1.0.0"
dump_lua = true
priority = -10

# SCALING VALUES

# Ceremonial Dagger
[[patches]]
[patches.pattern]
target = 'card.lua'
match_indent = true
position = 'at'
pattern = '''
r 3 2572 - -
l 32
'''
payload = '''
'''

[[patches]]
[patches.pattern]
target = "card.lua"
pattern = '''card_eval_status_text(self, 'extra', nil, nil, nil, {message = localize{type = 'variable', key = 'a_mult', vars = {self.ability.mult+2*sliced_card.sell_cost}}, colour = G.C.RED, no_juice = true})'''
position = 'at'
match_indent = true
payload = '''
SMODS.scale_card(self, {
    ref_table = self.ability,
    ref_value = "mult",
    scalar_table = sliced_card,
    scalar_value = "sell_cost",
    scalar_factor = 2,
    scaling_message = {
        message = localize{type = 'variable', key = 'a_mult', vars = {self.ability.mult+2*sliced_card.sell_cost}},
        colour = G.C.RED,
        no_juice = true
    }
})
'''

# Flash Card
[[patches]]
[patches.pattern]
target = 'card.lua'
match_indent = true
position = 'at'
pattern = '''
r 3 2405 - -
r 1 112 - -
l 1
    func = (function()
r 3 2408 %20%20%20%20%20%20%20%20 -
l 20
    return true
end)}))
'''
payload = '''
SMODS.scale_card(self, {
    ref_table = self.ability,
    ref_value = "mult",
    scalar_value = "extra",
    message_key = 'a_mult',
    message_colour = G.C.RED
})
return nil, true
'''
