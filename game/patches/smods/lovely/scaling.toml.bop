r 3 2432 %20%20%20%20%20%20%20%20 -
r 3 2447 %20%20%20%20%20%20%20%20%20%20%20%20 -
l 24
            colour = G.C.RED,
            delay = 0.45, 
            card = self
        }) 
        return true
    end}))
'''
