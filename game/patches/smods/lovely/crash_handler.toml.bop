BOP 1
eol lf
final 1
base 0
l 27
[manifest]
version = "1.0.0"
dump_lua = true
priority = -11

[[patches]]
[patches.pattern]
target = "main.lua"
pattern = "function love.errhand(msg)"
position = "at"
payload = "if false then"
match_indent = true

[[patches]]
[patches.copy]
target = "main.lua"
position = "prepend"
sources = [
    "src/crash_handler.lua",
]

[[patches]]
[patches.pattern]
target = 'game.lua'
match_indent = true
position = 'after'
pattern = '''
r 9 2021 - -
l 4
'''
payload = '''
if G.SAVED_GAME then SMODS.save_game = G.SAVED_GAME.GAME.smods_version else SMODS.save_game = nil end
'''
end
