# Update old_slots when required
[[patches]]
[patches.pattern]
target = 'game.lua'
match_indent = true
position = 'before'
pattern = '''
r 9 3236 - -
l 6
'''
payload = '''
if G.hand.config.card_limits.old_slots < G.hand.config.card_limits.total_slots then
    G.hand.config.card_limits.old_slots = G.hand.config.card_limits.total_slots
end
'''
