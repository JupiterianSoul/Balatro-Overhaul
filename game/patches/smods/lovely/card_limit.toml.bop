# CardArea:update()
# Add support for extra_slots_used parameter
[[patches]]
[patches.pattern]
target = 'cardarea.lua'
match_indent = true
position = 'at'
pattern = '''
r 6 266 - -
r 6 267 - -
l 14
'''
payload = '''
self:handle_card_limit()
self.config.temp_limit = math.max(#self.cards, self.config.card_limit or 0)
'''

# CardArea:draw()
# Change count display to use true_card_limit
[[patches]]
[patches.pattern]
target = 'cardarea.lua'
match_indent = true
position = 'at'
pattern = '''
e 6 287 - - =84,+%6C%61%6E%67%20%3D%20%47%2E%4C%41%4E%47%55%41%47%45%53%5B%27%65%6E%2D%75%73%27%5D%2C%20,=21
l 12
'''
payload = '''
{n=G.UIT.T, config={ref_table = self.config.card_limits, ref_value = 'display_slots', scale = 0.3, lang = G.LANGUAGES['en-us'], colour = G.C.WHITE}},
'''

