'''
# Hex SMODS.is_eternal and card.getting_sliced
[[patches]]
[patches.pattern]
target = 'card.lua'
match_indent = true
position = 'at'
pattern = '''
r 3 1491 - -
l 11
'''
payload = '''
if v ~= eligible_card and (not SMODS.is_eternal(v, self)) then v.getting_sliced = true; v:start_dissolve(nil, _first_dissolve);_first_dissolve = true end
'''
# Card:can_sell(), Add can_sell API method
[[patches]]
[patches.pattern]
target = 'card.lua'
match_indent = true
position = 'at'
pattern = '''
r 3 1649 - -
l 17
'''
payload = '''
not SMODS.is_eternal(self, {from_sell = true}) then

local obj = self.config.center
if self.ability.set ~= "Enhanced" and obj.can_sell and type(obj.can_sell) == 'function' then
	return obj:can_sell(self, context)
end
'''

# Adds tag_added context
[[patches]]
[patches.pattern]
target = 'functions/UI_definitions.lua'
match_indent = true
position = 'after'
pattern = '''
r 15 1270 - -
l 13
'''
payload = '''
if not _tag.from_load then SMODS.calculate_context({tag_added = _tag}) end
_tag.from_load = nil
'''

# Prevent tag added context on reloading
[[patches]]
[patches.pattern]
target = 'tag.lua'
match_indent = true
position = 'after'
pattern = '''
r 4 486 - -
l 12
'''
payload = '''
self.from_load = true
'''

# Fix Campfire 'upgrading' when it is sold
[[patches]]
[patches.pattern]
target = 'card.lua'
match_indent = true
position = 'at'
pattern = '''
r 3 2396 - -
l 25
'''
payload = '''
if self.ability.name == 'Campfire' and not context.blueprint and self ~= context.card then
'''

# Support for ante contexts
[[patches]]
[patches.pattern]
target = 'functions/state_events.lua'
match_indent = true
pattern = '''
delay(0.4); ease_ante(1); delay(0.4);
'''
position = 'at'
payload = '''
delay(0.4); SMODS.ante_end = true; ease_ante(1); SMODS.ante_end = nil; delay(0.4);
'''

# Sixth Sense only triggers once with multiple copies
[[patches]]
[patches.pattern]
target = 'card.lua'
match_indent = true
position = 'at'
pattern = '''
r 3 2604 - -
l 13
'''
payload = '''
if self.ability.name == 'Sixth Sense' and #context.full_hand == 1 and context.full_hand[1]:get_id() == 6 and not context.full_hand[1].sixth_sense and G.GAME.current_round.hands_played == 0 then
    context.full_hand[1].sixth_sense = true
'''

# Blueprint uses SMODS.blueprint_effect
[[patches]]
[patches.pattern]
target = 'card.lua'
match_indent = true
position = 'at'
pattern = '''
r 3 2309 - -
r 3 2310 %20%20%20%20 -
r 3 2311 %20%20%20%20 -
r 3 2312 %20%20%20%20 -
r 3 2313 %20%20%20%20 -
r 3 2314 %20%20%20%20 %20
r 3 2315 %20%20%20%20%20%20%20%20 -
r 3 2316 %20%20%20%20%20%20%20%20 -
r 3 2317 %20%20%20%20%20%20%20%20 -
l 18
    end
end
'''
payload = '''
local ret = SMODS.blueprint_effect(self, other_joker, context)
if ret then
    ret.colour = G.C.BLUE
    return ret
end
'''

# Brainstorm uses SMODS.blueprint_effect
[[patches]]
[patches.pattern]
target = 'card.lua'
match_indent = true
position = 'at'
pattern = '''
r 3 2309 - -
r 3 2310 %20%20%20%20 -
r 3 2311 %20%20%20%20 -
r 3 2312 %20%20%20%20 -
r 3 2313 %20%20%20%20 -
r 3 2314 %20%20%20%20 %20
r 3 2315 %20%20%20%20%20%20%20%20 -
r 3 2330 %20%20%20%20%20%20%20%20 -
r 3 2317 %20%20%20%20%20%20%20%20 -
l 18
    end
end
'''
payload = '''
local ret = SMODS.blueprint_effect(self, other_joker, context)
if ret then
    ret.colour = G.C.RED
    return ret
end
'''

# Prep from_cashout field for context.money_altered
[[patches]]
[patches.pattern]
target = 'functions/button_callbacks.lua'
match_indent = true
position = 'at'
pattern = '''
r 13 2938 - -
l 3
'''
payload = '''
SMODS.money_from_cashout = true
r 13 2938 - -
l 8
SMODS.money_from_cashout = nil
'''

# Add context.modify_final_cashout
[[patches]]
[patches.pattern]
target = "functions/state_events.lua"
pattern = '''
r 16 1202 %20%20%20%20 -
l 19
end
'''
position = "after"
payload = '''

    SMODS.cashout_pitch = pitch; SMODS.cashout_index = i; SMODS.cashout_dollars = dollars
    SMODS.calculate_context({modify_final_cashout = true, amount = dollars})
    dollars = SMODS.cashout_dollars
    SMODS.cashout_pitch = nil; SMODS.cashout_index = nil; SMODS.cashout_dollars = nil
'''
match_indent = false

# Reload SMODS.last_hand
[[patches]]
[patches.pattern]
target = 'game.lua'
match_indent = true
position = 'before'
pattern = '''
r 9 2326 - -
l 24
'''
payload = '''
if saveTable then
    if saveTable.SMODS then
        SMODS.last_hand = {scoring_hand = {}, full_hand = {}, scoring_name = saveTable.SMODS.last_hand.scoring_name}
        for _, v in ipairs({'scoring_hand','full_hand'}) do
            for _, card in ipairs(G.playing_cards) do
                if card.ability['SMODS_'..v] then
                    SMODS.last_hand[v][card.ability['SMODS_'..v]] = card
                end
            end
        end
	end
end
'''

# Draw to play area context
[[patches]]
[patches.pattern]
target = "functions/state_events.lua"
pattern = "table.sort(G.hand.highlighted, function(a,b) return a.T.x < b.T.x end)"
position = 'before'
match_indent = true
payload = '''
r 3 1227 - -
l 23
    local effects = {}
    SMODS.calculate_context({drawing_to_play_area = true, other_card = G.hand.cards[i], cardarea = G.hand, full_hand = G.hand.highlighted, ignore_other_debuff = true}, effects)
    local flags = SMODS.trigger_effects(effects, G.hand.cards[i])
    if flags.remove_from_hand then
        G.hand:remove_from_highlighted(G.hand.cards[i])
    elseif flags.add_to_hand then
        G.hand:add_to_highlighted(G.hand.cards[i])
    end
    if flags.return_to_hand and G.hand.cards[i].highlighted then
        G.hand.cards[i].ability.return_to_hand = true
    end
end
'''

[[patches]]
[patches.pattern]
target = "functions/state_events.lua"
pattern = "v.ability.forced_selection = nil"
position = 'after'
match_indent = true
payload = '''
v.ability.return_to_hand = nil
'''
end
