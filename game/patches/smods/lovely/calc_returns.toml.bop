BOP 1
eol lf
final 1
base 0
l 12
[manifest]
version = "1.0.0"
dump_lua = true
priority = -20

# Add support to attention text for UI nodes as a message
[[patches]]
[patches.pattern]
target = 'functions/UI_definitions.lua'
match_indent = true
position = 'before'
pattern = '''
r 15 919 - -
l 10
'''
payload = '''
type(args.text) == "table" and args.text.n and args.text or
'''
[[patches]]
[patches.pattern]
target = 'functions/UI_definitions.lua'
match_indent = true
position = 'at'
pattern = '''
r 15 925 - -
l 4
args.text:pulse(0.5)
'''
payload = '''
if type(args.text) == 'string' then
r 15 925 %20%20%20%20 -
l 16
    args.text:pulse(0.5)
end
'''
[[patches]]
[patches.pattern]
target = 'functions/UI_definitions.lua'
match_indent = true
position = 'at'
pattern = '''
args.text:pop_out(3)
'''
payload = '''
if Object.is(args.text, DynaText) then
    args.text:pop_out(3)
end
'''
end
