target = 'functions/state_events.lua'
match_indent = false
position = 'after'
pattern = '''
r 16 1064 %20%20 -
l 6
}))
score_delay(0.3)
'''
payload = '''
    SMODS.last_hand_score = SMODS.calculate_round_score()
    SMODS.last_hand_oneshot = SMODS.last_hand_score >= G.GAME.blind.chips
r 1 112 %20%20%20%20 -
r 2 398 %20%20%20%20%20%20 -
l 17
      func = (function() 
        for name, parameter in pairs(SMODS.Scoring_Parameters) do
            parameter.current = parameter.default_value
