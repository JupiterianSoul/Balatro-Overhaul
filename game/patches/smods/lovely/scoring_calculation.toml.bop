[patches.pattern]
target = 'functions/common_events.lua'
match_indent = true
position = 'before'
pattern = '''
r 1 112 - -
r 2 398 %20%20%20%20 -
r 13 491 %20%20%20%20 -
l 13
}))
'''
payload = '''
]]
'''

