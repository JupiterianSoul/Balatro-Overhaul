                "Utile pour le debug !",
            },
            sc_sub_tgl_perf_mode={
                "{C:attention}Mode Performance{} : réduit",
                "les effets visuels pour de",
                "meilleures performances.",
            },
            sc_sub_tgl_jimbo_comments={
                "{C:attention}Commentaires de Jimbo{} :",
