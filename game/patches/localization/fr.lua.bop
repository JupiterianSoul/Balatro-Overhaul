            },
            sc_sub_tgl_online={
                "{C:attention}Fonctions en ligne{} :",
                "active la connectivité réseau",
                "pour le multijoueur et plus.",
            },
            sc_sub_tgl_score_preview={
                "{C:attention}Aperçu du Score{} : affiche",
                "ton score estimé avant de",
                "jouer ta main. Très utile !",
            },
            sc_sub_tgl_joker_info={
                "{C:attention}Info Joker{} : affiche des",
