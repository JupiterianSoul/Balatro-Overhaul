            -- ==========================================
            -- FEATURE: Overhaul Showcase text keys
            -- ==========================================
            sc_welcome={
                "Salut ! Bienvenue dans",
                "{C:attention}Balatro Overhaul{} !",
                "Laisse-moi te montrer tout",
                "ce qui a été ajouté. Prêt ?",
            },
            sc_play={
                "Voici ton bouton {C:blue}Jouer{} !",
                "Tu as maintenant des {C:attention}Défis Quotidiens{},",
                "de nouveaux {C:attention}Défis{}, et un",
                "{C:attention}Créateur de Partie{} complet avec",
                "des réglages pour mains, défausses, argent...",
            },
            sc_achievements={
                "Voici le menu {C:attention}Succès{} !",
                "Il y a plus de {C:attention}200 succès{}",
                "avec {C:attention}5 niveaux de rareté{} à débloquer.",
                "Combien peux-tu en obtenir ?",
            },
            sc_collection={
                "La {C:green}Collection{} te permet de parcourir",
                "tous les jokers, tarots, planètes et plus.",
                "Plus {C:attention}4 nouvelles Mises Créatives{} !",
                "{C:attention}Chaos{}, {C:attention}Oubli{}, {C:attention}Apocalypse{},",
                "et {C:red}Transcendance{} attendent les braves !",
            },
            sc_progression={
                "La {C:green}Progression{} est toute neuve !",
                "Gagne de l'{C:attention}XP{} en jouant des mains,",
                "en franchissant des antes, en gagnant,",
                "et en {C:attention}complétant des quêtes{} !",
                "Monte à travers {C:attention}7 rangs{} !",
            },
            sc_tavern={
                "La {C:blue}Taverne{} est ton hub !",
                "Tu y trouveras les {C:attention}Quêtes{},",
                "ton {C:attention}Profil{}, la {C:money}Boutique{},",
                "le {C:attention}Créateur de Deck{}, et",
                "la {C:attention}Bibliothèque de Seeds{} !",
            },
            sc_multiplayer={
                "Le {C:blue}Multijoueur{} est arrivé !",
                "Affronte tes amis en ligne",
                "dans des parties compétitives.",
                "Que la meilleure main gagne !",
            },
            sc_settings={
                "Les {C:attention}Paramètres{} ont plein de nouveautés !",
                "Réglages de fonctionnalités, {C:attention}Performance{},",
                "config de l'{C:attention}Optimiseur{}, réglages {C:attention}Jimbo{},",
                "et le {E:1}Jukebox{} !",
                "Explore chaque sous-menu !",
            },
            sc_modmenu={
                "Active les {C:red}Triches{} dans Jouer >",
                "Nouvelle partie : un bouton {C:red}TRICHES{}",
                "apparaît. Place-le où tu veux !",
                "(Compte comme une partie à graine.)",
            },
            sc_farewell={
                "C'est tout ! {E:1}Amuse-toi bien{}",
                "en explorant toutes les nouveautés.",
                "Tu peux relancer cette visite",
                "depuis {C:attention}Paramètres{} > {C:attention}Nouveautés{}.",
                "Maintenant, va éclater des blinds !",
            },
            -- FEATURE: Sub-showcase text keys (contextual Jimbo tips)
            sc_sub_tavern_intro={
                "Bienvenue à la {C:blue}Taverne{} !",
                "C'est ton hub principal.",
                "Découvre les {C:attention}Quêtes{}, ton {C:attention}Profil{},",
                "la {C:money}Boutique{}, le {C:attention}Créateur de Deck{},",
                "et la nouvelle {C:attention}Bibliothèque de Seeds{} !",
            },
            sc_sub_quests={
                "Voici tes {C:attention}Quêtes{} !",
                "{C:blue}Quotidiennes{}, {C:green}hebdomadaires{}, et",
                "{C:attention}répétables{} — elles rapportent",
                "des {C:money}Balacoins{} et de l'{C:attention}XP{} !",
                "Suis tes séries aussi !",
            },
            sc_sub_quests_daily={
                "L'onglet {C:blue}Quotidiennes{} a des quêtes",
                "qui se réinitialisent toutes les {C:attention}24h{}.",
                "Complète-les pour des",
                "{C:money}Balacoins{} rapides !",
            },
            sc_sub_quests_weekly={
                "L'onglet {C:green}Hebdomadaires{} a des quêtes",
                "plus difficiles, reset tous les {C:attention}7 jours{}.",
                "De plus grosses récompenses",
                "pour de plus grands défis !",
            },
            sc_sub_quests_repeatable={
                "Les quêtes {C:attention}Répétables{} n'expirent jamais.",
                "Complète-les autant de fois",
                "que tu veux pour un revenu",
                "régulier de {C:money}Balacoins{} !",
            },
            sc_sub_profile={
                "Voici ton {C:attention}Profil{} !",
                "Personnalise ton apparence avec",
                "{C:attention}6 onglets{} d'options.",
                "Laisse-moi te montrer !",
            },
            sc_sub_profile_colors={
                "L'onglet {C:attention}Couleurs{} te permet",
                "de changer la palette de ton profil.",
                "Débloque-en plus dans",
                "la {C:money}Boutique{} !",
            },
            sc_sub_profile_icon={
                "L'onglet {C:attention}Icône{} te permet",
                "de choisir ta photo de profil.",
                "Les icônes se débloquent en jouant !",
            },
            sc_sub_profile_icon_effect={
                "Les {C:attention}Effets d'icône{} ajoutent du style",
                "à ton icône de profil —",
                "holographique, foil, et plus !",
            },
            sc_sub_profile_decks={
                "L'onglet {C:attention}Decks{} montre tous",
                "tes dos de deck. Inclut les",
                "decks personnalisés que tu as créés !",
            },
            sc_sub_profile_badges={
                "L'onglet {C:attention}Badges{} montre tes",
                "badges de boss. Équipes-en un",
                "pour {C:gold}désactiver{} l'effet du boss !",
            },
            sc_sub_profile_jimbo_skin={
                "L'onglet {E:1}Skin de Jimbo{} te permet",
                "de changer l'apparence de Jimbo !",
                "Achète des skins dans la {C:money}Boutique{}.",
            },
            sc_sub_shop={
                "Bienvenue à la {C:money}Boutique Balacoins{} !",
                "Dépense tes {C:money}Balacoins{} en cosmétiques.",
                "Laisse-moi te montrer chaque section !",
            },
            sc_sub_shop_jimbo_skins={
                "L'onglet {E:1}Skins de Jimbo{} propose",
                "des skins uniques pour Jimbo.",
                "Achète-les avec des {C:money}Balacoins{} !",
            },
            sc_sub_shop_colors={
                "L'onglet {C:attention}Couleurs{} vend",
                "des palettes de couleurs de profil.",
                "Chacune change toute l'apparence",
                "de ton profil !",
            },
            sc_sub_shop_icon_effects={
                "L'onglet {C:attention}Effets d'icône{} propose",
                "des effets spéciaux pour ton",
                "icône de profil. Fais-le briller !",
            },
            sc_sub_achievements={
                "Parcours tes {C:attention}Succès{} !",
                "Un onglet par partie du jeu,",
                "le {C:attention}jeton{} montre sa rareté.",
                "Les déblocages s'affichent en jeu !",
            },
            sc_sub_progression={
                "Ta page de {C:green}Progression{} !",
                "Vois ton rang actuel, ta barre d'XP,",
                "et tes jalons. Continue à jouer",
                "pour monter en rang !",
            },
            sc_sub_collection={
                "La {C:green}Collection{} montre tout",
                "ce que tu as découvert. Consulte",
                "l'onglet {C:attention}Mises{} pour les 4 nouvelles",
                "Mises Créatives !",
            },
            sc_sub_multiplayer={
                "Bienvenue en {C:blue}Multijoueur{} !",
                "Crée une salle ou rejoins-en une.",
                "Joue en face-à-face contre",
                "un autre joueur en ligne !",
            },
            -- FEATURE: Settings sub-showcase (per-setting walkthrough)
            sc_sub_settings_welcome={
                "Bienvenue dans les {C:attention}Paramètres{} !",
                "Laisse-moi te présenter",
                "toutes les nouveautés ici.",
            },
            sc_sub_settings_gamespeed={
                "{C:attention}Vitesse du jeu{} : contrôle la",
                "vitesse des animations de cartes.",
                "Plus haut = plus rapide !",
            },
            sc_sub_settings_fps_cap={
                "{C:attention}Limite FPS{} : limite les",
                "images par seconde pour économiser",
                "la batterie ou déplafonner.",
            },
            sc_sub_settings_score_speed={
                "{C:attention}Vitesse du score{} : vitesse",
                "du compteur de score.",
                "Mets {C:red}Instantané{} pour le passer !",
            },
            sc_sub_settings_toggles={
                "Ces {C:attention}interrupteurs{} contrôlent :",
                "{C:attention}Triches{}, {C:attention}Aperçu du Score{},",
                "{C:attention}Info Joker{}, {C:attention}Optimiseur{},",
                "{C:attention}Glisser pour Sélect.{}, {C:attention}Compteur FPS{},",
                "{C:attention}Mode Performance{}, et plus !",
            },
            -- FEATURE: Individual toggle/button showcase steps
            sc_sub_tgl_modmenu={
                "{C:attention}Désactiver les triches{} : cache",
