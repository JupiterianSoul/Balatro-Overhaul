            sc_welcome={
                "¡Hola! Bienvenido a",
                "{C:attention}Balatro Overhaul{}.",
                "Déjame enseñarte todo",
                "lo que se ha añadido. ¿Listo?",
            },
            sc_play={
                "¡Este es tu botón {C:blue}Jugar{}!",
                "Ahora tienes {C:attention}Carreras Diarias{},",
                "nuevos {C:attention}Desafíos{}, y un",
                "{C:attention}Creador de Partida{} completo con",
                "ajustes para manos, descartes, dinero...",
            },
            sc_achievements={
                "¡Aquí está el menú de {C:attention}Logros{}!",
                "Hay más de {C:attention}200 logros{}",
                "con {C:attention}5 niveles de rareza{} por desbloquear.",
                "¿Cuántos puedes conseguir?",
            },
            sc_collection={
                "La {C:green}Colección{} te permite explorar",
                "todos los jokers, tarots, planetas y más.",
                "¡Más {C:attention}4 nuevas Apuestas Creativas{}!",
                "{C:attention}Caos{}, {C:attention}Olvido{}, {C:attention}Apocalipsis{},",
                "¡y {C:red}Trascendencia{} esperan a los valientes!",
            },
            sc_progression={
                "¡La {C:green}Progresión{} es totalmente nueva!",
                "Gana {C:attention}XP{} jugando manos,",
                "superando antes, ganando partidas,",
                "¡y {C:attention}completando misiones{}!",
                "¡Sube a través de {C:attention}7 rangos{}!",
            },
            sc_tavern={
                "¡La {C:blue}Taberna{} es tu centro!",
                "Dentro encontrarás {C:attention}Misiones{},",
                "tu {C:attention}Perfil{}, la {C:money}Tienda{},",
                "el {C:attention}Creador de Mazo{}, y",
                "¡la {C:attention}Biblioteca de Seeds{}!",
            },
            sc_multiplayer={
                "¡El {C:blue}Multijugador{} está aquí!",
                "Juega contra amigos en línea",
                "en partidas competitivas de Balatro.",
                "¡Que gane la mejor mano!",
            },
            sc_settings={
                "¡{C:attention}Ajustes{} tiene muchas novedades!",
                "Controles de funciones, ajustes de {C:attention}Rendimiento{},",
                "config del {C:attention}Optimizador{}, ajustes de {C:attention}Jimbo{},",
                "¡y el {E:1}Jukebox{}!",
                "¡Explora cada submenú!",
            },
            sc_modmenu={
                "Activa los {C:red}Trucos{} en Jugar >",
                "Nueva partida: aparece un botón {C:red}TRUCOS{}.",
                "¡Muévelo donde quieras!",
                "(Cuenta como partida con semilla.)",
            },
            sc_farewell={
                "¡Eso es todo! {E:1}Pásala bien{}",
                "explorando todas las novedades.",
                "Puedes repetir este recorrido",
                "desde {C:attention}Ajustes{} > {C:attention}Novedades{}.",
                "¡Ahora ve a reventar algunas blinds!",
            },
            sc_sub_tavern_intro={
                "¡Bienvenido a la {C:blue}Taberna{}!",
                "Este es tu centro principal.",
                "Descubre las {C:attention}Misiones{}, tu {C:attention}Perfil{},",
                "la {C:money}Tienda{}, el {C:attention}Creador de Mazo{},",
                "¡y la nueva {C:attention}Biblioteca de Seeds{}!",
            },
            sc_sub_quests={
                "¡Aquí están tus {C:attention}Misiones{}!",
                "{C:blue}Diarias{}, {C:green}semanales{}, y",
                "{C:attention}repetibles{} — te dan",
                "{C:money}Balacoins{} y {C:attention}XP{}!",
                "¡Sigue tus rachas también!",
            },
            sc_sub_quests_daily={
                "La pestaña {C:blue}Diarias{} tiene misiones",
                "que se reinician cada {C:attention}24 horas{}.",
                "¡Complétalas para ganar",
                "{C:money}Balacoins{} rápidos!",
            },
            sc_sub_quests_weekly={
                "La pestaña {C:green}Semanales{} tiene misiones",
                "más difíciles, se reinician cada {C:attention}7 días{}.",
                "¡Mayores recompensas para",
                "mayores desafíos!",
            },
            sc_sub_quests_repeatable={
                "Las misiones {C:attention}Repetibles{} nunca expiran.",
                "¡Complétalas tantas veces",
                "como quieras para un ingreso",
                "constante de {C:money}Balacoins{}!",
            },
            sc_sub_profile={
                "¡Este es tu {C:attention}Perfil{}!",
                "Personaliza tu apariencia con",
                "{C:attention}6 pestañas{} de opciones.",
                "¡Déjame mostrarte cada una!",
            },
            sc_sub_profile_colors={
                "La pestaña {C:attention}Colores{} te permite",
                "cambiar la paleta de tu perfil.",
                "¡Desbloquea más desde",
