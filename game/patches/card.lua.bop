r 3 1593 %20%20%20%20 -
l 25
    if not area then return end
    if area == G.hand and area:can_highlight(self) then
        if G.STATE == G.STATES.HAND_PLAYED then return end
        if self.highlighted ~= true then area:add_to_highlighted(self) end
    end
    if area == G.pack_cards and not self.ability.consumeable and can_select_pack_card(self) then
        swipe_use(self)
        return
    end
    if area == G.shop_jokers or area == G.shop_booster or area == G.shop_vouchers then
        local set = self.ability.set
        if (set == 'Booster' or set == 'Voucher') and swipe_affordable(self) then
            swipe_use(self)
            return
        end
        if area == G.shop_jokers and G.FUNCS.card_can_buy(self) then
            G.FUNCS.buy_from_shop({config = {ref_table = self, id = 'buy'}})
            return
        end
    end
    if self.ability.consumeable and (area == G.consumeables or area == G.pack_cards) and self:can_use_consumeable() then
        swipe_use(self)
    end
end

