local function saved_big_to_number(v)
    if type(v.val) == 'number' then return v.val end
    local sign = v.sign == -1 and -1 or 1
    if type(v.array) == 'table' and #v.array <= 1 then return sign * (tonumber(v.array[1]) or 0) end
    return sign * math.huge
end

local function plain_saved_numbers(t, seen)
    seen = seen or {}
    if seen[t] then return end
    seen[t] = true
