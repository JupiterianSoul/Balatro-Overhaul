local function default_load_lists()
    local local_files, names = {['settings.jkr'] = true}, {'settings.jkr'}
    for slot = 1, 3 do
        for _, file in ipairs({'profile.jkr', 'save.jkr', 'meta.jkr', 'unlock_notify.jkr'}) do
            names[#names + 1] = slot..'/'..file
        end
        local_files[slot..'/save.jkr'] = true
        local_files[slot..'/unlock_notify.jkr'] = true
    end
    return local_files, names
end

function Game:load_all_files()
    local handler = G.LOAD_HANDLER or {}
    G.LOAD_HANDLER = handler
    if not (handler.LOCAL_FILES and handler.FILE_NAMES) then
        local local_files, names = default_load_lists()
        handler.LOCAL_FILES = handler.LOCAL_FILES or local_files
        handler.FILE_NAMES = handler.FILE_NAMES or names
    end
    if not G.FILES then G.FILES = {} end
    handler.FILE_STATUS = {}
    for _, name in ipairs(handler.FILE_NAMES) do
        handler.FILE_STATUS[name] = {_status = 'LOADING'}
        self:load_file(name)
    end
end

