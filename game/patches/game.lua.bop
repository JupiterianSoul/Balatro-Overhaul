function Game:collect_loaded_files()
    local handler = G.LOAD_HANDLER
    if not (handler and handler.loading) then return end
    local reply = G.LOAD_MANAGER.return_channel:pop()
    local status = reply and reply._status
    local entry = reply and handler.FILE_STATUS[reply._filename]
    if entry and (status == 'OK' or status == 'NOT FOUND') then
        if status == 'OK' then G.FILES[reply._filename] = reply._content end
        entry._status = status
c 1
s 1
l 8
    for _, file in pairs(handler.FILE_STATUS) do
        if file._status ~= 'OK' and file._status ~= 'NOT FOUND' then return end
    end
    G:refresh()
    handler.loading = nil
end

