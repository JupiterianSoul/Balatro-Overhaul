local orig_ui = Card.generate_UIBox_ability_table
function Card:generate_UIBox_ability_table(...)
    local cfg = self.ability and self.ability.rnd and self.ability.rnd_cfg
    if not cfg then return orig_ui(self, ...) end
    local real = self.config.center
    self.config.center = setmetatable({config = cfg}, {__index = real})
    local ok, r = pcall(orig_ui, self, ...)
    self.config.center = real
    if not ok then error(r) end
    return r
end

local orig_open = Card.open
function Card:open(...)
    local cfg = self.ability and self.ability.set == 'Booster' and self.ability.rnd and self.ability.rnd_cfg
    local r = orig_open(self, ...)
    if cfg and G.GAME and G.GAME.pack_choices then
        local base = self.config.center.config.choose or 1
        G.GAME.pack_choices = math.max(1, G.GAME.pack_choices - base + (cfg.choose or base))
    end
    return r
end

for _, name in ipairs({'create_UIBox_arcana_pack', 'create_UIBox_spectral_pack', 'create_UIBox_standard_pack', 'create_UIBox_buffoon_pack', 'create_UIBox_celestial_pack'}) do
    local orig = _G[name]
    if orig then
        _G[name] = function(...)
            local r = orig(...)
            local size = G.GAME and G.GAME.pack_size or 0
            if size > 5 and G.pack_cards and G.pack_cards.T then
                local w = math.min(G.pack_cards.T.w, ((UIK and UIK.portrait and UIK.portrait()) and 4.4 or 5.5) * G.CARD_W)
                G.pack_cards.T.w = w
                if G.pack_cards.VT then G.pack_cards.VT.w = w end
            end
            return r
        end
    end
end

local orig_start = Game.start_run
function Game:start_run(args, ...)
    local r = orig_start(self, args, ...)
    if not (args and args.savetext) and RZ.active() and G.GAME and not G.GAME.rnd_hands then
        local ok, err = pcall(RZ.roll_hands)
        if not ok then print('[RANDOMIZER] hands: ' .. tostring(err)) end
    end
    return r
end

return RZ
end
