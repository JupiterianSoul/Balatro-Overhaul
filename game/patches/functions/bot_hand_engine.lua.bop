l 92
        for _, j in ipairs(G.jokers.cards) do
            parts[#parts+1] = j.config.center.key
        end
    end
    -- Hands/discards left
    if G.GAME and G.GAME.current_round then
        parts[#parts+1] = tostring(G.GAME.current_round.hands_left or 0)
        parts[#parts+1] = tostring(G.GAME.current_round.discards_left or 0)
    end
    return table.concat(parts, '|')
end

--- Get rank name for a card ID.
local function rank_name(id)
    if id == 14 or id == 1 then return 'A' end
    if id == 13 then return 'K' end
    if id == 12 then return 'Q' end
    if id == 11 then return 'J' end
    if id == 10 then return '10' end
    return tostring(id)
end

--- Get short suit symbol.
local function suit_sym(suit)
    if suit == 'Hearts'   then return "\xe2\x99\xa5" end
    if suit == 'Diamonds' then return "\xe2\x99\xa6" end
    if suit == 'Clubs'    then return "\xe2\x99\xa3" end
    if suit == 'Spades'   then return "\xe2\x99\xa0" end
    return suit and suit:sub(1, 1) or '?'
end

--- Short enhancement abbreviation for a playing card, e.g. "[Gl]" for Glass Card.
local EHLABELS = {
    ['Bonus Card']  = 'Bo', ['Mult Card']  = 'Mu', ['Glass Card'] = 'Gl',
    ['Steel Card']  = 'St', ['Stone Card'] = 'Sn', ['Gold Card']  = 'Au',
    ['Lucky Card']  = 'Lu', ['Wild Card']  = 'Wi',
}
local function enhancement_abbr(card)
    if card and card.ability and card.ability.set == 'Enhanced' then
        return EHLABELS[card.ability.name]
    end
end

--- Describe a card briefly, including enhancement tag when present.
--- Examples: "K♥", "3♦[Gl]", "A♣[Lu]"
local function card_label(card)
    if not card then return '?' end
    local id   = card.base and card.base.id or card:get_id()
    local suit = card.base and card.base.suit or ''
    local lbl  = rank_name(id) .. suit_sym(suit)
    local abbr = enhancement_abbr(card)
    if abbr then lbl = lbl .. '[' .. abbr .. ']' end
    return lbl
end

--- Suit display color: respects high-contrast setting (colourblind_option).
local function suit_color(suit)
    if G.SETTINGS and G.SETTINGS.colourblind_option then
        -- High-contrast card mode: red ♥, yellow ♦, blue ♣, dark-gray ♠
        if suit == 'Hearts'   then return {1,    0.20, 0.15, 1} end
        if suit == 'Diamonds' then return {0.95, 0.82, 0.10, 1} end
        if suit == 'Clubs'    then return {0.15, 0.62, 0.95, 1} end
        if suit == 'Spades'   then return {0.55, 0.55, 0.60, 1} end
    end
    -- Normal mode: red for Hearts/Diamonds, white for Clubs/Spades
    if suit == 'Hearts' or suit == 'Diamonds' then
        return G.C.RED or {1, 0.2, 0.2, 1}
    end
    return G.C.UI.TEXT_LIGHT or {1, 1, 1, 1}
end

local function white_text_colour()
    return (G and G.C and G.C.WHITE) or (G and G.C and G.C.UI and G.C.UI.TEXT_LIGHT) or {1, 1, 1, 1}
end

local function ui_scale(value, mult)
    return value * mult
end

local function compact_scale_mult()
    local pct = G and G.SETTINGS and G.SETTINGS.ho_compact_scale or 100
    return math.max(60, math.min(170, pct)) / 100
end

local function panel_scale_mult()
    local pct = G and G.SETTINGS and G.SETTINGS.ho_panel_scale or 100
    return math.max(60, math.min(170, pct)) / 100
end

