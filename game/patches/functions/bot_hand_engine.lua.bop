--- Pick the weakest joker category using proper tri-min logic.
--- Tie-break priority: xmult > mult > chips (multiplicative > additive scaling).
local function find_weakest(lineup)
    local m = math.min(lineup.xmult, lineup.mult, lineup.chips)
    if lineup.xmult == m then return 'xmult'
    elseif lineup.mult  == m then return 'mult'
    else return 'chips' end
end

--- Classify a joker as 'xmult' / 'mult' / 'chips' / 'econ' / 'retrigger' / 'utility'.
--- Uses JOKER_DB name table first, then falls back to runtime ability fields.
local function classify_joker(joker)
    if not joker then return 'utility' end
    local name = (joker.ability and joker.ability.name) or
                 (joker.config and joker.config.center and joker.config.center.name) or ''
    local db = JOKER_DB[name]
    if db then return db.type end
    local ab = joker.ability or {}
    local ed = joker.edition or {}
    if (ab.x_mult and ab.x_mult > 1) or (ab.Xmult and ab.Xmult > 1) or ed.x_mult then
        return 'xmult'
    end
    if (ab.mult and ab.mult ~= 0) or (ab.t_mult and ab.t_mult ~= 0) or ed.mult then
        return 'mult'
    end
    if (ab.chips and ab.chips ~= 0) or (ab.t_chips and ab.t_chips ~= 0) or ed.chips then
        return 'chips'
    end
    return 'utility'
end

--- Build a snapshot of the current run context for synergy checks.
--- Returns a table of boolean flags the advisor uses to score jokers contextually.
local function build_run_context()
    local ctx = {}
    if not G or not G.GAME then return ctx end
    -- Hand play frequencies
    ctx.hands = {}
    ctx.most_played = nil
    local most_count = 0
    if G.GAME.hands then
        for hname, info in pairs(G.GAME.hands) do
            if info.visible then
                ctx.hands[hname] = {
                    played  = info.played or 0,
                    level   = info.level or 1,
                    l_chips = info.l_chips or 0,
                    l_mult  = info.l_mult or 0,
                    s_chips = info.s_chips or info.chips or 0,
                    s_mult  = info.s_mult or info.mult or 0,
                }
                if (info.played or 0) > most_count then
                    most_count = info.played or 0
                    ctx.most_played = hname
                end
            end
        end
    end
    -- Deck composition
    ctx.deck_size = 0
    ctx.suits = {Spades=0, Hearts=0, Clubs=0, Diamonds=0}
    ctx.ranks = {}
    ctx.face_count = 0
    ctx.enhanced_count = 0
    ctx.stone_count = 0
    ctx.steel_count = 0
    ctx.glass_count = 0
    ctx.gold_count = 0
    ctx.lucky_count = 0
    ctx.wild_count = 0
    local all_cards = {}
    local function scan_area(area)
        if area and area.cards then
            for _, c in ipairs(area.cards) do
                all_cards[#all_cards+1] = c
            end
        end
    end
    scan_area(G.deck)
    scan_area(G.hand)
    scan_area(G.play)
    scan_area(G.discard)
    for _, c in ipairs(all_cards) do
        ctx.deck_size = ctx.deck_size + 1
        local suit = c.base and c.base.suit
        if suit and ctx.suits[suit] then ctx.suits[suit] = ctx.suits[suit] + 1 end
        local id = c.base and c.base.id or 0
        ctx.ranks[id] = (ctx.ranks[id] or 0) + 1
        if id >= 11 or id == 1 then ctx.face_count = ctx.face_count + 1 end -- J/Q/K + Ace under some jokers
        local ab = c.ability or {}
        if ab.name and ab.name ~= '' and ab.name ~= 'Base Card' then
            ctx.enhanced_count = ctx.enhanced_count + 1
            if ab.name == 'Stone Card' then ctx.stone_count = ctx.stone_count + 1 end
            if ab.name == 'Steel Card' then ctx.steel_count = ctx.steel_count + 1 end
            if ab.name == 'Glass Card' then ctx.glass_count = ctx.glass_count + 1 end
            if ab.name == 'Gold Card'  then ctx.gold_count  = ctx.gold_count + 1 end
            if ab.name == 'Lucky Card' then ctx.lucky_count = ctx.lucky_count + 1 end
            if ab.name == 'Wild Card'  then ctx.wild_count  = ctx.wild_count + 1 end
        end
    end
    -- Game state
    ctx.dollars     = G.GAME.dollars or 0
    ctx.ante        = G.GAME.round_resets and G.GAME.round_resets.ante or 1
    ctx.hands_left  = G.GAME.current_round and G.GAME.current_round.hands_left or 4
    ctx.discards_left = G.GAME.current_round and G.GAME.current_round.discards_left or 3
    ctx.joker_count = G.jokers and G.jokers.cards and #G.jokers.cards or 0
    ctx.joker_limit = G.jokers and G.jokers.config and G.jokers.config.card_limit or 5
    ctx.joker_slots_free = ctx.joker_limit - ctx.joker_count
    ctx.consumable_count = G.consumeables and G.consumeables.cards and #G.consumeables.cards or 0
    ctx.consumable_limit = G.consumeables and G.consumeables.config and G.consumeables.config.card_limit or 2
    ctx.consumable_slots_free = ctx.consumable_limit - ctx.consumable_count
    ctx.hand_size = (G.hand and G.hand.config and G.hand.config.hand_size) or
                    (G.hand and G.hand.cards and #G.hand.cards) or 5
    -- Joker names in lineup (for synergy: uncommon count, blueprint presence, etc.)
    ctx.joker_names = {}
    ctx.uncommon_joker_count = 0
r 13 2531 %20%20%20%20 -
l 289
        for _, j in ipairs(G.jokers.cards) do
            local n = (j.ability and j.ability.name) or ''
            ctx.joker_names[n] = true
            if j.config and j.config.center and j.config.center.rarity == 2 then
                ctx.uncommon_joker_count = ctx.uncommon_joker_count + 1
            end
        end
    end
    -- Planets used this run
    ctx.unique_planets_used = 0
    if G.GAME.consumeable_usage and G.GAME.consumeable_usage.planet then
        for _ in pairs(G.GAME.consumeable_usage.planet) do
            ctx.unique_planets_used = ctx.unique_planets_used + 1
        end
    end
    -- Tarots used this run
    ctx.tarots_used = 0
    if G.GAME.consumeable_usage and G.GAME.consumeable_usage.tarot then
        for _, v in pairs(G.GAME.consumeable_usage.tarot) do
            ctx.tarots_used = ctx.tarots_used + (v.count or 0)
        end
    end
    return ctx
end

--- Score a joker from JOKER_DB using full run context. Returns rating (0-7) and reason string.
local function score_joker_contextual(name, db_entry, ctx, lineup)
    local d = db_entry
    local rating = d.tier  -- baseline from DB
    local reasons = {}

    -- Type-based scaling
    local cat = d.type
    if cat == 'xmult'    then reasons[#reasons+1] = 'xMult'
    elseif cat == 'mult'  then reasons[#reasons+1] = '+Mult'
    elseif cat == 'chips' then reasons[#reasons+1] = '+Chips'
    elseif cat == 'econ'  then reasons[#reasons+1] = 'Economy'
    elseif cat == 'retrigger' then reasons[#reasons+1] = 'Retrigger'
    else reasons[#reasons+1] = 'Utility' end

    -- Map type to lineup category for gap detection
    local lineup_cat = cat
    if cat == 'econ' or cat == 'retrigger' or cat == 'utility' then lineup_cat = nil end

    if lineup_cat then
        local weakest = find_weakest(lineup)
        if lineup_cat == weakest then
            rating = rating + 1
            reasons[#reasons+1] = 'fills gap!'
        end
        if lineup[lineup_cat] and lineup[lineup_cat] >= 3 then
            rating = math.max(1, rating - 1)
            reasons[#reasons+1] = 'saturated'
        end
    end

    -- Synergy bonuses — check each tag
    if d.syn then
        for _, tag in ipairs(d.syn) do
            -- Suit synergies: bonus if lots of that suit in deck
            if tag:sub(1,5) == 'suit_' then
                local s = tag:sub(6)
                if ctx.suits and ctx.suits[s] and ctx.suits[s] >= 8 then
                    rating = rating + 1; reasons[#reasons+1] = s .. ' deck'
                    break
                end
            end
            -- Hand type synergies: bonus if that hand is played frequently
            if tag:sub(1,5) == 'hand_' then
                local h = tag:sub(6)
                if ctx.hands and ctx.hands[h] and (ctx.hands[h].played or 0) >= 3 then
                    rating = rating + 1; reasons[#reasons+1] = h .. ' player'
                    break
                end
            end
            -- Specific synergies
            if tag == 'face_cards' and ctx.face_count >= 10 then
                rating = rating + 1; reasons[#reasons+1] = 'face-heavy deck'; break
            end
            if tag == 'scaling' and ctx.ante >= 4 then
                rating = rating + 1; reasons[#reasons+1] = 'scales well late'; break
            end
            if tag == 'discards' and ctx.discards_left >= 3 then
                rating = rating + 1; reasons[#reasons+1] = 'discard synergy'; break
            end
            if tag == 'save_money' and ctx.dollars >= 15 then
                rating = rating + 1; reasons[#reasons+1] = 'money synergy'; break
            end
            if tag == 'many_jokers' and ctx.joker_count >= 4 then
                rating = rating + 1; reasons[#reasons+1] = 'full lineup'; break
            end
            if tag == 'planet_use' and ctx.unique_planets_used >= 3 then
                rating = rating + 1; reasons[#reasons+1] = 'planet user'; break
            end
            if tag == 'tarot_use' and ctx.tarots_used >= 5 then
                rating = rating + 1; reasons[#reasons+1] = 'tarot user'; break
            end
            if tag == 'steel_cards' and ctx.steel_count >= 2 then
                rating = rating + 1; reasons[#reasons+1] = 'steel synergy'; break
            end
            if tag == 'glass_cards' and ctx.glass_count >= 2 then
                rating = rating + 1; reasons[#reasons+1] = 'glass synergy'; break
            end
            if tag == 'lucky_cards' and ctx.lucky_count >= 2 then
                rating = rating + 1; reasons[#reasons+1] = 'lucky synergy'; break
            end
            if tag == 'gold_cards' and ctx.gold_count >= 2 then
                rating = rating + 1; reasons[#reasons+1] = 'gold synergy'; break
            end
            if tag == 'stone_cards' and ctx.stone_count >= 3 then
                rating = rating + 1; reasons[#reasons+1] = 'stone synergy'; break
            end
            if tag == 'enhanced' and ctx.enhanced_count >= 5 then
                rating = rating + 1; reasons[#reasons+1] = 'enhanced deck'; break
            end
            if tag == '16_enhanced' and ctx.enhanced_count >= 12 then
                rating = rating + 1; reasons[#reasons+1] = ctx.enhanced_count .. ' enhanced'; break
            end
            if tag == 'uncommon_jokers' and ctx.uncommon_joker_count >= 2 then
                rating = rating + 1; reasons[#reasons+1] = ctx.uncommon_joker_count .. ' uncommon'; break
            end
            if tag == 'small_deck' and ctx.deck_size < 42 then
                rating = rating + 1; reasons[#reasons+1] = 'thin deck'; break
            end
            if tag == 'big_deck' and ctx.deck_size > 52 then
                rating = rating + 1; reasons[#reasons+1] = 'large deck'; break
            end
            if tag == 'probabilities' then
                rating = rating + 1; reasons[#reasons+1] = 'doubles all odds'; break
            end
            if tag == 'boss_blind' then
                reasons[#reasons+1] = 'boss utility'; break
            end
            if tag == 'skip_blinds' then
                reasons[#reasons+1] = 'skip synergy'; break
            end
            if tag == 'reroll' then
                reasons[#reasons+1] = 'reroll synergy'; break
            end
        end
    end

    rating = math.min(7, math.max(1, rating))
    return rating, table.concat(reasons, ', ')
end

--- Score a planet card based on hand play data and current levels.
local function score_planet_contextual(planet_name, ctx)
    local ht = PLANET_HAND[planet_name]
    if not ht then return 2, planet_name or '?' end
    local hi = ctx.hands and ctx.hands[ht]
    if not hi then
        return 1, ht .. ' (not played)'
    end
    -- Compute value: play frequency * level-up gain
    local gain = (hi.l_chips * (hi.s_mult + hi.l_mult * hi.level)) +
                 (hi.l_mult * (hi.s_chips + hi.l_chips * hi.level))
    local val = math.max(hi.played, 1) * gain
    local rating = math.min(5, math.max(1, math.floor(val / 50 + 1)))
    -- Boost if it's the most-played hand
    if ht == ctx.most_played then
        rating = math.min(5, rating + 1)
    end
    local reason = ht .. ' Lv' .. hi.level
    if hi.played > 0 then reason = reason .. ' (x' .. hi.played .. ')' end
    reason = reason .. ' +' .. hi.l_chips .. 'c +' .. hi.l_mult .. 'm'
    return rating, reason
end

--- Score a tarot card based on full context (deck composition, hand size, etc.)
local function score_tarot_contextual(name, ctx)
    local td = TAROT_DB[name]
    if not td then return 2, 'Tarot card' end
    local rating = td.tier
    local reasons = {td.desc}

    -- Enhancement tarots: bonus if lots of unenhanced cards to target
    if td.cat == 'enhancement' then
        local unenhanced = ctx.deck_size - ctx.enhanced_count
        if unenhanced >= 20 then rating = math.min(5, rating + 1); reasons[#reasons+1] = 'many targets' end
    end
    -- Suit change tarots: bonus if building flush and that suit is dominant
    if td.cat == 'suit_change' and td.suit then
        local most_suit, most_count = nil, 0
        for s, v in pairs(ctx.suits or {}) do if v > most_count then most_count=v; most_suit=s end end
        if td.suit == most_suit then
            rating = math.min(5, rating + 1); reasons[#reasons+1] = 'dominant suit!'
        end
        -- Check if playing flush-heavy
        if ctx.hands and ctx.hands['Flush'] and (ctx.hands['Flush'].played or 0) >= 3 then
            rating = math.min(5, rating + 1); reasons[#reasons+1] = 'flush player'
        end
    end
    -- Economy tarots
    if name == 'The Hermit' then
        if ctx.dollars >= 10 then rating = 5; reasons = {'Double $' .. ctx.dollars .. ' (up to $20)'}
        elseif ctx.dollars <= 3 then rating = 2; reasons = {'Low money, weak double'} end
    end
    if name == 'Temperance' then
        if ctx.joker_count >= 4 then rating = math.min(5, rating + 1); reasons[#reasons+1] = ctx.joker_count .. ' jokers' end
    end
    -- Generation tarots: check consumable space
    if td.cat == 'generation' then
        if ctx.consumable_slots_free <= 0 then
            rating = math.max(1, rating - 1); reasons[#reasons+1] = 'NO SLOT!'
        end
    end
    -- Destruction: useful if deck is cluttered
    if name == 'The Hanged Man' then
        if ctx.deck_size > 55 then rating = math.min(5, rating + 1); reasons[#reasons+1] = 'thin the deck' end
    end
    -- Judgement: always premium
    if name == 'Judgement' then
        if ctx.joker_slots_free <= 0 then rating = 3; reasons = {'No joker slots!'} end
    end

    return math.min(5, math.max(1, rating)), table.concat(reasons, ' | ')
end

--- Score a spectral card based on full context.
local function score_spectral_contextual(name, ctx)
    local sd = SPECTRAL_DB[name]
    if not sd then return 3, 'Spectral' end
    local rating = sd.tier
    local reasons = {sd.desc}

    -- Hand size danger check
    if sd.danger_hand and ctx.hand_size <= 3 then
        return 1, 'DANGER: hand size ' .. ctx.hand_size .. '!'
    end
    -- Money danger
    if sd.danger_money and ctx.dollars <= 5 then
        rating = math.max(2, rating - 1); reasons[#reasons+1] = 'low money warning'
    end
    -- Ankh/Hex: very risky with many jokers
    if (name == 'Ankh' or name == 'Hex') and ctx.joker_count >= 3 then
        rating = math.max(2, rating - 1); reasons[#reasons+1] = 'will destroy ' .. (ctx.joker_count-1) .. ' jokers!'
    end
    if (name == 'Ankh' or name == 'Hex') and ctx.joker_count <= 1 then
        rating = math.min(5, rating + 1); reasons[#reasons+1] = 'safe with 1 joker'
    end
    -- Ectoplasm: bonus if joker slots tight, penalty if hand tiny
    if name == 'Ectoplasm' then
        if ctx.joker_slots_free <= 0 then
            rating = math.min(5, rating + 1); reasons[#reasons+1] = 'need slot!'
        end
        if ctx.hand_size <= 4 then
            reasons[#reasons+1] = 'CAUTION: hand → ' .. (ctx.hand_size - 1)
        end
    end
    -- Black Hole: always amazing, even more so at higher antes
    if name == 'Black Hole' then
        if ctx.ante >= 5 then rating = 5; reasons = {'INCREDIBLE: upgrades ALL hands'} end
    end
    -- Soul: always 5
    if name == 'The Soul' then rating = 5 end
    -- Wraith: better if joker slots available
    if name == 'Wraith' and ctx.joker_slots_free >= 1 then
        reasons[#reasons+1] = 'has slot for rare joker'
    end
    -- Cryptid: amazing for strong cards
    if name == 'Cryptid' then
        if ctx.enhanced_count >= 5 then rating = math.min(5, rating + 1); reasons[#reasons+1] = 'copy enhanced!' end
    end
    -- Immolate: risky but $20 is huge early
    if name == 'Immolate' and ctx.ante <= 3 then
        rating = math.min(5, rating + 1); reasons[#reasons+1] = '$20 early is huge'
    end

    return math.min(5, math.max(1, rating)), table.concat(reasons, ' | ')
end

--- Analyze shop offerings using full encyclopedic knowledge base.
--- Context-aware scoring for jokers, planets, tarots, spectrals, and vouchers.
function BOT_ENGINE.analyze_shop()
