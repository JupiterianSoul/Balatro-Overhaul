-- FEATURE: Hand Optimizer
-- A full decision engine and UI assistant that analyzes the player's hand,
-- jokers, hand levels, deck composition, blind targets, and provides
-- actionable play/discard/outs recommendations.
--
-- Integrates with the existing PREVIEW score simulation engine.
-- All analysis is read-only — no game state mutation.

-- ============================================================
-- GLOBAL STATE
-- ============================================================
BOT_ENGINE = {
    -- Current analysis results (populated by .analyze())
    results       = nil,
    -- Compact HUD ref tables for live UIBox text
    hud_play       = { text = '' },
    hud_play_cards = { text = '' },  -- card labels for best play, e.g. 'A♠ K♠ Q♦'
    hud_score      = { text = '' },
    hud_action     = { text = '' },
    hud_discard    = { text = '', cards = {} },  -- .text = 'K♥ 3♣'; .cards = {{text,color},...}
    -- UI state
    panel_open    = false,
    active_tab    = 'plays',       -- plays | discards | outs | jokers | settings
    -- Timing
    _last_hash    = '',
    _last_time    = 0,
    _debounce     = 1.0,          -- seconds between re-analyses (was 0.25)
    -- Performance
    MAX_JOKER_PERMS     = 120,     -- max joker order permutations
    -- Timestamp tracking for auto-refresh
    _compact_ts         = 0,       -- timestamp of results when compact was last built
    _panel_results_ts   = 0,       -- timestamp of results when panel was last built
    _hide_start         = nil,     -- love.timer time when 'hide' was first requested
    _compact_saved_pos  = nil,     -- {x, y} persisted drag position for compact HUD
    _pending_settings_save = false,
    _panel_refresh_queued = false,
    -- Version
    VERSION = '2.0',
}

