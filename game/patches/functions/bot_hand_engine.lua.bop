local HAND_TYPES_ORDERED = {
    "Flush Five", "Flush House", "Five of a Kind",
    "Straight Flush", "Four of a Kind", "Full House",
    "Flush", "Straight", "Three of a Kind",
    "Two Pair", "Pair", "High Card",
}

--- Deep-copy a flat or nested table (safe for card data).
local function shallow_copy(t)
    if type(t) ~= 'table' then return t end
    local r = {}
    for k, v in pairs(t) do r[k] = v end
    return r
end

--- Format a number for display (1234 → "1.2K", 1234567 → "1.2M").
local function fmt_score(n)
    if not n or n == 0 then return "0" end
    if type(n) ~= "number" then
        local v = to_number and to_number(n)
        if type(v) ~= "number" or v >= 1e15 then return number_format and number_format(n) or tostring(n) end
        n = v
    end
    if n >= 1e12 then return string.format("%.1fT", n / 1e12) end
    if n >= 1e9  then return string.format("%.1fB", n / 1e9)  end
    if n >= 1e6  then return string.format("%.1fM", n / 1e6)  end
    if n >= 1e3  then return string.format("%.1fK", n / 1e3)  end
    return tostring(math.floor(n))
end

--- Format a percentage.
local function fmt_pct(n)
    if not n then return "?%" end
    if n >= 99.95 then return "99.9%" end
    if n < 0.05   then return "<0.1%" end
    return string.format("%.1f%%", n)
end

--- Create a hash of the current game state for change detection.
local function state_hash()
    if not G or not G.hand or not G.hand.cards then return '' end
    local parts = {}
    -- Hand card IDs + positions
    for i, c in ipairs(G.hand.cards) do
        parts[#parts+1] = tostring(c.sort_id or i)
        parts[#parts+1] = c.highlighted and 'H' or '_'
    end
    -- Joker IDs
