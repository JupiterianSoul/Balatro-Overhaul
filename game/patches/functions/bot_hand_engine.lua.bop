            local cost = card.cost or 0
            local vd = VOUCHER_DB[name]
            local rating = vd and vd.tier or 2
            local reason = vd and vd.desc or 'Voucher'
            -- Context bonuses
            if name == 'Antimatter' then
                if ctx.joker_slots_free <= 0 then rating = 5; reason = reason .. ' (NEED SLOT!)' end
            elseif name == 'Grabber' or name == 'Nacho Tong' then
                if ctx.ante >= 5 then rating = math.min(5, rating + 1); reason = reason .. ' (late game)' end
            elseif name == 'Paint Brush' or name == 'Palette' then
                if ctx.hand_size <= 4 then rating = math.min(5, rating + 1); reason = reason .. ' (small hand)' end
            elseif name == 'Crystal Ball' then
                if ctx.consumable_slots_free <= 0 then rating = 5; reason = reason .. ' (NEED SLOT!)' end
            elseif name == 'Seed Money' or name == 'Money Tree' then
                if ctx.dollars >= 20 then rating = math.min(5, rating + 1); reason = reason .. ' (saving $)' end
            elseif name == 'Observatory' then
                if ctx.unique_planets_used >= 4 then rating = 5; reason = reason .. ' (' .. ctx.unique_planets_used .. ' planets)' end
            end
            results.voucher_ratings[#results.voucher_ratings+1] = {
                name=name, cost=cost, affordable=dollars>=cost,
                rating=rating, reason=reason,
            }
        end
    end

    -- ── 4. Shop consumables (planets/tarots/spectrals in shop) ──
    if G.shop_booster and G.shop_booster.cards then
        for _, card in ipairs(G.shop_booster.cards) do
            local ab = card.ability or {}
            local name = ab.name or (card.config and card.config.center and card.config.center.name) or '?'
            local set = ab.set or ''
            if set == 'Planet' then
                local rating, reason = score_planet_contextual(name, ctx)
                results.consumable_tips[#results.consumable_tips+1] = {
                    name=name, hand_type=PLANET_HAND[name] or '?', rating=rating, reason=reason }
            elseif set == 'Tarot' then
                local rating, reason = score_tarot_contextual(name, ctx)
                results.consumable_tips[#results.consumable_tips+1] = {
                    name=name, rating=rating, reason=reason }
            elseif set == 'Spectral' then
                local rating, reason = score_spectral_contextual(name, ctx)
                results.consumable_tips[#results.consumable_tips+1] = {
                    name=name, rating=rating, reason=reason }
            end
        end
    end

    -- Check held consumables for planet tip
    if G.consumeables and G.consumeables.cards then
        for _, card in ipairs(G.consumeables.cards) do
            local ab = card.ability or {}
            local name = ab.name or '?'
            if ab.set == 'Planet' then
                local rating, reason = score_planet_contextual(name, ctx)
                results.consumable_tips[#results.consumable_tips + 1] = {
                    name=name, hand_type=PLANET_HAND[name] or '', rating=rating, reason=reason }
            end
        end
    end

    -- Recommend best planet overall
    if ctx.most_played then
        local hi = ctx.hands[ctx.most_played]
        if hi then
            results.planet_tip = {
                hand_type  = ctx.most_played,
                level      = hi.level,
                gain_chips = hi.l_chips,
                gain_mult  = hi.l_mult,
                played     = hi.played,
            }
        end
    end

    -- ── 5. Action recommendation ─────────────────────────────────
    local best_j = results.joker_ratings[1]
    local best_v = results.voucher_ratings[1]
    local reroll_cost = (G.GAME.current_round and G.GAME.current_round.reroll_cost) or 5
    results.reroll_cost = reroll_cost
    results.dollars = dollars
    local best_val = best_j and best_j.rating or 0
    local voucher_val = best_v and best_v.rating or 0
    -- Prioritize: great joker > great voucher > reroll > save
    if best_j and best_j.affordable and best_val >= 4 then
        results.action = 'BUY: ' .. best_j.name
        results.action_good = true
    elseif best_v and best_v.affordable and voucher_val >= 4 then
        results.action = 'VOUCHER: ' .. best_v.name
        results.action_good = true
    elseif dollars >= reroll_cost and best_val <= 2 and dollars > reroll_cost + 2 then
        results.action = 'REROLL ($' .. reroll_cost .. ')'
        results.action_good = nil  -- neutral (gold)
    else
        results.action = 'SAVE $' .. dollars
        results.action_good = false
    end

    BOT_ENGINE.shop_results = results
    return results
end

-- FEATURE: Pack Advisor — analyze cards inside an open booster pack using
-- full encyclopedic knowledge base (JOKER_DB, TAROT_DB, SPECTRAL_DB, PLANET_HAND, etc.)
function BOT_ENGINE.analyze_pack()
    if not G or not G.GAME then return nil end
    if not G.pack_cards or not G.pack_cards.cards or #G.pack_cards.cards == 0 then return nil end

    local ctx = build_run_context()
    local results = {
        choose_count = G.GAME.pack_choices or 1,
        total_count  = #G.pack_cards.cards,
        items        = {},
        header       = 'Pack Advisor',
        timestamp    = love.timer.getTime(),
    }

    -- Detect pack type from current state
    local st = G.STATE
    local is_joker   = st == G.STATES.BUFFOON_PACK
    local is_planet  = st == G.STATES.PLANET_PACK
    local is_tarot   = st == G.STATES.TAROT_PACK
    local is_spec    = st == G.STATES.SPECTRAL_PACK
    local is_std     = st == G.STATES.STANDARD_PACK

    if is_joker then
        -- ── Buffoon Pack: rate jokers with full JOKER_DB + context ──────
        results.header = 'Joker Pack'
        local lineup = { chips = 0, mult = 0, xmult = 0, econ = 0, retrigger = 0, utility = 0, total = 0 }
r 13 2531 %20%20%20%20%20%20%20%20 -
l 1212
            for _, j in ipairs(G.jokers.cards) do
                local cat = classify_joker(j)
                lineup[cat] = (lineup[cat] or 0) + 1
                lineup.total = lineup.total + 1
            end
        end
        for _, card in ipairs(G.pack_cards.cards) do
            local name = (card.ability and card.ability.name) or
                         (card.config and card.config.center and card.config.center.name) or '?'
            local cat  = classify_joker(card)
            local db = JOKER_DB[name]
            local rating, reason
            if db then
                rating, reason = score_joker_contextual(name, db, ctx, lineup)
            else
                rating = (cat == 'xmult') and 3 or (cat == 'mult') and 2 or 1
                reason = (cat == 'xmult') and 'xMult' or (cat == 'mult') and '+Mult' or
                         (cat == 'chips')  and '+Chips' or 'Utility'
            end
            -- Edition bonus
            if card.edition then
                if card.edition.negative then
                    rating = math.min(7, rating + 3); reason = reason .. ' +NEGATIVE!'
                elseif card.edition.polychrome then rating = rating + 2; reason = reason .. ' +Poly'
                elseif card.edition.holo   then rating = rating + 1; reason = reason .. ' +Holo'
                elseif card.edition.foil   then rating = rating + 1; reason = reason .. ' +Foil' end
            end
            local col = (cat == 'xmult') and (G.C.RED or {1,0,0,1}) or
                        (cat == 'mult')  and (G.C.MULT or {1,0.3,0.3,1}) or
                        (cat == 'chips') and (G.C.CHIPS or {0.3,0.5,1,1}) or
                        (G.C.UI.TEXT_LIGHT)
            results.items[#results.items + 1] = {
                name=name, rating=math.min(7, math.max(1, rating)), reason=reason, colour=col,
                is_negative=(card.edition and card.edition.negative) or false,
            }
        end
        table.sort(results.items, function(a, b) return a.rating > b.rating end)
        -- Joker slot warning
        if ctx.joker_slots_free <= 0 then
            local has_neg = false
            for _, it in ipairs(results.items) do if it.is_negative then has_neg=true; break end end
            if not has_neg then results.slot_warning = 'JOKER SLOTS FULL' end
        end

    elseif is_planet then
        -- ── Planet Pack: rate using PLANET_HAND + hand play data ─────────
        results.header = 'Celestial Pack'
        for _, card in ipairs(G.pack_cards.cards) do
            local ab = card.ability or {}
            local name = ab.name or (card.config and card.config.center and card.config.center.name) or '?'
            local rating, reason = score_planet_contextual(name, ctx)
            results.items[#results.items + 1] = {
                name = name, rating = rating, reason = reason,
                colour = G.C.BLUE or {0.3,0.5,1,1},
            }
        end
        table.sort(results.items, function(a, b) return a.rating > b.rating end)

    elseif is_tarot then
        -- ── Tarot (Arcana) Pack: rate using TAROT_DB + context ──────────
        results.header = 'Arcana Pack'
        for _, card in ipairs(G.pack_cards.cards) do
            local ab = card.ability or {}
            local name = ab.name or (card.config and card.config.center and card.config.center.name) or '?'
            local rating, reason = score_tarot_contextual(name, ctx)
            -- Consumable slot check for generation tarots
            if ctx.consumable_slots_free <= 0 and TAROT_DB[name] and TAROT_DB[name].cat == 'generation' then
                reason = reason .. ' | NO SLOT!'
            end
            results.items[#results.items + 1] = {
                name = name, rating = rating, reason = reason,
                colour = G.C.PURPLE or {0.5,0,0.8,1},
            }
        end
        table.sort(results.items, function(a, b) return a.rating > b.rating end)

    elseif is_spec then
        -- ── Spectral Pack: rate using SPECTRAL_DB + context ──────────────
        results.header = 'Spectral Pack'
        for _, card in ipairs(G.pack_cards.cards) do
            local ab = card.ability or {}
            local name = ab.name or (card.config and card.config.center and card.config.center.name) or '?'
            local rating, reason = score_spectral_contextual(name, ctx)
            results.items[#results.items + 1] = {
                name = name, rating = rating, reason = reason,
                colour = G.C.DARK_EDITION or {0.2,0,0.4,1},
            }
        end
        table.sort(results.items, function(a, b) return a.rating > b.rating end)

    elseif is_std then
        -- ── Standard Pack: rate by suit diversity, enhancements, editions, seals ──
        results.header = 'Standard Pack'
        -- Find dominant + weakest suit
        local min_suit, min_val = 'Spades', 99
        local max_suit, max_val = 'Spades', 0
        for s, v in pairs(ctx.suits) do
            if v < min_val then min_val = v; min_suit = s end
            if v > max_val then max_val = v; max_suit = s end
        end
        local flush_build = ctx.hands and ctx.hands['Flush'] and (ctx.hands['Flush'].played or 0) >= 2
        for _, card in ipairs(G.pack_cards.cards) do
            local bc   = card.base or (card.config and card.config.card) or {}
            local suit = bc.suit or '?'
            local rank = bc.value or bc.id or '?'
            local name = tostring(rank) .. ' of ' .. tostring(suit)
            local ab   = card.ability or {}
            if ab.name and ab.name ~= '' and ab.name ~= 'Base Card' then name = ab.name end
            local rating = 2
            local reasons = {}

            -- Suit analysis
            if flush_build and suit == max_suit then
                rating = rating + 1; reasons[#reasons+1] = 'flush suit'
            elseif suit == min_suit then
                reasons[#reasons+1] = 'rare suit'
            end

            -- Enhancement
            if ab.name and ab.name ~= 'Base Card' and ab.name ~= '' then
                local ev = ENHANCEMENT_VALUE[ab.name:lower():gsub(' card', '')]
                if ev then
                    rating = rating + ev.score - 1; reasons[#reasons+1] = ev.label
                else
                    rating = rating + 1; reasons[#reasons+1] = 'enhanced'
                end
            end

            -- Edition
            if card.edition then
                for ename, ev in pairs(EDITION_VALUE) do
                    if card.edition[ename] then
                        rating = rating + ev.score; reasons[#reasons+1] = ev.label
                        break
                    end
                end
            end

            -- Seal
            if card.seal then
                local sv = SEAL_VALUE[card.seal]
                if sv then rating = rating + sv.score; reasons[#reasons+1] = sv.label
                else rating = rating + 1; reasons[#reasons+1] = 'Seal' end
            end

            -- Face card value if face-heavy lineup
            local id = bc.id or 0
            if id >= 11 and ctx.joker_names then
                if ctx.joker_names['Scary Face'] or ctx.joker_names['Photograph'] or
                   ctx.joker_names['Sock and Buskin'] or ctx.joker_names['Smiley Face'] then
                    rating = rating + 1; reasons[#reasons+1] = 'face card synergy'
                end
            end

            -- Rank synergy (Fibonacci: A,2,3,5,8)
            if ctx.joker_names and ctx.joker_names['Fibonacci'] then
                local fib = {[14]=true, [2]=true, [3]=true, [5]=true, [8]=true}
                if fib[id] then rating = rating + 1; reasons[#reasons+1] = 'Fibonacci!' end
            end

            results.items[#results.items + 1] = {
                name = name,
                rating = math.min(7, math.max(1, rating)),
                reason = #reasons > 0 and table.concat(reasons, ', ') or (suit .. ' card'),
                colour = G.C.UI.TEXT_LIGHT,
            }
        end
        table.sort(results.items, function(a, b) return a.rating > b.rating end)
    end

    -- Action synthesis
    if #results.items > 0 then
        local top  = results.items[1]
        local pick = results.choose_count or 1
        if results.slot_warning then
            results.action = results.slot_warning
            results.action_good = false
        elseif top.rating >= 4 then
            results.action = (pick == 1) and ('PICK: ' .. top.name) or ('PICK ' .. pick .. ' best')
            results.action_good = true
        else
            results.action = 'All mediocre'
            results.action_good = nil
        end
    end

    BOT_ENGINE.pack_results = results
    return results
end

-- ============================================================
-- MONTE CARLO EV HELPERS (Tier 1 accuracy upgrade)
-- ============================================================

--- Build lookup: hand type name → best observed score from scored plays.
--- Gives joker-aware reference scores since plays were scored via PREVIEW engine.
local function build_hand_type_ev_map(plays)
    local map = {}
    for _, p in ipairs(plays) do
        if p.hand_name and p.score then
            if not map[p.hand_name] or p.score > map[p.hand_name] then
                map[p.hand_name] = p.score
            end
        end
    end
    -- Also pull from hand level data for types not represented in current plays
    if G and G.GAME and G.GAME.hands then
        for hand_name, info in pairs(G.GAME.hands) do
            if not map[hand_name] and info.level and info.level >= 1 then
                -- Rough estimate: base chips × base mult × hand level
                local l_chips = info.l_chips or info.chips or 0
                local l_mult  = info.l_mult or info.mult or 0
                if l_chips > 0 and l_mult > 0 then
                    map[hand_name] = l_chips * l_mult
                end
            end
        end
    end
    return map
end

--- Hypergeometric probability: P(≥1 hit in 'draws' draws from 'deck_size' cards with 'outs' targets).
local function hyper_hit(outs, deck_size, draws)
    if outs <= 0 or deck_size <= 0 or draws <= 0 then return 0 end
    if outs >= deck_size then return 1 end
    draws = math.min(draws, deck_size)
    local non_outs = deck_size - outs
    local p_miss = 1
    for d = 0, draws - 1 do
        p_miss = p_miss * math.max(0, (non_outs - d)) / math.max(1, (deck_size - d))
    end
    return 1 - p_miss
end

--- Hypergeometric probability: P(≥need hits in 'draws' draws).
--- For need>1, uses recursive inclusion-exclusion approximation.
local function hyper_hit_n(outs, deck_size, draws, need)
    if need <= 0 then return 1 end
    if need == 1 then return hyper_hit(outs, deck_size, draws) end
    if outs < need or draws < need then return 0 end
    -- P(≥need): use complement of cumulative hypergeometric
    -- P(exactly k) = C(outs,k) * C(non,draws-k) / C(total,draws)
    -- Sum P(0..need-1) then subtract from 1
    local non_outs = deck_size - outs
    -- Compute P(exactly k) iteratively using ratio trick
    -- P(0) = C(non,draws)/C(total,draws) = product((non-d)/(total-d), d=0..draws-1)
    local p0 = 1
    for d = 0, draws - 1 do
        p0 = p0 * math.max(0, (non_outs - d)) / math.max(1, (deck_size - d))
    end
    local cum = p0
    local pk = p0
    for k = 1, need - 1 do
        -- P(k) = P(k-1) * (outs-k+1)/(k) * (draws-k+1)/(non_outs-draws+k)
        local num = (outs - k + 1) * (draws - k + 1)
        local den = k * math.max(1, (non_outs - draws + k))
        if den == 0 then break end
        pk = pk * num / den
        cum = cum + pk
    end
    return math.max(0, math.min(1, 1 - cum))
end

--- Estimate expected value of discarding specific cards, drawing replacements.
--- Uses probability-weighted scoring with joker-aware reference scores from plays.
--- Returns { ev, keep_score, keep_hand, targets={{hand, prob, ref_score},...}, best_target }
local function estimate_discard_ev(kept_cards, n_draws, unseen, ev_map)
    if not kept_cards or #kept_cards < 1 or n_draws < 1 then
        -- No draws: just score what we keep
        local kr = (#kept_cards >= 1) and sim_score(kept_cards) or nil
        return { ev = kr and kr.score or 0, keep_score = kr and kr.score or 0,
                 keep_hand = kr and kr.hand_name or 'High Card', targets = {}, best_target = nil }
    end

    -- Score kept cards as-is (baseline)
    local kr = sim_score(kept_cards)
    local keep_score = kr and kr.score or 0
    local keep_hand  = kr and kr.hand_name or 'High Card'

    local by_rank, by_suit, id_set = analyze_hand_patterns(kept_cards)
    local total_unseen = #unseen
    if total_unseen < 1 then
        return { ev = keep_score, keep_score = keep_score, keep_hand = keep_hand,
                 targets = {}, best_target = nil }
    end

    local targets = {}
    local post_draw_total = #kept_cards + n_draws -- hand size after drawing

    -- ── Flush potential ──────────────────────────────────────────
    for suit, suited_cards in pairs(by_suit) do
        local have = #suited_cards
        local need = 5 - have
        if need > 0 and need <= n_draws and have >= 2 then
            local suited_outs = 0
            for _, uc in ipairs(unseen) do
                if (uc.base and uc.base.suit or '') == suit then suited_outs = suited_outs + 1 end
            end
            local prob = hyper_hit_n(suited_outs, total_unseen, n_draws, need)
            if prob > 0.005 then
                local ref = ev_map['Flush'] or (keep_score * 3)
                targets[#targets + 1] = { hand = 'Flush', prob = prob, ref_score = ref }
            end
            -- Straight Flush: suited + consecutive
            if have >= 3 then
                local suited_ids = {}
                for _, c in ipairs(suited_cards) do
                    suited_ids[#suited_ids + 1] = c.base and c.base.id or 0
                end
                table.sort(suited_ids)
                local sf_runs = find_runs(suited_ids, nil, 3)
                for _, run in ipairs(sf_runs) do
                    local sf_need = 5 - #run
                    if sf_need > 0 and sf_need <= n_draws then
                        -- Need specific suited+ranked cards
                        local sf_needed_ranks = {}
                        local lo = run[1] == 1 and 14 or run[1]
                        local hi = run[#run] == 1 and 14 or run[#run]
                        for ext = 1, sf_need do
                            if lo - ext >= 2 then sf_needed_ranks[lo - ext] = true end
                            if hi + ext <= 14 then sf_needed_ranks[hi + ext] = true end
                        end
                        local sf_outs = 0
                        for _, uc in ipairs(unseen) do
                            if (uc.base and uc.base.suit or '') == suit
                               and sf_needed_ranks[uc.base and uc.base.id or 0] then
                                sf_outs = sf_outs + 1
                            end
                        end
                        local sf_prob = hyper_hit_n(sf_outs, total_unseen, n_draws, sf_need)
                        if sf_prob > 0.001 then
                            local ref = ev_map['Straight Flush'] or (keep_score * 10)
                            targets[#targets + 1] = { hand = 'Straight Flush', prob = sf_prob, ref_score = ref }
                        end
                    end
                end
            end
        end
    end

    -- ── Straight potential ───────────────────────────────────────
    local runs = find_runs(id_set, by_rank, 3)
    for _, run in ipairs(runs) do
        local str_need = 5 - #run
        if str_need > 0 and str_need <= n_draws then
            local needed_ranks = {}
            local lo = run[1] == 1 and 14 or run[1]
            local hi = run[#run] == 1 and 14 or run[#run]
            -- Extend both ends
            for ext = 1, str_need do
                if lo - ext >= 2 then needed_ranks[lo - ext] = true end
                if hi + ext <= 14 then needed_ranks[hi + ext] = true end
            end
            local str_outs = 0
            for _, uc in ipairs(unseen) do
                if needed_ranks[uc.base and uc.base.id or 0] then str_outs = str_outs + 1 end
            end
            local str_prob = hyper_hit_n(str_outs, total_unseen, n_draws, str_need)
            if str_prob > 0.005 then
                local ref = ev_map['Straight'] or (keep_score * 2)
                targets[#targets + 1] = { hand = 'Straight', prob = str_prob, ref_score = ref }
            end
        end
    end

    -- ── Pair / Trips / Quads upgrades ────────────────────────────
    local best_rank_count, best_rank_id = 0, nil
    for id, cards in pairs(by_rank) do
        if #cards > best_rank_count then best_rank_count, best_rank_id = #cards, id end
    end
    if best_rank_id then
        local upgrades = {
            { from = 1, to = 2, hand = 'Pair' },
            { from = 2, to = 3, hand = 'Three of a Kind' },
            { from = 3, to = 4, hand = 'Four of a Kind' },
        }
        for _, u in ipairs(upgrades) do
            if best_rank_count == u.from then
                local rank_outs = 0
                for _, uc in ipairs(unseen) do
                    if (uc.base and uc.base.id or 0) == best_rank_id then rank_outs = rank_outs + 1 end
                end
                local prob = hyper_hit(rank_outs, total_unseen, n_draws)
                if prob > 0.005 then
                    local ref = ev_map[u.hand] or (keep_score * 1.5)
                    targets[#targets + 1] = { hand = u.hand, prob = prob, ref_score = ref }
                end
            end
        end
        -- Full House: have trips, need pair from draws
        if best_rank_count >= 3 then
            local pair_outs = 0
            for id, cards in pairs(by_rank) do
                if id ~= best_rank_id then
                    for _, uc in ipairs(unseen) do
                        if (uc.base and uc.base.id or 0) == id then pair_outs = pair_outs + 1 end
                    end
                end
            end
            local prob = hyper_hit(pair_outs, total_unseen, n_draws)
            if prob > 0.01 then
                local ref = ev_map['Full House'] or (keep_score * 2.5)
                targets[#targets + 1] = { hand = 'Full House', prob = prob, ref_score = ref }
            end
        end
    end

    -- ── Two Pair potential: have 1 pair, need another ────────────
    local pair_count = 0
    for _, cards in pairs(by_rank) do
        if #cards >= 2 then pair_count = pair_count + 1 end
    end
    if pair_count == 1 and n_draws >= 1 then
        local single_outs = 0
        for id, cards in pairs(by_rank) do
            if #cards == 1 then
                for _, uc in ipairs(unseen) do
                    if (uc.base and uc.base.id or 0) == id then single_outs = single_outs + 1 end
                end
            end
        end
        local prob = hyper_hit(single_outs, total_unseen, n_draws)
        if prob > 0.01 then
            local ref = ev_map['Two Pair'] or (keep_score * 1.4)
            targets[#targets + 1] = { hand = 'Two Pair', prob = prob, ref_score = ref }
        end
    end

    -- ── Compute weighted EV ──────────────────────────────────────
    -- For each target: partial_ev = prob × ref_score
    -- Total EV = keep_score + Σ(max(0, partial_ev - keep_score × prob))
    -- This correctly accounts for opportunity cost: we only gain when upgrade > keep
    local ev = keep_score
    local best_target = nil
    local best_uplift = 0
    for _, t in ipairs(targets) do
        local uplift = t.prob * math.max(0, t.ref_score - keep_score)
        if uplift > best_uplift then
            best_uplift = uplift
            best_target = t
        end
    end
    ev = keep_score + best_uplift

    return {
        ev = ev, keep_score = keep_score, keep_hand = keep_hand,
        targets = targets, best_target = best_target,
    }
end

--- Evaluate discard candidates using Monte Carlo EV estimation.
--- Generates multiple candidate discard sets, scores each with sim_score + probability math,
--- returns ALL candidates ranked by EV (best first). Joker-aware via PREVIEW engine.
local function evaluate_discards(hand_cards, plays)
    if not hand_cards or #hand_cards < 1 then return {} end

    local discards_left = G.GAME and G.GAME.current_round and G.GAME.current_round.discards_left or 0
    if discards_left <= 0 then return {} end

    local n = #hand_cards
    local ev_map = build_hand_type_ev_map(plays)
    local unseen = get_unseen_cards()
    local by_rank, by_suit, id_set = analyze_hand_patterns(hand_cards)

    -- Collect candidate discard sets (cards to REMOVE from hand)
    local candidates = {} -- { {cards={...}, label="..."}, ... }
    local seen_keys = {}

    local function add_candidate(discard_cards, label)
        if #discard_cards < 1 or #discard_cards > math.min(5, discards_left) then return end
        -- Dedup by sorted card identities
        local ids = {}
        for _, c in ipairs(discard_cards) do ids[#ids + 1] = tostring(c.sort_id or 0) end
        table.sort(ids)
        local key = table.concat(ids, '|')
        if seen_keys[key] then return end
        seen_keys[key] = true
        candidates[#candidates + 1] = { cards = discard_cards, label = label }
    end

    -- ── Pattern-based candidates ─────────────────────────────────

    -- 4-to-Straight-Flush: keep the 4 suited+consecutive, discard rest
    for suit, suited_cards in pairs(by_suit) do
        if #suited_cards >= 4 then
            local suited_ids, suited_by_id = {}, {}
            for _, c in ipairs(suited_cards) do
                local id = c.base and c.base.id or 0
                if not suited_by_id[id] then
                    suited_by_id[id] = c
                    suited_ids[#suited_ids + 1] = id
                end
            end
            table.sort(suited_ids)
            local sf_runs = find_runs(suited_ids, nil, 4)
            for _, run in ipairs(sf_runs) do
                local run_set = {}
                for _, rid in ipairs(run) do run_set[rid == 1 and 14 or rid] = true end
                local non_run = {}
                for _, c in ipairs(hand_cards) do
                    local id = c.base and c.base.id or 0
                    if not (run_set[id] and suited_by_id[id] == c) then
                        non_run[#non_run + 1] = c
                    end
                end
                if #non_run > 0 then add_candidate(non_run, '4-to-SF') end
            end
        end
    end

    -- 4-to-Flush: keep 4 of the dominant suit, discard rest
    for suit, suited_cards in pairs(by_suit) do
        if #suited_cards >= 4 and n >= 5 then
            local suit_set = {}
            -- Keep top 4 by rank
            local sorted_suited = {}
            for _, c in ipairs(suited_cards) do sorted_suited[#sorted_suited + 1] = c end
            table.sort(sorted_suited, function(a, b)
                return (a.base and a.base.id or 0) > (b.base and b.base.id or 0)
            end)
            for i = 1, math.min(4, #sorted_suited) do suit_set[sorted_suited[i]] = true end
            local to_discard = {}
            for _, c in ipairs(hand_cards) do
                if not suit_set[c] then to_discard[#to_discard + 1] = c end
            end
            if #to_discard > 0 then add_candidate(to_discard, '4-to-flush') end
        end
    end

    -- 4-to-Straight: keep 4 consecutive, discard rest
    local runs4 = find_runs(id_set, nil, 4)
    for _, run in ipairs(runs4) do
        local run_id_set = {}
        for _, rid in ipairs(run) do run_id_set[rid == 1 and 14 or rid] = true end
        local kept_count = 0
        local non_run = {}
        for _, c in ipairs(hand_cards) do
            local id = c.base and c.base.id or 0
            if run_id_set[id] and kept_count < 4 then
                kept_count = kept_count + 1
            else
                non_run[#non_run + 1] = c
            end
        end
        if #non_run > 0 then add_candidate(non_run, '4-to-straight') end
    end

    -- Keep best pair/trips, discard others
    local rank_groups = {}
    for id, cards in pairs(by_rank) do
        if #cards >= 2 then
            rank_groups[#rank_groups + 1] = { id = id, count = #cards, cards = cards }
        end
    end
    table.sort(rank_groups, function(a, b) return a.count > b.count or (a.count == b.count and a.id > b.id) end)
    if #rank_groups > 0 then
        local best_group = rank_groups[1]
        local keep_set = {}
        for _, c in ipairs(best_group.cards) do keep_set[c] = true end
        local to_discard = {}
        for _, c in ipairs(hand_cards) do
            if not keep_set[c] then to_discard[#to_discard + 1] = c end
        end
        if #to_discard > 0 and #to_discard <= 5 then
            add_candidate(to_discard, 'keep-' .. best_group.count .. '-of-a-kind')
        end
    end

    -- ── Dead-card candidates ─────────────────────────────────────
    local card_usage = {}
    for _, c in ipairs(hand_cards) do card_usage[c] = 0 end
    for i = 1, math.min(#plays, 5) do
        for _, c in ipairs((plays[i] and plays[i].cards) or {}) do
            card_usage[c] = (card_usage[c] or 0) + 1
        end
    end
    -- Sort by usage ascending (least used first)
    local by_usage = {}
    for _, c in ipairs(hand_cards) do by_usage[#by_usage + 1] = c end
    table.sort(by_usage, function(a, b) return (card_usage[a] or 0) < (card_usage[b] or 0) end)

    -- Try discarding 1, 2, 3 dead/low-usage cards
    for sz = 1, math.min(3, #by_usage, discards_left) do
        local d = {}
        for i = 1, sz do d[#d + 1] = by_usage[i] end
        if #d > 0 then add_candidate(d, 'dead-' .. sz) end
    end

    -- ── Score all candidates with Monte Carlo EV ─────────────────
    local results = {}
    local max_candidates = 10 -- limit sim_score calls for performance
    for i = 1, math.min(#candidates, max_candidates) do
        local cand = candidates[i]
        -- Determine kept cards
        local discard_set = {}
        for _, c in ipairs(cand.cards) do discard_set[c] = true end
        local kept = {}
        for _, c in ipairs(hand_cards) do
            if not discard_set[c] then kept[#kept + 1] = c end
        end
        if #kept >= 1 then
            local ok, ev_data = pcall(estimate_discard_ev, kept, #cand.cards, unseen, ev_map)
            if ok and ev_data then
                local target_hand = ev_data.best_target and ev_data.best_target.hand or ev_data.keep_hand
                local conf_parts = { cand.label }
                if ev_data.best_target then
                    conf_parts[#conf_parts + 1] = string.format(
                        '%s ~%.0f%%', ev_data.best_target.hand,
                        ev_data.best_target.prob * 100)
                end
                results[#results + 1] = {
                    discard_cards = cand.cards,
                    draw_count    = #cand.cards,
                    target_hand   = target_hand,
                    ev            = ev_data.ev,
                    confidence    = table.concat(conf_parts, ' | '),
                    -- FEATURE: Monte Carlo detail fields
                    keep_score    = ev_data.keep_score,
                    keep_hand     = ev_data.keep_hand,
                    targets       = ev_data.targets,
                    best_target   = ev_data.best_target,
                }
            end
        end
    end

    -- Sort by EV descending
    table.sort(results, function(a, b) return a.ev > b.ev end)

    -- FEATURE: Multi-discard chain simulation
    -- If multiple discards remain, estimate chained EV for the top candidates.
    -- After discard 1 draws, the new hand may still benefit from discard 2, etc.
    -- Uses probability compounding: chain_ev = step1_ev + (improvement_ratio × step1_ev × remaining_steps × decay)
    -- Decay factor models diminishing returns (each subsequent discard is less impactful).
    if discards_left >= 2 and #results > 0 then
        local remaining = discards_left - 1  -- discards available after this one
        local unseen_after = math.max(1, #unseen - 5)  -- approximate unseen after drawing
        for _, dr in ipairs(results) do
            -- Calculate improvement ratio from this single discard
            local base_play = (plays and #plays > 0) and plays[1].score or dr.keep_score
            if base_play > 0 and dr.ev > base_play then
                local improvement = dr.ev / base_play - 1  -- fractional improvement (e.g. 0.30 = 30%)
                -- Each subsequent discard contributes less (70% decay per step)
                -- Chain bonus: sum of (improvement × 0.7^step) for step = 1..remaining
                local chain_bonus = 0
                local decay = 0.7
                for step = 1, math.min(remaining, 3) do  -- Cap at 3 lookahead steps
                    chain_bonus = chain_bonus + improvement * math.pow(decay, step)
                end
                dr.chain_ev       = dr.ev * (1 + chain_bonus)
                dr.chain_steps    = math.min(remaining, 3)
                dr.chain_bonus_pct = chain_bonus * 100
            else
                dr.chain_ev       = dr.ev
                dr.chain_steps    = 0
                dr.chain_bonus_pct = 0
            end
        end
        -- Re-sort by chain_ev when available
        table.sort(results, function(a, b) return (a.chain_ev or a.ev) > (b.chain_ev or b.ev) end)
    end

    return results
end

-- ============================================================
-- D. OUTS / DRAW IMPROVEMENT VIEWER
-- ============================================================

--- Compute outs for improving toward a target hand type.
--- FIX: Pure rank/suit analysis only — never calls Balatro engine functions
--- so cannot trigger the moveable.lua:279 FRAME crash from async event scheduling.
--- FEATURE: Now includes score_impact (joker-aware) via ev_map from plays.
--- Returns { outs_list={card_descriptions}, count=N, probability=P, score_impact=N }
local function compute_outs(hand_cards, target_play, ev_map)
    if not hand_cards or not target_play then return nil end

    local unseen = get_unseen_cards()
    if #unseen < 1 then return { outs_list = {}, count = 0, probability = 0, estimated = true } end

    local target_hand = target_play.hand_name
    local by_rank, by_suit, id_set = analyze_hand_patterns(hand_cards)

    local outs = {}
    local seen_labels = {}
    local function add_out(lbl)
        if not seen_labels[lbl] then
            seen_labels[lbl] = true
            outs[#outs + 1] = lbl
        end
    end

    -- Pure statistical analysis: no engine calls, no G.FUNCS, no event scheduling
    if target_hand == 'Flush' or target_hand == 'Straight Flush'
       or target_hand == 'Flush Five' or target_hand == 'Flush House' then
        -- Need more of the dominant suit
        local best_suit, best_count = nil, 0
        for suit, cards in pairs(by_suit) do
            if #cards > best_count then best_suit, best_count = suit, #cards end
        end
        if best_suit then
            for _, uc in ipairs(unseen) do
                if (uc.base and uc.base.suit or '') == best_suit then add_out(card_label(uc)) end
                if #outs >= 30 then break end
            end
        end

    elseif target_hand == 'Straight' then
        -- Cards that complete the longest partial run
        local runs4 = find_runs(id_set, by_rank, 4)
        local needed = {}
        for _, run in ipairs(runs4) do
            local lo = run[1] == 1 and 14 or run[1]
            local hi = run[#run] == 1 and 14 or run[#run]
            if lo > 2  then needed[lo - 1] = true end
            if hi < 14 then needed[hi + 1] = true end
        end
        for _, uc in ipairs(unseen) do
            local id = uc.base and uc.base.id or 0
            if needed[id] then add_out(card_label(uc)) end
            if #outs >= 30 then break end
        end

    elseif target_hand == 'Four of a Kind' or target_hand == 'Five of a Kind' then
        -- Need more copies of the best rank
        local best_rank, best_count = nil, 0
        for id, cards in pairs(by_rank) do
            if #cards > best_count then best_rank, best_count = id, #cards end
        end
        if best_rank then
            for _, uc in ipairs(unseen) do
                if (uc.base and uc.base.id or 0) == best_rank then add_out(card_label(uc)) end
            end
        end

    elseif target_hand == 'Full House' then
        -- Need either the 3rd copy of the trip rank or any pair to fill
        local trips_rank, pair_rank = nil, nil
        for id, cards in pairs(by_rank) do
            if #cards >= 3 then trips_rank = id
            elseif #cards == 2 and not pair_rank then pair_rank = id end
        end
        for _, uc in ipairs(unseen) do
            local id = uc.base and uc.base.id or 0
            if (trips_rank and id == trips_rank) or (pair_rank and id == pair_rank) then
                add_out(card_label(uc))
            end
            if #outs >= 30 then break end
        end

    elseif target_hand == 'Three of a Kind' then
        -- Need more of the best pair rank
        local best_rank, best_count = nil, 0
        for id, cards in pairs(by_rank) do
            if #cards > best_count then best_rank, best_count = id, #cards end
        end
        if best_rank then
            for _, uc in ipairs(unseen) do
                if (uc.base and uc.base.id or 0) == best_rank then add_out(card_label(uc)) end
            end
        end

    elseif target_hand == 'Two Pair' then
        -- Need a pair for the top single-card rank(s)
        local singles = {}
        for id, cards in pairs(by_rank) do
            if #cards == 1 then singles[#singles + 1] = id end
        end
        table.sort(singles, function(a, b) return a > b end)
        local needed = {}
        for i = 1, math.min(2, #singles) do needed[singles[i]] = true end
        for _, uc in ipairs(unseen) do
            local id = uc.base and uc.base.id or 0
            if needed[id] then add_out(card_label(uc)) end
            if #outs >= 30 then break end
        end

    elseif target_hand == 'Pair' then
        -- Any deck card matching a rank currently in hand
        local in_hand = {}
        for id, _ in pairs(by_rank) do in_hand[id] = true end
        for _, uc in ipairs(unseen) do
            local id = uc.base and uc.base.id or 0
            if in_hand[id] then add_out(card_label(uc)) end
            if #outs >= 30 then break end
        end

    else
        -- High Card: top-rank cards in the deck (J+)
        for _, uc in ipairs(unseen) do
            local id = uc.base and uc.base.id or 0
            if id >= 11 then add_out(card_label(uc)) end
            if #outs >= 15 then break end
        end
    end

    local draw_count = G.GAME and G.GAME.current_round and G.GAME.current_round.discards_left or 0
    draw_count = math.min(draw_count, 5)
    local total_unseen = #unseen
    local out_count    = #outs

    -- Hypergeometric probability: P(hit ≥1 out in draw_count draws)
    local prob = 0
    if total_unseen > 0 and draw_count > 0 and out_count > 0 then
        local non_outs = total_unseen - out_count
        if non_outs >= 0 and draw_count <= total_unseen then
            local p_miss = 1
            for d = 0, draw_count - 1 do
                p_miss = p_miss * math.max(0, (non_outs - d)) / math.max(1, (total_unseen - d))
            end
            prob = (1 - p_miss) * 100
        end
    end

    -- FEATURE: Joker-aware score impact using ev_map from plays
    ev_map = ev_map or {}
    local current_score = target_play.score or 0
    local target_score  = ev_map[target_hand] or current_score
    local score_impact  = math.max(0, target_score - current_score)
    local ev_if_hit     = (prob / 100) * target_score  -- expected value contribution

    return {
        outs_list    = outs,
        count        = out_count,
        probability  = prob,
        total_deck   = total_unseen,
        draw_count   = draw_count,
        estimated    = total_unseen < 10,
        -- FEATURE: Score impact fields
        score_impact = score_impact,
        target_score = target_score,
        ev_if_hit    = ev_if_hit,
    }
end

-- ============================================================
-- F. JOKER ORDER OPTIMIZATION
-- ============================================================

--- Test different joker orders for the given play.
--- Returns { current_score=N, best_score=N, best_order={indices}, gain_pct=N }
local function optimize_joker_order(play_cards)
    if not play_cards or #play_cards < 1 then return nil end
    if not G or not G.jokers or not G.jokers.cards then return nil end
    local jokers = G.jokers.cards
    local n = #jokers
    if n < 2 or n > 8 then return nil end -- too few or too many

    local max_perms = BOT_ENGINE.MAX_JOKER_PERMS

    -- Score with current order
    local current_result = sim_score(play_cards)
    if not current_result then return nil end
    local current_score = current_result.score

    -- Generate permutations (limited)
    local best_score = current_score
    local best_order = nil

    -- Simple approach: try swapping adjacent pairs and keep best
    -- For small joker counts, try all permutations
    if n <= 5 then
        -- Generate permutations iteratively
        local indices = {}
        for i = 1, n do indices[i] = i end

        local function permute(arr, k, count)
            if count[1] >= max_perms then return end
            if k == 1 then
                -- Test this order
                local saved = {}
                for i = 1, n do saved[i] = jokers[i] end
                for i = 1, n do
                    -- We can't actually reorder jokers in G.jokers.cards safely
                    -- Instead, we swap references temporarily
                    G.jokers.cards[i] = saved[arr[i]]
                end
                local r = sim_score(play_cards)
                if r and r.score > best_score then
                    best_score = r.score
                    best_order = {}
                    for i = 1, n do best_order[i] = arr[i] end
                end
                -- Restore
                for i = 1, n do G.jokers.cards[i] = saved[i] end
                count[1] = count[1] + 1
            else
                for i = 1, k do
                    permute(arr, k - 1, count)
                    if k % 2 == 0 then
                        arr[i], arr[k] = arr[k], arr[i]
                    else
                        arr[1], arr[k] = arr[k], arr[1]
                    end
                end
            end
        end

        local perm_arr = {}
        for i = 1, n do perm_arr[i] = i end
        permute(perm_arr, n, {0})
    else
        -- For larger sets, try random swaps
        local saved = {}
        for i = 1, n do saved[i] = jokers[i] end
        for attempt = 1, math.min(max_perms, n * (n - 1) / 2) do
            local i, j = math.random(1, n), math.random(1, n)
            if i ~= j then
                G.jokers.cards[i], G.jokers.cards[j] = saved[j], saved[i]
                local r = sim_score(play_cards)
                if r and r.score > best_score then
                    best_score = r.score
                    best_order = {}
                    for k = 1, n do
                        for orig = 1, n do
                            if G.jokers.cards[k] == saved[orig] then
                                best_order[k] = orig
                                break
                            end
                        end
                    end
                end
                -- Restore
                for k = 1, n do G.jokers.cards[k] = saved[k] end
            end
        end
    end

    if not best_order or best_score <= current_score then
        return { current_score = current_score, best_score = current_score, best_order = nil, gain_pct = 0 }
    end

    local gain = best_score > 0 and ((best_score - current_score) / current_score * 100) or 0
    return {
        current_score = current_score,
        best_score    = best_score,
        best_order    = best_order,
        gain_pct      = gain,
    }
end

-- ============================================================
-- MAIN ANALYSIS PIPELINE
-- ============================================================

function BOT_ENGINE.analyze()
    if not G or not G.GAME or not G.hand or not G.hand.cards then return end
    if #G.hand.cards < 1 then return end
    if not (G.STATE == G.STATES.SELECTING_HAND or G.STATE == G.STATES.DRAW_TO_HAND) then return end


    -- Debounce
    local now = love.timer.getTime()
    local hash = state_hash()
    if hash == BOT_ENGINE._last_hash and (now - BOT_ENGINE._last_time) < BOT_ENGINE._debounce then
        return
    end
    BOT_ENGINE._last_hash = hash
    BOT_ENGINE._last_time = now

    local hand_cards = G.hand.cards
    local blind_chips = G.GAME.blind and G.GAME.blind.chips or 0
    local current_chips = G.GAME.chips or 0
    local hands_left = G.GAME.current_round and G.GAME.current_round.hands_left or 0
    local discards_left = G.GAME.current_round and G.GAME.current_round.discards_left or 0
    local mode = 1
    local perf = BOT_ENGINE.perf or 2
    local num_suggestions = 5

    -- FIX: Performance mode now controls sim_score budget (not brute-force subset count)
    local max_to_score = 5
    if perf == 1 then max_to_score = 3       -- Fast: 3 sim_score calls
    elseif perf == 3 then max_to_score = 10  -- Deep: 10 sim_score calls
    else max_to_score = 5 end                -- Balanced: 5

    -- FEATURE: Read active boss blind constraints before play enumeration
    local blind_constraints = get_blind_constraints()

    -- FEATURE: Deck context — deck name, stake, draw pile composition
    local deck_context = get_deck_context()

    -- ── A. Enumerate and score plays (smart heuristic) ──────────
    local plays = enumerate_plays(hand_cards, max_to_score, blind_constraints)
    plays = dedup_plays(plays)

    -- Generate reasons for top plays
    for i = 1, math.min(#plays, num_suggestions + 5) do
        generate_reasons(plays[i], blind_chips, mode)
    end

    -- Apply mode-based reranking
    if mode == 2 and blind_chips > 0 then
        -- Survive Blind: prefer lowest-cost play that clears
        table.sort(plays, function(a, b)
            local a_clears = (current_chips + a.score >= blind_chips)
            local b_clears = (current_chips + b.score >= blind_chips)
            if a_clears ~= b_clears then return a_clears end
            if a_clears then
                return #a.cards < #b.cards
            end
            return a.score > b.score
        end)
    elseif mode == 3 then
        -- Conserve Resources: prefer fewer cards played
        table.sort(plays, function(a, b)
            if #a.cards ~= #b.cards then return #a.cards < #b.cards end
            return a.score > b.score
        end)
    end

    -- ── Build joker-aware score reference map ─────────────────────
    local ev_map = build_hand_type_ev_map(plays)

    -- ── C. Discard advisor (Monte Carlo EV) ─────────────────────
    local discard_results = {}
    if discards_left > 0 then
        local ok_d, dr = pcall(evaluate_discards, hand_cards, plays)
        if ok_d and dr then
            discard_results = dr
        end
    end

    -- ── D. Outs computation (joker-aware score impact) ──────────
    local outs_data = nil
    if #plays > 0 then
        -- Compute outs for the best play's hand type
        local ok_o, od = pcall(compute_outs, hand_cards, plays[1], ev_map)
        if ok_o and od then
            outs_data = od
        end
    end

    -- ── E. Play vs Discard verdict (multi-hand lookahead) ──────
    local best_play_score = #plays > 0 and plays[1].score or 0
    local best_disc_ev = #discard_results > 0 and discard_results[1].ev or 0
    local verdict = 'PLAY NOW'
    local verdict_reason = ''

    -- FEATURE: Multi-hand lookahead — calculate pace and urgency
    local chips_remaining = blind_chips > 0 and math.max(0, blind_chips - current_chips) or 0
    local chips_per_hand  = (hands_left > 0 and chips_remaining > 0) and (chips_remaining / hands_left) or 0
    local on_pace         = best_play_score >= chips_per_hand  -- current play keeps us on track
    local can_clear       = blind_chips > 0 and (current_chips + best_play_score >= blind_chips)
    local is_last_hand    = hands_left <= 1
    local has_discard     = discards_left > 0
    local ev_ratio        = best_play_score > 0 and (best_disc_ev / best_play_score) or 0

    -- Discard aggression scales with spare hands: more hands = more freedom to discard
    -- Range: 1.05 (aggressive, many hands) to 1.4 (conservative, few hands)
    local disc_threshold = 1.4
    if hands_left >= 4 then disc_threshold = 1.05
    elseif hands_left == 3 then disc_threshold = 1.10
    elseif hands_left == 2 then disc_threshold = 1.20 end

    if not has_discard then
        verdict = 'PLAY NOW'
        verdict_reason = mod_loc('no discards remaining')
    elseif is_last_hand then
        verdict = 'PLAY NOW'
        verdict_reason = mod_loc('last hand — play best available')
    elseif can_clear then
        -- Already clears blind — but check if discarding could save hands for future rounds
        if best_disc_ev > best_play_score * 1.3 and hands_left >= 3 then
            verdict = 'DISCARD FIRST'
            verdict_reason = string.format('clears blind already, but +%.0f%% EV saves future hands',
                (ev_ratio - 1) * 100)
        else
            verdict = 'PLAY NOW'
            verdict_reason = mod_loc('current play clears blind')
        end
    elseif best_play_score <= 0 then
        if best_disc_ev > 0 then
            verdict = 'DISCARD FIRST'
            verdict_reason = mod_loc('no strong play available')
        else
            verdict = 'PLAY NOW'
            verdict_reason = mod_loc('no improvement expected')
        end
    elseif not on_pace and has_discard and best_disc_ev > best_play_score then
        -- Behind pace: need improvement to catch up
        verdict = 'DISCARD FIRST'
        local best_disc = discard_results[1]
        local target = best_disc and best_disc.best_target
        if target then
            verdict_reason = string.format('behind pace (need ~%s/hand) — %s ~%.0f%% chance',
                fmt_score(chips_per_hand), target.hand, target.prob * 100)
        else
            verdict_reason = string.format('behind pace (need ~%s/hand), +%.0f%% EV',
                fmt_score(chips_per_hand), (ev_ratio - 1) * 100)
        end
    elseif ev_ratio >= disc_threshold then
        -- EV improvement exceeds threshold (adjusted by hands remaining)
        verdict = 'DISCARD FIRST'
        local best_disc = discard_results[1]
        local target = best_disc and best_disc.best_target
        if target then
            verdict_reason = string.format('+%.0f%% EV — %s ~%.0f%% chance',
                (ev_ratio - 1) * 100, target.hand, target.prob * 100)
        else
            verdict_reason = string.format('+%.0f%% EV improvement expected', (ev_ratio - 1) * 100)
        end
    elseif on_pace then
        verdict = 'PLAY NOW'
        if hands_left >= 3 then
            verdict_reason = mod_loc('on pace — comfortable margin')
        else
            verdict_reason = mod_loc('on pace — current play is strong enough')
        end
    else
        verdict = 'PLAY NOW'
        verdict_reason = mod_loc('current play is strong enough')
    end

    -- ── F. Joker order (optional) ───────────────────────────────
    local joker_opt = nil
    -- FIX: always compute when Jokers tab is active (not just when setting is enabled)
    local should_optimize_jokers = false
    if should_optimize_jokers and #plays > 0 then
        local ok_j, jo = pcall(optimize_joker_order, plays[1].cards)
        if ok_j and jo then
            joker_opt = jo
        end
    end

    -- ── G. Ante pace projection ─────────────────────────────────
    local ante_wall = nil
    if #plays > 0 then
        local ok_aw, aw = pcall(estimate_ante_wall, plays[1].score)
        if ok_aw and aw then ante_wall = aw end
    end

    -- ── Assemble results ────────────────────────────────────────
    local r = {
        plays          = plays,
        num_plays      = #plays,
        best_play      = #plays > 0 and plays[1] or nil,

        discards       = discard_results,
        num_discards   = #discard_results,
        best_discard   = #discard_results > 0 and discard_results[1] or nil,

        outs           = outs_data,

        verdict        = verdict,
        verdict_reason = verdict_reason,

        joker_opt      = joker_opt,

        blind_chips    = blind_chips,
        current_chips  = current_chips,
        hands_left     = hands_left,
        discards_left  = discards_left,

        -- FEATURE: Boss blind constraints (filtering + UI note)
        blind_constraints = blind_constraints,

        -- FEATURE: Deck tracking — deck name, stake, draw pile composition
        deck_context   = deck_context,

        -- FEATURE: Ante pace projection — when the run hits a wall
        ante_wall      = ante_wall,

        timestamp      = hash,  -- use state hash so panel only refreshes on actual state change
    }
    BOT_ENGINE.results = r

    -- ── Update compact HUD text ─────────────────────────────────
    if r.best_play then
        BOT_ENGINE.hud_play.text  = r.best_play.hand_name or ''
        BOT_ENGINE.hud_score.text = '~' .. fmt_score(r.best_play.score)
        -- Card labels for compact HUD row
        if r.best_play.cards then
            local lbls = {}
            for _, c in ipairs(r.best_play.cards) do lbls[#lbls+1] = card_label(c) end
            BOT_ENGINE.hud_play_cards.text = table.concat(lbls, ' ')
        else
            BOT_ENGINE.hud_play_cards.text = ''
        end
    else
        BOT_ENGINE.hud_play.text  = 'No play'
        BOT_ENGINE.hud_score.text = ''
        BOT_ENGINE.hud_play_cards.text = ''
    end
    BOT_ENGINE.hud_action.text = verdict
    -- Populate discard hint with per-suit colored card data
    if verdict == 'DISCARD FIRST' and r.best_discard and r.best_discard.discard_cards then
        local cards_data = {}
        local labels = {}
        for _, c in ipairs(r.best_discard.discard_cards) do
            local suit  = c.base and c.base.suit or ''
            local color = suit_color(suit)
            local lbl   = card_label(c)
            cards_data[#cards_data + 1] = { text = lbl, color = color }
            labels[#labels + 1] = lbl
        end
        BOT_ENGINE.hud_discard.cards = cards_data
        -- FIX: include "Discard: " prefix so ref_table text node shows complete hint
        BOT_ENGINE.hud_discard.text  = 'Discard: ' .. table.concat(labels, ' ')
    else
        BOT_ENGINE.hud_discard.cards = {}
        BOT_ENGINE.hud_discard.text  = ''
    end
end

-- ============================================================
-- AUTO-SELECT HELPERS
-- ============================================================

local function ho_select_cards(cards)
    if not G.hand or not G.hand.cards or G.STATE ~= G.STATES.SELECTING_HAND then return false end
    if G.play and G.play.cards and G.play.cards[1] then return false end
    if G.GAME and (G.GAME.STOP_USE or 0) > 0 then return false end
r 2 582 %20%20%20%20 -
l 48
    local valid_hand_cards = {}
    for _, hc in ipairs(G.hand.cards) do
        if hc and hc.FRAME then valid_hand_cards[hc] = true end
    end
    for _, c in ipairs(cards) do
        if valid_hand_cards[c] and not c.highlighted then
            G.hand:add_to_highlighted(c, true)
        end
    end
    return true
end

--- Highlight the cards for a specific play recommendation.
function BOT_ENGINE.select_play(play_index)
    if not BOT_ENGINE.results or not BOT_ENGINE.results.plays then return end
    local play = BOT_ENGINE.results.plays[play_index]
    if not play or not play.cards then return end
    if not ho_select_cards(play.cards) then return end

    -- Trigger UI refresh
    pcall(PREVIEW.run)
end

--- Highlight cards to discard based on a discard recommendation.
function BOT_ENGINE.select_discard(disc_index)
    if not BOT_ENGINE.results or not BOT_ENGINE.results.discards then return end
    local disc = BOT_ENGINE.results.discards[disc_index]
    if not disc or not disc.discard_cards then return end
    ho_select_cards(disc.discard_cards)
end

-- ============================================================
local _be_eval = G.FUNCS.evaluate_play
G.FUNCS.evaluate_play = function(e, ...)
    BOT_ENGINE.results = nil
    BOT_ENGINE._last_hash = ''
    return _be_eval(e, ...)
end

local _be_discard = G.FUNCS.discard_cards_from_highlighted
G.FUNCS.discard_cards_from_highlighted = function(e, is_hook_blind, ...)
    local r = _be_discard(e, is_hook_blind, ...)
    if not is_hook_blind then
        BOT_ENGINE.results = nil
        BOT_ENGINE._last_hash = ''
    end
    return r
end
end
