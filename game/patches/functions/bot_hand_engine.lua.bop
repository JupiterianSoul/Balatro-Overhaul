local function prepare_overlay_box(box, allow_drag_targets)
    if not box then return end
    box.attention_text = true
    box.states.drag.can = true
    if allow_drag_targets and box.UIRoot then
        enable_box_drag_targets(box.UIRoot, true)
    end
end

-- ============================================================
-- SAFE SCORE SIMULATION
-- ============================================================
-- Wraps the existing PREVIEW engine to score an arbitrary subset
-- of cards without mutating game state.

--- Score a specific set of card objects as if they were the highlighted hand.
--- Returns { score=N, chips=N, mult=N, hand_name="...", scoring_cards={...} }
--- SAFE: saves and restores all mutated state.
local function sim_score(cards)
    if not cards or #cards < 1 then return nil end
    if not G or not G.GAME or not G.hand then return nil end
    if not PREVIEW or not PREVIEW.run then return nil end

    -- Save original highlighted state
    local orig_highlighted = G.hand.highlighted
    local orig_highlights = {}
    for _, c in ipairs(G.hand.cards) do
        orig_highlights[c] = c.highlighted
        c.highlighted = false
    end
    -- Set our candidate cards as highlighted
    local temp_highlighted = {}
    for _, c in ipairs(cards) do
        c.highlighted = true
        temp_highlighted[#temp_highlighted + 1] = c
    end
    G.hand.highlighted = temp_highlighted

    -- Run the existing PREVIEW simulation
    local ok, _ = pcall(PREVIEW.run)

    local result = nil
    if ok then
        local hand_name, loc_text, poker_hands, scoring_hand = PREVIEW.hand_info(temp_highlighted)
        result = {
            score        = PREVIEW.data or 0,
            chips        = PREVIEW._run and PREVIEW._run.chips or 0,
            mult         = PREVIEW._run and PREVIEW._run.mult or 0,
            hand_name    = hand_name or 'NULL',
            loc_text     = loc_text or '',
            scoring_hand = scoring_hand,
            cards        = cards,
        }
    end

    -- Restore original highlighted state
    for _, c in ipairs(G.hand.cards) do
        c.highlighted = orig_highlights[c] or false
    end
    G.hand.highlighted = orig_highlighted

    -- Re-run preview for the actual current selection
    pcall(PREVIEW.run)

    return result
end

-- ============================================================
-- A. SMART PLAY ENUMERATION (heuristic, NOT brute-force)
-- ============================================================

--- Group hand cards by rank and suit for fast pattern detection.
local function analyze_hand_patterns(hand_cards)
    local by_rank = {}  -- rank_id → {cards}
    local by_suit = {}  -- suit_name → {cards}
    local all_ids = {}  -- sorted list of unique rank IDs

    for _, c in ipairs(hand_cards) do
        local id = c.base and c.base.id or (c.get_id and c:get_id() or 0)
        local suit = c.base and c.base.suit or ''

        if not by_rank[id] then by_rank[id] = {} end
        by_rank[id][#by_rank[id] + 1] = c

        if suit ~= '' then
            if not by_suit[suit] then by_suit[suit] = {} end
            by_suit[suit][#by_suit[suit] + 1] = c
        end
    end

    -- Sorted unique rank IDs
    local id_set = {}
    for id, _ in pairs(by_rank) do
        id_set[#id_set + 1] = id
    end
    table.sort(id_set)

    return by_rank, by_suit, id_set
end

--- Find runs of consecutive rank IDs (for straight detection).
local function find_runs(id_set, by_rank, min_length)
    min_length = min_length or 4
    local runs = {}
    if #id_set < min_length then return runs end

    -- Normalize: treat Ace (14) as also 1 for low straights
    local ids_with_low_ace = {}
    local has_ace = false
    for _, id in ipairs(id_set) do
        ids_with_low_ace[#ids_with_low_ace + 1] = id
        if id == 14 then has_ace = true end
    end
    if has_ace then
        table.insert(ids_with_low_ace, 1, 1) -- Ace as low
    end

    local i = 1
    while i <= #ids_with_low_ace do
        local run = {ids_with_low_ace[i]}
        local j = i + 1
        while j <= #ids_with_low_ace and ids_with_low_ace[j] == ids_with_low_ace[j-1] + 1 do
            run[#run + 1] = ids_with_low_ace[j]
            j = j + 1
        end
        if #run >= min_length then
            runs[#runs + 1] = run
        end
        i = j
    end
    return runs
end

--- Build smart play candidates from hand patterns, generating MULTIPLE kicker-count
--- variants per pattern so sim_score (with active jokers) picks the true optimum.
--- E.g. a Pair is tried at 2, 3, 4, and 5 cards — "Photograph" joker wants 1 card,
--- "Greedy Joker" wants Diamond kickers, etc. sim_score handles all that automatically.
local function build_smart_candidates(hand_cards, by_rank, by_suit, id_set)
    local candidates = {}
    local seen = {}
    local n = #hand_cards

    local function add_candidate(cards, label)
        if #cards < 1 or #cards > 5 then return end
        local keys = {}
        for _, c in ipairs(cards) do keys[#keys + 1] = tostring(c) end
        table.sort(keys)
        local key = table.concat(keys, '|')
        if seen[key] then return end
        seen[key] = true
        candidates[#candidates + 1] = {cards = cards, label = label}
    end

    -- Returns up to `count` remaining cards sorted by rank desc (best kickers first)
    local function avail_kickers(exclude_set)
        local sorted = {}
        for _, c in ipairs(hand_cards) do
            if not exclude_set[c] then sorted[#sorted + 1] = c end
        end
        table.sort(sorted, function(a, b)
            return (a.base and a.base.id or 0) > (b.base and b.base.id or 0)
        end)
        return sorted
    end

    -- Add base play + 0..max_extra kickers, generating one candidate per size
    local function add_with_size_variants(base, label, max_extra)
        local excl = {}
        for _, c in ipairs(base) do excl[c] = true end
        local kpool = avail_kickers(excl)
        -- Bare play (no kickers)
        add_candidate(base, label)
        -- +1 kicker, +2, … up to max_extra (or hand limit)
        for k = 1, math.min(max_extra, #kpool) do
            local play = {}
            for _, c in ipairs(base) do play[#play + 1] = c end
            for j = 1, k do play[#play + 1] = kpool[j] end
            add_candidate(play, label)
        end
    end

    -- 1. Straight Flush (highest priority — try all 5-card windows)
    for suit, suited_cards in pairs(by_suit) do
        if #suited_cards >= 5 then
            local suited_ids, suited_by_id = {}, {}
            for _, c in ipairs(suited_cards) do
                local id = c.base and c.base.id or 0
                if not suited_by_id[id] then
                    suited_by_id[id] = c
                    suited_ids[#suited_ids + 1] = id
                end
            end
            table.sort(suited_ids)
            local sf_runs = find_runs(suited_ids, nil, 5)
            for _, run in ipairs(sf_runs) do
                -- Try every 5-card window in the run (e.g. A-2-3-4-5-6 → two windows)
                for w = 1, math.max(1, #run - 4) do
                    local play = {}
                    for i = w, w + 4 do
                        local rid = run[i]
                        local lid = rid == 1 and 14 or rid
                        if suited_by_id[lid] then play[#play + 1] = suited_by_id[lid] end
                    end
                    if #play == 5 then add_candidate(play, "Straight Flush") end
                end
            end
        end
    end

    -- 2. Four of a Kind — try without kicker AND with kicker
    for id, cards in pairs(by_rank) do
        if #cards >= 4 then
            local quad = {cards[1], cards[2], cards[3], cards[4]}
            add_with_size_variants(quad, "Four of a Kind", 1)
        end
    end

    -- 3. Full House
    for id, cards in pairs(by_rank) do
        if #cards >= 3 then
            local trip = {cards[1], cards[2], cards[3]}
            for id2, cards2 in pairs(by_rank) do
                if id2 ~= id and #cards2 >= 2 then
                    add_candidate({trip[1], trip[2], trip[3], cards2[1], cards2[2]}, "Full House")
                end
            end
        end
    end

    -- 4. Three of a Kind — try 3, 4, and 5 card plays
    for id, cards in pairs(by_rank) do
        if #cards >= 3 then
            add_with_size_variants({cards[1], cards[2], cards[3]}, "Three of a Kind", 2)
        end
    end

    -- 5. Flush — if 6+ suited, try multiple 5-card subsets (top-5, and drop-1 variants)
    for suit, cards in pairs(by_suit) do
        if #cards >= 5 then
            local sorted = {}
            for _, c in ipairs(cards) do sorted[#sorted + 1] = c end
            table.sort(sorted, function(a, b)
                return (a.base and a.base.id or 0) > (b.base and b.base.id or 0)
            end)
            -- Top 5 by rank
            local top5 = {}
            for i = 1, math.min(5, #sorted) do top5[#top5 + 1] = sorted[i] end
            add_candidate(top5, "Flush")
            -- If 6+, also try dropping the highest card (sometimes a Steel card or rank-specific joker changes priority)
            if #sorted >= 6 then
                local alt = {}
                for i = 2, 6 do alt[#alt + 1] = sorted[i] end
                add_candidate(alt, "Flush")
            end
        end
    end

    -- 6. Straight — try every 5-card window in the run
    local runs = find_runs(id_set, by_rank, 5)
    for _, run in ipairs(runs) do
        for w = 1, math.max(1, #run - 4) do
            local play = {}
            for i = w, w + 4 do
                local rid = run[i]
                local lid = rid == 1 and 14 or rid
                if by_rank[lid] and by_rank[lid][1] then
                    play[#play + 1] = by_rank[lid][1]
                end
            end
            if #play == 5 then add_candidate(play, "Straight") end
        end
    end

    -- 7. Two Pair — try 4-card (no kicker) AND 5-card (+1 kicker)
    local pairs_found = {}
    for id, cards in pairs(by_rank) do
        if #cards >= 2 then
            pairs_found[#pairs_found + 1] = {id = id, cards = {cards[1], cards[2]}}
        end
    end
    table.sort(pairs_found, function(a, b) return a.id > b.id end)
    if #pairs_found >= 2 then
        for i = 1, math.min(#pairs_found, 3) do
            for j = i + 1, math.min(#pairs_found, 4) do
                local base = {
                    pairs_found[i].cards[1], pairs_found[i].cards[2],
                    pairs_found[j].cards[1], pairs_found[j].cards[2],
                }
                add_with_size_variants(base, "Two Pair", 1)
            end
        end
    end

    -- 8. Single Pair — try 2, 3, 4, 5 card plays (most important for joker coverage)
    for _, p in ipairs(pairs_found) do
        add_with_size_variants({p.cards[1], p.cards[2]}, "Pair", 3)
    end

    -- 9. High Card — try 1, 2, 3, 4, 5 card plays
    if n >= 1 then
        local sorted = {}
        for _, c in ipairs(hand_cards) do sorted[#sorted + 1] = c end
        table.sort(sorted, function(a, b)
            return (a.base and a.base.id or 0) > (b.base and b.base.id or 0)
        end)
        -- All sizes from 1 to min(5, n)
        for sz = 1, math.min(5, #sorted) do
            local play = {}
            for i = 1, sz do play[#play + 1] = sorted[i] end
            add_candidate(play, "High Card")
        end
    end

    return candidates
end

-- ============================================================
-- BOSS BLIND CONSTRAINT ENGINE
-- ============================================================

--- Read live blind state and return a constraints table that the optimizer
--- respects when filtering and scoring plays.
--- Returns:
---   .name          string  — blind name (or nil if not a boss)
---   .blocked_hands table   — set of hand type strings that score nothing / are illegal
---   .only_hand     string  — only this hand type scores (The Mouth), or nil
---   .single_card   bool    — must play exactly 1 card (The Needle)
---   .no_discard    bool    — no discards available (The Water already gives 0, but The Serpent locks it)
---   .face_debuffed bool    — face cards are debuffed (The Plant)
---   .note          string  — short human-readable constraint summary for the panel
local function get_blind_constraints()
    local c = {
        name = nil, blocked_hands = {}, only_hand = nil,
        single_card = false, no_discard = false,
        face_debuffed = false, note = nil,
    }
    if not G or not G.GAME or not G.GAME.blind then return c end
    local blind = G.GAME.blind
    -- Only apply constraints for active, un-disabled boss blinds
    if not blind.boss or blind.disabled then return c end
    c.name = blind.name

    -- The Eye: each hand type can only be played once per round
    -- FEATURE: Persistent Eye tracking — cache used hand types and show remaining count
    if blind.name == 'The Eye' and blind.hands then
        -- Merge live state with cached state (in case analysis runs between plays)
        BOT_ENGINE._eye_used = BOT_ENGINE._eye_used or {}
        for hand_name, used in pairs(blind.hands) do
            if used then
                c.blocked_hands[hand_name] = true
                BOT_ENGINE._eye_used[hand_name] = true
            end
        end
        -- Also include any previously cached (handles transition timing)
        for hand_name, used in pairs(BOT_ENGINE._eye_used) do
            if used then c.blocked_hands[hand_name] = true end
        end
        local blocked_count = 0
        for _ in pairs(c.blocked_hands) do blocked_count = blocked_count + 1 end
        -- Total scoreable hand types in Balatro = ~10 (Pair, Two Pair, Three of a Kind, etc.)
        local total_types = 0
        if G.GAME and G.GAME.hands then
            for _ in pairs(G.GAME.hands) do total_types = total_types + 1 end
        end
        if total_types <= 0 then total_types = 10 end
        local remaining = total_types - blocked_count
        if blocked_count > 0 then
            local names = {}
            for h in pairs(c.blocked_hands) do names[#names + 1] = h end
            table.sort(names)
            c.note = 'Eye: ' .. blocked_count .. ' used, ' .. remaining .. ' remaining (' .. table.concat(names, ', ') .. ')'
        else
            c.note = 'Eye: each hand type once only (' .. total_types .. ' available)'
        end
    else
        -- Reset cache when not fighting The Eye
        BOT_ENGINE._eye_used = nil
    end

    -- The Mouth: only the first hand type played this round scores
    if blind.name == 'The Mouth' then
        if blind.only_hand and blind.only_hand ~= false then
            c.only_hand = blind.only_hand
            c.note = 'Mouth: only ' .. blind.only_hand .. ' scores'
        else
            c.note = 'Mouth: first hand type locks all others'
        end
    end

    -- The Needle: must play exactly 1 card
    if blind.name == 'The Needle' then
        c.single_card = true
        c.note = 'Needle: play exactly 1 card'
    end

    -- The Plant: face cards (J/Q/K) are debuffed
    if blind.name == 'The Plant' then
        c.face_debuffed = true
        c.note = 'Plant: face cards debuffed'
    end

    -- The Arm: playing a levelled hand delevels it
    if blind.name == 'The Arm' then
        c.note = 'Arm: playing levelled hands reduces level'
    end

    -- The Ox: playing most common hand type sets money to $0
    if blind.name == 'The Ox' then
        c.note = 'Ox: most-played hand type costs all money'
    end

    -- The Hook: discards remove 2 random cards from hand
    if blind.name == 'The Hook' then
        c.note = 'Hook: discards remove 2 cards from hand'
    end

    -- The Serpent: after each hand, forced to draw 3 new cards (effectively no plan survives)
    if blind.name == 'The Serpent' then
        c.note = 'Serpent: hand replaced after each play'
    end

    return c
end

--- Enumerate plays using smart heuristics (NOT brute force).
--- Returns a sorted list of scored candidates (best first).
local function enumerate_plays(hand_cards, max_to_score, blind_constraints)
    if not hand_cards or #hand_cards < 1 then return {} end
    max_to_score = max_to_score or 8

    local by_rank, by_suit, id_set = analyze_hand_patterns(hand_cards)
    local candidates = build_smart_candidates(hand_cards, by_rank, by_suit, id_set)

    -- Validate each candidate with get_poker_hand_info (cheap)
    local valid = {}
    for _, c in ipairs(candidates) do
        local ok, hand_name = pcall(function()
            return G.FUNCS.get_poker_hand_info(c.cards)
        end)
        if ok and hand_name and hand_name ~= 'NULL' then
            c.hand_name = hand_name
            valid[#valid + 1] = c
        end
    end

    -- FEATURE: Boss blind constraint filtering — remove illegal plays before scoring
    blind_constraints = blind_constraints or {}
    if next(blind_constraints.blocked_hands or {}) or blind_constraints.only_hand
       or blind_constraints.single_card then
        local filtered = {}
        for _, c in ipairs(valid) do
            local ok = true
            -- The Eye: skip already-used hand types
            if blind_constraints.blocked_hands[c.hand_name] then ok = false end
            -- The Mouth: skip any hand type that isn't the locked one
            if blind_constraints.only_hand and c.hand_name ~= blind_constraints.only_hand then ok = false end
            -- The Needle: only 1-card plays
            if blind_constraints.single_card and #c.cards ~= 1 then ok = false end
            if ok then filtered[#filtered + 1] = c end
        end
        -- If all plays filtered out, keep originals (don't strand the player)
        if #filtered > 0 then valid = filtered end
    end

    -- Score the top candidates with sim_score (expensive — limited)
    local scored = {}
    local to_score = math.min(#valid, max_to_score)
    for i = 1, to_score do
        local c = valid[i]
        local r = sim_score(c.cards)
        if r and r.score > 0 then
            r.label = c.label
            r.reasons = {}
            scored[#scored + 1] = r
        end
    end

    -- Sort by score descending
    table.sort(scored, function(a, b) return a.score > b.score end)
    return scored
end

--- Deduplicate plays that produce the same hand type + same cards.
local function dedup_plays(plays)
    local seen = {}
    local result = {}
    for _, p in ipairs(plays) do
        local key = p.hand_name
        for _, c in ipairs(p.cards) do
            key = key .. '|' .. tostring(c.sort_id or 0)
        end
        if not seen[key] then
            seen[key] = true
            result[#result + 1] = p
        end
    end
    return result
end

-- ============================================================
-- B. REASON TAGS
-- ============================================================

local function generate_reasons(play, blind_chips, mode)
    if not play then return {} end
    local reasons = {}

    -- Does it clear the blind?
    if blind_chips and blind_chips > 0 then
        local current_chips = G.GAME and G.GAME.chips or 0
        if current_chips + play.score >= blind_chips then
            reasons[#reasons + 1] = "clears blind"
        else
            local pct = ((current_chips + play.score) / blind_chips) * 100
            reasons[#reasons + 1] = string.format("%.0f%% of blind", pct)
        end
    end

    -- Hand level boost
    if G.GAME and G.GAME.hands and G.GAME.hands[play.hand_name] then
        local lvl = G.GAME.hands[play.hand_name].level or 1
        if lvl >= 5 then
            reasons[#reasons + 1] = "Lv." .. lvl .. " " .. play.hand_name
        end
    end

    -- Card count efficiency
    if play.cards then
        local n = #play.cards
        if n <= 2 then
            reasons[#reasons + 1] = "low card count"
        end
    end

    -- Mult vs chips contribution
    if play.mult and play.chips then
        if play.mult > play.chips then
            reasons[#reasons + 1] = "mult-heavy"
        end
    end

    play.reasons = reasons
    return reasons
end

-- ============================================================
-- C. DISCARD ADVISOR
-- ============================================================

--- Get drawable unseen cards: draw pile + discard pile when deck nearly exhausted.
--- FEATURE: Deck tracking — uses actual remaining draw pile for accurate probabilities.
--- When ≤4 cards remain in draw, includes discard pile (Balatro reshuffles it on next draw).
local function get_unseen_cards()
    local unseen = {}
    if not G or not G.deck or not G.deck.cards then return unseen end
    for _, c in ipairs(G.deck.cards) do
        unseen[#unseen + 1] = c
    end
    -- FIX: When draw pile is nearly exhausted, include discard pile (reshuffle imminent)
    if #unseen <= 4 and G.discard and G.discard.cards then
        for _, c in ipairs(G.discard.cards) do
            unseen[#unseen + 1] = c
        end
    end
    return unseen
end

--- FEATURE: Deck context — read which deck + stake the player is on, and draw pile composition.
--- Returns { deck_name, deck_short, stake, stake_name, draw_remaining, discard_count,
---           total_live, suit_counts{Spades,Hearts,Diamonds,Clubs,?} }
local function get_deck_context()
    local ctx = {
        deck_name      = 'Unknown',
        deck_short     = 'Unknown',
        stake          = 1,
        stake_name     = 'White',
        draw_remaining = 0,
        discard_count  = 0,
        total_live     = 0,
        suit_counts    = {},
    }
    if not G or not G.GAME then return ctx end

    -- Deck (back) name
    if G.GAME.selected_back then
        ctx.deck_name  = G.GAME.selected_back.name or 'Unknown'
        -- Strip trailing " Deck" for compact display (e.g. "Red Deck" → "Red")
        ctx.deck_short = ctx.deck_name:gsub('%s?Deck$', '')
    end

    -- Stake number and name
    ctx.stake = G.GAME.stake or 1
    local STAKE_NAMES = {
        'White', 'Red', 'Green', 'Black', 'Blue', 'Purple', 'Orange', 'Gold',
        'Insanity', 'Chaos', 'Oblivion', 'Apocalypse', 'Transcendent',
    }
    ctx.stake_name = STAKE_NAMES[ctx.stake] or ('Stake ' .. ctx.stake)

    -- Draw pile count + suit distribution
    if G.deck and G.deck.cards then
        ctx.draw_remaining = #G.deck.cards
        for _, c in ipairs(G.deck.cards) do
            local suit = (c.base and c.base.suit) or 'Unknown'
            ctx.suit_counts[suit] = (ctx.suit_counts[suit] or 0) + 1
        end
    end

    -- Discard pile count
    if G.discard and G.discard.cards then
        ctx.discard_count = #G.discard.cards
    end

    -- Total live cards in run (may differ from 52 due to consumable effects)
r 3 4751 %20%20%20%20 -
l 471
        ctx.total_live = #G.playing_cards
    end

    return ctx
end

--- FEATURE: Ante pace projection — estimate which ante the best play score stops clearing boss blinds.
--- Uses get_blind_amount() with boss mult=2 (typical boss) and current ante_scaling.
--- Returns { current_ante, wall_ante, boss_chips_at_wall, best_score }
local function estimate_ante_wall(best_score)
    local result = { current_ante = 1, wall_ante = nil, boss_chips_at_wall = 0, best_score = best_score or 0 }
    if not G or not G.GAME or not best_score or best_score <= 0 then return result end
    if not get_blind_amount then return result end

    result.current_ante = G.GAME.round_resets and G.GAME.round_resets.ante or 1
    local ante_scaling = G.GAME.starting_params and G.GAME.starting_params.ante_scaling or 1
    local hands_per_round = G.GAME.current_round and G.GAME.current_round.hands_left or 4

    -- Get creative stake multiplier if available
    local creative_mult = 1
    if get_creative_blind_multiplier then
        creative_mult = get_creative_blind_multiplier()
    elseif get_insanity_blind_multiplier then
        creative_mult = get_insanity_blind_multiplier()
    end

    -- Project forward: can our best score × hands clear the boss blind at each ante?
    local round_output = best_score * math.max(hands_per_round, 1)
    for ante = result.current_ante, result.current_ante + 12 do
        local boss_chips = get_blind_amount(ante) * 2 * ante_scaling * creative_mult  -- boss mult=2
        if round_output < boss_chips then
            result.wall_ante = ante
            result.boss_chips_at_wall = boss_chips
            break
        end
    end

    return result
end

