local MG = Minigames
local K = MG.kit
local L = MG.L
local P = require "functions/minigames/poker"

local min, max, sin, pi = math.min, math.max, math.sin, math.pi

local Game = {}
Game.__index = Game

local SHOW, FLIP, REVEAL, LOSE = 1.1, 0.22, 0.7, 1.3

function Game:start()
    self.score = 0
    self.pops = K.pops(4)
    self.end_sound = "whoosh1"
    self.cards = {}
    for i = 1, 3 do self.cards[i] = {key = i == 1 and "S_A" or "H_K", slot = i, f = 1, up = false, ace = i == 1} end
    self.s = min(0.85, (self.H - 1.3) / K.card_h())
    self.gap = K.card_w() * self.s * 1.45
    self.cy = self.H / 2 + 0.3
    self.arc = K.card_h() * self.s * 0.28
    self.hint = "Watch the Ace!"
    local c = self.cards
    for i = 3, 2, -1 do
        local j = self.rng:random(1, i)
        c[i].slot, c[j].slot = c[j].slot, c[i].slot
    end
    self:round()
end

function Game:slot_x(i)
    return self.W / 2 + (i - 2) * self.gap
end

function Game:round()
    local rng, c = self.rng, self.cards
    local r1 = rng:random(2, 13)
    local r2 = rng:random(2, 12)
    if r2 >= r1 then r2 = r2 + 1 end
    c[2].key = P.key(r1, P.SUITS[rng:random(1, 4)])
    c[3].key = P.key(r2, P.SUITS[rng:random(1, 4)])
    for i = 1, 3 do c[i].up = true end
    K.juice(c[1], 0.4)
    self.swaps = min(14, 3 + self.score)
    self.last_swaps = self.swaps
    self.swap_d = max(0.15, 0.42 - self.score * 0.025)
    self.state = "show"
    self.hint = "Watch the Ace!"
    self.t = 0
    K.sound("card1", 1, 0.6)
end

function Game:next_swap()
    local rng = self.rng
    local a = rng:random(1, 3)
    local b = rng:random(1, 2)
    if b >= a then b = b + 1 end
    for i = 1, 3 do
        local s = self.cards[i].slot
        if s == a then self.sa = i elseif s == b then self.sb = i end
    end
    self.t = 0
    K.sound("cardSlide1", 1.2 + self.rng:random() * 0.2, 0.35)
end

function Game:pick(i)
    if self.state ~= "pick" then return end
    local c = self.cards[i]
    c.up = true
    K.juice(c, 0.3)
    self.t = 0
    self.hint = ""
    local top = self.cy - K.card_h() * self.s / 2 - 0.15
    if c.ace then
        self.score = self.score + 1
        self.state = "right"
        K.pop(self.pops, "+1", self:slot_x(c.slot), top, G.C.GOLD, 0.7)
        K.sound("chips1", 1 + min(self.score, 15) * 0.03, 0.6)
        K.flash(G.C.GOLD, 0.12)
        if self.score % 5 == 0 then
            K.sound("multhit1", 1 + min(self.score, 30) * 0.01, 0.55)
            K.pop(self.pops, string.format(L("%d in a row!"), self.score), self.W / 2, self.cy, G.C.WHITE, 0.75)
        end
    else
        self.state = "wrong"
        self.result = "Lost the Ace!"
        self.summary = string.format(L("Last shuffle: %d swaps"), self.last_swaps)
        K.pop(self.pops, localize and localize("k_nope_ex") or "Nope!", self:slot_x(c.slot), top, G.C.RED, 0.7)
        K.sound("cancel", 0.8, 0.7)
        K.shake(0.12)
        K.flash(G.C.RED, 0.2)
    end
end

function Game:press(x, y)
    if self.state ~= "pick" then return end
    local hw, hh = K.card_w() * self.s / 2 + 0.1, K.card_h() * self.s / 2 + 0.1
    for i = 1, 3 do
        local cx = self:slot_x(self.cards[i].slot)
        if x >= cx - hw and x <= cx + hw and y >= self.cy - hh and y <= self.cy + hh then self:pick(i) return end
    end
end

function Game:key(k)
    if self.state ~= "pick" then return end
    local slot = (k == "left" or k == "1") and 1 or (k == "down" or k == "up" or k == "2") and 2 or (k == "right" or k == "3") and 3 or nil
    if not slot then return end
    for i = 1, 3 do if self.cards[i].slot == slot then self:pick(i) return end end
end

r 9 2449 - -
l 98
    self.t = self.t + dt
    local step = dt / FLIP
    for i = 1, 3 do
        local c = self.cards[i]
        if c.up then c.f = max(0, c.f - step) else c.f = min(1, c.f + step) end
    end
    local st = self.state
    if st == "show" and self.t >= SHOW then
        for i = 1, 3 do self.cards[i].up = false end
        self.state = "hide"
        self.t = 0
    elseif st == "hide" and self.t >= FLIP + 0.15 then
        self.state = "swap"
        self.hint = ""
        self:next_swap()
    elseif st == "swap" and self.t >= self.swap_d then
        local a, b = self.cards[self.sa], self.cards[self.sb]
        a.slot, b.slot = b.slot, a.slot
        self.swaps = self.swaps - 1
        if self.swaps > 0 then
            self:next_swap()
        else
            self.sa, self.sb = nil, nil
            self.state = "pick"
            self.hint = "Where is the Ace?"
            self.t = 0
        end
    elseif st == "right" and self.t >= REVEAL then
        self:round()
    elseif st == "wrong" then
        if self.t >= 0.35 and not self.cards[1].up then
            for i = 1, 3 do self.cards[i].up = true end
            K.juice(self.cards[1], 0.4)
            K.sound("card1", 1.1, 0.55)
        end
        if self.t >= LOSE then self.over = true end
    end
end

local glow = {1, 1, 1, 1}

function Game:draw(ox, oy)
    local s = self.s
    local now = K.now()
    local st = self.state
    local cw, ch = K.card_w() * s, K.card_h() * s
    for i = 1, 3 do
        local c = self.cards[i]
        local x, y = self:slot_x(c.slot), self.cy
        if self.state == "swap" and (i == self.sa or i == self.sb) then
            local other = self.cards[i == self.sa and self.sb or self.sa]
            local u = K.smooth(self.t / self.swap_d)
            x = K.lerp(self:slot_x(c.slot), self:slot_x(other.slot), u)
            y = y + (i == self.sa and -1 or 1) * sin(pi * u) * self.arc
        end
        local r = K.jr(c)
        if st == "pick" then
            K.hover(c, ox + x - cw / 2, oy + y - ch / 2, cw, ch)
            r = r + sin(now * 1.6 + i * 2) * 0.02
        end
        if c.ace and c.f < 0.5 and (st == "show" or st == "right" or (st == "wrong" and self.t >= 0.35)) then
            local g = G.C.GOLD
            glow[1], glow[2], glow[3], glow[4] = g[1], g[2], g[3], 0.35 + 0.2 * sin(now * 6)
            local k = K.jk(c) * 1.08
            K.rect(ox + x - cw * k / 2, oy + y - ch * k / 2, cw * k, ch * k, glow, 0.15)
        end
        K.card(c.key, ox + x, oy + y, s * K.jk(c), {flip = c.f, r = r})
    end
    if self.hint ~= "" then
        local a = 0.75 + 0.25 * sin(K.now() * 4)
        K.text(L(self.hint), ox + self.W / 2, oy + 0.4, UIK.touch() and 0.55 or 0.5, G.C.GOLD, "c", a)
    end
    K.draw_pops(self.pops, ox, oy)
end

MG.register{
    key = "find_ace",
    name = "Find the Ace",
    desc = "Follow the Ace while the cards shuffle",
    how = "Watch the Ace, follow the shuffle, tap it. Faster every round.",
    score = "Rounds",
    new = function() return setmetatable({}, Game) end,
}

if mod_loc_register then
    mod_loc_register{
        fr = {["Find the Ace"] = "Trouvez l'As", ["Follow the Ace while the cards shuffle"] = "Suivez l'As pendant que les cartes se mélangent",
            ["Watch the Ace, follow the shuffle, tap it. Faster every round."] = "Regardez l'As, suivez le mélange, touchez-le. Plus rapide à chaque manche.",
            ["Rounds"] = "Manches", ["Watch the Ace!"] = "Regardez l'As !", ["Where is the Ace?"] = "Où est l'As ?", ["Lost the Ace!"] = "As perdu !",
            ["Last shuffle: %d swaps"] = "Dernier mélange : %d échanges"},
        es = {["Find the Ace"] = "Encuentra el as", ["Follow the Ace while the cards shuffle"] = "Sigue al As mientras se barajan las cartas",
            ["Watch the Ace, follow the shuffle, tap it. Faster every round."] = "Mira el As, sigue la mezcla y tócalo. Más rápido cada ronda.",
            ["Rounds"] = "Rondas", ["Watch the Ace!"] = "¡Mira el as!", ["Where is the Ace?"] = "¿Dónde está el As?", ["Lost the Ace!"] = "¡Perdiste el as!",
            ["Last shuffle: %d swaps"] = "Última mezcla: %d cambios"},
    }
end

return Game
end
