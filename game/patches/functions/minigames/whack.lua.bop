local MG = Minigames
local K = MG.kit
local L = MG.L

local min, max, floor, ceil, sin = math.min, math.max, math.floor, math.ceil, math.sin

local Game = {}
Game.__index = Game

local TIME, COLS, ROWS, FLIP, MAX_UP = 30, 4, 2, 0.12, 3
local N = COLS * ROWS
local BOSSES = {"bl_hook", "bl_wall", "bl_club", "bl_psychic", "bl_needle", "bl_manacle", "bl_final_bell", "bl_final_leaf"}

function Game:start()
    self.score = 0
    self.left = TIME
    self.pool = K.jokers()
    self.pops = K.pops(4)
    self.holes = {}
    for i = 1, N do self.holes[i] = {kind = nil, key = nil, life = 0, f = 1, gone = 0} end
    local s = min((self.W - 0.6) / (COLS * K.card_w() * 1.3), (self.H - 0.95) / (ROWS * K.card_h() * 1.12))
    self.s = s
    self.gx = K.card_w() * s * 1.3
    self.gy = K.card_h() * s * 1.12
    self.x0 = self.W / 2 - (COLS - 1) * self.gx / 2
    self.y0 = (self.H - 0.6) / 2 - (ROWS - 1) * self.gy / 2
    self.bar = {x = 0.5, y = self.H - 0.42, w = self.W - 2.2, h = 0.2}
    self.spawn_t = 0.6
    self.tsec, self.ttext = -1, ""
    self.dead_t = nil
    self.sel = 1
    self.pad = false
    self.away = 0
    self.end_sound = "whoosh1"
end

function Game:sum()
    self.summary = string.format(L("Got away: %d"), self.away)
end

function Game:pos(i)
    return self.x0 + ((i - 1) % COLS) * self.gx, self.y0 + floor((i - 1) / COLS) * self.gy
end

function Game:progress()
    return 1 - max(0, self.left) / TIME
end

function Game:spawn()
    local up, free = 0, 0
    for i = 1, N do
        local h = self.holes[i]
        if h.kind then up = up + 1 elseif h.f >= 1 then free = free + 1 end
    end
    if up >= MAX_UP or free == 0 then return end
    local pick = self.rng:random(1, free)
    for i = 1, N do
        local h = self.holes[i]
        if not h.kind and h.f >= 1 then
            pick = pick - 1
            if pick == 0 then
                local p = self:progress()
                h.kind = self.rng:random() < 0.2 + p * 0.1 and "boss" or "joker"
                h.key = h.kind == "boss" and BOSSES[self.rng:random(1, #BOSSES)] or self.pool[self.rng:random(1, #self.pool)]
                h.life = (1.25 - p * 0.6) * (self.pad and 1.35 or 1)
                h.born = 0
                return
            end
        end
    end
end

function Game:whack(i)
    local h = self.holes[i]
    if self.dead_t or self.ending then return end
    if h.kind == "joker" and h.f < 0.5 then
        h.kind = nil
        K.juice(h, 0.5)
        self.score = self.score + 1
        local x, y = self:pos(i)
        K.pop(self.pops, "+1", x, y - K.card_h() * self.s / 2 + 0.2, G.C.GOLD, 0.75)
        K.sound("multhit1", 1 + min(self.score, 30) * 0.015, 0.55)
        K.shake(0.03)
        if self.score % 10 == 0 then
            K.flash(G.C.GOLD, 0.12)
            K.pop(self.pops, self.score .. "!", self.W / 2, self.y0 + self.gy / 2, G.C.WHITE, 0.9)
            K.sound("multhit2", 1, 0.5)
        end
    elseif h.kind == "boss" then
        K.juice(h, 0.8)
        self.dead_t = 1.1
        self.boss_hit = i
        self.result = "The Boss caught you!"
        self:sum()
        K.sound("cancel", 0.7, 0.8)
        K.shake(0.16)
        K.flash(G.C.RED, 0.3)
    else
        K.juice(h, 0.15)
        K.sound("card1", 0.8, 0.35)
    end
end

function Game:press(x, y)
    self.pad = false
    local hw, hh = K.card_w() * self.s / 2 + 0.08, K.card_h() * self.s / 2 + 0.08
    for i = 1, N do
        local cx, cy = self:pos(i)
        if x >= cx - hw and x <= cx + hw and y >= cy - hh and y <= cy + hh then self:whack(i) return end
    end
end

function Game:key(k)
    local n = tonumber(k)
    if n and n >= 1 and n <= N then self:whack(n) return end
    local c, r = (self.sel - 1) % COLS, floor((self.sel - 1) / COLS)
    if k == "left" then c = (c - 1) % COLS
    elseif k == "right" then c = (c + 1) % COLS
    elseif k == "up" then r = (r - 1) % ROWS
    elseif k == "down" then r = (r + 1) % ROWS
    elseif k == "return" or k == "space" then
        self.pad = true
        self:whack(self.sel)
        return
    else
        return
    end
    self.pad = true
    self.sel = r * COLS + c + 1
    K.sound("card1", 1.3, 0.2)
end

function Game:pad_hit()
    self.pad = true
    self:whack(self.sel)
end

r 10 2449 - -
l 94
    if self.dead_t then
        self.dead_t = self.dead_t - dt
        if self.dead_t <= 0 then self.over = true end
        return
    end
    if self.ending then
        self.ending = self.ending - dt
        for i = 1, N do local h = self.holes[i] h.f = min(1, h.f + dt / FLIP) end
        if self.ending <= 0 then self.over = true end
        return
    end
    local step = dt / FLIP
    for i = 1, N do
        local h = self.holes[i]
        if h.kind then
            h.born = h.born + dt
            h.life = h.life - dt
            if h.kind == "joker" then h.f = max(0, h.f - step) end
            if h.life <= 0 then
                if h.kind == "joker" then self.away = self.away + 1 end
                h.kind = nil
            end
        else
            h.f = min(1, h.f + step)
        end
    end
    self.spawn_t = self.spawn_t - dt
    if self.spawn_t <= 0 then
        self:spawn()
        self.spawn_t = 0.75 - self:progress() * 0.37
    end
    local before = self.left
    self.left = self.left - dt
    if self.left < 5 and floor(before) ~= floor(self.left) and self.left > 0 then K.sound("button", 0.8, 0.35) K.juice(self.bar, 0.2) end
    if self.left <= 0 then
        self.left = 0
        self.result = "Time!"
        self.result_col = G.C.GOLD
        for i = 1, N do self.holes[i].kind = nil end
        self:sum()
        self.ending = 0.6
        K.sound("cardFan2", 1, 0.5)
    end
end

function Game:draw(ox, oy)
    local s = self.s
    for i = 1, N do
        local h = self.holes[i]
        local x, y = self:pos(i)
        local face = h.f < 0.5 and h.key and not (h.kind == "boss")
        K.center(face and h.key or "j_joker", ox + x, oy + y - (1 - h.f) * 0.15, s * K.jk(h), {flip = face and h.f or 1, r = K.jr(h), back = "b_blue"})
        if h.kind == "boss" then
            local k = K.out_back(min(1, h.born / 0.2))
            local bob = sin(h.born * 9) * 0.05
            local size = K.card_w() * s * 0.9 * k * K.jk(h)
            K.blind(h.key, ox + x, oy + y + bob, size)
        end
    end
    if self.pad and not self.dead_t and not self.ending then
        local x, y = self:pos(self.sel)
        local w, h = K.card_w() * s + 0.22, K.card_h() * s + 0.22
        K.outline(ox + x - w / 2, oy + y - h / 2, w, h, G.C.GOLD, 0.12, 0.07)
    end
    local b = self.bar
    local bj = K.jk(b)
    K.bar(ox + b.x, oy + b.y - (bj - 1) * b.h, b.w, b.h * bj, self.left / TIME, self.left < 8 and G.C.RED or G.C.GREEN)
    local sec = ceil(self.left)
    if sec ~= self.tsec then self.tsec = sec self.ttext = sec .. "s" end
    K.text(self.ttext, ox + b.x + b.w + 0.35, oy + b.y + b.h / 2, 0.42, self.left < 8 and G.C.RED or G.C.UI.TEXT_LIGHT, "l")
    K.draw_pops(self.pops, ox, oy)
end

MG.register{
    key = "whack",
    name = "Whack-a-Joker",
    desc = "Tap the jokers that pop up, never the Boss Blind",
    how = "Tap every joker that pops up. Never tap a Boss Blind. 30 seconds.",
    score = "Jokers",
    new = function() return setmetatable({}, Game) end,
}

if mod_loc_register then
    mod_loc_register{
        fr = {["Whack-a-Joker"] = "Tape-Joker", ["Tap the jokers that pop up, never the Boss Blind"] = "Touchez les jokers qui surgissent, jamais la Blinde Boss",
            ["Tap every joker that pops up. Never tap a Boss Blind. 30 seconds."] = "Touchez chaque joker qui surgit. Jamais une Blinde Boss. 30 secondes.",
            ["Jokers"] = "Jokers", ["The Boss caught you!"] = "Le Boss vous a eu !", ["Got away: %d"] = "Échappés : %d"},
        es = {["Whack-a-Joker"] = "Golpea al comodín", ["Tap the jokers that pop up, never the Boss Blind"] = "Toca los comodines que salen, nunca la ciega jefe",
            ["Tap every joker that pops up. Never tap a Boss Blind. 30 seconds."] = "Toca cada comodín que salga. Nunca una ciega jefe. 30 segundos.",
            ["Jokers"] = "Comodines", ["The Boss caught you!"] = "¡El Jefe te atrapó!", ["Got away: %d"] = "Escapados: %d"},
    }
end

return Game
end
