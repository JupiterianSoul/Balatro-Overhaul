    snap("mg_pick_" .. tostring(P.cur))
end

local KEYS = {escape = true, up = true, w = true, down = true, s = true, right = true, d = true, tab = true, left = true, a = true, ["return"] = true, kpenter = true, space = true}

function P.wants(key)
    return P.is_open() and KEYS[key] == true
end

function P.sync()
    if not P.is_open() then return end
    local f = P.focus or "list"
    snap(f == "play" and "mg_pick_play" or f == "switch" and "mg_pick_on" or "mg_pick_" .. tostring(P.cur))
end

function P.key(key)
    if not P.is_open() then return false end
r 23 774 %20%20%20%20 -
l 141
        G.FUNCS.open_tavern_hub()
        return true
    end
    local f = P.focus or "list"
    if key == "up" or key == "w" then
        P.kb = true
        if f == "list" then P.step(-1) else P.focus = f == "switch" and "play" or "list" play_sound("paper1", 1.2, 0.3) end
        return true
    end
    if key == "down" or key == "s" then
        P.kb = true
        if f == "list" then P.step(1) elseif f == "play" then P.focus = "switch" play_sound("paper1", 1.2, 0.3) end
        return true
    end
    if key == "right" or key == "d" or key == "tab" then
        P.kb = true
        if f == "list" then P.focus = "play" elseif f == "play" then P.focus = "switch" elseif key == "tab" then P.focus = "list" end
        play_sound("paper1", 1.2, 0.3)
        return true
    end
    if key == "left" or key == "a" then
        P.kb = true
        P.focus = "list"
        play_sound("paper1", 1.2, 0.3)
        return true
    end
    if key == "return" or key == "kpenter" or key == "space" then
        P.kb = true
        if f == "switch" then
            P.view.on = not P.view.on
            MG.set(P.cur, P.view.on)
            play_sound("button", 1, 0.3)
        else
            play_sound("button", 1, 0.3)
            G.FUNCS.mg_pick_play()
        end
        return true
    end
    return false
end

local function tavern_buttons(node, list)
    if type(node) ~= "table" then return list end
    local c = node.config
    if node.n == G.UIT.C and c and c.button and c.minh and c.id ~= "overlay_menu_back_button" then list[#list + 1] = c end
    for _, ch in ipairs(node.nodes or {}) do tavern_buttons(ch, list) end
    return list
end

function MG.fit_tavern(def)
    local list = tavern_buttons(def, {})
    if #list < 7 then return def end
    local h = math.min(1, 5.6 / #list)
    for _, c in ipairs(list) do c.minh = h end
    return def
end

if create_UIBox_tavern_hub and not P.tavern_wrapped then
    P.tavern_wrapped = true
    local base = create_UIBox_tavern_hub
    create_UIBox_tavern_hub = function(...)
        local def = base(...)
        local ok, err = pcall(MG.fit_tavern, def)
        if not ok then print("[Minigames] tavern fit: " .. tostring(err)) end
        return def
    end
end

function MG.tavern_button()
    if not MG.available() then return nil end
    return {n = G.UIT.R, config = {align = "cm", padding = 0.08}, nodes = {
        UIBox_button({label = {L("MINIGAMES")}, button = "open_minigames", minw = 5, minh = 1, colour = G.C.RED}),
    }}
end

