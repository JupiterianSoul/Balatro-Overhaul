    local all = true
    for i = 1, 3 do
        local r = self.reels[i]
        if r.state == "spin" then
            r.pos = (r.pos + r.v * dt)
            all = false
        elseif r.state == "stop" then
            r.t = r.t + dt
            local u = min(1, r.t / STOP)
            r.pos = r.p0 + (r.target - r.p0) * K.out_back(u)
            if u >= 1 then
                r.pos = r.target % NS
                r.state = "idle"
                K.juice(r, 0.25)
                K.shake(0.02)
                K.sound("card1", 1.1, 0.5)
            else
                all = false
            end
        end
    end
    if self.state == "stopping" and all then self:pay() end
    if self.state == "show" then
        self.t = self.t + dt
        if self.t >= SHOW then
            self.win_row = nil
            if self.spins <= 0 then
                self.result = "Out of spins"
                self.result_col = G.C.GOLD
                self.summary = string.format(L("Wins: %d of %d   Best win: +%d"), self.wins, SPINS, self.top_win)
                self.over = true
            else
                self.state = "idle"
                self.btn.label, self.btn.colour = L("Spin"), G.C.GREEN
            end
        end
    end
end

function Game:draw(ox, oy)
    local s, bw, bh = self.s, self.bw, self.bh
    local ch = K.card_h() * s
    for i = 1, 3 do
        local r = self.reels[i]
        local cx = self.mid + (i - 2) * self.gap
        local j = K.jk(r)
        K.panel(ox + cx - bw / 2, oy + self.top, bw, bh, G.C.BLACK, 0.12, 0.6)
        local p = r.pos
        local base = floor(p)
        local u = p - base
        local cur = r.strip[base % NS + 1]
        local nxt = r.strip[(base + 1) % NS + 1]
        local y0 = oy + self.top + (bh - ch) / 2
        if u < 0.001 then
            K.center(cur, ox + cx, y0 + ch / 2, s * j, {r = K.jr(r)})
        else
            K.center(nxt, ox + cx, y0 + u * ch / 2, s, {vk = u, shadow = false})
            K.center(cur, ox + cx, y0 + (1 + u) * ch / 2, s, {vk = 1 - u, shadow = false})
        end
    end
    local off = self.state == "stopping" or self.state == "show" or (self.state == "idle" and self.spins <= 0)
    self.btn.disabled = off
    K.button(self.btn, 1, ox, oy)
    local rx = ox + self.rx
    local y = oy + self.top + 0.35
    for i = 1, 3 do
        local row = self.rows[i]
        if self.win_row == i then
            K.outline(rx - 1.05, y - 0.3, 2.1, 0.98, i == 1 and G.C.GOLD or G.C.CHIPS, 0.1, 0.05, 0.6 + 0.4 * sin(K.now() * 10))
        end
        local rj = K.jk(self.row_j[i])
        if row.name then
            K.text(row.name, rx, y, 0.36 * rj, G.C.UI.TEXT_LIGHT, "c")
        else
            for k = -1, 1 do K.center(JIMBO, rx + k * 0.42, y, 0.17 * rj, {shadow = false}) end
        end
        K.text(row.text, rx, y + 0.42, 0.5 * rj, i == 1 and G.C.GOLD or G.C.CHIPS, "c")
        y = y + 1.05
    end
    K.text(self.spin_text, ox + self.mid, oy + self.btn.y + self.btn.h + 0.38, 0.4, G.C.UI.TEXT_LIGHT, "c")
    K.draw_pops(self.pops, ox, oy)
end

MG.register{
    key = "slots",
    name = "Slot Machine",
    desc = "Spin three reels of jokers and stop them one by one",
    how = "Spin, then tap to stop each reel. Three Jimbos pay 150. 10 spins.",
    score = "Chips",
    new = function() return setmetatable({}, Game) end,
}

if mod_loc_register then
    mod_loc_register{
        fr = {["Slot Machine"] = "Machine à sous", ["Spin three reels of jokers and stop them one by one"] = "Lancez trois rouleaux de jokers et arrêtez-les un par un",
            ["Spin, then tap to stop each reel. Three Jimbos pay 150. 10 spins."] = "Lancez, puis touchez pour arrêter chaque rouleau. Trois Jimbo paient 150. 10 tours.",
            ["Spin"] = "Lancer", ["Stop"] = "Arrêter", ["Spins left: %d"] = "Tours restants : %d", ["Wins: %d of %d   Best win: +%d"] = "Gains : %d sur %d   Meilleur gain : +%d",
            ["Out of spins"] = "Plus de tours"},
        es = {["Slot Machine"] = "Tragaperras", ["Spin three reels of jokers and stop them one by one"] = "Gira tres rodillos de comodines y páralos uno a uno",
            ["Spin, then tap to stop each reel. Three Jimbos pay 150. 10 spins."] = "Gira y toca para parar cada rodillo. Tres Jimbos pagan 150. 10 giros.",
            ["Spin"] = "Girar", ["Stop"] = "Parar", ["Spins left: %d"] = "Giros restantes: %d", ["Wins: %d of %d   Best win: +%d"] = "Premios: %d de %d   Mejor premio: +%d",
            ["Out of spins"] = "Sin giros"},
    }
end

return Game
