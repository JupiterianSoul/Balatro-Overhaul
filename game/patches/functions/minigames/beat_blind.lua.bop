        fr = {["Beat the Blind"] = "Battez la blinde", ["Beat blind after blind with poker hands and level them up with planets"] = "Battez blinde après blinde avec des mains de poker et montez-les de niveau avec des planètes",
            ["Score at least the target in 3 hands to beat each blind. Every win levels up a hand."] = "Atteignez le score demandé en 3 mains pour battre chaque blinde. Chaque victoire monte une main de niveau.",
