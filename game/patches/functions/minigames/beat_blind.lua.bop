            ["Lost to %s on ante %d"] = "Battu par %s à la mise %d", ["Blinds beaten: %d"] = "Blindes battues : %d", ["Best hand: %s for %d"] = "Meilleure main : %s pour %d"},
        es = {["Beat the Blind"] = "Vence a la ciega", ["Beat blind after blind with poker hands and level them up with planets"] = "Vence ciega tras ciega con manos de póker y súbelas de nivel con planetas",
            ["Score at least the target in 3 hands to beat each blind. Every win levels up a hand."] = "Consigue la puntuación pedida en 3 manos para vencer cada ciega. Cada victoria sube una mano de nivel.",
            ["Pick up to 5 cards"] = "Elige hasta 5 cartas", ["Pick a planet"] = "Elige un planeta", ["Blind defeated!"] = "¡Ciega vencida!",
            ["Lost to %s on ante %d"] = "Derrota ante %s en la apuesta inicial %d", ["Blinds beaten: %d"] = "Ciegas vencidas: %d", ["Best hand: %s for %d"] = "Mejor mano: %s por %d"},
    }
end

