    self.t = self.t + dt
    local ease = min(1, dt * 12)
    local lifted = (self.state == "score" or self.state == "total") and 0.4 or 0.3
    for i = 1, #self.hand do
        local c = self.hand[i]
        if c.delay > 0 then
            c.delay = c.delay - dt
        else
            c.x = c.x + (self:target_x(i) - c.x) * ease
        end
        local want = c.sel and lifted or 0
        c.lift = c.lift + (want - c.lift) * ease
    end
    if self.round_disp ~= self.round then
        local d = self.round_disp + (self.round - self.round_disp) * min(1, dt * 7)
        if abs(self.round - d) < 0.5 then d = self.round end
        local before = floor(self.round_disp + 0.5)
        self.round_disp = d
        local now = floor(d + 0.5)
        if now ~= before then self.round_text = tostring(now) end
    end
    local st = self.state
    if st == "score" and self.t >= STEP then
        self.t = 0
        self:score_step()
    elseif st == "total" and self.t >= TOTAL then
        self.state = "clear"
        self.t = 0
    elseif (st == "clear" or st == "discard") and self.t >= FADE then
        self:remove_gone()
        self.t = 0
        if st == "clear" and self.round >= self.target then
            self.beaten = self.beaten + 1
            self.state = "won"
            K.sound("win", 1, 0.45)
            K.flash(G.C.GOLD, 0.25)
            K.shake(0.08)
            K.juice(self.bp, 0.6)
        elseif st == "clear" and self.hands <= 0 then
            self:lose()
        else
            self:fill()
            self.state = "select"
        end
    elseif st == "won" and self.t >= WON then
        self:make_offer()
        self.state = "pick"
        self.t = 0
        K.sound("cardFan2", 1, 0.5)
    elseif st == "chosen" and self.t >= CHOSEN then
        self:advance()
    end
end

function Game:draw_top(ox, oy)
    local bp = self.bp
    local x, y = ox + bp.x, oy + bp.y
    local jb = K.jk(bp)
    K.rect(x, y, bp.w, bp.h, box_col, 0.12)
    K.panel(x, y, bp.w, 0.4, self.bcol, 0.1, 1, 0.04)
    K.text(self.bname, x + bp.w / 2, y + 0.2, K.fit(self.bname, 0.42, bp.w - 0.3) * jb, G.C.UI.TEXT_LIGHT, "c")
    local nl = #self.blines
    local r0 = y + 0.69
    if nl > 0 then
        local fy, fh = y + 0.45, 0.48
        local bad = self.state == "select" and not self.ok
        K.rect(x + 0.08, fy, bp.w - 0.16, fh, bad and G.C.RED or self.dcol, 0.08)
        local jf = K.jk(self.fx_j)
        for i, line in ipairs(self.blines) do
            local ly = fy + fh / 2 + (i - (nl + 1) / 2) * 0.21
            K.text(line, x + bp.w / 2, ly, K.fit(line, 0.29, bp.w - 0.36) * jf, G.C.UI.TEXT_LIGHT, "c")
        end
        r0 = y + 0.97
    end
    K.blind(self.blind, x + 0.5, r0 + 0.42, 0.72 * jb)
    local tx, tw = x + 0.98, bp.w - 1.08
    local mid = tx + tw / 2
    K.text(self.at_least, mid, r0 + 0.1, K.fit(self.at_least, 0.28, tw), G.C.UI.TEXT_LIGHT, "c")
    K.text(self.target_text, mid, r0 + 0.365, K.fit(self.target_text, 0.46, tw), G.C.RED, "c")
    local u = min(1, self.round_disp / max(1, self.target))
    local jr = K.jk(self.bar)
    local bh = 0.26 * jr
    local by = r0 + 0.7 - bh / 2
    K.rect(tx, by, tw, bh, bar_bg, 0.08)
    if u > 0 then K.rect(tx, by, max(0.16, tw * u), bh, u >= 1 and G.C.GREEN or G.C.CHIPS, 0.08) end
    K.text(self.round_text, mid, r0 + 0.7, K.fit(self.round_text, 0.31, tw - 0.1) * jr, G.C.UI.TEXT_LIGHT, "c")
    local cx = self.cx
    local ns = UIK.touch() and 0.46 or 0.44
    local ty = y + 0.25
    local picking = self.state == "pick" or self.state == "chosen"
    if picking then
        local pu = self.state == "pick" and K.out_back(min(1, self.t / 0.3)) or 1
        K.text(self.pick_title, ox + cx, y + bp.h / 2, K.fit(self.pick_title, UIK.touch() and 0.6 or 0.58, 3.6) * pu, G.C.GOLD, "c")
    end
    if self.state == "total" and self.total_text then
        K.text(self.total_text, ox + cx, ty, K.fit(self.total_text, ns * 1.3, 3.6) * K.out_back(min(1, self.t / 0.2)), self.blocked and G.C.RED or G.C.GOLD, "c")
    elseif self.name ~= "" and (self.state == "select" or self.state == "score") then
        K.text(self.name, ox + cx, ty, K.fit(self.name, ns, 3.6) * K.jk(self.name_j), self.ok and G.C.UI.TEXT_LIGHT or G.C.RED, "c")
    end
    local bw, bh2, top = 1.45, 1.0, y + 0.55
    if not picking then
        local jc, jm = K.jk(self.box_c), K.jk(self.box_m)
        K.panel(ox + cx - 0.3 - bw + bw * (1 - jc) / 2, top, bw * jc, bh2, G.C.CHIPS, 0.1)
        K.text(self.ctext, ox + cx - 0.3 - bw / 2, top + bh2 / 2, K.fit(self.ctext, 0.62, bw - 0.15) * jc, G.C.UI.TEXT_LIGHT, "c")
        K.text("X", ox + cx, top + bh2 / 2, 0.5, G.C.RED, "c")
        K.panel(ox + cx + 0.3 + bw * (1 - jm) / 2, top, bw * jm, bh2, G.C.MULT, 0.1)
        K.text(self.mtext, ox + cx + 0.3 + bw / 2, top + bh2 / 2, K.fit(self.mtext, 0.62, bw - 0.15) * jm, G.C.UI.TEXT_LIGHT, "c")
    end
    local rx, sw = ox + self.rx, 1.05
    local jh, jd = K.jk(self.box_h), K.jk(self.box_d)
    K.text(self.hands_label, rx, ty, K.fit(self.hands_label, 0.34, 1.3), G.C.UI.TEXT_LIGHT, "c")
    K.panel(rx - sw * jh / 2, top, sw * jh, bh2, G.C.BLUE, 0.1)
    K.text(self.htext, rx, top + bh2 / 2, 0.62 * jh, G.C.UI.TEXT_LIGHT, "c")
    K.text(self.disc_label, rx + 1.35, ty, K.fit(self.disc_label, 0.34, 1.3), G.C.UI.TEXT_LIGHT, "c")
    K.panel(rx + 1.35 - sw * jd / 2, top, sw * jd, bh2, G.C.RED, 0.1)
    K.text(self.dtext, rx + 1.35, top + bh2 / 2, 0.62 * jd, G.C.UI.TEXT_LIGHT, "c")
end

function Game:draw_hint(ox, oy)
    if self.state ~= "select" or self.boss or #self:selected() > 0 then return end
    local hs = UIK.touch() and 0.36 or 0.34
    local pulse = 0.75 + 0.25 * sin(K.now() * 3)
    K.text(self.hint, ox + self.W / 2, oy + self.hint_y, K.fit(self.hint, hs, self.W - 0.4), G.C.GOLD, "c", pulse)
end

function Game:draw_hand(ox, oy)
    local s = self.s
    local st = self.state
    local fading = st == "clear" or st == "discard"
    local hw, hh = self.gx / 2, K.card_h() * s / 2
    local all = st == "won" and max(0, 1 - self.t / 0.35) or 1
    if all > 0 then
        for i = 1, #self.hand do
            local c = self.hand[i]
            local a = (fading and (c.sel or (st == "clear" and c.hook))) and max(0, 1 - self.t / FADE) or all
            local hov = st == "select" and K.hover(c, ox + c.x - hw, oy + self.hy - c.lift - hh, hw * 2, hh * 2)
            K.card(c.key, ox + c.x, oy + self.hy - c.lift - ((hov and not c.sel) and 0.08 or 0), s * K.jk(c), {r = K.jr(c), a = a})
        end
    end
    if st == "won" then
        local u = K.out_back(min(1, self.t / 0.25))
        local str = L("Blind defeated!")
        K.text(str, ox + self.W / 2, oy + self.hy - 0.2, K.fit(str, UIK.touch() and 0.8 or 0.75, self.W - 0.6) * u, G.C.GOLD, "c")
        return
    end
    self:draw_hint(ox, oy)
    local n = #self.played
    local busy = st ~= "select"
    self.play.disabled = busy or n == 0
    self.disc.disabled = busy or n == 0 or self.discards <= 0
    K.button(self.play, 1, ox, oy)
    K.button(self.disc, 1, ox, oy)
end

function Game:draw_pick(ox, oy)
    local u = self.state == "pick" and K.smooth(min(1, self.t / 0.3)) or 1
    local hw, hh = K.card_w() * self.ps / 2, K.card_h() * self.ps / 2
    for i, o in ipairs(self.offer or {}) do
        local dim = self.chosen and self.chosen ~= i
        local k = dim and (1 - 0.15 * K.smooth(min(1, self.t / 0.25))) or 1
        local hov = self.state == "pick" and K.hover(o.j, ox + o.x - hw, oy + self.py - hh, hw * 2, hh * 2)
        local lift = (hov or (self.focus == i and not self.chosen)) and 0.1 or 0
        K.center(o.key, ox + o.x, oy + self.py - lift - (1 - u) * 0.4, self.ps * k * K.jk(o.j), {r = K.jr(o.j)})
        K.text(o.lv, ox + o.x, oy + self.lv_y, K.fit(o.lv, UIK.touch() and 0.36 or 0.34, o.btn.w), dim and G.C.UI.TEXT_INACTIVE or G.C.UI.TEXT_LIGHT, "c", u)
        o.btn.disabled = self.state ~= "pick" and self.chosen ~= i
        K.button(o.btn, u, ox, oy)
        if self.focus == i and self.state == "pick" and self.keyed then
            K.outline(ox + o.btn.x - 0.05, oy + o.btn.y - 0.05, o.btn.w + 0.1, o.btn.h + 0.17, G.C.WHITE, 0.12, 0.04, 0.8)
        end
    end
end

function Game:draw(ox, oy)
    self:draw_top(ox, oy)
    if self.state == "pick" or self.state == "chosen" then self:draw_pick(ox, oy) else self:draw_hand(ox, oy) end
    K.draw_pops(self.pops, ox, oy)
end

MG.register{
    key = "beat_blind",
    name = "Beat the Blind",
    desc = "Beat blind after blind with poker hands and level them up with planets",
    how = "Score at least the target in 3 hands to beat each blind. Every win levels up a hand.",
    score = "Chips",
    new = function() return setmetatable({}, Game) end,
}

