    self.t = self.t + dt
    if self.sv ~= self.score then
        local d = self.sv + (self.score - self.sv) * min(1, dt * 8)
        if math.abs(self.score - d) < 0.5 then d = self.score end
        if math.floor(d + 0.5) ~= math.floor(self.sv + 0.5) then self.stack_text = tostring(math.floor(d + 0.5)) end
        self.sv = d
    end
    for i = 1, #self.ph do local c = self.ph[i] c.dt = c.dt + dt c.f = c.up and max(0, c.f - dt / 0.2) or 1 end
    for i = 1, #self.dh do local c = self.dh[i] c.dt = c.dt + dt c.f = c.up and max(0, c.f - dt / 0.2) or 1 end
    local st = self.state
    if st == "deal" and self.t >= DEAL then
        self.t = 0
        self:refresh()
        self.step = self.step + 1
        if self.step == 1 or self.step == 3 then self:give(self.ph, true)
        elseif self.step == 2 then self:give(self.dh, true)
        elseif self.step == 4 then self:give(self.dh, false) end
        if self.step >= 4 then
            if value(self.ph) == 21 then self:dealer_turn() else self.state = "player" end
        end
    elseif st == "hitting" and self.t >= DEAL then
        self:refresh()
        local v = value(self.ph)
        if v > 21 then
            for i = 1, #self.dh do self.dh[i].up = true end
            self:refresh()
            self:finish()
        elseif v == 21 then self:dealer_turn()
        else self.state = "player" end
    elseif st == "doubling" and self.t >= DEAL then
        self:refresh()
        if value(self.ph) > 21 then
            for i = 1, #self.dh do self.dh[i].up = true end
            self:refresh()
            self:finish()
        else
            self:dealer_turn()
        end
    elseif st == "dealer" and self.t >= DEALER then
        self.t = 0
        self:refresh()
        if value(self.dh) < 17 then
            self:give(self.dh, true)
        else
            self:finish()
        end
    elseif st == "settle" and self.t >= SETTLE then
        if self.hand_no >= HANDS or self.score < BET then
            self.result = self.score < BET and "Out of chips" or "Table closed"
            if self.score >= START then self.result_col = G.C.GOLD end
            self.summary = string.format(L("Won: %d   Lost: %d   Pushes: %d"), self.won, self.lost, self.pushes)
            self.over = true
        else
            self:new_hand()
        end
    end
end

function Game:draw_hand(hand, y, ox, oy)
    local s = self.s
    local gx = K.card_w() * s * 0.62
    local n = #hand
    local x0 = self.mid - (n - 1) * gx / 2
    for i = 1, n do
        local c = hand[i]
        local u = K.smooth(min(1, c.dt / DEAL))
        local x = K.lerp(self.deck_x, x0 + (i - 1) * gx, u)
        local yy = K.lerp(self.deck_y, y, u)
        if u >= 1 and not c.landed then c.landed = true K.juice(c, 0.2) end
        if u >= 1 and hand == self.ph and self.state == "player" then K.hover(c, ox + x - gx / 2, oy + yy - K.card_h() * s / 2, gx, K.card_h() * s) end
        K.card(c.key, ox + x, oy + yy, s * K.jk(c), {flip = c.f, r = K.jr(c)})
    end
    return x0 + (n - 1) * gx + K.card_w() * s / 2
end

function Game:draw(ox, oy)
    local s = self.s
    for i = 3, 1, -1 do K.card(nil, ox + self.deck_x + i * 0.03, oy + self.deck_y - i * 0.03, s, {flip = 1, shadow = i == 3}) end
    local jk = K.jk(self.box)
    K.chip("stake_gold", ox + self.deck_x - 0.55, oy + self.deck_y + 1.4, 0.42 * jk)
    local sc = (self.sv < self.score - 0.5 and G.C.GREEN) or (self.sv > self.score + 0.5 and G.C.RED) or G.C.GOLD
    K.text(self.stack_text, ox + self.deck_x - 0.25, oy + self.deck_y + 1.4, 0.55 * jk, sc, "l")
    K.text(self.hand_text, ox + self.deck_x, oy + self.deck_y + 2.05, 0.38, G.C.UI.TEXT_LIGHT, "c")
    local dx = self:draw_hand(self.dh, self.dy, ox, oy)
    local px = self:draw_hand(self.ph, self.py, ox, oy)
    if #self.dh > 0 then K.text(self.dtext, ox + dx + 0.3, oy + self.dy, 0.55 * K.jk(self.dj), G.C.UI.TEXT_LIGHT, "l") end
    if #self.ph > 0 then K.text(self.ptext, ox + px + 0.3, oy + self.py, 0.55 * K.jk(self.pj), (self.ptext == "21" and G.C.GOLD) or G.C.UI.TEXT_LIGHT, "l") end
    if self.msg ~= "" then
        local k = K.out_back(min(1, self.t / 0.25))
        K.text(L(self.msg), ox + self.mid, oy + (self.dy + self.py) / 2, 0.7 * k, self.msg_col, "c")
    end
    local off = self.state ~= "player"
    self.hit.disabled, self.stand.disabled = off, off
    self.double.disabled = off or #self.ph ~= 2 or self.score < 2 * BET
    K.button(self.hit, 1, ox, oy)
    K.button(self.stand, 1, ox, oy)
    K.button(self.double, 1, ox, oy)
    K.draw_pops(self.pops, ox, oy)
end

