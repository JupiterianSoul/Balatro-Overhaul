local MG = Minigames
local K = MG.kit
local L = MG.L
local H = MG.host or {}
MG.host = H

local min, max = math.min, math.max

H.CHECK_EVERY = 0.2
H.GAP = 0.18
H.PAD = 0.3
H.view = H.view or {name = ""}
H.next_check = 0

local function alive(o) return o and not o.REMOVED end

local function in_match()
    return bom_match and bom_match.is_in_match and bom_match.is_in_match()
end

local function lobby_waiting(st)
    return st and (st.waiting_guest or not st.opp_name or (st.my_ready and not st.opp_ready)) and true or false
end

function H.wait_kind()
    if not (G and G.STAGES) then return nil end
    if bom_playback and bom_playback.active and bom_playback.active() then return nil end
    if alive(G.BOM_PVP_WAITING_OVERLAY) then return "pvp_finish" end
    if in_match() and G.STATE == G.STATES.BLIND_SELECT and G.GAME and G.GAME.mp_blind_ready then return "pvp_ready" end
    local R = bom_rejoin and bom_rejoin.opp_away
    if R and not R.dismissed and not R.leaving and in_match() then return "away" end
    if G.GAME and G.GAME.mp_searching and G.OVERLAY_MENU then return "search" end
    local U = bom_ranked_ui and bom_ranked_ui.Q
    if U and U.status == "searching" then return "queue" end
    if bom_match and bom_match.get_phase and bom_match.get_phase() == "lobby" and G.OVERLAY_MENU then
        if bom_party and bom_party.active and bom_party.active() then
            local open = bom_party.lobby_open and bom_party.lobby_open()
            if open == nil then open = UIK and UIK._win and UIK._win.id == "party" and G.OVERLAY_MENU == bom_party._box end
            if open then return "party_lobby" end
            return nil
        end
        if lobby_waiting(bom_match.get_state and bom_match.get_state()) then return "lobby" end
    end
    return nil
end

local function frame()
    local o = G.OVERLAY_MENU
    if not (alive(o) and o.UIRoot) then return nil end
    local R = G.ROOM and G.ROOM.T or {w = 20, h = 11.5}
    local best, area = nil, 0
    local queue, qi = {o.UIRoot}, 1
    while queue[qi] and qi <= 120 do
        local node = queue[qi]
        qi = qi + 1
        local V, c = node.VT, node.config and node.config.colour
        if node ~= o.UIRoot and V and V.w >= 2 and V.h >= 1.5 and V.w <= R.w * 1.2 and V.h <= R.h * 1.4
            and type(c) == "table" and (c[4] or 1) > 0.3 and V.w * V.h > area then
            best, area = V, V.w * V.h
        end
        if type(node.children) == "table" then
            for _, ch in ipairs(node.children) do queue[#queue + 1] = ch end
        end
    end
    return best
end
H.frame = frame

local function screen()
    if bom_emotes and bom_emotes.screen_box then return bom_emotes.screen_box() end
    local R = G.ROOM and G.ROOM.T or {w = 20, h = 11.5}
    return 0, 0, R.w, R.h
end

local function each_node(node, fn)
    if not node then return end
    fn(node)
    if type(node.children) == "table" then
        for _, ch in pairs(node.children) do each_node(ch, fn) end
    end
end

local function over_px(b, x, y, w, h, sx, sy, s)
    if not (b and b.w and b.h) then return false end
    local bx, by, bw, bh = sx + b.x / s - H.GAP, sy + b.y / s - H.GAP, b.w / s + 2 * H.GAP, b.h / s + 2 * H.GAP
    return x < bx + bw and bx < x + w and y < by + bh and by < y + h
end

local ver_box = {x = 0, y = 0, w = 0, h = 0}

local function on_labels(x, y, w, h, sx, sy)
    local CL = CORNER_LABELS
    if not CL then return false end
    local s = (G.TILESIZE or 20) * (G.TILESCALE or 1)
    if over_px(CL.status_box, x, y, w, h, sx, sy, s) then return true end
    local GR = G.SETTINGS and G.SETTINGS.GRAPHICS
    if GR and GR.show_fps and over_px(CL.fps_box, x, y, w, h, sx, sy, s) then return true end
    if _G._IS_DESKTOP and G.STAGE == G.STAGES.MAIN_MENU and CL.box and CL.version_text then
        local ok, vw, vh = pcall(CL.box, CL.version_text(), 1, CL.last_font or love.graphics.getFont())
        if ok and vw then
            ver_box.w, ver_box.h = vw, vh + 46
            ver_box.x, ver_box.y = love.graphics.getWidth() - (CL.MARGIN or 10) - vw, 0
            if over_px(ver_box, x, y, w, h, sx, sy, s) then return true end
        end
    end
    return false
end

local function fits(x, y, w, h)
    local sx, sy, sw, sh = screen()
    if not (x >= sx + H.PAD and y >= sy + H.PAD and x + w <= sx + sw - H.PAD and y + h <= sy + sh - H.PAD) then return false end
    return not on_labels(x, y, w, h, sx, sy)
end

function H.button_spot(kind, w, h)
    if kind == "pvp_finish" then return nil end
    local F = frame()
    if kind == "pvp_ready" or (kind == "away" and not F) then
        local mb = bom_social and bom_social.S and bom_social.S.match_button
        local bx0, bx1, by1 = nil, nil, nil
        local chat = package.loaded["multiplayer.mps_chat"]
        for _, b in ipairs({mb or false, type(chat) == "table" and chat.run_button or false}) do
            local V = alive(b) and b.VT
            if V and V.w > 0.1 then
                bx0 = min(bx0 or V.x, V.x)
                bx1, by1 = max(bx1 or V.x + V.w, V.x + V.w), max(by1 or V.y + V.h, V.y + V.h)
            end
        end
        if bx0 then
            local x, y = (bx0 + bx1) / 2 - w / 2, by1 + H.GAP
            if fits(x, y, w, h) then return x, y end
        end
        local D = G.deck and G.deck.T
        if D then
            local x, y = D.x + D.w / 2 - w / 2, D.y - h - H.GAP * 2
            if fits(x, y, w, h) then return x, y end
        end
        return nil
    end
    if not F then return nil end
    local _, sy = screen()
    local top = max(F.y + 0.1, sy + H.PAD)
    local bottom = F.y + F.h - h
    local rx, lx, cx = F.x + F.w + H.GAP, F.x - H.GAP - w, F.x + F.w / 2 - w / 2
    local y = top
    while y <= bottom + 1e-6 do
        if fits(rx, y, w, h) then return rx, y end
        y = y + 0.25
    end
    if fits(cx, F.y + F.h + H.GAP, w, h) then return cx, F.y + F.h + H.GAP end
    if fits(cx, F.y - h - H.GAP, w, h) then return cx, F.y - h - H.GAP end
    y = top
    while y <= bottom + 1e-6 do
        if fits(lx, y, w, h) then return lx, y end
        y = y + 0.25
    end
    return nil
end

local function pin(box)
    box.created_on_pause = true
    each_node(box.UIRoot, function(n)
        n.created_on_pause = true
        if n.config and n.config.object then n.config.object.created_on_pause = true end
    end)
end

local function button_size(tall)
    local touch = UIK.touch()
    local sc = touch and 0.42 or 0.36
    if tall then
        local a, b = L("Play while"), L("you wait")
        local w = max(touch and 2.2 or 1.9, UIK.text_w(a, sc) + 0.4, UIK.text_w(b, sc) + 0.4)
        return w, touch and 1.1 or 0.92, sc, {a, b}
    end
    local label = L("Play while you wait")
    local w = max(touch and 3.3 or 2.9, UIK.text_w(label, sc) + 0.5)
    return w, touch and 0.8 or 0.62, sc, {label}
end

local function remove_button()
    if H.btn then pcall(function() H.btn:remove() end) end
    H.btn = nil
end

function H.update_button(kind)
    if H.win or not kind or kind == "lobby" or kind == "party_lobby" or #MG.enabled() == 0 then remove_button() return end
    local tall = false
    local w, h, sc, label = button_size(false)
    local x, y = H.button_spot(kind, w, h)
    if not x then
        tall = true
        w, h, sc, label = button_size(true)
        x, y = H.button_spot(kind, w, h)
    end
    if not x then remove_button() return end
    if alive(H.btn) and H.btn_tall ~= tall then remove_button() end
    H.btn_tall = tall
    if not alive(H.btn) then
        H.btn = UIBox{
            definition = {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR, padding = 0}, nodes = {
                UIK.button{label = label, button = "mg_wait_play", colour = UIK.C.purple, w = w, h = h, scale = sc, id = "mg_wait_play"},
            }},
            config = {align = "tli", offset = {x = x, y = y}, major = G.ROOM_ATTACH, bond = "Weak", instance_type = "POPUP"},
        }
        pin(H.btn)
        H.btn:align_to_major()
        H.btn:hard_set_VT()
    else
        H.btn.alignment.offset.x, H.btn.alignment.offset.y = x, y
        H.btn:align_to_major()
    end
    H.btn_kind = kind
end

