function MG.wants_key(key)
    if H.win and not H.closing then return true end
    return MG.pick and MG.pick.wants and MG.pick.wants(key) or false
end

function MG.wait_row()
    if not MG.available() or #MG.enabled() == 0 then return nil end
    if bom_playback and bom_playback.active and bom_playback.active() then return nil end
    local touch = UIK.touch()
    local sc = touch and 0.42 or 0.36
    local label = L("Play while you wait")
    return {n = G.UIT.R, config = {align = "cm", padding = 0.08}, nodes = {
        UIK.button{label = label, button = "mg_wait_play", colour = UIK.C.purple, w = max(touch and 3.3 or 2.9, UIK.text_w(label, sc) + 0.5), h = touch and 0.8 or 0.62, scale = sc, id = "mg_wait_row"},
    }}
end

function MG.end_wait()
    if H.win and H.mode == "wait" and not H.closing then H.close("ended") end
    remove_button()
end

function MG.lobby_wait(st)
    if not MG.available() or #MG.enabled() == 0 then return false end
    if st == true then return true end
    return lobby_waiting(st)
end

G.FUNCS.mg_close = function() H.close("back") end
G.FUNCS.mg_prev = function() H.switch(-1) end
G.FUNCS.mg_next = function() H.switch(1) end
G.FUNCS.mg_wait_play = function() H.open(H.last, "wait") end

