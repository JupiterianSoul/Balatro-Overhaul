local function build(text, card, card_left, chars, vertical)
    local t = touch()
    local scale = t and 0.42 or 0.36
    local rows = {}
    for _, line in ipairs(wrap(text, chars)) do
        rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.02}, nodes = {
            {n = G.UIT.T, config = {text = line, scale = scale, colour = G.C.UI.TEXT_DARK}},
        }}
    end
    local bubble = {n = G.UIT.C, config = {align = "cm", padding = 0.12, r = 0.12, colour = G.C.WHITE, emboss = 0.05, minh = G.CARD_H * (t and 0.5 or 0.42) * 0.8}, nodes = {
        {n = G.UIT.R, config = {align = "cm"}, nodes = {{n = G.UIT.C, config = {align = "cm"}, nodes = rows}}},
    }}
    local face = {n = G.UIT.C, config = {align = "cm"}, nodes = {{n = G.UIT.O, config = {object = card}}}}
    if vertical then
        return {n = G.UIT.ROOT, config = {align = "cm", padding = 0.08, r = 0.15, colour = G.C.CLEAR}, nodes = {
            {n = G.UIT.R, config = {align = "cm"}, nodes = {face}},
            {n = G.UIT.R, config = {minh = 0.1}},
            {n = G.UIT.R, config = {align = "cm"}, nodes = {bubble}},
        }}
    end
    local gap = {n = G.UIT.C, config = {minw = 0.1}}
    local row = card_left and {face, gap, bubble} or {bubble, gap, face}
    return {n = G.UIT.ROOT, config = {align = "cm", padding = 0.08, r = 0.15, colour = G.C.CLEAR}, nodes = {
        {n = G.UIT.R, config = {align = "cm"}, nodes = row},
    }}
end

local function rect_of(m, pad)
    if type(m) ~= "table" or type(m.T) ~= "table" then return nil end
    if m.REMOVED or (m.states and m.states.visible == false) then return nil end
    local T = m.VT or m.T
    if not (T.w and T.h) or T.w <= 0 or T.h <= 0 then return nil end
    pad = pad or 0
    return {x = T.x - pad, y = T.y - pad, w = T.w + 2 * pad, h = T.h + 2 * pad}
end

local function hits(a, b)
    return a.x < b.x + b.w and b.x < a.x + a.w and a.y < b.y + b.h and b.y < a.y + a.h
end

local function is_ours(box)
    return JC._box and box == JC._box
end

local function room_rect()
    local W, H = G.ROOM and G.ROOM.T.w or 20, G.ROOM and G.ROOM.T.h or 11.5
    local m = 0.2
    return {x = m, y = m, w = W - 2 * m, h = H - 2 * m}
end

function JC.obstacles(ignore)
    local out = {}
    local room = room_rect()
    local function add(r)
        if r and not (r.w >= room.w * 0.98 and r.h >= room.h * 0.98) then out[#out + 1] = r end
    end
    for _, area in ipairs(G.I and G.I.CARDAREA or {}) do
        if not area.REMOVED and not (area.states and area.states.visible == false) then
            local has = area.cards and #area.cards > 0
            if has or area == G.hand or area == G.jokers or area == G.deck then
                local r = rect_of(area, 0.1)
                if r then
                    if area == G.hand then r.y = r.y - 0.7 r.h = r.h + 0.7 end
                    add(r)
                end
                for _, c in ipairs(area.cards or {}) do add(rect_of(c, 0.05)) end
            end
        end
    end
    local cons = G.consumeables
    local empty_cons = cons and cons.children and (not cons.cards or #cons.cards == 0) and cons.children.area_uibox or nil
    for _, box in ipairs(G.I and G.I.UIBOX or {}) do
        if not is_ours(box) and box ~= ignore and box ~= empty_cons and box.states and box.states.visible ~= false and not box.REMOVED then
            local r = rect_of(box, 0.15)
            if r and not (r.w >= room.w * 0.95 and r.h >= room.h * 0.95) then add(r) end
        end
    end
    if empty_cons then
        local a, u = rect_of(cons, 0), rect_of(empty_cons, 0.15)
        if a and u then
            local top = math.max(u.y, a.y + a.h - 0.35)
            if u.y + u.h > top then add({x = u.x, y = top, w = u.w, h = u.y + u.h - top}) end
        end
    end
    local logo = rect_of(G.SPLASH_LOGO, 0.1)
    if logo then
        local inset = logo.w * 0.05
        add({x = logo.x + inset, y = logo.y, w = logo.w - 2 * inset, h = logo.h})
    end
    add(rect_of(G.title_top, 0.1))
    return out
end

local function free(r, obs)
    for i = 1, #obs do
        if hits(r, obs[i]) then return false end
    end
    return true
end

local function inside(r, room)
    return r.x >= room.x and r.y >= room.y and r.x + r.w <= room.x + room.w and r.y + r.h <= room.y + room.h
end

function JC.find_spot(w, h, focus, obs)
    local room = room_rect()
    obs = obs or JC.obstacles()
    local fx = focus and focus.x or room.x + room.w / 2
    local fy = focus and focus.y or room.y + room.h * 0.45
    local best, best_d = nil, nil
    local step = 0.2
    local y = room.y
    while y + h <= room.y + room.h + 0.001 do
        local x = room.x
        while x + w <= room.x + room.w + 0.001 do
            local r = {x = x, y = y, w = w, h = h}
            local cx, cy = x + w / 2, y + h / 2
            local d = (cx - fx) ^ 2 + ((cy - fy) * 1.3) ^ 2
            if (not best_d or d < best_d) and free(r, obs) then best, best_d = r, d end
            x = x + step
        end
        y = y + step
    end
    return best
end

local function center_of(m)
    local r = rect_of(m)
    if not r then return nil end
    return {x = r.x + r.w / 2, y = r.y + r.h / 2}
end

local FOCUS = {
    hand = function() return (G.play and G.play.cards and #G.play.cards > 0 and center_of(G.play)) or center_of(G.play) or center_of(G.hand) end,
    blind = function() return center_of(G.HUD_blind) or center_of(G.play) end,
    money = function()
        local e = G.HUD and G.HUD.get_UIE_by_ID and G.HUD:get_UIE_by_ID("dollar_text_UI")
        return center_of(e) or center_of(G.HUD)
    end,
    joker = function() return center_of(G.jokers) end,
    center = function() return center_of(G.play) end,
}

function JC.hide()
    if JC._box then
        pcall(function() JC._box:remove() end)
    end
    JC._box, JC._msg, JC._until, JC._prio = nil, nil, 0, nil
end

local function say_sound()
    pcall(play_sound, "voice" .. rand(1, 11), (G.SPEEDFACTOR or 1) * (rand() * 0.2 + 1), 0.35)
end

local function place(box, focus)
    local w, h = box.T.w, box.T.h
    local spot = JC.find_spot(w, h, focus)
    if not spot then return false end
    box.alignment.offset.x = spot.x - (G.ROOM_ATTACH.T.x or 0)
    box.alignment.offset.y = spot.y - (G.ROOM_ATTACH.T.y or 0)
    box:align_to_major()
    return true
end

local function widths()
    if portrait() then return {{24}, {18}, {14}, {14, true}, {12, true}} end
    if touch() then return {{30}, {22}, {16}, {16, true}, {14, true}, {12, true}} end
    return {{32}, {22}, {16}, {16, true}, {14, true}, {12, true}}
end

local function build_placed(text, focus)
    local card_left = true
    if focus and G.ROOM then card_left = focus.x >= G.ROOM.T.w / 2 end
    for _, wd in ipairs(widths()) do
        local card = make_card()
        local box = UIBox{
            definition = build(text, card, card_left, wd[1], wd[2]),
            config = {align = "tli", offset = {x = -30, y = -30}, major = G.ROOM_ATTACH, bond = "Weak", instance_type = "POPUP"},
        }
        JC._box = box
        if place(box, focus) then
            box:hard_set_VT()
            box.states.collide.can = false
            return box, card
        end
        pcall(function() box:remove() end)
        JC._box = nil
    end
    return nil
end

function JC.show(text, prio, focus_kind, keep_time)
    if not (G and G.ROOM_ATTACH and G.UIT and Card) then return false end
    local until_t = keep_time and JC._until
    JC.hide()
    local focus_fn = FOCUS[focus_kind or ""]
    local focus = focus_fn and focus_fn() or nil
    local ok, box, card = pcall(build_placed, text, focus)
    if not ok or not box then
        JC.hide()
        if not ok then JC.last_error = box end
        return false
    end
    if not keep_time then card:juice_up(0.3, 0.3) end
    JC._msg, JC._until, JC._prio, JC._focus = text, until_t or (now() + JC.DISPLAY + math.min(3, #text / 30)), prio or 0, focus_kind
    JC._shown_at = now()
    if not keep_time then say_sound() end
    return true
end

local function blocked()
    if not enabled() then return true end
    if G.OVERLAY_TUTORIAL then return true end
    if G.SETTINGS and G.SETTINGS.paused and G.STAGE == G.STAGES.RUN then return true end
    if G.STAGE == G.STAGES.SANDBOX then return true end
    if G.STAGE == G.STAGES.RUN and G.OVERLAY_MENU then return true end
    return false
end

function JC.fire(pool, vars, focus_kind, force)
    if blocked() and not force then JC.last_fail = "blocked" return false end
    local rule = POOL_RULES[pool] or {p = 1, cd = 60}
    local t = now()
    if not force then
        if rule.chance and rand() > rule.chance then JC.last_fail = "chance " .. pool return false end
        local last = JC._last_pool_at[pool]
        if last and rule.cd > 0 and t - last < rule.cd then return false end
        if JC._msg and (JC._prio or 0) >= rule.p then return false end
        local gap = JC.GAPS[rate()]
        if rule.p < 3 and t - (JC._last_at or 0) < gap then return false end
        if rule.p >= 3 and t - (JC._last_at or 0) < 3 then return false end
    end
    local line = pick(pool)
    if not line then return false end
    local text = fill(line, vars)
    JC.last_fail = "no room " .. pool
    if JC.show(text, rule.p, focus_kind) then
        JC.last_fail = nil
        JC._last_pool_at[pool] = t
        JC._last_at = t
        JC._last_line = line
        JC._last_pool = pool
        return true
    end
    return false
end

local function blind_key()
    local b = G.GAME and G.GAME.blind
    return b and b.config and b.config.blind and b.config.blind.key
end

local function blind_name()
    local key = blind_key()
    local ok, name = pcall(localize, {type = "name_text", key = key, set = "Blind"})
    if ok and type(name) == "string" and name ~= "ERROR" then return name end
    local b = G.GAME and G.GAME.blind
    return b and b.name or "the boss"
end

local function joker_name(card)
    local key = card.config and card.config.center and card.config.center.key
    local ok, name = pcall(localize, {type = "name_text", key = key, set = "Joker"})
    if ok and type(name) == "string" and name ~= "ERROR" then return name end
    return card.ability and card.ability.name or "that Joker"
end

local function hand_label(name)
    local ok, s = pcall(localize, name, "poker_hands")
    if ok and type(s) == "string" and s ~= "ERROR" then return s end
    return name
end

local function in_mp()
    return G.GAME and G.GAME.multiplayer and true or false
end

local function pvp_now()
    local ok, r = pcall(function() return bom_match and bom_match.is_pvp_blind and bom_match.is_pvp_blind() end)
    return ok and r or false
end

local PACK_STATES = {}
local function is_pack(state)
    if not next(PACK_STATES) then
        for _, k in ipairs({"TAROT_PACK", "PLANET_PACK", "SPECTRAL_PACK", "STANDARD_PACK", "BUFFOON_PACK", "SMODS_BOOSTER_OPENED"}) do
            if G.STATES[k] then PACK_STATES[G.STATES[k]] = true end
        end
    end
    return PACK_STATES[state] or false
end

local S = {}
JC._snap = S

local function reset_run(game)
    S.game = game
    S.jokers = {}
    for _, j in ipairs(G.jokers and G.jokers.cards or {}) do S.jokers[j] = true end
    S.ante = G.GAME.round_resets and G.GAME.round_resets.ante or 1
    S.dollars = G.GAME.dollars or 0
    S.skips = G.GAME.skips or 0
    S.won = G.GAME.won
    S.mp_lives = tonumber(G.GAME.mp_lives)
    S.opp_lives = tonumber(G.GAME.mp_opponent_lives) or (type(G.GAME.mp_opponent_panel) == "table" and tonumber(G.GAME.mp_opponent_panel.lives)) or nil
    S.rare_seen = {}
    S.streak = {}
    S.blind_seen = nil
    S.last_hand_blind = nil
    S.chips_before = nil
    S.target = nil
    S.boss = nil
    S.over = false
    S.money_band = nil
end

local function money_band(d)
    if d >= 100 then return 3 end
    if d >= 25 then return 2 end
    if d <= 2 then return 0 end
    return 1
end

local function on_hand_done()
    local score = (tonumber(G.GAME.chips) or 0) - (S.chips_before or 0)
    S.chips_before = nil
    local name = G.GAME.last_hand_played
    if not name or score <= 0 then return end
    local target = S.target or tonumber(G.GAME.blind and G.GAME.blind.chips) or 0
    local vars = {score = fmt_num(score), hand = hand_label(name)}
    S.streak[#S.streak + 1] = name
    if #S.streak > 5 then table.remove(S.streak, 1) end
    if RARE_HANDS[name] and not S.rare_seen[name] then
        S.rare_seen[name] = true
        if JC.fire("rare_hand", vars, "hand") then return end
    end
    if target > 0 and score >= target * 10 and JC.fire("huge_hand", vars, "hand") then return end
    if target > 0 and score >= target and (S.first_hand_of_blind) and JC.fire("one_shot", vars, "hand") then return end
    local best = G.GAME.round_scores and G.GAME.round_scores.hand and tonumber(G.GAME.round_scores.hand.amt) or 0
    if score >= best and (G.GAME.hands_played or 0) > 4 and JC.fire("best_hand", vars, "hand") then return end
    if #S.streak == 5 then
        local same = true
        for i = 2, 5 do if S.streak[i] ~= S.streak[1] then same = false end end
        if same and JC.fire("hand_streak", vars, "hand") then S.streak = {} return end
    end
    local hl = G.GAME.current_round and G.GAME.current_round.hands_left or 0
    local need = target - (tonumber(G.GAME.chips) or 0)
    if target > 0 and hl >= 1 and need > 0 and score * hl < need * 0.4 then JC.fire("weak_hand", vars, "hand") end
end

local function poll_run()
    local g = G.GAME
    if S.game ~= g then
        reset_run(g)
        if (g.round or 0) == 0 and S.ante <= 1 then
            S.pending_new = true
        end
    end
    local st = G.STATE
    local prev = S.state
    S.state = st

    if S.pending_new and st == G.STATES.BLIND_SELECT then
        S.pending_new = nil
        JC.fire("new_run", nil, "center")
    end

    if st == G.STATES.HAND_PLAYED and prev ~= st then
        S.chips_before = tonumber(g.chips) or 0
        S.first_hand_of_blind = (g.current_round and (g.current_round.hands_played or 0) <= 1) or false
    elseif prev == G.STATES.HAND_PLAYED and st ~= prev and S.chips_before then
        on_hand_done()
    end

    if st == G.STATES.SELECTING_HAND then
        local key = blind_key()
        local id = tostring(key) .. ":" .. tostring(g.round)
        if S.blind_seen ~= id then
            S.blind_seen = id
            S.target = tonumber(g.blind and g.blind.chips) or 0
            S.boss = g.blind and g.blind.boss and key or nil
            if in_mp() and pvp_now() then
                JC.fire("mp_pvp", nil, "blind")
            elseif S.boss then
                local pool = LINES["boss_" .. key] and (rand() < 0.75) and ("boss_" .. key) or "boss"
                if pool ~= "boss" then POOL_RULES[pool] = POOL_RULES[pool] or {p = 3, cd = 0} end
                JC.fire(pool, {boss = blind_name()}, "blind")
            end
        end
        local cr = g.current_round
        if cr and cr.hands_left == 1 and S.last_hand_blind ~= id then
            local need = (tonumber(g.blind and g.blind.chips) or 0) - (tonumber(g.chips) or 0)
            if need > 0 then
                S.last_hand_blind = id
                JC.fire("last_hand", {left = fmt_num(need)}, "hand")
            end
        end
    end

    if st == G.STATES.ROUND_EVAL and prev ~= st then
        local cr = g.current_round
        local chips, target = tonumber(g.chips) or 0, S.target or 0
        if cr and cr.hands_left == 0 then
            JC.fire("clutch_win", nil, "center")
        elseif target > 0 and chips < target * 1.1 then
            JC.fire("close_win", nil, "center")
        elseif S.boss then
            JC.fire("boss_beaten", {boss = blind_name()}, "center")
        end
    end

    if st == G.STATES.GAME_OVER and not S.over then
        S.over = true
        local chips, target = tonumber(g.chips) or 0, S.target or tonumber(g.blind and g.blind.chips) or 0
        if in_mp() then
            JC.fire("mp_lost", nil, "center", true)
        elseif target > 0 and chips >= target * 0.85 then
            JC.fire("near_miss", {left = fmt_num(math.max(0, target - chips))}, "center", true)
        else
            JC.fire("loss", nil, "center", true)
        end
    end

    if g.won and not S.won then
        S.won = true
        JC.fire(in_mp() and "mp_won" or "win", {ante = g.win_ante or 8}, "center", true)
    end

    local ante = g.round_resets and g.round_resets.ante or S.ante
    if ante > (S.ante or ante) then
        S.ante = ante
        local win_ante = g.win_ante or 8
        if ante == win_ante then JC.fire("final_ante", {ante = ante}, "blind")
        elseif ante > win_ante then JC.fire("endless", {ante = ante}, "blind")
        else JC.fire("ante_up", {ante = ante}, "blind") end
    end

    if (g.skips or 0) > (S.skips or 0) then
        S.skips = g.skips
        JC.fire("skip_blind", nil, "blind")
    end

    local cur = {}
    for _, j in ipairs(G.jokers and G.jokers.cards or {}) do
        cur[j] = true
        if not S.jokers[j] and not j._is_jimbo_visual then
            local r = j.config and j.config.center and j.config.center.rarity
            if r == 4 then JC.fire("legendary_joker", {joker = joker_name(j)}, "joker")
            elseif r == 3 then JC.fire("rare_joker", {joker = joker_name(j)}, "joker") end
        end
    end
    S.jokers = cur

    local d = tonumber(g.dollars) or 0
    local band = money_band(d)
    if S.money_band == nil then S.money_band = band end
    if band ~= S.money_band then
        local vars = {money = fmt_num(d)}
        if band == 3 and S.money_band < 3 then JC.fire("money_rich", vars, "money")
        elseif band == 2 and S.money_band < 2 then JC.fire("money_saved", vars, "money") end
        S.money_band = band
    end

    if st == G.STATES.SHOP and prev ~= st then
        if d <= 2 then JC.fire("money_broke", {money = fmt_num(d)}, "money")
        else JC.fire("shop", nil, "joker") end
    end
    if is_pack(st) and not is_pack(prev or -1) then JC.fire("pack", nil, "center") end

    if in_mp() then
        local panel = type(g.mp_opponent_panel) == "table" and g.mp_opponent_panel or nil
        local ml, ol = tonumber(g.mp_lives), tonumber(g.mp_opponent_lives) or (panel and tonumber(panel.lives))
        if ml and S.mp_lives and ml < S.mp_lives then
            if ml == 1 then JC.fire("mp_last_life", {lives = ml}, "center")
            elseif ml > 1 then JC.fire("mp_life_lost", {lives = ml}, "center") end
        end
        if ol and S.opp_lives and ol < S.opp_lives and ol > 0 then JC.fire("mp_opp_life", {lives = ol}, "center") end
        S.mp_lives, S.opp_lives = ml or S.mp_lives, ol or S.opp_lives
    end
end

local COLLECTION_IDS = {"your_collection_jokers", "your_collection_tarots", "your_collection_planets", "your_collection_spectrals", "your_collection_vouchers", "your_collection_boosters", "your_collection_tags", "your_collection_blinds", "your_collection_stakes", "your_collection_enhancements", "your_collection_seals", "your_collection_editions", "your_collection_decks"}

local function in_collection()
    local o = G.OVERLAY_MENU
    if not (o and o.get_UIE_by_ID) then return false end
    for _, id in ipairs(COLLECTION_IDS) do
        local ok, n = pcall(o.get_UIE_by_ID, o, id)
        if ok and n then return true end
    end
    return false
end

local function poll_menu()
    S.game = nil
    local t = now()
    if not JC._idle_at then
        local r = JC.IDLE[rate()]
        JC._idle_at = t + rand(r[1], r[2])
        return
    end
    if t < JC._idle_at then return end
    local r = JC.IDLE[rate()]
    JC._idle_at = t + rand(r[1], r[2])
r 23 214 %20%20%20%20 -
l 479
        if in_collection() then JC.fire("collection") end
        return
    end
    JC.fire("menu")
end

local function keep_placed()
    local box = JC._box
    if not box or box.REMOVED then JC.hide() return end
    local t = now()
    if t >= (JC._until or 0) then JC.hide() return end
    if t - (JC._check_at or 0) < 0.4 then return end
    JC._check_at = t
    local obs = JC.obstacles()
    local r = rect_of(box)
    if r and free(r, obs) and inside(r, room_rect()) then return end
    local fn = FOCUS[JC._focus or ""]
    local focus = fn and fn() or nil
    local spot = JC.find_spot(box.T.w, box.T.h, focus, obs)
    if not spot then
        JC.show(JC._msg, JC._prio, JC._focus, true)
        return
    end
    box.alignment.offset.x = spot.x - (G.ROOM_ATTACH.T.x or 0)
    box.alignment.offset.y = spot.y - (G.ROOM_ATTACH.T.y or 0)
    box:align_to_major()
end

local OLD_KEYS = {"ho_advisor", "jimbo_advanced", "jimbo_beginner", "advisor_jimbo_pos", "ho_auto_compact", "ho_num_suggestions", "ho_show_discards", "ho_show_outs",
    "ho_show_joker_order", "ho_mode", "ho_show_probs", "ho_show_reasons", "ho_perf_mode", "ho_compact_scale", "ho_panel_scale", "ho_beginner_mode"}

function JC.clean_settings()
    if JC._cleaned or not (G and G.SETTINGS) then return end
    JC._cleaned = true
    local dirty = false
    for _, k in ipairs(OLD_KEYS) do
        if G.SETTINGS[k] ~= nil then G.SETTINGS[k] = nil dirty = true end
    end
    if G.SETTINGS.jimbo_comments_rate == nil then G.SETTINGS.jimbo_comments_rate = 2 end
    if dirty and G.save_settings then pcall(function() G:save_settings() end) end
end

function JC.update(dt)
    if not G or not G.STAGES then return end
    JC.clean_settings()
    if JC._box then
        if not enabled() or G.OVERLAY_TUTORIAL or (G.STAGE == G.STAGES.RUN and G.OVERLAY_MENU) then JC.hide() else keep_placed() end
    end
    if not enabled() then return end
    if G.STAGE == G.STAGES.RUN and G.GAME then
        JC._idle_at = nil
        poll_run()
    elseif G.STAGE == G.STAGES.MAIN_MENU then
        poll_menu()
    end
end

function JC.say(pool, vars, focus_kind)
    return JC.fire(pool, vars, focus_kind, true)
end

function JC.clear()
    JC.hide()
end

function JC.rect()
    return JC._box and rect_of(JC._box) or nil
end

local _orig_start_run = Game and Game.start_run
if _orig_start_run then
    Game.start_run = function(self, ...)
        JC.hide()
        return _orig_start_run(self, ...)
    end
end

