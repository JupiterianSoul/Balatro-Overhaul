local rng = love and love.math and love.math.newRandomGenerator and love.math.newRandomGenerator(os.time()) or nil
local function rand(a, b)
    if rng then
        if a then return rng:random(a, b) end
        return rng:random()
    end
    if a then return a + math.floor((b - a + 1) * ((os.clock() * 7919) % 1)) end
    return (os.clock() * 7919) % 1
end

local function now()
    return love.timer.getTime()
end

local function enabled()
    return G and G.SETTINGS and G.SETTINGS.jimbo_comments_enabled == true
end

local function rate()
    local r = G and G.SETTINGS and tonumber(G.SETTINGS.jimbo_comments_rate) or 2
    if r < 1 or r > 3 then r = 2 end
    return math.floor(r)
end

JC._bags = JC._bags or {}
JC._last_pool_at = JC._last_pool_at or {}
JC._last_at = JC._last_at or 0

local function pick(pool)
    local lines = LINES[pool]
    if not lines or #lines == 0 then return nil end
    local bag = JC._bags[pool]
    if not bag or #bag == 0 then
        bag = {}
        for i = 1, #lines do bag[i] = i end
        for i = #bag, 2, -1 do
            local j = rand(1, i)
            bag[i], bag[j] = bag[j], bag[i]
        end
        if JC._last_line and #bag > 1 and lines[bag[#bag]] == JC._last_line then
            bag[1], bag[#bag] = bag[#bag], bag[1]
        end
        JC._bags[pool] = bag
    end
    local i = table.remove(bag)
    return lines[i]
end

local function fill(text, vars)
    text = mod_loc and mod_loc(text) or text
    if vars then
        text = text:gsub("{(%w+)}", function(k)
            local v = vars[k]
            if v == nil then return "{" .. k .. "}" end
            return tostring(v)
        end)
    end
    return text
end

local function fmt_num(v)
    local ok, s = pcall(number_format, v)
    if ok and type(s) == "string" then return s end
    return tostring(v)
end

local function ulen(s)
    local _, n = s:gsub("[^\128-\191]", "")
    return n
end

local function wrap_greedy(str, max_chars)
    local out, cur = {}, ""
    for word in str:gmatch("%S+") do
        if cur == "" then cur = word
        elseif ulen(cur) + 1 + ulen(word) <= max_chars then cur = cur .. " " .. word
        else out[#out + 1] = cur; cur = word end
    end
    if cur ~= "" then out[#out + 1] = cur end
    return out
end

local function wrap(str, max_chars)
    local best = wrap_greedy(str, max_chars)
    if #best < 2 then return best end
    for w = max_chars - 1, 6, -1 do
        local t = wrap_greedy(str, w)
        if #t > #best then break end
        best = t
    end
    return best
end

local function touch()
    return UIK and UIK.touch and UIK.touch() or (G and G.F_MOBILE_UI) or false
end

local function portrait()
    return UIK and UIK.portrait and UIK.portrait() or false
end

local function jimbo_center()
    local key = "j_joker"
    pcall(function()
        if JimboSkinManager_get_equipped then key = JimboSkinManager_get_equipped() or "j_joker" end
    end)
    return G.P_CENTERS[key] or G.P_CENTERS.j_joker
end

local function make_card()
    local s = touch() and 0.55 or 0.48
    local card = Card(0, 0, G.CARD_W * s, G.CARD_H * s, G.P_CARDS.empty, jimbo_center(), {bypass_discovery_center = true})
    card._is_jimbo_visual = true
