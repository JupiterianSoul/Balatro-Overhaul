        ["Don't look at me, I was rooting for you."] = "Me regarde pas, j'étais de ton côté.",
        ["That's just Balatro. Next run will be better."] = "C'est ça, Balatro. La prochaine sera meilleure.",
        ["We learned something. Probably. Let's go again."] = "On a appris quelque chose. Sans doute. On y retourne.",
        ["Ouch. Back to Ante 1 we go."] = "Aïe. Retour à la mise 1.",
        ["You beat Ante {ante}! Take a bow!"] = "Tu as battu la mise {ante} ! Salue la foule !",
        ["Run won! I'm framing this one."] = "Partie gagnée ! Je l'encadre, celle-là.",
        ["Victory! The Jokers are throwing a party."] = "Victoire ! Les Jokers font la fête.",
        ["That's a win! Endless mode is calling, if you dare."] = "Victoire ! Le mode infini t'appelle, si tu l'oses.",
        ["Champion! I knew it from the first hand."] = "Champion ! Je le savais dès la première main.",
        ["Boss time: {boss}. Read its rule twice."] = "C'est l'heure du boss : {boss}. Lis bien sa règle.",
        ["Here comes {boss}. Play around it."] = "Voilà {boss}. Joue autour.",
        ["{boss} is up. Don't let it mess with your hand."] = "{boss} arrive. Ne le laisse pas gâcher ta main.",
        ["Boss blind! {boss} hits harder than it looks."] = "Blinde de boss ! {boss} frappe plus fort qu'il n'y paraît.",
        ["Careful, {boss} changes the rules."] = "Attention, {boss} change les règles.",
        ["{boss}. Ugh. You can take it though."] = "{boss}. Pfff. Mais tu peux le battre.",
        ["The Psychic wants all five cards. No sneaky Pairs."] = "Le Psychique veut cinq cartes. Pas de petite Paire en douce.",
        ["The Eye: no repeating hand types. Plan your order."] = "L'Œil : pas deux fois la même main. Prévois ton ordre.",
        ["The Mouth: only one hand type this round. Pick your best."] = "La Bouche : un seul type de main cette manche. Choisis ta meilleure.",
        ["The Needle. One hand. Make it your biggest."] = "L'Aiguille. Une seule main. Fais ta plus grosse.",
        ["The Water: no discards. Play what you're dealt."] = "L'Eau : pas de défausse. Joue ce que tu as.",
        ["The Wall. It's a big one. Bring your biggest hand."] = "Le Mur. Il est énorme. Sors ta plus grosse main.",
        ["The Flint halves your base chips and mult. Ouch."] = "Le Silex divise par deux tes jetons et ton mult de base. Aïe.",
        ["The Plant debuffs face cards. Kings, take a nap."] = "La Plante affaiblit les figures. Les Rois, au lit.",
        ["The Head debuffs Hearts. Sorry, lovers."] = "La Tête affaiblit les Cœurs. Désolé pour les amoureux.",
        ["The Club debuffs Clubs. Spread out your suits."] = "Le Gourdin affaiblit les Trèfles. Varie tes couleurs.",
        ["The Window debuffs Diamonds. Shiny but useless now."] = "La Fenêtre affaiblit les Carreaux. Brillants, mais inutiles.",
        ["The Goad debuffs Spades. Dig in with the other suits."] = "L'Aiguillon affaiblit les Piques. Joue les autres couleurs.",
        ["The Hook throws away two cards each hand. Keep extras."] = "Le Crochet jette deux cartes à chaque main. Garde de la marge.",
        ["The Tooth takes a dollar per card played. Small hands save cash."] = "La Dent prend un dollar par carte jouée. Les petites mains économisent.",
        ["The Ox takes your money if you play your most played hand."] = "Le Bœuf prend ton argent si tu joues ta main la plus jouée.",
        ["The Arm lowers the level of every hand you play."] = "Le Bras baisse le niveau de chaque main jouée.",
        ["The House deals your first hand face down. Spooky."] = "La Maison distribue ta première main face cachée. Flippant.",
        ["The Wheel flips some cards face down. Trust your gut."] = "La Roue retourne des cartes face cachée. Fie-toi à ton instinct.",
        ["The Fish flips new cards face down after each hand."] = "Le Poisson retourne les nouvelles cartes après chaque main.",
        ["The Manacle takes a card from your hand size."] = "La Menotte réduit ta main d'une carte.",
        ["The Pillar debuffs cards you already played this ante."] = "Le Pilier affaiblit les cartes déjà jouées dans cette mise.",
        ["The Serpent: you always draw three. Discards hit different."] = "Le Serpent : tu pioches toujours trois cartes. Les défausses changent tout.",
        ["Violet Vessel. The biggest blind in the game. Everything you've got."] = "Vase violet. La plus grosse blinde du jeu. Donne tout.",
        ["Verdant Leaf: every card is debuffed until you sell a Joker."] = "Feuille verdoyante : toutes les cartes sont affaiblies tant que tu ne vends pas de Joker.",
        ["Amber Acorn flips and shuffles your Jokers. Remember the order!"] = "Gland d'ambre retourne et mélange tes Jokers. Retiens l'ordre !",
        ["Crimson Heart disables a random Joker each hand."] = "Cœur pourpre désactive un Joker au hasard à chaque main.",
        ["Cerulean Bell forces a card into every hand. Work around it."] = "Cloche céruléenne impose une carte à chaque main. Fais avec.",
        ["Boss down! Off to the shop."] = "Boss au tapis ! Direction la boutique.",
        ["{boss} beaten. Next ante, here we come."] = "{boss} battu. Mise suivante, nous voilà.",
        ["That boss didn't know who it was dealing with."] = "Ce boss ne savait pas à qui il avait affaire.",
        ["Boss cleared. Treat yourself in the shop."] = "Boss vaincu. Fais-toi plaisir à la boutique.",
        ["Another boss in the bin."] = "Encore un boss à la poubelle.",
        ["{joker}! That's a rare one. Build around it."] = "{joker} ! C'est un rare. Construis autour.",
        ["Ooh, {joker}. Now we're cooking."] = "Oh, {joker}. Là, ça devient sérieux.",
        ["{joker} joins the crew. Good pickup."] = "{joker} rejoint l'équipe. Bien vu.",
        ["A rare Joker! {joker} can carry a run."] = "Un Joker rare ! {joker} peut porter une partie.",
        ["{joker}, nice. Make room for it."] = "{joker}, joli. Fais-lui de la place.",
        ["{joker}?! A Legendary! This run just changed."] = "{joker} ?! Un Légendaire ! Cette partie vient de changer.",
        ["A Legendary Joker. Bow to {joker}."] = "Un Joker Légendaire. Inclinez-vous devant {joker}.",
        ["{joker}! I need to sit down."] = "{joker} ! Il faut que je m'assoie.",
        ["You found {joker}. This is not a drill."] = "Tu as trouvé {joker}. Ce n'est pas un exercice.",
        ["${money} in the bank. You could buy the whole shop."] = "{money} $ en banque. Tu pourrais acheter toute la boutique.",
        ["${money}! Spend some, or keep stacking interest?"] = "{money} $ ! Tu dépenses ou tu laisses grimper les intérêts ?",
        ["Look at all that cash. ${money}!"] = "Regarde-moi tout cet argent. {money} $ !",
        ["${money}. Is this a Balatro run or a bank?"] = "{money} $. C'est une partie de Balatro ou une banque ?",
        ["${money} saved up. Interest loves you."] = "{money} $ de côté. Les intérêts t'adorent.",
        ["Nice savings. ${money} makes a good cushion."] = "Belles économies. {money} $, ça fait un bon matelas.",
        ["${money} in the pocket. Patience pays."] = "{money} $ en poche. La patience paie.",
        ["Saving pays off. Literally."] = "Économiser, ça rapporte. Littéralement.",
        ["${money}. The shopkeeper is looking at you funny."] = "{money} $. Le marchand te regarde de travers.",
        ["Running on fumes. Maybe skip a reroll."] = "Tu roules sur la réserve. Évite peut-être une relance.",
        ["Broke again. Sell something or save up."] = "Encore fauché. Vends quelque chose ou économise.",
        ["${money}. Window shopping it is."] = "{money} $. On fera du lèche-vitrine.",
        ["Empty pockets. Next round pays, hopefully."] = "Poches vides. La prochaine manche paiera, espérons.",
        ["Ante {ante}. The blinds just got bigger."] = "Mise {ante}. Les blindes viennent de grossir.",
        ["Welcome to Ante {ante}. Check your scaling."] = "Bienvenue à la mise {ante}. Vérifie que ton jeu suit.",
        ["Ante {ante}! Is your build ready for it?"] = "Mise {ante} ! Ton jeu est prêt ?",
        ["Up to Ante {ante}. The chips needed just jumped."] = "Mise {ante}. Les jetons à faire viennent de bondir.",
        ["Ante {ante}. Things get serious from here."] = "Mise {ante}. Ça devient sérieux.",
        ["Ante 8. The last one. Everything you've got."] = "Mise 8. La dernière. Donne tout.",
        ["Final ante! One boss stands between you and a win."] = "Dernière mise ! Un seul boss te sépare de la victoire.",
        ["This is it. Ante 8. No holding back."] = "On y est. Mise 8. Pas de retenue.",
        ["Endless mode, Ante {ante}. How far can you go?"] = "Mode infini, mise {ante}. Jusqu'où iras-tu ?",
        ["Ante {ante}. The numbers are getting silly now."] = "Mise {ante}. Les chiffres deviennent ridicules.",
        ["Still going? Ante {ante}! Legend."] = "Toujours là ? Mise {ante} ! Une légende.",
        ["Skipped! Hope that tag was worth it."] = "Passée ! J'espère que l'étiquette en valait la peine.",
        ["Bold skip. Your Jokers better be strong."] = "Audacieux. Tes Jokers ont intérêt à être solides.",
        ["Skipping for the tag. I like your style."] = "Tu passes pour l'étiquette. J'aime ton style.",
        ["No blind, just the tag. Living dangerously."] = "Pas de blinde, juste l'étiquette. Tu vis dangereusement.",
        ["{hand}! I don't see that every day."] = "{hand} ! On ne voit pas ça tous les jours.",
        ["A {hand}?! Frame it."] = "{hand} ?! À encadrer.",
        ["{hand}! That's a rare sight."] = "{hand} ! C'est rare, ça.",
        ["Did you just play a {hand}? Wow."] = "Tu viens de jouer {hand} ? Waouh.",
        ["{hand} again? It's your thing now."] = "Encore {hand} ? C'est ta spécialité.",
        ["Another {hand}. Level it up at the next planet."] = "Encore {hand}. Monte son niveau avec la prochaine planète.",
        ["{hand}, {hand}, {hand}. I see the plan."] = "{hand}, {hand}, {hand}. Je vois le plan.",
        ["You really love {hand}s, huh."] = "Tu adores vraiment ça, hein : {hand}.",
        ["Shop time. Look for something that fits your build."] = "Boutique ! Cherche ce qui va avec ton jeu.",
        ["Check the Jokers first, then the packs."] = "Regarde d'abord les Jokers, ensuite les paquets.",
        ["Spend smart. Interest is free money."] = "Dépense malin. Les intérêts, c'est de l'argent gratuit.",
        ["Anything here help your best hand?"] = "Quelque chose ici aide ta meilleure main ?",
        ["Reroll or save? The eternal question."] = "Relancer ou économiser ? L'éternelle question.",
        ["New stuff on the shelves. Take a look."] = "Nouveautés en rayon. Jette un œil.",
        ["Let's see what's inside!"] = "Voyons ce qu'il y a dedans !",
        ["Pack time. Pick what helps your build."] = "Un paquet ! Prends ce qui aide ton jeu.",
        ["Ooh, a pack. Fingers crossed."] = "Oh, un paquet. Croisons les doigts.",
        ["Choose wisely. Or just pick the shiny one."] = "Choisis bien. Ou prends juste celle qui brille.",
        ["PvP blind! Outscore your opponent."] = "Blinde JcJ ! Fais mieux que ton adversaire.",
        ["Head to head now. Every chip counts."] = "Face à face. Chaque jeton compte.",
        ["Your rival is playing this blind too. Beat their score!"] = "Ton rival joue aussi cette blinde. Bats son score !",
        ["PvP round. Big hands only."] = "Manche JcJ. Que des grosses mains.",
        ["Showdown time. Make them sweat."] = "L'heure du duel. Fais-le transpirer.",
        ["You lost a life. Shake it off."] = "Tu as perdu une vie. Secoue-toi.",
        ["Ouch, one life down. Time to build up."] = "Aïe, une vie en moins. Il faut se renforcer.",
        ["That one stings. {lives} lives left."] = "Ça pique. Plus que {lives} vies.",
        ["Down a life. The shop can fix this."] = "Une vie de moins. La boutique peut arranger ça.",
        ["Last life. Play it safe. Or don't."] = "Dernière vie. Joue prudent. Ou pas.",
        ["One life left. Every hand matters now."] = "Une seule vie. Chaque main compte.",
        ["No more room for mistakes. Last life!"] = "Plus droit à l'erreur. Dernière vie !",
        ["Your opponent lost a life! Keep pushing."] = "Ton adversaire a perdu une vie ! Continue.",
        ["They're down a life. Momentum is yours."] = "Il a perdu une vie. Tu as l'avantage.",
        ["Ha! That's a life off them."] = "Ha ! Une vie de moins pour lui.",
        ["Opponent took a hit. Don't let up."] = "L'adversaire a pris un coup. Ne lâche rien.",
        ["Match won! Your opponent is speechless."] = "Match gagné ! Ton adversaire est sans voix.",
        ["Victory! Good game, good game."] = "Victoire ! Bien joué, bien joué.",
        ["You won the match! Rematch?"] = "Tu as gagné le match ! Revanche ?",
        ["Match lost. Good game though!"] = "Match perdu. Mais bien joué !",
        ["They got this one. Get them next time."] = "Il a eu celui-là. Tu l'auras la prochaine fois.",
        ["Close match. Rematch and take it back?"] = "Match serré. Une revanche pour te rattraper ?",
        ["Ready for another run? I am."] = "Prêt pour une autre partie ? Moi, oui.",
        ["Try a new deck today. Mix things up."] = "Essaie un nouveau deck aujourd'hui. Change un peu.",
        ["The Casino has quests waiting for you."] = "Le Casino a des quêtes qui t'attendent.",
        ["Psst. Multiplayer is open if you want a rival."] = "Psst. Le multijoueur est ouvert si tu veux un rival.",
        ["Daily challenge looks fun today."] = "Le défi du jour a l'air sympa.",
        ["A new stake is a new kind of pain. Try it."] = "Une nouvelle mise, une nouvelle souffrance. Essaie.",
        ["I've been practicing my shuffle."] = "Je me suis entraîné à mélanger.",
        ["The cards miss you. So do I."] = "Les cartes s'ennuient de toi. Moi aussi.",
        ["Have you checked the collection lately?"] = "Tu as regardé ta collection récemment ?",
        ["Every run starts with one click on Play."] = "Chaque partie commence par un clic sur Jouer.",
        ["Still here? Let's play something."] = "Toujours là ? Allez, on joue.",
        ["Somewhere a Legendary Joker is waiting for you."] = "Quelque part, un Joker Légendaire t'attend.",
        ["Some of these are still locked. Go get them."] = "Certaines sont encore verrouillées. Va les chercher.",
        ["So many Jokers. Which one is your favourite?"] = "Tant de Jokers. Lequel est ton préféré ?",
        ["Reading card text is the real strategy."] = "Lire les cartes, c'est ça la vraie stratégie.",
        ["Look at all you've discovered!"] = "Regarde tout ce que tu as découvert !",
        ["Every card here has a trick. Learn them all."] = "Chaque carte a son astuce. Apprends-les toutes.",
    },
    es = {
        ["Rarely"] = "Pocas veces",
        ["Sometimes"] = "A veces",
        ["Often"] = "A menudo",
        ["Fresh deck, fresh start. Let's make it count."] = "Baraja nueva, comienzo nuevo. Que valga la pena.",
        ["New run! I already like this one."] = "¡Nueva partida! Esta ya me gusta.",
        ["Shuffle up. Somewhere in there is a winning run."] = "A barajar. Ahí dentro hay una victoria escondida.",
        ["Ante 1. Everybody's a genius at Ante 1."] = "Apuesta 1. En la apuesta 1 todos somos genios.",
        ["Let's see what this seed is hiding."] = "Veamos qué esconde este código.",
        ["Deep breath. Small Blind first, glory later."] = "Respira. Primero la Ciega pequeña, la gloria después.",
        ["{score} in one hand. The blind never stood a chance."] = "{score} en una mano. La ciega no tuvo ninguna oportunidad.",
        ["One hand, one blind, done. Clean."] = "Una mano, una ciega, listo. Limpio.",
        ["{hand} for {score}? That blind just folded."] = "¿{hand} por {score}? La ciega se acaba de retirar.",
        ["Why use many hand when one hand do trick?"] = "¿Para qué jugar muchas manos si basta con una?",
        ["You didn't beat that blind, you deleted it."] = "No venciste a esa ciega, la borraste.",
        ["That {hand} cleared the whole thing by itself."] = "Con {hand} lo resolviste todo de golpe.",
        ["One and done. Save the rest for the shop."] = "Una y listo. Guarda el resto para la tienda.",
        ["{score}?! Somebody check the deck for cheats."] = "¡¿{score}?! Que alguien revise esa baraja.",
        ["That was ten blinds' worth of chips. At least."] = "Eso valía fichas para diez ciegas. Como mínimo.",
        ["I felt that one from over here. {score}!"] = "Esa la sentí desde aquí. ¡{score}!",
        ["The scoreboard needs a bigger screen now."] = "El marcador va a necesitar una pantalla más grande.",
        ["Okay, now you're just showing off. I love it."] = "Vale, ahora solo estás presumiendo. Me encanta.",
        ["New best hand this run: {score}!"] = "Mejor mano de la partida: ¡{score}!",
        ["{score}! That's your biggest hand yet."] = "¡{score}! Tu mano más grande hasta ahora.",
        ["Look at that {hand}. Run record!"] = "Mira eso: {hand}. ¡Récord de la partida!",
        ["Best hand of the run. Keep stacking."] = "La mejor mano de la partida. Sigue así.",
        ["Your engine is warming up. {score} and climbing."] = "Tu máquina se está calentando. {score} y subiendo.",
        ["Only {score}? The blind barely noticed."] = "¿Solo {score}? La ciega casi ni lo notó.",
        ["That {hand} needs some help. Maybe a Joker or two."] = "{hand} se queda corto. Quizá un comodín o dos.",
        ["Hmm. We need way more than that."] = "Mmm. Necesitamos mucho más que eso.",
        ["Small hand, big gap. Time for something bold."] = "Mano pequeña, gran distancia. Toca arriesgar.",
        ["That's a start. A small one."] = "Es un comienzo. Uno pequeño.",
        ["Last hand. {left} to go. No pressure."] = "Última mano. Faltan {left}. Sin presión.",
        ["Final hand. Make it a big one."] = "Última mano. Que sea grande.",
        ["One hand left and {left} short. You've got this. Probably."] = "Queda una mano y faltan {left}. Puedes hacerlo. Seguramente.",
        ["All in on this one. {left} to clear."] = "Todo a esta mano. Faltan {left}.",
        ["This is the hand they'll write songs about. Or not."] = "De esta mano harán canciones. O no.",
        ["Last chance. Pick your best and pray."] = "Última oportunidad. Elige lo mejor y reza.",
        ["Everything rides on this hand."] = "Todo depende de esta mano.",
        ["On the very last hand! My heart can't take this."] = "¡En la última mano! Mi corazón no lo aguanta.",
        ["Clutch! I never doubted you. Mostly."] = "¡Por los pelos! Nunca dudé de ti. Casi nunca.",
        ["Last hand, and you pulled it off!"] = "¡Última mano y lo lograste!",
        ["That's how you close it out."] = "Así se cierra una ronda.",
        ["Down to the wire and still standing."] = "Hasta el final y sigues en pie.",
        ["Phew. Let's not do that again. Unless it's fun."] = "Uf. No lo repitamos. A menos que sea divertido.",
        ["Just barely over. A win's a win!"] = "Justo por encima. ¡Una victoria es una victoria!",
        ["That was close. Like, really close."] = "Eso estuvo cerca. Muy, muy cerca.",
        ["Squeaked through! Maybe buy something strong."] = "¡Pasaste de milagro! Quizá compra algo potente.",
        ["Made it by a hair. The next blind is bigger, though."] = "Por un pelo. Aunque la siguiente ciega es más grande.",
        ["So close! Just {left} short."] = "¡Casi! Faltaron solo {left}.",
        ["Agh, {left} away from making it. That one hurts."] = "Ay, a {left} de lograrlo. Esa duele.",
        ["Almost had it. One more Joker and that was yours."] = "Casi. Un comodín más y era tuya.",
        ["Missed by a whisker. Next run is yours."] = "Por un pelo. La próxima partida es tuya.",
        ["That close?! The blind got lucky."] = "¡¿Tan cerca?! La ciega tuvo suerte.",
        ["So near. Don't worry, I won't tell anyone."] = "Tan cerca. Tranquilo, no se lo diré a nadie.",
        ["Well, that's the run. Shuffle up and go again?"] = "Bueno, se acabó la partida. ¿Barajamos otra vez?",
        ["Every great player loses. A lot. Like, a lot a lot."] = "Todo gran jugador pierde. Mucho. Muchísimo.",
        ["The blind wins this time. Rematch?"] = "Esta vez gana la ciega. ¿Revancha?",
        ["Don't look at me, I was rooting for you."] = "No me mires, yo iba contigo.",
        ["That's just Balatro. Next run will be better."] = "Así es Balatro. La próxima saldrá mejor.",
        ["We learned something. Probably. Let's go again."] = "Algo aprendimos. Seguramente. Otra vez.",
        ["Ouch. Back to Ante 1 we go."] = "Ay. De vuelta a la apuesta 1.",
        ["You beat Ante {ante}! Take a bow!"] = "¡Superaste la apuesta {ante}! ¡Haz una reverencia!",
        ["Run won! I'm framing this one."] = "¡Partida ganada! Esta la enmarco.",
        ["Victory! The Jokers are throwing a party."] = "¡Victoria! Los comodines están de fiesta.",
        ["That's a win! Endless mode is calling, if you dare."] = "¡Victoria! El modo infinito te llama, si te atreves.",
        ["Champion! I knew it from the first hand."] = "¡Campeón! Lo supe desde la primera mano.",
        ["Boss time: {boss}. Read its rule twice."] = "Hora del jefe: {boss}. Lee su regla dos veces.",
        ["Here comes {boss}. Play around it."] = "Ahí viene {boss}. Juega a su alrededor.",
        ["{boss} is up. Don't let it mess with your hand."] = "Le toca a {boss}. No dejes que te arruine la mano.",
        ["Boss blind! {boss} hits harder than it looks."] = "¡Ciega jefe! {boss} pega más fuerte de lo que parece.",
        ["Careful, {boss} changes the rules."] = "Cuidado, {boss} cambia las reglas.",
        ["{boss}. Ugh. You can take it though."] = "{boss}. Uf. Pero puedes con él.",
        ["The Psychic wants all five cards. No sneaky Pairs."] = "El Psíquico quiere las cinco cartas. Nada de Parejas a escondidas.",
        ["The Eye: no repeating hand types. Plan your order."] = "El Ojo: no repitas tipos de mano. Planea el orden.",
        ["The Mouth: only one hand type this round. Pick your best."] = "La Boca: un solo tipo de mano esta ronda. Elige la mejor.",
        ["The Needle. One hand. Make it your biggest."] = "La Aguja. Una sola mano. Que sea la más grande.",
        ["The Water: no discards. Play what you're dealt."] = "El Agua: sin descartes. Juega lo que te toque.",
        ["The Wall. It's a big one. Bring your biggest hand."] = "El Muro. Es enorme. Saca tu mano más grande.",
        ["The Flint halves your base chips and mult. Ouch."] = "El Pedernal reduce a la mitad tus fichas y multi base. Ay.",
        ["The Plant debuffs face cards. Kings, take a nap."] = "La Planta debilita las figuras. Reyes, a dormir la siesta.",
        ["The Head debuffs Hearts. Sorry, lovers."] = "La Cabeza debilita los Corazones. Lo siento, enamorados.",
        ["The Club debuffs Clubs. Spread out your suits."] = "El Garrote debilita los Tréboles. Reparte tus palos.",
        ["The Window debuffs Diamonds. Shiny but useless now."] = "La Ventana debilita los Diamantes. Brillan, pero no sirven.",
        ["The Goad debuffs Spades. Dig in with the other suits."] = "La Aguijada debilita las Picas. Tira de los otros palos.",
        ["The Hook throws away two cards each hand. Keep extras."] = "El Gancho tira dos cartas en cada mano. Guarda de sobra.",
        ["The Tooth takes a dollar per card played. Small hands save cash."] = "El Diente cobra un dólar por carta jugada. Las manos pequeñas ahorran.",
        ["The Ox takes your money if you play your most played hand."] = "El Buey se lleva tu dinero si juegas tu mano más usada.",
        ["The Arm lowers the level of every hand you play."] = "El Brazo baja el nivel de cada mano que juegas.",
        ["The House deals your first hand face down. Spooky."] = "La Casa reparte tu primera mano boca abajo. Qué miedo.",
        ["The Wheel flips some cards face down. Trust your gut."] = "La Rueda pone cartas boca abajo. Confía en tu instinto.",
        ["The Fish flips new cards face down after each hand."] = "El Pez pone boca abajo las cartas nuevas tras cada mano.",
        ["The Manacle takes a card from your hand size."] = "El Grillete te quita una carta del tamaño de mano.",
        ["The Pillar debuffs cards you already played this ante."] = "El Pilar debilita las cartas ya jugadas en esta apuesta.",
        ["The Serpent: you always draw three. Discards hit different."] = "La Serpiente: siempre robas tres. Los descartes cambian.",
        ["Violet Vessel. The biggest blind in the game. Everything you've got."] = "Vasija violeta. La ciega más grande del juego. Dalo todo.",
        ["Verdant Leaf: every card is debuffed until you sell a Joker."] = "Hoja verde: todas las cartas están debilitadas hasta que vendas un comodín.",
        ["Amber Acorn flips and shuffles your Jokers. Remember the order!"] = "Bellota ámbar voltea y mezcla tus comodines. ¡Recuerda el orden!",
        ["Crimson Heart disables a random Joker each hand."] = "Corazón carmesí desactiva un comodín al azar en cada mano.",
        ["Cerulean Bell forces a card into every hand. Work around it."] = "Campana cerúlea obliga a usar una carta en cada mano. Adáptate.",
        ["Boss down! Off to the shop."] = "¡Jefe derrotado! A la tienda.",
        ["{boss} beaten. Next ante, here we come."] = "{boss} vencido. Siguiente apuesta, allá vamos.",
        ["That boss didn't know who it was dealing with."] = "Ese jefe no sabía con quién se metía.",
        ["Boss cleared. Treat yourself in the shop."] = "Jefe superado. Date un capricho en la tienda.",
        ["Another boss in the bin."] = "Otro jefe a la basura.",
        ["{joker}! That's a rare one. Build around it."] = "¡{joker}! Es raro. Construye a su alrededor.",
        ["Ooh, {joker}. Now we're cooking."] = "Uh, {joker}. Ahora sí que vamos en serio.",
        ["{joker} joins the crew. Good pickup."] = "{joker} se une al equipo. Buena elección.",
        ["A rare Joker! {joker} can carry a run."] = "¡Un comodín raro! {joker} puede cargar con una partida.",
        ["{joker}, nice. Make room for it."] = "{joker}, genial. Hazle sitio.",
        ["{joker}?! A Legendary! This run just changed."] = "¡¿{joker}?! ¡Un Legendario! Esta partida acaba de cambiar.",
        ["A Legendary Joker. Bow to {joker}."] = "Un comodín Legendario. Inclínate ante {joker}.",
        ["{joker}! I need to sit down."] = "¡{joker}! Necesito sentarme.",
        ["You found {joker}. This is not a drill."] = "Encontraste a {joker}. No es un simulacro.",
        ["${money} in the bank. You could buy the whole shop."] = "${money} en el banco. Podrías comprar toda la tienda.",
        ["${money}! Spend some, or keep stacking interest?"] = "¡${money}! ¿Gastas algo o sigues sumando intereses?",
        ["Look at all that cash. ${money}!"] = "Mira cuánto dinero. ¡${money}!",
        ["${money}. Is this a Balatro run or a bank?"] = "${money}. ¿Esto es una partida de Balatro o un banco?",
        ["${money} saved up. Interest loves you."] = "${money} ahorrados. Los intereses te adoran.",
        ["Nice savings. ${money} makes a good cushion."] = "Buen ahorro. ${money} es un buen colchón.",
        ["${money} in the pocket. Patience pays."] = "${money} en el bolsillo. La paciencia paga.",
        ["Saving pays off. Literally."] = "Ahorrar sale a cuenta. Literalmente.",
        ["${money}. The shopkeeper is looking at you funny."] = "${money}. El tendero te mira raro.",
        ["Running on fumes. Maybe skip a reroll."] = "Vas en la reserva. Quizá sáltate una renovación.",
        ["Broke again. Sell something or save up."] = "Otra vez sin blanca. Vende algo o ahorra.",
        ["${money}. Window shopping it is."] = "${money}. Toca mirar escaparates.",
        ["Empty pockets. Next round pays, hopefully."] = "Bolsillos vacíos. La próxima ronda paga, ojalá.",
        ["Ante {ante}. The blinds just got bigger."] = "Apuesta {ante}. Las ciegas acaban de crecer.",
        ["Welcome to Ante {ante}. Check your scaling."] = "Bienvenido a la apuesta {ante}. Revisa si tu mazo escala.",
        ["Ante {ante}! Is your build ready for it?"] = "¡Apuesta {ante}! ¿Está listo tu mazo?",
        ["Up to Ante {ante}. The chips needed just jumped."] = "Apuesta {ante}. Las fichas necesarias acaban de dispararse.",
        ["Ante {ante}. Things get serious from here."] = "Apuesta {ante}. A partir de aquí va en serio.",
        ["Ante 8. The last one. Everything you've got."] = "Apuesta 8. La última. Dalo todo.",
        ["Final ante! One boss stands between you and a win."] = "¡Última apuesta! Solo un jefe te separa de la victoria.",
        ["This is it. Ante 8. No holding back."] = "Llegó el momento. Apuesta 8. Sin contenerse.",
        ["Endless mode, Ante {ante}. How far can you go?"] = "Modo infinito, apuesta {ante}. ¿Hasta dónde llegarás?",
        ["Ante {ante}. The numbers are getting silly now."] = "Apuesta {ante}. Los números ya son ridículos.",
        ["Still going? Ante {ante}! Legend."] = "¿Sigues? ¡Apuesta {ante}! Leyenda.",
        ["Skipped! Hope that tag was worth it."] = "¡Saltada! Ojalá esa etiqueta valga la pena.",
        ["Bold skip. Your Jokers better be strong."] = "Salto atrevido. Más vale que tus comodines sean fuertes.",
        ["Skipping for the tag. I like your style."] = "Saltas por la etiqueta. Me gusta tu estilo.",
        ["No blind, just the tag. Living dangerously."] = "Sin ciega, solo la etiqueta. Vives al límite.",
        ["{hand}! I don't see that every day."] = "¡{hand}! Eso no se ve todos los días.",
        ["A {hand}?! Frame it."] = "¡¿{hand}?! Para enmarcar.",
        ["{hand}! That's a rare sight."] = "¡{hand}! Eso es raro de ver.",
        ["Did you just play a {hand}? Wow."] = "¿Acabas de jugar {hand}? Guau.",
        ["{hand} again? It's your thing now."] = "¿Otra vez {hand}? Ya es lo tuyo.",
        ["Another {hand}. Level it up at the next planet."] = "Otra vez {hand}. Súbele el nivel con el próximo planeta.",
        ["{hand}, {hand}, {hand}. I see the plan."] = "{hand}, {hand}, {hand}. Ya veo el plan.",
        ["You really love {hand}s, huh."] = "Te encanta de verdad: {hand}, ¿eh?",
        ["Shop time. Look for something that fits your build."] = "Hora de la tienda. Busca algo que encaje con tu mazo.",
        ["Check the Jokers first, then the packs."] = "Mira primero los comodines y luego los paquetes.",
        ["Spend smart. Interest is free money."] = "Gasta con cabeza. Los intereses son dinero gratis.",
        ["Anything here help your best hand?"] = "¿Algo de aquí ayuda a tu mejor mano?",
        ["Reroll or save? The eternal question."] = "¿Renovar o ahorrar? La eterna pregunta.",
        ["New stuff on the shelves. Take a look."] = "Cosas nuevas en los estantes. Échales un vistazo.",
        ["Let's see what's inside!"] = "¡A ver qué hay dentro!",
        ["Pack time. Pick what helps your build."] = "Hora del paquete. Elige lo que ayude a tu mazo.",
        ["Ooh, a pack. Fingers crossed."] = "Uh, un paquete. Crucemos los dedos.",
        ["Choose wisely. Or just pick the shiny one."] = "Elige bien. O coge la que más brille.",
        ["PvP blind! Outscore your opponent."] = "¡Ciega JcJ! Supera la puntuación de tu rival.",
        ["Head to head now. Every chip counts."] = "Cara a cara. Cada ficha cuenta.",
        ["Your rival is playing this blind too. Beat their score!"] = "Tu rival también juega esta ciega. ¡Supera su puntuación!",
        ["PvP round. Big hands only."] = "Ronda JcJ. Solo manos grandes.",
        ["Showdown time. Make them sweat."] = "Hora del duelo. Hazle sudar.",
        ["You lost a life. Shake it off."] = "Perdiste una vida. Sacúdetelo.",
        ["Ouch, one life down. Time to build up."] = "Ay, una vida menos. Toca reforzarse.",
        ["That one stings. {lives} lives left."] = "Eso escuece. Quedan {lives} vidas.",
        ["Down a life. The shop can fix this."] = "Una vida menos. La tienda puede arreglarlo.",
        ["Last life. Play it safe. Or don't."] = "Última vida. Juega seguro. O no.",
        ["One life left. Every hand matters now."] = "Queda una vida. Cada mano cuenta.",
        ["No more room for mistakes. Last life!"] = "Ya no hay margen de error. ¡Última vida!",
        ["Your opponent lost a life! Keep pushing."] = "¡Tu rival perdió una vida! Sigue presionando.",
        ["They're down a life. Momentum is yours."] = "Tiene una vida menos. La racha es tuya.",
        ["Ha! That's a life off them."] = "¡Ja! Una vida menos para él.",
        ["Opponent took a hit. Don't let up."] = "Tu rival recibió un golpe. No aflojes.",
        ["Match won! Your opponent is speechless."] = "¡Partida ganada! Tu rival se quedó sin palabras.",
        ["Victory! Good game, good game."] = "¡Victoria! Buena partida, buena partida.",
        ["You won the match! Rematch?"] = "¡Ganaste la partida! ¿Revancha?",
        ["Match lost. Good game though!"] = "Partida perdida. ¡Pero bien jugada!",
        ["They got this one. Get them next time."] = "Esta se la llevó él. La próxima es tuya.",
        ["Close match. Rematch and take it back?"] = "Partida reñida. ¿Revancha para recuperarla?",
        ["Ready for another run? I am."] = "¿Listo para otra partida? Yo sí.",
        ["Try a new deck today. Mix things up."] = "Prueba una baraja nueva hoy. Cambia un poco.",
        ["The Casino has quests waiting for you."] = "El Casino tiene misiones esperándote.",
        ["Psst. Multiplayer is open if you want a rival."] = "Psst. El multijugador está abierto si quieres un rival.",
        ["Daily challenge looks fun today."] = "El desafío diario pinta bien hoy.",
        ["A new stake is a new kind of pain. Try it."] = "Una apuesta nueva es un dolor nuevo. Pruébala.",
        ["I've been practicing my shuffle."] = "He estado practicando cómo barajar.",
        ["The cards miss you. So do I."] = "Las cartas te echan de menos. Yo también.",
        ["Have you checked the collection lately?"] = "¿Has mirado la colección últimamente?",
        ["Every run starts with one click on Play."] = "Toda partida empieza con un clic en Jugar.",
        ["Still here? Let's play something."] = "¿Sigues aquí? Juguemos algo.",
        ["Somewhere a Legendary Joker is waiting for you."] = "En algún lugar te espera un comodín Legendario.",
        ["Some of these are still locked. Go get them."] = "Algunas siguen bloqueadas. Ve a por ellas.",
        ["So many Jokers. Which one is your favourite?"] = "Cuántos comodines. ¿Cuál es tu favorito?",
        ["Reading card text is the real strategy."] = "Leer las cartas es la verdadera estrategia.",
        ["Look at all you've discovered!"] = "¡Mira todo lo que has descubierto!",
        ["Every card here has a trick. Learn them all."] = "Cada carta tiene su truco. Apréndelos todos.",
    },
}
end
