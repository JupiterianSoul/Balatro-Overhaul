function RI.whats_new_key()
  return RI.build() or RI.version_name()
end

function RI.whats_new_def()
  local e = RI.changelog()[1]
  local title, highs, rest = RI.entry_text(e)
  local port = UIK.portrait()
  local w = port and (UIK.PORT_W - 0.2) or 13.4
  local inner = w - 0.3
  local per = port and 1 or 2
  local sc = body_scale()
  local room = port and (UIK.PORT_H - 2) or (UIK.LAND_H - 0.2)
  local rows = {}
  local label = RI.version_label(e)
  if e.date ~= "" then label = label .. "  |  " .. RI.date_text(e.date) end
  rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cm', padding = 0.02}, nodes = {t_node(label, body_scale(), UIK.C.muted, false)}}
  if title then rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cm', padding = 0.04}, nodes = {
    {n = G.UIT.C, config = {align = 'cm', maxw = inner}, nodes = {t_node(title, touch() and 0.55 or 0.5, UIK.C.text, true)}}}} end
  rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cm', minh = 0.1}, nodes = {}}
  local list = {}
  for i, h in ipairs(highs) do
    if i > 6 then break end
    list[#list + 1] = h
  end
  if #list == 0 then
    for i, it in ipairs(rest) do
      if i > 6 then break end
      list[#list + 1] = {text = it}
    end
  end
  local used = 0.3 + (touch() and 0.45 or 0.4) + (title and 0.7 or 0) + 0.1
  for i, node in ipairs(news_rows(list, inner, per, UIK.GAP, sc)) do
    used = used + node.uik_h
    if i > 1 and used > room then
      UIK.discard(node)
    else
      rows[#rows + 1] = node
    end
  end
  return UIK.window{
    id = 'whats_new',
    title = L("WHAT'S NEW"),
    compact = true,
    w = w,
    back_func = 'whats_new_close',
    back_label = L("Close"),
    build = function()
      return {n = G.UIT.R, config = {align = 'cm', minw = w, padding = 0}, nodes = {
        {n = G.UIT.C, config = {align = 'tm', minw = inner, padding = 0}, nodes = rows},
      }}
    end,
    footer = {UIK.button{label = L("Full patch notes"), button = 'whats_new_full', colour = UIK.C.accent,
      w = math.max(touch() and 4.2 or 3.8, UIK.text_w(L("Full patch notes"), touch() and 0.5 or 0.47) + 0.8)}},
  }
end

function RI.open_whats_new()
  if not RI.changelog()[1] then return end
r 4 1381 %20%20 -
l 267
  G.FUNCS.overlay_menu{definition = RI.whats_new_def()}
end

G.FUNCS.whats_new_close = function(e)
  G.FUNCS.exit_overlay_menu(e)
end

G.FUNCS.whats_new_full = function(e)
  RI._cl_idx = 1
  UIK._pages.about_changelog = 1
  RI.open('changelog', 'menu')
end

function RI.panel_def()
  local e = RI.changelog()[1]
  local _, highs, rest = RI.entry_text(e)
  local w = touch() and 3.9 or 3.3
  local inner = w - 0.24
  local sc = touch() and 0.3 or 0.27
  local dim = {0.62, 0.66, 0.7, 1}
  local rows = {}
  rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cm', minw = inner, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = 'cl', minw = inner - 0.55, padding = 0}, nodes = {t_node(L("WHAT'S NEW"), sc * 1.2, G.C.UI.TEXT_LIGHT, false)}},
    {n = G.UIT.C, config = {align = 'cr', minw = 0.55, padding = 0}, nodes = {
      UIK.button{label = "X", button = 'ri_panel_close', colour = UIK.C.off, w = touch() and 0.6 or 0.45, h = touch() and 0.5 or 0.38, scale = 0.32}}},
  }}
  rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cl', minw = inner, padding = 0.01}, nodes = {t_node(RI.version_label(e), sc * 0.85, dim, false)}}
  local n = 0
  local function line(str)
    n = n + 1
    rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cl', minw = inner, padding = 0.015}, nodes = {
      {n = G.UIT.C, config = {align = 'cl', maxw = inner}, nodes = {t_node("- " .. str, sc, G.C.UI.TEXT_LIGHT, false)}}}}
  end
  for _, h in ipairs(highs) do
    if n >= 5 then break end
    local s = h.title
    if not s or s == "" then
      local words = {}
      for wd in tostring(h.text or ""):gmatch("%S+") do words[#words + 1] = wd if #words >= 4 then break end end
      s = table.concat(words, " ")
    end
    line(s)
  end
  if n == 0 then
    for _, it in ipairs(rest) do
      if n >= 4 then break end
      local words = {}
      for wd in tostring(it):gmatch("%S+") do words[#words + 1] = wd if #words >= 4 then break end end
      line(table.concat(words, " "))
    end
  end
  rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cm', minw = inner, padding = 0.05}, nodes = {
    UIK.button{label = L("Full patch notes"), button = 'whats_new_full', colour = UIK.C.off, w = inner, h = touch() and 0.55 or 0.45, scale = touch() and 0.34 or 0.3}}}
  return {n = G.UIT.ROOT, config = {align = 'cm', colour = G.C.CLEAR, func = 'ri_panel_check'}, nodes = {
    {n = G.UIT.C, config = {align = 'cm', r = 0.1, colour = {0.13, 0.16, 0.18, 0.92}, outline = 1, outline_colour = {0.32, 0.37, 0.41, 1}, padding = 0.1}, nodes = {
      {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {{n = G.UIT.C, config = {align = 'cm', padding = 0}, nodes = rows}}},
    }},
  }}
end

function RI.panel_remove()
  if RI.panel then RI.panel:remove() RI.panel = nil end
end

G.FUNCS.ri_panel_check = function(e)
  if G.STAGE ~= G.STAGES.MAIN_MENU or RI._panel_closed then RI.panel_remove() return end
  local p = RI.panel
  if p and p.states then p.states.visible = not (G.OVERLAY_MENU or G.OVERLAY_TUTORIAL) end
end

G.FUNCS.ri_panel_close = function(e)
  RI._panel_closed = true
  RI.panel_remove()
end

function RI.panel_place()
  local p = RI.panel
  if not (p and p.T and G.ROOM and G.ROOM_ATTACH) then return end
  local u = G.TILESIZE * G.TILESCALE
  local sw, sh = love.graphics.getWidth() / u, love.graphics.getHeight() / u
  local left, top = -G.ROOM.T.x, -G.ROOM.T.y
  local cx = left + sw - 0.35 - p.T.w / 2
  local cy = top + 0.75 + p.T.h / 2
  local ra = G.ROOM_ATTACH.T
  p:set_alignment({major = G.ROOM_ATTACH, type = 'cm', offset = {x = cx - (ra.x + ra.w / 2), y = cy - (ra.y + ra.h / 2)}})
  p:align_to_major()
  p:hard_set_T(p.T.x, p.T.y, p.T.w, p.T.h)
  p:hard_set_VT()
end

function RI.whats_new_check()
  if RI._panel_closed or not (G.SETTINGS and G.STAGE == G.STAGES.MAIN_MENU) then return end
  if not RI.changelog()[1] or UIK.portrait() then return end
  RI.panel_remove()
  RI.panel = UIBox{definition = RI.panel_def(), config = {align = 'cm', offset = {x = 0, y = 0}, major = G.ROOM_ATTACH, bond = 'Weak'}}
  RI.panel_place()
  G.SETTINGS.whats_new_seen = RI.whats_new_key()
end

local main_menu_ui = set_main_menu_UI
function set_main_menu_UI(...)
  main_menu_ui(...)
  pcall(RI.whats_new_check)
end

G.FUNCS.open_about = function(e) RI.open('about', false) end
G.FUNCS.open_about_licences = function(e) RI.open('licences') end
G.FUNCS.open_about_privacy = function(e) RI.open('privacy') end
G.FUNCS.open_changelog = function(e) RI.open('changelog', false) end
G.FUNCS.about_back = function(e)
  if RI.from == 'menu' then
    RI.from = nil
    return G.FUNCS.exit_overlay_menu(e)
  end
  if G.FUNCS.settings then G.FUNCS.settings(e, true) else G.FUNCS.exit_overlay_menu(e) end
end
G.ESC_BACK_FUNCS = G.ESC_BACK_FUNCS or {}
G.ESC_BACK_FUNCS.about_back = true

