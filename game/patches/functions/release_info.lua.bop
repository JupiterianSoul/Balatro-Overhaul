RI.PATREON_URL = "https://ko-fi.com/jupiteriansoull"

function RI.patreon_tab()
  local w = 9.6
  local sc = 0.4
  local lines = {}
  for i, ptext in ipairs({L("The Overhaul is free and will stay free. Ko-fi is only for those who want to support me and help pay for the online server."),
      L("Thank you, it means a lot.")}) do
    if i > 1 then lines[#lines + 1] = "" end
    for _, l in ipairs(RI.wrap(ptext, w - 0.6, sc)) do lines[#lines + 1] = l end
  end
  local rows = text_rows(lines, w - 0.6, sc, G.C.UI.TEXT_LIGHT, 'cm')
  return {n = G.UIT.ROOT, config = {align = "cm", padding = 0.2, colour = G.C.BLACK, r = 0.1, emboss = 0.05, minh = 6, minw = 10}, nodes = {
    {n = G.UIT.R, config = {align = "cm", padding = 0.25, outline_colour = G.C.JOKER_GREY, r = 0.1, outline = 1, minw = w}, nodes = {
      {n = G.UIT.R, config = {align = "cm", padding = 0.05}, nodes = {t_node(L("Support the Overhaul"), 0.6, G.C.GOLD, true)}},
      {n = G.UIT.R, config = {align = "cm", minh = 0.15}, nodes = {}},
      {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = {{n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = rows}}},
      {n = G.UIT.R, config = {align = "cm", minh = 0.3}, nodes = {}},
      {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = {
        UIK.button{label = L("Open my Ko-fi"), button = 'open_patreon', colour = {1, 0.26, 0.3, 1}, w = 4.2, h = touch() and 0.95 or 0.85, scale = 0.5, col = true},
      }},
    }},
  }}
end

G.FUNCS.open_patreon = function(e)
  love.system.openURL(RI.PATREON_URL)
end

