ReleaseInfo = ReleaseInfo or {}
local RI = ReleaseInfo
local L = function(s) return mod_loc(s) end

RI.CHANGELOG_FILE = "CHANGELOG.md"

local function touch() return UIK.touch() end
local function body_scale() return touch() and 0.33 or 0.32 end

function RI.lang()
  local lang = G and G.SETTINGS and G.SETTINGS.language or "en-us"
  if lang == "fr" then return "fr" end
  if lang == "es_ES" or lang == "es_419" then return "es" end
  return "en"
end

function RI.wrap(str, w, scale)
  local lines, cur = {}, ""
  for word in tostring(str or ""):gmatch("%S+") do
    local try = cur == "" and word or (cur .. " " .. word)
    if cur ~= "" and UIK.text_w(try, scale) > w then
      lines[#lines + 1] = cur
      cur = word
    else
      cur = try
    end
  end
  if cur ~= "" then lines[#lines + 1] = cur end
  return lines
end

local function split_icon(text)
  local key, rest = text:match("^{([%w_]+)}%s*(.*)$")
  if key then return rest, key end
  return text, nil
end

function RI.parse_changelog(text)
  local out, entry, lang, last = {}, nil, nil, nil
  for raw in (tostring(text or "") .. "\n"):gmatch("([^\n]*)\n") do
    local l = raw:gsub("\r$", "")
    local head = l:match("^##%s+([^#].*)$")
    local sub, title = l:match("^###%s+(%a%a)%s*(.-)%s*$")
    local item = l:match("^%s*%-%s+(.+)$")
    local hl = l:match("^%s*%+%s+(.+)$")
    if head then
      local version, date = head:match("^(.-)%s*|%s*(.-)%s*$")
      entry = {version = version or head, date = date or "", titles = {}, items = {}, highlights = {}}
      out[#out + 1] = entry
      lang, last = nil, nil
    elseif entry and sub then
      lang = sub:lower()
      if title and title ~= "" then entry.titles[lang] = title end
      entry.items[lang] = entry.items[lang] or {}
      entry.highlights[lang] = entry.highlights[lang] or {}
      last = nil
    elseif entry and lang and hl then
      local t, icon = split_icon(hl)
      local name, body = t:match("^%[(.-)%]%s*(.*)$")
      if name then t = body end
      last = {text = t, icon = icon, title = name}
      local list = entry.highlights[lang]
      list[#list + 1] = last
    elseif entry and lang and item then
      local list = entry.items[lang]
      list[#list + 1] = item
      last = nil
    elseif entry and lang and l:match("^%s+%S") then
      local more = l:gsub("^%s+", "")
      if last then
        last.text = last.text .. " " .. more
      else
        local list = entry.items[lang]
        if #list > 0 then list[#list] = list[#list] .. " " .. more end
      end
    end
  end
  return out
end

function RI.entry_text(e, lang)
  lang = lang or RI.lang()
  local function pick(t) return (t[lang] and next(t[lang]) and t[lang]) or t.en or {} end
  return e.titles[lang] or e.titles.en, pick(e.highlights), pick(e.items)
end

function RI.changelog()
  if RI._changelog then return RI._changelog end
  local ok, text = pcall(love.filesystem.read, RI.CHANGELOG_FILE)
  RI._changelog = RI.parse_changelog(ok and text or "")
  return RI._changelog
end

local function col_inner(cols)
  return UIK.col_w(cols) - 2 * UIK.PAD - 0.2
end

local function cols_n()
  return UIK.portrait() and 1 or 2
end

local function para(items, str, colour)
  local w = col_inner(cols_n())
  local lines = RI.wrap(str, w, body_scale())
  local chunk = touch() and 5 or 7
  for i = 1, #lines, chunk do
    local part = {}
    for j = i, math.min(i + chunk - 1, #lines) do part[#part + 1] = lines[j] end
    items[#items + 1] = UIK.note(part, {w = w + 0.2, scale = body_scale(), colour = colour or UIK.C.text})
  end
end

local function head(items, str, colour)
  items[#items + 1] = UIK.header(str, {w = col_inner(cols_n()) + 0.2, colour = colour})
end

local function t_node(str, scale, colour, shadow)
  return {n = G.UIT.T, config = {text = str, scale = scale, colour = colour, shadow = shadow}}
end

local function head_pair(items, name, extra)
  local w = col_inner(cols_n()) + 0.2
  local h = touch() and 0.66 or 0.58
  local hs = touch() and 0.5 or 0.45
  local node = {n = G.UIT.R, config = {align = 'cm', minw = w, minh = h, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = 'cm', maxw = w - 0.1, padding = 0}, nodes = {
      t_node(name, hs, UIK.C.title, true),
      t_node("  " .. extra, body_scale(), UIK.C.muted, false),
    }},
  }}
  node.uik_h = h
  node.uik_header = true
  items[#items + 1] = node
end

local function bullet_node(str, w)
  local sc = body_scale()
  local dash = "- "
  local indent = UIK.text_w(dash, sc)
  local lines = RI.wrap(str, w - indent, sc)
  local lh = sc * 1.05 + 0.04
  local rows = {}
  for i, l in ipairs(lines) do
    rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cl', minw = w, minh = lh, padding = 0}, nodes = {
      {n = G.UIT.C, config = {align = 'cl', minw = indent, minh = lh, padding = 0}, nodes = i == 1 and {t_node(dash, sc, UIK.C.title, false)} or {}},
      t_node(l, sc, UIK.C.text, false),
    }}
  end
  local h = #rows * lh + 0.08
  local node = {n = G.UIT.C, config = {align = 'tl', minw = w, minh = h, padding = 0}, nodes = {
    {n = G.UIT.R, config = {align = 'cl', padding = 0}, nodes = {{n = G.UIT.C, config = {align = 'cl', padding = 0}, nodes = rows}}},
  }}
  node.uik_h = h
  return node
end

function RI.version_name()
  return tostring(rawget(_G, "OVERHAUL_NAME") or rawget(_G, "OVERHAUL_VERSION") or "?")
end

function RI.build()
  local b = rawget(_G, "OVERHAUL_VERSION")
  return b ~= nil and tostring(b) or nil
end

local function version_text()
  local b = rawget(_G, "OVERHAUL_NAME") and RI.build()
  return string.format(L("Version %s"), RI.version_name() .. (b and (" b" .. b) or ""))
end
RI.version_text = version_text

RI.RAINBOW = RI.RAINBOW or {0.95, 0.35, 0.35, 1}

local function hsv(h, s, v)
  local i = math.floor(h * 6)
  local f = h * 6 - i
  local p, q, t = v * (1 - s), v * (1 - f * s), v * (1 - (1 - f) * s)
  i = i % 6
  if i == 0 then return v, t, p elseif i == 1 then return q, v, p elseif i == 2 then return p, v, t
  elseif i == 3 then return p, q, v elseif i == 4 then return t, p, v end
  return v, p, q
end

G.FUNCS.ri_rainbow = function(e)
  local t = G.TIMERS and G.TIMERS.REAL or 0
  if RI._rb_t ~= t then
    RI._rb_t = t
    RI.RAINBOW[1], RI.RAINBOW[2], RI.RAINBOW[3] = hsv((t * 0.12) % 1, 0.62, 0.92)
  end
  e.config.colour = RI.RAINBOW
end

function RI.card_node(key, w)
  local center = G.P_CENTERS[key] or G.P_CENTERS.j_joker
  local h = w * G.CARD_H / G.CARD_W
  local area = CardArea(0, 0, w, h, {card_limit = 1, type = 'title', highlight_limit = 0, card_w = w})
  local card = Card(0, 0, w, h, G.P_CARDS.empty, center, {bypass_discovery_center = true, bypass_discovery_ui = true, bypass_lock = true})
