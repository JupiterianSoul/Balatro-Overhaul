local function text_rows(lines, w, sc, colour, align)
  local lh = sc * 1.05 + 0.05
  local rows = {}
  for _, l in ipairs(lines) do
    rows[#rows + 1] = {n = G.UIT.R, config = {align = align or 'cl', minw = w, minh = lh, padding = 0}, nodes = {t_node(l, sc, colour or UIK.C.text, false)}}
  end
  return rows, #rows * lh
end

local function info_card(o, w, h)
  local sc = touch() and 0.33 or 0.31
  local icon_w = touch() and 0.5 or 0.45
  local inner = w - 2 * 0.15
  local lines = {}
  for i, ptext in ipairs(o[3]) do
    if i > 1 then lines[#lines + 1] = "" end
    for _, l in ipairs(RI.wrap(L(ptext), inner, sc)) do lines[#lines + 1] = l end
  end
  local rows = text_rows(lines, inner, sc, UIK.C.text)
  local title_w = inner - icon_w - 0.2
  return {n = G.UIT.C, config = {align = 'tm', minw = w, minh = h, r = 0.12, padding = 0.15, colour = UIK.C.section}, nodes = {
    {n = G.UIT.R, config = {align = 'cl', minw = inner, padding = 0}, nodes = {
      RI.card_node(o[1], icon_w),
      {n = G.UIT.B, config = {w = 0.2, h = 0.1}},
      {n = G.UIT.C, config = {align = 'cl', minw = title_w, padding = 0}, nodes = {t_node(L(o[2]), touch() and 0.5 or 0.46, UIK.C.title, true)}},
    }},
    {n = G.UIT.R, config = {align = 'cm', minh = 0.12}, nodes = {}},
    {n = G.UIT.R, config = {align = 'tl', minw = inner, padding = 0}, nodes = {{n = G.UIT.C, config = {align = 'tl', padding = 0}, nodes = rows}}},
  }}
end

local function hero(w, h, side)
  local bw = touch() and 3.4 or 3.2
  local bh = touch() and 0.8 or 0.66
  local cw = touch() and 1.7 or (side and 1.6 or 1.9)
  local text = {
    {n = G.UIT.R, config = {align = 'cm', padding = 0.04}, nodes = {{n = G.UIT.C, config = {align = 'cm', maxw = (side and w - 2.4 or w) - 0.4, padding = 0}, nodes = {t_node("Balatro Overhaul", touch() and 0.62 or 0.6, UIK.C.title, true)}}}},
    {n = G.UIT.R, config = {align = 'cm', padding = 0.03}, nodes = {t_node(version_text(), body_scale(), UIK.C.muted, false)}},
    {n = G.UIT.R, config = {align = 'cm', padding = 0.03}, nodes = {t_node(L("Made by Jupiterian Soul"), body_scale(), UIK.C.text, false)}},
    {n = G.UIT.R, config = {align = 'cm', minh = 0.15}, nodes = {}},
    {n = G.UIT.R, config = {align = 'cm', padding = 0.05}, nodes = {UIK.button{label = L("Credits"), button = 'about_credits', colour = UIK.C.accent, w = bw, h = bh, col = true}}},
    {n = G.UIT.R, config = {align = 'cm', padding = 0.05}, nodes = {UIK.button{label = L("Support on Ko-fi"), button = 'about_patreon', w = bw, h = bh, col = true, func = 'ri_rainbow'}}},
  }
  local card = {n = G.UIT.C, config = {align = 'cm', padding = 0.05}, nodes = {RI.card_node('j_hologram', cw)}}
  local body = {n = G.UIT.C, config = {align = 'cm', padding = 0}, nodes = text}
  local nodes
  if side then
    nodes = {{n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {card, {n = G.UIT.C, config = {minw = 0.3}, nodes = {}}, body}}}
  else
    nodes = {{n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {card}}, {n = G.UIT.R, config = {align = 'cm', minh = 0.1}, nodes = {}}, {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {body}}}
  end
  return {n = side and G.UIT.R or G.UIT.C, config = {align = 'cm', minw = w, minh = h, r = 0.12, padding = 0.1, colour = UIK.C.section}, nodes = nodes}
end

function RI.about_tab()
  local avail = UIK.H - UIK.TOP - 0.05
  local gap = UIK.GAP
  if UIK.portrait() then
    local hh = 4.1
    local ch = (avail - hh - 4 * gap) / 4
    local rows = {hero(UIK.W, hh, true)}
    for _, o in ipairs(RI.ABOUT_CARDS) do
      rows[#rows + 1] = {n = G.UIT.R, config = {minh = gap}, nodes = {}}
      rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {info_card(o, UIK.W, ch)}}
    end
    return {n = G.UIT.R, config = {align = 'tm', minw = UIK.W, padding = 0}, nodes = {{n = G.UIT.C, config = {align = 'tm', padding = 0}, nodes = rows}}}
  end
  local hw = touch() and 4.4 or 4.3
  local rw = UIK.W - hw - gap
  local cw = (rw - gap) / 2
  local ch = (avail - gap) / 2
  local grid = {}
  for r = 0, 1 do
    if r > 0 then grid[#grid + 1] = {n = G.UIT.R, config = {minh = gap}, nodes = {}} end
    grid[#grid + 1] = {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {
      info_card(RI.ABOUT_CARDS[r * 2 + 1], cw, ch),
      {n = G.UIT.C, config = {minw = gap}, nodes = {}},
      info_card(RI.ABOUT_CARDS[r * 2 + 2], cw, ch),
    }}
  end
  return {n = G.UIT.R, config = {align = 'tm', minw = UIK.W, padding = 0}, nodes = {
    hero(hw, avail),
    {n = G.UIT.C, config = {minw = gap}, nodes = {}},
    {n = G.UIT.C, config = {align = 'tm', padding = 0}, nodes = grid},
  }}
end

function RI.licences_tab()
  local items = {}
  for _, e in ipairs(RI.LICENCES) do
    head_pair(items, L(e[1]), L(e[3]))
    para(items, L(e[2]))
  end
  return UIK.flow{id = 'about_licences', items = items, cols = cols_n()}
end

function RI.privacy_tab()
  local items = {}
  for _, s in ipairs(RI.PRIVACY) do
    head(items, L(s[1]))
    for _, p in ipairs(s[2]) do para(items, L(p)) end
  end
  return UIK.flow{id = 'about_privacy', items = items, cols = cols_n()}
end

local MONTHS = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"}

function RI.date_text(d)
  local y, m, day = tostring(d or ""):match("^(%d+)-(%d+)-(%d+)$")
  if not y then return tostring(d or "") end
  return tonumber(day) .. " " .. L(MONTHS[tonumber(m)] or m) .. " " .. y
end

function RI.version_label(e)
  local v = e.version
  local test = v:match("^[Tt]est%s+([%d%.]+)$")
  if test then return string.format(L("Test build %s"), test) end
  if v:match("^[%d%.]+$") then v = string.format(L("Version %s"), v) end
  return v
end

local function news_parts(h, w, sc)
  local p = {pad = 0.12, ts = touch() and 0.44 or 0.4}
  p.inner = w - 2 * p.pad
  p.icon_w = h.icon and (touch() and 0.62 or 0.56) or 0
  p.tw = p.inner - (h.icon and p.icon_w + 0.2 or 0)
  p.title_h = h.title and (p.ts * 1.1 + 0.06) or 0
  p.lines = RI.wrap(h.text, p.tw, sc)
  local th = p.title_h + #p.lines * (sc * 1.05 + 0.05)
  p.h = math.max(th, p.icon_w * G.CARD_H / G.CARD_W) + 2 * p.pad
  return p
end

function RI.news_h(h, w, sc)
  return news_parts(h, w, sc).h
end

function RI.news_card(h, w, sc, hh)
  local p = news_parts(h, w, sc)
  hh = math.max(hh or 0, p.h)
  local rows = {}
  if h.title then
    rows[1] = {n = G.UIT.R, config = {align = 'cl', minw = p.tw, minh = p.title_h, padding = 0}, nodes = {
      {n = G.UIT.C, config = {align = 'cl', maxw = p.tw, padding = 0}, nodes = {t_node(h.title, p.ts, UIK.C.title, true)}},
    }}
  end
  for _, r in ipairs((text_rows(p.lines, p.tw, sc, UIK.C.text))) do rows[#rows + 1] = r end
  local nodes = {}
  if h.icon then
    nodes[1] = RI.card_node(h.icon, p.icon_w)
    nodes[2] = {n = G.UIT.B, config = {w = 0.2, h = 0.1}}
  end
  nodes[#nodes + 1] = {n = G.UIT.C, config = {align = 'tl', minw = p.tw, padding = 0}, nodes = rows}
  local node = {n = G.UIT.C, config = {align = 'tm', minw = w, minh = hh, r = 0.12, padding = p.pad, colour = UIK.C.section}, nodes = {
    {n = G.UIT.R, config = {align = 'tl', minw = p.inner, padding = 0}, nodes = nodes},
  }}
  node.uik_h = hh
  return node
end

function RI.pair_row(nodes, w, gap, vgap)
  local h = 0
  local list = {}
  for i, n in ipairs(nodes) do
    if i > 1 then list[#list + 1] = {n = G.UIT.C, config = {minw = gap, padding = 0}, nodes = {}} end
    list[#list + 1] = n
    h = math.max(h, n.uik_h or 0)
  end
  vgap = vgap or gap
  local node = {n = G.UIT.R, config = {align = 'cm', minw = w, minh = h + vgap, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = 'tm', padding = 0}, nodes = {{n = G.UIT.R, config = {align = 'tm', padding = 0}, nodes = list}}},
  }}
  node.uik_h = h + vgap
  return node
end

local function news_rows(highs, w, per, gap, sc, vgap)
  local cw = (w - gap * (per - 1)) / per
  local out = {}
  for i = 1, #highs, per do
    local group = {}
    for j = i, math.min(i + per - 1, #highs) do group[#group + 1] = highs[j] end
    local hh = 0
    for _, h in ipairs(group) do hh = math.max(hh, RI.news_h(h, cw, sc)) end
    local cards = {}
    for k, h in ipairs(group) do cards[k] = RI.news_card(h, cw, sc, hh) end
    out[#out + 1] = RI.pair_row(cards, w, gap, vgap)
  end
  return out
end
RI.news_rows = news_rows

function RI.cl_index()
  local list = RI.changelog()
  RI._cl_idx = math.max(1, math.min(RI._cl_idx or 1, math.max(#list, 1)))
  return RI._cl_idx, list
end

G.FUNCS.ri_cl_step = function(e)
  local r = e and e.config and e.config.ref_table
  local idx, list = RI.cl_index()
  RI._cl_idx = math.max(1, math.min(#list, idx + ((r and r.d) or 0)))
  UIK._pages.about_changelog = 1
  UIK.refresh()
end

function RI.changelog_tab()
  local idx, list = RI.cl_index()
  local e = list[idx]
  if not e then
    local items = {}
    para(items, L("No changelog in this build."), UIK.C.muted)
    return UIK.flow{id = 'about_changelog', items = items, cols = cols_n()}
  end
  local title, highs, rest = RI.entry_text(e)
  local label = RI.version_label(e)
  if e.date ~= "" then label = label .. "  |  " .. RI.date_text(e.date) end
  local bar = UIK.pager{prev = 'ri_cl_step', next = 'ri_cl_step', prev_ref = {key = 'cl', d = 1}, next_ref = {key = 'cl', d = -1},
    text = label, text_w = UIK.portrait() and 4.6 or 7.5, prev_disabled = idx >= #list, next_disabled = idx <= 1, w = UIK.W}
  local per = cols_n()
  local fw = UIK.W - 2 * UIK.PAD
  local gap = UIK.GAP
  local sc = body_scale()
  local items = {}
  for _, r in ipairs(news_rows(highs, fw, per, gap, sc, gap - 2 * UIK.PAD + 0.02)) do items[#items + 1] = r end
  if #rest > 0 then
    if #highs > 0 then items[#items + 1] = UIK.header(L("Also in this version"), {w = fw, colour = UIK.C.muted}) end
    local bw = (fw - gap * (per - 1)) / per
    for i = 1, #rest, per do
      local group = {}
      for j = i, math.min(i + per - 1, #rest) do group[#group + 1] = bullet_node(rest[j], bw) end
      items[#items + 1] = RI.pair_row(group, fw, gap, 0)
    end
  end
  if title then
    local tw = UIK.portrait() and 4.3 or 7.3
    local ts = touch() and 0.46 or 0.44
    local th = ts * 1.1 + 0.04 + body_scale() * 1.1
    bar.nodes[2].nodes = {{n = G.UIT.C, config = {align = 'cm', padding = 0}, nodes = {
      {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {{n = G.UIT.C, config = {align = 'cm', maxw = tw - 0.2, padding = 0}, nodes = {t_node(title, ts, UIK.C.title, true)}}}},
      {n = G.UIT.R, config = {align = 'cm', minh = 0.04, padding = 0}, nodes = {}},
      {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {{n = G.UIT.C, config = {align = 'cm', maxw = tw - 0.2, padding = 0}, nodes = {t_node(label, body_scale(), UIK.C.muted, false)}}}},
    }}}
    bar.uik_h = math.max(bar.uik_h, th + 0.16)
  end
  local head_nodes = {bar}
  local keep = UIK.H
  UIK.H = UIK.H - bar.uik_h
  local ok, flow = pcall(UIK.flow, {id = 'about_changelog', items = items, cols = 1})
  UIK.H = keep
  if not ok then error(flow) end
  head_nodes[#head_nodes + 1] = flow
  return {n = G.UIT.R, config = {align = 'tm', minw = UIK.W, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = 'tm', padding = 0}, nodes = head_nodes},
  }}
end

function RI.window(tab)
  return UIK.window{
    id = 'about',
    title = L("ABOUT"),
    tab = tab,
    back_func = 'about_back',
    tabs = {
      {key = 'about', label = L("About"), build = RI.about_tab},
      {key = 'changelog', label = L("Changelog"), build = RI.changelog_tab},
      {key = 'licences', label = L("Licences"), build = RI.licences_tab},
      {key = 'privacy', label = L("Privacy"), build = RI.privacy_tab},
    },
  }
end

function RI.open(tab, from)
