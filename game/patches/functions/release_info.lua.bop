    ["Game engine by the LÖVE Development Team. Its libraries (SDL2, LuaJIT, LuaSocket, OpenAL Soft, FreeType and more) are listed in license.txt."] = "Motor de juego del LÖVE Development Team. Sus bibliotecas (SDL2, LuaJIT, LuaSocket, OpenAL Soft, FreeType y más) están en license.txt.",
    ["zlib licence"] = "Licencia zlib",
    ["Modding framework by the Steamodded team, shipped with its source and modified for the Overhaul. The changes are listed in OVERHAUL_CHANGES.md next to it."] = "Herramienta de modding del equipo de Steamodded, incluida con su código fuente, modificado para el Overhaul, cambios en OVERHAUL_CHANGES.md.",
    ["GNU GPL 3.0"] = "GNU GPL 3.0",
    ["File access library by megagrump, used by Steamodded."] = "Biblioteca de acceso a archivos de megagrump, usada por Steamodded.",
    ["MIT licence"] = "Licencia MIT",
    ["The Workshop's list of mods, by Efe and its contributors."] = "La lista de mods del Workshop, de Efe y sus colaboradores.",
    ["The Overhaul reads mods made for Lovely, by ethangreen-dev. The Overhaul's loader is its own code."] = "El Overhaul lee mods hechos para Lovely, de ethangreen-dev. El cargador del Overhaul es código propio.",
    ["Based on Balatro Multiplayer by Virtualized and the BMP team: the multiplayer in this mod builds on their work. Thank you."] = "Basado en Balatro Multiplayer de Virtualized y el equipo de BMP: el multijugador de este mod se apoya en su trabajo. Gracias.",
    ["Fonts"] = "Fuentes",
    ["m6x11plus by Daniel Linssen, Noto Sans and Go Noto (SIL Open Font Licence). They come from your copy of Balatro."] = "m6x11plus de Daniel Linssen, Noto Sans y Go Noto (licencia SIL Open Font). Vienen de tu copia de Balatro.",
    ["The Deck Creator is ported from Balatro-DeckCreator by adambennett."] = "El Creador de mazos está portado de Balatro-DeckCreator, de adambennett.",
    ["Some of the Deck Creator's random-value logic follows Cryptid, by MathIsFun_ and the Cryptid team."] = "Parte de la lógica de valores aleatorios del Creador de mazos sigue a Cryptid, de MathIsFun_ y el equipo de Cryptid.",
    ["Music and sounds"] = "Música y sonidos",
    ["Balatro's soundtrack by LouisF and its sounds come from your copy of Balatro. The public release ships no one else's music."] = "La banda sonora de Balatro de LouisF y sus sonidos vienen de tu copia de Balatro. La versión pública no incluye música de nadie más.",
    ["From your copy"] = "De tu copia",
    ["Code, art and texts made for this mod. Free software: you may use, study, change and share it under the GPL, keeping the credits."] = "Código, arte y textos hechos para este mod. Software libre: puedes usarlo, estudiarlo, modificarlo y compartirlo bajo la GPL, manteniendo los créditos.",
    ["Free to download and play"] = "Gratis para descargar y jugar",
    ["Online account"] = "Cuenta en línea",
    ["Playing online creates an account on the Overhaul server: your player name, a random key kept on this device, friends, match results, ranked points and replays."] = "Jugar en línea crea una cuenta en el servidor del Overhaul: tu nombre, una clave aleatoria guardada en este dispositivo, amigos, resultados, puntos de clasificatoria y repeticiones.",
    ["Chat and reports"] = "Chat y reportes",
    ["Chat messages go through the server and a word filter. Reports from players are kept so they can be checked."] = "Los mensajes del chat pasan por el servidor y un filtro de palabras. Los reportes de jugadores se guardan para poder revisarlos.",
    ["Crash reports"] = "Informes de errores",
    ["Send crash reports is on unless you turn it off (Settings > Account)."] = "Enviar informes de errores está activado salvo que lo desactives (Configuración > Cuenta).",
    ["A crash sends the error, the game version, your system and graphics card, where you were in the game, your last clicks, the end of the log and your mod list."] = "Un cierre inesperado envía el error, la versión del juego, tu sistema y tarjeta gráfica, dónde estabas en el juego, tus últimos clics, el final del registro y tu lista de mods.",
    ["It also sends a random number for this install, to count players. Your name and folders are removed first."] = "También envía un número al azar para esta instalación, para contar jugadores. Tu nombre y tus carpetas se quitan antes del envío.",
    ["AI bots"] = "Bots de IA",
    ["If you let Bot-latro use an online AI service with your own key, it sends the run's state to that service. Your key stays on this device."] = "Si dejas que Bot-latro use un servicio de IA en línea con tu propia clave, envía el estado de la partida a ese servicio. Tu clave se queda en este dispositivo.",
    ["What we never do"] = "Lo que nunca hacemos",
    ["No ads, no tracking, nothing is sold. The server is run by the Overhaul's developer, not by LocalThunk or Playstack."] = "Sin anuncios, sin rastreo, no se vende nada. El servidor lo gestiona el desarrollador del Overhaul, no LocalThunk ni Playstack.",
    ["Your data"] = "Tus datos",
    ["To have your account and its data deleted, ask on the Overhaul's GitHub page. Online play with chat is meant for players aged 13 and over."] = "Para borrar tu cuenta y sus datos, pídelo en la página de GitHub del Overhaul. El juego en línea con chat es para jugadores de 13 años o más.",
    ["About the Overhaul"] = "Acerca del Overhaul",
    ["Disclaimer, licences and privacy"] = "Aviso, licencias y privacidad",
    ["What changed in each version"] = "Qué cambió en cada versión",
  },
}


