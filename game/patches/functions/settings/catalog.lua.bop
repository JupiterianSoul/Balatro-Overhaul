    profile[#profile + 1] = UIK.action{id = 'set_language', label = L("Language"), info = L("Change the game language"), button_label = L("Open"), button = 'language_selection', colour = UIK.C.accent}
  end
  if SaveTransfer and SaveTransfer.settings_rows then
    for _, r in ipairs(SaveTransfer.settings_rows()) do profile[#profile + 1] = r end
  end
  local other = {
    UIK.toggle{id = 'set_modmenu', label = L("Disable Cheats"), info = L("Hides the Cheats toggle and button"), ref_table = St, ref_value = 'mod_menu_disabled', callback = save},
    UIK.toggle{id = 'set_cheatbtn', label = L("Hide Cheats Button"), info = L("Cheats stay in the pause menu"), ref_table = St, ref_value = 'hide_cheats_button', callback = function() save() if remove_floating_mod_button then remove_floating_mod_button() end if G.STAGE == G.STAGES.RUN and create_floating_mod_button then create_floating_mod_button() end end},
    UIK.toggle{id = 'set_crash', label = L("Send crash reports"), info = L("Sends the error and game info to the Overhaul team"), ref_table = St, ref_value = 'crashreports', callback = function() if CrashReports and CrashReports.chose then CrashReports.chose() end save() end},
  }
  if BOM_DEBUG_BUILD and not (DebugManager and DebugManager.is_enabled and DebugManager.is_enabled()) then
    other[#other + 1] = UIK.action{id = 'set_debug_unlock', label = L("Unlock Debug"), info = L("Developer access, needs a PIN"), button_label = L("Unlock"), button = 'open_debug_pin', colour = UIK.C.warn}
  end
  local about = {
    UIK.action{id = 'set_about', label = L("About the Overhaul"), info = L("Disclaimer, licences and privacy"), button_label = L("Open"), button = 'open_about', colour = UIK.C.accent},
    UIK.action{id = 'set_changelog', label = L("Changelog"), info = L("What changed in each version"), button_label = L("Open"), button = 'open_changelog', colour = UIK.C.accent},
  }
  if ReleaseInfo and ReleaseInfo.settings_rows then
    for _, r in ipairs(ReleaseInfo.settings_rows()) do about[#about + 1] = r end
  end
  return {
    {title = "Profile", items = profile},
    {title = "Other", items = other},
    {title = "About", items = about},
  }
end

