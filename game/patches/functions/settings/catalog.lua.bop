local function guide()
  local done = G.SETTINGS.tutorial_complete and not G.OVERLAY_TUTORIAL
  local ov_done = G.FUNCS.overhaul_tutorial_done and G.FUNCS.overhaul_tutorial_done() or false
  local menu = G.STAGE == G.STAGES.MAIN_MENU
  local function buttons(list, colour)
    local out = {}
    for _, g in ipairs(list) do
      if G.FUNCS[g[2]] then out[#out + 1] = {label = g[1], button = g[2], colour = colour, id = 'set_guide_' .. g[2]} end
    end
    return out
  end
  return {
    {title = "Tutorials", items = {
      UIK.action{id = 'set_replay_tutorial', label = L("Balatro tutorial"), info = L("Your first run with Jimbo's tips"), button_label = L("set_btn_play"), button = 'start_tutorial', colour = UIK.C.accent,
        disabled = G.GAME and G.GAME.multiplayer and G.STAGE == G.STAGES.RUN},
      UIK.action{id = 'set_skip_tutorial', label = L("Skip Balatro tutorial"), info = done and L("The Balatro tutorial is done") or L("Mark Jimbo's first run as done"),
        button_label = done and L("set_btn_done") or L("set_btn_skip"), button = 'skip_vanilla_tutorial', colour = UIK.C.warn, disabled = done},
      UIK.action{id = 'set_replay_overhaul_tutorial', label = L("Overhaul tutorial"), info = menu and L("Hologram shows every Overhaul feature") or L("Open it from the main menu"),
        button_label = L("set_btn_play"), button = 'replay_overhaul_tutorial', colour = UIK.C.accent, disabled = not menu},
      UIK.action{id = 'set_skip_overhaul_tutorial', label = L("Skip Overhaul tutorial"), info = ov_done and L("The Overhaul tutorial is done") or L("No tour and no Hologram tips"),
        button_label = ov_done and L("set_btn_done") or L("set_btn_skip"), button = 'skip_overhaul_tutorial', colour = UIK.C.warn, disabled = ov_done},
    }},
    {title = "Multiplayer", grid = buttons(S.GUIDES_MP, UIK.C.warn)},
    {title = "Overhaul", grid = buttons(S.GUIDES, UIK.C.accent)},
  }
end

local function debug()
  return {
    {title = "Debug Active", colour = UIK.C.ok, items = {
      UIK.action{id = 'set_debug_content', label = L("Content Unlock"), info = L("Unlock cards, decks and more"), button_label = L("Open"), button = 'open_debug_menu_overlay', colour = UIK.C.ok},
      UIK.action{id = 'set_debug_coin', label = L("+10000 Balacoin"), info = L("Adds coins to this profile"), button_label = L("Add"), button = 'debug_add_balacoin', colour = UIK.C.money},
      UIK.action{id = 'set_debug_xp', label = L("+50000 XP"), info = L("Adds XP to this profile"), button_label = L("Add"), button = 'debug_add_xp', colour = UIK.C.add},
      UIK.action{id = 'set_debug_lock', label = L("Lock Debug"), info = L("Turns debug mode off"), button_label = L("Lock"), button = 'debug_reset', colour = UIK.C.danger},
    }},
  }
end

local function debug_on()
  return BOM_DEBUG_BUILD and DebugManager and DebugManager.is_enabled and DebugManager.is_enabled() and true or false
end

S.CATS = {
  {key = 'gameplay', label = "Gameplay", build = gameplay},
  {key = 'shop', label = "Shop", build = shop},
  {key = 'helpers', label = "Helpers", build = helpers},
  {key = 'controls', label = "Controls", build = controls, page = function()
    local C = rawget(_G, "Controls")
    return C and C.settings_page and C.settings_page() or nil
  end, show = function()
    local C = rawget(_G, "Controls")
    return not touch() or (C and C.settings_page and true) or false
  end},
  {key = 'display', label = "Display", build = display},
  {key = 'graphics', label = "Graphics", build = graphics},
  {key = 'performance', label = "Performance", build = performance},
  {key = 'audio', label = "Audio", build = audio},
  {key = 'jukebox', label = "Jukebox", build = jukebox},
  {key = 'account', label = "Account", build = account},
  {key = 'guide', label = "Guide", build = guide},
  {key = 'debug', label = "Debug", build = debug, show = debug_on},
}

S.LEGACY = {
  Game = 'gameplay', QoL = 'gameplay', Helpers = 'helpers', Display = 'display', Video = 'display', Interface = 'display',
  Graphics = 'graphics', Audio = 'audio', Jukebox = 'jukebox', Account = 'account', Other = 'account', Guide = 'guide', Debug = 'debug',
}
