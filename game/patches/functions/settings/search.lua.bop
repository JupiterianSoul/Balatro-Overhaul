local S = SettingsUI
local L = function(s) return mod_loc(s) end

S.MIN_CHARS = 2

local ACCENTS = {["à"] = "a", ["â"] = "a", ["á"] = "a", ["ä"] = "a", ["ã"] = "a", ["ç"] = "c", ["é"] = "e", ["è"] = "e", ["ê"] = "e", ["ë"] = "e",
  ["í"] = "i", ["ì"] = "i", ["î"] = "i", ["ï"] = "i", ["ñ"] = "n", ["ó"] = "o", ["ò"] = "o", ["ô"] = "o", ["ö"] = "o", ["õ"] = "o",
  ["ú"] = "u", ["ù"] = "u", ["û"] = "u", ["ü"] = "u", ["ý"] = "y", ["ÿ"] = "y", ["œ"] = "oe", ["æ"] = "ae"}

function S.norm(s)
  s = tostring(s or "")
  s = s:gsub("[\195\197][\128-\191]", function(ch) return ACCENTS[ch:lower()] or ACCENTS[ch] or ch end)
  s = s:lower()
  s = s:gsub("[\195\197][\128-\191]", function(ch) return ACCENTS[ch] or ch end)
  return s
end

local function card_h_results(d)
  return d.PAD + d.HH + d.PAD
end

local function field_w()
  return UIK.touch() and 7.2 or 6.6
end

local function trim(s) return (s:gsub("^%s+", ""):gsub("%s+$", "")) end

function S.search_active(q)
  return #trim(S.norm(q or "")) >= S.MIN_CHARS
end

function S.build_index()
  local d = S.dims()
  local out = {}
  for _, cat in ipairs(S.visible_cats()) do
    local sections = S.sections(cat, d)
    for _, s in ipairs(sections) do
      local section = s.raw_title and s.title or L(s.title)
      for _, r in ipairs(s.rows) do
        local e = r.set_entry
        if e and e.id and e.label ~= '' then
          out[#out + 1] = {id = e.id, label = e.label, info = e.info, cat = cat.key, cat_label = L(cat.label), section = section}
        end
        S.discard(r)
      end
    end
  end
  return out
end

function S.match(entries, query)
  local q = trim(S.norm(query))
  if #q < S.MIN_CHARS then return {} end
  local first, second, third = {}, {}, {}
  for _, e in ipairs(entries) do
    local l = S.norm(e.label)
    if l:find(q, 1, true) == 1 then
      first[#first + 1] = e
    elseif l:find(" " .. q, 1, true) or l:find(q, 1, true) then
      second[#second + 1] = e
    elseif S.norm(e.info):find(q, 1, true) or S.norm(e.section):find(q, 1, true) or S.norm(e.cat_label):find(q, 1, true) then
      third[#third + 1] = e
    end
  end
  for _, e in ipairs(second) do first[#first + 1] = e end
  for _, e in ipairs(third) do first[#first + 1] = e end
  return first
end

function S.result_row(e, i, d)
  local path = e.cat_label .. "  >  " .. e.section
  local w = d.INNER - 0.1
  local tw = w - 2 * d.INSET
  return {n = G.UIT.R, config = {align = 'cm', padding = 0.04}, nodes = {
    {n = G.UIT.C, config = {id = 'set_res_' .. i, align = 'cl', minw = w, maxw = w, minh = d.RH - 0.08, r = 0.1, padding = 0, hover = true, shadow = true, colour = UIK.C.button,
      button = 'set_search_go', ref_table = e, focus_args = i == 1 and {snap_to = true} or nil}, nodes = {
      {n = G.UIT.C, config = {minw = d.INSET, padding = 0}, nodes = {}},
      {n = G.UIT.C, config = {align = 'cl', minw = tw, maxw = tw, padding = 0}, nodes = {
        {n = G.UIT.R, config = {align = 'cl', minh = d.LH, padding = 0}, nodes = {
          {n = G.UIT.C, config = {align = 'cl', maxw = tw, padding = 0}, nodes = {{n = G.UIT.T, config = {text = e.label, scale = d.LS, colour = G.C.UI.TEXT_LIGHT, shadow = true}}}},
        }},
        {n = G.UIT.R, config = {align = 'cl', minh = d.IH, padding = 0}, nodes = {
          {n = G.UIT.C, config = {align = 'cl', maxw = tw, padding = 0}, nodes = {{n = G.UIT.T, config = {text = path, scale = d.IS, colour = {1, 1, 1, 0.75}}}}},
        }},
      }},
    }},
  }}
end

function S.results(q, d)
  S.index = S.index or S.build_index()
  local found = S.match(S.index, q)
  local full = d.BODY_H - UIK.TOP
  local per = d.RH + 2 * 0.04 + d.PAD
  local max = math.max(1, math.floor((full - card_h_results(d)) / per))
  local shown = math.min(#found, max)
  S.found = found
  local title
  if #found == 0 then
    title = L("No setting found")
  elseif #found > shown then
    title = string.format(L("%d of %d results, type more letters"), shown, #found)
  else
    title = string.format(#found == 1 and L("%d result") or L("%d results"), #found)
  end
  local nodes = {UIK.header(title, {w = d.INNER})}
  for i = 1, shown do nodes[#nodes + 1] = S.result_row(found[i], i, d) end
  return {n = G.UIT.R, config = {align = 'tm', minw = d.CW, minh = full, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = 'tm', padding = 0}, nodes = {
      {n = G.UIT.R, config = {align = 'tm', minw = d.CW, r = 0.12, padding = d.PAD, colour = UIK.C.section}, nodes = nodes},
    }},
  }}
end

function S.search_field(d)
  local w = math.min(d.CW - 1, field_w())
  local h = UIK.touch() and 0.66 or 0.52
  local input = create_text_input({ref_table = S.state, ref_value = 'query', max_length = 24, w = w, h = h, text_scale = UIK.touch() and 0.42 or 0.38,
    prompt_text = L("Search settings"), extended_corpus = true, keyboard_offset = UIK.touch() and 2.4 or 3, callback = function() S.enter() end})
  local function find(n)
    if type(n) ~= 'table' then return nil end
    if n.config and n.config.id == 'text_input' then return n end
    for _, ch in ipairs(n.nodes or {}) do
      local f = find(ch)
      if f then return f end
    end
  end
  local box = find(input)
  if box then box.config.focus_args = {nav = 'wide'} end
  return {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {input}}
end

function S.after_keyboard(fn)
  local c = G.CONTROLLER
  local tries = 0
  G.E_MANAGER:add_event(Event({blocking = false, blockable = false, func = function()
    tries = tries + 1
    if not G.OVERLAY_MENU or tries > 120 then return true end
    if c.screen_keyboard or c.text_input_hook then return false end
    fn()
    return true
  end}))
end

function S.focus_result(n)
  S.after_keyboard(function()
    local c = G.CONTROLLER
    local body = G.OVERLAY_MENU:get_UIE_by_ID('uik_body')
    local box = body and body.config.object
    local f = G.OVERLAY_MENU:get_UIE_by_ID('set_res_' .. n) or (box and box.get_UIE_by_ID and box:get_UIE_by_ID('set_res_' .. n))
    if f and c.HID.controller then c:snap_to{node = f} end
  end)
end

function S.enter()
  local list = S.found or (S.index and S.match(S.index, S.state.query)) or {}
  if #list > 1 and G.CONTROLLER and G.CONTROLLER.screen_keyboard then
    S.focus_result(1)
    return
  end
  if list[1] then S.go(list[1]) end
end

function S.first_focus(node, depth)
  depth = depth or 0
  if not node or depth > 30 then return nil end
  local c = node.config or {}
  if c.button or (c.focus_args and c.focus_args.type ~= 'none' and not c.focus_args.funnel_from) then return node end
  for _, ch in ipairs(node.children or {}) do
    local f = S.first_focus(ch, depth + 1)
    if f then return f end
  end
  return nil
end

function S.go(e)
  if not (e and e.cat and S.find_cat(e.cat)) then return end
  if G.CONTROLLER and G.CONTROLLER.screen_keyboard then
r 24 1015 %20%20%20%20 -
l 49
    S.after_keyboard(function() S.go(e) end)
    return
  end
  if G.CONTROLLER then G.CONTROLLER.text_input_hook = nil end
  S.state.query = ''
  S.last_q = ''
  S.cur = e.cat
  UIK._pages['set_p_' .. e.cat] = S.page_of(S.find_cat(e.cat), e.id)
  S.flash_id = e.id
  S.open(true)
  play_sound('paper1', 1.1, 0.5)
  G.E_MANAGER:add_event(Event({blocking = false, blockable = false, func = function()
    local body = G.OVERLAY_MENU and G.OVERLAY_MENU:get_UIE_by_ID('uik_body')
    local box = body and body.config.object
    local row = box and box.get_UIE_by_ID and box:get_UIE_by_ID(e.id)
    if row then
      if row.juice_up then row:juice_up(0.2, 0.2) end
      local c = G.CONTROLLER
      local f = S.first_focus(row)
      if f and c and (c.HID.controller or (Controls and Controls.keys_on and Controls.keys_on())) then c:snap_to{node = f} end
    end
    return true
  end}))
end

function S.focus_input()
  if UIK.touch() or not G.OVERLAY_MENU then return end
  local input = G.OVERLAY_MENU:get_UIE_by_ID('text_input')
  if input and G.FUNCS.select_text_input then G.FUNCS.select_text_input(input) end
end

function S.search_init()
  G.FUNCS.set_search_watch = function(e)
    local q = S.state.query or ''
    if q == S.last_q then return end
    local was = S.search_active(S.last_q or '')
    S.last_q = q
    local now = S.search_active(q)
    if now or was then
      if now and not was then S.index = nil end
      local ok, err = pcall(UIK.refresh)
      if not ok then print("[Settings] search: " .. tostring(err)) end
    end
  end
  G.FUNCS.set_search_go = function(e)
    local ok, err = pcall(S.go, e and e.config and e.config.ref_table)
    if not ok then print("[Settings] search go: " .. tostring(err)) end
  end
end
end
