l 51
end

function LS.draw(label, force)
    if st.finished then return end
    local t_now = now()
    if not st.t0 then
        st.t0 = t_now
        st.expected = read_expected()
    end
    local nl = clean_label(label)
    if nl then st.label = nl end
    if not force and t_now - st.last_draw < FRAME_GAP then return end
    st.last_draw = t_now
    if love.event then love.event.pump() end
    local target = target_progress(t_now - st.t0)
    st.shown = math.max(st.shown, st.shown + (target - st.shown) * 0.25)
    render(t_now)
end

local function outro()
    local start = now()
    local from = st.shown
    st.deal_gap = 0.12
    st.label = "Ready"
    local done_at
    while true do
        local t_now = now()
        local u = (t_now - start) / 0.6
        st.shown = from + (1 - from) * ease_out(u)
        local all = st.hand == false or st.dealt[HAND] ~= nil
        if not done_at and u >= 1 and all and t_now - st.t0 >= MIN_SHOW then
            done_at = math.max(t_now, (st.last_deal or 0) + st.t0 + 0.45)
        end
        local fade = done_at and (t_now - done_at - 0.25) / 0.3 or 0
        if fade >= 1 or t_now - start > OUTRO_MAX then break end
        if love.event then love.event.pump() end
        render(t_now, fade)
        love.timer.sleep(FRAME_GAP / 2)
    end
end

function LS.finish()
    if not st.t0 or st.finished then return end
    local took = now() - st.t0
    pcall(love.filesystem.write, TIME_FILE, string.format("%.2f", took))
    pcall(outro)
    st.finished = true
    st.hand, st.ace, st.logo, st.shader = nil, nil, nil, nil
end

return LS
end
