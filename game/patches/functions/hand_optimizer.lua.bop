local function hud_def(mini)
    local t = touch()
    local r = O.results
    local best = r and r.plays and r.plays[1]
    local ts = t and 0.4 or 0.34
    local bh = t and 0.7 or 0.5
    local function buttons(bw, vertical)
        local a = UIK.button{label = L("Pick"), button = "ho_select_best", colour = UIK.C.accent, w = bw, h = bh, scale = ts, col = not vertical, disabled = not best}
        local b = UIK.button{label = L("More"), button = "ho_open", colour = UIK.C.money, w = bw, h = bh, scale = ts, col = not vertical, disabled = not best}
        if vertical then
            return {n = G.UIT.C, config = {align = "cm"}, nodes = {a, {n = G.UIT.R, config = {minh = 0.08}}, b}}
        end
        return {n = G.UIT.R, config = {align = "cm", padding = 0.04}, nodes = {a, {n = G.UIT.C, config = {minw = 0.1}}, b}}
    end
    local status = O.job and L("Thinking...") or (not best and L("No hand scores here")) or nil
    local body
    if mini then
        local w = t and 2.9 or 2.5
        local info = status and {UIK.text(status, {scale = ts, colour = UIK.C.muted})} or {
            {n = G.UIT.R, config = {align = "cm"}, nodes = {UIK.text(hand_name(best), {scale = ts, colour = UIK.C.title})}},
            {n = G.UIT.R, config = {align = "cm"}, nodes = {UIK.text(O.score_text(best), {scale = ts, colour = G.C.CHIPS})}},
        }
        body = {n = G.UIT.R, config = {align = "cm", padding = 0.04}, nodes = {
            {n = G.UIT.C, config = {align = "cm", minw = w, minh = bh * 2 + 0.08}, nodes = info},
            {n = G.UIT.C, config = {minw = 0.1}},
            buttons(t and 1.6 or 1.3, true),
        }}
    else
        local w = t and 4.2 or 3.5
        local mid
        if status then
            mid = {UIK.text(status, {scale = ts, colour = UIK.C.muted})}
        else
            mid = {
                {n = G.UIT.R, config = {align = "cm", padding = 0.02}, nodes = {UIK.text(hand_name(best), {scale = t and 0.44 or 0.4, colour = G.C.WHITE})}},
                {n = G.UIT.R, config = {align = "cm"}, nodes = {
                    {n = G.UIT.C, config = {align = "cm"}, nodes = {cards_row(best.cards, t and 0.32 or 0.28)}},
                    {n = G.UIT.C, config = {minw = 0.15}},
                    {n = G.UIT.C, config = {align = "cm"}, nodes = {UIK.text(O.score_text(best), {scale = t and 0.42 or 0.38, colour = G.C.CHIPS})}},
                }},
            }
        end
        body = {n = G.UIT.C, config = {align = "cm"}, nodes = {
            {n = G.UIT.R, config = {align = "cm", padding = 0.02}, nodes = {UIK.text(L("BEST HAND"), {scale = t and 0.34 or 0.3, colour = UIK.C.title})}},
            {n = G.UIT.R, config = {align = "cm", minw = w, minh = t and 1.05 or 0.9}, nodes = {{n = G.UIT.C, config = {align = "cm"}, nodes = mid}}},
            buttons((w - 0.3) / 2),
        }}
    end
    return {n = G.UIT.ROOT, config = {align = "cm", padding = 0.08, r = 0.15, colour = G.C.BLACK, emboss = 0.05}, nodes = {
        {n = G.UIT.R, config = {align = "cm", padding = 0.06, r = 0.12, colour = UIK.C.section}, nodes = {body}},
    }}
end

function O.hide_hud()
    if O._hud then pcall(function() O._hud:remove() end) end
    O._hud = nil
end

local function rect(m)
    local T = m and (m.VT or m.T)
    if not T or not T.w then return nil end
    return {x = T.x, y = T.y, w = T.w, h = T.h}
end

local function hits(a, b)
    return a.x < b.x + b.w and b.x < a.x + a.w and a.y < b.y + b.h and b.y < a.y + a.h
end

local function preferred_spot(w, h)
    local deck = rect(G.deck)
    if not deck then return nil end
    local x = deck.x + deck.w / 2 - w / 2
    local y = deck.y - h - 0.25
    local room_w = G.ROOM and G.ROOM.T.w or 20
    x = math.max(0.2, math.min(x, room_w - w - 0.2))
    return {x = x, y = y, w = w, h = h}
end

local function spot_free(r, obs)
    local room_w, room_h = G.ROOM and G.ROOM.T.w or 20, G.ROOM and G.ROOM.T.h or 11.5
    if r.x < 0.2 or r.y < 0.2 or r.x + r.w > room_w - 0.2 or r.y + r.h > room_h - 0.2 then return false end
    for _, ob in ipairs(obs or {}) do
        if hits(r, ob) then return false end
    end
    return true
end

local function obstacles()
    if JIMBO_COMMENTS and JIMBO_COMMENTS.obstacles then
        local ok, obs = pcall(JIMBO_COMMENTS.obstacles, O._hud)
        if ok then return obs end
    end
    return {}
end

local function place_hud(box)
    local w, h = box.T.w, box.T.h
    local obs = obstacles()
    local spot = preferred_spot(w, h)
    if not (spot and spot_free(spot, obs)) then
        spot = nil
        if JIMBO_COMMENTS and JIMBO_COMMENTS.find_spot then
            local focus = rect(G.deck)
            spot = JIMBO_COMMENTS.find_spot(w, h, focus and {x = focus.x + focus.w / 2, y = focus.y} or nil, obs)
        end
    end
    if not spot then return false end
    box.alignment.offset.x = spot.x - G.ROOM_ATTACH.T.x
    box.alignment.offset.y = spot.y - G.ROOM_ATTACH.T.y
    box:align_to_major()
    return true
end

local function new_box(mini)
    local ok, box = pcall(UIBox, {definition = hud_def(mini), config = {align = "tli", offset = {x = -30, y = -30}, major = G.ROOM_ATTACH, bond = "Weak"}})
    if not ok then O.last_error = box return nil end
    return box
end

function O.refresh_hud()
    if not active() then O.hide_hud() return end
    local t = now()
    local old = O._hud
    if not old and (t < (O._retry_at or 0) or G.OVERLAY_MENU) then return end
    local mini = old and O._mini or false
    local box = new_box(mini)
    if not box then return end
    if old then
        box.alignment.offset.x, box.alignment.offset.y = old.alignment.offset.x, old.alignment.offset.y
        box:align_to_major()
        pcall(function() old:remove() end)
        O._hud = box
        if G.OVERLAY_MENU then return end
        local r = rect(box)
        if r and spot_free(r, obstacles()) then return end
    end
    O._hud = box
    if place_hud(box) then
        O._mini = mini
        if not old then box:hard_set_VT() end
        return
    end
    pcall(function() box:remove() end)
    O._hud = nil
    if not mini then
        box = new_box(true)
        if box then
            O._hud = box
            if place_hud(box) then
                O._mini = true
                box:hard_set_VT()
                return
            end
            pcall(function() box:remove() end)
            O._hud = nil
        end
    end
    O._retry_at = t + 1
end

function O.keep_hud()
    local box = O._hud
    if not box or G.OVERLAY_MENU then return end
    local t = now()
    if t - (O._hud_check or 0) < 0.5 then return end
    O._hud_check = t
    local r = rect(box)
    if r and spot_free(r, obstacles()) then return end
    if place_hud(box) then return end
    O.hide_hud()
    O._mini = false
    O._retry_at = 0
    O.refresh_hud()
end

local function chips_mult(play, sc)
    if play.chance then
        return {n = G.UIT.R, config = {align = "cm"}, nodes = {UIK.text(L("Luck based"), {scale = sc, colour = UIK.C.muted})}}
    end
    return {n = G.UIT.R, config = {align = "cm"}, nodes = {
        UIK.text(fmt(play.chips), {scale = sc, colour = G.C.CHIPS}),
        UIK.text(" X ", {scale = sc, colour = UIK.C.muted}),
        UIK.text(fmt(play.mult), {scale = sc, colour = G.C.MULT}),
    }}
end

local function play_row(play, i, w)
    local t = touch()
    local sw, bw = t and 3.0 or 2.8, t and 2.2 or 1.9
    local nw = w - sw - bw - 0.5
    local sub = chips_mult(play, t and 0.32 or 0.3)
    return {n = G.UIT.R, config = {align = "cm", padding = t and 0.04 or 0.08, r = 0.12, colour = UIK.C.section, minw = w}, nodes = {
        {n = G.UIT.C, config = {align = "cm", minw = 0.5}, nodes = {UIK.text(tostring(i), {scale = 0.45, colour = i == 1 and UIK.C.title or UIK.C.muted})}},
        t and {n = G.UIT.C, config = {align = "cl", minw = nw}, nodes = {
            {n = G.UIT.R, config = {align = "cl"}, nodes = {
                {n = G.UIT.C, config = {align = "cl", minw = 3.2}, nodes = {UIK.text(hand_name(play), {scale = 0.44, colour = UIK.C.title})}},
                {n = G.UIT.C, config = {align = "cm"}, nodes = {cards_row(play.cards, 0.34)}},
            }},
        }} or {n = G.UIT.C, config = {align = "cl", minw = nw}, nodes = {
            {n = G.UIT.R, config = {align = "cl", padding = 0.02}, nodes = {UIK.text(hand_name(play), {scale = 0.4, colour = UIK.C.title})}},
            {n = G.UIT.R, config = {align = "cl"}, nodes = {cards_row(play.cards, 0.3)}},
        }},
        {n = G.UIT.C, config = {align = "cm", minw = sw}, nodes = {
            {n = G.UIT.R, config = {align = "cm"}, nodes = {UIK.text(O.score_text(play), {scale = t and 0.46 or 0.42, colour = G.C.CHIPS})}},
            sub,
        }},
        {n = G.UIT.C, config = {align = "cm", minw = bw}, nodes = {
            UIK.button{label = L("Pick"), button = "ho_select_best", ref_table = {index = i, close = true}, colour = UIK.C.accent, w = bw - 0.1, h = t and 0.75 or 0.6, scale = t and 0.42 or 0.36, col = true},
        }},
    }}
end

local function window_body()
    local r = O.results
    local w = math.min(UIK.W - 0.4, touch() and 13.4 or 12.4)
    local rows = {}
    if not r or not r.plays or #r.plays == 0 then
        rows[1] = {n = G.UIT.R, config = {align = "cm", minw = w, minh = 1.2}, nodes = {UIK.text(L(O.job and "Thinking..." or "No hand scores here"), {scale = 0.45, colour = UIK.C.muted})}}
    else
        for i, p in ipairs(r.plays) do
            rows[#rows + 1] = play_row(p, i, w)
            if i < #r.plays then rows[#rows + 1] = {n = G.UIT.R, config = {minh = touch() and 0.06 or 0.08}} end
        end
        local note = r.exact and L("Every possible hand was scored with the game's own rules.") or L("The strongest hands were scored with the game's own rules.")
        rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.1, minw = w}, nodes = {UIK.text(note, {scale = 0.32, colour = UIK.C.muted})}}
    end
    return {n = G.UIT.R, config = {align = "tm", padding = 0.05}, nodes = {{n = G.UIT.C, config = {align = "tm"}, nodes = rows}}}
end

local function portrait_body()
    local r = O.results
    local w = UIK.W - 0.4
    local rows = {}
    for i, p in ipairs(r and r.plays or {}) do
        rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.1, r = 0.12, colour = UIK.C.section, minw = w}, nodes = {
            {n = G.UIT.C, config = {align = "cm"}, nodes = {
                {n = G.UIT.R, config = {align = "cm"}, nodes = {UIK.text(i .. ". " .. hand_name(p), {scale = 0.46, colour = UIK.C.title})}},
                cards_row(p.cards, 0.36),
                {n = G.UIT.R, config = {align = "cm", padding = 0.04}, nodes = {UIK.text(O.score_text(p), {scale = 0.48, colour = G.C.CHIPS})}},
                chips_mult(p, 0.34),
                {n = G.UIT.R, config = {minh = 0.08}},
                {n = G.UIT.R, config = {align = "cm"}, nodes = {UIK.button{label = L("Pick"), button = "ho_select_best", ref_table = {index = i, close = true}, colour = UIK.C.accent, w = 3.2, h = 0.8, scale = 0.44}}},
            }},
        }}
        if i < #(r.plays) then rows[#rows + 1] = {n = G.UIT.R, config = {minh = 0.1}} end
    end
    if #rows == 0 then rows[1] = {n = G.UIT.R, config = {align = "cm", minw = w, minh = 1.2}, nodes = {UIK.text(L("No hand scores here"), {scale = 0.45, colour = UIK.C.muted})}} end
    return {n = G.UIT.R, config = {align = "tm", padding = 0.05}, nodes = {{n = G.UIT.C, config = {align = "tm"}, nodes = rows}}}
end

G.FUNCS.ho_open = function(e)
    if not O.results or not O.results.plays or #O.results.plays == 0 then return end
    G.FUNCS.overlay_menu{definition = UIK.window{
        id = "ho",
        title = L("HAND OPTIMIZER"),
        compact = true,
        w = UIK.portrait() and (UIK.W - 0.2) or (touch() and 13.8 or 12.8),
        tabs = {{key = "plays", label = L("Best hands"), build = function() return UIK.portrait() and portrait_body() or window_body() end}},
    }}
end

function O.install_check(path)
    if O._check then return end
    local f = io.open(path, "a")
    if not f then return end
    O._check = {f = f, ok = 0, miss = 0, exact = 0}
    local raw_play = G.FUNCS.play_cards_from_highlighted
    G.FUNCS.play_cards_from_highlighted = function(e, ...)
        local C = O._check
        if C and not (G.play and G.play.cards[1]) and G.hand and #G.hand.highlighted > 0 then
            local sel = {}
            for i, c in ipairs(G.hand.highlighted) do sel[i] = c end
            if PREVIEW and PREVIEW.clear_cache then PREVIEW.clear_cache() end
            local ok, play = pcall(O.evaluate, sel)
            C.pending = ok and play or false
            C.before = num(G.GAME.chips)
            C.best = O.results and O.results.plays and O.results.plays[1]
        end
        return raw_play(e, ...)
    end
end

function O.check_after()
    local C = O._check
    if not C or C.pending == nil then return end
    local real = num(G.GAME.chips) - (C.before or 0)
    local p = C.pending
    C.pending = nil
    local jk = {}
    for _, j in ipairs(G.jokers and G.jokers.cards or {}) do jk[#jk + 1] = j.config and j.config.center and j.config.center.key or "?" end
    local b = G.GAME.blind
    local status
    if not p then status = real <= 0 and "ok" or "miss"
    else
        local lo, hi = num(p.lo), num(p.hi)
        local tol = 1e-6 * math.max(1, math.abs(real))
        if real >= lo - tol and real <= hi + tol then status = "ok" else status = "miss" end
        if status == "ok" and math.abs(lo - hi) <= tol then C.exact = C.exact + 1 end
    end
    C[status] = C[status] + 1
    C.f:write(string.format("OPT_CHECK %s real=%s lo=%s hi=%s hand=%s best=%s blind=%s jokers=%s\n", status, tostring(real), tostring(p and p.lo), tostring(p and p.hi),
        tostring(p and p.name), tostring(C.best and C.best.lo), tostring(b and b.config and b.config.blind and b.config.blind.key), table.concat(jk, ",")))
    C.f:flush()
end

