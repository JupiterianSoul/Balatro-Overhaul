OPTIMIZER = OPTIMIZER or {}
local O = OPTIMIZER

O.MAX_EXACT = 420
O.SHOW = 5
O.BUDGET = 0.006
O.results = nil
O.job = nil
O.stats = {jobs = 0, sims = 0, ms = 0, last_ms = 0}

local function now() return love.timer.getTime() end
local function L(s) return mod_loc and mod_loc(s) or s end

local function touch()
    return UIK and UIK.touch and UIK.touch() or false
end

local function setting_on()
    return G and G.SETTINGS and G.SETTINGS.hand_optimizer == true
end

function O.allowed()
    local FL = rawget(_G, "FairLock")
    if FL and FL.blocks then
        local ok, why = pcall(FL.blocks, "hand_optimizer")
        if ok and why then return false end
    end
    if FL and FL.mp_setting_locked and FL.mp_setting_locked("hand_optimizer") then return false end
    return true
end

local function playing_state()
    return G and G.STAGE == G.STAGES.RUN and G.GAME and G.hand and G.hand.cards
        and (G.STATE == G.STATES.SELECTING_HAND)
end

local function active()
    return setting_on() and O.allowed() and playing_state() and PREVIEW and PREVIEW.compute and true or false
end

local function card_key(c)
    local b = c.base or {}
    local ed = c.edition
    return table.concat({tostring(c.sort_id or c.ID), tostring(b.id), tostring(b.suit), tostring(c.config and c.config.center and c.config.center.key),
        tostring(type(ed) == "table" and (ed.type or ed.key) or ed), tostring(c.seal), c.debuff and "d" or "", tostring(c.facing)}, ":")
end

function O.state_key()
    local g = G.GAME
    local parts = {}
    for _, c in ipairs(G.hand.cards) do parts[#parts + 1] = card_key(c) end
    parts[#parts + 1] = "|"
    for _, j in ipairs(G.jokers and G.jokers.cards or {}) do parts[#parts + 1] = card_key(j) end
    parts[#parts + 1] = "|"
    for _, c in ipairs(G.consumeables and G.consumeables.cards or {}) do parts[#parts + 1] = tostring(c.sort_id) end
    local cr = g.current_round or {}
    local b = g.blind or {}
    local lv = 0
    for _, h in pairs(g.hands or {}) do if type(h) == "table" then lv = lv + (tonumber(h.level) or 0) * 7 + (tonumber(h.played) or 0) end end
    parts[#parts + 1] = table.concat({tostring(g.dollars), tostring(cr.hands_left), tostring(cr.discards_left), tostring(g.hands_played),
        tostring(b.name), tostring(b.disabled), tostring(lv), tostring(#(G.deck and G.deck.cards or {}))}, ",")
    return table.concat(parts, " ")
end

local function play_limit()
    local lim = G.hand and G.hand.config and tonumber(G.hand.config.highlighted_limit) or 5
    if lim < 1 then lim = 5 end
    return math.min(lim, 6)
end

local function subsets(cards, kmax)
    local out = {}
    local n = #cards
    local pick = {}
    local function rec(start, depth)
        if depth > 0 then
            local s = {}
            for i = 1, depth do s[i] = pick[i] end
            out[#out + 1] = s
        end
        if depth == kmax then return end
        for i = start, n do
            pick[depth + 1] = cards[i]
            rec(i + 1, depth + 1)
        end
    end
    rec(1, 0)
    return out
end

local function hand_info(sel)
    local fn = PREVIEW and PREVIEW.hand_info or G.FUNCS.get_poker_hand_info
    local ok, name, _, _, scoring = pcall(fn, sel)
    if not ok then return nil end
    return name, scoring
end

local function rough(sel)
    local name, scoring = hand_info(sel)
    if not name or name == "NULL" then return 0 end
    local h = G.GAME.hands and G.GAME.hands[name]
    if not h then return 0 end
    local chips = tonumber(h.chips) or 0
    for _, c in ipairs(scoring or {}) do
        local b = c.base
        if b and not c.debuff then chips = chips + (tonumber(b.nominal) or 0) end
    end
    return chips * (tonumber(h.mult) or 1) + #sel * 0.01
end

local function candidates(cards)
    local all = subsets(cards, play_limit())
    if #all <= O.MAX_EXACT then return all, #all end
    local scored = {}
    for i, s in ipairs(all) do scored[i] = {s = s, v = rough(s)} end
    table.sort(scored, function(a, b) return a.v > b.v end)
    local out = {}
    for i = 1, math.min(O.MAX_EXACT, #scored) do out[i] = scored[i].s end
    return out, #all
end

local function num(v)
    if type(v) == "number" then return v end
    if type(v) == "table" and to_number then
        local ok, n = pcall(to_number, v)
        if ok and type(n) == "number" then return n end
    end
    return tonumber(v) or 0
end

local function sig(play)
    local ids = {}
    for _, c in ipairs(play.scoring or play.cards) do ids[#ids + 1] = tostring(c.sort_id or c.ID) end
    table.sort(ids)
    return tostring(play.name) .. "#" .. table.concat(ids, ",") .. "#" .. tostring(play.lo) .. "#" .. tostring(play.hi)
end

local function better(a, b)
    local alo, blo = num(a.lo), num(b.lo)
    if alo ~= blo then return alo > blo end
    local ahi, bhi = num(a.hi), num(b.hi)
    if ahi ~= bhi then return ahi > bhi end
    return #a.cards < #b.cards
end

local function finish(job)
    table.sort(job.plays, better)
    local seen, top = {}, {}
    for _, p in ipairs(job.plays) do
        local k = sig(p)
        if not seen[k] then
            seen[k] = true
            top[#top + 1] = p
            if #top >= O.SHOW then break end
        end
    end
    local ms = (now() - job.t0) * 1000
    O.stats.jobs = O.stats.jobs + 1
    O.stats.last_ms = ms
    O.stats.ms = O.stats.ms + ms
    O.results = {key = job.key, plays = top, all = job.plays, tried = job.done, total = job.total, exact = job.total == #job.list, ms = ms}
    O.job = nil
    O.refresh_hud()
    if O.on_done then pcall(O.on_done, O.results) end
end

local function face_up_cards()
    local out = {}
    for _, c in ipairs(G.hand.cards) do
        if c.facing ~= "back" and not c.removed then out[#out + 1] = c end
    end
    return out
end

function O.start()
    local key = O.state_key()
    local list, total = candidates(face_up_cards())
    O.job = {key = key, list = list, total = total, i = 0, done = 0, plays = {}, t0 = now()}
    O.results = nil
    O.hide_hud()
    O._mini, O._retry_at = false, 0
    O.refresh_hud()
end

function O.evaluate(sel)
    local res = PREVIEW.compute(sel)
    if not res then return nil end
    local lo, hi = num(res.lo), num(res.hi)
    if lo <= 0 and hi <= 0 then return nil end
    local name, scoring = hand_info(sel)
    return {cards = sel, name = res.name or name, lo = res.lo, hi = res.hi, chips = res.chips, mult = res.mult, chance = res.chance, scoring = scoring}
end

local function step(job, budget)
    local t_end = now() + budget
    while job.i < #job.list do
        job.i = job.i + 1
        local sel = job.list[job.i]
        local ok, play = pcall(O.evaluate, sel)
        O.stats.sims = O.stats.sims + 1
        job.done = job.done + 1
        if ok and play then job.plays[#job.plays + 1] = play end
        if now() >= t_end then return false end
    end
    return true
end

function O.run_all()
    if not playing_state() then return nil end
    O.start()
    while O.job do
        if step(O.job, 10) then finish(O.job) end
    end
    return O.results
end

function O.update(dt)
    if not active() then
        if O.job then O.job = nil end
        if O._hud then O.hide_hud() end
        return
    end
    local t = now()
    if O.job then
        if t - (O._key_at or 0) > 0.3 then
            O._key_at = t
            if O.state_key() ~= O.job.key then O.start() end
        end
        if step(O.job, touch() and 0.005 or O.BUDGET) then finish(O.job) end
    elseif t - (O._key_at or 0) > 0.3 then
        O._key_at = t
        local key = O.state_key()
        if not O.results or O.results.key ~= key then O.start() end
    end
    if not O._hud then O.refresh_hud() end
    O.keep_hud()
end

function O.refresh()
    O.results, O.job = nil, nil
    O.hide_hud()
end

local RANKS = {[14] = "A", [13] = "K", [12] = "Q", [11] = "J"}
local function rank_text(c)
    local id = c.base and c.base.id
    if c.ability and c.ability.effect == "Stone Card" then return "S" end
    return RANKS[id] or tostring(id or "?")
end

local function suit_colour(c)
    local s = c.base and c.base.suit
    if c.ability and c.ability.effect == "Stone Card" then return G.C.GREY end
    return (G.C.SO_1 and G.C.SO_1[s]) or (G.C.SUITS and G.C.SUITS[s]) or G.C.WHITE
end

local function cards_row(cards, scale)
    local nodes = {}
    local list = {}
    for i, c in ipairs(cards) do list[i] = c end
    table.sort(list, function(a, b) return (a.T and a.T.x or 0) < (b.T and b.T.x or 0) end)
    for i, c in ipairs(list) do
        nodes[#nodes + 1] = {n = G.UIT.C, config = {align = "cm", padding = 0.02, r = 0.04, colour = G.C.WHITE, minw = scale * 1.15, minh = scale * 1.55, emboss = 0.02}, nodes = {
            {n = G.UIT.T, config = {text = rank_text(c), scale = scale, colour = suit_colour(c)}},
        }}
        if i < #list then nodes[#nodes + 1] = {n = G.UIT.C, config = {minw = 0.05}} end
    end
    return {n = G.UIT.R, config = {align = "cm", padding = 0.02}, nodes = nodes}
end

local function fmt(v)
    local ok, s = pcall(number_format, v)
    if ok and type(s) == "string" then return s end
    return tostring(v)
end

function O.score_text(play)
    if not play then return "" end
    if num(play.lo) < num(play.hi) then
        return (L("{1} to {2}"):gsub("{1}", fmt(play.lo)):gsub("{2}", fmt(play.hi)))
    end
    return fmt(play.lo)
end

local function hand_name(play)
    local ok, s = pcall(localize, play.name, "poker_hands")
    if ok and type(s) == "string" and s ~= "ERROR" then return s end
    return tostring(play.name)
end

