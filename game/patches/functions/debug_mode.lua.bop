-- ===== HELPER: show debug success text =====
local function debug_notify(text)
  pcall(function() play_sound('timpani', 1.0, 0.5) end)
  pcall(function()
    if attention_text then
      local major = G.ROOM_ATTACH or G.play or G.hand
      if major then
        attention_text{text = text, scale = 1.2, hold = 2, backdrop_colour = G.C.GREEN, align = 'cm', major = major, offset = {x = 0, y = -2}}
      end
    end
  end)
end

local function debug_save_and_refresh()
  pcall(function() G:save_progress() end)
  pcall(function() G:save_settings() end)
  pcall(function()
r 4 240 %20%20%20%20 -
l 43
    if set_discover_tallies then set_discover_tallies() end
  end)
  pcall(function()
    if set_profile_progress then set_profile_progress() end
  end)
end

local function get_debug_profile()
  if G and G.PROFILES and G.SETTINGS and G.SETTINGS.profile then
    return G.PROFILES[G.SETTINGS.profile]
  end
  return nil
end

-- ===== PER-CATEGORY UNLOCK FUNCTIONS =====

-- Unlock Jokers
G.FUNCS.debug_unlock_jokers = function(e)
  if not DebugManager.is_enabled() then return end
  local profile = get_debug_profile()
  if not profile then return end
  pcall(function()
    if type(profile.joker_usage) ~= "table" then profile.joker_usage = {} end
    if G.P_CENTERS then
      for key, center in pairs(G.P_CENTERS) do
        if center.set == 'Joker' then
          center.unlocked = true
          center.discovered = true
          center.alerted = true
          if not profile.joker_usage[key] then
            profile.joker_usage[key] = {count = 1, order = center.order or 0, wins = {}, losses = {}}
          end
          if not profile.joker_usage[key].wins then profile.joker_usage[key].wins = {} end
          for s = 1, debug_stake_count() do
            profile.joker_usage[key].wins[s] = profile.joker_usage[key].wins[s] or 1
          end
        end
      end
    end
    -- Remove jokers from P_LOCKED
    if G.P_LOCKED then
      for i = #G.P_LOCKED, 1, -1 do
        if G.P_LOCKED[i] and G.P_LOCKED[i].set == 'Joker' then
r 13 1621 %20%20%20%20%20%20%20%20%20%20 -
l 31
        end
      end
    end
    debug_save_and_refresh()
    debug_notify(mod_loc("ALL JOKERS UNLOCKED!"))
    print("[DEBUG] All Jokers unlocked")
  end)
end

