-- ===== DEBUG CONSTANTS =====

local DEBUG_CONFIG = {
  pin_sha = "7d8187b5e28cb20ef28a72825a76badfa7178bd8d2c4e6ada4e722562e1c12c1",
  enabled = false,
  unlock_all_triggered = false,
}

-- ===== DEBUG MANAGER =====

DebugManager = {
  initialized = false,
  unlocked = false,
  entered_pin = "",
}

-- Initialize debug system
function DebugManager.init()
  if DebugManager.initialized then return true end
  if not G then return false end

  DebugManager.initialized = true
  print("[DEBUG] Debug system initialized!")
  return true
end

local function pin_ok(entered_pin)
  if type(entered_pin) ~= "string" or not (love.data and love.data.hash) then return false end
  return love.data.encode("string", "hex", love.data.hash("sha256", entered_pin)) == DEBUG_CONFIG.pin_sha
end

-- Verify PIN
function DebugManager.verify_pin(entered_pin)
  if not entered_pin then return false end

  if pin_ok(entered_pin) then
    DebugManager.unlocked = true
    DEBUG_CONFIG.enabled = true
    print("[DEBUG] Debug mode unlocked with PIN!")
    return true
  end
  return false
end

-- Check if debug mode is active
function DebugManager.is_enabled()
  return DEBUG_CONFIG.enabled and DebugManager.unlocked
end

-- ===== UNLOCK ALL FUNCTION =====
-- Ultra crash-proof version V13.0 - Dynamically unlocks 100%

function debug_stake_count()
  if G.P_CENTER_POOLS and G.P_CENTER_POOLS.Stake and #G.P_CENTER_POOLS.Stake > 0 then return #G.P_CENTER_POOLS.Stake end
  return G.sticker_map and #G.sticker_map or 12
end

function unlock_all_content(profile)
  profile = profile or (G.PROFILES and G.SETTINGS and G.PROFILES[G.SETTINGS.profile])
  if not profile then return false end
  profile.joker_usage = type(profile.joker_usage) == "table" and profile.joker_usage or {}
  profile.deck_usage = type(profile.deck_usage) == "table" and profile.deck_usage or {}
  profile.consumeable_usage = type(profile.consumeable_usage) == "table" and profile.consumeable_usage or {}
  profile.voucher_usage = type(profile.voucher_usage) == "table" and profile.voucher_usage or {}
  profile.stake_progress = type(profile.stake_progress) == "table" and profile.stake_progress or {}
  profile.challenge_progress = type(profile.challenge_progress) == "table" and profile.challenge_progress or {}
  profile.challenge_progress.unlocked = profile.challenge_progress.unlocked or {}
  profile.challenge_progress.completed = profile.challenge_progress.completed or {}
  local function open(v)
    if type(v) ~= "table" then return end
    v.unlocked = true
    v.discovered = true
    v.alerted = true
  end
  local S = rawget(_G, "SMODS")
  local tables = {G.P_CENTERS, G.P_BLINDS, G.P_TAGS, G.P_SEALS, G.P_STAKES}
  if S then
    for _, name in ipairs({"Stickers", "Seals", "Stakes", "Blinds", "Tags", "Centers", "Editions", "Enhancements", "Consumables", "Vouchers", "Boosters", "Backs"}) do
      if type(S[name]) == "table" then tables[#tables + 1] = S[name] end
    end
  end
  for _, t in ipairs(tables) do
    if type(t) == "table" then
r 12 154 %20%20%20%20%20%20 -
l 268
        if type(v) == "table" and not v.wip then open(v) end
      end
    end
  end
  for _, pool in pairs(G.P_CENTER_POOLS or {}) do
    if type(pool) == "table" then
      for _, v in ipairs(pool) do if type(v) == "table" and not v.wip then open(v) end end
    end
  end
  for _, b in pairs(G.P_BLINDS or {}) do if type(b) == "table" then b.defeated = true end end
  local stakes = {}
  for i, st in ipairs((G.P_CENTER_POOLS or {}).Stake or {}) do stakes[#stakes + 1] = {i = i, key = st.key} end
  if #stakes == 0 then for i = 1, debug_stake_count() do stakes[#stakes + 1] = {i = i} end end
  for i = 1, math.max(#stakes, debug_stake_count()) do profile.stake_progress[i] = true end
  local conv = rawget(_G, "convert_usage_entry")
  local function all_wins(usage, key, center)
    local u = usage[key]
    if type(u) ~= "table" then
      u = {count = 1, order = center.order or 0, wins = {}, losses = {}}
      if S then u.wins_by_key, u.losses_by_key = {}, {} end
      usage[key] = u
    end
    u.count = math.max(tonumber(u.count) or 0, 1)
    u.wins = type(u.wins) == "table" and u.wins or {}
    u.losses = type(u.losses) == "table" and u.losses or {}
    if S then
      u.wins_by_key = type(u.wins_by_key) == "table" and u.wins_by_key or {}
      u.losses_by_key = type(u.losses_by_key) == "table" and u.losses_by_key or {}
      if conv then pcall(conv, u) end
    end
    for _, st in ipairs(stakes) do
      if st.key and u.wins_by_key then
        u.wins_by_key[st.key] = math.max(tonumber(u.wins_by_key[st.key]) or 0, 1)
      end
      if not S or st.i <= 8 then u.wins[st.i] = math.max(tonumber(u.wins[st.i]) or 0, 1) end
    end
  end
  for key, c in pairs(G.P_CENTERS or {}) do
    if type(c) == "table" and not c.wip then
      if c.set == "Joker" then all_wins(profile.joker_usage, key, c)
      elseif c.set == "Back" and not c.omit then all_wins(profile.deck_usage, key, c)
      elseif c.set == "Voucher" then
        profile.voucher_usage[key] = profile.voucher_usage[key] or {count = 1, order = c.order or 0}
      elseif c.consumeable then
        profile.consumeable_usage[key] = profile.consumeable_usage[key] or {count = 1, order = c.order or 0}
      end
    end
  end
  if G.CHALLENGES then
    profile.challenges_unlocked = #G.CHALLENGES
    for _, ch in pairs(G.CHALLENGES) do
      if type(ch) == "table" and ch.id then profile.challenge_progress.unlocked[ch.id] = true end
    end
  end
  if G.P_LOCKED then for i = #G.P_LOCKED, 1, -1 do G.P_LOCKED[i] = nil end end
  return true
end

