    if type(profile.progression.unlocked_badges) ~= "table" then profile.progression.unlocked_badges = {} end
    safe_unlock_cosmetic(_G.BADGES, profile.progression.unlocked_badges)
    debug_save_and_refresh()
    debug_notify(mod_loc("ALL BADGES UNLOCKED!"))
    print("[DEBUG] All Badges unlocked (cosmetic + boss)")
  end)
end

