          AchievementManager.player_data.achievements[ach_id] = {}
        end
        AchievementManager.player_data.achievements[ach_id].unlocked = true
        AchievementManager.player_data.achievements[ach_id].progress = ach.progress_required or 1
        AchievementManager.player_data.achievements[ach_id].unlock_date = os.time() or 0
      end
      pcall(function() AchievementManager.save_data() end)
    end
    debug_save_and_refresh()
    debug_notify(mod_loc("ALL ACHIEVEMENTS UNLOCKED!"))
    print("[DEBUG] All Achievements unlocked")
  end)
end

-- Unlock Deck Skins (customize deck)
G.FUNCS.debug_unlock_skins = function(e)
  if not DebugManager.is_enabled() then return end
  local profile = get_debug_profile()
  if not profile then return end
  pcall(function()
    if not profile.CUSTOM_DECK then profile.CUSTOM_DECK = {} end
    if not profile.CUSTOM_DECK.Collabs then
      profile.CUSTOM_DECK.Collabs = {Spades='default', Hearts='default', Clubs='default', Diamonds='default'}
    end
    -- Unlock all collab deck skins via ProfileRewardsManager
    if not profile.progression then profile.progression = {} end
    if not profile.progression.unlocked_decks then profile.progression.unlocked_decks = {} end
    if G.COLLABS and G.COLLABS.options then
      local existing = {}
      for _, v in ipairs(profile.progression.unlocked_decks) do existing[v] = true end
      for suit, options in pairs(G.COLLABS.options) do
        for _, collab_key in ipairs(options) do
          if collab_key ~= 'default' and not existing[collab_key] then
            table.insert(profile.progression.unlocked_decks, collab_key)
            existing[collab_key] = true
          end
        end
      end
    end
    debug_save_and_refresh()
    debug_notify(mod_loc("ALL DECK SKINS UNLOCKED!"))
    print("[DEBUG] All Deck Skins unlocked (ProfileRewardsManager)")
  end)
end

-- Helper for cosmetic unlocks
local function safe_unlock_cosmetic(source_table, target_array)
  if not source_table or type(source_table) ~= "table" then return end
  local existing = {}
  for _, v in ipairs(target_array) do existing[v] = true end
  for _, v in pairs(source_table) do
    if type(v) == "table" and v.id and not existing[v.id] then
      table.insert(target_array, v.id)
      existing[v.id] = true
    end
  end
end

-- Unlock Profile Icons (joker-based icons)
G.FUNCS.debug_unlock_icons = function(e)
  if not DebugManager.is_enabled() then return end
  local profile = get_debug_profile()
  if not profile then return end
  pcall(function()
    if not profile.progression then profile.progression = {} end
    if type(profile.progression.unlocked_icons) ~= "table" then profile.progression.unlocked_icons = {} end
    -- Profile icons = joker keys from G.P_CENTER_POOLS.Joker
    local joker_pool = G.P_CENTER_POOLS and G.P_CENTER_POOLS["Joker"]
    if joker_pool then
      local existing = {}
      for _, v in ipairs(profile.progression.unlocked_icons) do existing[v] = true end
      for _, center in ipairs(joker_pool) do
        if center.key and not existing[center.key] then
          table.insert(profile.progression.unlocked_icons, center.key)
          existing[center.key] = true
        end
      end
    end
    debug_save_and_refresh()
    debug_notify(mod_loc("ALL PROFILE ICONS UNLOCKED!"))
    print("[DEBUG] All Profile Icons unlocked (joker-based)")
  end)
end

-- Unlock Badges (cosmetic)
G.FUNCS.debug_unlock_badges = function(e)
  if not DebugManager.is_enabled() then return end
  local profile = get_debug_profile()
