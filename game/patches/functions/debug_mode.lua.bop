-- Create debug menu (after PIN verified) - PAGINATED
local DebugMenuPage = 1

function create_UIBox_debug_menu()
  if not G or not G.C or not G.UIT or not G.ROOM then
    return {n=G.UIT.ROOT, config={align = "cm"}, nodes={}}
  end

  if not DebugManager.is_enabled() then
    return create_UIBox_debug_pin()
