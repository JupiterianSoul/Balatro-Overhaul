-- ===== BUTTON CALLBACKS =====

-- Numpad digit pressed
G.FUNCS.debug_pin_digit = function(e)
  local digit = e.config.ref_value
  if not digit then return end

  if #DebugUI.pin_input < 6 then
    DebugUI.pin_input = DebugUI.pin_input .. digit
    -- Update display with asterisks
    DebugUI.pin_display = string.rep("*", #DebugUI.pin_input) .. string.rep("_", 6 - #DebugUI.pin_input)
    pcall(function() play_sound('button', 0.6, 0.7) end)
  end
end

-- Clear PIN input
G.FUNCS.debug_pin_clear = function(e)
  DebugUI.pin_input = ""
  DebugUI.pin_display = "______"
  pcall(function() play_sound('cancel', 0.8, 0.5) end)
end

-- Submit PIN
G.FUNCS.debug_pin_submit = function(e)
  print("[DEBUG] PIN submitted")

  if pin_ok(DebugUI.pin_input) then
    -- Correct PIN!
    print("[DEBUG] PIN CORRECT! Unlocking debug mode...")
    DebugManager.unlocked = true
    DEBUG_CONFIG.enabled = true

    pcall(function() play_sound('timpani', 1.0, 0.5) end)

    -- Close current menu and open debug menu
    if G and G.FUNCS and G.FUNCS.exit_overlay_menu then
      pcall(function() G.FUNCS.exit_overlay_menu() end)
    end

    -- Open debug menu after short delay
    if G and G.E_MANAGER and Event then
r 1 112 %20%20%20%20%20%20 -
l 5
        trigger = 'after',
        delay = 0.3,
        func = function()
          pcall(function()
            if G.FUNCS and G.FUNCS.overlay_menu then
r 4 1382 %20%20%20%20%20%20%20%20%20%20%20%20%20%20 -
l 18
                definition = create_UIBox_debug_menu()
              }
            end
          end)
          return true
        end
      }))
    end
  else
    -- Wrong PIN!
    print("[DEBUG] PIN INCORRECT!")
    pcall(function() play_sound('cancel', 1.0, 0.5) end)

    -- Flash red and clear
    DebugUI.pin_display = mod_loc("WRONG!")

    -- Clear after delay
    if G and G.E_MANAGER and Event then
r 1 112 %20%20%20%20%20%20 -
l 24
        trigger = 'after',
        delay = 0.8,
        func = function()
          DebugUI.pin_input = ""
          DebugUI.pin_display = "______"
          return true
        end
      }))
    else
      DebugUI.pin_input = ""
      DebugUI.pin_display = "______"
    end
  end
end

