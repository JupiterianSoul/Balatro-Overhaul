G.FUNCS.debug_page_prev = function(e)
  DebugMenuPage = math.max(1, (DebugMenuPage or 1) - 1)
  refresh_debug_menu()
end

G.FUNCS.debug_page_next = function(e)
  DebugMenuPage = math.min(3, (DebugMenuPage or 1) + 1)
  refresh_debug_menu()
end

-- ===== SHOP CONTENT UNLOCK CALLBACKS =====

G.FUNCS.debug_unlock_color_sets = function(e)
  if not DebugManager.is_enabled() then return end
  pcall(function()
    pcall(function() AshCardManager.init() end)
    local profile = G.PROFILES[G.SETTINGS.profile]
    if not profile or not profile.progression then return end
    local prog = profile.progression
    if not prog.owned_color_sets then prog.owned_color_sets = {} end
    local function add_unique(arr, id)
      for _, v in ipairs(arr) do if v == id then return end end
      table.insert(arr, id)
    end
    if SHOP_COLOR_SETS then
      for _, set in ipairs(SHOP_COLOR_SETS) do add_unique(prog.owned_color_sets, set.id) end
    end
    if SHOP_POLYCHROMATIC then add_unique(prog.owned_color_sets, "polychromatic") end
    if G and G.save_progress then G:save_progress() end
    debug_save_and_refresh()
    debug_notify(mod_loc("ALL COLOR SETS UNLOCKED!"))
    print("[DEBUG] All Color Sets unlocked")
  end)
end

G.FUNCS.debug_unlock_icon_effects = function(e)
  if not DebugManager.is_enabled() then return end
  pcall(function()
    pcall(function() AshCardManager.init() end)
    local profile = G.PROFILES[G.SETTINGS.profile]
    if not profile or not profile.progression then return end
    local prog = profile.progression
    if not prog.owned_icon_effects then prog.owned_icon_effects = {} end
    local function add_unique(arr, id)
      for _, v in ipairs(arr) do if v == id then return end end
      table.insert(arr, id)
    end
    if SHOP_ICON_EFFECTS then
      for _, eff in ipairs(SHOP_ICON_EFFECTS) do add_unique(prog.owned_icon_effects, eff.id) end
    end
    if G and G.save_progress then G:save_progress() end
    debug_save_and_refresh()
    debug_notify(mod_loc("ALL ICON EFFECTS UNLOCKED!"))
    print("[DEBUG] All Icon Effects unlocked")
  end)
end

