        G.SETTINGS.ACHIEVEMENTS_EARNED[ach_id] = true
      end
    end
    -- Mod achievements
    if AchievementManager and AchievementManager.achievements and AchievementManager.player_data then
      if not AchievementManager.player_data.achievements then AchievementManager.player_data.achievements = {} end
