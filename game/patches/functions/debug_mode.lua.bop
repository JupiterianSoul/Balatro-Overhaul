-- Unlock All - ULTRA SAFE VERSION V13.0
G.FUNCS.debug_unlock_all = function(e)
  print("\n" .. string.rep("*", 50))
  print("    DEBUG UNLOCK ALL BUTTON PRESSED")
  print(string.rep("*", 50))

  -- Multiple layers of protection
  local success = false
  local err_msg = nil

  -- First check if function even exists
  if type(unlock_all_debug) ~= "function" then
    print("[DEBUG] ERROR - unlock_all_debug function not found!")
    pcall(function() play_sound('cancel', 1.0, 0.5) end)
    return
  end

  print("[DEBUG] unlock_all_debug function exists, calling...")

  -- Call with pcall
  success, err_msg = pcall(function()
    unlock_all_debug()
  end)

  if success then
    print("[DEBUG] SUCCESS - Unlock All completed!")
    pcall(function() play_sound('timpani', 1.0, 0.5) end)

    -- Show success via safe attention_text (do NOT pass cover=true, it must be a UI object or nil)
    pcall(function()
      if attention_text then
        local major = G.ROOM_ATTACH or G.play or G.hand
        if major then
          attention_text{text = mod_loc("ALL CONTENT UNLOCKED!"), scale = 1.5, hold = 3, backdrop_colour = G.C.GREEN, align = 'cm', major = major, offset = {x = 0, y = -2}}
        end
      end
    end)
  else
    print("[DEBUG] FAILED - Unlock All error: " .. tostring(err_msg))
    pcall(function() play_sound('cancel', 1.0, 0.5) end)

    -- Show error notification
    pcall(function()
      if attention_text then
        local major = G.ROOM_ATTACH or G.play or G.hand
        if major then
          attention_text{text = mod_loc("UNLOCK FAILED! Check logs."), scale = 1, hold = 3, backdrop_colour = G.C.RED, align = 'cm', major = major, offset = {x = 0, y = -2}}
        end
      end
    end)
  end

  print(string.rep("*", 50) .. "\n")
end

-- Add Balacoin
G.FUNCS.debug_add_balacoin = function(e)
  if not DebugManager.is_enabled() then
    print("[DEBUG] Debug mode not enabled, cannot add balacoin")
    return
  end

  print("[DEBUG] Adding 10000 Balacoin...")

  -- Direct profile access
  if G and G.PROFILES and G.SETTINGS and G.SETTINGS.profile then
    local profile = G.PROFILES[G.SETTINGS.profile]
    if profile then
      if not profile.progression then profile.progression = {} end
      profile.progression.balacoin = (profile.progression.balacoin or 0) + 10000
      profile.progression.total_balacoin_earned = (profile.progression.total_balacoin_earned or 0) + 10000
      print("[DEBUG] New Balacoin: " .. tostring(profile.progression.balacoin))
      pcall(function() play_sound('coin3', 1.0, 0.5) end)

      -- Save
      pcall(function() G:save_progress() end)
    end
  end
end

-- Add XP
G.FUNCS.debug_ranked_max = function(e)
  if not (BOM_DEBUG_BUILD and DebugManager.is_enabled() and bom_ranked and bom_core) then return end
  local function go()
    bom_ranked.send({type = "ranked_test_set", rp = 3000, all = true})
    pcall(function() play_sound('highlight1', 1.0, 0.5) end)
  end
  if bom_core.is_connected() then go() else bom_core.connect(go, {silent = true}) end
end

G.FUNCS.debug_add_xp = function(e)
  if not DebugManager.is_enabled() then
    print("[DEBUG] Debug mode not enabled, cannot add XP")
    return
  end

  print("[DEBUG] Adding 50000 XP...")

  -- Use award_xp function if available (handles level up)
  if award_xp then
    print("[DEBUG] Using award_xp function")
    award_xp(50000, "debug_bonus")
    pcall(function() play_sound('highlight1', 1.0, 0.5) end)
  else
    -- Fallback: Direct add
    print("[DEBUG] award_xp not found, using direct add")
    if G and G.PROFILES and G.SETTINGS and G.SETTINGS.profile then
      local profile = G.PROFILES[G.SETTINGS.profile]
      if profile then
        if not profile.progression then profile.progression = {} end
        local old_xp = profile.progression.xp or 0
        local old_level = profile.progression.level or 1

        profile.progression.xp = old_xp + 50000
        profile.progression.total_xp = (profile.progression.total_xp or 0) + 50000

        -- Simple level up check
        local xp_per_level = 1000
        while profile.progression.xp >= xp_per_level * (profile.progression.level or 1) do
          profile.progression.xp = profile.progression.xp - (xp_per_level * profile.progression.level)
          profile.progression.level = (profile.progression.level or 1) + 1
          print("[DEBUG] LEVEL UP! New level: " .. tostring(profile.progression.level))
        end

        print("[DEBUG] XP: " .. tostring(old_xp) .. " -> " .. tostring(profile.progression.xp))
        print("[DEBUG] Level: " .. tostring(old_level) .. " -> " .. tostring(profile.progression.level))

        pcall(function() play_sound('highlight1', 1.0, 0.5) end)

        -- Save
        pcall(function() G:save_progress() end)
      end
    end
  end
end

