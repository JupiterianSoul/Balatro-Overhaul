-- Unlock Challenges
G.FUNCS.debug_unlock_challenges = function(e)
  if not DebugManager.is_enabled() then return end
  local profile = get_debug_profile()
  if not profile then return end
  pcall(function()
    if type(profile.challenge_progress) ~= "table" then profile.challenge_progress = {} end
    if type(profile.challenge_progress.unlocked) ~= "table" then profile.challenge_progress.unlocked = {} end
    if type(profile.challenge_progress.completed) ~= "table" then profile.challenge_progress.completed = {} end
    if G.CHALLENGES then
      profile.challenges_unlocked = #G.CHALLENGES
      for _, challenge in pairs(G.CHALLENGES) do
        if challenge.id then
          profile.challenge_progress.unlocked[challenge.id] = true
          profile.challenge_progress.completed[challenge.id] = true
        end
      end
    end
    debug_save_and_refresh()
    debug_notify(mod_loc("ALL CHALLENGES UNLOCKED!"))
    print("[DEBUG] All Challenges unlocked & completed")
  end)
end

