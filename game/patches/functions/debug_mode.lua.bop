-- ===== DEBUG UI =====

local DebugUI = {
  pin_input = "",
  pin_display = "______",
}

-- Create numpad for PIN entry
local function create_debug_numpad()
  local numpad_rows = {
    {"1", "2", "3"},
    {"4", "5", "6"},
    {"7", "8", "9"},
    {"C", "0", "OK"},
  }

  local rows = {}
  for _, row_data in ipairs(numpad_rows) do
    local row_nodes = {}
    for _, digit in ipairs(row_data) do
      local button_color = G.C.GREY
      local button_func = 'debug_pin_digit'

      if digit == "C" then
        button_color = G.C.RED
        button_func = 'debug_pin_clear'
      elseif digit == "OK" then
        button_color = G.C.GREEN
        button_func = 'debug_pin_submit'
      end

      table.insert(row_nodes, {
        n = G.UIT.C,
        config = {
          align = "cm", padding = 0.05, r = 0.1, minw = 0.8, minh = 0.8,
          colour = button_color, button = button_func, hover = true, shadow = true,
          ref_value = digit
        },
        nodes = {
          {n = G.UIT.T, config = {text = digit, scale = 0.45, colour = G.C.WHITE}}
        }
      })
    end
    table.insert(rows, {n = G.UIT.R, config = {align = "cm", padding = 0.03}, nodes = row_nodes})
  end

  return {n = G.UIT.C, config = {align = "cm", padding = 0.1}, nodes = rows}
end

