-- Unlock Stakes (all 13 in G.P_STAKES + profile)
G.FUNCS.debug_unlock_stakes = function(e)
  if not DebugManager.is_enabled() then return end
  local profile = get_debug_profile()
  if not profile then return end
  pcall(function()
    if type(profile.stake_progress) ~= "table" then profile.stake_progress = {} end
    for i = 1, debug_stake_count() do
      profile.stake_progress[i] = true
    end
    if G.P_STAKES then
      for _, stake in pairs(G.P_STAKES) do
        stake.unlocked = true
        stake.discovered = true
        stake.alerted = true
      end
    end
    -- Also mark all decks as having won all stakes
    if type(profile.deck_usage) ~= "table" then profile.deck_usage = {} end
    if G.P_CENTERS then
      for key, center in pairs(G.P_CENTERS) do
        if center.set == 'Back' and not center.omit then
          if not profile.deck_usage[key] then
            profile.deck_usage[key] = {count = 1, order = center.order or 0, wins = {}, losses = {}}
          end
          if not profile.deck_usage[key].wins then profile.deck_usage[key].wins = {} end
          for s = 1, debug_stake_count() do
            profile.deck_usage[key].wins[s] = profile.deck_usage[key].wins[s] or 1
          end
        end
      end
    end
    debug_save_and_refresh()
    debug_notify(mod_loc("ALL STAKES UNLOCKED!"))
    print("[DEBUG] All Stakes unlocked")
  end)
end

-- Set Joker Stake Wins (all 12 stakes for every joker)
G.FUNCS.debug_set_joker_stake_wins = function(e)
  if not DebugManager.is_enabled() then return end
  local profile = get_debug_profile()
  if not profile then return end
  pcall(function()
    if type(profile.joker_usage) ~= "table" then profile.joker_usage = {} end
    if G.P_CENTERS then
      for key, center in pairs(G.P_CENTERS) do
        if center.set == 'Joker' then
          if not profile.joker_usage[key] then
            profile.joker_usage[key] = {count = 1, order = center.order or 0, wins = {}, losses = {}}
          end
          if not profile.joker_usage[key].wins then profile.joker_usage[key].wins = {} end
          for s = 1, debug_stake_count() do
            profile.joker_usage[key].wins[s] = math.max(profile.joker_usage[key].wins[s] or 0, 1)
          end
        end
      end
    end
    debug_save_and_refresh()
    debug_notify(mod_loc("ALL JOKER STAKE WINS SET!"))
    print("[DEBUG] All joker stake wins set (1-12)")
  end)
end

