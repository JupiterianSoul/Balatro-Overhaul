local X = Extras
local KEY = "keyboard_play"
local M = X.feature(KEY, {})
local L = function(s) return mod_loc(s) end

M.GROUPS = {
    {key = "nav", label = "Navigation"},
    {key = "hand", label = "Hand"},
    {key = "cards", label = "Jokers and consumables"},
    {key = "shop", label = "Shop and packs"},
}

M.ACTIONS = {
    {id = "nav_up", group = "nav", key = "up", pad = "dpup", label = "Move up"},
    {id = "nav_down", group = "nav", key = "down", pad = "dpdown", label = "Move down"},
    {id = "nav_left", group = "nav", key = "left", pad = "dpleft", label = "Move left"},
    {id = "nav_right", group = "nav", key = "right", pad = "dpright", label = "Move right"},
    {id = "confirm", group = "nav", key = "space", pad = "a", label = "Press or pick"},
    {id = "back", group = "nav", key = "backspace", pad = "b", label = "Back"},
    {id = "tab_prev", group = "nav", key = "q", pad = "leftshoulder", label = "Previous tab"},
    {id = "tab_next", group = "nav", key = "e", pad = "rightshoulder", label = "Next tab"},
    {id = "run_info", group = "nav", key = "i", label = "Run Info"},
    {id = "play", group = "hand", key = "return", label = "Play or go on"},
    {id = "discard", group = "hand", key = "d", label = "Discard or skip"},
    {id = "sort_rank", group = "hand", key = "x", label = "Sort by rank"},
    {id = "sort_suit", group = "hand", key = "c", label = "Sort by suit"},
    {id = "use", group = "cards", key = "u", label = "Use"},
    {id = "sell", group = "cards", key = "s", label = "Sell"},
    {id = "move_left", group = "cards", key = ",", label = "Move card left"},
    {id = "move_right", group = "cards", key = ".", label = "Move card right"},
    {id = "buy", group = "shop", key = "b", label = "Buy"},
    {id = "buy_use", group = "shop", key = "v", label = "Buy and use"},
    {id = "reroll", group = "shop", key = "t", label = "Reroll"},
}
for i = 1, 10 do
    table.insert(M.ACTIONS, 13 + i, {id = "card" .. i, group = "hand", key = tostring(i % 10), card = i, label = "Card %d", n = i})
end

M.SCAN = {}
M.held = {}

function M.normal(sc)
    if type(sc) ~= "string" then return nil end
    if sc == "kpenter" then return "return" end
    if sc:sub(1, 2) == "kp" and sc:match("^kp%d$") then return sc:sub(3) end
    return sc
end

M.SETS = {}

local function bind_set()
    local name = M.active_set and M.active_set()
    local set = name and M.SETS[name]
    if set then return set.saved, set.keys end
    return "keyboard_binds", nil
end
M.bind_set = bind_set

function M.default_key(a)
    local _, keys = bind_set()
    if keys and keys[a.id] ~= nil then return keys[a.id] or nil end
    return a.key
end

function M.binds()
    local saved = G.SETTINGS and G.SETTINGS[(bind_set())]
    local out = {}
    for _, a in ipairs(M.ACTIONS) do
        local v
        if type(saved) == "table" then v = saved[a.id] end
        if v == false then out[a.id] = nil
        elseif type(v) == "string" then out[a.id] = v
        else out[a.id] = M.default_key(a) end
    end
    return out
end

function M.refresh()
    M.by_scan = {}
    M.by_id = {}
    local b = M.binds()
    for _, a in ipairs(M.ACTIONS) do
        M.by_id[a.id] = a
        local k = b[a.id]
        if k and not M.by_scan[k] then M.by_scan[k] = a end
    end
    M.bound = b
end

function M.action_for(sc)
    if not M.by_scan then M.refresh() end
    return M.by_scan[M.normal(sc)]
end

function M.key_name(sc)
    if not sc then return nil end
    local ok, k = pcall(love.keyboard.getKeyFromScancode, sc)
    if not ok or type(k) ~= "string" or k == "" or k == "unknown" then k = sc end
    local names = {["return"] = "Enter", space = "Space", backspace = "Backspace", up = "Up", down = "Down", left = "kb_left", right = "kb_right",
        tab = "Tab", escape = "Esc", lshift = "Left Shift", rshift = "Right Shift", lctrl = "Left Ctrl", rctrl = "Right Ctrl", lalt = "Left Alt", ralt = "Right Alt",
        pageup = "Page Up", pagedown = "Page Down", home = "Home", ["end"] = "End", insert = "Insert", delete = "Delete"}
    if names[k] then return L(names[k]) end
    if sc:match("^%d$") then return sc end
    if #k == 1 then return k:upper() end
    return k:sub(1, 1):upper() .. k:sub(2)
end

function M.touch_only()
    return UIK and UIK.touch and UIK.touch() or false
end

function M.enabled()
    return X.on(KEY) and not M.touch_only()
end

local function playback()
    local pb = rawget(_G, "bom_playback")
    return pb and pb.active and pb.active()
end

function M.can_nav()
    local c = G.CONTROLLER
    if not (c and M.enabled()) then return false end
    if c.text_input_hook or c.screen_keyboard then return false end
    if playback() then return false end
    return true
end

function M.can_act(ctrl)
    if not M.can_nav() then return false end
    if ctrl and (ctrl.locks and ctrl.locks.frame) then return false end
    if ctrl and ctrl.locked and not G.SETTINGS.paused then return false end
    return true
end

local function visible(node)
    return node and not node.REMOVED and node.states and node.states.visible ~= false and (not node.UIBox or node.UIBox.states.visible ~= false)
end

local function walk(node, names, depth)
    if type(node) ~= "table" or depth > 40 then return nil end
    local cfg = node.config
    if cfg and cfg.button and names[cfg.button] and visible(node) and not node.under_overlay then
        local want = names[cfg.button]
        if want == true or want == cfg.id then return node end
    end
    for _, ch in ipairs(node.children or {}) do
        local hit = walk(ch, names, depth + 1)
        if hit then return hit end
    end
    if cfg and type(cfg.object) == "table" and cfg.object.UIRoot then
        return walk(cfg.object.UIRoot, names, depth + 1)
    end
end

local function find_in(boxes, names)
    for _, box in ipairs(boxes) do
        if type(box) == "table" and box.UIRoot and not box.REMOVED then
            local hit = walk(box.UIRoot, names, 0)
            if hit then return hit end
        end
    end
end
M.find_in = find_in

local function all_boxes()
    if G.OVERLAY_MENU then return {G.OVERLAY_MENU} end
    local list = {}
    for _, b in pairs(G.I.UIBOX or {}) do
        if type(b) == "table" and b.UIRoot and not b.REMOVED and b.states and b.states.visible ~= false then list[#list + 1] = b end
    end
    return list
end

local function press(boxes, names)
    local e = find_in(boxes, names) or (not G.OVERLAY_MENU and find_in(all_boxes(), names))
    if e then e:click() return true end
    return false
end

local function card_boxes(card)
    local list = {}
    if card and card.children then
        for _, ch in pairs(card.children) do
            if type(ch) == "table" and ch.UIRoot then list[#list + 1] = ch end
        end
    end
    return list
end

local function focused_card()
    local f = G.CONTROLLER and G.CONTROLLER.focused and G.CONTROLLER.focused.target
    if f and type(f) == "table" and f.is and Card and f:is(Card) and not f.REMOVED then return f end
end

local function target(areas)
    local p = M.pick_target and M.pick_target(areas)
    if p then return p end
    local f = focused_card()
    for _, a in ipairs(areas) do
        if a and f and f.area == a then return f end
    end
    for _, a in ipairs(areas) do
        if a and a.highlighted and a.highlighted[1] then return a.highlighted[1] end
    end
end

local function find_check(node, funcs, depth)
    if type(node) ~= "table" or depth > 40 or node.REMOVED then return nil end
    if node.UIRoot then return find_check(node.UIRoot, funcs, depth + 1) end
    local cfg = node.config
    if cfg and cfg.func and funcs[cfg.func] then return node end
    for _, ch in pairs(node.children or {}) do
        local hit = find_check(ch, funcs, depth + 1)
        if hit then return hit end
    end
    if cfg and type(cfg.object) == "table" and cfg.object.UIRoot then
        return find_check(cfg.object.UIRoot, funcs, depth + 1)
    end
end

local function press_on_card(areas, funcs)
    local c = target(areas)
    if not c then return false end
    if not c.highlighted and c.area and c.area.highlighted and c.area:can_highlight(c) then c:click() end
    for _, box in ipairs(card_boxes(c)) do
        local e = find_check(box, funcs, 0)
        if e then
            local f = G.FUNCS[e.config.func]
            if type(f) == "function" then pcall(f, e) end
            if e.config.button and not e.disable_button then
                e:click()
                return true
            end
            return false
        end
    end
    return false
end

M.USE = {can_use_consumeable = true, select_button_check = true}
M.SELL = {can_sell_card = true}
M.BUY = {buy_button_check = true, can_redeem = true, can_open = true}
M.BUY_USE = {buy_and_use_button_check = true}

local function in_pack()
    local s, S = G.STATE, G.STATES
    return s == S.TAROT_PACK or s == S.PLANET_PACK or s == S.SPECTRAL_PACK or s == S.STANDARD_PACK or s == S.BUFFOON_PACK or (S.SMODS_BOOSTER_OPENED and s == S.SMODS_BOOSTER_OPENED)
end
M.in_pack = in_pack

local function blind_boxes()
    local list = {}
    local o = G.blind_select_opts
    if o then
        local cur = G.GAME and G.GAME.blind_on_deck and string.lower(G.GAME.blind_on_deck)
        if cur and o[cur] then list[1] = o[cur] end
        for _, k in ipairs({"small", "big", "boss"}) do if o[k] and o[k] ~= list[1] then list[#list + 1] = o[k] end end
    end
    if G.blind_select then list[#list + 1] = G.blind_select end
    if G.blind_prompt_box then list[#list + 1] = G.blind_prompt_box end
    return list
end

local function move_card(c, dir)
    if not (c and c.area and c.area.cards) then return false end
    local cards = c.area.cards
    local i
    for k, v in ipairs(cards) do if v == c then i = k end end
    local j = i and i + dir
    if not (j and cards[j]) then return false end
    cards[i], cards[j] = cards[j], cards[i]
    c.area:set_ranks()
    c.area:align_cards()
    if G.CONTROLLER.HID.controller then G.CONTROLLER:snap_to{node = c}
    elseif M.after_move then pcall(M.after_move, c) end
    play_sound("cardSlide1", 0.85 + math.random() * 0.1)
    return true
end
M.move_card = move_card

local function move(dir)
    local rows = {G.jokers, G.consumeables, G.hand}
    local c = M.pick_target and M.pick_target(rows)
    if not c then
        local f = focused_card()
        for _, a in ipairs(rows) do
            if a and f and f.area == a then c = f end
        end
    end
    c = c or target({G.jokers, G.consumeables})
    if c and c.area == G.hand and G.STATE ~= G.STATES.SELECTING_HAND then return false end
    return move_card(c, dir)
end

local function pick(n)
    if G.STATE == G.STATES.SELECTING_HAND and G.hand and G.hand.cards then
        local card = G.hand.cards[n]
        if card then card:click() end
        return card ~= nil
    end
    if in_pack() and G.pack_cards and G.pack_cards.cards then
        local card = G.pack_cards.cards[n]
        if not card then return false end
        if G.pack_cards:can_highlight(card) then card:click()
        else G.CONTROLLER:snap_to{node = card} end
        return true
    end
    return false
end

M.RUN = {
    play = function()
        if G.OVERLAY_MENU then return false end
        local s, S = G.STATE, G.STATES
        if s == S.SELECTING_HAND then return press({G.buttons}, {play_cards_from_highlighted = true}) end
        if s == S.BLIND_SELECT then return press(blind_boxes(), {select_blind = true, bom_toggle_ready_blind = true}) end
        if s == S.ROUND_EVAL then return press({G.round_eval}, {cash_out = true}) end
        if s == S.SHOP then return press({G.shop}, {toggle_shop = true}) end
        if in_pack() then return press_on_card({G.pack_cards}, M.USE) end
        return false
    end,
    discard = function()
        if G.OVERLAY_MENU then return false end
        local s, S = G.STATE, G.STATES
        if s == S.SELECTING_HAND then return press({G.buttons}, {discard_cards_from_highlighted = true}) end
        if s == S.BLIND_SELECT then return press(blind_boxes(), {skip_blind = true}) end
        if in_pack() then return press(all_boxes(), {skip_booster = true}) end
        return false
    end,
    sort_rank = function()
        if G.OVERLAY_MENU or G.STATE ~= G.STATES.SELECTING_HAND then return false end
        return press({G.buttons}, {sort_hand_value = true})
    end,
    sort_suit = function()
        if G.OVERLAY_MENU or G.STATE ~= G.STATES.SELECTING_HAND then return false end
        return press({G.buttons}, {sort_hand_suit = true})
    end,
    use = function()
        if G.OVERLAY_MENU then return false end
        return press_on_card({G.consumeables, G.pack_cards}, M.USE)
    end,
    sell = function()
        if G.OVERLAY_MENU then return false end
        return press_on_card({G.jokers, G.consumeables}, M.SELL)
    end,
    move_left = function()
        if G.OVERLAY_MENU then return false end
        return move(-1)
    end,
    move_right = function()
        if G.OVERLAY_MENU then return false end
        return move(1)
    end,
    buy = function()
        if G.OVERLAY_MENU or G.STATE ~= G.STATES.SHOP then return false end
        return press_on_card({G.shop_jokers, G.shop_vouchers, G.shop_booster}, M.BUY)
    end,
    buy_use = function()
        if G.OVERLAY_MENU or G.STATE ~= G.STATES.SHOP then return false end
        return press_on_card({G.shop_jokers}, M.BUY_USE)
    end,
    reroll = function()
        if G.OVERLAY_MENU then return false end
        if G.STATE == G.STATES.SHOP then return press({G.shop}, {reroll_shop = true}) end
        if G.STATE == G.STATES.BLIND_SELECT then return press(blind_boxes(), {reroll_boss = true}) end
        return false
    end,
    run_info = function()
        if G.OVERLAY_MENU or G.STAGE ~= G.STAGES.RUN or not G.FUNCS.run_info then return false end
        G.FUNCS.run_info({config = {}})
        return true
    end,
}

function M.handle(key, ctrl)
    local sc = M.SCAN[key] or key
    local a = M.action_for(sc)
    if not a or a.pad or not M.can_act(ctrl) then return false end
    if a.card then
        if G.OVERLAY_MENU then return false end
        return pick(a.card)
    end
    local fn = M.RUN[a.id]
    if fn then return fn() and true or false end
    return false
end

local function menu_back()
    local reg = G.CONTROLLER.button_registry and G.CONTROLLER.button_registry.b
    local r = reg and reg[1]
    local t = r and r.node and r.node.T
    local plain = r and r.node and r.node.config and r.node.config.button == "exit_overlay_menu"
    return r and r.node and not r.node.REMOVED and not plain and r.menu == (G.OVERLAY_MENU ~= nil) and t and G.ROOM
        and t.x > -2 and t.x < G.ROOM.T.w + 2 and t.y > -2 and t.y < G.ROOM.T.h + 2 or false
end

local function jump_up()
    local f = focused_card()
    if G.OVERLAY_MENU or not (f and G.hand and f.area == G.hand) then return false end
    local best, bd
    for _, area in ipairs({G.jokers, G.consumeables}) do
        for _, c in ipairs(area and area.cards or {}) do
            local d = math.abs((c.T.x + c.T.w / 2) - (f.T.x + f.T.w / 2))
            if not bd or d < bd then best, bd = c, d end
        end
    end
    if not best then return false end
    M.from_kb = true
    G.CONTROLLER:set_HID_flags("button", "dpup")
    M.from_kb = nil
    G.CONTROLLER:snap_to{node = best}
    return true
end
M.jump_up = jump_up

M.REPLAY = {confirm = "pb_pause", play = "pb_pause", discard = "pb_step_hand", nav_left = "pb_prev_action", nav_right = "pb_next_action", tab_prev = "pb_speed", tab_next = "pb_ff"}

function M.replay_key(sc)
    if not (playback() and M.enabled()) then return false end
    local c = G.CONTROLLER
    if G.OVERLAY_MENU or c.text_input_hook or c.screen_keyboard then return false end
    local bar = G.PB_BAR
    local a = M.action_for(sc)
    local fn = a and M.REPLAY[a.id]
    if not (fn and bar and not bar.REMOVED) then return false end
    local e = find_in({bar}, {[fn] = true})
    if e then e:click() else pcall(play_sound, "cancel") end
    return true
end

function M.yields(key)
    local mg = rawget(_G, "Minigames")
    return mg and mg.wants_key and mg.wants_key(key) or false
end

function M.pad_press(sc)
    local a = M.action_for(sc)
    if not (a and M.can_nav()) then return false end
    if a.id == "nav_up" and jump_up() then return true end
    local pad = a.pad or (a.id == "play" and G.OVERLAY_MENU and "a")
    if not pad then return false end
    if pad == "b" and G.OVERLAY_MENU and not menu_back() then
        pcall(G.CONTROLLER.key_press_update, G.CONTROLLER, "escape")
        return true
    end
    M.held[sc] = pad
    M.from_kb = true
    local ok, err = pcall(love.gamepadpressed, G.CONTROLLER.keyboard_controller, pad)
    M.from_kb = nil
    if not ok then print("[KeyboardPlay] " .. tostring(err)) end
    return true
end

function M.pad_release(sc)
    local pad = M.held[sc]
    if not pad then return false end
    M.held[sc] = nil
    M.from_kb = true
    pcall(love.gamepadreleased, G.CONTROLLER.keyboard_controller, pad)
    M.from_kb = nil
    return true
end

function M.on_toggle(v)
    if not v then
        for sc in pairs(M.held) do M.pad_release(sc) end
    end
end

function M.init()
    if M._wrapped or not (Controller and Controller.key_press_update) then return end
    M._wrapped = true
    M.refresh()
    G.ESC_BACK_FUNCS = G.ESC_BACK_FUNCS or {}
    G.ESC_BACK_FUNCS.kb_binds_back = true
    local lkp = love.keypressed
    if type(lkp) == "function" then
        love.keypressed = function(key, scancode, isrepeat, ...)
            if type(key) == "string" then M.SCAN[key] = scancode end
            if M.capture and scancode and M.capture_key(scancode, isrepeat) then return end
            if scancode and not isrepeat and M.replay_key(scancode) then return end
            if scancode and not M.yields(key) and M.pad_press(scancode) then return end
            M.key_event = true
            lkp(key, scancode, isrepeat, ...)
            M.key_event = nil
        end
    end
    local lkr = love.keyreleased
    if type(lkr) == "function" then
        love.keyreleased = function(key, scancode, ...)
            if scancode and M.pad_release(scancode) then return end
            M.key_event = true
            lkr(key, scancode, ...)
            M.key_event = nil
        end
    end
    local orig = Controller.key_press_update
    Controller.key_press_update = function(self, key, dt)
        if X.on(KEY) then pcall(M.handle, key, self) end
        return orig(self, key, dt)
    end
    local hid = Controller.set_HID_flags
    Controller.set_HID_flags = function(self, kind, button)
        if kind == "mouse" and M.key_event and self.HID.keyboard then return end
        hid(self, kind, button)
        if kind == "button" then self.HID.keyboard = M.from_kb or nil
        elseif kind then self.HID.keyboard = nil end
    end
    local pip = G.FUNCS.set_button_pip
    if type(pip) == "function" then
