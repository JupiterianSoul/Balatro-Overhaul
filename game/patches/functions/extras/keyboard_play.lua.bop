end

M.TABS = {
    {key = "nav", label = "Navigation"},
    {key = "hand", label = "Hand"},
    {key = "cards", label = "Cards"},
    {key = "shop", label = "Shop"},
}
M.ui = {}
M.KEY_W = 2.6
M.ROW_H = 0.62

function M.action_label(a)
    if a.n then return string.format(L(a.label), a.n) end
    return L(a.label)
end

local function save_binds()
    if G and G.save_settings then pcall(function() G:save_settings() end) end
end

function M.set_bind(id, sc)
    sc = M.normal(sc)
    if not (sc and M.by_id and M.by_id[id]) then return nil end
    local skey = bind_set()
    local saved = type(G.SETTINGS[skey]) == "table" and G.SETTINGS[skey] or {}
    G.SETTINGS[skey] = saved
    M.refresh()
    local moved
    for _, a in ipairs(M.ACTIONS) do
        if a.id ~= id and M.bound[a.id] == sc then
            saved[a.id] = false
            moved = a
        end
    end
    saved[id] = sc
    M.refresh()
    save_binds()
    return moved
end

function M.reset_binds()
    G.SETTINGS[(bind_set())] = nil
    M.capture = nil
    M.refresh()
    save_binds()
end

local function page_open()
    return G.OVERLAY_MENU and UIK and UIK._win and UIK._win.id == "kb_binds" and G.OVERLAY_MENU:get_UIE_by_ID("uik_body") ~= nil
end

local function redraw(focus_id)
    if not page_open() then return end
    UIK.refresh()
    local b = focus_id and G.OVERLAY_MENU:get_UIE_by_ID("kb_bind_" .. focus_id)
    if b and G.CONTROLLER.HID.controller then G.CONTROLLER:snap_to{node = b} end
end

function M.capture_key(sc, isrepeat)
    local id = M.capture
    if not page_open() then M.capture = nil return false end
    if isrepeat then return true end
    M.capture = nil
    sc = M.normal(sc)
    if sc == "escape" then
        M.ui.notice = nil
    else
        local moved = M.set_bind(id, sc)
        M.ui.notice = moved and string.format(L("%s moved from %s"), M.key_name(sc), M.action_label(moved)) or nil
    end
    play_sound("button", 1, 0.4)
    redraw(id)
    return true
end

local function bind_row(a, w, lw)
    local k = M.bound and M.bound[a.id]
    local cap = M.capture == a.id
    local text = cap and L("Press a key") or (k and M.key_name(k) or L("Unbound"))
    local colour = cap and UIK.C.warn or (k and UIK.C.accent or UIK.C.inactive)
    local h = M.ROW_H
    local node = {n = G.UIT.R, config = {align = "cm", minw = w, minh = h + 0.1, padding = 0}, nodes = {
        {n = G.UIT.C, config = {align = "cr", minw = lw, maxw = lw, minh = h, padding = 0}, nodes = {
            {n = G.UIT.T, config = {text = M.action_label(a), scale = 0.4, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
        }},
        {n = G.UIT.C, config = {align = "cm", minw = 0.25, minh = h, padding = 0}, nodes = {}},
        UIK.button{label = text, button = "kb_bind_pick", ref_table = a, colour = colour, w = M.KEY_W, h = h, scale = 0.4, col = true, id = "kb_bind_" .. a.id},
    }}
    node.uik_h = h + 0.1
    return node
end

local function group_body(group)
    M.refresh()
    local list = {}
    for _, a in ipairs(M.ACTIONS) do if a.group == group then list[#list + 1] = a end end
    local cw = UIK.col_w(2)
    local inner = cw - 2 * UIK.PAD
    local lw = 0
    for _, a in ipairs(M.ACTIONS) do lw = math.max(lw, UIK.text_w(M.action_label(a), 0.4)) end
    lw = math.min(lw + 0.1, inner - M.KEY_W - 0.45)
    local per = math.ceil(#list / 2)
    local cols = {{}, {}}
    for i, a in ipairs(list) do table.insert(cols[i <= per and 1 or 2], bind_row(a, inner, lw)) end
    local note_h = 0.5
    local line = M.ui.notice or L("Pick an action, then press its new key. Esc cancels.")
    return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, padding = 0}, nodes = {
        {n = G.UIT.C, config = {align = "tm", padding = 0}, nodes = {
            UIK.columns(cols, {h = UIK.H - UIK.TOP - note_h, cards = true}),
            {n = G.UIT.R, config = {align = "cm", minw = UIK.W, minh = note_h, padding = 0}, nodes = {
                {n = G.UIT.T, config = {text = line, scale = 0.32, colour = M.ui.notice and UIK.C.title or UIK.C.muted}},
            }},
        }},
    }}
end

M.group_body = group_body

function M.page()
    local tabs = {}
    for _, t in ipairs(M.TABS) do
        tabs[#tabs + 1] = {key = t.key, label = L(t.label), build = function() return group_body(t.key) end}
    end
    return UIK.window{
        id = "kb_binds",
        title = L("KEYBOARD KEYS"),
        tabs = tabs,
        footer = {{label = L("Reset to defaults"), button = "kb_binds_reset", colour = UIK.C.danger}},
        back_func = "kb_binds_back",
    }
end

G.FUNCS.open_keyboard_binds = function()
    if not M.enabled() then return end
    M.capture = nil
    M.ui.notice = nil
r 13 1381 %20%20%20%20 -
l 66
    G.FUNCS.overlay_menu{definition = M.page()}
end

G.FUNCS.kb_bind_pick = function(e)
    local a = e and e.config and e.config.ref_table
    if not (a and a.id) then return end
    M.capture = M.capture ~= a.id and a.id or nil
    M.ui.notice = nil
    redraw(a.id)
end

G.FUNCS.kb_binds_reset = function()
    M.reset_binds()
    M.ui.notice = L("Every key is back to its default")
    redraw()
end

G.FUNCS.kb_binds_back = function(e)
    M.capture = nil
    M.ui.notice = nil
    G.FUNCS.settings(e)
end

local function register_new(t)
    local out = {}
    for lang, entries in pairs(t) do
        out[lang] = {}
        local have = MOD_TRANSLATIONS and MOD_TRANSLATIONS[lang] or {}
        for k, v in pairs(entries) do if have[k] == nil then out[lang][k] = v end end
    end
    mod_loc_register(out)
end

