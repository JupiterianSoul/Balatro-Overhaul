  ["- Or: Options > Mod Menu tab"] = "- O: Opciones > Pestaña Menú Mod",
  ["- God Mode: Auto-win when out of hands"] = "- Modo Dios: Victoria auto sin manos",
  ["- Win Blind: Instantly beat current blind"] = "- Ganar Ciega: Ganar ciega actual",
  ["- +Hand/+Discard: Add extra hands or discards"] = "- +Mano/+Desc: Añadir manos o descartes",
  ["- Add Money: Use slider to pick amount"] = "- Añadir dinero: Usar cursor para cantidad",
  ["- Slot Buttons: +1 joker/consumable/hand size"] = "- Botones Ranura: +1 comodín/consumible/tamaño",
  ["- Negative Joker: Add without using a slot"] = "- Comodín Negativo: Añadir sin ranura",
  ["- Soul Card: Creates a legendary joker"] = "- Carta Alma: Crea un comodín legendario",
  ["- +Level: Level up all poker hand types"] = "- +Nivel: Subir todas las manos de póker",
  ["WARNING: Using cheats marks the run as MODDED."] = "AVISO: Los trucos marcan la partida como MODIFICADA.",
  ["Modded runs do NOT earn XP or quest progress!"] = "¡Las partidas modificadas NO ganan XP ni progreso!",

  ["- Play menu > 'Custom' tab"] = "- Menú Jugar > Pestaña 'Perso.'",
  ["BASIC SETTINGS:"] = "AJUSTES BÁSICOS:",
  ["- Starting hands and discards"] = "- Manos y descartes iniciales",
  ["- Win ante (how many antes to beat)"] = "- Apuesta inicial de victoria (cuántas superar)",
  ["- Starting money amount"] = "- Cantidad de dinero inicial",
  ["SLOTS:"] = "RANURAS:",
  ["- Joker slots (1-10), consumable slots"] = "- Ranuras de comodín (1-10), consumibles",
  ["- Hand size override"] = "- Tamaño de mano personalizado",
  ["DECK:"] = "BARAJA:",
  ["- Deck size from 20 to 156 cards"] = "- Tamaño de baraja de 20 a 156 cartas",
  ["- Card enhancements and editions"] = "- Mejoras y ediciones de cartas",
  ["PRESETS:"] = "PREAJUSTES:",
  ["- Quick configs: Balanced, Chaos, Easy, Hard"] = "- Configs rápidas: Equilibrado, Caos, Fácil, Difícil",
  ["- Press START CUSTOM RUN to begin!"] = "- ¡Pulsar INICIAR PARTIDA PERSO. para empezar!",
  ["Custom runs do NOT count for progression."] = "Las partidas perso. NO cuentan para la progresión.",

  ["XP SOURCES:"] = "FUENTES DE XP:",
  ["- Win a run: 500-5000 XP (scales with stake)"] = "- Ganar: 500-5000 XP (según el pozo)",
  ["- Complete antes: 50-500 XP each"] = "- Completar apuestas iniciales: 50-500 XP cada una",
  ["- Play hands: Small XP per hand played"] = "- Jugar manos: Poco XP por mano",
  ["- Complete quests: Bonus XP rewards"] = "- Completar misiones: Bonus XP",
  ["LEVEL SYSTEM:"] = "SISTEMA DE NIVEL:",
  ["- Levels 1 to 500"] = "- Niveles 1 a 500",
  ["- Each level requires more XP than the last"] = "- Cada nivel requiere más XP",
  ["- Leveling unlocks cosmetics and titles"] = "- Subir de nivel desbloquea cosméticos y títulos",
  ["RANK TIERS:"] = "RANGOS:",
  ["Novice > Bronze > Silver > Gold"] = "Novato > Bronce > Plata > Oro",
  ["Platinum > Diamond > Master > Grand Master"] = "Platino > Diamante > Maestro > Gran Maestro",
  ["Celestial (highest rank)"] = "Celestial (rango más alto)",
  ["ANTI-CHEAT:"] = "ANTI-TRAMPAS:",
  ["Modded and seeded runs earn ZERO XP!"] = "¡Partidas modificadas/seeded ganan CERO XP!",
  ["Only clean, unseeded runs count."] = "Solo cuentan las partidas limpias.",

  ["QUEST TYPES:"] = "TIPOS DE MISIONES:",
  ["- Daily: 40+ quests, reset every 24 hours"] = "- Diarias: 40+, se reinician cada 24 horas",
  ["- Weekly: 30+ quests, reset every 7 days"] = "- Semanales: 30+, se reinician cada 7 días",
  ["- Repeatable: 20+ quests, always available"] = "- Repetibles: 20+, siempre disponibles",
  ["- Main menu > 'Quests' button"] = "- Menú principal > Botón 'Misiones'",
  ["- View active, completed, claimable quests"] = "- Ver misiones activas, completadas, reclamables",
  ["QUEST EXAMPLES:"] = "EJEMPLOS DE MISIONES:",
  ["- Win 3 runs, Play 50 hands, Earn $500"] = "- Ganar 3 partidas, Jugar 50 manos, Ganar $500",
  ["- Use 10 Tarot cards, Beat Ante 8"] = "- Usar 10 cartas de tarot, superar la apuesta inicial 8",
  ["- Buy 5 jokers, Discard 30 cards"] = "- Comprar 5 comodines, Descartar 30 cartas",
  ["REWARDS:"] = "RECOMPENSAS:",
  ["- XP bonuses: 100 to 2000+"] = "- Bonos XP: 100 a 2000+",
  ["- Balacoin currency: 50 to 500+"] = "- Moneda Balacoin: 50 a 500+",
  ["- Claim rewards in the Quests menu!"] = "- ¡Reclamar en el menú de Misiones!",
  ["Seeded/modded runs don't count!"] = "¡Las partidas seeded/modificadas no cuentan!",

  ["COSMETIC TYPES:"] = "TIPOS DE COSMÉTICOS:",
  ["- Titles: 50+ display names (e.g. 'Legend')"] = "- Títulos: 50+ nombres (ej. 'Leyenda')",
  ["- Banners: 30+ profile backgrounds"] = "- Banners: 30+ fondos de perfil",
  ["- Badges: 30+ profile icons"] = "- Insignias: 30+ iconos de perfil",
  ["- Borders: 20+ frame styles"] = "- Bordes: 20+ estilos de marco",
  ["HOW TO UNLOCK:"] = "CÓMO DESBLOQUEAR:",
  ["- Level up to unlock specific items"] = "- Subir de nivel para desbloquear objetos",
  ["- Reach new ranks for exclusive rewards"] = "- Alcanzar nuevos rangos para recompensas exclusivas",
  ["- Purchase with Balacoin in the Shop"] = "- Comprar con Balacoin en la Tienda",
  ["- Complete achievements for rare items"] = "- Completar logros para objetos raros",
  ["EQUIPPING:"] = "EQUIPAR:",
  ["- Main menu > Profile to view and equip"] = "- Menú principal > Perfil para ver y equipar",
  ["- Change title, banner, badge, and border"] = "- Cambiar título, banner, insignia y borde",
  ["- Cosmetics are saved per profile"] = "- Los cosméticos se guardan por perfil",

  ["CURRENCY: BALACOIN"] = "MONEDA: BALACOIN",
