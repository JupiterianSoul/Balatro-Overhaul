  ["- Spent on cosmetic items in the shop"] = "- Gastada en cosméticos en la tienda",
  ["SHOP CATEGORIES:"] = "CATEGORÍAS DE LA TIENDA:",
  ["- Titles: 500 - 5,000 Balacoin"] = "- Títulos: 500 - 5.000 Balacoin",
