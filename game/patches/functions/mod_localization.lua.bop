function mod_loc(english_text)
  if not english_text then return "" end
  local lang = (G and G.SETTINGS and G.SETTINGS.language) or "en-us"
  if lang ~= _mod_loc_cached_lang then
    _mod_loc_cache = {}
    _mod_loc_cached_lang = lang
  end
  local cached = _mod_loc_cache[english_text]
  if cached then return cached end
  local result
  if lang == "en-us" then
    local en_t = MOD_TRANSLATIONS["en-us"]
    result = (en_t and en_t[english_text]) or english_text
  else
    local lookup_lang = lang
    if lang == "es_ES" or lang == "es_419" then lookup_lang = "es" end
    local t = MOD_TRANSLATIONS[lookup_lang]
    if t and t[english_text] then
      result = t[english_text]
    else
      local en_t = MOD_TRANSLATIONS["en-us"]
      result = (en_t and en_t[english_text]) or english_text
    end
  end
  if type(result) == 'string' and result:find("\226\128\148", 1, true) then
    result = result:gsub(" ?\226\128\148 ?", " - ")
  end
  _mod_loc_cache[english_text] = result
  return result
end

function mod_loc_register(t)
  for lang, entries in pairs(t or {}) do
    MOD_TRANSLATIONS[lang] = MOD_TRANSLATIONS[lang] or {}
    for k, v in pairs(entries) do
      MOD_TRANSLATIONS[lang][k] = v
    end
  end
  _mod_loc_cache = {}
end

