function score_time(t)
    if G.SETTINGS and G.SETTINGS.skip_score_animation then return 0 end
    return (t or 0) * ((G.SETTINGS and G.SETTINGS.fast_score_resolve) or 1.0)
end

function score_delay(t)
    if G.SETTINGS and G.SETTINGS.skip_score_animation then return end
    delay(score_time(t))
end

