local function footer_sig(m)
  return tostring(m.ws_pages) .. ":" .. tostring(m.ws_page)
end

G.FUNCS.workshop_net_line = function(e)
  local m = M()
  if not m then return end
  local text, colour = net_line()
  if text ~= m.ws_net_text then m.ws_net_text = text end
  e.config.colour = colour
end

local function replace_object(e, def)
r 4 1218 %20%20 -
l 132
  e.config.object = UIBox{definition = def, config = {offset = {x = 0, y = 0}, parent = e}}
end

local function set_grid(e)
  if not (e and e.config and e.config.object) then return end
  local m = M()
  replace_object(e, W.grid_def())
  local footer = e.UIBox:get_UIE_by_ID('workshop_footer')
  if footer and m.ws_footer_keep then
    m.ws_footer_keep = nil
    footer.config.ws_sig = footer_sig(m)
  end
  if footer and footer.config.object and footer.config.ws_sig ~= footer_sig(m) then
    footer.config.ws_sig = footer_sig(m)
    replace_object(footer, W.footer_def())
  end
  e.UIBox:recalculate()
end

function W.rebuild_grid()
  M().ws_dirty = true
end

G.FUNCS.workshop_watch = function(e)
  local m = M()
  if not m then return end
  local now = love.timer.getTime()
  if m.search ~= m.ws_last_search then
    m.ws_last_search = m.search
    m.ws_search_at = now + 0.3
  end
  if m.ws_search_at and now >= m.ws_search_at then
    m.ws_search_at = nil
    m.ws_page = 1
    m.ws_dirty = true
  end
  if W.changed then W.changed = false; m.ws_dirty = true end
  if W.thumbs_changed and now - (m.ws_thumb_at or 0) > 0.4 then
    W.thumbs_changed = false
    m.ws_thumb_at = now
    m.ws_dirty = true
  end
  if m.ws_dirty then
    m.ws_dirty = false
    m.ws_gen = (m.ws_gen or 0) + 1
  end
  if e.config.ws_gen ~= m.ws_gen then
    e.config.ws_gen = m.ws_gen
    set_grid(e)
  end
end

G.FUNCS.workshop_page = function(args)
  if not (args and args.cycle_config) then return end
  M().ws_page = args.cycle_config.current_option
  M().ws_footer_keep = true
  M().ws_dirty = true
end

G.FUNCS.workshop_sort = function(args)
  if not (args and args.cycle_config) then return end
  M().ws_sort = args.cycle_config.current_option
  M().ws_page = 1
  M().ws_dirty = true
end

G.FUNCS.workshop_show = function(args)
  if not (args and args.cycle_config) then return end
  M().ws_show = args.cycle_config.current_option
  M().ws_page = 1
  M().ws_dirty = true
end

local function walk(node, fn)
  if not node then return end
  fn(node)
  for _, c in pairs(node.children or {}) do walk(c, fn) end
end

G.FUNCS.workshop_cat = function(e)
  local ref = e and e.config and e.config.ref_table
  if not ref then return end
  M().ws_cat = ref.i
  M().ws_page = 1
  M().ws_dirty = true
  local box = e.UIBox
  W.later(function()
    walk(box and box.UIRoot, function(v)
      if v.config and v.config.button == 'workshop_cat' and v.config.ref_table then
        v.config.chosen = (v.config.ref_table.i == M().ws_cat) and 'vert' or nil
      end
    end)
  end, 1)
end

G.FUNCS.workshop_refresh = function(e)
  W.refresh(true)
  M().ws_dirty = true
end

