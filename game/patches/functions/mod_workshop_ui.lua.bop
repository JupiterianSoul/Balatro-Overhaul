local function thumb_node(entry, w, h)
  local atlas = W.thumb(entry) or placeholder_atlas(entry)
  if atlas then
    G.ASSET_ATLAS[atlas.name] = atlas
    local sprite = Sprite(0, 0, w, h, atlas, {x = 0, y = 0})
    sprite.states.drag.can = false
    sprite.states.hover.can = false
    sprite.states.collide.can = false
    sprite:define_draw_steps({{shader = 'dissolve'}})
    return {n=G.UIT.R, config={align = "cm", r = 0.08, colour = G.C.BLACK, minw = w, minh = h}, nodes={
      {n=G.UIT.O, config={object = sprite}},
    }}
  end
  local c = cat_colour(entry.categories and entry.categories[1])
  return {n=G.UIT.R, config={align = "cm", r = 0.08, colour = darken(c, 0.35), minw = w, minh = h, emboss = 0.04}, nodes={}}
end

local function pill(text, colour, scale)
  return {n=G.UIT.C, config={align = "cm", r = 0.08, colour = colour, minw = text_w(text, scale) + 0.2, minh = scale + 0.16}, nodes={
    {n=G.UIT.T, config={text = text, scale = scale, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
  }}
end

local function compat_label(entry, long)
  local cs, reason, _, pname = W.compat_for(entry)
  if not cs then return nil end
  local base = cs == "ok" and "Tested" or cs == "issue" and "Known issue" or "Does not work"
  local colour = cs == "ok" and G.C.GREEN or cs == "issue" and G.C.ORANGE or G.C.RED
  return long and (loc(base .. " on") .. " " .. pname) or loc(base), colour, reason, cs
end
W.compat_label = compat_label

local function compat_pill(entry, scale, maxw, long)
  local text, colour = compat_label(entry, long)
  if not text then return nil end
  if not long then text = string.upper(text) end
  local t, sc = fit(text, scale, maxw - 0.2, scale * 0.75)
  return pill(t, colour, sc)
end

local function badge_info(entry)
  local s, st = W.entry_status(entry)
  if s == "busy" then
    local p = st.total and st.total > 0 and math.floor(100 * st.got / st.total) or nil
    return st.stage == "install" and loc("Installing") or (p and (p .. "%") or loc("Downloading")), G.C.BLUE
  elseif s == "deps" then
    return string.upper(loc("Needs mods")), G.C.ORANGE
  elseif s == "installed" then
    if not W.entry_enabled(entry) then return string.upper(loc("Off")), G.C.UI.BACKGROUND_INACTIVE end
    return string.upper(loc("Installed")), G.C.GREEN
  elseif s == "update" then
    return string.upper(loc("Update")), G.C.ORANGE
  elseif s == "builtin" then
    return string.upper(loc("Built in")), G.C.UI.BACKGROUND_INACTIVE
  elseif s == "none" and W.link_broken(entry) then
    return string.upper(loc("Broken link")), G.C.RED
  elseif st and st.stage == "error" then
    return loc("Failed"), G.C.RED
  end
end

local function status_pill(entry, scale)
  local text, colour = badge_info(entry)
  if not text then return nil end
  local ref = {entry = entry, text = text}
  return {n=G.UIT.C, config={align = "cm", r = 0.08, colour = colour, minw = math.max(text_w(text, scale), text_w("100%", scale)) + 0.2, minh = scale + 0.16,
    func = 'workshop_badge', ref_table = ref}, nodes={
    {n=G.UIT.T, config={ref_table = ref, ref_value = 'text', scale = scale, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
  }}
end

G.FUNCS.workshop_badge = function(e)
  local ref = e.config.ref_table
  if not (ref and ref.entry) then return end
  local text, colour = badge_info(ref.entry)
  if text and text ~= ref.text then ref.text = text end
  if colour then e.config.colour = colour end
end

local function card(entry)
  local k = CARD_K
  local tw = CARD_W - 0.16
  local th = math.min(tw * 9 / 16, CARD_H - 1.04 * k - 0.45)
  local badge = status_pill(entry, 0.24 * k)
  local cw = badge and tw / 2 or tw * 0.9
  local compat = compat_pill(entry, 0.24 * k, cw)
  local title, title_scale = fit(clean_text(entry.title), 0.36 * k, tw - 0.1, 0.28 * k)
  local author, author_scale = fit(loc("by") .. " " .. clean_text(entry.author), 0.26 * k, tw - 0.1, 0.22 * k)
  return {n=G.UIT.C, config={align = "tm", padding = 0.06}, nodes={
    {n=G.UIT.R, config={align = "tm", minw = CARD_W, maxw = CARD_W, minh = CARD_H, r = 0.1, padding = 0.08, colour = G.C.BLACK, emboss = 0.05,
      hover = true, shadow = true, button = "workshop_open", ref_table = {key = entry.key}}, nodes={
      {n=G.UIT.R, config={align = "cm", minw = tw}, nodes={thumb_node(entry, th * 16 / 9, th)}},
      {n=G.UIT.R, config={align = "cm", minh = 0.42 * k, maxw = tw}, nodes={
        {n=G.UIT.T, config={text = title, scale = title_scale, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
      }},
      {n=G.UIT.R, config={align = "cm", minh = 0.26 * k, maxw = tw}, nodes={
        {n=G.UIT.T, config={text = author, scale = author_scale, colour = G.C.UI.TEXT_INACTIVE}},
      }},
      {n=G.UIT.R, config={align = "cm", minh = 0.36 * k}, nodes={
        {n=G.UIT.C, config={align = "cl", minw = cw, maxw = cw}, nodes={
          compat or {n=G.UIT.T, config={text = entry.version ~= "" and clean_text(entry.version) or " ", scale = 0.26 * k, colour = G.C.GOLD, maxw = tw / 2 - 0.05}},
        }},
        {n=G.UIT.C, config={align = "cr", minw = tw - cw}, nodes={badge}},
      }},
    }},
  }}
end

local function matches(entry, q, cat, show)
  if cat then
    local found = false
    for _, c in ipairs(entry.categories or {}) do if c == cat then found = true end end
    if not found then return false end
  end
  if show ~= 1 then
    local s = W.entry_status(entry)
    if show == 2 and not (s == "installed" or s == "update" or s == "builtin") then return false end
    if show == 3 and s ~= "update" then return false end
  end
  if q ~= "" then
    local hay = entry._hay
    if not hay then
      hay = (entry.title .. " " .. entry.author .. " " .. entry.key .. " " .. table.concat(entry.categories or {}, " ")):lower()
      entry._hay = hay
    end
    for word in q:gmatch("%S+") do
      if not hay:find(word, 1, true) then return false end
    end
  end
  return true
end

function W.filtered()
  local idx = W.load_index()
  local m = M()
  local q = tostring(m.search or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
  local cat = CATEGORIES[m.ws_cat or 1].key
  local show = m.ws_show or 1
  local list = {}
  for _, e in ipairs(idx.mods) do
    if matches(e, q, cat, show) then list[#list + 1] = e end
  end
  local sort = m.ws_sort or 1
  table.sort(list, function(a, b)
    if sort == 1 and (a.updated or 0) ~= (b.updated or 0) then return (a.updated or 0) > (b.updated or 0) end
    local f = SORT_FIELD[sort]
    if f and (a[f] or -1) ~= (b[f] or -1) then return (a[f] or -1) > (b[f] or -1) end
    if sort == 3 then
      local x, y = a.author:lower(), b.author:lower()
      if x ~= y then return x < y end
    end
    local x, y = a.title:lower(), b.title:lower()
    if x ~= y then return x < y end
    return a.key < b.key
  end)
  return list
end

local function net_line()
  local idx = W.load_index()
  if W.net.refreshing then
    local p = W.net.refresh_progress
    return loc("Updating the list...") .. (p and (" " .. math.floor(p * 100) .. "%") or ""), G.C.UI.TEXT_LIGHT
  end
  if W.net.failed then return loc("Offline: saved list"), G.C.RED end
  local t = idx.refreshed or idx.built
  return loc("Mod list from") .. " " .. os.date("%Y-%m-%d", t or 0), G.C.UI.TEXT_INACTIVE
end

function W.grid_def()
  local m = M()
  local list = W.filtered()
  m.ws_count = #list
  local pages = math.max(1, math.ceil(#list / PAGE_SIZE))
  m.ws_pages = pages
  m.ws_page = math.min(math.max(1, m.ws_page or 1), pages)
  m.ws_count_text = #list .. " " .. loc("mods")
  local rows = {}
  local first = (m.ws_page - 1) * PAGE_SIZE
  for r = 1, ROWS do
    local cols = {}
    for c = 1, COLS do
      local e = list[first + (r - 1) * COLS + c]
      if e then
        cols[#cols + 1] = card(e)
      else
        cols[#cols + 1] = {n=G.UIT.C, config={align = "cm", minw = CARD_W + 0.28, minh = CARD_H + 0.28}, nodes={}}
      end
    end
    rows[#rows + 1] = {n=G.UIT.R, config={align = "cm"}, nodes=cols}
  end
  if #list == 0 then
    rows = {{n=G.UIT.R, config={align = "cm", minw = COLS * (CARD_W + 0.28), minh = ROWS * (CARD_H + 0.28)}, nodes={
