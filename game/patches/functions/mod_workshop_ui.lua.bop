local function segments(key_fn, n, w)
  local nodes = {}
  local seg_w = (w - (n - 1) * 0.04) / n
  for i = 1, n do
    nodes[#nodes + 1] = {n=G.UIT.C, config={align = "cm", minw = seg_w, minh = 0.18, r = 0.04, colour = G.C.UI.BACKGROUND_INACTIVE,
      func = 'workshop_seg', ref_table = {i = i, n = n, get = key_fn}}, nodes={}}
    if i < n then nodes[#nodes + 1] = {n=G.UIT.C, config={minw = 0.04}, nodes={}} end
  end
  return {n=G.UIT.R, config={align = "cm"}, nodes=nodes}
end
W.segments = segments

G.FUNCS.workshop_seg = function(e)
  local ref = e.config.ref_table
  local p = ref.get and ref.get() or 0
  local lit
  if p < 0 then
    local head = math.floor(love.timer.getTime() * 10) % (ref.n + 3)
    lit = ref.i <= head and ref.i > head - 3
  else
    lit = p >= (ref.i - 0.5) / ref.n
  end
  e.config.colour = lit and G.C.GREEN or G.C.UI.BACKGROUND_INACTIVE
end

local function fmt_mb(b)
  return string.format("%.1f MB", (b or 0) / 1048576)
end

local function entry_progress(entry)
  local st = W.state[entry.key]
  if not st then return 0 end
  if st.stage == "done" then return 1 end
  if st.stage == "install" then return 1 end
  if st.stage == "download" then
    if st.total and st.total > 0 then return math.min(1, st.got / st.total) end
    return -1
  end
  return 0
end

local function status_text(entry)
  local st = W.state[entry.key]
  if not st then return "" end
  if st.stage == "download" then
    if st.total and st.total > 0 then
      return loc("Downloading") .. " " .. math.floor(100 * st.got / st.total) .. "%  (" .. fmt_mb(st.got) .. " / " .. fmt_mb(st.total) .. ")"
    end
    return loc("Downloading") .. "  " .. fmt_mb(st.got)
  elseif st.stage == "install" then
    return loc("Installing") .. "..."
  elseif st.stage == "error" then
    return loc("Failed") .. ": " .. tostring(st.err or "")
  elseif st.stage == "done" then
    local L = rawget(_G, "MODLOADER")
    return (L and L.modded) and loc("Restart to apply") or loc("Installed")
  end
  return ""
end

local LEFT_W = 5.4
local ACT_H = 3.9
local MENU_KEY = 'mods_menu'
W.MENU_KEY = MENU_KEY

function W.show(def)
  G.FUNCS.overlay_menu({definition = def, key = MENU_KEY})
end

local function action_button(label, button, colour, w, ref)
  return UIBox_button({button = button, label = {label}, colour = colour, minw = w, minh = _G._IS_DESKTOP and 0.7 or 0.85, scale = 0.42, col = true, ref_table = ref})
end

local function button_row(...)
  return {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={...}}
end

local function local_loaded_note(entry)
  local L = rawget(_G, "MODLOADER")
  if not (L and L.modded) then return nil end
  local m = W.find_local(entry)
  if m and m.enabled ~= m.loaded then return loc("Restart to apply") end
end

local function page_status(entry)
  local st = W.state[entry.key]
  if st and st.stage == "done" then return local_loaded_note(entry) or loc("Installed") end
  if st and st.stage ~= "deps" and st.stage ~= "warn" then return status_text(entry) end
  return local_loaded_note(entry) or ""
end

local function dep_parts(deps)
  local parts = {}
  for _, d in ipairs(deps) do
    local name = clean_text(d.name) .. (d.range and (" " .. d.range) or "")
    if d.wrong and not d.have then
      name = name .. " (" .. loc("you have") .. " " .. clean_text(tostring(d.wrong.version or "?")):gsub("^[vV]", "") .. ")"
      if d.index_has then
        name = name .. " (" .. loc("Workshop has") .. " " .. clean_text(tostring(d.index_has)):gsub("^[vV]", "") .. ")"
      elseif not d.entry and not d.fixed then name = name .. " (" .. loc("not in the Workshop") .. ")" end
    elseif d.index_has then
      name = name .. " (" .. loc("Workshop has") .. " " .. clean_text(tostring(d.index_has)):gsub("^[vV]", "") .. ")"
    elseif not (d.entry or d.have) then
      name = name .. " (" .. loc("not in the Workshop") .. ")"
    end
    parts[#parts + 1] = name
  end
  return parts
end

local function dep_names(deps)
  return table.concat(dep_parts(deps), ", ")
end

local function actions_def(entry)
  local m = M()
  local s, st = W.entry_status(entry)
  local ref = {key = entry.key}
  local w = LEFT_W
  local half = (w - 0.12) / 2
  local rows = {}
  if s == "builtin" then
    rows[#rows + 1] = button_row(action_button(loc("Built in"), 'nil', G.C.UI.BACKGROUND_INACTIVE, w, ref))
  elseif s == "busy" then
    rows[#rows + 1] = button_row(action_button(st.stage == "install" and loc("Installing") or loc("Downloading"), 'nil', G.C.UI.BACKGROUND_INACTIVE, w, ref))
    if st.stage == "download" then
      rows[#rows + 1] = button_row(action_button(loc("Cancel"), 'workshop_cancel', G.C.RED, w, ref))
    end
  elseif s == "deps" then
    local parts = dep_parts(st.deps or {})
    if #parts > 4 then
      local extra = #parts - 3
      for i = #parts, 4, -1 do parts[i] = nil end
      parts[4] = "+" .. extra .. " " .. loc("more")
    end
    rows[#rows + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.4}, nodes={
      {n=G.UIT.T, config={text = loc("This mod needs") .. ":", scale = 0.36, colour = G.C.ORANGE, shadow = true}},
    }}
    for _, part in ipairs(parts) do
      local line, line_scale = fit(part, 0.32, w - 0.1, 0.26)
      rows[#rows + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.3}, nodes={
        {n=G.UIT.T, config={text = line, scale = line_scale, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
      }}
    end
    rows[#rows + 1] = {n=G.UIT.R, config={minh = 0.08}, nodes={}}
    rows[#rows + 1] = button_row(
      action_button(loc("Install all"), 'workshop_deps_yes', G.C.GREEN, half, ref),
      {n=G.UIT.C, config={minw = 0.12}, nodes={}},
      action_button(loc("Cancel"), 'workshop_deps_no', G.C.RED, half, ref))
  elseif s == "warn" then
    local pname = select(4, W.compat_for(entry))
    local head, head_scale = fit(loc("Does not work on") .. " " .. tostring(pname), 0.36, w - 0.1, 0.28)
    rows[#rows + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.4}, nodes={
      {n=G.UIT.T, config={text = head, scale = head_scale, colour = G.C.RED, shadow = true}},
    }}
    local lines = wrap(clean_text(tostring(st.reason or "")), 0.3, w - 0.1)
    for i = 1, math.min(#lines, 4) do
      rows[#rows + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.28}, nodes={
        {n=G.UIT.T, config={text = lines[i], scale = 0.3, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
      }}
    end
    rows[#rows + 1] = {n=G.UIT.R, config={minh = 0.08}, nodes={}}
    rows[#rows + 1] = button_row(
      action_button(loc("Install anyway"), 'workshop_warn_yes', G.C.ORANGE, half, ref),
      {n=G.UIT.C, config={minw = 0.12}, nodes={}},
      action_button(loc("Cancel"), 'workshop_warn_no', G.C.RED, half, ref))
  elseif s == "none" and W.nexus_page(entry) then
    rows[#rows + 1] = button_row(action_button(loc("Open on Nexus Mods"), 'workshop_open_nexus', G.C.BLUE, w, ref))
    for _, line in ipairs(wrap(loc("nexus_note"), 0.3, w - 0.1)) do
      rows[#rows + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.28}, nodes={
        {n=G.UIT.T, config={text = line, scale = 0.3, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
      }}
    end
  elseif s == "none" and W.link_broken(entry) then
    rows[#rows + 1] = button_row(action_button(loc("Download link broken"), 'nil', G.C.UI.BACKGROUND_INACTIVE, w, ref))
  elseif s == "none" then
    rows[#rows + 1] = button_row(action_button(loc("Install"), 'workshop_install', G.C.GREEN, w, ref))
  else
    if s == "update" then
      rows[#rows + 1] = button_row(action_button(loc("Update"), 'workshop_install', G.C.ORANGE, w, ref))
    end
    if W.entry_enabled(entry) then
      rows[#rows + 1] = button_row(action_button(loc("Disable"), 'workshop_disable', G.C.UI.BACKGROUND_INACTIVE, w, ref))
    else
      rows[#rows + 1] = button_row(action_button(loc("Enable"), 'workshop_enable', G.C.GREEN, w, ref))
    end
    rows[#rows + 1] = button_row(action_button(loc("Uninstall"), 'workshop_uninstall', G.C.RED, w, ref))
  end
  if entry.repo and entry.repo:match("^https?://") then
    rows[#rows + 1] = button_row(action_button(loc("Open page"), 'workshop_open_repo', G.C.BLUE, w, ref))
  end
  if st and st.stage ~= "deps" and st.stage ~= "warn" then
    rows[#rows + 1] = {n=G.UIT.R, config={align = "cm", padding = 0.06}, nodes={segments(function() return entry_progress(entry) end, 20, w)}}
  else
    rows[#rows + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.3}, nodes={}}
  end
  m.ws_status = page_status(entry)
  rows[#rows + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.32}, nodes={
    {n=G.UIT.T, config={ref_table = m, ref_value = 'ws_status', scale = 0.3, colour = G.C.UI.TEXT_LIGHT, maxw = w}},
  }}
  return {n=G.UIT.ROOT, config={align = "tm", colour = G.C.CLEAR, minw = w, minh = ACT_H}, nodes={
    {n=G.UIT.C, config={align = "tm"}, nodes=rows},
  }}
end

local function actions_sig(entry)
  local s, st = W.entry_status(entry)
  local L = rawget(_G, "MODLOADER")
  local lm = s ~= "none" and s ~= "busy" and W.find_local(entry)
  return s .. tostring(st and st.stage) .. tostring(st and st.deps and #st.deps) .. tostring(lm and W.entry_enabled(entry))
    .. tostring(lm and lm.loaded) .. tostring(L and L.modded)
end

local function notes_def(entry)
  local right_w = DESC_W + 0.3
  local notes = {}
  local lm = select(3, W.entry_status(entry))
  if lm and lm.version then
    notes[#notes + 1] = loc("Installed") .. ": v" .. clean_text(tostring(lm.version)):gsub("^[vV]", "")
  end
  local deps = W.deps_for(entry)
  local missing = false
  if #deps > 0 then
    for _, d in ipairs(deps) do if d.missing then missing = true end end
    notes[#notes + 1] = loc("Needs") .. ": " .. dep_names(deps)
  end
  local text = #notes > 0 and table.concat(notes, "   ") or " "
  local scale
  text, scale = fit(text, 0.28, right_w, 0.22)
  return {n=G.UIT.ROOT, config={align = "cl", colour = G.C.CLEAR, minw = right_w, minh = 0.3}, nodes={
    {n=G.UIT.T, config={text = text, scale = scale, colour = missing and G.C.ORANGE or G.C.GREEN}},
  }}
end

local function notes_sig(entry)
  local s, _, lm = W.entry_status(entry)
  local parts = {s, tostring(lm and lm.version)}
  for _, d in ipairs(W.deps_for(entry)) do parts[#parts + 1] = d.id .. tostring(d.missing) end
  return table.concat(parts, "|")
end

local function thumb_def(entry)
  return {n=G.UIT.ROOT, config={align = "cm", colour = G.C.CLEAR}, nodes={thumb_node(entry, LEFT_W, LEFT_W * 9 / 16)}}
end

local function thumb_sig(entry)
  local t = W.thumbs[entry.key]
  return tostring(t ~= nil and t ~= false and t ~= "loading")
end

local BOXES = {
  thumb = {def = thumb_def, sig = thumb_sig},
  actions = {def = actions_def, sig = actions_sig},
  notes = {def = notes_def, sig = notes_sig},
}

function W.poke()
  W.poke_gen = (W.poke_gen or 0) + 1
end

local function box_node(kind, entry, align)
  local b = BOXES[kind]
  local object = UIBox{definition = b.def(entry), config = {offset = {x = 0, y = 0}}}
  return {n=G.UIT.R, config={align = align or "cm"}, nodes={
    {n=G.UIT.O, config={func = 'workshop_box', ws_box = kind, ws_entry = entry, ws_sig = b.sig(entry), ws_poke = W.poke_gen, object = object}},
  }}
end

G.FUNCS.workshop_box = function(e)
  local m = M()
  local entry = m and m.ws_entry
  if not entry or e.config.ws_entry ~= entry or not e.config.object then return end
  if e.config.ws_box == "actions" then m.ws_status = page_status(entry) end
  local now = love.timer.getTime()
  if e.config.ws_poke == W.poke_gen and (e.config.ws_at or 0) > now then return end
  e.config.ws_poke = W.poke_gen
  e.config.ws_at = now + 0.2
  local b = BOXES[e.config.ws_box]
  if e.config.ws_box == "thumb" then W.thumb(entry) end
  local sig = b.sig(entry)
  if sig == e.config.ws_sig then return end
  e.config.ws_sig = sig
r 4 1218 %20%20 -
l 11
  e.config.object = UIBox{definition = b.def(entry), config = {offset = {x = 0, y = 0}, parent = e}}
  e.UIBox:recalculate()
end

function W.mod_page(entry)
  local m = M()
  m.ws_entry = entry
  local right_w = DESC_W + 0.3

  local left = {n=G.UIT.C, config={align = "tm", minw = LEFT_W}, nodes={
    box_node("thumb", entry),
r 15 6188 %20%20%20%20 -
l 84
    box_node("actions", entry),
  }}

  local pills = {}
  local compat = compat_pill(entry, 0.28, right_w / 2, true)
  if compat then
    pills[#pills + 1] = compat
    pills[#pills + 1] = {n=G.UIT.C, config={minw = 0.08}, nodes={}}
  end
  local _, compat_colour, compat_reason, compat_status = compat_label(entry)
  local reason_row
  if compat_status and compat_status ~= "ok" and compat_reason and compat_reason ~= "" then
    local rtext = clean_text(compat_reason)
    local rs = 0.28
    local rlines = wrap(rtext, rs, right_w - 0.1)
    if #rlines > 2 then
      rs = 0.22
      rlines = wrap(rtext, rs, right_w - 0.1)
    end
    local reason_nodes = {}
    for i = 1, math.min(#rlines, 2) do
      local line = rlines[i]
      if i == 2 and #rlines > 2 then line = fit(line .. "...", rs, right_w - 0.1, rs) end
      reason_nodes[#reason_nodes + 1] = {n=G.UIT.R, config={align = "cm", minh = rs + 0.04}, nodes={
        {n=G.UIT.T, config={text = line, scale = rs, colour = compat_colour}},
      }}
    end
    reason_row = {n=G.UIT.R, config={align = "cm", minw = right_w}, nodes={
      {n=G.UIT.C, config={align = "cm"}, nodes=reason_nodes},
    }}
  end
  if entry.version ~= "" then
    pills[#pills + 1] = pill("v" .. clean_text(entry.version):gsub("^[vV]", ""), G.C.GOLD, 0.28)
    pills[#pills + 1] = {n=G.UIT.C, config={minw = 0.08}, nodes={}}
  end
  for _, c in ipairs(entry.categories or {}) do
    pills[#pills + 1] = pill(cat_text(c), cat_colour(c), 0.28)
    pills[#pills + 1] = {n=G.UIT.C, config={minw = 0.08}, nodes={}}
  end

  local desc = strip_markdown(entry.desc or "")
  if desc == "" then desc = clean_text(entry.title) end
  local lines = wrap(desc, DESC_SCALE, DESC_W - 0.1)
  local pages = math.max(1, math.ceil(#lines / DESC_LINES))
  m.ws_desc_page = math.min(math.max(1, m.ws_desc_page or 1), pages)
  local desc_rows = {}
  local first = (m.ws_desc_page - 1) * DESC_LINES
  for i = first + 1, math.min(first + DESC_LINES, #lines) do
    desc_rows[#desc_rows + 1] = {n=G.UIT.R, config={align = "cl", minh = DESC_LINE_H}, nodes={
      {n=G.UIT.T, config={text = lines[i] ~= "" and lines[i] or " ", scale = DESC_SCALE, colour = G.C.UI.TEXT_LIGHT}},
    }}
  end
  local desc_pages = {}
  for i = 1, pages do desc_pages[i] = localize('k_page') .. ' ' .. i .. '/' .. pages end

  local page_title, page_title_scale = fit(clean_text(entry.title), 0.6, right_w, 0.4)
  local source_names = {}
  for i, name in ipairs(W.source_names(entry)) do source_names[i] = loc(name) end
  local right = {n=G.UIT.C, config={align = "tl", minw = right_w}, nodes={
    {n=G.UIT.R, config={align = "cl", minh = 0.6}, nodes={
      {n=G.UIT.T, config={text = page_title, scale = page_title_scale, colour = G.C.WHITE, shadow = true}},
    }},
    {n=G.UIT.R, config={align = "cl", minh = 0.36}, nodes={
      {n=G.UIT.T, config={text = loc("by") .. " " .. clean_text(entry.author), scale = 0.34, colour = G.C.UI.TEXT_LIGHT, maxw = right_w}},
    }},
    {n=G.UIT.R, config={align = "cl", minh = 0.32}, nodes={
      {n=G.UIT.T, config={text = (#source_names > 1 and loc("Sources") or loc("Source")) .. ": " .. table.concat(source_names, ", "), scale = 0.3, colour = G.C.UI.TEXT_LIGHT, maxw = right_w}},
    }},
    {n=G.UIT.R, config={align = "cl", padding = 0.04}, nodes=pills},
    reason_row or {n=G.UIT.R, config={}, nodes={}},
    box_node("notes", entry, "cl"),
    {n=G.UIT.R, config={align = "tl", colour = G.C.BLACK, r = 0.1, emboss = 0.05, padding = 0.12, minw = right_w, minh = DESC_LINES * DESC_LINE_H + 0.24}, nodes={
      {n=G.UIT.C, config={align = "tl"}, nodes=desc_rows},
    }},
    pages > 1 and {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      create_option_cycle({options = desc_pages, w = 3, h = 0.45, scale = 0.65, opt_callback = 'workshop_desc_page',
        current_option = m.ws_desc_page, colour = G.C.RED, no_pips = true}),
    }} or nil,
  }}

  if port() then
    return create_UIBox_generic_options({
      back_func = 'workshop_back',
      contents = {
r 15 246 %20%20%20%20%20%20%20%20 -
l 1
          {n=G.UIT.R, config={align = "cm"}, nodes={left}},
r 15 722 %20%20%20%20%20%20%20%20%20%20 -
l 8
          {n=G.UIT.R, config={align = "cm"}, nodes={right}},
        }},
      },
    })
  end
  return create_UIBox_generic_options({
    back_func = 'workshop_back',
    contents = {
r 15 1648 %20%20%20%20%20%20 -
l 88
        left,
        {n=G.UIT.C, config={minw = 0.3}, nodes={}},
        right,
      }},
    },
  })
end

G.FUNCS.workshop_desc_page = function(args)
  if not (args and args.cycle_config) then return end
  M().ws_desc_page = args.cycle_config.current_option
  local entry = M().ws_entry
  if entry then W.show(W.mod_page(entry)) end
end

local function entry_from(e)
  local ref = e and e.config and e.config.ref_table
  local idx = W.load_index()
  return ref and ref.key and idx.by_key[ref.key]
end

G.FUNCS.workshop_open = function(e)
  local entry = entry_from(e)
  if not entry then return end
  M().ws_desc_page = 1
  W.show(W.mod_page(entry))
end

G.FUNCS.workshop_back = function(e)
  M().ws_entry = nil
  M().tab = "workshop"
  W.invalidate_local()
  W.show(create_UIBox_mods_menu())
end

local function entry_action(fn)
  return function(e)
    local entry = entry_from(e)
    if not entry then return end
    fn(entry)
    W.poke()
  end
end

G.FUNCS.workshop_install = entry_action(function(entry) W.request_install(entry) end)
G.FUNCS.workshop_deps_yes = entry_action(function(entry) W.deps_answer(entry, true) end)
G.FUNCS.workshop_deps_no = entry_action(function(entry) W.deps_answer(entry, false) end)
G.FUNCS.workshop_warn_yes = entry_action(function(entry) W.warn_answer(entry, true) end)
G.FUNCS.workshop_warn_no = entry_action(function(entry) W.warn_answer(entry, false) end)
G.FUNCS.workshop_enable = entry_action(function(entry) W.enable_entry(entry, true) end)
G.FUNCS.workshop_disable = entry_action(function(entry) W.enable_entry(entry, false) end)
G.FUNCS.workshop_uninstall = entry_action(function(entry) W.uninstall(entry) end)
G.FUNCS.workshop_cancel = entry_action(function(entry) W.cancel(entry) end)

G.FUNCS.workshop_open_nexus = function(e)
  local entry = entry_from(e)
  local page = entry and W.nexus_page(entry)
  if page then love.system.openURL(page) end
end

G.FUNCS.workshop_open_repo = function(e)
  local entry = entry_from(e)
  if entry and entry.repo and entry.repo:match("^https?://") then love.system.openURL(entry.repo) end
end

function W.required_def(req)
  local rows = {}
  for _, row in ipairs(req.rows) do
    rows[#rows + 1] = {n=G.UIT.R, config={align = "cm", padding = 0.05}, nodes={
      {n=G.UIT.R, config={align = "cm", r = 0.1, colour = G.C.BLACK, emboss = 0.05, padding = 0.1, minw = 9}, nodes={
        {n=G.UIT.C, config={align = "cl", minw = 3.6, maxw = 3.6}, nodes={
          {n=G.UIT.T, config={text = clean_text(row.name), scale = 0.4, colour = G.C.UI.TEXT_LIGHT, shadow = true, maxw = 3.6}},
        }},
        {n=G.UIT.C, config={align = "cl", minw = 1.4, maxw = 1.4}, nodes={
          {n=G.UIT.T, config={text = row.version and ("v" .. clean_text(row.version):gsub("^[vV]", "")) or "", scale = 0.3, colour = G.C.GOLD, maxw = 1.4}},
        }},
        {n=G.UIT.C, config={align = "cm", minw = 3.6}, nodes={
          {n=G.UIT.R, config={align = "cm"}, nodes={segments(function() return W.row_progress(row) end, 12, 3.4)}},
          {n=G.UIT.R, config={align = "cm", minh = 0.3}, nodes={
            {n=G.UIT.T, config={ref_table = row, ref_value = 'status', scale = 0.28, colour = G.C.UI.TEXT_LIGHT, maxw = 3.4}},
          }},
        }},
      }},
    }}
  end
  return create_UIBox_generic_options({
    no_back = true,
    contents = {
r 15 723 %20%20%20%20%20%20 -
l 3
        {n=G.UIT.T, config={text = loc("Installing required mods"), scale = 0.55, colour = G.C.WHITE, shadow = true}},
      }},
      {n=G.UIT.R, config={align = "cm"}, nodes=rows},
r 15 723 %20%20%20%20%20%20 -
l 15
        UIBox_button({button = 'workshop_required_cancel', label = {loc("Cancel")}, colour = G.C.RED, minw = 4, minh = 0.7, scale = 0.45}),
      }},
    },
  })
end

G.FUNCS.workshop_required_cancel = function(e)
  W.cancel_required()
end

function W.open_required_ui(req)
  G.FUNCS.overlay_menu({definition = W.required_def(req), key = G.OVERLAY_MENU and G.OVERLAY_MENU_KEY or 'mods_required'})
end

function W.close_required_ui(req, ok)
