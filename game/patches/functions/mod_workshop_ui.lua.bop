local W = ModWorkshop
local loc = W.loc

local SIDE_W = 3.0
local CARD_W, CARD_H = 3.0, 3.0
local COLS, ROWS = 3, 2
local PAGE_SIZE = COLS * ROWS
local CARD_K = 1
local DESC_LINES = 13
local DESC_W = 7.0
local DESC_SCALE = 0.3
local DESC_LINE_H = 0.33

W.TAB_W = SIDE_W + COLS * (CARD_W + 0.12) + 0.4
W.TAB_H = 7.5

local function port() return rawget(_G, 'UIK') ~= nil and UIK.portrait() or false end

function W.layout()
  if port() then
    local top = G.MODS_MENU and G.MODS_MENU.mp_only and 0.8 or 0
    SIDE_W = 7.8
    W.TAB_W = 7.9
    COLS, ROWS = 2, 2
    PAGE_SIZE = COLS * ROWS
    CARD_W = (W.TAB_W - 0.1) / COLS - 0.28
    CARD_H = 3.0
    W.TAB_H = 12.6 - top
    CARD_K = math.max(1, math.min(CARD_W / 3, CARD_H / 2.3))
    DESC_SCALE = 0.33
    DESC_LINE_H = 0.36
    DESC_W = 7.4
    return
  end
  COLS, ROWS = 3, 2
  PAGE_SIZE = COLS * ROWS
  local uw, uh, ui = 21, 11.8, 1
  if love.graphics and G.TILESIZE and G.window_prev and ui_size_fit then
    local w, h = love.graphics.getDimensions()
    local ts = G.TILESIZE * ui_size_fit(w, h)
    uw, uh, ui = w / ts, h / ts, G.UI_SIZE or 1
  end
  SIDE_W = _G._IS_DESKTOP == false and 4.2 or 3.0
  local fill = window_fill and window_fill() or 0.85
  W.TAB_W = math.max(SIDE_W + 9.76, math.min(18.5, uw * fill - 0.9, uw * 0.97 / ui - 0.9))
  local top = G.MODS_MENU and G.MODS_MENU.mp_only and 0.8 or 0
  W.TAB_H = math.max(7.5 - top, math.min(10, uh * fill - 3.3 - top, uh * 0.97 / ui - 3.3 - top))
  local grid_w = W.TAB_W - SIDE_W - 0.55
  CARD_W = grid_w / COLS - 0.28
  CARD_H = (W.TAB_H - 0.9) / ROWS - 0.28
  CARD_K = math.max(1, math.min(CARD_W / 3, CARD_H / 2.3))
  local kd = math.max(1, math.min(1.3, W.TAB_H / 7.5))
  DESC_SCALE = 0.3 * kd
  DESC_LINE_H = 0.33 * kd
  DESC_W = W.TAB_W - 5.4 - 0.9
end

local CATEGORIES = {
  {key = nil, label = "All categories"},
  {key = "Content", label = "Content"},
  {key = "Joker", label = "Joker"},
  {key = "Quality of Life", label = "Quality of Life"},
  {key = "Technical", label = "Technical"},
  {key = "Resource Packs", label = "Resource Packs"},
  {key = "API", label = "API"},
  {key = "Extension", label = "Extension"},
  {key = "Miscellaneous", label = "Miscellaneous"},
}

local CAT_TEXT = {
  fr = {["Content"] = "Contenu", ["Joker"] = "Jokers", ["Quality of Life"] = "Confort", ["Technical"] = "Technique",
    ["Resource Packs"] = "Packs de textures", ["Extension"] = "Extension", ["Miscellaneous"] = "Divers", ["API"] = "API"},
  es = {["Content"] = "Contenido", ["Joker"] = "Comodín", ["Quality of Life"] = "Comodidad", ["Technical"] = "Técnico",
    ["Resource Packs"] = "Packs de texturas", ["Extension"] = "Extensión", ["Miscellaneous"] = "Varios", ["API"] = "API"},
}

local function cat_text(c)
  local lang = G.SETTINGS and G.SETTINGS.language or "en-us"
  if lang == "es_ES" or lang == "es_419" then lang = "es" end
  return (CAT_TEXT[lang] and CAT_TEXT[lang][c]) or loc(c)
end

local function cat_colour(c)
  if c == "Content" then return G.C.RED end
  if c == "Joker" then return G.C.SECONDARY_SET.Planet end
  if c == "Quality of Life" then return G.C.GREEN end
  if c == "Technical" then return G.C.BLUE end
  if c == "Resource Packs" then return G.C.PURPLE end
  if c == "API" then return G.C.GOLD end
  if c == "Extension" then return G.C.ORANGE end
  return G.C.GREY
end

local SORTS = {"Updated", "Name", "Author", "Most popular", "Most downloaded", "Most liked"}
local SORT_FIELD = {[4] = "pop", [5] = "downloads", [6] = "likes"}
local SHOWS = {"All", "Installed", "Updates"}

local function M() return G.MODS_MENU end

local function text_w(s, scale)
  local f = G.LANG.font
  local ok, w = pcall(f.FONT.getWidth, f.FONT, s)
  if not ok then
    local t = s:gsub("[\128-\255]+", function(run) return run:match("^[\194-\244][\128-\191]*") and "?" or "" end)
    w = f.FONT:getWidth(t)
  end
  return w * f.squish * scale * f.FONTSCALE / G.TILESIZE
end

local function fit(s, scale, maxw, min_scale)
  local w = text_w(s, scale)
  if w <= maxw then return s, scale end
  local s2 = math.max(min_scale, scale * maxw / w)
  if text_w(s, s2) <= maxw then return s, s2 end
  local cut = #s
  while cut > 1 and text_w(s:sub(1, cut) .. "...", s2) > maxw do cut = cut - 1 end
  while cut > 1 and s:byte(cut + 1) and s:byte(cut + 1) >= 128 and s:byte(cut + 1) < 192 do cut = cut - 1 end
  return s:sub(1, cut):gsub("%s+$", "") .. "...", s2
end

local EM_DASH = "\226\128\148"
local EN_DASH = "\226\128\147"

local function clean_text(s)
  s = tostring(s or "")
  s = s:gsub(EM_DASH, "-"):gsub(EN_DASH, "-")
  s = s:gsub("\226\128\152", "'"):gsub("\226\128\153", "'"):gsub("\226\128\156", '"'):gsub("\226\128\157", '"')
  s = s:gsub("\226\128\162", "-"):gsub("\226\128\166", "...")
  s = s:gsub("[\240-\247][\128-\191][\128-\191][\128-\191]", "")
  s = s:gsub("[\224-\239][\128-\191][\128-\191]", "")
  s = s:gsub("\r", "")
  return s
end
W.clean_text = clean_text

local function strip_markdown(md)
  local s = clean_text(md)
  s = s:gsub("<!%-%-.-%-%->", "")
  s = s:gsub("```[^\n]*", "")
  s = s:gsub("!%[[^%]]*%]%([^%)]*%)", "")
  s = s:gsub("%[!%[[^%]]*%]%([^%)]*%)%]%([^%)]*%)", "")
  s = s:gsub("%[([^%]]*)%]%([^%)]*%)", "%1")
  s = s:gsub("<br%s*/?>", "\n")
  s = s:gsub("<[^>\n]+>", "")
  s = s:gsub("&nbsp;", " "):gsub("&amp;", "&"):gsub("&lt;", "<"):gsub("&gt;", ">"):gsub("&quot;", '"')
  local out = {}
  for line in (s .. "\n"):gmatch("([^\n]*)\n") do
    line = line:gsub("^%s*#+%s*", "")
    line = line:gsub("^%s*>%s?", "")
    line = line:gsub("^(%s*)[%*%-%+]%s+", "%1- ")
    line = line:gsub("%*%*", ""):gsub("__", ""):gsub("`", "")
    line = line:gsub("(%s)%*(%S)", "%1%2"):gsub("(%S)%*(%s)", "%1%2"):gsub("^%*(%S)", "%1"):gsub("(%S)%*$", "%1")
    line = line:gsub("^%s*|?%s*:?%-%-+.*$", "")
    line = line:gsub("%s+$", "")
    if line:match("^%s*[-=_*]+%s*$") then line = "" end
    out[#out + 1] = line
  end
  s = table.concat(out, "\n"):gsub("\n\n\n+", "\n\n"):gsub("^\n+", ""):gsub("\n+$", "")
  return s
end
W.strip_markdown = strip_markdown

local function wrap(text, scale, maxw)
  local lines = {}
  for para in (text .. "\n"):gmatch("([^\n]*)\n") do
    if para == "" then
      if #lines > 0 and lines[#lines] ~= "" then lines[#lines + 1] = "" end
    else
      local indent = para:match("^(%s*%- )") and "  " or ""
      local cur = ""
      for word in para:gmatch("%S+") do
        local try = cur == "" and word or (cur .. " " .. word)
        if text_w(try, scale) <= maxw or cur == "" then
          cur = try
          while text_w(cur, scale) > maxw and #cur > 1 do
            local cut = #cur
            while cut > 1 and text_w(cur:sub(1, cut), scale) > maxw do cut = cut - 1 end
            lines[#lines + 1] = cur:sub(1, cut)
            cur = indent .. cur:sub(cut + 1)
          end
        else
          lines[#lines + 1] = cur
          cur = indent .. word
        end
      end
      if cur ~= "" then lines[#lines + 1] = cur end
    end
  end
  while lines[#lines] == "" do lines[#lines] = nil end
  return lines
end
W.wrap = wrap

local PH_W, PH_H = 384, 216
local ph_cache, ph_order, ph_shader, ph_figures = {}, {}, nil, nil

local function ph_jokers()
  if ph_figures then return ph_figures end
  local list = {}
  for _, c in pairs(G.P_CENTERS or {}) do
    if c.set == "Joker" and c.pos and not c.mod and not c.atlas and c.order then list[#list + 1] = {order = c.order, pos = c.pos} end
  end
  table.sort(list, function(a, b) return a.order < b.order end)
  if #list == 0 then list = {{order = 1, pos = {x = 0, y = 0}}} end
  ph_figures = list
  return list
end

local function ph_hash(s)
  local h = 5381
  for i = 1, #s do h = (h * 33 + s:byte(i)) % 4294967296 end
  return h
end

local function hsv(h, s, v)
  local i = math.floor(h * 6) % 6
  local f = h * 6 - math.floor(h * 6)
  local p, q, t = v * (1 - s), v * (1 - f * s), v * (1 - (1 - f) * s)
  if i == 0 then return v, t, p elseif i == 1 then return q, v, p elseif i == 2 then return p, v, t
  elseif i == 3 then return p, q, v elseif i == 4 then return t, p, v end
  return v, p, q
end

local function placeholder_atlas(entry)
  local key = tostring(entry.key)
  if ph_cache[key] then return ph_cache[key] end
  local jokers = G.ASSET_ATLAS and G.ASSET_ATLAS["Joker"]
  if not (jokers and jokers.image and love.graphics.newCanvas) then return nil end
  if not ph_shader then
    local ok, sh = pcall(love.graphics.newShader, [[
      extern vec3 dark;
      vec4 effect(vec4 c, Image t, vec2 uv, vec2 sc) {
        vec4 px = Texel(t, uv);
        float l = dot(px.rgb, vec3(0.299, 0.587, 0.114));
        return vec4(mix(dark, c.rgb, smoothstep(0.15, 0.85, l)), c.a * px.a);
      }
    ]])
    if not ok then return nil end
    ph_shader = sh
  end
  local h = ph_hash(key .. "|" .. tostring(entry.title))
  local hue = (h % 360) / 360
  local figs = ph_jokers()
  local fig = figs[math.floor(h / 360) % #figs + 1].pos
  local rays = 8 + math.floor(h / 2160) % 5 * 2
  local spin = (math.floor(h / 10800) % 100) / 100 * math.pi
  local tilt = ((math.floor(h / 1080000) % 21) - 10) / 100
  local ok, canvas = pcall(love.graphics.newCanvas, PH_W, PH_H)
  if not ok or not canvas then return nil end
  canvas:setFilter("linear", "linear")
  local r1, g1, b1 = hsv(hue, 0.6, 0.62)
  local r2, g2, b2 = hsv((hue + 0.06) % 1, 0.7, 0.3)
  local r3, g3, b3 = hsv(hue, 0.35, 0.95)
  love.graphics.push("all")
  love.graphics.setCanvas(canvas)
