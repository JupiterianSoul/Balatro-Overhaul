-- ===== APPLY PRE-RUN MOD SETTINGS =====

function apply_mod_settings_to_run()
  if not G.MOD_SETTINGS or not G.MOD_SETTINGS.pre_run or not G.MOD_SETTINGS.pre_run.enabled then
    return
  end

  if _mod_menu_multiplayer_violation("Attempted to apply modded run settings in multiplayer") then
    return
  end

  local settings = G.MOD_SETTINGS.pre_run

  -- FIX: Mark run as modded when pre-run settings are applied (anti-cheat)
  if mark_run_as_modded then
    mark_run_as_modded("Pre-run mod settings applied")
  end

  -- Apply starting money
  if settings.starting_money and settings.starting_money ~= 4 then
    G.GAME.dollars = settings.starting_money
  end

  -- Apply joker slots
  if settings.joker_slots and settings.joker_slots ~= 5 then
    G.GAME.round_resets.joker_slots = settings.joker_slots
    if G.jokers then G.jokers.config.card_limit = settings.joker_slots end
  end

  -- Apply consumable slots
  if settings.consumable_slots and settings.consumable_slots ~= 2 then
    G.GAME.round_resets.consumable_slots = settings.consumable_slots
    if G.consumeables then G.consumeables.config.card_limit = settings.consumable_slots end
  end

  -- Apply hand size
  if settings.hand_size and settings.hand_size ~= 8 then
    G.GAME.round_resets.hand_size = settings.hand_size
    if G.hand then G.hand.config.card_limit = settings.hand_size end
  end

  -- Apply hands per round
  if settings.hands_per_round and settings.hands_per_round ~= 4 then
    G.GAME.round_resets.hands = settings.hands_per_round
    G.GAME.current_round.hands_left = settings.hands_per_round
  end

  -- Apply discards per round
  if settings.discards_per_round and settings.discards_per_round ~= 3 then
    G.GAME.round_resets.discards = settings.discards_per_round
    G.GAME.current_round.discards_left = settings.discards_per_round
  end

  -- Apply interest cap
  if settings.interest_cap and settings.interest_cap ~= 25 then
    G.GAME.interest_cap = settings.interest_cap
  end

  -- Apply win ante
  if settings.win_ante and settings.win_ante ~= 8 then
    G.GAME.win_ante = settings.win_ante
  end

  -- Copy pre-run settings to runtime
  if settings.free_rerolls then
    G.MOD_SETTINGS.runtime.free_rerolls_active = true
  end

  if settings.free_shop then
    G.MOD_SETTINGS.runtime.free_shop_active = true
  end

  if settings.all_eternal then
    G.MOD_SETTINGS.runtime.all_eternal_active = true
  end

  print("[MOD MENU] Pre-run mods applied!")
end

-- ===== MOD MENU UPDATE HOOK - Called from Game:update =====

function mod_menu_update()
  if not G.GAME then return end

  -- Anti-cheat: If in multiplayer, enforce mods are disabled
  if G.GAME.multiplayer then
    local mods_active = false
    pcall(function()
      if G.MOD_SETTINGS then
        if G.MOD_SETTINGS.in_run.god_mode then mods_active = true end
        if G.MOD_SETTINGS.runtime.free_rerolls_active then mods_active = true end
        if G.MOD_SETTINGS.runtime.free_shop_active then mods_active = true end
        if G.MOD_SETTINGS.runtime.all_eternal_active then mods_active = true end
        if G.MOD_SETTINGS.pre_run.enabled then mods_active = true end
      end
    end)
    if mods_active then
      _mod_menu_multiplayer_violation("Detected active mod cheat state in multiplayer")
      return
    end
    -- Remove floating mod button in multiplayer
    if G.MOD_FLOATING_BUTTON then
      pcall(function() remove_floating_mod_button() end)
    end
    return
  end

  if G.STAGE == G.STAGES.RUN and not G.GAME.cheats_allowed then
    if G.MOD_SETTINGS.in_run.god_mode or G.MOD_SETTINGS.runtime.free_rerolls_active or G.MOD_SETTINGS.runtime.free_shop_active then
      cheats_new_run()
    end
    if G.MOD_FLOATING_BUTTON then remove_floating_mod_button() end
    if G.GAME.modded_run and not G.MODDED_INDICATOR then
      pcall(create_modded_indicator)
    end
    return
  end

  -- GOD MODE - Always have enough chips to win
  if G.MOD_SETTINGS.in_run.god_mode then
    if not G.GAME.modded_run and mark_run_as_modded then mark_run_as_modded("God mode") end
r 4 1900 %20%20%20%20 -
l 144
      -- Keep chips at least equal to blind requirement
      if G.GAME.chips < G.GAME.blind.chips then
        if G.GAME.current_round and G.GAME.current_round.hands_left <= 0 then
          G.GAME.chips = G.GAME.blind.chips
        end
      end
    end
  end

  -- FREE REROLLS - Keep reroll cost at 0
  if G.MOD_SETTINGS.runtime.free_rerolls_active then
    if G.GAME.current_round then
      G.GAME.current_round.reroll_cost = 0
    end
  end

  -- FREE SHOP - Keep discount at 100%
  if G.MOD_SETTINGS.runtime.free_shop_active then
    G.GAME.discount_percent = 100
  end

  -- MODDED INDICATOR - Show when run is modded
  if G.GAME.modded_run and not G.MODDED_INDICATOR and G.STAGE == G.STAGES.RUN then
    pcall(create_modded_indicator)
  end
end

-- ===== FLOATING MOD BUTTON =====

function cheats_allowed_in_run()
  local g = G and G.GAME
  if not g or g.multiplayer or _is_multiplayer_mod_ban_context() then return false end
  if not (G.STAGES and G.STAGE == G.STAGES.RUN) then return false end
  return g.cheats_allowed == true
end

function cheats_off_notice()
  pcall(function()
    play_sound('cancel', 1.0, 0.5)
    attention_text({
      text = mod_loc("Cheats are off for this run"),
      scale = 0.6,
      hold = 2.2,
      colour = G.C.RED,
      major = G.ROOM_ATTACH or G.ROOM,
    })
  end)
end

function cheats_new_run()
  if not G.MOD_SETTINGS then return end
  G.MOD_SETTINGS.in_run.god_mode = false
  G.MOD_SETTINGS.runtime.free_rerolls_active = false
  G.MOD_SETTINGS.runtime.free_shop_active = false
  G.MOD_SETTINGS.runtime.all_eternal_active = false
end

local CHEATS_BTN_EDGE = 0.3

local function _cheats_btn_orient()
  return _mm_port() and 'port' or 'land'
end

local function _cheats_btn_bounds(box)
  local ts = (G.TILESIZE or 20) * (G.TILESCALE or 1)
  local sw, sh = love.graphics.getWidth() / ts, love.graphics.getHeight() / ts
  local ox = (G.ROOM and G.ROOM.T.x or 0) + (G.ROOM_ATTACH and G.ROOM_ATTACH.T.x or 0)
  local oy = (G.ROOM and G.ROOM.T.y or 0) + (G.ROOM_ATTACH and G.ROOM_ATTACH.T.y or 0)
  local x0, y0 = CHEATS_BTN_EDGE - ox, CHEATS_BTN_EDGE - oy
  local x1 = math.max(x0, sw - ox - box.T.w - CHEATS_BTN_EDGE)
  local y1 = math.max(y0, sh - oy - box.T.h - CHEATS_BTN_EDGE)
  return x0, x1, y0, y1
end

local function _cheats_btn_clamp(box, x, y)
  local x0, x1, y0, y1 = _cheats_btn_bounds(box)
  return math.max(x0, math.min(x1, x)), math.max(y0, math.min(y1, y))
end

local function _cheats_btn_pin(box, x, y)
  x, y = _cheats_btn_clamp(box, x, y)
  box:set_alignment({type = 'tli', offset = {x = x, y = y}})
  box:align_to_major()
  box:recalculate()
  box.cheats_pinned = true
  box.portrait_land = nil
  return x, y
end

local function _cheats_btn_saved()
  local all = G.SETTINGS and G.SETTINGS.cheats_button_pos
  local p = type(all) == 'table' and all[_cheats_btn_orient()]
  if type(p) == 'table' and tonumber(p.x) and tonumber(p.y) then return tonumber(p.x), tonumber(p.y) end
end

local function _cheats_btn_place(box)
  box.cheats_orient = _cheats_btn_orient()
  local x, y = _cheats_btn_saved()
  if x then
    _cheats_btn_pin(box, x, y)
  else
    box.cheats_pinned = nil
    box.portrait_land = nil
    box:set_alignment({type = 'tr', offset = {x = -0.5, y = 4.5}})
    box:align_to_major()
    box:recalculate()
    if _mm_port() and PORTRAIT and PORTRAIT.place_mods_button then pcall(PORTRAIT.place_mods_button) end
  end
end

local function _cheats_btn_keep_on_screen(box)
  if box.cheats_orient ~= _cheats_btn_orient() then
    _cheats_btn_place(box)
    return
  end
  if box.states.drag.is or not box.role.major then return end
  local ra = box.role.major.T
  local x, y = box.T.x - ra.x, box.T.y - ra.y
  local cx, cy = _cheats_btn_clamp(box, x, y)
  if math.abs(cx - x) > 0.001 or math.abs(cy - y) > 0.001 then
    local pinned = box.cheats_pinned
    _cheats_btn_pin(box, cx, cy)
    box.cheats_pinned = pinned
  end
end

function create_floating_mod_button()
  -- Remove existing button first
  if G.MOD_FLOATING_BUTTON then
    G.MOD_FLOATING_BUTTON:remove()
    G.MOD_FLOATING_BUTTON = nil
  end

  -- Don't create if disabled or in multiplayer
  if not G.MOD_SETTINGS.menu.floating_button then return end
  if G.SETTINGS.mod_menu_disabled then return end
  if G.GAME and G.GAME.multiplayer then return end
  if not cheats_allowed_in_run() then return end

  local opacity = (G.MOD_SETTINGS.menu.floating_opacity or 70) / 100
  local thumb = UIK and UIK.touch and UIK.touch()

  G.MOD_FLOATING_BUTTON = UIBox{
    definition = {n=G.UIT.ROOT, config={align = "cm", colour = {0.9, 0.7, 0.1, opacity}, r = 0.15, padding = 0.12, minw = thumb and 1.9 or 1.4, minh = thumb and 1.15 or 0.9}, nodes={
r 7 297 %20%20%20%20%20%20 -
l 179
        {n=G.UIT.T, config={text = mod_loc("CHEATS"), scale = thumb and 0.6 or 0.5, colour = G.C.WHITE, shadow = true}}
      }}
    }},
    config = {
      align = "tr",
      offset = {x = -0.5, y = 4.5},
      major = G.ROOM_ATTACH
    }
  }

  local box = G.MOD_FLOATING_BUTTON
  if box then
    box.states.collide.can = true
    box.states.click.can = true
    box.states.drag.can = true
    box.attention_text = true
    _cheats_btn_place(box)
    box.drag = function(self, offset)
      Moveable.drag(self, offset)
      local ra = self.role.major and self.role.major.T or {x = 0, y = 0}
      _cheats_btn_pin(self, self.T.x - ra.x, self.T.y - ra.y)
    end
    box.stop_drag = function(self)
      Node.stop_drag(self)
      if not self.cheats_pinned or not self.alignment then return end
      G.SETTINGS.cheats_button_pos = type(G.SETTINGS.cheats_button_pos) == 'table' and G.SETTINGS.cheats_button_pos or {}
      G.SETTINGS.cheats_button_pos[_cheats_btn_orient()] = {x = self.alignment.offset.x, y = self.alignment.offset.y}
      pcall(function() G:save_settings() end)
    end
    box.move = function(self, dt)
      _cheats_btn_keep_on_screen(self)
      UIBox.move(self, dt)
    end
  end
end

function remove_floating_mod_button()
  if G.MOD_FLOATING_BUTTON then
    G.MOD_FLOATING_BUTTON:remove()
    G.MOD_FLOATING_BUTTON = nil
  end
end

-- Hook into the click system for the floating button
local _orig_UIBox_click = UIBox.click
if _orig_UIBox_click then
  UIBox.click = function(self)
    if self == G.MOD_FLOATING_BUTTON then
      G.FUNCS.open_mod_menu_inrun()
      return true
    end
    return _orig_UIBox_click(self)
  end
end

-- ===== MODDED RUN INDICATOR =====

function create_modded_indicator()
  remove_modded_indicator()

  if not G.GAME or not G.GAME.modded_run then return end
  G.MODDED_INDICATOR = {text = G.GAME.cheats_allowed and mod_loc("CHEATS USED - NO PROGRESS") or mod_loc("NO PROGRESS IN THIS RUN")}
end

function remove_modded_indicator()
  G.MODDED_INDICATOR = nil
end

-- Check and show modded indicator periodically
G.FUNCS.check_modded_indicator = function(e)
  if not G or not G.GAME then return end
  if G.STAGE ~= G.STAGES.RUN then
    remove_modded_indicator()
    return
  end
  if G.GAME.modded_run and not G.MODDED_INDICATOR then
    pcall(create_modded_indicator)
  end
end

-- Hook mark_run_as_modded to show indicator immediately
local _orig_mark_modded = _G.mark_run_as_modded
_G.mark_run_as_modded = function(reason)
  if _orig_mark_modded then _orig_mark_modded(reason) end
  pcall(create_modded_indicator)
end

-- FIX: Guard every actionable mod-menu callback in multiplayer, including direct callback invocation.
local function _wrap_mod_menu_multiplayer_guards()
  local wrapped_callbacks = {}
  local blocked_callbacks = {
    open_mod_menu_fullscreen = "Attempted to open the mod menu in multiplayer",
    open_mod_menu_inrun = "Attempted to open the in-run mod menu in multiplayer",
    mod_add_money = "Attempted to add money in multiplayer",
    mod_do_add_hands = "Attempted to add hands in multiplayer",
    mod_do_add_discards = "Attempted to add discards in multiplayer",
    mod_do_add_both = "Attempted to add hands and discards in multiplayer",
    mod_win_blind = "Attempted to auto-win a blind in multiplayer",
    mod_increase_ante = "Attempted to increase ante in multiplayer",
    mod_decrease_ante = "Attempted to decrease ante in multiplayer",
    mod_do_add_joker_slots = "Attempted to add joker slots in multiplayer",
    mod_do_add_consumable_slots = "Attempted to add consumable slots in multiplayer",
    mod_do_add_hand_size = "Attempted to add hand size in multiplayer",
    mod_do_remove_joker_slot = "Attempted to remove joker slot in multiplayer",
    mod_do_remove_consumable_slot = "Attempted to remove consumable slot in multiplayer",
    mod_do_remove_hand_size = "Attempted to remove hand size in multiplayer",
    mod_do_remove_hand = "Attempted to remove hand in multiplayer",
    mod_do_remove_discard = "Attempted to remove discard in multiplayer",
    mod_add_selected_jokers = "Attempted to add jokers in multiplayer",
    mod_browse_jokers = "Attempted to browse jokers in multiplayer",
    mod_add_selected_consumables = "Attempted to add consumables in multiplayer",
    mod_browse_tarots = "Attempted to browse tarots in multiplayer",
    mod_browse_planets = "Attempted to browse planets in multiplayer",
    mod_browse_spectrals = "Attempted to browse spectrals in multiplayer",
    mod_add_selected_cards = "Attempted to add cards in multiplayer",
    mod_browse_cards = "Attempted to browse cards in multiplayer",
    mod_do_remove_selected_cards = "Attempted to remove cards in multiplayer",
    mod_add_selected_vouchers = "Attempted to add vouchers in multiplayer",
    mod_browse_vouchers = "Attempted to browse vouchers in multiplayer",
    mod_level_all_hands = "Attempted to level all hands in multiplayer",
    mod_level_all_hands_10 = "Attempted to level all hands by 10 in multiplayer",
    mod_level_all_hands_100 = "Attempted to level all hands by 100 in multiplayer",
    mod_delevel_all_hands = "Attempted to de-level all hands in multiplayer",
    mod_delevel_all_hands_10 = "Attempted to de-level all hands by 10 in multiplayer",
    mod_delevel_all_hands_100 = "Attempted to de-level all hands by 100 in multiplayer",
  }

  for callback_name, violation_reason in pairs(blocked_callbacks) do
    local original = G.FUNCS[callback_name]
    if original and not wrapped_callbacks[callback_name] then
      G.FUNCS[callback_name] = function(...)
        if _mod_menu_multiplayer_violation(violation_reason) then
          return
        end
        if callback_name ~= 'open_mod_menu_fullscreen' and callback_name ~= 'open_mod_menu_inrun'
          and G.STAGE == G.STAGES.RUN and not cheats_allowed_in_run() then
          return
        end
        return original(...)
      end
      wrapped_callbacks[callback_name] = true
    end
  end
end

_wrap_mod_menu_multiplayer_guards()

