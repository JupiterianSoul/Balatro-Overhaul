      local is_neg = edition_key == 'negative'
      if not is_neg and #G.jokers.cards >= G.jokers.config.card_limit then break end
      local card = create_card('Joker', G.jokers, nil, nil, nil, nil, key)
      if edition_key and edition_key ~= 'base' then
