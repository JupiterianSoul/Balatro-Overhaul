    free_rerolls = false,
    free_shop = false,
    all_eternal = false,
  },

  -- In-run temp values for sliders
  in_run = {
    god_mode = false,
    add_hands = 1,
    add_discards = 1,
    add_money = 100,
    add_joker_slots = 1,
    add_consumable_slots = 1,
    add_hand_size = 1,
    card_quantity = 1,
  },

  -- Menu settings
  menu = {
    floating_button = true,
    floating_opacity = 70,
  },

  -- Floating button position (above deck area)
  float_pos = {x = 0, y = 5.5},

  -- Runtime flags
  runtime = {
    free_rerolls_active = false,
    free_shop_active = false,
    all_eternal_active = false,
  }
}

-- FEATURE: Mod menu browse/select state
G.MOD_MENU_STATE = G.MOD_MENU_STATE or {
  selected_jokers = {},       -- {key = true} map
  selected_edition = 'base',  -- base/foil/holo/polychrome/negative
  selected_consumables = {},  -- {key = true} map
  consumable_negative = false,
  selected_cards = {},        -- {{suit='H', rank='A'}, ...}
  selected_enhancement = 'c_base',
  selected_seal = nil,        -- nil/'Red'/'Blue'/'Gold'/'Purple'
  selected_vouchers = {},     -- {key = true} map
  active_tab = 1,             -- track which tab to return to on back
}

local _mp_mod_violation_pending = false

local function _is_multiplayer_mod_ban_context()
  if G and G.GAME and G.GAME.multiplayer then
    return true
  end

  local active = false
  pcall(function()
    if bom_match and bom_match.is_active then
      active = bom_match.is_active()
    end
  end)
  return active
end

local function _disable_all_mod_menu_cheats()
  if not G or not G.MOD_SETTINGS then return end

  pcall(function()
    G.MOD_SETTINGS.pre_run.enabled = false
    G.MOD_SETTINGS.in_run.god_mode = false
    G.MOD_SETTINGS.runtime.free_rerolls_active = false
    G.MOD_SETTINGS.runtime.free_shop_active = false
    G.MOD_SETTINGS.runtime.all_eternal_active = false
  end)
end

local function _mod_menu_multiplayer_violation(reason)
  if not _is_multiplayer_mod_ban_context() then return false end

  _disable_all_mod_menu_cheats()

  pcall(function()
    if G and G.GAME then
      G.GAME.modded_run = true
    end
  end)
  pcall(function() remove_floating_mod_button() end)
  pcall(function()
    if G and G.OVERLAY_MENU and G.FUNCS and G.FUNCS.exit_overlay_menu then
r 4 1375 %20%20%20%20%20%20 -
l 35
    end
  end)

  -- FIX: Do not redirect to main menu if a run is currently starting (STATE==-1)
  -- or if we are already in a run (STAGE==RUN). The caller (apply_mod_settings_to_run)
  -- fires during Game:start_run before G.STATE is set properly.
  local stage = G and G.STAGE or 0
  local state  = G and G.STATE  or 0
  local stages_run = G and G.STAGES and G.STAGES.RUN or 2
  if stage == stages_run or state == -1 then
    -- Already in or entering a run -- just disable cheats, don't kick to menu
    return true
  end

  if _mp_mod_violation_pending then
    return true
  end
  _mp_mod_violation_pending = true

  print("[MOD MENU] Multiplayer violation detected: " .. tostring(reason))

  pcall(function()
    play_sound('cancel', 1.0, 0.5)
    if attention_text and G and (G.ROOM_ATTACH or G.ROOM) then
      attention_text({
        text = mod_loc("CHEATS ARE OFF IN MULTIPLAYER"),
        scale = 0.65,
        hold = 2.6,
        colour = G.C.RED,
        major = G.ROOM_ATTACH or G.ROOM,
      })
    end
  end)

  if G and G.E_MANAGER then
r 1 112 %20%20%20%20 -
r 2 398 %20%20%20%20%20%20 -
l 27
      blocking = false,
      blockable = false,
      no_delete = true,
      func = function()
        pcall(function()
          if bom_core and bom_core.send and bom_match and bom_match.is_active and bom_match.is_active() then
            bom_core.send({ type = "leave_lobby" })
          end
        end)

        pcall(function()
          if bom_ui and bom_ui.destroy_match_hud then
            bom_ui.destroy_match_hud()
          end
          if G and G.GAME then
            G.GAME.multiplayer = nil
          end
          if bom_core and bom_core.disconnect then
            bom_core.disconnect()
          end
          if bom_match and bom_match.reset then
            bom_match.reset()
          end
        end)

        pcall(function()
          if G and G.OVERLAY_MENU and G.FUNCS and G.FUNCS.exit_overlay_menu then
r 4 1375 %20%20%20%20%20%20%20%20%20%20%20%20 -
