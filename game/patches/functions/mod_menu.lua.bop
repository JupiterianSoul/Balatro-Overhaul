          end
        end)

        pcall(function()
          if G and G.delete_run then
            G:delete_run()
          end
          if G and G.main_menu then
            G:main_menu()
          end
        end)

        _mp_mod_violation_pending = false
        return true
      end,
    }))
  else
    _mp_mod_violation_pending = false
  end

  return true
end

-- ===== FULL SCREEN MOD MENU WITH TABS =====

local function _mm_cell(node, w, h)
  return {n=G.UIT.C, config={align = "cm", minw = w, minh = h}, nodes={node}}
end

local function _mm_port()
  return rawget(_G, 'PORTRAIT') ~= nil and PORTRAIT.on()
end

local function _mm_w()
  return _mm_port() and 7.7 or 13
end

function create_UIBox_mod_menu_fullscreen()
  local at = G.MOD_MENU_STATE and G.MOD_MENU_STATE.active_tab or 1
  return create_UIBox_generic_options({
    no_pip = true,
    back_func = 'mod_menu_back',
    contents = {
r 15 71 %20%20%20%20%20%20 -
l 417
        {n=G.UIT.T, config={text = mod_loc("CHEATS"), scale = 0.45, colour = G.C.GOLD}}
      }},
      {n=G.UIT.R, config={align = "cm", padding = 0.02, minw = _mm_port() and 7.6 or 14, minh = 4.2}, nodes={
        create_tabs({
          tabs = {
            {
              label = mod_loc("RUN"),
              chosen = (at == 1),
              tab_definition_function = G.UIDEF.mod_tab_cheats
            },
            {
              label = mod_loc("JOKERS"),
              chosen = (at == 2),
              tab_definition_function = G.UIDEF.mod_tab_jokers
            },
            {
              label = mod_loc("CONSUM."),
              chosen = (at == 3),
              tab_definition_function = G.UIDEF.mod_tab_consumables
            },
            {
              label = mod_loc("CARDS"),
              chosen = (at == 4),
              tab_definition_function = G.UIDEF.mod_tab_cards
            },
            {
              label = mod_loc("VOUCHERS"),
              chosen = (at == 5),
              tab_definition_function = G.UIDEF.mod_tab_vouchers
            },
            {
              label = mod_loc("HANDS"),
              chosen = (at == 6),
              tab_definition_function = G.UIDEF.mod_tab_poker_hands
            },
            {
              label = mod_loc("OPTIONS"),
              chosen = (at == 7),
              tab_definition_function = G.UIDEF.mod_tab_settings
            },
          },
          snap_to_nav = true,
          tab_h = not _mm_port() and ((UIK and UIK.touch and UIK.touch()) and 6.0 or 6.6) or nil
        }),
      }},
    }
  })
end

-- ===== TAB: CHEATS (v3.0 — 3-column layout: sliders | positive | negative, 30% bigger) =====
G.UIDEF.mod_tab_cheats = function()
  local settings = G.MOD_SETTINGS.in_run
  -- Button size: 30% increase
  local bw = 2.85
  local bh = 0.78
  local bs = 0.47
  local ch = (UIK and UIK.touch and UIK.touch() and not _mm_port()) and 0.9 or 1.0

  if _mm_port() then
    local pw, pc = 3.55, 3.75
    local function pb(label, button, colour)
      return UIBox_button({label = {mod_loc(label)}, button = button, colour = colour, minw = pw, minh = bh, scale = bs})
    end
    local function pr(a, b)
      return {n=G.UIT.R, config={align = "cm", padding = 0.02}, nodes={_mm_cell(a, pc, ch), b and _mm_cell(b, pc, ch) or nil}}
    end
    local function sr(sl, label, button, colour)
      return {n=G.UIT.R, config={align = "cm", padding = 0.02}, nodes={
        _mm_cell(create_slider(sl), pc, ch),
        _mm_cell(UIBox_button({label = {mod_loc(label)}, button = button, colour = colour, minw = pw, minh = bh, scale = bs}), pc, ch),
      }}
    end
    return {n=G.UIT.ROOT, config={align = "cm", padding = 0.05, colour = G.C.CLEAR, minw = _mm_w(), minh = 3.2}, nodes={
      sr({label = mod_loc("MONEY"), w = 2.75, h = 0.35, label_scale = 0.4, ref_table = settings, ref_value = 'add_money', min = 100, max = 10000}, "ADD $", 'mod_add_money', G.C.MONEY),
      sr({label = mod_loc("HANDS"), w = 2.75, h = 0.35, label_scale = 0.4, ref_table = settings, ref_value = 'add_hands', min = 1, max = 50}, "+HAND", 'mod_do_add_hands', G.C.BLUE),
      sr({label = mod_loc("DISCARDS"), w = 2.75, h = 0.35, label_scale = 0.4, ref_table = settings, ref_value = 'add_discards', min = 1, max = 50}, "+DISC", 'mod_do_add_discards', G.C.RED),
      {n=G.UIT.R, config={align = "cm", padding = 0.02}, nodes={
        _mm_cell(create_toggle({label = mod_loc("GOD MODE"), ref_table = settings, ref_value = 'god_mode', w = 3.0, label_scale = 0.47, active_colour = G.C.YELLOW}), pc*2, ch),
      }},
      pr(pb("WIN BLIND", 'mod_win_blind', G.C.ORANGE), pb("BOTH H+D", 'mod_do_add_both', G.C.GREEN)),
      pr(pb("+1 ANTE", 'mod_increase_ante', G.C.GREEN), pb("-1 ANTE", 'mod_decrease_ante', G.C.RED)),
      pr(pb("+JKR SLOT", 'mod_do_add_joker_slots', G.C.GREEN), pb("-JKR SLOT", 'mod_do_remove_joker_slot', G.C.RED)),
      pr(pb("+CON SLOT", 'mod_do_add_consumable_slots', G.C.SECONDARY_SET.Tarot), pb("-CON SLOT", 'mod_do_remove_consumable_slot', G.C.RED)),
      pr(pb("+HAND SIZE", 'mod_do_add_hand_size', G.C.CHIPS), pb("-HAND SIZE", 'mod_do_remove_hand_size', G.C.RED)),
      pr(pb("-1 HAND", 'mod_do_remove_hand', G.C.RED), pb("-1 DISC", 'mod_do_remove_discard', G.C.RED)),
    }}
  end

  local function cell(label, button, colour)
    return {n=G.UIT.R, config={align = "cm", padding = 0.02}, nodes={
      _mm_cell(UIBox_button({label = {mod_loc(label)}, button = button, colour = colour, minw = bw, minh = bh, scale = bs}), bw + 0.1, ch),
    }}
  end
  local function srow(sl, label, button, colour)
    return {n=G.UIT.R, config={align = "cm", padding = 0.02}, nodes={
      _mm_cell(create_slider(sl), 3.3, ch),
      _mm_cell(UIBox_button({label = {mod_loc(label)}, button = button, colour = colour, minw = bw, minh = bh, scale = bs}), 3.0, ch),
    }}
  end
  return {n=G.UIT.ROOT, config={align = "cm", padding = 0.05, colour = G.C.CLEAR, minh = 3.2}, nodes={
    {n=G.UIT.R, config={align = "tm", padding = 0.02}, nodes={
      {n=G.UIT.C, config={align = "tm", padding = 0.03}, nodes={
        srow({label = mod_loc("MONEY"), w = 2.5, h = 0.35, label_scale = 0.4, ref_table = settings, ref_value = 'add_money', min = 100, max = 10000}, "ADD $", 'mod_add_money', G.C.MONEY),
        srow({label = mod_loc("HANDS"), w = 2.5, h = 0.35, label_scale = 0.4, ref_table = settings, ref_value = 'add_hands', min = 1, max = 50}, "+HAND", 'mod_do_add_hands', G.C.BLUE),
        srow({label = mod_loc("DISCARDS"), w = 2.5, h = 0.35, label_scale = 0.4, ref_table = settings, ref_value = 'add_discards', min = 1, max = 50}, "+DISC", 'mod_do_add_discards', G.C.RED),
        {n=G.UIT.R, config={align = "cm", padding = 0.02}, nodes={
          _mm_cell(create_toggle({label = mod_loc("GOD MODE"), ref_table = settings, ref_value = 'god_mode', w = 3.0, label_scale = 0.47, active_colour = G.C.YELLOW}), 6.3, ch),
        }},
      }},
      {n=G.UIT.C, config={align = "tm", padding = 0.03}, nodes={
        cell("WIN BLIND", 'mod_win_blind', G.C.ORANGE),
        cell("+1 ANTE", 'mod_increase_ante', G.C.GREEN),
        cell("+JKR SLOT", 'mod_do_add_joker_slots', G.C.GREEN),
        cell("+CON SLOT", 'mod_do_add_consumable_slots', G.C.SECONDARY_SET.Tarot),
        cell("+HAND SIZE", 'mod_do_add_hand_size', G.C.CHIPS),
        cell("-1 HAND", 'mod_do_remove_hand', G.C.RED),
      }},
      {n=G.UIT.C, config={align = "tm", padding = 0.03}, nodes={
        cell("BOTH H+D", 'mod_do_add_both', G.C.GREEN),
        cell("-1 ANTE", 'mod_decrease_ante', G.C.RED),
        cell("-JKR SLOT", 'mod_do_remove_joker_slot', G.C.RED),
        cell("-CON SLOT", 'mod_do_remove_consumable_slot', G.C.RED),
        cell("-HAND SIZE", 'mod_do_remove_hand_size', G.C.RED),
        cell("-1 DISC", 'mod_do_remove_discard', G.C.RED),
      }},
    }},
  }}
end

-- ===== TAB: JOKERS (browse, select edition, add to hand) =====
G.UIDEF.mod_tab_jokers = function()
  local state = G.MOD_MENU_STATE
  local sel_count = 0
  for _ in pairs(state.selected_jokers) do sel_count = sel_count + 1 end
  local sel_text = sel_count > 0 and (sel_count .. " selected") or "None selected"

  return {n=G.UIT.ROOT, config={align = "cm", padding = 0.065, colour = G.C.CLEAR, minw = _mm_w(), minh = 4.16}, nodes={
    {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      {n=G.UIT.T, config={text = mod_loc("JOKERS"), scale = 0.52, colour = G.C.RED}}
    }},
    {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      UIBox_button({label = {mod_loc("Browse Jokers")}, button = 'mod_browse_jokers', colour = G.C.RED, minw = 6.5, minh = 0.91, scale = 0.52}),
    }},
    {n=G.UIT.R, config={align = "cm", padding = 0.026}, nodes={
      {n=G.UIT.T, config={text = mod_loc(sel_text), scale = 0.39, colour = G.C.UI.TEXT_LIGHT}}
    }},
    {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      create_option_cycle({
        label = mod_loc("Edition"),
        options = {mod_loc("Base"), mod_loc("Foil"), mod_loc("Holographic"), mod_loc("Polychrome"), mod_loc("Negative")},
        opt_callback = 'mod_edition_cycle',
        current_option = ({base=1, foil=2, holo=3, polychrome=4, negative=5})[state.selected_edition] or 1,
        colour = G.C.DARK_EDITION, w = _mm_port() and 5.4 or 5.85, scale = 1.04, text_scale = 0.455,
      }),
    }},
    {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      UIBox_button({label = {mod_loc("ADD SELECTED JOKERS")}, button = 'mod_add_selected_jokers', colour = G.C.GREEN, minw = 6.5, minh = 0.91, scale = 0.52}),
    }},
  }}
end

-- ===== TAB: CONSUMABLES (tarots, planets, spectral + negative toggle + add) =====
G.UIDEF.mod_tab_consumables = function()
  local state = G.MOD_MENU_STATE
  local sel_count = 0
  for _ in pairs(state.selected_consumables) do sel_count = sel_count + 1 end
  local sel_text = sel_count > 0 and (sel_count .. " selected") or "None selected"
  local port = _mm_port()
  local cbw = port and 6.5 or 4.55
  local browse = {
    UIBox_button({label = {mod_loc("Tarot Cards")}, button = 'mod_browse_tarots', colour = G.C.SECONDARY_SET.Tarot, minw = cbw, minh = 0.91, scale = 0.455}),
    UIBox_button({label = {mod_loc("Planet Cards")}, button = 'mod_browse_planets', colour = G.C.SECONDARY_SET.Planet, minw = cbw, minh = 0.91, scale = 0.455}),
    UIBox_button({label = {mod_loc("Spectral Cards")}, button = 'mod_browse_spectrals', colour = G.C.SECONDARY_SET.Spectral, minw = cbw, minh = 0.91, scale = 0.455}),
  }
  local browse_rows = {{n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes=browse}}
  if port then
    browse_rows = {}
    for _, b in ipairs(browse) do browse_rows[#browse_rows + 1] = {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={b}} end
  end

  return {n=G.UIT.ROOT, config={align = "cm", padding = 0.065, colour = G.C.CLEAR, minw = _mm_w(), minh = 4.16}, nodes={
    {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      {n=G.UIT.T, config={text = mod_loc("CONSUMABLES"), scale = 0.52, colour = G.C.SECONDARY_SET.Spectral}}
    }},
    {n=G.UIT.R, config={align = "cm"}, nodes=browse_rows},
    {n=G.UIT.R, config={align = "cm", padding = 0.026}, nodes={
      {n=G.UIT.T, config={text = mod_loc(sel_text), scale = 0.39, colour = G.C.UI.TEXT_LIGHT}}
    }},
    {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      create_toggle({label = mod_loc("Make added consumables Negative"), ref_table = state, ref_value = 'consumable_negative', w = port and 5.7 or 6.5, active_colour = G.C.DARK_EDITION}),
    }},
    {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      UIBox_button({label = {mod_loc("ADD SELECTED CONSUMABLES")}, button = 'mod_add_selected_consumables', colour = G.C.GREEN, minw = 6.5, minh = 0.91, scale = 0.52}),
    }},
  }}
end

-- ===== TAB: CARDS (browse by suit, quantity, enhancement, seal, preview, add, remove) =====
G.UIDEF.mod_tab_cards = function()
  local state = G.MOD_MENU_STATE
  local settings = G.MOD_SETTINGS.in_run
  local sel_count = #state.selected_cards
  local sel_text = sel_count > 0 and (sel_count .. " card(s) selected") or "None selected"
  local port = _mm_port()
  local cc, cb, qw = 5.4, 5.2, 3.9
  if port then cc, cb = 3.75, 3.55 end
  if port then
    local function cbtn(label, button, colour, w)
      return UIBox_button({label = {mod_loc(label)}, button = button, colour = colour, minw = w or cb, minh = 0.85, scale = 0.49})
    end
    local function crow(a, b)
      return {n=G.UIT.R, config={align = "cm", padding = 0.02}, nodes={_mm_cell(a, cc, 0.95), _mm_cell(b, cc, 0.95)}}
    end
    return {n=G.UIT.ROOT, config={align = "cm", padding = 0.065, colour = G.C.CLEAR, minw = _mm_w(), minh = 4.16}, nodes={
      {n=G.UIT.R, config={align = "cm", padding = 0.026}, nodes={
        {n=G.UIT.T, config={text = mod_loc("CARDS"), scale = 0.52, colour = G.C.CHIPS}}
      }},
      crow(cbtn("Browse Cards", 'mod_browse_cards', G.C.BLUE), cbtn("Enhancements", 'mod_browse_enhancements', G.C.GREEN)),
      crow(cbtn("Remove Cards", 'mod_remove_cards_browse', G.C.RED), cbtn("Seals", 'mod_browse_seals', G.C.SECONDARY_SET.Spectral)),
      crow(cbtn("Card Preview", 'mod_card_preview', G.C.ORANGE), cbtn("Editions", 'mod_browse_editions', G.C.SECONDARY_SET.Celestial)),
      {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
        _mm_cell(create_slider({label = mod_loc("Qty"), w = 4.5, h = 0.52, ref_table = settings, ref_value = 'card_quantity', min = 1, max = 25}), cc*2, 1.3),
      }},
      {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
        _mm_cell(UIBox_button({label = {mod_loc("ADD CARDS")}, button = 'mod_add_selected_cards', colour = G.C.GREEN, minw = cc*2 - 0.2, minh = 0.91, scale = 0.52}), cc*2, 0.95),
      }},
      {n=G.UIT.R, config={align = "cm", padding = 0.026}, nodes={
        {n=G.UIT.T, config={text = mod_loc(sel_text), scale = 0.36, colour = G.C.UI.TEXT_LIGHT}},
      }},
    }}
  end

  return {n=G.UIT.ROOT, config={align = "cm", padding = 0.065, colour = G.C.CLEAR, minw = _mm_w(), minh = 4.16}, nodes={
    {n=G.UIT.R, config={align = "cm", padding = 0.026}, nodes={
      {n=G.UIT.T, config={text = mod_loc("CARDS"), scale = 0.52, colour = G.C.CHIPS}}
    }},
    -- Two columns: left (Browse/Remove/ADD/Slider), right (Enhancements/Seals/Editions/Preview)
    {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      _mm_cell(UIBox_button({label = {mod_loc("Browse Cards")}, button = 'mod_browse_cards', colour = G.C.BLUE, minw = cb, minh = 0.85, scale = 0.49}), cc, 0.95),
      _mm_cell(UIBox_button({label = {mod_loc("Enhancements")}, button = 'mod_browse_enhancements', colour = G.C.GREEN, minw = cb, minh = 0.85, scale = 0.49}), cc, 0.95),
    }},
    {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      _mm_cell(UIBox_button({label = {mod_loc("Remove Cards")}, button = 'mod_remove_cards_browse', colour = G.C.RED, minw = cb, minh = 0.85, scale = 0.49}), cc, 0.95),
      _mm_cell(UIBox_button({label = {mod_loc("Seals")}, button = 'mod_browse_seals', colour = G.C.SECONDARY_SET.Spectral, minw = cb, minh = 0.85, scale = 0.49}), cc, 0.95),
    }},
    -- FEATURE: Editions button (between Seals and Card Preview)
    {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      _mm_cell(UIBox_button({label = {mod_loc("ADD CARDS")}, button = 'mod_add_selected_cards', colour = G.C.GREEN, minw = cb, minh = 0.91, scale = 0.52}), cc, 0.95),
      _mm_cell(UIBox_button({label = {mod_loc("Editions")}, button = 'mod_browse_editions', colour = G.C.SECONDARY_SET.Celestial, minw = cb, minh = 0.85, scale = 0.49}), cc, 0.95),
    }},
