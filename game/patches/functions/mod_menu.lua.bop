    local discards = math.floor(G.MOD_SETTINGS.in_run.add_discards or 1)
    G.GAME.current_round.hands_left = G.GAME.current_round.hands_left + hands
    G.GAME.current_round.discards_left = G.GAME.current_round.discards_left + discards
    play_sound('button')
  end
end

