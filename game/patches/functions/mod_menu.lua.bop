-- MOD MENU v3.0 for Balatro Overhaul
-- FEATURE: Complete rework — Cheats, Jokers, Consumables, Cards, Vouchers, Poker Hands, Options

-- Global mod settings table
G.MOD_SETTINGS = G.MOD_SETTINGS or {
