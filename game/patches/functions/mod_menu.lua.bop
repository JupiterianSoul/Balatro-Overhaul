-- ===== CHEAT CALLBACKS =====

G.FUNCS.mod_add_money = function(e)
  if G.GAME then
    -- Anti-cheat: Mark run as modded
    if mark_run_as_modded then mark_run_as_modded("Added money") end

    local amount = math.floor(G.MOD_SETTINGS.in_run.add_money or 100)
    G.GAME.dollars = G.GAME.dollars + amount
    play_sound('coin1')
  end
end

G.FUNCS.mod_do_add_hands = function(e)
  if G.GAME and G.GAME.current_round then
    -- Anti-cheat: Mark run as modded
    if mark_run_as_modded then mark_run_as_modded("Added hands") end

    local amount = math.floor(G.MOD_SETTINGS.in_run.add_hands or 1)
    G.GAME.current_round.hands_left = G.GAME.current_round.hands_left + amount
    play_sound('button')
  end
end

G.FUNCS.mod_do_add_discards = function(e)
  if G.GAME and G.GAME.current_round then
    -- Anti-cheat: Mark run as modded
