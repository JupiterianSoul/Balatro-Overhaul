G.FUNCS.mod_add_selected_cards = function(e)
  if not G.GAME or not G.deck or not G.playing_cards then return end
  local state = G.MOD_MENU_STATE
  local settings = G.MOD_SETTINGS.in_run
  if #state.selected_cards == 0 then
    pcall(function() play_sound('cancel') end)
    return
