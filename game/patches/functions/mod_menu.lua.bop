G.UIDEF.mod_tab_settings = function()
  local settings = G.MOD_SETTINGS.menu
  local port = _mm_port()
  local sbw = port and 6.5 or 4.55
  local float_cells = {
    _mm_cell(create_toggle({label = mod_loc("Show Cheats Button"), ref_table = settings, ref_value = 'floating_button', w = 3.64, label_scale = 0.45, active_colour = G.C.BLUE}), port and 7.3 or 4.6, port and 1.0 or 1.3),
    _mm_cell(create_slider({label = mod_loc("Opacity %"), w = 4.55, h = 0.49, ref_table = settings, ref_value = 'floating_opacity', min = 20, max = 100}), port and 7.3 or 6.6, 1.3),
  }
  local float_rows = {{n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes=float_cells}}
  if port then
    float_rows = {
      {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={float_cells[1]}},
      {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={float_cells[2]}},
    }
  end

  return {n=G.UIT.ROOT, config={align = "cm", padding = 0.13, colour = G.C.CLEAR, minw = _mm_w(), minh = 4.16}, nodes={
    {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      {n=G.UIT.T, config={text = mod_loc("CHEATS OPTIONS"), scale = 0.52, colour = G.C.GOLD}}
    }},
    {n=G.UIT.R, config={align = "cm"}, nodes=float_rows},
    {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      UIBox_button({label = {mod_loc("APPLY & REFRESH")}, button = 'mod_refresh_float', colour = G.C.BLUE, minw = sbw, minh = 0.85, scale = 0.455}),
      UIBox_button({label = {mod_loc("RESET POSITION")}, button = 'mod_reset_float_pos', colour = G.C.RED, minw = sbw, minh = 0.85, scale = 0.455}),
    }},
    -- FEATURE: Deck Creator shortcut
    {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      UIBox_button({label = {mod_loc("DECK CREATOR")}, button = 'dc_open_deck_creator', colour = G.C.GREEN, minw = sbw, minh = 0.85, scale = 0.455}),
    }},
    {n=G.UIT.R, config={align = "cm", padding = 0.065, maxw = port and 7.3 or nil}, nodes={
      {n=G.UIT.T, config={text = mod_loc("Drag the Cheats button anywhere on screen"), scale = 0.36, colour = G.C.UI.TEXT_LIGHT}}
    }},
  }}
end

-- FEATURE: Helper for card selection with visual feedback (matching custom_runs.lua system)
-- Sets card.highlighted for Y-offset visual + juice_up animation + single_tap for Android touch
local function _mod_setup_card_select(card, selection_table, key)
  card.states.click.can = true
  local _toggle = function()
    if selection_table[key] then
      selection_table[key] = nil
      card.highlighted = false
    else
      selection_table[key] = true
      card.highlighted = true
    end
    card:juice_up(0.3, 0.3)
    pcall(function() play_sound('cardSlide1') end)
  end
  card.click = _toggle
  card.single_tap = _toggle
  if selection_table[key] then
    card.highlighted = true
  end
end

-- Helper for playing card selection (array-based, suit+rank)
local function _mod_setup_playing_card_select(card, suit, rank)
  card.states.click.can = true
  local _toggle = function()
    local found = false
    for si, sel in ipairs(G.MOD_MENU_STATE.selected_cards) do
      if sel.suit == suit and sel.rank == rank then
        table.remove(G.MOD_MENU_STATE.selected_cards, si)
        found = true
        break
      end
    end
    if not found then
      table.insert(G.MOD_MENU_STATE.selected_cards, {suit = suit, rank = rank})
    end
    card.highlighted = not found
    card:juice_up(0.3, 0.3)
    pcall(function() play_sound('cardSlide1') end)
  end
  card.click = _toggle
  card.single_tap = _toggle
  for _, sel in ipairs(G.MOD_MENU_STATE.selected_cards) do
    if sel.suit == suit and sel.rank == rank then
      card.highlighted = true
      break
    end
  end
end

