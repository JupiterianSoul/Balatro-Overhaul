G.FUNCS.mod_browse_back_cards = function(e)
  -- FEATURE: Disable drag-to-select when leaving any browse window
  if DRAG_SELECT then DRAG_SELECT.set_browse_mode(false) end
  -- FIX: Clear stale single_tap/click/highlighted on collection display cards so they
  -- cannot receive touch events from DRAG_SELECT._update_browse after the window closes.
  -- Covers both mod_browse_cards (G._mod_suit_X) and mod_remove_cards_browse (G.mod_browse_collection).
  pcall(function()
    for _, suit in ipairs({'H','D','S','C'}) do
      local area = G['_mod_suit_'..suit]
      if area and area.cards then
        for _, c in ipairs(area.cards) do
          c.single_tap = nil; c.click = nil; c.highlighted = false
        end
      end
    end
    if G.mod_browse_collection then
      for _, area in ipairs(G.mod_browse_collection) do
        if area and area.cards then
          for _, c in ipairs(area.cards) do
            c.single_tap = nil; c.click = nil; c.highlighted = false
          end
        end
      end
    end
  end)
