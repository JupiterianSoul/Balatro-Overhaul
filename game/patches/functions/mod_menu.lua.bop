G.FUNCS.mod_add_selected_vouchers = function(e)
  if not G.GAME then return end
  if mark_run_as_modded then mark_run_as_modded("Added vouchers from mod menu") end
  local state = G.MOD_MENU_STATE
  local added = 0

  for key, _ in pairs(state.selected_vouchers) do
    local center = G.P_CENTERS[key]
    if center then
      -- Mark voucher as used
      G.GAME.used_vouchers[key] = true
      -- Create a temporary card to apply the voucher effects
      local card = Card(G.play and G.play.T.x or 0, G.play and G.play.T.y or 0,
        G.CARD_W, G.CARD_H, nil, center)
      pcall(function()
        card:apply_to_run()
      end)
      card:remove()
      added = added + 1
    end
  end

  -- FIX: Don't clear selection so user can click ADD multiple times
  if added > 0 then play_sound('timpani') end
end

