G.FUNCS.mod_remove_card_page = function(args)
r 4 603 %20%20 -
l 75
  if not G.mod_browse_collection or not G._mod_remove_deck_cards then return end
  local deck_cards = G._mod_remove_deck_cards
  local num_rows = G._mod_remove_rows or 2
  local cols = G._mod_remove_cols or 5
  local items_per_page = cols * num_rows
  local page = args.cycle_config.current_option

  for j = 1, num_rows do
    if G.mod_browse_collection[j] then
      for i = #G.mod_browse_collection[j].cards, 1, -1 do
        local c = G.mod_browse_collection[j]:remove_card(G.mod_browse_collection[j].cards[i])
        c:remove(); c = nil
      end
    end
  end

  for j = 1, num_rows do
    for i = 1, cols do
      local idx = i + (j-1)*cols + items_per_page*(page-1)
      local orig_card = deck_cards[idx]
      if orig_card then
        local card = Card(G.mod_browse_collection[j].T.x + G.mod_browse_collection[j].T.w/2,
          G.mod_browse_collection[j].T.y, G.CARD_W, G.CARD_H,
          orig_card.config.card, orig_card.config.center)
        if orig_card.seal then card:set_seal(orig_card.seal, true, true) end
        if orig_card.edition then card:set_edition(orig_card.edition, true, true) end
        card:start_materialize(nil, idx > 1)
        _mod_setup_card_select(card, G._mod_remove_selected, idx)
        G.mod_browse_collection[j]:emplace(card)
      end
    end
  end
end

G.FUNCS.mod_do_remove_selected_cards = function(e)
  if not G.GAME or not G.playing_cards or not G._mod_remove_deck_cards then return end
  if mark_run_as_modded then mark_run_as_modded("Removed cards from mod menu") end

  local deck_cards = G._mod_remove_deck_cards
  local removed = 0

  -- Remove in reverse order to preserve indices
  local indices = {}
  for idx, _ in pairs(G._mod_remove_selected) do
    table.insert(indices, idx)
  end
  table.sort(indices, function(a, b) return a > b end)

  for _, idx in ipairs(indices) do
    local target = deck_cards[idx]
    if target then
      -- Find and remove from playing_cards
      for pi = #G.playing_cards, 1, -1 do
        if G.playing_cards[pi] == target then
          table.remove(G.playing_cards, pi)
          break
        end
      end
      -- Remove from its area
      if target.area then
        target.area:remove_card(target)
      end
      target:remove()
      if G.deck then
        G.deck.config.card_limit = math.max(0, G.deck.config.card_limit - 1)
      end
      removed = removed + 1
    end
  end

  G._mod_remove_selected = {}

  if removed > 0 then
    play_sound('tarot2')
    -- Close and return
r 4 1375 %20%20%20%20 -
l 27
    G.E_MANAGER:add_event(Event({trigger='after', delay=0.15, func=function()
      pcall(function() G.FUNCS.open_mod_menu_inrun() end)
      return true
    end}))
  end
end

