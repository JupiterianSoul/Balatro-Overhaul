local function needs_switch()
  local L = loader()
  if not (L and L.switch) then return false end
  if not L.modded then return true end
  local status = L.status and L.status() or {}
  return status.restart == true
end

local function switch_to_mods(after)
  switch_saved(true, after)
end

local function mods_installed()
  local L = loader()
  local status = L and L.status and L.status() or {}
  return status.mods and #status.mods > 0 or false
end
MODS_INSTALLED = mods_installed

local function install_first()
  if G.MODS_MENU.install_note and love.timer.getTime() < G.MODS_MENU.install_note then return end
  G.MODS_MENU.install_note = love.timer.getTime() + 3
  attention_text({text = mod_loc("Install a mod first"), scale = 0.9, hold = 2, backdrop_colour = G.C.RED, align = 'cm', major = G.ROOM_ATTACH, offset = {x = 0, y = 0}})
end

G.FUNCS.mods_menu_play = function(e)
  local func = not G.SETTINGS.tutorial_complete and "start_run" or "setup_run"
  if needs_switch() then
    if not mods_installed() then return install_first() end
    return switch_to_mods(func)
  end
  G.FUNCS[func](e)
end

G.FUNCS.mods_menu_collection = function(e)
  if needs_switch() then
    if not mods_installed() then return install_first() end
    return switch_to_mods("your_collection")
  end
  G.FUNCS.your_collection(e)
end

G.FUNCS.mods_normal_game = function(e)
  switch_saved(false)
end

G.FUNCS.mods_modded_game = function(e)
  if not mods_installed() then return install_first() end
  switch_saved(true)
end

