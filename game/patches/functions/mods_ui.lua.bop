end

G.FUNCS.mods_menu_update = function(e)
  local ref = e and e.config and e.config.ref_table
  local W = workshop()
  if not (ref and W) then return end
  local entry = W.load_index().by_key[ref.key]
  if not entry then return end
  G.MODS_MENU.tab = "workshop"
  W.request_install(entry)
  W.show(W.mod_page(entry))
end

G.FUNCS.mods_menu_page = function(args)
  if not (args and args.cycle_config) then return end
  G.MODS_MENU.page = args.cycle_config.current_option
  rebuild()
end

local function switch_saved(modded, after)
