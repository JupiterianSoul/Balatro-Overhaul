local function workshop()
  return rawget(_G, "ModWorkshop")
end

local function wloc(s)
  local W = workshop()
  return W and W.loc(s) or mod_loc(s)
end

local function load_problem(entry, status)
  if not (entry.enabled and status.active and not entry.loaded and not entry.refused) then return nil end
  local S = rawget(_G, "SMODS")
  local m = S and S.Mods and entry.id and S.Mods[entry.id]
  local issues = m and m.load_issues
  if type(issues) == "table" then
    local parts = {}
    local function names(list)
      local out = {}
      for _, v in ipairs(list or {}) do out[#out + 1] = tostring(v) end
      return table.concat(out, ", ")
    end
    if type(issues.dependencies) == "table" and #issues.dependencies > 0 then parts[#parts + 1] = wloc("Needs") .. " " .. names(issues.dependencies) end
    if type(issues.conflicts) == "table" and #issues.conflicts > 0 then parts[#parts + 1] = wloc("Conflicts with") .. " " .. names(issues.conflicts) end
    if issues.outdated then parts[#parts + 1] = wloc("Outdated") end
    if issues.main_file_not_found then parts[#parts + 1] = wloc("Main file missing") end
    if #parts > 0 then return table.concat(parts, ". ") end
  end
  return wloc("Not loaded")
end

local function workshop_map()
  local W = workshop()
  if not W then return {} end
  local ok = pcall(W.load_index)
  if not ok then return {} end
  W.invalidate_local()
  local map = {}
  for _, e in ipairs(W.index.mods) do
    local lm = W.find_local(e)
    if lm and not map[lm.folder] then map[lm.folder] = e end
  end
  return map
end

local HAND_OK = "mods/.hand_ok.txt"

local function hand_key(entry)
  return (tostring(entry.folder) .. "@" .. tostring(entry.version or "")):gsub("[\r\n]", "")
end

local function hand_seen()
  local seen = {}
  for line in tostring(love.filesystem.read(HAND_OK) or ""):gmatch("[^\r\n]+") do seen[line] = true end
  return seen
end

local function hand_mod_unseen(entry)
  if not entry or not entry.folder then return false end
  local W = workshop()
  if W and W.from_workshop and W.from_workshop(entry.folder) then return false end
  return not hand_seen()[hand_key(entry)]
end

G.FUNCS.mods_menu_hand_warn = function(entry)
  G.MODS_MENU.hand_warn = {folder = entry.folder, version = entry.version, name = entry.name}
  local w = port() and 6.4 or 9
  local lines = {}
  local words, line = {}, ""
  for word in tostring(mod_loc("This mod was added by hand. It can change your game and your saves. Only turn it on if you trust where it came from.")):gmatch("%S+") do words[#words + 1] = word end
  local max_chars = port() and 34 or 52
  for _, word in ipairs(words) do
    if line ~= "" and #line + 1 + #word > max_chars then
      lines[#lines + 1] = line
      line = word
    else
      line = line == "" and word or (line .. " " .. word)
    end
  end
  if line ~= "" then lines[#lines + 1] = line end
  local rows = {
    {n=G.UIT.R, config={align = "cm", padding = 0.06}, nodes={
      {n=G.UIT.T, config={text = tostring(entry.name), scale = 0.5, colour = G.C.WHITE, shadow = true, maxw = w}},
    }},
    {n=G.UIT.R, config={align = "cm", padding = 0.04}, nodes={
      {n=G.UIT.T, config={text = mod_loc("Not from the Workshop"), scale = 0.42, colour = G.C.ORANGE, shadow = true, maxw = w}},
    }},
  }
  for _, l in ipairs(lines) do
    rows[#rows + 1] = {n=G.UIT.R, config={align = "cm", padding = 0.01}, nodes={
      {n=G.UIT.T, config={text = l, scale = 0.34, colour = G.C.UI.TEXT_LIGHT, shadow = true, maxw = w}},
    }}
  end
  rows[#rows + 1] = {n=G.UIT.R, config={align = "cm", padding = 0.12}, nodes={
    UIBox_button({button = 'mods_menu_hand_on', label = {mod_loc("Turn on")}, colour = G.C.ORANGE, minw = 3, minh = 0.7, scale = 0.5}),
  }}
  local def = create_UIBox_generic_options({
    back_func = 'mods_menu_back',
    contents = rows,
  })
  if def.config then def.config.mods_hand_warn = true end
  G.FUNCS.overlay_menu({key = 'mods_menu', definition = def})
end

G.FUNCS.mods_menu_hand_on = function(e)
  local ref = G.MODS_MENU.hand_warn
  G.MODS_MENU.hand_warn = nil
  if ref then
    love.filesystem.append(HAND_OK, hand_key(ref) .. "\n")
    local L = loader()
    if L and L.set_enabled then L.set_enabled(ref.folder, true) end
  end
  G.FUNCS.overlay_menu({definition = create_UIBox_mods_menu(), key = 'mods_menu'})
end

local function mod_row(entry, status, wmap)
  local ls = UIK.touch() and 0.37 or 0.3
  local info = {
    {n=G.UIT.R, config={align = "cl", padding = 0.01}, nodes={
      {n=G.UIT.T, config={text = entry.name, scale = 0.45, colour = G.C.WHITE, shadow = true, maxw = 3.3}},
      entry.version and {n=G.UIT.T, config={text = "  v" .. tostring(entry.version), scale = UIK.touch() and 0.37 or 0.32, colour = G.C.GOLD, shadow = true, maxw = 1.6}} or nil,
    }},
  }
  if entry.author then
    info[#info + 1] = {n=G.UIT.R, config={align = "cl", padding = 0.01}, nodes={
      {n=G.UIT.T, config={text = wloc("by") .. " " .. entry.author, scale = ls, colour = G.C.UI.TEXT_LIGHT, maxw = 5.2}},
    }}
  end
  local problem = (entry.enabled and entry.refused and sentence(entry.refused)) or load_problem(entry, status)
  if problem then
    local pw = port() and ROW_W - 1.45 or 5.5
    local lines = UIK.wrap(sentence(problem), ls, pw)
    if not port() and #lines > 2 then
      local last = table.concat(lines, " ", 2)
      while #last > 1 and ui_text_width(last .. "...", ls) > pw do
        local cut = last:gsub("[%z\1-\127\194-\244][\128-\191]*$", "")
        if #cut >= #last then break end
        last = cut
      end
      lines = {lines[1], (last:gsub("[%s,;:.(]+$", "")) .. "..."}
    end
    for _, line in ipairs(lines) do
      info[#info + 1] = {n=G.UIT.R, config={align = "cl", padding = 0.01}, nodes={
        {n=G.UIT.T, config={text = line, scale = ls, colour = G.C.RED, maxw = pw}},
      }}
    end
  end
  local W = workshop()
  local wentry = wmap and wmap[entry.folder]
  local update = W and wentry and W.entry_status(wentry) == "update" and wentry or nil
  if update then
    info[#info + 1] = {n=G.UIT.R, config={align = "cl", padding = 0.01}, nodes={
      {n=G.UIT.T, config={text = wloc("Update available") .. ": v" .. tostring(update.version):gsub("^[vV]", ""), scale = ls, colour = G.C.ORANGE, maxw = 5.2}},
    }}
  end

  local state = {on = entry.enabled}
  local toggle = create_toggle({
    label = "", w = 0, col = true,
    ref_table = state, ref_value = "on",
    callback = function(val)
      local L = loader()
      if val and hand_mod_unseen(entry) then
        state.on = false
        return G.FUNCS.mods_menu_hand_warn(entry)
      end
      if val and W and wentry and W.enable_entry then
        W.enable_entry(wentry, true)
      elseif L and L.set_enabled then
        L.set_enabled(entry.folder, val)
      end
      rebuild()
    end,
  })

  local mid_btn
  if update then
    mid_btn = with_ref(UIBox_button({
      button = 'mods_menu_update', label = {wloc("Update")}, colour = G.C.ORANGE,
      minw = 1.5, minh = _G._IS_DESKTOP and 0.55 or 0.8, scale = 0.38, col = true,
    }), {key = update.key})
  elseif config_func(entry) then
    mid_btn = with_ref(UIBox_button({
      button = 'mods_menu_config', label = {mod_loc("Config")}, colour = G.C.BLUE,
      minw = 1.5, minh = _G._IS_DESKTOP and 0.55 or 0.8, scale = 0.38, col = true,
    }), {folder = entry.folder, id = entry.id})
  else
    mid_btn = {n=G.UIT.C, config={align = "cm", minw = 1.5}, nodes={}}
  end

  local remove_btn = with_ref(UIBox_button({
    button = 'mods_menu_remove', label = {mod_loc("Remove")}, colour = G.C.RED,
    minw = 1.5, minh = _G._IS_DESKTOP and 0.55 or 0.8, scale = 0.38, col = true,
  }), {folder = entry.folder, name = entry.name})

  if port() then
    return {n=G.UIT.R, config={align = "cm", padding = 0.05}, nodes={
      {n=G.UIT.C, config={align = "cm", r = 0.1, colour = G.C.BLACK, emboss = 0.05, padding = 0.1, minw = ROW_W}, nodes={
r 15 392 %20%20%20%20%20%20%20%20 -
