G.FUNCS.mods_menu_restart = function(e)
  local S = rawget(_G, "SMODS")
  if S and S.save_all_config then pcall(S.save_all_config) end
  local L = loader()
  if L and L.switch then
    local status = L.status and L.status() or {}
    local target = L.modded and true or false
    if not G.MODS_MENU.mp_only then
      local want, running = switch_want(status)
      target = running
      if want ~= nil then target = want end
    end
    target = target and ticked_count(status) > 0
    G.MODS_MENU.want = nil
    if L.modded or target then return switch_saved(target) end
  end
  if L and L.restart then L.restart() end
end

