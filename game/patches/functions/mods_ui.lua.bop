l 7
      (restart and not port()) and UIBox_button({id = 'mods_menu_restart', button = 'mods_menu_restart', label = {mod_loc("Restart now")}, colour = G.C.GREEN, minw = 3, minh = 0.7, scale = 0.5, col = true}) or nil,
