uses_picker = function()
  local L = loader()
  return (L and L.uses_picker and L.uses_picker()) == true
end

local function zip_size(n)
  n = tonumber(n) or 0
  if n >= 1048576 then return string.format("%.1f MB", n / 1048576) end
  return string.format("%d KB", math.max(1, math.floor(n / 1024 + 0.5)))
end

local function zip_title(c)
  if c.builtin then return "Steamodded" end
  local names = {}
  for _, m in ipairs(c.mods) do names[#names + 1] = tostring(m.name) end
  return table.concat(names, ", ")
end

local function zip_replaces(c)
  for _, m in ipairs(c.mods) do if m.exists then return true end end
  return false
end

local function zip_row(c, w)
  local version = #c.mods == 1 and c.mods[1].version or nil
  local replaces = zip_replaces(c)
  local info_w = w - 2.1
  local info = {
    {n=G.UIT.R, config={align = "cl", padding = 0.01}, nodes={
      {n=G.UIT.T, config={text = zip_title(c), scale = 0.42, colour = G.C.WHITE, shadow = true, maxw = info_w - 1.4}},
      version and {n=G.UIT.T, config={text = "  v" .. tostring(version):gsub("^[vV]", ""), scale = 0.32, colour = G.C.GOLD, shadow = true, maxw = 1.3}} or nil,
    }},
    {n=G.UIT.R, config={align = "cl", padding = 0.01}, nodes={
      {n=G.UIT.T, config={text = c.name .. "  " .. zip_size(c.size) .. (c.where == "picked" and "" or (", " .. mod_loc(c.where == "mods" and "in the mods folder" or "in Downloads"))), scale = 0.3, colour = G.C.UI.TEXT_LIGHT, maxw = info_w}},
    }},
  }
  if c.builtin or replaces then
    info[#info + 1] = {n=G.UIT.R, config={align = "cl", padding = 0.01}, nodes={
      {n=G.UIT.T, config={text = mod_loc(c.builtin and "Steamodded is already built in." or "Replaces the installed version"), scale = 0.3, colour = c.builtin and G.C.UI.TEXT_INACTIVE or G.C.ORANGE, maxw = info_w}},
    }}
  end
  local action
  if c.builtin then
    action = {n=G.UIT.C, config={align = "cm", minw = 1.8}, nodes={
      {n=G.UIT.T, config={text = mod_loc("Not needed"), scale = 0.32, colour = G.C.UI.TEXT_INACTIVE, maxw = 1.7}},
    }}
  else
    action = with_ref(UIBox_button({
      button = 'mods_menu_zip_pick', label = {mod_loc(replaces and "Replace" or "Install")}, colour = replaces and G.C.ORANGE or G.C.GREEN,
      minw = 1.8, minh = _G._IS_DESKTOP and 0.6 or 0.8, scale = 0.4, col = true,
    }), c)
  end
  return {n=G.UIT.R, config={align = "cm", padding = 0.05}, nodes={
    {n=G.UIT.R, config={align = "cm", r = 0.1, colour = G.C.BLACK, emboss = 0.05, padding = 0.1, minw = w, minh = 1}, nodes={
      {n=G.UIT.C, config={align = "cl", minw = info_w, maxw = info_w}, nodes=info},
      action,
    }},
  }}
end

local function zips_window()
  zip_strings()
  local Z = G.MODS_MENU.zips or {list = {}, info = {readable = false}}
  local w = port() and 7.5 or 9.4
  local list = Z.list
  local pages = math.max(1, math.ceil(#list / ZIPS_PAGE_SIZE))
  Z.page = math.min(math.max(1, Z.page or 1), pages)
  local rows = {}
  local picked = uses_picker()
  if #list == 0 and not picked then
    rows[1] = {n=G.UIT.R, config={align = "cm", padding = 0.3}, nodes={
      {n=G.UIT.T, config={text = mod_loc(Z.info.readable and "No mod zip found in your Downloads folder." or "The game can't read your Downloads folder here."), scale = 0.4, colour = G.C.UI.TEXT_INACTIVE, maxw = w}},
    }}
  elseif #list > 0 then
    local first = (Z.page - 1) * ZIPS_PAGE_SIZE
    for i = first + 1, math.min(first + ZIPS_PAGE_SIZE, #list) do rows[#rows + 1] = zip_row(list[i], w) end
  end
  local page_options = {}
  for i = 1, pages do page_options[i] = localize('k_page') .. ' ' .. i .. '/' .. pages end
  local function line(s, colour, scale)
    return {n=G.UIT.R, config={align = "cm", padding = 0.02}, nodes={{n=G.UIT.T, config={text = s, scale = scale or 0.34, colour = colour or G.C.UI.TEXT_LIGHT, maxw = w}}}}
  end
  return create_UIBox_generic_options({
    back_func = 'mods_menu_back',
    contents = {
      {n=G.UIT.R, config={align = "cm", padding = 0.08}, nodes={{n=G.UIT.T, config={text = mod_loc("ADD A MOD FROM A ZIP"), scale = 0.55, colour = G.C.GOLD, shadow = true, maxw = w}}}},
      line(mod_loc(picked and "The zip you picked." or "Mod zips found in your Downloads folder.")),
      line(mod_loc("Nothing is installed until you pick one.")),
      line(mod_loc("Your files are never moved or deleted.")),
      Z.message and line(Z.message, Z.message_bad and G.C.RED or G.C.GREEN, 0.38) or nil,
      {n=G.UIT.R, config={align = "tm", minw = w + 0.2, minh = ZIPS_PAGE_SIZE * 1.1}, nodes={
        {n=G.UIT.C, config={align = "tm"}, nodes=rows},
      }},
      pages > 1 and {n=G.UIT.R, config={align = "cm", padding = 0.05}, nodes={
        create_option_cycle({
          options = page_options, w = 3.5, h = 0.35, scale = 0.8, cycle_shoulders = true,
          opt_callback = 'mods_menu_zip_page', current_option = Z.page,
          colour = G.C.RED, no_pips = true, focus_args = {snap_to = true},
        }),
      }} or nil,
    },
  })
end

local function zips_load(message, bad)
  local L = loader()
  local list, info = {}, {readable = false}
  if L and L.find_zips then list, info = L.find_zips() end
  G.MODS_MENU.zips = {list = list or {}, info = info or {readable = false}, page = 1, message = message, message_bad = bad}
  return G.MODS_MENU.zips
end

local function zips_scan(message, bad)
  zips_load(message, bad)
  G.FUNCS.overlay_menu({definition = zips_window(), key = 'mods_menu'})
end

local function zips_picked(res)
  if res.status == "cancel" then
    if #zips_load().list > 0 then G.FUNCS.overlay_menu({definition = zips_window(), key = 'mods_menu'}) end
    return
  end
  if #res.added == 0 then
    return zips_scan(mod_loc(#res.wrong > 0 and "That file is not a zip." or "Could not read that file."), true)
  end
  local Z = zips_load()
  local found = false
  for _, c in ipairs(Z.list) do if c.where == "picked" then found = true end end
  if not found then
    Z.message, Z.message_bad = mod_loc("No mod found in that zip."), true
    local L = loader()
    if L and L.pick_dir then L.pick_dir(true) end
  end
  G.FUNCS.overlay_menu({definition = zips_window(), key = 'mods_menu'})
end

local function zips_pick()
  zip_strings()
  local L = loader()
  local ok, P = pcall(require, "functions/file_picker")
  local dir = L and L.pick_dir and L.pick_dir(true)
  if not (ok and type(P) == "table" and dir and P.pick("zip", dir, "zip", 0, zips_picked)) then
    zips_scan(mod_loc(require("functions/file_picker").missing_text()), true)
  end
end

local EXPORT_LIMIT = 400 * 1024 * 1024

local function mods_zip_list()
  local fs, list, total = love.filesystem, {}, 0
  local function walk(dir, rel)
    for _, item in ipairs(fs.getDirectoryItems(dir)) do
      local path = dir .. "/" .. item
      local info = fs.getInfo(path)
      if info and item:sub(1, 1) ~= "." then
        if info.type == "directory" then
          walk(path, rel .. item .. "/")
        elseif info.type == "file" then
          total = total + (info.size or 0)
          list[#list + 1] = rel .. item .. "\t" .. path
        end
      end
    end
  end
  for _, name in ipairs(fs.getDirectoryItems("mods")) do
    local dir = "mods/" .. name
    if name:sub(1, 1) ~= "." and name ~= "lovely" and fs.getInfo(dir, "directory") then walk(dir, name .. "/") end
  end
  if #list == 0 then return nil, "empty" end
  if total > EXPORT_LIMIT then return nil, "big" end
  return table.concat(list, "\n"), total
end

local export_notes = {}
local function export_note(text, bad, hold)
  for _, n in ipairs(export_notes) do
    if n.AT then
      if type(n.text) == "table" and n.text.pop_out then n.text:pop_out(8) end
      if n.backdrop_colour then n.backdrop_colour[4] = 0 end
    end
  end
  export_notes = {}
  local s = mod_loc(text)
  local maxw = ((G.ROOM and G.ROOM.T and G.ROOM.T.w) or 20)*0.9
  local scale, lines = 0.7, {s}
  if UIK and UIK.text_w and UIK.text_w(s, scale) > maxw then
    scale, lines = 0.55, {}
    local cur = ""
    for word in s:gmatch("%S+") do
      local try = cur == "" and word or (cur .. " " .. word)
      if cur ~= "" and UIK.text_w(try, scale) > maxw then
        lines[#lines + 1] = cur
        cur = word
      else
        cur = try
      end
    end
    if cur ~= "" then lines[#lines + 1] = cur end
  end
  for i, l in ipairs(lines) do
    local n = {text = l, scale = scale, hold = (hold or 2.5) + (#lines - 1), backdrop_colour = bad and G.C.RED or G.C.GREEN, align = 'cm', major = G.ROOM_ATTACH, offset = {x = 0, y = (i - (#lines + 1)/2)*scale*1.5}}
    export_notes[#export_notes + 1] = n
    attention_text(n)
  end
end

local function export_saved(P, rel)
  local name = rel:match("([^/]+)$")
  local started = P.save(love.filesystem.getSaveDirectory() .. "/" .. rel, name, function(res)
    love.filesystem.remove(rel)
    if res.status == "ok" then export_note("Mods saved as a zip")
    elseif res.status ~= "cancel" then export_note("Android could not save the file", true) end
  end)
  if not started then
    love.filesystem.remove(rel)
    export_note(require("functions/file_picker").missing_text(), true)
  end
end

G.FUNCS.mods_menu_export = function(e)
  zip_strings()
  if G.MODS_MENU.exporting then return end
  local ok, P = pcall(require, "functions/file_picker")
  if not (ok and type(P) == "table" and P.available()) then return export_note(require("functions/file_picker").missing_text(), true) end
  local list, why = mods_zip_list()
  if not list then return export_note(why == "big" and "The mods are too big to save as one zip." or "No mods to save.", true) end
  local SIO = require("functions/save_io")
  love.filesystem.createDirectory("exports")
  local rel = "exports/Overhaul-mods-" .. SIO.stamp() .. ".zip"
  local chan_name = "mods_export_" .. tostring(math.random(100000, 999999))
  local okt, th = pcall(love.thread.newThread, "functions/mods_export_thread.lua")
  if not okt or not th then return export_note("Could not write the file", true) end
  G.MODS_MENU.exporting = true
  th:start(list, rel, chan_name)
  export_note("Making the zip...", false, 1.5)
  local chan = love.thread.getChannel(chan_name)
  local shown = love.timer.getTime()
r 1 112 %20%20 -
l 80
    blocking = false, blockable = false, no_delete = true, pause_force = true, timer = 'REAL',
    func = function()
      local terr = th:getError()
      local msg = chan:pop()
      while chan:getCount() > 0 do msg = chan:pop() end
      if terr then
        G.MODS_MENU.exporting = nil
        print("[mods] export failed: " .. tostring(terr))
        export_note("Could not write the file", true)
        return true
      end
      if not msg then return false end
      if msg:sub(1, 2) == "p " then
        local i, n = msg:match("^p (%d+) (%d+)")
        if love.timer.getTime() - shown > 1.6 and i then
          shown = love.timer.getTime()
          export_note(mod_loc("Making the zip...") .. " " .. math.floor(100 * tonumber(i) / math.max(1, tonumber(n))) .. "%", false, 1.5)
        end
        return false
      end
      G.MODS_MENU.exporting = nil
      if msg:sub(1, 3) == "ok " then
        export_saved(P, rel)
      else
        print("[mods] export failed: " .. msg)
        love.filesystem.remove(rel)
        export_note("Could not write the file", true)
      end
      return true
    end
  }))
end

G.FUNCS.mods_menu_zips = function(e)
  if uses_picker() then zips_pick() else zips_scan() end
end

G.FUNCS.mods_menu_zip_page = function(args)
  if not args or not args.cycle_config or not G.MODS_MENU.zips then return end
  G.MODS_MENU.zips.page = args.cycle_config.current_option
  G.FUNCS.overlay_menu({definition = zips_window(), key = 'mods_menu'})
end

local function zip_install(c)
  local L = loader()
  local mods = L and L.install_zip_choice and L.install_zip_choice(c)
  local W = workshop()
  if W and W.invalidate_local then pcall(W.invalidate_local) end
  if mods then
    zips_scan(mod_loc("Installed. Turn it on in the list."))
  else
    zips_scan(mod_loc("Could not install this zip."), true)
  end
end

G.FUNCS.mods_menu_zip_pick = function(e)
  local c = e and e.config and e.config.ref_table
  if type(c) ~= "table" or c.builtin then return end
  if not zip_replaces(c) then return zip_install(c) end
  G.MODS_MENU.zip_pending = c
  local status = (loader() and loader().status and loader().status()) or {mods = {}}
  local have = {}
  for _, m in ipairs(status.mods or {}) do have[m.folder] = m end
  local rows = {}
  for _, m in ipairs(c.mods) do
    if m.exists then
      local old = have[m.folder]
      local from = old and old.version and ("v" .. tostring(old.version):gsub("^[vV]", "")) or "?"
      local to = m.version and ("v" .. tostring(m.version):gsub("^[vV]", "")) or "?"
      rows[#rows + 1] = {n=G.UIT.R, config={align = "cm", padding = 0.03}, nodes={
        {n=G.UIT.T, config={text = tostring(old and old.name or m.name) .. "  " .. from .. " > " .. to, scale = 0.42, colour = G.C.WHITE, shadow = true, maxw = 7}},
      }}
    end
  end
  G.FUNCS.overlay_menu({key = 'mods_menu', definition = create_UIBox_generic_options({
    back_func = 'mods_menu_zip_keep', no_back = true,
    contents = {
      {n=G.UIT.R, config={align = "cm", padding = 0.1}, nodes={{n=G.UIT.T, config={text = mod_loc("REPLACE THIS MOD?"), scale = 0.55, colour = G.C.GOLD, shadow = true}}}},
      {n=G.UIT.R, config={align = "cm", padding = 0.05}, nodes={{n=G.UIT.C, config={align = "cm", r = 0.1, colour = G.C.BLACK, emboss = 0.05, padding = 0.15, minw = 7.2}, nodes=rows}}},
      {n=G.UIT.R, config={align = "cm", padding = 0.05}, nodes={{n=G.UIT.T, config={text = mod_loc("The installed copy is deleted and replaced by the zip."), scale = 0.34, colour = G.C.UI.TEXT_LIGHT, maxw = 7.2}}}},
r 15 723 %20%20%20%20%20%20 -
l 82
        UIBox_button({button = 'mods_menu_zip_keep', label = {mod_loc("Keep mine")}, colour = G.C.GREEN, minw = 3, minh = 0.75, scale = 0.45, col = true, focus_args = {snap_to = true}}),
        {n=G.UIT.C, config={align = "cm", minw = 0.3}, nodes={}},
        UIBox_button({button = 'mods_menu_zip_replace', label = {mod_loc("Replace")}, colour = G.C.RED, minw = 3, minh = 0.75, scale = 0.45, col = true}),
      }},
    },
  })})
end

G.FUNCS.mods_menu_zip_keep = function(e)
  G.MODS_MENU.zip_pending = nil
  G.FUNCS.overlay_menu({definition = zips_window(), key = 'mods_menu'})
end

G.FUNCS.mods_menu_zip_replace = function(e)
  local c = G.MODS_MENU.zip_pending
  G.MODS_MENU.zip_pending = nil
  if c then zip_install(c) end
end

function create_UIBox_mods_menu()
  local W = workshop()
  local tab = G.MODS_MENU.tab or "installed"
  if not W then return create_UIBox_generic_options({contents = {{n=G.UIT.R, config={align = "cm"}, nodes={{n=G.UIT.O, config={object = UIBox{definition = installed_tab(), config = {offset = {x = 0, y = 0}}}}}}}}}) end
  local mp = G.MODS_MENU.mp_only and rawget(_G, "mpm_mods")
  local tabs_node = create_tabs({
        snap_to_nav = true,
        tabs = {
          {label = wloc("Installed"), chosen = tab == "installed", tab_definition_function = function()
            G.MODS_MENU.tab = "installed"
            return installed_tab()
          end},
