local function switch_reason(lines, colour)
  local ls = port() and 0.3 or 0.37
  if not port() and #lines > 1 then
    local parts = {}
    for i, line in ipairs(lines) do parts[i] = mod_loc(line) end
    lines = {table.concat(parts, " ")}
  end
  local rows = {}
  for i, line in ipairs(lines) do
    rows[i] = {n=G.UIT.R, config={align = "cm", padding = 0.02}, nodes={
      {n=G.UIT.T, config={text = mod_loc(line), scale = ls, colour = colour or G.C.UI.TEXT_LIGHT, maxw = ROW_W}},
    }}
  end
  return {n=G.UIT.R, config={align = "cm", minw = ROW_W, minh = port() and 0.78 or nil}, nodes={
    {n=G.UIT.C, config={align = "cm"}, nodes=rows},
  }}
end

local function installed_tab()
  zip_strings()
  ROW_W = port() and 7.5 or 11.4
  local L = loader()
  local status = L and L.status and L.status() or {mods = {}, restart = false}
  G.MODS_MENU.status = status
  local mods = status.mods
  local pages = math.max(1, math.ceil(#mods / MODS_PAGE_SIZE))
  G.MODS_MENU.page = math.min(math.max(1, G.MODS_MENU.page or 1), pages)
  local wmap = #mods > 0 and workshop_map() or {}

  local rows = {}
  if #mods == 0 then
    rows[1] = {n=G.UIT.R, config={align = "cm", padding = 0.3}, nodes={
      {n=G.UIT.T, config={text = mod_loc("No mods installed"), scale = 0.4, colour = G.C.UI.TEXT_INACTIVE}},
    }}
  else
    local first = (G.MODS_MENU.page - 1) * MODS_PAGE_SIZE
    for i = first + 1, math.min(first + MODS_PAGE_SIZE, #mods) do
      rows[#rows + 1] = mod_row(mods[i], status, wmap)
    end
  end

  local S = rawget(_G, "SMODS")
  local changed = status.restart or (S and S.full_restart and S.full_restart ~= 0) or false
  local want, running, ticked = nil, status.modded and true or false, 0
  if not G.MODS_MENU.mp_only then want, running, ticked = switch_want(status) end
  local restart = changed or want ~= nil
  local note = G.MODS_MENU.note
  G.MODS_MENU.note = nil

  local page_options = {}
  for i = 1, pages do page_options[i] = localize('k_page') .. ' ' .. i .. '/' .. pages end

  local W = workshop()
  if W and W.layout then W.layout() end
  return {n=G.UIT.ROOT, config={align = "tm", colour = G.C.CLEAR, minw = W and W.TAB_W or ROW_W + 0.2, minh = W and W.TAB_H or nil}, nodes={
    G.MODS_MENU.mp_only and {n=G.UIT.R, config={align = "cm"}, nodes={}} or switch_row(want, running, ticked, #mods > 0),
    (G.MODS_MENU.mp_only and not changed) and {n=G.UIT.R, config={align = "cm"}, nodes={}} or switch_reason(note and {note} or switch_lines(want, running, changed), note and G.C.RED or nil),
    {n=G.UIT.R, config={align = "tm", minw = ROW_W + 0.2, minh = MODS_PAGE_SIZE * 1.1}, nodes={
      {n=G.UIT.C, config={align = "tm"}, nodes=rows},
    }},
    pages > 1 and {n=G.UIT.R, config={align = "cm", padding = 0.05}, nodes={
      create_option_cycle({
        options = page_options, w = 3.5, h = 0.35, scale = 0.8, cycle_shoulders = true,
        opt_callback = 'mods_menu_page', current_option = G.MODS_MENU.page,
        colour = G.C.RED, no_pips = true, focus_args = {snap_to = true},
      }),
    }} or nil,
    (restart and port()) and {n=G.UIT.R, config={align = "cm", padding = 0.05}, nodes={
      UIBox_button({id = 'mods_menu_restart', button = 'mods_menu_restart', label = {mod_loc("Restart now")}, colour = G.C.GREEN, minw = 3, minh = 0.7, scale = 0.5, col = true}),
    }} or nil,
