local function ticked_count(status)
  local n = 0
  for _, m in ipairs(status and status.mods or {}) do
    if m.enabled then n = n + 1 end
  end
  return n
end

local function switch_want(status)
  local L = loader()
  local running = L and L.modded and true or false
  local ticked = ticked_count(status)
  local want = G.MODS_MENU.want
  if ticked == 0 then
    G.MODS_MENU.want = nil
    want = nil
    if running then want = false end
  end
  if want == running then want = nil end
  return want, running, ticked
end

local function switch_lines(want, running, restart)
  if want == true then return {"Restart to turn mods on.", "Modded saves are kept apart."} end
  if want == false then return {"Restart to turn mods off.", "Back to your normal saves."} end
  if restart then return {"Restart to load your changes."} end
  if running then return {"Mods are on. Online: private rooms only."} end
  return {"Mods are off. Normal game and saves."}
end

