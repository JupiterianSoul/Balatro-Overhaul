  main_menu_ui(...)
  pcall(guard_collections)
  local L = loader()
  local after = L and L.after_boot
  if not after then return end
  L.after_boot = nil
  if (NORMAL_FUNCS[after] or after == "profile_select") and G.FUNCS[after] then
