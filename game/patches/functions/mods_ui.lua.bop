  if S and S.save_all_config then pcall(S.save_all_config) end
  G.FUNCS.mods_menu_back(e)
end

G.FUNCS.mods_menu_config = function(e)
  local ref = e and e.config and e.config.ref_table
  local S = rawget(_G, "SMODS")
  local mod = ref and S and S.Mods and S.Mods[ref.id]
  if not (mod and type(mod.config_tab) == "function") then
    print("[mods] no config page for " .. tostring(ref and ref.id))
