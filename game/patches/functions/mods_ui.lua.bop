local function installed_tab()
  ROW_W = port() and 7.5 or 11.4
  local L = loader()
  local status = L and L.status and L.status() or {mods = {}, restart = false}
  G.MODS_MENU.status = status
  local mods = status.mods
  local pages = math.max(1, math.ceil(#mods / MODS_PAGE_SIZE))
  G.MODS_MENU.page = math.min(math.max(1, G.MODS_MENU.page or 1), pages)
  local wmap = #mods > 0 and workshop_map() or {}

  local rows = {}
  if #mods == 0 then
    rows[1] = {n=G.UIT.R, config={align = "cm", padding = 0.3}, nodes={
      {n=G.UIT.T, config={text = mod_loc("No mods installed"), scale = 0.4, colour = G.C.UI.TEXT_INACTIVE}},
    }}
  else
    local first = (G.MODS_MENU.page - 1) * MODS_PAGE_SIZE
    for i = first + 1, math.min(first + MODS_PAGE_SIZE, #mods) do
      rows[#rows + 1] = mod_row(mods[i], status, wmap)
    end
  end

  local S = rawget(_G, "SMODS")
  local restart = status.restart or (S and S.full_restart and S.full_restart ~= 0) or false

  local page_options = {}
  for i = 1, pages do page_options[i] = localize('k_page') .. ' ' .. i .. '/' .. pages end

  local W = workshop()
  if W and W.layout then W.layout() end
  return {n=G.UIT.ROOT, config={align = "tm", colour = G.C.CLEAR, minw = W and W.TAB_W or ROW_W + 0.2, minh = W and W.TAB_H or nil}, nodes={
    G.MODS_MENU.mp_only and {n=G.UIT.R, config={align = "cm"}, nodes={}} or {n=G.UIT.R, config={align = "cm", padding = 0.05}, nodes={
      UIBox_button({id = 'mods_menu_play', button = 'mods_menu_play', label = {localize('b_play_cap')}, colour = G.C.BLUE, minw = (ROW_W + 0.2 - GAP_W) / 2, minh = 0.9, scale = 0.6, col = true}),
      {n=G.UIT.C, config={align = "cm", minw = GAP_W}, nodes={}},
      UIBox_button({id = 'mods_menu_collection', button = 'mods_menu_collection', label = {localize('b_collection_cap')}, colour = G.C.ORANGE, minw = (ROW_W + 0.2 - GAP_W) / 2, minh = 0.9, scale = 0.6, col = true}),
    }},
    {n=G.UIT.R, config={align = "tm", minw = ROW_W + 0.2, minh = MODS_PAGE_SIZE * 1.1}, nodes={
      {n=G.UIT.C, config={align = "tm"}, nodes=rows},
    }},
    pages > 1 and {n=G.UIT.R, config={align = "cm", padding = 0.05}, nodes={
      create_option_cycle({
        options = page_options, w = 3.5, h = 0.35, scale = 0.8, cycle_shoulders = true,
        opt_callback = 'mods_menu_page', current_option = G.MODS_MENU.page,
        colour = G.C.RED, no_pips = true, focus_args = {snap_to = true},
      }),
    }} or nil,
    restart and {n=G.UIT.R, config={align = "cm", padding = 0.05}, nodes={
      UIBox_button({button = 'mods_menu_restart', label = {mod_loc("Restart")}, colour = G.C.GREEN, minw = 3, minh = 0.7, scale = 0.5}),
    }} or nil,
  }}
end

function create_UIBox_mods_menu()
  local W = workshop()
  local tab = G.MODS_MENU.tab or "installed"
  if not W then return create_UIBox_generic_options({contents = {{n=G.UIT.R, config={align = "cm"}, nodes={{n=G.UIT.O, config={object = UIBox{definition = installed_tab(), config = {offset = {x = 0, y = 0}}}}}}}}}) end
  local mp = G.MODS_MENU.mp_only and rawget(_G, "mpm_mods")
  local tabs_node = create_tabs({
        snap_to_nav = true,
        tabs = {
          {label = wloc("Installed"), chosen = tab == "installed", tab_definition_function = function()
            G.MODS_MENU.tab = "installed"
            return installed_tab()
          end},
          {label = wloc("Workshop"), chosen = tab == "workshop", tab_definition_function = function()
            G.MODS_MENU.tab = "workshop"
            return W.workshop_tab()
          end},
          rawget(_G, "JokerForge") and {label = mod_loc("Forged"), chosen = tab == "forge", tab_definition_function = function()
            G.MODS_MENU.tab = "forge"
            return JokerForge.mods_tab()
          end} or nil,
        },
      })
  return create_UIBox_generic_options({
    back_func = mp and 'mpm_mods_back' or nil,
    contents = mp and {mp.header(), tabs_node} or {tabs_node},
  })
end

G.FUNCS.mods_button = function(e)
  local L = loader()
  if L and L.scan_downloads then pcall(L.scan_downloads) end
  G.MODS_MENU.page = 1
  G.MODS_MENU.tab = G.MODS_MENU.tab or "installed"
  G.FUNCS.overlay_menu({definition = create_UIBox_mods_menu(), key = 'mods_menu'})
end

G.FUNCS.mods_menu_update = function(e)
  local ref = e and e.config and e.config.ref_table
  local W = workshop()
  if not (ref and W) then return end
  local entry = W.load_index().by_key[ref.key]
  if not entry then return end
  G.MODS_MENU.tab = "workshop"
  W.request_install(entry)
  W.show(W.mod_page(entry))
end

G.FUNCS.mods_menu_page = function(args)
  if not (args and args.cycle_config) then return end
  G.MODS_MENU.page = args.cycle_config.current_option
  rebuild()
end

