local function mods_installed()
  local L = loader()
  local status = L and L.status and L.status() or {}
  return status.mods and #status.mods > 0 or false
end
MODS_INSTALLED = mods_installed

G.FUNCS.mods_normal_game = function(e)
  switch_saved(false)
end

G.FUNCS.mods_modded_game = function(e)
  if not mods_installed() then return mods_note("Install a mod first") end
  local L = loader()
  if not (L and L.bare_ok and L.bare_ok()) and ticked_count(L and L.status and L.status()) == 0 then return mods_note("Tick at least one mod first") end
  switch_saved(true)
end

local switch_menu_once = false
local class_main_menu = Game.main_menu
function Game:main_menu(change_context, ...)
  if switch_menu_once then
    switch_menu_once = false
    change_context = 'switch'
  end
  return class_main_menu(self, change_context, ...)
end

