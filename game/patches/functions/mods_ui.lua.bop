local collection_guarded = setmetatable({}, {__mode = "k"})

local collection_live = {open = false}

local function collection_failed(where, err)
  print("[mods] collection screen " .. tostring(where) .. " failed: " .. tostring(err))
  collection_live.open = false
  collection_live.grace = 120
  pcall(function()
r 13 1825 %20%20%20%20 -
l 10
    attention_text({text = mod_loc("That collection page failed to open"), scale = 0.7, hold = 2.5, backdrop_colour = G.C.RED, align = 'cm', major = G.ROOM_ATTACH, offset = {x = 0, y = 0}})
  end)
end

local function collection_in_view()
  if (collection_live.grace or 0) > 0 then
    collection_live.grace = collection_live.grace - 1
    return true
  end
  if not collection_live.open then return false end
r 3 349 %20%20 -
l 77
    collection_live.open = false
    return false
  end
  return true
end

local function guard_frame_calls()
  if collection_live.hooked then return end
  collection_live.hooked = true
  local EM = rawget(_G, "EventManager")
  if EM and EM.add_event then
    local add_event = EM.add_event
    EM.add_event = function(self, event, ...)
      if collection_in_view() and type(event) == "table" and type(event.func) == "function" then
        local func = event.func
        event.func = function(...)
          local res = {pcall(func, ...)}
          if res[1] then return unpack(res, 2) end
          collection_failed("event", res[2])
          return true
        end
      end
      return add_event(self, event, ...)
    end
  end
  for _, key in ipairs({"update", "draw", "mousepressed", "mousereleased", "mousemoved", "wheelmoved", "keypressed", "keyreleased", "touchpressed", "touchreleased", "touchmoved", "gamepadpressed", "gamepadreleased", "gamepadaxis"}) do
    local fn = love[key]
    if type(fn) == "function" then
      love[key] = function(...)
        if not collection_in_view() then return fn(...) end
        local res = {pcall(fn, ...)}
        if res[1] then return unpack(res, 2) end
        if key == "draw" then
          pcall(love.graphics.setCanvas)
          pcall(function() for _ = 1, 64 do love.graphics.pop() end end)
          pcall(love.graphics.origin)
          pcall(love.graphics.setColor, 1, 1, 1, 1)
        end
        collection_failed(key, res[2])
      end
    end
  end
end

local function guard_collections()
  pcall(guard_frame_calls)
  local names = {}
  for name, fn in pairs(G.FUNCS) do
    if type(name) == "string" and name:sub(1, 15) == "your_collection" and type(fn) == "function" and not collection_guarded[fn] then
      names[#names + 1] = name
    end
  end
  for _, name in ipairs(names) do
    local fn = G.FUNCS[name]
    local wrapped = function(...)
      local res = {pcall(fn, ...)}
      if res[1] then
        collection_live.open = true
        return unpack(res, 2)
      end
      collection_failed(name, res[2])
    end
    collection_guarded[fn] = true
    collection_guarded[wrapped] = true
    G.FUNCS[name] = wrapped
  end
end

local main_menu_ui = set_main_menu_UI
