G.FUNCS.mods_menu_remove_confirm = function(e)
  local ref = G.MODS_MENU.removing
  G.MODS_MENU.removing = nil
  local L = loader()
  if ref and L and L.remove_mod then L.remove_mod(ref.folder) end
  local W = workshop()
  if ref and W and W.forget_folder then pcall(W.forget_folder, ref.folder) end
  G.MODS_MENU.icons["mods_menu_icon_" .. tostring(ref and ref.folder)] = nil
  G.FUNCS.overlay_menu({definition = create_UIBox_mods_menu(), key = 'mods_menu'})
end

G.FUNCS.mods_menu_back = function(e)
  G.ACTIVE_MOD_UI = nil
