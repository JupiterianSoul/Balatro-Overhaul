local MODS_PAGE_SIZE = 5
local ROW_W = 11.4
local function port() return rawget(_G, 'UIK') ~= nil and UIK.portrait() or false end
local GAP_W = 0.2
local uses_picker
local NORMAL_FUNCS = {
  setup_run = true,
  start_run = true,
  your_collection = true,
  open_achievements_menu = true,
  open_tavern_hub = true,
  open_multiplayer_menu = true,
  open_progression_screen = true,
}

G.MODS_MENU = G.MODS_MENU or {page = 1, icons = {}}

local function loader()
  return rawget(_G, "MODLOADER")
end

local function smods_mod(entry)
  local S = rawget(_G, "SMODS")
  if not (entry.loaded and entry.id and S and S.Mods) then return nil end
  return S.Mods[entry.id]
end

local function config_func(entry)
  local m = smods_mod(entry)
  if m and type(m.config_tab) == "function" then return m end
end

local function icon_atlas(entry)
  local smod = smods_mod(entry)
  if smod and smod.prefix then
    local a = G.ASSET_ATLAS[smod.prefix .. "_modicon"]
    if a and a.image then return a end
  end
  local key = "mods_menu_icon_" .. entry.folder
  if G.MODS_MENU.icons[key] ~= nil then return G.MODS_MENU.icons[key] or nil end
  G.MODS_MENU.icons[key] = false
  local names = {}
  if entry.icon_path then names[#names + 1] = entry.icon_path end
  if entry.prefix then names[#names + 1] = entry.prefix .. "_icon.png" end
  names[#names + 1] = "icon.png"
  names[#names + 1] = "modicon.png"
  local scale = (G.SETTINGS and G.SETTINGS.GRAPHICS and G.SETTINGS.GRAPHICS.texture_scaling) or 1
  for _, name in ipairs(names) do
    for _, s in ipairs({scale, 1}) do
      local path = entry.dir .. "/assets/" .. s .. "x/" .. name
      if love.filesystem.getInfo(path, "file") then
        local ok, img = pcall(love.graphics.newImage, path, {mipmaps = true, dpiscale = s})
        if ok and img then
          local w, h = img:getDimensions()
          local px = entry.icon_width and entry.icon_width < w and entry.icon_width or w
          local atlas = {name = key, image = img, px = px, py = h, type = "asset_atli"}
          G.ASSET_ATLAS[key] = atlas
          G.MODS_MENU.icons[key] = atlas
          return atlas
        end
      end
    end
  end
  return nil
end

local function icon_node(entry)
  local atlas = icon_atlas(entry)
  if not atlas then
    return {n=G.UIT.C, config={align = "cm", minw = 0.8, minh = 0.8}, nodes={}}
  end
  local sprite = Sprite(0, 0, 0.8, 0.8, atlas, {x = 0, y = 0})
  sprite.states.drag.can = false
  sprite:define_draw_steps({
r 15 662 %20%20%20%20 -
r 4 505 %20%20%20%20 -
l 17
  })
  return {n=G.UIT.C, config={align = "cm", minw = 0.8, minh = 0.8}, nodes={
    {n=G.UIT.O, config={object = sprite}},
  }}
end

local function with_ref(button, ref)
  button.nodes[1].config.ref_table = ref
  return button
end

local function sentence(s)
  s = tostring(s or "")
  return s:sub(1, 1):upper() .. s:sub(2) .. (s:match("[%.!?]$") and "" or ".")
end

