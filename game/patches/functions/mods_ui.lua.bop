G.FUNCS.mods_menu_restart = function(e)
  local S = rawget(_G, "SMODS")
  if S and S.save_all_config then pcall(S.save_all_config) end
  local L = loader()
  if L and L.modded and L.switch then
    local any = false
    for _, m in ipairs((L.status and L.status() or {}).mods or {}) do
      if m.enabled then any = true end
    end
    return switch_saved(any)
  end
  if L and L.restart then L.restart() end
end

