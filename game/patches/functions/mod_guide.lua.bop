local function guide_1105_lines(list)
  local out = {}
  for _, l in ipairs(list) do
    if l[1] == "" then
      out[#out + 1] = {text = ""}
    elseif l[2] then
      out[#out + 1] = {text = mod_loc(l[1]), scale = 0.45, colour = l[2]}
    else
      out[#out + 1] = {text = mod_loc(l[1]), scale = 0.39}
    end
  end
  return out
end

for _, p in ipairs(GUIDE_1105) do
  G.FUNCS[p.fn] = function(e)
    G.FUNCS.overlay_menu{definition = build_two_columns(mod_loc(p.title), guide_1105_lines(p.left), guide_1105_lines(p.right))}
  end
end

