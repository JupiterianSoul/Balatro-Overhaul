local function resolve_colour(name)
  if not name or not G or not G.C then return G.C.WHITE end
  local map = {
    BLUE = G.C.BLUE, RED = G.C.RED, GREEN = G.C.GREEN, GOLD = G.C.GOLD,
    ORANGE = G.C.ORANGE, PURPLE = G.C.PURPLE, WHITE = G.C.WHITE,
    MONEY = G.C.MONEY, GREY = G.C.L_BLACK,
  }
  return map[name] or G.C.WHITE
end

local function build_line_rows(lines)
  local rows = {}
  for _, line in ipairs(lines) do
    if line.text == "" then
      table.insert(rows, {n=G.UIT.R, config={align = "cm", padding = 0.01}, nodes={}})
    else
      local colour = resolve_colour(line.colour)
      local scale = line.scale or 0.39
      table.insert(rows, {n=G.UIT.R, config={align = "cl", padding = 0.006}, nodes={
        {n=G.UIT.T, config={text = line.text, scale = scale, colour = colour}}
      }})
    end
  end
  return rows
end

local function build_single_column(title, lines)
  local rows = build_line_rows(lines)
  return create_UIBox_generic_options({
    back_func = 'guide_back_to_guide_tab',
    contents = {
      {n=G.UIT.R, config={align = "cm", padding = 0.03}, nodes={
        {n=G.UIT.T, config={text = title, scale = 0.59, colour = G.C.GOLD, shadow = true}}
      }},
      {n=G.UIT.R, config={align = "cm", padding = 0.02}, nodes={
        {n=G.UIT.C, config={align = "tl", padding = 0.06, minw = 5.6}, nodes=rows}
      }},
    }
  })
end

local function build_two_columns(title, left_lines, right_lines)
  local left_rows = build_line_rows(left_lines)
  local right_rows = build_line_rows(right_lines)
  return create_UIBox_generic_options({
    back_func = 'guide_back_to_guide_tab',
    contents = {
      {n=G.UIT.R, config={align = "cm", padding = 0.03}, nodes={
        {n=G.UIT.T, config={text = title, scale = 0.59, colour = G.C.GOLD, shadow = true}}
      }},
      {n=G.UIT.R, config={align = "tm", padding = 0.02}, nodes={
        {n=G.UIT.C, config={align = "tl", padding = 0.06, minw = 4.2}, nodes=left_rows},
        {n=G.UIT.C, config={align = "cm", minw = 0.15}, nodes={}},
        {n=G.UIT.C, config={align = "tl", padding = 0.06, minw = 4.2}, nodes=right_rows},
      }},
    }
  })
end

