PlayerName = PlayerName or {}
local P = PlayerName

local TEXT = {
  fr = {
    ["Choose your name"] = "Choisissez votre nom",
    ["Your name for this profile and for multiplayer"] = "Votre nom pour ce profil et en multijoueur",
    ["Pick your own name"] = "Choisissez votre nom",
    ["That name is already used"] = "Ce nom est déjà pris",
    ["Confirm"] = "Valider",
  },
  es = {
    ["Choose your name"] = "Elige tu nombre",
    ["Your name for this profile and for multiplayer"] = "Tu nombre para este perfil y en multijugador",
    ["Pick your own name"] = "Elige tu propio nombre",
    ["That name is already used"] = "Ese nombre ya está en uso",
    ["Confirm"] = "Confirmar",
  },
}

local function t(s)
  local lang = G.SETTINGS and G.SETTINGS.language or "en-us"
  if lang == "es_ES" or lang == "es_419" then lang = "es" end
  return TEXT[lang] and TEXT[lang][s] or s
end
P.text = t

local function trim(s)
  return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

function P.is_default(name)
  local n = trim(name):lower()
  if n == "" or n == "error" then return true end
  if n:match("^p%s*%d+$") or n:match("^player%s*%d*$") or n:match("^m%s*[1-3]$") then return true end
  return false
end

local function profile()
  return G.PROFILES and G.SETTINGS and G.PROFILES[G.SETTINGS.profile]
end

local NAME_FILE = "player_name.txt"

local function fs()
  return love.mod_filesystem or love.filesystem
end

function P.shared()
  if P._shared == nil then
    local ok, s = pcall(function() return fs().getInfo(NAME_FILE) and fs().read(NAME_FILE) end)
    s = ok and type(s) == "string" and trim(s):sub(1, 32) or ""
    if P.is_default(s) and G.SETTINGS and type(G.SETTINGS.player_name) == "string" then s = trim(G.SETTINGS.player_name) end
    P._shared = (not P.is_default(s)) and s or false
  end
  return P._shared or nil
end

function P.remember(name)
  name = trim(name)
  if P.is_default(name) or P.shared() == name then return end
  P._shared = name
  pcall(fs().write, NAME_FILE, name)
end

function P.adopt()
  local prof = profile()
  if not prof then return end
  local name = P.shared()
  if not name then
    if not P.is_default(prof.name) then P.remember(prof.name) end
    return
  end
  if prof.name ~= name then
    prof.name = name
    G:save_progress()
  end
end

function P.current()
  local prof = profile()
  return prof and prof.name
end

