    end
    return true
  end}))
end

G.FUNCS.player_name_confirm = function(e)
  P.confirm()
end

G.FUNCS.player_name_prompt = function(e)
  P.prompt({can_cancel = true})
end

G.FUNCS.player_name_cancel = function(e)
  local st = P.state
  P.state = nil
