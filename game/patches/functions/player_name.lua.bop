function P.prompt(opts)
  opts = opts or {}
  local cur = trim(P.current())
  P.state = {
    name = (P.is_default(cur) or (opts.taken and cur:lower() == trim(opts.taken):lower())) and "" or cur,
    error = opts.message or "",
    taken = opts.taken,
    can_cancel = opts.can_cancel and true or false,
    on_done = opts.on_done,
    on_cancel = opts.on_cancel,
  }
  local st = P.state
r 13 1381 %20%20 -
