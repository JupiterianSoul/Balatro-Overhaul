  if st and st.on_cancel then
    local ok, err = pcall(st.on_cancel)
    if not ok then print("[player_name] on_cancel: " .. tostring(err)) end
  end
end

function P.check()
  pcall(P.adopt)
  local L = rawget(_G, "MODLOADER")
  if L and L.modded then return end
  if os.getenv("NO_NAME_PROMPT") == "1" then return end
  if not P.is_default(P.current()) then return end
  G.E_MANAGER:add_event(Event({blockable = false, blocking = false, func = function()
    if G.STAGE ~= G.STAGES.MAIN_MENU then return true end
    if G.OVERLAY_MENU or G.OVERLAY_TUTORIAL then return false end
    if P.is_default(P.current()) then P.prompt() end
    return true
  end}))
end

local main_menu_ui = set_main_menu_UI
function set_main_menu_UI(...)
  main_menu_ui(...)
  P.check()
end
end
