  G.FUNCS.overlay_menu({definition = P.definition(), config = {no_esc = not st.can_cancel}})
  if G.F_MOBILE or (G.CONTROLLER.HID and G.CONTROLLER.HID.controller and not G.CONTROLLER.HID.keyboard) then return end
  G.E_MANAGER:add_event(Event({blockable = false, blocking = false, func = function()
    if P.state ~= st or not G.OVERLAY_MENU then return true end
    local input = G.OVERLAY_MENU:get_UIE_by_ID('text_input')
    if input and not G.CONTROLLER.text_input_hook then G.FUNCS.select_text_input(input) end
    return true
  end}))
end

function P.confirm()
  local st = P.state
  if not st then return end
  local name = trim(st.name)
  if P.is_default(name) then
    st.error = t("Pick your own name")
    return
  end
  if st.taken and name:lower() == trim(st.taken):lower() then
    st.error = t("That name is already used")
    return
  end
  local prof = profile()
  if prof then
    prof.name = name
    P.remember(name)
    G:save_settings()
    G:save_progress()
