    if args and args.bo_forge_test then
      if not P.sandbox then P.sandbox_begin() end
      local BM = rawget(_G, "BoosterManager")
      local inv = BM and BM.get_inventory
      if inv then BM.get_inventory = function() return {} end end
      local res = {pcall(orig, e, args)}
      if inv then BM.get_inventory = inv end
      if not res[1] then error(res[2], 0) end
      return unpack(res, 2)
    end
    return orig(e, args)
  end
end

if mod_loc_register then mod_loc_register{
  fr = {
    ["Progress is off for this run: %s"] = "Progression désactivée pour cette partie : %s",
    ["Progress is off"] = "Progression désactivée",
    ["replay"] = "replay",
    ["Forge test"] = "test de la Forge",
    ["Forge content"] = "contenu de la Forge",
    ["cheats"] = "triches",
    ["custom run"] = "partie personnalisée",
    ["mods"] = "mods",
  },
  es = {
    ["Progress is off for this run: %s"] = "Progreso desactivado en esta partida: %s",
    ["Progress is off"] = "Progreso desactivado",
    ["replay"] = "repetición",
    ["Forge test"] = "prueba de la Forja",
    ["Forge content"] = "contenido de la Forja",
    ["cheats"] = "trucos",
    ["custom run"] = "partida personalizada",
    ["mods"] = "mods",
  },
} end

return P
