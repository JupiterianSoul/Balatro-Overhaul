local function seed_library_file()
  local L = rawget(_G, "MODLOADER")
  return (L and L.modded) and "modded_seed_library.jkr" or "seed_library.jkr"
end
local SEED_LIBRARY_MAX  = 20

local function seed_library_load()
  local seeds = {}
  pcall(function()
    local data = love.filesystem.read(seed_library_file())
    if data then
      for line in data:gmatch("[^\n]+") do
        local parts = {}
        for part in (line .. "|||"):gmatch("([^|]*)|") do
          table.insert(parts, part)
          if #parts == 4 then break end
        end
        local seed = parts[1] or ""
        if seed ~= "" then
          table.insert(seeds, {
            seed  = seed,
            name  = parts[2] or "",
            deck  = parts[3] or "",
            stake = tonumber(parts[4]) or 1,
          })
        end
      end
    end
  end)
  return seeds
end

local function seed_library_save(seeds)
  local lines = {}
  for _, e in ipairs(seeds) do
    table.insert(lines,
      e.seed
      .. "|" .. (e.name  or ""):gsub("|","")
      .. "|" .. (e.deck  or ""):gsub("|","")
      .. "|" .. tostring(e.stake or 1))
  end
  pcall(function() love.filesystem.write(seed_library_file(), table.concat(lines, "\n")) end)
end

local _seed_lib_cache = nil
local function seed_library_get()
  if not _seed_lib_cache then _seed_lib_cache = seed_library_load() end
  return _seed_lib_cache
end
local function seed_library_invalidate() _seed_lib_cache = nil end

local _seed_lib_page        = 1
local SEEDS_PER_PAGE        = 3
local _seed_lib_rename_target = nil
local _seed_edit_target     = nil
local _seed_edit_deck_opts  = {}
local _seed_edit_deck_idx   = 1
local _seed_edit_stake      = 1

local function seed_lib_get_deck_opts()
  local opts = {}
  if G.P_CENTER_POOLS and G.P_CENTER_POOLS.Back then
    for _, v in ipairs(G.P_CENTER_POOLS.Back) do
      if not v.omit then table.insert(opts, {name = v.name or "?", key = v.key or ""}) end
    end
  end
  if #opts == 0 then opts = {{name = "Red Deck", key = "b_red"}} end
  return opts
end

local function seed_lib_stake_name(n)
  local ok, result = pcall(function()
    return localize{type='name_text', set='Stake', key=G.P_CENTER_POOLS.Stake[n].key}
  end)
  return (ok and result and result ~= "") and (n .. " - " .. result) or tostring(n)
end

function create_UIBox_seed_library()
  local seeds = seed_library_get()
  local total_pages = math.max(1, math.ceil(#seeds / SEEDS_PER_PAGE))
  _seed_lib_page = math.min(_seed_lib_page, total_pages)
  local page = _seed_lib_page
  local start_idx = (page - 1) * SEEDS_PER_PAGE + 1
  local end_idx   = math.min(start_idx + SEEDS_PER_PAGE - 1, #seeds)

  local rows = {}

  table.insert(rows, {n=G.UIT.R, config={align="cm", padding=0.08}, nodes={
    {n=G.UIT.T, config={text=mod_loc("SEED LIBRARY"), scale=0.65, colour=G.C.GOLD, shadow=true}}
  }})

  table.insert(rows, {n=G.UIT.R, config={align="cm", padding=0.05}, nodes={
    UIBox_button({label={mod_loc("Paste from Clipboard")}, button='seed_lib_paste_clipboard', minw=7.0, minh=0.97, colour=G.C.GREEN, scale=0.52}),
  }})

  if #seeds == 0 then
    table.insert(rows, {n=G.UIT.R, config={align="cm", padding=0.13}, nodes={
      {n=G.UIT.T, config={text=mod_loc("No seeds saved yet"), scale=0.45, colour=G.C.UI.TEXT_INACTIVE}}
    }})
    table.insert(rows, {n=G.UIT.R, config={align="cm", padding=0.04}, nodes={
      {n=G.UIT.T, config={text=mod_loc("Paste a seed, or save one from Options during a run!"), scale=0.35, colour=G.C.UI.TEXT_INACTIVE}}
    }})
  else
    for i = start_idx, end_idx do
      local entry = seeds[i]
      if entry then
        local display_name = (entry.name ~= "" and entry.name) or (mod_loc("Seed") .. " #" .. i)
        local sub_info = entry.seed
        if entry.deck and entry.deck ~= "" then
          sub_info = sub_info .. "   " .. entry.deck .. "  ·  " .. mod_loc("Stake") .. " " .. (entry.stake or 1)
        end
        table.insert(rows, {n=G.UIT.R, config={align="cm", padding=0.04}, nodes={
          {n=G.UIT.C, config={align="cm", padding=0.05, r=0.08, colour=G.C.L_BLACK, emboss=0.04, minw=5.5}, nodes={
            {n=G.UIT.R, config={align="cl", padding=0.04}, nodes={
              {n=G.UIT.C, config={align="cl"}, nodes={
                {n=G.UIT.T, config={text=display_name, scale=0.40, colour=G.C.WHITE}},
              }},
            }},
            {n=G.UIT.R, config={align="cl", padding=0.02}, nodes={
              {n=G.UIT.C, config={align="cl"}, nodes={
                {n=G.UIT.T, config={text=sub_info, scale=0.31, colour=G.C.GOLD}},
              }},
            }},
            {n=G.UIT.R, config={align="cm", padding=0.04}, nodes={
              {n=G.UIT.C, config={align="cm", padding=0.02}, nodes={UIBox_button({label={mod_loc("Play")},   button='seed_lib_play_'..i,   minw=1.15, minh=0.58, colour=G.C.GREEN,  scale=0.36})}},
              {n=G.UIT.C, config={align="cm", padding=0.02}, nodes={UIBox_button({label={mod_loc("Edit")},   button='seed_lib_edit_'..i,   minw=1.15, minh=0.58, colour=G.C.BLUE,   scale=0.36})}},
              {n=G.UIT.C, config={align="cm", padding=0.02}, nodes={UIBox_button({label={mod_loc("Rename")}, button='seed_lib_rename_'..i, minw=1.15, minh=0.58, colour=G.C.ORANGE, scale=0.36})}},
              {n=G.UIT.C, config={align="cm", padding=0.02}, nodes={UIBox_button({label={mod_loc("Del")},    button='seed_lib_delete_'..i, minw=1.15, minh=0.58, colour=G.C.RED,   scale=0.36})}},
            }},
          }},
        }})
      end
    end
  end

  if total_pages > 1 then
    local page_options = {}
    for p = 1, total_pages do
      table.insert(page_options, localize('k_page') .. ' ' .. p .. '/' .. total_pages)
    end
    table.insert(rows, {n=G.UIT.R, config={align="cm", padding=0.05}, nodes={
      create_option_cycle({options=page_options, w=5.85, cycle_shoulders=true,
        opt_callback='seed_lib_page', current_option=page,
        colour=G.C.RED, no_pips=true, focus_args={snap_to=true, nav='wide'}})
    }})
  end

  table.insert(rows, {n=G.UIT.R, config={align="cm", padding=0.04}, nodes={
    {n=G.UIT.T, config={text=#seeds.."/"..SEED_LIBRARY_MAX.." "..mod_loc("seeds saved"), scale=0.32, colour=G.C.UI.TEXT_INACTIVE}}
  }})

  return create_UIBox_generic_options({back_func='exit_overlay_menu', contents=rows})
end

G.FUNCS.open_seed_library = function(e)
  seed_library_invalidate()
  _seed_lib_page = 1
  if G.FUNCS.trigger_sub_showcase_seed_library then
    G.FUNCS.trigger_sub_showcase_seed_library()
  end
  G.FUNCS.overlay_menu{definition=create_UIBox_seed_library()}
end

local function seed_lib_refresh()
  G.E_MANAGER:add_event(Event({trigger='after', delay = 0, func=function()
    seed_library_invalidate()
    G.FUNCS.overlay_menu{definition=create_UIBox_seed_library()}
    return true
  end}))
end

G.FUNCS.seed_lib_page = function(args)
r 4 603 %20%20 -
l 176
  _seed_lib_page = args.cycle_config.current_option
  seed_lib_refresh()
end

G.FUNCS.seed_lib_save_current = function(e)
  if not G or not G.GAME or not G.GAME.pseudorandom or not G.GAME.pseudorandom.seed then
    pcall(function() play_sound('cancel') end)
    return
  end
  local seeds = seed_library_get()
  if #seeds >= SEED_LIBRARY_MAX then
    pcall(function() play_sound('cancel') end)
    return
  end
  local current_seed  = G.GAME.pseudorandom.seed
  local current_deck  = (G.GAME.selected_back and G.GAME.selected_back.name) or ""
  local current_stake = G.GAME.stake or 1
  for _, entry in ipairs(seeds) do
    if entry.seed == current_seed then
      pcall(function() play_sound('cancel') end)
      return
    end
  end
  table.insert(seeds, {seed=current_seed, name="", deck=current_deck, stake=current_stake})
  seed_library_save(seeds)
  seed_library_invalidate()
  pcall(function() play_sound('timpani') end)
end

G.FUNCS.seed_lib_paste_clipboard = function(e)
  local seeds = seed_library_get()
  if #seeds >= SEED_LIBRARY_MAX then
    pcall(function() play_sound('cancel') end)
    return
  end
  local clip = ""
  pcall(function()
    clip = G.F_LOCAL_CLIPBOARD and (G.CLIPBOARD or "") or (love.system.getClipboardText() or "")
  end)
  clip = (clip:match("^%s*(.-)%s*$") or ""):upper():gsub("[^A-Z0-9]", "")
  if clip == "" or #clip > 12 then
    pcall(function() play_sound('cancel') end)
    return
  end
  for _, entry in ipairs(seeds) do
    if entry.seed == clip then
      pcall(function() play_sound('cancel') end)
      return
    end
  end
  table.insert(seeds, {seed=clip, name="", deck="", stake=1})
  seed_library_save(seeds)
  pcall(function() play_sound('timpani') end)
  seed_lib_refresh()
end

function create_UIBox_seed_edit(idx)
  local seeds = seed_library_get()
  local entry = seeds[idx] or {seed="", name="", deck="", stake=1}

  _seed_edit_deck_opts = seed_lib_get_deck_opts()
  _seed_edit_deck_idx  = 1
  for di, dv in ipairs(_seed_edit_deck_opts) do
    if dv.name == entry.deck then _seed_edit_deck_idx = di; break end
  end
  _seed_edit_stake = math.max(1, entry.stake or 1)

  G._seed_edit_input = entry.seed or ""

  local deck_names = {}
  for _, dv in ipairs(_seed_edit_deck_opts) do table.insert(deck_names, dv.name) end

  local stake_names = {}
  local max_stake = (G.P_CENTER_POOLS and G.P_CENTER_POOLS.Stake and #G.P_CENTER_POOLS.Stake) or 8
  for si = 1, max_stake do table.insert(stake_names, seed_lib_stake_name(si)) end

  return create_UIBox_generic_options({
    back_func = 'seed_lib_edit_cancel',
    contents = {
      {n=G.UIT.R, config={align="cm", padding=0.08}, nodes={
        {n=G.UIT.T, config={text=mod_loc("EDIT SEED"), scale=0.45, colour=G.C.GOLD}}
      }},
      {n=G.UIT.R, config={align="cm", padding=0.03}, nodes={
        {n=G.UIT.T, config={text=mod_loc("Seed:"), scale=0.34, colour=G.C.UI.TEXT_LIGHT}}
      }},
      {n=G.UIT.R, config={align="cm", padding=0.06}, nodes={
        create_text_input({
          w=5.5, max_length=12, prompt_text=mod_loc("Enter seed..."),
          ref_table=G, ref_value='_seed_edit_input',
          all_caps=true, keyboard_offset=1
        })
      }},
      {n=G.UIT.R, config={align="cm", padding=0.05}, nodes={
        create_option_cycle({label=mod_loc("Deck"), options=deck_names, w=5.5,
          opt_callback='seed_lib_edit_deck', current_option=_seed_edit_deck_idx,
          colour=G.C.PURPLE})
      }},
      {n=G.UIT.R, config={align="cm", padding=0.05}, nodes={
        create_option_cycle({label=mod_loc("Stake"), options=stake_names, w=5.5,
          opt_callback='seed_lib_edit_stake', current_option=_seed_edit_stake,
          colour=G.C.RED})
      }},
      {n=G.UIT.R, config={align="cm", padding=0.08}, nodes={
        UIBox_button({label={mod_loc("Confirm")}, button='seed_lib_edit_confirm', minw=4.5, minh=0.8, colour=G.C.GREEN, scale=0.42}),
      }},
    }
  })
end

G.FUNCS.seed_lib_edit_deck = function(args)
  if args and args.cycle_config then _seed_edit_deck_idx = args.cycle_config.current_option end
end
G.FUNCS.seed_lib_edit_stake = function(args)
  if args and args.cycle_config then _seed_edit_stake = args.cycle_config.current_option end
end

G.FUNCS.seed_lib_edit_cancel = function(e)
  G._seed_edit_input = nil; _seed_edit_target = nil
  G.E_MANAGER:add_event(Event({trigger='after', delay = 0, func=function()
    seed_library_invalidate()
    G.FUNCS.overlay_menu{definition=create_UIBox_seed_library()}
    return true
  end}))
end

G.FUNCS.seed_lib_edit_confirm = function(e)
  local idx = _seed_edit_target
  if idx then
    local seeds = seed_library_get()
    if seeds[idx] then
      local new_seed = (G._seed_edit_input or ""):upper():gsub("[^A-Z0-9]",""):sub(1,12)
      if new_seed ~= "" then seeds[idx].seed = new_seed end
      local chosen = _seed_edit_deck_opts[_seed_edit_deck_idx]
      if chosen then seeds[idx].deck = chosen.name end
      seeds[idx].stake = _seed_edit_stake or seeds[idx].stake
      seed_library_save(seeds)
    end
  end
  G._seed_edit_input = nil; _seed_edit_target = nil
  pcall(function() play_sound('timpani') end)
  G.E_MANAGER:add_event(Event({trigger='after', delay = 0, func=function()
    seed_library_invalidate()
    G.FUNCS.overlay_menu{definition=create_UIBox_seed_library()}
    return true
  end}))
end

local _original_FUNCS_index = getmetatable(G.FUNCS) and getmetatable(G.FUNCS).__index
if not getmetatable(G.FUNCS) then setmetatable(G.FUNCS, {}) end
local _FUNCS_mt = getmetatable(G.FUNCS)
_FUNCS_mt.__index = function(t, key)
  local play_idx = key:match("^seed_lib_play_(%d+)$")
  if play_idx then
    play_idx = tonumber(play_idx)
    return function(e)
      local seeds = seed_library_get()
      local entry = seeds[play_idx]
      if not entry then return end
      if G.OVERLAY_MENU then G.OVERLAY_MENU:remove(); G.OVERLAY_MENU = nil end
      if entry.deck and entry.deck ~= "" then
        local center = get_deck_from_name(entry.deck)
        if center and center.unlocked then G.GAME.viewed_back = Back(center) end
      end
      local max = G.P_CENTER_POOLS and G.P_CENTER_POOLS.Stake and #G.P_CENTER_POOLS.Stake or 8
      local vb = G.GAME.viewed_back and G.GAME.viewed_back.effect and G.GAME.viewed_back.effect.center
      if PlayRandom and PlayRandom.max_stake then max = math.min(max, PlayRandom.max_stake(vb and vb.key or "b_red")) end
      G.FUNCS.start_run(nil, {stake = math.max(1, math.min(max, tonumber(entry.stake) or 1)), seed = entry.seed})
    end
  end
  local edit_idx = key:match("^seed_lib_edit_(%d+)$")
  if edit_idx then
    edit_idx = tonumber(edit_idx)
    return function(e)
      local seeds = seed_library_get()
      local entry = seeds[edit_idx]
      if not entry then return end
r 4 1375 %20%20%20%20%20%20 -
l 14
      G.E_MANAGER:add_event(Event({trigger='after', delay=0.1, func=function()
        _seed_edit_target = edit_idx
        G.FUNCS.overlay_menu{definition=create_UIBox_seed_edit(edit_idx)}
        return true
      end}))
    end
  end
  local rename_idx = key:match("^seed_lib_rename_(%d+)$")
  if rename_idx then
    rename_idx = tonumber(rename_idx)
    return function(e)
      local seeds = seed_library_get()
      local entry = seeds[rename_idx]
      if not entry then return end
r 4 1375 %20%20%20%20%20%20 -
l 87
      G.E_MANAGER:add_event(Event({trigger='after', delay=0.1, func=function()
        _seed_lib_rename_target = rename_idx
        G._seed_rename_input = entry.name or ""
        G.FUNCS.overlay_menu{definition=create_UIBox_seed_rename(rename_idx, entry.name, entry.seed)}
        return true
      end}))
    end
  end
  local delete_idx = key:match("^seed_lib_delete_(%d+)$")
  if delete_idx then
    delete_idx = tonumber(delete_idx)
    return function(e)
      local seeds = seed_library_get()
      if seeds[delete_idx] then
        table.remove(seeds, delete_idx)
        seed_library_save(seeds)
        pcall(function() play_sound('card1') end)
        seed_lib_refresh()
      end
    end
  end
  if _original_FUNCS_index then
    if type(_original_FUNCS_index) == "function" then return _original_FUNCS_index(t, key)
    elseif type(_original_FUNCS_index) == "table" then return _original_FUNCS_index[key] end
  end
  return nil
end

