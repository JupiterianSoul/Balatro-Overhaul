      }},
      {n=G.UIT.R, config={align="cm", padding=0.04}, nodes={
        {n=G.UIT.T, config={text=seed_text or "", scale=0.35, colour=G.C.UI.TEXT_LIGHT}}
      }},
      {n=G.UIT.R, config={align="cm", padding=0.08}, nodes={
        create_text_input({
          w=5, max_length=30, prompt_text=mod_loc("Enter name..."),
          ref_table=G, ref_value='_seed_rename_input',
          extended_corpus=true, keyboard_offset=1
        })
      }},
      {n=G.UIT.R, config={align="cm", padding=0.08}, nodes={
        UIBox_button({label={mod_loc("Confirm")}, button='seed_lib_rename_confirm', minw=4, minh=0.8, colour=G.C.GREEN, scale=0.42}),
      }},
