function create_quest_tab(tab_type)
  QuestUI.current_tab = tab_type
  QuestUI.current_page = 1

  if not G or not G.PROFILES or not G.SETTINGS or not G.SETTINGS.profile then
    return {n=G.UIT.ROOT, config={align = "cm", padding = 0.1, colour = G.C.CLEAR}, nodes={
      {n=G.UIT.T, config={text = mod_loc("Loading..."), scale = 0.4, colour = G.C.WHITE}}
    }}
  end

  local profile = G.PROFILES[G.SETTINGS.profile]
  if not profile or not profile.quests then
    if QuestManager then
      QuestManager.initialized = false
      pcall(function() QuestManager.init() end)
      pcall(function() QuestManager.check_daily_reset() end)
      pcall(function() QuestManager.check_weekly_reset() end)
    end
    profile = G.PROFILES[G.SETTINGS.profile]
    if not profile or not profile.quests then
      return {n=G.UIT.ROOT, config={align = "cm", padding = 0.1, colour = G.C.CLEAR}, nodes={
        {n=G.UIT.T, config={text = mod_loc("Play a run to unlock quests!"), scale = 0.4, colour = G.C.WHITE}}
      }}
    end
  end

  local quests = {}
  local reset_time = ""
  local completed_text = ""

  if tab_type == "daily" then
    quests = profile.quests.daily_quests or {}
    reset_time = mod_loc("Resets in: ") .. (QuestManager.get_time_until_daily_reset and QuestManager.get_time_until_daily_reset() or "??h ??m")
    completed_text = mod_loc("Completed Today: ") .. (profile.quests.daily_completed_today or 0) .. "/" .. #quests
  elseif tab_type == "weekly" then
    quests = profile.quests.weekly_quests or {}
    reset_time = mod_loc("Resets in: ") .. (QuestManager.get_time_until_weekly_reset and QuestManager.get_time_until_weekly_reset() or "?d ?h")
    completed_text = mod_loc("Completed This Week: ") .. (profile.quests.weekly_completed_this_week or 0) .. "/" .. #quests
  elseif tab_type == "repeatable" then
    quests = profile.quests.repeatable_quests or {}
    reset_time = mod_loc("Always Available")
    completed_text = mod_loc("Total Completed: ") .. (profile.quests.total_quests_completed or 0)
  end

  local quest_nodes = {}
  for i, quest in ipairs(quests) do
    if i <= QuestUI.items_per_page then
      table.insert(quest_nodes, create_quest_card(quest, i))
    end
  end

  if #quest_nodes == 0 then
    table.insert(quest_nodes, {n=G.UIT.R, config={align = "cm", padding = 0.17}, nodes={
      {n=G.UIT.T, config={text = mod_loc("No quests available"), scale = 0.442, colour = G.C.WHITE}}
    }})
  end

  return {n=G.UIT.ROOT, config={align = "cm", padding = 0.0425, colour = G.C.CLEAR, minw = 7.735, minh = 6.0775}, nodes={
    {n=G.UIT.R, config={align = "cm", padding = 0.0255}, nodes={
      {n=G.UIT.C, config={align = "cl", minw = 3.8675}, nodes={
        {n=G.UIT.T, config={text = mod_loc(string.upper(tab_type) .. " QUESTS"), scale = 0.442, colour = G.C.WHITE, shadow = true}}
      }},
      {n=G.UIT.C, config={align = "cr", minw = 3.8675}, nodes={
        {n=G.UIT.T, config={text = reset_time, scale = 0.3315, colour = G.C.ORANGE}}
      }},
    }},

    {n=G.UIT.R, config={align = "cm", padding = 0.017, minh = 0.017, minw = 7.735, colour = G.C.L_BLACK}, nodes={}},

    {n=G.UIT.R, config={align = "tm", padding = 0.0255}, nodes={
      {n=G.UIT.C, config={align = "tm", padding = 0.017}, nodes=quest_nodes}
    }},

    {n=G.UIT.R, config={align = "cm", padding = 0.0425}, nodes={
      {n=G.UIT.T, config={text = completed_text, scale = 0.3315, colour = G.C.WHITE}}
    }},

    tab_type == "repeatable" and {n=G.UIT.R, config={align = "cm", padding = 0.0425}, nodes={
      UIBox_button({label = {mod_loc("Reroll Quests")}, button = 'reroll_repeatable_quests', minw = 3.315, minh = 0.663, colour = G.C.ORANGE, scale = 0.387})
    }} or nil,
  }}
end

function create_quest_card(quest, index)
  if not quest then return nil end

  local progress_percent = quest.target > 0 and (quest.progress / quest.target) or 0
  progress_percent = math.min(1, math.max(0, progress_percent))

  local status_text = ""
  local status_color = G.C.WHITE

  if quest.claimed then
    status_text = mod_loc("[CLAIMED]")
    status_color = G.C.GREY
  elseif quest.completed then
    status_text = mod_loc("[COMPLETED]")
    status_color = G.C.GREEN
  else
    status_text = mod_loc("[IN PROGRESS]")
    status_color = G.C.ORANGE
  end

  local difficulty_color = get_difficulty_color(quest.difficulty)
  local bar_color = quest.completed and G.C.GREEN or G.C.BLUE

  local card_nodes = {
    {n=G.UIT.R, config={align = "cm", padding = 0.017}, nodes={
      {n=G.UIT.C, config={align = "cl", minw = 4.7515}, nodes={
        {n=G.UIT.T, config={text = mod_loc(quest.name), scale = 0.387, colour = G.C.WHITE, shadow = true}}
      }},
      {n=G.UIT.C, config={align = "cr", minw = 2.21}, nodes={
        {n=G.UIT.T, config={text = status_text, scale = 0.276, colour = status_color}}
      }},
    }},

    {n=G.UIT.R, config={align = "cm", padding = 0.0085}, nodes={
      {n=G.UIT.C, config={align = "cl", minw = 6.9615}, nodes={
        {n=G.UIT.T, config={text = mod_loc(quest.description), scale = 0.309, colour = G.C.WHITE}}
      }},
    }},

    {n=G.UIT.R, config={align = "cm", padding = 0.0255}, nodes={
      {n=G.UIT.C, config={align = "cl", minw = 6.0775, minh = 0.276, r = 0.085, colour = G.C.L_BLACK, emboss = 0.017}, nodes={
        {n=G.UIT.C, config={align = "cl", minw = 6.0775 * progress_percent, minh = 0.221, r = 0.068, colour = bar_color}, nodes={}}
      }},
      {n=G.UIT.C, config={align = "cr", minw = 0.884, padding = 0.017}, nodes={
        {n=G.UIT.T, config={text = math.floor(progress_percent * 100) .. "%", scale = 0.276, colour = G.C.WHITE}}
      }},
    }},

    {n=G.UIT.R, config={align = "cm", padding = 0.017}, nodes={
      {n=G.UIT.C, config={align = "cl", minw = 2.7625}, nodes={
        {n=G.UIT.T, config={text = mod_loc("Progress: ") .. quest.progress .. "/" .. quest.target, scale = 0.276, colour = G.C.UI.TEXT_LIGHT}}
      }},
      {n=G.UIT.C, config={align = "cr", minw = 4.199}, nodes={
        {n=G.UIT.T, config={text = "+" .. quest.xp_reward .. " XP, +" .. quest.currency_reward .. " BC", scale = 0.276, colour = G.C.GOLD}}
      }},
    }},
  }

  if quest.completed and not quest.claimed then
    table.insert(card_nodes, {n=G.UIT.R, config={align = "cm", padding = 0.0255}, nodes={
      {n=G.UIT.C, config={
        align = "cm",
        minw = 2.7625,
        minh = 0.5525,
        r = 0.085,
        colour = G.C.GREEN,
        hover = true,
        shadow = true,
        button = "claim_quest_reward",
        ref_table = {quest = quest, index = index, tab = QuestUI.current_tab}
      }, nodes={
        {n=G.UIT.T, config={text = mod_loc("CLAIM REWARD"), scale = 0.3315, colour = G.C.WHITE}}
      }}
    }})
  end

  return {n=G.UIT.R, config={align = "cm", padding = 0.0425, r = 0.085, colour = G.C.L_BLACK, emboss = 0.0255, minw = 7.1825}, nodes=card_nodes}
end


