  G.E_MANAGER:add_event(Event({trigger='after', delay = 0, func=function()
    seed_library_invalidate()
    G.FUNCS.overlay_menu{definition=create_UIBox_seed_library()}
    return true
  end}))
end

G.FUNCS.seed_lib_rename_confirm = function(e)
  local idx = _seed_lib_rename_target
  local new_name = (G._seed_rename_input or ""):gsub("|",""):sub(1,30)
  if idx then
    local seeds = seed_library_get()
    if seeds[idx] then seeds[idx].name = new_name; seed_library_save(seeds) end
  end
  G._seed_rename_input = nil; _seed_lib_rename_target = nil
  pcall(function() play_sound('timpani') end)
  G.E_MANAGER:add_event(Event({trigger='after', delay = 0, func=function()
    seed_library_invalidate()
    G.FUNCS.overlay_menu{definition=create_UIBox_seed_library()}
    return true
  end}))
end


