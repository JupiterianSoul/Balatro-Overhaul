local QuestUI = {
  current_tab = "daily",
  current_page = 1,
  items_per_page = 4,
}

local function get_difficulty_color(difficulty)
  if not G or not G.C then return {1,1,1,1} end
  if difficulty == "easy" then return G.C.GREEN end
  if difficulty == "medium" then return G.C.ORANGE end
  if difficulty == "hard" then return G.C.RED end
  if difficulty == "low" then return G.C.BLUE end
  return G.C.WHITE
end

