l 28
  -- FIX: Resolve #N# or Steamodded #<s>N# / #<plural,singular>N# variable references
  -- Cryptid localization uses #<s>1# ("Chip#<s>1#" → "Chip" or "Chips") which vanilla
  -- loc_parse_string stores as {"<s>1"}.  tonumber("<s>1") == nil → "ERROR" without this.
  local function _resolve_var(vars, ref)
    if type(vars) ~= 'table' then vars = {} end
    local n = tonumber(ref)
    if n then return vars[n] or 'ERROR' end
    -- Single-suffix form: #<s>1# → "" (singular) or "s" (plural)
    local suffix, si = ref:match("^<([^,>]+)>(%d+)$")
    if suffix then
      local v = vars[tonumber(si)]
      return (not v or tonumber(v) == 1) and '' or suffix
    end
    -- Two-form: #<ies,y>1# → "ies" (plural) or "y" (singular)
    local pl, sg, pi = ref:match("^<([^,>]+),([^>]+)>(%d+)$")
    if pl then
      local v = vars[tonumber(pi)]
      return (not v or tonumber(v) == 1) and sg or pl
    end
    return ''
  end
  if args == nil then
    if not G.LOCALIZE_NIL_LOGGED then
      G.LOCALIZE_NIL_LOGGED = true
      print("localize called with nil args\n" .. debug.traceback())
    end
    return 'ERROR'
  end
