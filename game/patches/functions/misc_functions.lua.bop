local PHONE_GC_CALM = {}
local phone_gc_live, phone_gc_state = nil, nil

function phone_gc()
	if not PHONE_GC_CALM.ready and G and G.STATES then
		PHONE_GC_CALM.ready = true
		for _, k in ipairs({"SHOP", "BLIND_SELECT", "ROUND_EVAL", "MENU", "GAME_OVER", "SPLASH"}) do
			if G.STATES[k] then PHONE_GC_CALM[G.STATES[k]] = true end
		end
	end
	local mem = collectgarbage("count")
	local live = phone_gc_live or mem
	local soft = live * 1.5 + 16384
	local budget = 3e-4
	if mem > soft then budget = mem > soft * 1.5 and 2e-3 or 1e-3 end
	local state = G and G.STATE
	if state ~= phone_gc_state then
		phone_gc_state = state
		if PHONE_GC_CALM[state] and mem > live * 1.2 then budget = 4e-3 end
	end
	local start = love.timer.getTime()
	local steps = 0
	while love.timer.getTime() - start < budget and steps < 4000 do
		steps = steps + 1
		if collectgarbage("step", 1) then
			mem = collectgarbage("count")
			phone_gc_live = mem
			if mem < live * 1.5 + 16384 then break end
		end
	end
	if collectgarbage("count") > 307200 then
