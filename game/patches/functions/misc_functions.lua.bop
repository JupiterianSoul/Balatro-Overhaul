local function drag_zones()
  local j, c, d, p = G.jokers.T, G.consumeables.T, G.deck.T, G.play.T
  local function zone(x, y, w, h) return Moveable{T = {x = x, y = y, w = w, h = h}} end
  return {
    S_buy = zone(j.x, j.y - 0.1, c.x + c.w - j.x, j.h + 0.6),
    S_buy_and_use = zone(d.x + 0.2, d.y - 5.1, d.w - 0.1, 4.5),
    C_sell = zone(j.x, j.y - 0.2, j.w, j.h + 0.6),
    J_sell = zone(c.x + 0.3, c.y - 0.2, c.w - 0.3, c.h + 0.6),
    C_use = zone(d.x + 0.2, d.y - 5.1, d.w - 0.1, 4.5),
    P_select = zone(p.x, p.y - 2, p.w + 2, p.h + 1),
  }
end

local function drop_zone(cover, colour, text, card, can, on_release)
  drag_target({cover = cover, colour = adjust_alpha(colour, 0.9), text = text, card = card, active_check = can, release_func = on_release})
end

local function priced(key, amount)
  local lines = copy_table(localize(key))
  lines[#lines + 1] = '$'..amount
  return lines
end

local function use_dropped(other)
  G.FUNCS.use_card({config = {ref_table = other}})
end

local function tutorial_wants(button)
  if G.OVERLAY_TUTORIAL and G.OVERLAY_TUTORIAL.button_listen == button then G.FUNCS.tut_next() end
end

create_drag_target_from_card = function(_card)
  if not _card or G.STAGE ~= G.STAGES.RUN then return end
  G.DRAG_TARGETS = G.DRAG_TARGETS or drag_zones()
  local Z, area = G.DRAG_TARGETS, _card.area
  if not area then return end

  if area == G.shop_jokers or area == G.shop_vouchers or area == G.shop_booster then
    local key = (area == G.shop_vouchers and 'ml_redeem_target') or (area == G.shop_booster and 'ml_open_target') or 'ml_buy_target'
    drop_zone(Z.S_buy, G.C.GREEN, priced(key, _card.cost), _card,
      function(other) return G.FUNCS.card_can_buy(other) end,
      function(other)
        if not G.FUNCS.card_can_buy(other) then return end
        if other.area == G.shop_jokers then
          tutorial_wants('buy_from_shop')
          G.FUNCS.buy_from_shop({config = {ref_table = other, id = 'buy'}})
        elseif other.area == G.shop_vouchers or other.area == G.shop_booster then
          use_dropped(other)
        end
      end)
    if G.FUNCS.card_can_buy_and_use(_card) then
      drop_zone(Z.S_buy_and_use, G.C.ORANGE, priced('ml_buy_and_use_target', _card.cost), _card,
        function(other) return G.FUNCS.card_can_buy_and_use(other) end,
        function(other)
          if G.FUNCS.card_can_buy_and_use(other) then
            G.FUNCS.buy_from_shop({config = {ref_table = other, id = 'buy_and_use'}})
          end
        end)
    end
  end

  if area == G.pack_cards then
    if _card.ability.consumeable and _card.ability.set ~= 'Planet' then
      drop_zone(Z.C_use, G.C.RED, {localize('b_use')}, _card,
        function(other) return other:can_use_consumeable() end,
        function(other) if other:can_use_consumeable() then use_dropped(other) end end)
    else
      drop_zone(Z.P_select, G.C.GREEN, {localize('b_select')}, _card,
        function(other) return G.FUNCS.can_select_card(other) end,
        function(other) if G.FUNCS.can_select_card(other) then use_dropped(other) end end)
    end
  end

  if area == G.jokers or area == G.consumeables then
    local price = _card.facing == 'back' and '?' or _card.sell_cost
    drop_zone(area == G.consumeables and Z.C_sell or Z.J_sell, G.C.GOLD, priced('ml_sell_target', price), _card,
      function(other) return other:can_sell_card() end,
      function(other) G.FUNCS.sell_card{config = {ref_table = other}} end)
r 4 2270 %20%20%20%20 -
l 29
      drop_zone(Z.C_use, G.C.RED, {localize('b_use')}, _card,
        function(other) return other:can_use_consumeable() end,
        function(other)
          if not other:can_use_consumeable() then return end
          use_dropped(other)
          tutorial_wants('use_card')
        end)
    end
  end
end

function set_profile_flag(_flag)
  rawset(G.SETTINGS, _flag, true)
  for _, profile in pairs(G.PROFILES or {}) do
    profile.flags = profile.flags or {}
    profile.flags[_flag] = true
  end
end

function get_profile_flag(_flag)
  if rawget(G.SETTINGS, _flag) then
    set_profile_flag(_flag)
    return true
  end
  for _, profile in pairs(G.PROFILES or {}) do
    profile.flags = profile.flags or {}
    if profile.flags[_flag] then return true end
  end
end
end
