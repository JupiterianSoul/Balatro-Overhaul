function apply_gc_tuning(on)
  collectgarbage("setpause", on and 150 or 200)
  collectgarbage("setstepmul", 200)
end

local deferred_files = {}
local deferred_files_mt = {
  __index = function(t, k)
    local data = deferred_files[k]
    if data == nil then return nil end
    deferred_files[k] = nil
    local v = STR_UNPACK(STR_PACK(data))
    rawset(t, k, v)
    return v
  end,
  __newindex = function(t, k, v)
    deferred_files[k] = nil
    rawset(t, k, v)
  end,
}

function defer_file_copy(key, data)
  if not G.FILES then G.FILES = {} end
  if getmetatable(G.FILES) ~= deferred_files_mt then setmetatable(G.FILES, deferred_files_mt) end
  rawset(G.FILES, key, nil)
  deferred_files[key] = data
end

