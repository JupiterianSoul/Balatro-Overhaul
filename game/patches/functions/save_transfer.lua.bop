function T.modded_only(p)
  if type(p.info) ~= "table" or #p.info == 0 then return false end
  for _, e in ipairs(p.info) do
    if not e.modded then return false end
  end
  return true
end

function T.confirm_window(p)
  local w = row_w()
  return UIK.window{
    id = 'save_transfer_confirm', title = L("IMPORT THIS SAVE?"), compact = true, w = w + 0.6,
    back_func = 'save_transfer_main',
    build = function()
      local rows = {UIK.value{label = L("File"), value = p.name, w = w, vw = w - 0.4}}
      for i, e in ipairs(p.info) do
        if i <= 3 then
          local run = e.run and string.format(L("Run in progress: Ante %d, round %d"), e.run.ante, e.run.round) or L("No run in progress")
          rows[#rows + 1] = UIK.value{label = who(e), value = string.format(L("%d wins, %d discovered, %d unlocked"), e.wins, e.discovered, e.unlocked),
            info = run, w = w, vw = w - 0.4}
        end
      end
      if p.when then
        rows[#rows + 1] = UIK.value{label = L("Saved on"), value = os.date("%Y-%m-%d %H:%M", p.when), w = w, vw = w - 0.4}
      end
      local notes = {L("Replace your save? Yours is backed up first."), L("The game restarts to load it.")}
      if #p.dropped > 0 then table.insert(notes, 1, string.format(L("%d files are left out: they are not plain save data."), #p.dropped)) end
      rows[#rows + 1] = UIK.note(notes, {w = w})
      return UIK.stack(rows, {w = w})
    end,
    footer = {UIK.button{label = L("REPLACE MY SAVE"), button = 'save_transfer_load', ref_table = p, colour = UIK.C.ok, w = math.min(w, 5.4)}},
  }
end

function T.restart()
  if MODLOADER and MODLOADER.restart then
    return MODLOADER.restart()
  end
  love.event.quit("restart")
end

function T.load(p)
  if not (p and p.files and SIO.check(p.files)) then return false end
  local data = SIO.zip(SIO.entries(p.files))
  fs.createDirectory(T.IMPORTS)
  if not fs.write(T.PENDING, data) or fs.read(T.PENDING) ~= data then
    fs.remove(T.PENDING)
    return false
  end
  T.restart()
  return true
end

G.FUNCS.save_transfer_main = function() T.open() end
G.FUNCS.save_transfer_import = function() T.open() end
G.FUNCS.save_transfer_export_tab = function() T.open() end
G.FUNCS.save_transfer_from_profile = function() T.open(nil, 'profile_select') end
G.FUNCS.save_transfer_from_settings = function() T.open(nil, 'settings') end
G.FUNCS.save_transfer_export_from_profile = function() T.open(nil, 'profile_select') end
G.FUNCS.save_transfer_export_from_settings = function() T.open(nil, 'settings') end

G.FUNCS.save_transfer_pick = function(e)
  local entry = e and e.config and e.config.ref_table
  if not entry then return end
  T.preview_data(fs.read(entry.rel) or "", entry.name)
end

G.FUNCS.save_transfer_load = function(e)
  local p = e and e.config and e.config.ref_table
  if not T.load(p) then
    T.status = {text = L("Could not write the save. Nothing was changed."), kind = "error"}
    T.open()
  end
end

local function desktop_os()
  local ok, osn = pcall(love.system.getOS)
  osn = ok and osn or ""
  return SIO.dialog_osn(osn) and osn or nil
end

