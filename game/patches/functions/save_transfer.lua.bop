SaveTransfer = SaveTransfer or {}
local T = SaveTransfer
local SIO = require("functions/save_io")

T.EXPORTS, T.IMPORTS, T.BACKUPS = "exports", "imports", "backups"
T.PENDING = "imports/pending.zip"

local fs = love.filesystem

local function L(s)
  return mod_loc and mod_loc(s) or s
end

local function phone()
  local osn = love.system.getOS()
  return osn == "Android" or osn == "iOS"
end

local function picker()
  local ok, P = pcall(require, "functions/file_picker")
  if ok and type(P) == "table" and P.available() then return P end
  return nil
end

local function keep_settings(name)
  return SIO.skip(name) and not SIO.SKIP_FILES[name]
end

function T.backup(tag, incoming)
  local files = SIO.collect(fs, "", keep_settings)
  if incoming then files = SIO.with_touched(fs, incoming, files) end
  if not next(files) then return true, files end
  local name = SIO.backup(fs, T.BACKUPS, tag, files)
  return name, name and files or nil
end

function T.read(data, name)
  local files, err, meta = SIO.read_any(data, name or "save.zip")
  if not files then return nil, err end
  return files, nil, meta
end

function T.apply_pending()
  if not fs.getInfo(T.PENDING) then return end
  local data = fs.read(T.PENDING)
  local files, err = T.read(data or "")
  if not files then
    print("[SAVES] pending import refused: " .. tostring(err))
    fs.remove(T.PENDING)
    return nil, err
  end
  files = SIO.mirror_modded(files)
  local name, backed = T.backup("before-import", files)
  if not name then
    print("[SAVES] pending import kept: backup failed")
    return nil, "backup"
  end
  local n, werr = SIO.apply(fs, files, backed)
  fs.remove(T.PENDING)
  print("[SAVES] imported " .. tostring(n) .. " files" .. (werr and (", failed at " .. tostring(werr)) or ""))
  T.just_imported = n
  return n, werr
end

function T.export_data()
  local files = SIO.collect(fs, "")
  if not SIO.check(files) then return nil, "empty" end
  return SIO.zip(SIO.entries(files))
end

function T.export()
  local data, err = T.export_data()
  if not data then return nil, err end
  fs.createDirectory(T.EXPORTS)
  local rel = T.EXPORTS .. "/" .. SIO.export_name()
  if not fs.write(rel, data) then return nil, "write" end
  return rel, data
end

function T.list()
  local out = {}
  for _, dir in ipairs({T.IMPORTS, T.EXPORTS, T.BACKUPS}) do
    for _, name in ipairs(fs.getDirectoryItems(dir)) do
      local rel = dir .. "/" .. name
      local info = fs.getInfo(rel)
      if rel ~= T.PENDING and name:lower():match("%.zip$") and info and info.type == "file" then
        out[#out + 1] = {rel = rel, dir = dir, name = name, time = info.modtime or 0}
      end
    end
  end
  local rank = {[T.IMPORTS] = 1, [T.EXPORTS] = 2, [T.BACKUPS] = 3}
  table.sort(out, function(a, b)
    if rank[a.dir] ~= rank[b.dir] then return rank[a.dir] < rank[b.dir] end
    if a.time ~= b.time then return a.time > b.time end
    return a.rel > b.rel
  end)
  return out
end

local function who(e)
  local base = e.name or ("P" .. e.slot:gsub("^modded", ""))
  if e.modded then
    local m = e.slot:match("^modded(%d*)$") or ""
    return L("Modded") .. (m ~= "" and (" " .. m) or "") .. (e.name and (" " .. e.name) or "")
  end
  return base
end

function T.summary(entry)
  if entry.info == nil then
    local files = T.read(fs.read(entry.rel) or "")
    entry.info = files and SIO.preview(files) or false
  end
  if not entry.info then return L("Not a save file") end
  local parts = {}
  for _, p in ipairs(entry.info) do
    parts[#parts + 1] = string.format(L("%s: %d wins"), who(p), p.wins)
  end
  return #parts > 0 and table.concat(parts, "   ") or L("Empty save")
end

local function refresh()
  if UIK and UIK.refresh then UIK.refresh() end
end

local function set_status(text, kind)
  T.status = text and {text = text, kind = kind or "info"} or nil
  refresh()
end

local ERR = {
  not_zip = "This is not a save file. Pick an exported .zip or a Balatro .jkr file.",
  too_big = "This file is too big to be a save.",
  bad_zip = "This save file is damaged.",
  damaged = "This save file is damaged.",
  no_profile = "There is no profile in this file.",
  not_found = "Could not read that file.",
}

function T.err_text(err)
  return L(ERR[err] or "Could not read that file.")
end

function T.show_preview(files, meta, name)
  local p = {files = files, name = name or "", info = SIO.preview(files), dropped = meta and meta.dropped or {}, when = meta and meta.when}
  T.preview_save = p
  G.FUNCS.overlay_menu{definition = T.confirm_window(p)}
  return p
end

function T.preview_data(data, name)
  local files, err, meta = T.read(data, name)
  if not files then
    set_status(T.err_text(err), "error")
    return nil, err
  end
  return T.show_preview(files, meta, name)
end

function T.preview_path(path)
  path = tostring(path or ""):gsub("\\", "/")
  local base = path:match("([^/]+)$") or path
  if path:lower():match("%.jkr$") then
    local root = path:match("^(.*)/[123]/[^/]+$")
    if root then
      local files, err = SIO.read_folder_io(root)
      if not files then
        set_status(T.err_text(err), "error")
        return nil, err
      end
      return T.show_preview(files, {dropped = err}, root:match("([^/]+)$") or root)
    end
  end
  local data, err = SIO.read_path(path)
  if not data then
    set_status(T.err_text(err), "error")
    return nil, err
  end
  return T.preview_data(data, base)
end

function T.dropped(file)
  local name = file and file.getFilename and file:getFilename() or ""
  local low = name:lower()
  if not (low:match("%.zip$") or low:match("%.jkr$")) then return false end
  if low:match("%.jkr$") then
    T.open()
    T.preview_path(name)
    return true
  end
  local ok = pcall(function() file:open("r") end)
  local data = ok and file:read() or nil
  pcall(function() file:close() end)
  if not data or not T.read(data, name) then return false end
  T.open()
  T.preview_data(data, name:gsub("\\", "/"):match("([^/]+)$"))
  return true
end

function T.open_folder(dir)
  fs.createDirectory(dir)
  love.system.openURL("file://" .. fs.getSaveDirectory() .. "/" .. dir)
end

local DIR_LABEL = {imports = "Imported", exports = "Exported", backups = "Backup"}

local function row_w()
  return UIK.portrait() and UIK.row_w(1) or UIK.row_w(2)
end

local function file_label(e)
  local kind = L(DIR_LABEL[e.dir] or "Save")
  if (e.time or 0) > 0 then return kind .. ", " .. os.date("%Y-%m-%d %H:%M", e.time) end
  return kind .. ": " .. e.name:gsub("%.zip$", "")
end

local STATUS_COLOUR = {ok = "GREEN", error = "RED", info = "GOLD"}

local function main_page()
  local w = row_w()
  local rows = {
    UIK.action{id = 'st_export', label = L("Export my save"), info = L("All your profiles in one .zip file"), button_label = L("Export"), button = 'save_transfer_export', colour = UIK.C.ok, w = w},
    UIK.action{id = 'st_import', label = L("Import a save"), info = L("An exported .zip or a Balatro save from Steam"), button_label = L("Import"), button = 'save_transfer_import_file', colour = UIK.C.accent, w = w},
  }
  if T.status then
    local lines = {T.status.text}
    if UIK.portrait() then
      local a, b = T.status.text:match("^(.-[%.!?:])%s+(.+)$")
      if a then lines = {a, b} end
    end
    rows[#rows + 1] = UIK.note(lines, {w = w, colour = G.C[STATUS_COLOUR[T.status.kind] or "GOLD"], scale = UIK.touch() and 0.4 or 0.36})
  end
  local list = T.list()
  T._list = list
  if #list > 0 then
    rows[#rows + 1] = UIK.header(L("Earlier copies"), {w = w})
  end
  for i, e in ipairs(list) do
    rows[#rows + 1] = UIK.action{id = 'st_file_' .. i, label = file_label(e),
      info = T.summary(e), button_label = L("Load"), button = 'save_transfer_pick', ref_table = e,
      colour = UIK.C.ok, disabled = not e.info, w = w, bw = 2.85}
  end
  if not phone() then
    rows[#rows + 1] = UIK.action{id = 'st_open', label = L("Exports folder"), info = L("Your exports and backups stay here"), button_label = L("Open"), button = 'save_transfer_open_exports', colour = UIK.C.accent, w = w}
  end
  rows[#rows + 1] = UIK.note({L("Settings and your online key are never in an export.")}, {w = w})
  return UIK.flow{id = 'st_main', items = rows, cols = 2, fit = #list == 0}
end

function T.window()
  return UIK.window{
    id = 'save_transfer', title = L("SAVE FILES"), compact = #T.list() == 0,
    back_func = T.back or 'settings',
    build = main_page,
  }
end

function T.open(_, back)
  if back ~= nil then T.back = back end
