local function export_fallback(name)
  set_status(string.format(L("Saved in the exports folder: %s"), name), "ok")
  if not os.getenv("OVERHAUL_NO_OPEN_FOLDER") then pcall(T.open_folder, T.EXPORTS) end
end

G.FUNCS.save_transfer_export = function()
  if T.busy then return end
  local rel, data = T.export()
  if not rel then
    T.last_export = nil
    set_status(data == "empty" and L("Nothing to export yet: play a round first.") or L("Could not write the file."), "error")
    return
  end
  local name = rel:match("([^/]+)$")
  T.last_export = name
  local P = picker()
  if P then
    local started = P.save(fs.getSaveDirectory() .. "/" .. rel, name, function(res)
      if res.status == "ok" then
        set_status(string.format(L("Saved: %s"), res.added[1] or name), "ok")
      elseif res.status == "cancel" then
        set_status(L("Cancelled. Nothing was saved."), "info")
      else
        set_status(L("Android could not save the file."), "error")
      end
    end)
    set_status(started and L("Choose where to save it.") or L("Update the app to save it on your phone."), started and "info" or "error")
    return
  end
  local osn = desktop_os()
  local job = osn and SIO.dialog_start(SIO.save_command(osn, L("Export my save"), name))
  if not job then return export_fallback(name) end
  set_status(L("Choose where to save it."), "info")
  watch(job, function(st, path)
    if st == "ok" then
      if SIO.write_file(path, data) then
        set_status(string.format(L("Saved: %s"), path), "ok")
      else
        set_status(L("Could not write the file there. Nothing was saved."), "error")
      end
    elseif st == "cancel" then
      set_status(L("Cancelled. Nothing was saved."), "info")
    else
      export_fallback(name)
    end
  end)
end

G.FUNCS.save_transfer_import_file = function()
  if T.busy then return end
  local P = picker()
  if P then
    fs.createDirectory(T.IMPORTS)
    local started = P.pick("zip", fs.getSaveDirectory() .. "/" .. T.IMPORTS, "zip,jkr", SIO.MAX_TOTAL, function(res)
      if res.status == "cancel" then
        set_status(nil)
      elseif #res.added > 0 or #res.same > 0 then
        local name = res.added[1] or res.same[1]
        local rel = T.IMPORTS .. "/" .. name
        local data = fs.read(rel)
        set_status(nil)
        local shown = T.preview_data(data or "", name)
        if name:lower():match("%.jkr$") or not shown then fs.remove(rel) end
      elseif #res.big > 0 then
        set_status(T.err_text("too_big"), "error")
      elseif #res.wrong > 0 then
        set_status(T.err_text("not_zip"), "error")
      else
        set_status(T.err_text("not_found"), "error")
      end
    end)
    if not started then set_status(L("Update the app to pick files."), "error") end
    return
  end
  local osn = desktop_os()
  local job = osn and SIO.dialog_start(SIO.pick_command(osn, L("Import a save")))
  if not job then
    set_status(L("Drop the save file on the game window to import it."), "info")
    return
  end
  set_status(L("Pick the save in the window that opened."), "info")
  watch(job, function(st, path)
    if st == "ok" then
      set_status(nil)
      T.preview_path(path)
    elseif st == "cancel" then
      set_status(nil)
    else
      set_status(L("Drop the save file on the game window to import it."), "info")
    end
  end)
end

G.FUNCS.save_transfer_pick_file = G.FUNCS.save_transfer_import_file

G.FUNCS.save_transfer_open_exports = function() T.open_folder(T.EXPORTS) end
G.FUNCS.save_transfer_open_imports = function() T.open_folder(T.IMPORTS) end

local function fix_name_row(t)
  G.E_MANAGER:add_event(Event({blockable = false, blocking = false, func = function()
    local m = G.OVERLAY_MENU
    local tc = m and m.get_UIE_by_ID and m:get_UIE_by_ID('tab_contents')
    local box = tc and tc.config and tc.config.object
    if box and box.recalculate then box:recalculate() end
    return true
  end}))
  return t
end

local profile_option = G.UIDEF.profile_option
function G.UIDEF.profile_option(key)
  local t = profile_option(key)
  if t and t.nodes then
    table.insert(t.nodes, #t.nodes, {n = G.UIT.R, config = {align = "cm", padding = 0.08}, nodes = {
      UIK.button{label = L("Import save"), button = 'save_transfer_from_profile', colour = G.C.GREEN, w = 2.6, h = 0.6, scale = 0.35, col = true},
      UIK.button{label = L("Export save"), button = 'save_transfer_export_from_profile', colour = G.C.BLUE, w = 2.6, h = 0.6, scale = 0.35, col = true},
    }})
  end
  return fix_name_row(t)
end

function T.settings_rows()
  return {
    UIK.action{id = 'set_save_import', label = L("Import a save"), info = L("Load a save .zip, a backup is made first"), button_label = L("Open"), button = 'save_transfer_from_settings', colour = UIK.C.accent},
    UIK.action{id = 'set_save_export', label = L("Export my save"), info = L("Copy your progress to a .zip file"), button_label = L("Open"), button = 'save_transfer_export_from_settings', colour = UIK.C.accent},
  }
end

if not T.dropped_hooked then
  T.dropped_hooked = true
  local orig = love.filedropped
  love.filedropped = function(file, ...)
    local ok, used = pcall(T.dropped, file)
    if ok and used then return end
    if orig then return orig(file, ...) end
  end
end

local function pid()
  local ok, ffi = pcall(require, "ffi")
  if not ok then return 0 end
  if jit and jit.os == "Windows" then
    pcall(ffi.cdef, "unsigned long GetCurrentProcessId(void);")
    local ok2, n = pcall(function() return tonumber(ffi.C.GetCurrentProcessId()) end)
    return ok2 and n or 0
  end
  pcall(ffi.cdef, "int getpid(void);")
  local ok2, n = pcall(function() return tonumber(ffi.C.getpid()) end)
  return ok2 and n or 0
end

function T.lock_beat(force)
  if phone() then return end
  local now = os.time()
  if not force and T.lock_at and now - T.lock_at < 5 then return end
  T.lock_at = now
  T.pid = T.pid or pid()
  fs.write(SIO.LOCK, SIO.lock_text(T.pid, now))
  if not T.quit_hooked and love.quit then
    T.quit_hooked = true
    local quit = love.quit
    love.quit = function(...)
      local r = quit(...)
      if not r then pcall(fs.remove, SIO.LOCK) T.lock_at = math.huge end
      return r
    end
  end
end

if Game and Game.update and not T.update_hooked then
  T.update_hooked = true
  local update = Game.update
  Game.update = function(self, dt)
    pcall(T.lock_beat)
    return update(self, dt)
  end
end

T.apply_pending()

