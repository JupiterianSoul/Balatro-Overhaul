-- FEATURE: Deck Creator - Game Hooks Layer (Phase 2)
-- Ported from Balatro-DeckCreator-1.2.2 (DeckCreator.lua ~3300 lines)
-- Hooks into Back:apply_to_run, Back:trigger_effect, end_round, evaluate_play,
-- get_current_pool, create_card, draw/discard, and shop mechanics.
-- All Steamodded/Balamod dependencies removed. Uses safe hook pattern (store + wrap).

DeckCreatorHooks = {}

----------------------------------------------------------------------
-- HELPER: Check if current deck is a custom deck
----------------------------------------------------------------------
local function is_custom_deck()
    if not G then return false end
    if not G.GAME then return false end
    if not G.GAME.selected_back then return false end
    if G.GAME.dc_active then return true end
    local config = G.GAME.selected_back.effect and G.GAME.selected_back.effect.config
    return config and config.customDeck == true
end

local function get_deck_config()
    if not is_custom_deck() then return nil end
    return G.GAME.selected_back.effect.config or {}
end

-- Forward declarations for Number Randomizer functions referenced before
-- their definitions (the NR block is at the bottom of this file).
local _nr_randomize_all_hands               -- function, defined in the NR block
local _nr_hands_ante = -1                   -- last ante at which hands were randomized
local _nr_hand_base_l = {}                  -- original s/l chip+mult per hand name

----------------------------------------------------------------------
-- HOOK 1: Back:apply_to_run() — Apply all custom deck config at run start
----------------------------------------------------------------------
local original_back_apply_to_run = Back.apply_to_run

local DC_ENH = {Bonus = "m_bonus", Mult = "m_mult", Wild = "m_wild", Glass = "m_glass", Steel = "m_steel", Stone = "m_stone", Gold = "m_gold", Lucky = "m_lucky"}
local DC_ED = {Foil = "foil", Holographic = "holo", Polychrome = "polychrome", Negative = "negative"}

local function dc_pick(list, seed)
    return list[math.floor(pseudorandom(pseudoseed(seed)) * #list) + 1] or list[1]
end

local function dc_roll(p, seed)
    return p > 0 and pseudorandom(pseudoseed(seed)) * 100 < p
end

function DeckCreatorHooks.build_card_protos(config)
    local comp = DeckCreatorData.composition(config)
    local protos = {}
    if config.custom_cards_set and type(config.customCardList) == "table" and #config.customCardList > 0 then
        local suitMap = {Hearts = "H", Diamonds = "D", Clubs = "C", Spades = "S"}
        local rankMap = {["10"] = "T", Jack = "J", Queen = "Q", King = "K", Ace = "A"}
        for _, p in ipairs(config.customCardList) do
            local s = suitMap[p.suit] or p.suit
            local r = rankMap[p.rank] or p.rank
            if G.P_CARDS[tostring(s) .. "_" .. tostring(r)] then
                protos[#protos + 1] = {s = s, r = r,
                    e = p.enhancement and DC_ENH[p.enhancement], d = p.edition and DC_ED[p.edition],
                    g = (p.seal and p.seal ~= "None") and p.seal or nil}
            end
        end
    else
        for _ = 1, comp.copies do
            for _, s in ipairs(comp.suits) do
                for _, r in ipairs(comp.ranks) do protos[#protos + 1] = {s = s, r = r} end
            end
        end
    end
    if #protos == 0 then return protos end
    local all_suits = {"S", "H", "C", "D"}
    local all_ranks = {"2", "3", "4", "5", "6", "7", "8", "9", "T", "J", "Q", "K", "A"}
    local suit_pool = #comp.suits > 0 and comp.suits or all_suits
    local rank_pool = #comp.ranks > 0 and comp.ranks or all_ranks
    for i, p in ipairs(protos) do
        if config.random_ranks then p.r = dc_pick(rank_pool, "dc_rank" .. i) end
        if config.random_suits then p.s = dc_pick(suit_pool, "dc_suit" .. i) end
    end
    local function mix(pct_v, type_idx, list, field, map, seed)
        if (pct_v or 0) <= 0 then return end
        local n = math.floor(#protos * pct_v / 100 + 0.5)
        local idx = {}
        for i = 1, #protos do idx[i] = {i = i} end
        pseudoshuffle(idx, pseudoseed(seed))
        for k = 1, n do
            local name = list[type_idx] or "Random"
            if name == "Random" then name = dc_pick({unpack(list, 2)}, seed .. k) end
            protos[idx[k].i][field] = map and map[name] or name
        end
    end
    mix(config.enh_pct, config.enh_type, DeckCreatorData.ENHANCEMENTS, "e", DC_ENH, "dc_enh")
    mix(config.edition_pct, config.edition_type, DeckCreatorData.EDITIONS, "d", DC_ED, "dc_ed")
    mix(config.seal_pct, config.seal_type, DeckCreatorData.SEALS, "g", nil, "dc_seal")
    return protos
end

function DeckCreatorHooks.rebuild_deck(config)
    local protos = DeckCreatorHooks.build_card_protos(config)
    if #protos == 0 then return end
    local comp = DeckCreatorData.composition(config)
    local untouched = not config.custom_cards_set and comp.total == 52 and not config.random_ranks and not config.random_suits
        and (config.enh_pct or 0) == 0 and (config.edition_pct or 0) == 0 and (config.seal_pct or 0) == 0
    if untouched then return end
    for i = #G.playing_cards, 1, -1 do
        local c = G.playing_cards[i]
        if c.area then c.area:remove_card(c) end
        c:remove()
    end
    G.playing_cards = {}
    table.sort(protos, function(a, b) return (a.s .. a.r) < (b.s .. b.r) end)
    for _, p in ipairs(protos) do card_from_control(p) end
    G.GAME.starting_deck_size = #G.playing_cards
    if G.deck and G.deck.shuffle then G.deck:shuffle('dc_deck') end
end

function DeckCreatorHooks.runtime_flags(config)
    local f = {}
    f.dc_chip_reduction_percent = config.chip_reduction_percent
    f.dc_mult_reduction_percent = config.mult_reduction_percent
    f.dc_enhanced_dollars_per_round = config.enhanced_dollars_per_round
    f.dc_negative_joker_money = config.negative_joker_money
    f.dc_destroy_joker_ante4 = config.destroy_random_joker_after_ante_four
    f.dc_increase_drawn_rank = config.chance_to_increase_drawn_cards_rank
    f.dc_increase_discard_rank = config.chance_to_increase_discard_cards_rank
    f.dc_skip_dollars = config.skip_dollars
    f.dc_frugal_dollars = config.frugal_dollars
    f.dc_neg_joker_skip = config.neg_joker_on_skip
    f.dc_allow_legendary = config.allow_legendary_jokers_everywhere or nil
    f.dc_allow_duplicates = config.allow_duplicate_jokers or nil
    f.dc_allow_black_hole = config.allow_black_hole or nil
    f.dc_allow_soul = config.allow_soul or nil
    return f
end

