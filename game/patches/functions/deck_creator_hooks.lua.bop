----------------------------------------------------------------------
-- HOOK 2: Back:trigger_effect() — Runtime effects during gameplay
----------------------------------------------------------------------
local original_back_trigger_effect = Back.trigger_effect

r 1 108 - -
l 60
    -- Call vanilla first
    local r1, r2 = original_back_trigger_effect(self, args)

    if not is_custom_deck() then return r1, r2 end
    if not args then return r1, r2 end

    pcall(function()
        local config = get_deck_config()
        if not config then return end

        -- Final scoring step: apply chip/mult reductions
        if args.context == 'final_scoring_step' then
            if G.GAME.dc_chip_reduction_percent and G.GAME.dc_chip_reduction_percent > 0 then
                local reduction = args.chips * (G.GAME.dc_chip_reduction_percent / 100)
                args.chips = math.max(0, math.floor(args.chips - reduction))
            end
            if G.GAME.dc_mult_reduction_percent and G.GAME.dc_mult_reduction_percent > 0 then
                local reduction = args.mult * (G.GAME.dc_mult_reduction_percent / 100)
                args.mult = math.max(1, math.floor(args.mult - reduction))
            end
            if (G.GAME.dc_chip_reduction_percent or 0) > 0 or (G.GAME.dc_mult_reduction_percent or 0) > 0 then
                r1, r2 = args.chips, args.mult
            end
        end

        -- Blind amount scaling
        if args.context == 'blind_amount' and G.GAME.dc_blind_scaling and G.GAME.dc_blind_scaling ~= 1 then
            -- Blind scaling is applied during blind setup, not here
        end
    end)

    return r1, r2
end

