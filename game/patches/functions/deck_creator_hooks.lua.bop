----------------------------------------------------------------------
-- FEATURE: Number Randomizer — Game-level hooks
-- Active when G.GAME.number_randomizer == true (set by Custom Runs,
-- Deck Creator, or MP lobby settings). Randomizes prices, joker/
-- consumable ability values, poker hand chips/mult, and booster sizes.
-- These hooks are placed here (after card.lua) so Card/CardArea exist.
--
-- System based on Cryptid mod's misprintize.lua:
--   - Log-uniform distribution (pseudoseed-seeded) for fair randomization
--   - create_card hook (not emplace) to catch ALL card creation paths
--   - Full card.ability table iteration with a field blacklist
--   - Per-hand-per-ante seeding so each hand's factor is stable within an ante
----------------------------------------------------------------------
local function _nr_active()
    return G and G.GAME and G.GAME.number_randomizer == true and not Randomizer
end

-- Log-uniform random factor in [min_val, max_val] seeded deterministically.
-- Mirrors Cryptid's log_random(seed, min, max).
-- Reseeds math.random (same as vanilla pseudorandom does).
local function _nr_log_rand(seed_str, min_val, max_val)
    math.randomseed(pseudoseed(seed_str))
    local lmin = math.log(min_val)
    local lmax = math.log(max_val)
    return math.exp(lmin + math.random() * (lmax - lmin))
end

-- Apply a pre-computed factor to a numeric base value.
-- Uses %.2g formatting (2 significant figures) matching Cryptid's cry_format.
local function _nr_apply(base, factor)
    if type(base) ~= 'number' or base == 0 then return base end
    local sign = (base < 0) and -1 or 1
    local result = tonumber(string.format("%.2g", math.abs(base) * factor))
    return (result or math.abs(base) * factor) * sign
end

-- Fields that must never be randomized.
-- Exact match of Cryptid's misprintize_value_blacklist (identity/structural fields).
-- NOTE: odds, repetitions, perma_repetitions, nominal are in Cryptid's bignum_blacklist —
-- they ARE randomized but capped. They are NOT in this blacklist.
local _nr_blacklist = {
    -- Cryptid misprintize_value_blacklist (identity/structural fields).
    -- NOTE: h_size and d_size removed vs Cryptid so that joker hand/discard-size
    -- bonuses (Juggler, Drunkard, Merry Andy, Troubadour, Turtle Bean, Stuntman)
    -- ARE randomized.  In card.ability these fields represent bonus amounts, not
    -- structural limits; the structural card-area limit is card_limit, still blocked.
    id = true, suit_nominal = true, base_nominal = true, face_nominal = true,
    suit_nominal_original = true, perish_tally = true, times_played = true,
    card_limit = true, extra_slots_used = true,
    qty = true, h_x_chips = true, selected_d6_face = true, colour = true,
    -- Additional guard (Cryptid uses Card.no check):
    immutable = true,
}

-- Value caps matching Cryptid's misprintize_value_cap.
local _nr_value_cap = {
    repetitions = 40,
    perma_repetitions = 40,
}

-- Randomize all numeric values in card.ability (and one level of sub-tables).
-- Uses a SINGLE per-ante seed (exact Cryptid match) so all fields share the same factor.
-- Skips blacklisted fields and identity multipliers (x_mult/x_chips == 1).
-- Caps repetitions/perma_repetitions at 40 (Cryptid misprintize_value_cap).
local function _nr_randomize_ability(card)
    if not card or not card.config or not card.config.center then return end
    -- FIX: Skip immutable cards entirely (Cryptid does Card.no(card,"immutable",true) check)
    if card.ability and card.ability.immutable then return end
    local ante = (G.GAME and G.GAME.round_resets and G.GAME.round_resets.ante) or 0
    -- Single per-ante factor — ALL fields on ALL cards share this factor (Cryptid exact match)
    local factor = _nr_log_rand('nr_misprint' .. ante, 0.1, 10)
    local ab = card.ability
    if not ab then return end
    for k, v in pairs(ab) do
        if not _nr_blacklist[k] then
            if type(v) == 'number' and v ~= 0 then
                -- Skip identity multipliers (Cryptid does the same)
                if not ((k == 'x_mult' or k == 'x_chips') and v == 1) then
                    local result = _nr_apply(v, factor)
                    if _nr_value_cap[k] then result = math.min(result, _nr_value_cap[k]) end
                    ab[k] = result
                end
            elseif type(v) == 'table' and k ~= 'immutable' and k ~= 'colour' then
                -- Recurse one level (e.g. ab.extra sub-table)
                for k2, v2 in pairs(v) do
                    if not _nr_blacklist[k2] and type(v2) == 'number' and v2 ~= 0 then
                        if not ((k2 == 'x_mult' or k2 == 'x_chips') and v2 == 1) then
                            local result = _nr_apply(v2, factor)
                            if _nr_value_cap[k2] then result = math.min(result, _nr_value_cap[k2]) end
                            v[k2] = result
                        end
                    end
                end
            end
        end
    end
end

-- HOOK NR-1: Randomize card purchase prices (all shop cards)
-- Uses center key + ante as seed so price is stable within an ante.
local _nr_orig_set_cost = Card.set_cost
Card.set_cost = function(self)
    _nr_orig_set_cost(self)
    if not _nr_active() then return end
    if self.cost and type(self.cost) == 'number' and self.cost > 0 then
        local ante = (G.GAME and G.GAME.round_resets and G.GAME.round_resets.ante) or 0
        -- Same per-ante seed as ability values (Cryptid exact match)
        self.cost = math.max(1, math.floor(self.cost * _nr_log_rand('nr_misprint' .. ante, 0.1, 10)))
    end
end

-- HOOK NR-2: Randomize joker/consumable/voucher ability values when a card is created.
-- Mirrors Cryptid's create_card hook — catches ALL creation paths
-- (shop, boosters, tags, spectral effects, etc.), not just emplace.
local _nr_orig_create_card = create_card
create_card = function(_type, area, legendary, _rarity, skip_materialize, soulable, forced_key, key_append)
    local card = _nr_orig_create_card(_type, area, legendary, _rarity, skip_materialize, soulable, forced_key, key_append)
    if _nr_active() and card and card.config and card.config.center then
        local set = card.config.center.set
        if set == 'Joker' or set == 'Tarot' or set == 'Spectral' or set == 'Planet' or set == 'Voucher' then
            pcall(_nr_randomize_ability, card)
            card._nr_done = true  -- FIX #146: mark to prevent double-randomization via emplace hook
        end
    end
    return card
end

-- HOOK NR-2b: Catch jokers that bypass create_card (spectral effects, tag joker grants,
-- Card:init() direct calls, etc.) and randomize their ability on first emplace into G.jokers.
-- card._nr_done guards against double-randomization for cards that went through create_card.
local _nr_sp_emplace = CardArea.emplace  -- may already be wrapped by score_preview.lua
CardArea.emplace = function(self, card, location, stay_flipped)
    _nr_sp_emplace(self, card, location, stay_flipped)
    if self == G.jokers and _nr_active()
        and card and card.config and card.config.center
        and card.config.center.set == 'Joker'
        and not card._nr_done then
        pcall(_nr_randomize_ability, card)
        card._nr_done = true
    end
end

-- HOOK NR-5: Randomize playing card base.nominal (individual card chip contribution).
-- Cryptid misprintizes card.base as well as card.ability — this is the playing-card
-- equivalent. base.nominal is 2-11 for 2..Ace; jokers use G.P_CARDS.empty (nominal=0)
-- so the nominal ~= 0 guard naturally excludes them.
--
-- We hook Card:set_base(card, initial) because it is the single point where nominal
-- is written for BOTH creation paths:
--   - Starting deck:      card_from_control → Card() → set_base(card, true)
--   - Mid-run additions:  create_playing_card → Card() → set_base(card, true)
-- Passing initial=true means "first creation"; suit/rank transformations call
-- set_base without initial (nil/false) and are NOT re-randomized.
--
-- Seed: per-card-key + per-ante → all cards of the same type (e.g. all S_A)
-- share the same randomized nominal within an ante (mirrors Cryptid's base_values table).
local _nr_orig_set_base = Card.set_base
Card.set_base = function(self, card, initial)
    _nr_orig_set_base(self, card, initial)
    if initial and _nr_active() and self.base
        and type(self.base.nominal) == 'number' and self.base.nominal ~= 0 then
        pcall(function()
            local card_key = (self.config and self.config.card_key) or 'x'
            local ante = (G.GAME and G.GAME.round_resets and G.GAME.round_resets.ante) or 1
            self.base.nominal = _nr_apply(self.base.nominal,
                _nr_log_rand('nr_card_' .. card_key .. ante, 0.1, 10))
        end)
    end
end

-- HOOK NR-3 (redesigned): Permanently randomize poker hand chip/mult values per ante.
-- Old approach: modified h.chips/h.mult right before evaluate_play, restored after.
--   Problem: Run Info poker-hands tab reads G.GAME.hands directly and always saw
--   vanilla values; also the per-play factor was not stable within an ante.
-- New approach: apply a single per-ante factor ONCE, written permanently into
--   G.GAME.hands so every consumer (scoring engine, UI tabs, HUD) sees the same
--   randomized values.  l_chips/l_mult are also randomized so level-up bonuses are
--   wild.  Original vanilla values are stored in _nr_hand_base_l (populated once at
--   run start) so re-randomizing on the NEXT ante uses clean originals (no compounding).
-- Called from:
--   (a) Back:apply_to_run (via G.E_MANAGER immediate event) — ante 1
--   (b) ease_ante hook (via G.E_MANAGER immediate event) — every subsequent ante
-- _nr_hands_ante dedup guard prevents double-application within the same ante.
_nr_randomize_all_hands = function()
    if not _nr_active() or not G.GAME or not G.GAME.hands then return end
    local ante = (G.GAME.round_resets and G.GAME.round_resets.ante) or 1
    if _nr_hands_ante == ante then return end   -- already done for this ante
    _nr_hands_ante = ante
    local factor = _nr_log_rand('nr_misprint' .. ante, 0.1, 10)
    for name, h in pairs(G.GAME.hands) do
        -- Snapshot original vanilla values on first call for this run.
        -- Uses current h.s_chips/s_mult (NOT h.chips/mult which include level-ups).
        if not _nr_hand_base_l[name] then
            _nr_hand_base_l[name] = {
                s_chips = h.s_chips, s_mult = h.s_mult,
                l_chips = h.l_chips, l_mult = h.l_mult,
            }
        end
        local base = _nr_hand_base_l[name]
        -- Apply per-ante factor to originals (prevent compounding across antes).
        local new_s_chips = math.max(1, math.floor(_nr_apply(base.s_chips or h.s_chips, factor)))
        local new_s_mult  = math.max(1, math.floor(_nr_apply(base.s_mult  or h.s_mult,  factor)))
        local new_l_chips = math.max(1, math.floor(_nr_apply(base.l_chips or h.l_chips, factor)))
        local new_l_mult  = math.max(1, math.floor(_nr_apply(base.l_mult  or h.l_mult,  factor)))
        -- Write all four fields so level_up_hand() continues to work correctly with
        -- the randomized values: chips = s_chips + l_chips * (level-1).
        h.s_chips = new_s_chips
        h.s_mult  = new_s_mult
        h.l_chips = new_l_chips
        h.l_mult  = new_l_mult
        local level = h.level or 1
        h.chips = math.max(1, new_s_chips + new_l_chips * (level - 1))
        h.mult  = math.max(1, new_s_mult  + new_l_mult  * (level - 1))
    end
end

-- HOOK NR-4: Randomize booster pack card count and choices on open.
-- Uses pseudoseed so results are stable per ante.
local _nr_orig_use_consumeable = Card.use_consumeable
Card.use_consumeable = function(self, area, copier, ...)
    -- Randomize pack size (how many cards appear) before vanilla reads it
    if _nr_active() and self.ability and self.ability.set == 'Booster' then
        pcall(function()
            if self.ability.extra and type(self.ability.extra) == 'number' then
                local ante = (G.GAME and G.GAME.round_resets and G.GAME.round_resets.ante) or 0
                local key = (self.config and self.config.center_key) or 'booster'
                -- Absurd pack sizes: -3 to +8 cards, uncapped high end
                math.randomseed(pseudoseed('nr_bsize_' .. key .. ante))
                local delta = math.random(-3, 8)
                self.ability.extra = math.max(1, math.min(15, self.ability.extra + delta))
            end
        end)
    end
    local result = _nr_orig_use_consumeable(self, area, copier, ...)
    -- Randomize choices (how many you can pick) after vanilla sets G.GAME.pack_choices
    if _nr_active() and self.ability and self.ability.set == 'Booster' then
        pcall(function()
            if G.GAME and G.GAME.pack_choices then
                local ante = (G.GAME and G.GAME.round_resets and G.GAME.round_resets.ante) or 0
                local key = (self.config and self.config.center_key) or 'booster'
                math.randomseed(pseudoseed('nr_bchoice_' .. key .. ante))
                local delta = math.random(-1, 4)
                G.GAME.pack_choices = math.max(1, math.min(6, G.GAME.pack_choices + delta))
            end
        end)
    end
    return result
end

-- HOOK NR-6: Re-randomize poker hand values on each ante change.
-- ease_ante() is the single function that increments G.GAME.round_resets.ante.
-- The actual increment happens inside an Event({trigger='immediate',...}) so we
-- also queue our own immediate event (FIFO ordering guaranteed) which executes
-- AFTER the ante field is updated — _nr_randomize_all_hands reads the new ante.
local _nr_orig_ease_ante = ease_ante
ease_ante = function(mod)
    local result = _nr_orig_ease_ante(mod)
    if _nr_active() then
r 1 112 %20%20%20%20%20%20%20%20 -
r 2 398 %20%20%20%20%20%20%20%20%20%20%20%20 -
l 17
            func = function()
                pcall(_nr_randomize_all_hands)
                return true
            end,
        }))
    end
    return result
end

