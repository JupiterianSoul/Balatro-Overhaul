----------------------------------------------------------------------
-- HOOK 8: Banned blind replacement
-- When a blind would be selected, replace banned blinds with bl_empty
----------------------------------------------------------------------
DeckCreatorHooks.filterBannedBlind = function(blind_key)
    if not is_custom_deck() then return blind_key end
    if not G.GAME then return blind_key end

    local bannedBlinds = DeckCreatorCardUtils.bannedItems and DeckCreatorCardUtils.bannedItems.blinds or {}
    for _, banned_key in ipairs(bannedBlinds) do
        if banned_key == blind_key then
            DeckCreatorUtils.configureEmptyBlind()
            return "bl_empty"
        end
    end
    return blind_key
end

----------------------------------------------------------------------
-- HOOK 9: Banned tag filtering
-- Prevent banned tags from being awarded
----------------------------------------------------------------------
local original_add_tag = add_tag

if original_add_tag then
    add_tag = function(_tag, ...)
        -- FIX: C2 — Check ban OUTSIDE pcall so return actually blocks the call
        if is_custom_deck() and _tag and _tag.key then
            local ok, blocked = pcall(function()
                -- Check banned_keys (populated in apply_to_run)
                if G.GAME and G.GAME.banned_keys and G.GAME.banned_keys[_tag.key] then
                    return true
                end
                return false
            end)
            if ok and blocked then
                return -- Silently prevent banned tag
            end
        end
        return original_add_tag(_tag, ...)
    end
end

