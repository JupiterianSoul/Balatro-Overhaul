    -- FIX: Post-filter banned items from pool (catches vanilla fallback bypass for j_joker/v_blank)
    -- Vanilla's fallback hardcodes j_joker/v_blank without checking G.GAME.banned_keys.
    -- We re-scan the returned pool and mark banned entries as UNAVAILABLE.
    -- If ALL entries are banned, leave pool unchanged to prevent infinite loop in create_card.
    pcall(function()
        if G.GAME and G.GAME.banned_keys then
            local has_available = false
            for i = 1, #_pool do
                if _pool[i] ~= 'UNAVAILABLE' and not G.GAME.banned_keys[_pool[i]] then
                    has_available = true
                    break
                end
            end
            if has_available then
                for i = 1, #_pool do
                    if _pool[i] ~= 'UNAVAILABLE' and G.GAME.banned_keys[_pool[i]] then
                        _pool[i] = 'UNAVAILABLE'
                    end
                end
            end
        end
    end)

    return _pool, _pool_key
end

