local function L(s)
    local lang = G and G.SETTINGS and G.SETTINGS.language
    local t = (lang == "fr" and FR_UI) or ((lang == "es_ES" or lang == "es_419") and ES_UI) or nil
    if t and t[s] then return t[s] end
    if mod_loc then
        local ok, r = pcall(mod_loc, s)
        if ok and r then return r end
    end
    return s
end
W.L = L
