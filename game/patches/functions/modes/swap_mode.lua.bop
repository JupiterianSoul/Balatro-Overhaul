function W.load_run(d, from_pb)
    local save = unpack_run(d.data)
    if not save then
        if mp_log then mp_log.error("BOM_SWAP", "swap_run %s: payload did not decode", tostring(d.round)) end
        return false
    end
    local kept = keep_player_fields()
    S.loading = true
    S.waiting = false
    S.go, S.go_at = nil, nil
    W.hide_wait()
    local Rj = g("bom_rejoin")
    if Rj and not from_pb then
        Rj.pending_table = nil
        if Rj.pack and Rj.pack.job then Rj.pack.job.cancelled = true end
    end
    local M = match()
    if M and M.set_starting_mp_run then M.set_starting_mp_run() end
    if G.FUNCS.wipe_on then
        pcall(G.FUNCS.wipe_on, {L("SWITCHEROO")}, true, 1.3, G.C.PURPLE)
        pcall(play_sound, "whoosh_long", 1, 0.6)
    end
    G.FUNCS.start_run(nil, {savetext = save, mp_start = true})
r 1 112 %20%20%20%20 -
l 289
        trigger = "immediate", no_delete = true,
        func = function()
            local ok, err = pcall(finish_load, kept, d, from_pb)
            if not ok then
                S.loading = false
                if mp_log then mp_log.error("BOM_SWAP", "finish_load failed: %s", tostring(err)) end
            end
            return true
        end,
    }))
    return true
end

local function start_load(d)
    local RP = g("bom_replay")
    if RP and RP.push then pcall(RP.push, {k = "sw", r = d.round, d = d.data, h = d.hash, from = d.from, br = d.bot_run, owner = d.bot_run and d.bot_run.owner or (d.facts and d.facts.owner) or d.from}) end
    W.load_run(d)
end

local function on_swap_run(d)
    if type(d) ~= "table" or not W.active() or playing_back() then return end
    local round = tonumber(d.round) or 0
    if round <= (S.done or 0) then
        if S.need_applied and round == S.done then send({type = "swap_applied", round = round}) end
        return
    end
    if type(d.data) ~= "string" then return end
    local h = hash(d.data)
    if d.hash and d.hash ~= h then
        if mp_log then mp_log.error("BOM_SWAP", "swap_run %d hash %s does not match %s", round, tostring(h), tostring(d.hash)) end
    end
    S.done = round
    S.out = nil
    log({dir = "in", round = round, hash = h, bytes = #d.data, from = d.from, mine = d.mine})
    local bot_run = type(d.bot_run) == "table" and d.bot_run or nil
    if bot_run and bot_run.skip then
        S.go, S.go_at, S.waiting, S.ready, S.mine_out, S.opp_facts = nil, nil, false, false, nil, nil
        W.hide_wait()
        log({dir = "skipped", round = round, from = d.from})
        send({type = "swap_applied", round = round})
        W.banner(L("No swap this time, you keep your run"))
        return
    end
    local go = {round = round, data = d.data, hash = h, from = d.from, mine = d.party and d.mine or nil, bot_run = bot_run}
    local save = unpack_run(d.data)
    if bot_run then
        local lv = 0
        for _, hd in pairs(type(bot_run.levels) == "table" and bot_run.levels or {}) do lv = lv + math.max(0, (tonumber(type(hd) == "table" and hd.l) or 1) - 1) end
        local function n(t) return type(t) == "table" and #t or 0 end
        go.facts = S.opp_facts or {owner = bot_run.owner or d.from, ante = tonumber(bot_run.ante) or 0, dollars = tonumber(bot_run.dollars) or 0, deck = n(bot_run.cards),
            jokers = n(bot_run.jokers), cons = n(bot_run.cons), vouchers = n(bot_run.vouchers), levels = lv, tags = n(bot_run.tags)}
    elseif save and not S.opp_facts then
        pcall(function()
            local gm = save.GAME or {}
            local areas = save.cardAreas or {}
            local function n(a) return a and a.cards and #a.cards or 0 end
            local lv = 0
            for _, hd in pairs(gm.hands or {}) do lv = lv + math.max(0, (tonumber(hd.level) or 1) - 1) end
            go.facts = {owner = gm.bom_sw_owner or d.from, ante = gm.round_resets and gm.round_resets.ante or 0, dollars = tonumber(gm.dollars) or 0,
                deck = n(areas.deck) + n(areas.hand) + n(areas.discard) + n(areas.play), jokers = n(areas.jokers), cons = n(areas.consumeables),
                vouchers = count_keys(gm.used_vouchers), levels = lv, tags = #(save.tags or {})}
        end)
    end
    local secs = tonumber(d.countdown) or W.COUNT
    if secs <= 0 or not G.STAGE or G.STAGE ~= G.STAGES.RUN then
        start_load(go)
        return
    end
    S.go, S.go_at, S.count_n = go, now() - (W.COUNT - math.min(W.COUNT, secs)), nil
    S.waiting = false
    local UIK = g("UIK")
    if own_window() and UIK and UIK._win and UIK._win._cur ~= "swap" and UIK.open_tab then pcall(UIK.open_tab, "swap") end
    if not own_window() then W.show_wait() else W.refresh_wait(true) end
end

local function on_swap_waiting(d)
    if type(d) ~= "table" or not W.active() then return end
    if d.party then
        local names = {}
        for _, n in ipairs(type(d.waiting) == "table" and d.waiting or {}) do names[#names + 1] = tostring(n) end
        S.party_wait = {waiting = names, ready = tonumber(d.ready) or 0, total = tonumber(d.total) or 0, pressed = tonumber(d.pressed) or 0}
        if type(d.notReady) == "table" then S.v2 = true end
        if S.v2 and #names == 0 and not S.both_at then S.both_at = now() end
    else
        S.opp_sent = true
        S.opp_ready = true
    end
    W.refresh_wait()
end

local function on_swap_status(d)
    if type(d) ~= "table" or not W.active() or playing_back() then return end
    if not (S.out and tonumber(d.round) == S.out.round) then return end
    S.v2 = true
    S.opp_sent = d.oppSent == true
    S.opp_ready = d.oppReady == true
    if type(d.oppFacts) == "table" then S.opp_facts = d.oppFacts end
    if S.opp_sent and not S.both_at then S.both_at = now() end
    if S.ready and d.ready ~= true then send_ready() end
    W.refresh_wait()
end

local function on_rejoin(d)
    if type(d) ~= "table" or playing_back() then return end
    if not (d.mode == W.KEY or (d.party and type(d.swap) == "table")) then return end
    local sw = type(d.swap) == "table" and d.swap or {}
    local done = tonumber(sw.done) or 0
    if S.waiting and S.out then
        if done >= S.out.round then S.done = S.out.round - 1 end
        log({dir = "rejoin", round = S.out.round, done = done, live = true})
        resend()
        return
    end
    if S.go then return end
    S.done = done
    S.ante = tonumber(sw.ante) or 0
    S.waiting, S.loading, S.out = false, false, nil
    if (tonumber(sw.applied) or 0) < done then S.need_applied = done end
end

function W.reset()
    S.done, S.ante, S.out, S.waiting, S.opp_ready, S.opp_sent, S.loading, S.need_applied, S.party_wait = 0, 0, nil, false, false, false, false, nil, nil
    S.ready, S.v2, S.opp_facts, S.both_at, S.go, S.go_at, S.held, S.mine_out = false, false, nil, nil, nil, nil, nil, nil
    W.box_open = false
end

function W.check(round, data)
    local ok, n, list, fields = pcall(function()
        local sent = flatten(unpack_run(data), "", {}, 0)
        local _, live = pack(W.snapshot_table())
        local here = flatten(unpack_run(live), "", {}, 0)
        local c = 0
        for _ in pairs(sent) do c = c + 1 end
        local n2, l2 = W.diff(sent, here, 12)
        return n2, l2, c
    end)
    if not ok then
        log({dir = "check", round = round, error = tostring(n)})
        return nil
    end
    log({dir = "check", round = round, diffs = n, fields = fields, list = list})
    if mp_log and mp_log.info then pcall(mp_log.info, "BOM_SWAP", "check round=%s fields=%s diffs=%s %s", tostring(round), tostring(fields), tostring(n), table.concat(list, "; ")) end
    return n, list, fields
end

function W.update()
    if W._cover and not own_window() then W.cover(false) end
    if not W.active() or playing_back() then return end
    if not in_live_match() then return end
    local Rj = g("bom_rejoin")
    if S.need_applied and G.STAGE == G.STAGES.RUN and G.GAME and not (Rj and Rj.restoring) and not G.screenwipe then
        local f = W.facts()
        log({dir = "loaded", round = S.need_applied, restored = true, sig = f.sig, facts = f})
        send({type = "swap_applied", round = S.need_applied})
        S.need_applied = nil
    end
    if S.loading then return end
    if S.go then
        if now() - S.go_at >= W.COUNT then
            local d = S.go
            S.go, S.go_at, S.count_n = nil, nil, nil
            start_load(d)
            return
        end
        local n = W.count_left()
        if n ~= S.count_n then
            S.count_n = n
            pcall(play_sound, "highlight2", 0.85 + (W.COUNT - n) * 0.12, 0.8)
        end
        if not G.OVERLAY_MENU then W.show_wait() else W.refresh_wait() end
        return
    end
    if S.waiting then
        if not G.OVERLAY_MENU then W.show_wait() end
        if W.auto_left() == 0 and W.can_ready() then W.press_ready() end
        W.refresh_wait()
        return
    end
    if W.hold or not (post_boss_shop() and not G.screenwipe) then
        S.seen = nil
        if W.box_open and not S.waiting then W.hide_wait() end
        return
    end
    if not W.box_open or not G.OVERLAY_MENU then W.show_wait() end
    if not G.shop then return end
    local t = now()
    S.seen = S.seen or t
    if S.shop_saved or (t - S.seen > 1.5 and not (G.CONTROLLER and G.CONTROLLER.locked)) then
        S.seen = nil
        pcall(save_run)
        S.shop_saved = nil
        submit()
    end
end

function W.on_save()
    if not W.active() or playing_back() then return end
    if G.STATE == G.STATES.SHOP and post_boss_shop() and not S.waiting and not S.loading then S.shop_saved = true end
end

function W.playback_entry(e)
    local PB = g("bom_playback")
    local st = PB and PB.state and PB.state()
    if type(e.d) ~= "string" then return "swap" end
    S.done = tonumber(e.r) or S.done
    if st then st.restore_wait = true end
    if not W.load_run({round = e.r, data = e.d, hash = e.h, from = e.from, bot_run = type(e.br) == "table" and e.br or nil}, true) then return "swap" end
end

local function register_mode()
    local GM = g("bom_gamemodes")
    if GM and GM.register and not (GM.registry and GM.registry[W.KEY]) then
        local nem = GM.get and GM.get("nemesis") or {}
        GM.register({
            key = W.KEY, display_name = W.NAME,
            description = "Rivals rules, but after every boss blind you and your opponent trade runs: deck, jokers, money, everything. Lose a PvP blind with the run you hold and you lose a life.",
            rule = "Runs swap after every boss blind", order = 5, default_lives = 4,
            is_blind_pvp = nem.is_blind_pvp, get_blinds_by_ante = nem.get_blinds_by_ante,
            banned_jokers = nem.banned_jokers or {}, banned_consumables = nem.banned_consumables or {},
            banned_vouchers = nem.banned_vouchers or {}, banned_enhancements = nem.banned_enhancements or {},
            banned_tags = nem.banned_tags or {}, banned_blinds = nem.banned_blinds or {},
        })
    end
    local RS = g("bom_rulesets")
    if RS and RS.add_mode and RS.register and not (RS.MODE_BY_KEY and RS.MODE_BY_KEY[W.KEY]) then
        RS.add_mode({key = W.KEY, name = W.NAME})
        RS.register{id = "swap_classic", mode = W.KEY, family = "classic", name = "Classic", desc = "Runs swap after every boss, PvP bosses from ante 2",
            settings = {starting_lives = 4, pvp_start_round = 2}}
    end
end

local function hook_lobby()
    local LS = g("bom_lobby_settings")
    if not (LS and LS.DEFS) or W.lobby_done then return end
    W.lobby_done = true
    for _, d in ipairs(LS.DEFS) do
        if d.key == "pvp_start_round" then
            local show = d.show
            d.show = function(s) return (s.mode or "nemesis") == W.KEY or (show == nil or show(s)) end
        elseif d.key == "mode" then
            local info = d.info_fn
            d.info_fn = function(s)
                if (s.mode or "nemesis") == W.KEY then return L("Runs swap after every boss blind") end
                return info and info(s) or nil
            end
        end
    end
end

local function hook_playback()
    local PB = g("bom_playback")
    if not (PB and PB.DO) or PB.DO.sw then return end
    PB.DO.sw = W.playback_entry
    if PB.LIFE_SKIP then PB.LIFE_SKIP.sw = true end
end

local function hook_save()
    if W.save_hooked or type(save_run) ~= "function" then return end
    W.save_hooked = true
    local ref = save_run
    save_run = function(...)
        local r = ref(...)
        pcall(W.on_save)
        return r
    end
end

function W.init()
    W.verify_on = W.verify_on or (os.getenv and os.getenv("MP_TEST_ROLE") ~= nil) or false
    if G and G.FUNCS then G.FUNCS.bom_swap_ready = function() W.press_ready() end end
    if mod_loc_register then pcall(mod_loc_register, {fr = FR, es = ES}) end
    pcall(register_mode)
    pcall(hook_lobby)
    pcall(hook_playback)
    pcall(hook_save)
    local E = g("bom_events")
    if E and E.register then
        E.register("swap_run", on_swap_run)
        E.register("swap_waiting", on_swap_waiting)
        E.register("swap_status", on_swap_status)
        E.register("rejoin_ok", on_rejoin)
        E.register("match_start", function() W.reset() end)
        E.register("lobby_returned", function() W.reset() W.hide_wait() end)
        E.register("match_ended", function() S.waiting, S.go, S.go_at = false, nil, nil W.hide_wait() end)
        E.register("match_end", function() S.waiting, S.go, S.go_at = false, nil, nil W.hide_wait() end)
    end
end

return W
end
