local HOOKS_INSTALLED = false
local HOOKS_ATTEMPTED = false

local function safe_trigger_event(event_func, ...)
    if not event_func then return end
    if type(event_func) ~= "function" then return end

    local args = {...}
    local success, err = pcall(function()
        event_func(table.unpack(args))
    end)

    if not success then
        print("[ACHIEVEMENTS] Event error: " .. tostring(err))
    end
end

local function safe_delayed_event(delay, callback)
    if not G then return end
    if not G.E_MANAGER then return end
    if not Event then return end

    local success, err = pcall(function()
r 1 112 %20%20%20%20%20%20%20%20 -
l 701
            trigger = 'after',
            delay = delay or 0.1,
            func = function()
                pcall(callback)
                return true
            end
        }))
    end)

    if not success then
        print("[ACHIEVEMENTS] Delayed event error: " .. tostring(err))
    end
end


