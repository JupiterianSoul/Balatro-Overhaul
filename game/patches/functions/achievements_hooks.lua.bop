    return true
end


local LATE = {}

local function bump(event, data)
    if Overhaul and Overhaul.stats and Overhaul.stats.on then Overhaul.stats.on(event, data) end
end

local function after_call(after, a, b, ...)
    pcall(after, a, b)
    return ...
end

local function wrap_field(tbl, key, tag, after)
    if type(tbl) ~= "table" then return end
    local f = rawget(tbl, key)
    if type(f) ~= "function" or LATE[tag] == f then return end
    local wrapped = function(a, b, ...)
        local before = nil
        if type(after) == "table" then before = after.before and after.before(a, b) end
        local fn = type(after) == "table" and function(x, y) after.after(x, y, before) end or after
        return after_call(fn, a, b, f(a, b, ...))
    end
    LATE[tag] = wrapped
    tbl[key] = wrapped
end

local function wrap_funcs(names, after)
    for _, name in ipairs(names) do wrap_field(G.FUNCS, name, "F:" .. name, after) end
end

local function install_late_hooks()
    if not (G and G.FUNCS) then return end
    wrap_funcs({"open_mod_menu_fullscreen", "open_mod_menu_inrun", "open_mod_menu", "open_cheats_menu", "open_cheats"}, function() bump("cheats_opened") end)
    local guides = {}
    for name in pairs(G.FUNCS) do
        if type(name) == "string" and name:find("^open_guide_") then guides[#guides + 1] = name end
    end
    wrap_funcs(guides, function() bump("guide_opened") end)
    wrap_funcs({"open_jukebox", "jukebox_mini_open"}, function() bump("jukebox_opened") end)
    wrap_funcs({"bo_bp_play"}, function() bump("boss_practice") end)
    wrap_funcs({"mg_play"}, function() bump("arcade_play") end)
    wrap_funcs({"seed_lib_save_current"}, function() bump("seed_saved") end)
    wrap_funcs({"open_run_history"}, function() bump("history_opened") end)
    local town = rawget(_G, "Town")
    wrap_field(town, "open", "Town.open", function() bump("casino_visit") end)
    wrap_field(town, "go", "Town.go", function(key) if key then bump("casino_place", {key = key, no_count = true}) end end)
    wrap_field(rawget(_G, "BO_SPREPLAY"), "watch", "SR.watch", function() bump("replay_watched") end)
    wrap_field(rawget(_G, "bom_replay"), "watch", "RP.watch", function() bump("replay_watched") end)
    local cm = rawget(_G, "CosmeticsManager")
    wrap_field(cm, "equip", "CM.equip", {
        before = function(kind, id)
            local ok, cur = pcall(cm.get_equipped, kind)
            return ok and cur or nil
        end,
        after = function(kind, id, before)
            if G.OVERLAY_MENU and id ~= nil and id ~= before then bump("tailor_change") end
        end,
    })
    local ok, store = pcall(require, "functions/forge/forge_store")
    if ok and type(store) == "table" then
        local function was_new(getter)
            return function(c)
                local had = false
                if type(c) == "table" and c.id ~= nil then
                    local ok2, cur = pcall(store[getter], c.id)
                    had = ok2 and cur ~= nil
                end
                return had
            end
        end
        local function created(c, _, had) if type(c) == "table" and not had then bump("forge_created") end end
        wrap_field(store, "put", "Forge.put", {before = was_new("get"), after = created})
        wrap_field(store, "put_item", "Forge.put_item", {before = was_new("get_item"), after = created})
    end
end

local last_state = nil

local function watch_state()
    if not (G and G.STATES) then return end
    local cur = G.STATE
    if cur == last_state then return end
    if cur == G.STATES.SHOP and last_state == G.STATES.ROUND_EVAL then
        if AchievementManager and AchievementManager.on_shop_visit then AchievementManager.on_shop_visit() end
        if QuestManager and QuestManager.process_event then QuestManager.process_event("shop_visited", nil, 1) end
    end
    last_state = cur
end

AchievementHooks = AchievementHooks or {}
AchievementHooks.install_late = install_late_hooks
AchievementHooks.watch_state = watch_state

local HOOKS_TRIGGER_ATTEMPTED = false

local function try_install_all()
    pcall(install_late_hooks)
    if HOOKS_INSTALLED then return end
    if HOOKS_TRIGGER_ATTEMPTED then return end
    HOOKS_TRIGGER_ATTEMPTED = true
    pcall(function()
        if AchievementManager and AchievementManager.init then
            AchievementManager.init()
        end
    end)
    install_hooks()
end

local function hook_main_menu()
    if not G then return false end
    if type(set_main_menu_UI) ~= "function" then
        print("[ACHIEVEMENTS] set_main_menu_UI not found - will use G.update fallback")
        return false
    end

    local success, err = pcall(function()
        local original_set_main_menu_UI = set_main_menu_UI
        set_main_menu_UI = function(...)
            local result = original_set_main_menu_UI(...)
            pcall(try_install_all)
            return result
        end
    end)

    if not success then
        print("[ACHIEVEMENTS] Main menu hook error: " .. tostring(err))
        return false
    end

    return true
end

local UPDATE_FALLBACK_INSTALLED = false
local prev_state_for_game_over  = nil
local _periodic_check_timer = 0

local function install_update_fallback(needs_hooks, needs_gameover)
    if UPDATE_FALLBACK_INSTALLED then return end
    if not G then return end
    if type(G.update) ~= "function" then return end

    UPDATE_FALLBACK_INSTALLED = true
    local original_update = rawget(G, "update")
    G.update = function(self, dt, ...)
        local result
        if original_update then result = original_update(self, dt, ...) else result = Game.update(self, dt, ...) end

        if needs_hooks and not HOOKS_INSTALLED and G.STAGE and G.STAGE ~= G.STAGES.SPLASH then
            pcall(try_install_all)
        end

        pcall(watch_state)

        if needs_gameover and not GAME_OVER_HOOK_INSTALLED and G.STATE then
            local cur = G.STATE
            if prev_state_for_game_over ~= cur and cur == G.STATES.GAME_OVER then
                pcall(fire_game_over_events)
            end
            prev_state_for_game_over = cur
        end

        _periodic_check_timer = _periodic_check_timer + (dt or 0)
        if _periodic_check_timer >= 30 then
            _periodic_check_timer = 0
            pcall(install_late_hooks)
            pcall(function()
                if AchievementManager and AchievementManager.player_data and AchievementManager.player_data.stats then
                    AchievementManager.player_data.stats.total_play_time =
                        (AchievementManager.player_data.stats.total_play_time or 0) + 30
                end
                if AchievementManager and AchievementManager.check_periodic then
                    AchievementManager.check_periodic()
                end
            end)
        end

        return result
    end
    print("[ACHIEVEMENTS] G.update fallback installed (hooks=" .. tostring(needs_hooks) ..
          " gameover=" .. tostring(needs_gameover) .. ")")
end


local GAME_OVER_HOOK_INSTALLED = false

local function fire_game_over_events()
    pcall(function()
        if AchievementManager and AchievementManager.on_run_end then
            local chips    = (G and G.GAME and G.GAME.chips) or 0
            local run_time = Overhaul and Overhaul.stats and Overhaul.stats.run_time() or 0
            local deck_key = nil
            if G and G.GAME and G.GAME.selected_back and G.GAME.selected_back.effect and
               G.GAME.selected_back.effect.center then
                deck_key = G.GAME.selected_back.effect.center.key
            end
            AchievementManager.on_run_end(false, chips, run_time, deck_key)
        end
    end)
    pcall(function()
        if QuestManager and QuestManager.on_run_lost then
            QuestManager.on_run_lost()
        end
    end)
end

local function hook_game_over()
    if not G then return false end
    if type(create_UIBox_game_over) ~= "function" then
        print("[ACHIEVEMENTS] create_UIBox_game_over not found - will use GAME_OVER state fallback")
        GAME_OVER_HOOK_INSTALLED = false
        return false
    end

    local success, err = pcall(function()
        local original_game_over = create_UIBox_game_over
        create_UIBox_game_over = function(...)
            fire_game_over_events()
            if G and G.GAME and G.GAME.multiplayer then
                if bom_ui and bom_ui.create_mp_game_over then
                    local ok, def = pcall(bom_ui.create_mp_game_over)
                    if ok and def then return def end
                end
            end
            return original_game_over(...)
        end
        GAME_OVER_HOOK_INSTALLED = true
    end)

    if not success then
        print("[ACHIEVEMENTS] Game over hook error: " .. tostring(err))
        return false
    end

    return true
end

local function install_game_over_state_fallback() end


function trigger_custom_run_achievement()
    pcall(function()
        if AchievementManager and AchievementManager.check_achievement then
            AchievementManager.update_progress("secret_custom_run", 1)
        end
    end)
end

function trigger_daily_complete_achievement(score, streak)
    pcall(function()
        if AchievementManager and AchievementManager.on_daily_complete then
            AchievementManager.on_daily_complete(score, streak)
        end
    end)
end


local function init_hooks()
    local mm_ok = hook_main_menu()
    local go_ok = hook_game_over()

    pcall(function()
        install_update_fallback(not mm_ok, not go_ok)
    end)

    if G and G.FUNCS then
        install_hooks()
    end
end

local init_success, init_err = pcall(init_hooks)
if not init_success then
    print("[ACHIEVEMENTS] Hooks init error: " .. tostring(init_err))
end

AchievementHooks = AchievementHooks or {}
AchievementHooks.install = install_hooks
AchievementHooks.trigger_custom_run = trigger_custom_run_achievement
AchievementHooks.trigger_daily_complete = trigger_daily_complete_achievement

print("[ACHIEVEMENTS] Hooks module loaded (safe, deferred)")
return AchievementHooks
end
