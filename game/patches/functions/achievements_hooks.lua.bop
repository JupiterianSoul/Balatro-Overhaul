            end


            if type(G.FUNCS.claim_quest_reward) == "function" then
                local original_claim_quest = G.FUNCS.claim_quest_reward
                G.FUNCS.claim_quest_reward = function(e, ...)
                    local result = original_claim_quest(e, ...)
                    pcall(function()
                        if AchievementManager and AchievementManager.on_quest_claimed then
                            AchievementManager.on_quest_claimed()
                        end
                    end)
                    return result
                end
            end


            G.FUNCS.achievement_prev_page = function(e)
                pcall(function()
                    if AchievementManager and AchievementManager.current_page and AchievementManager.current_page > 1 then
