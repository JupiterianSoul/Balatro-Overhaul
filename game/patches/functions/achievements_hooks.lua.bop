        if Card and type(Card.set_ability) == "function" then
            local original_set_ability = Card.set_ability
            Card.set_ability = function(self, center, initial, delay_sprites, ...)
                local old_name = self and self.ability and self.ability.name
                local result = original_set_ability(self, center, initial, delay_sprites, ...)
                pcall(function()
                    if not initial and AchievementManager then
                        local new_name = self and self.ability and self.ability.name
                        if old_name ~= new_name and self.ability and self.ability.type == "Enhanced" then
                            if AchievementManager.on_card_enhanced then
