            if type(G.FUNCS.skip_blind) == "function" then
                local original_skip_blind = G.FUNCS.skip_blind
                G.FUNCS.skip_blind = function(e, ...)
                    local result = original_skip_blind(e, ...)
                    pcall(function()
                        if AchievementManager and AchievementManager.on_blind_skipped then
                            AchievementManager.on_blind_skipped()
                        end
                    end)
