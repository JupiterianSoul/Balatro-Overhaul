                G.FUNCS.discard_cards_from_highlighted = function(e, hook, ...)
                    local result = original_discard(e, hook, ...)

                    safe_delayed_event(0.1, function()
                        if AchievementManager and AchievementManager.on_discard then
                            AchievementManager.on_discard()
