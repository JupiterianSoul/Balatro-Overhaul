                        if (AchievementManager.current_page or 1) < total_pages then
                            AchievementManager.current_page = (AchievementManager.current_page or 1) + 1
                            if G.FUNCS.open_achievements_menu then
                                G.FUNCS.open_achievements_menu()
                            end
                        end
                    end
                end)
            end
        end

        local traps = rawget(_G, "bom_traps")
        if traps and type(traps.arm) == "function" and not traps._ach_wrapped then
            traps._ach_wrapped = true
            local original_arm = traps.arm
            traps.arm = function(key, ...)
                local result = original_arm(key, ...)
                pcall(function()
                    if G and G.GAME and G.GAME.multiplayer then
                        G.GAME.ach_traps_sent = (G.GAME.ach_traps_sent or 0) + 1
                        if AchievementManager and AchievementManager.update_progress then
                            AchievementManager.update_progress("mp_saboteur", G.GAME.ach_traps_sent)
                        end
                    end
                    local pb = rawget(_G, "bom_playback")
                    if pb and pb.active and pb.active() then return end
                    if Overhaul and Overhaul.stats then Overhaul.stats.on("trap_sent", {key = key}) end
                end)
                return result
            end
        end

        HOOKS_INSTALLED = true
        print("[ACHIEVEMENTS] Hooks installed successfully")

    end)

    if not success then
        print("[ACHIEVEMENTS] Hook installation error: " .. tostring(err))
        return false
