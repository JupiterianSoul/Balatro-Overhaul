                            if QuestManager and QuestManager.on_card_enhanced then
                                local _qok, _qerr = pcall(QuestManager.on_card_enhanced)
                                if not _qok then print("[QUEST ERROR] on_card_enhanced: " .. tostring(_qerr)) end
                            end
                        end
                    end
                end)
                return result
