        end

        if Card and type(Card.set_edition) == "function" then
            local original_set_edition = Card.set_edition
            Card.set_edition = function(self, edition, immediate, silent, ...)
                local result = original_set_edition(self, edition, immediate, silent, ...)
                pcall(function()
                    if edition and AchievementManager and AchievementManager.on_edition_obtained then
                        AchievementManager.on_edition_obtained()
                    end
                    if edition and QuestManager and QuestManager.on_edition_obtained then
                        local _qok, _qerr = pcall(QuestManager.on_edition_obtained)
                        if not _qok then print("[QUEST ERROR] on_edition_obtained: " .. tostring(_qerr)) end
                    end
                end)
                return result
            end
        end

        if G.FUNCS then
            if type(G.FUNCS.evaluate_play) == "function" then
                local original_evaluate_play = G.FUNCS.evaluate_play
                G.FUNCS.evaluate_play = function(e, ...)
                    local result = original_evaluate_play(e, ...)

                    safe_delayed_event(0.1, function()
                        if AchievementManager and AchievementManager.on_hand_played then
                            local hand_data = {
                                chips = (G and G.GAME and G.GAME.chips) or 0,
