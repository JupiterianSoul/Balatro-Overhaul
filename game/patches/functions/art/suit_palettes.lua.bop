local CUSTOM_DEFAULT = {Hearts = 'red', Diamonds = 'orange', Clubs = 'green', Spades = 'black'}

local function find(list, key)
    for i, v in ipairs(list) do
        if v.key == key then return v, i end
    end
end

function suit_palette_key()
    local S = G.SETTINGS
    if S.suit_palette and find(SUIT_PALETTES, S.suit_palette) then return S.suit_palette end
    return S.colourblind_option and 'hc' or 'normal'
end

function suit_palette_colours(key)
    if key == 'custom' then
        local c = G.SETTINGS.suit_palette_custom or {}
        local out = {}
        for _, s in ipairs(SUITS) do
            out[s] = (find(SUIT_COLOURS, c[s]) or find(SUIT_COLOURS, CUSTOM_DEFAULT[s])).hex
        end
        return out
    end
    local p = find(SUIT_PALETTES, key)
    return p and p.colours
end

local function atlas_path(name)
    for _, a in ipairs(G.asset_atli or {}) do
        if a.name == name then return a.path end
    end
end

local function hex_rgb(h)
    return tonumber(h:sub(1, 2), 16)/255, tonumber(h:sub(3, 4), 16)/255, tonumber(h:sub(5, 6), 16)/255
end

local function signature(colours)
    return colours and (colours.Hearts .. colours.Diamonds .. colours.Clubs .. colours.Spades) or nil
end

local function recolour(name, colours, cell)
    local atlas = G.ASSET_ATLAS and G.ASSET_ATLAS[name]
    if not atlas or not atlas.image then return end
    atlas.bom_pal_sig = signature(colours)
    atlas.bom_orig_image = atlas.bom_orig_image or atlas.image
    local old = atlas.bom_pal_image
    atlas.bom_pal_image = nil
    atlas.image = atlas.bom_orig_image
    if old then old:release() end
    local path = colours and atlas_path(name)
    if not path then return end
    local ok, data = pcall(love.image.newImageData, path)
    if not ok or not data then return end
    local scale = data:getWidth()/atlas.image:getWidth()
    local tol = 1.5/255
    for _, s in ipairs(SUITS) do
        local fr, fg, fb = hex_rgb(BASE[s])
        local tr, tg, tb = hex_rgb(colours[s])
        local x, y, w, h = cell(s, scale, data)
        data:mapPixel(function(_, _, r, g, b, a)
            if a > 0 and math.abs(r - fr) < tol and math.abs(g - fg) < tol and math.abs(b - fb) < tol then
                return tr, tg, tb, a
            end
            return r, g, b, a
        end, x, y, w, h)
    end
    local img = love.graphics.newImage(data, {mipmaps = true, dpiscale = atlas.bom_orig_image:getDPIScale()})
    img:setFilter(atlas.bom_orig_image:getFilter())
    local mf, sharp = atlas.bom_orig_image:getMipmapFilter()
    if mf then img:setMipmapFilter(mf, sharp) end
    data:release()
    atlas.bom_pal_image = img
    atlas.image = img
end

local function deck_cell(s, scale, data)
    local h = math.floor(95*scale + 0.5)
    return 0, DECK_ROW[s]*h, data:getWidth(), h
end

local function full_cell(_, _, data)
    return 0, 0, data:getWidth(), data:getHeight()
end

local function collab_atlases()
    local out, seen = {}, {}
    local chosen = G.SETTINGS.CUSTOM_DECK and G.SETTINGS.CUSTOM_DECK.Collabs or {}
    for _, s in ipairs(SUITS) do
        local k = chosen[s]
        if type(k) == 'string' and k ~= 'default' and not seen[k] then
            seen[k] = true
            out[#out + 1] = k .. '_1'
        end
    end
    return out
end

local function ui_cell(s, scale)
    local c = math.floor(18*scale + 0.5)
    return UI_COL[s]*c, c, c, c
end

function suit_palette_apply(changed)
    if not G.SETTINGS or not G.C or not G.C.SUITS then return end
    local key = suit_palette_key()
    local colours = suit_palette_colours(key)
    local S = G.SETTINGS
    if changed then
        S.suit_palette = key
        S.colourblind_option = key == 'hc'
        local want = key == 'hc' and 'hc' or 'lc'
        local skins = rawget(_G, 'SMODS') and SMODS.DeckSkins
        if S.colour_palettes and skins then
            for _, s in ipairs(SUITS) do
                local skin = skins[S.CUSTOM_DECK and S.CUSTOM_DECK.Collabs and S.CUSTOM_DECK.Collabs[s] or '']
                if skin and skin.palette_map and skin.palette_map[want] then S.colour_palettes[s] = want end
            end
        end
    end
    if not colours and not changed and not (G.ASSET_ATLAS and G.ASSET_ATLAS.cards_1 and G.ASSET_ATLAS.cards_1.bom_pal_image) then return end
    recolour('cards_1', colours, deck_cell)
    recolour('ui_1', colours, ui_cell)
    for _, name in ipairs(collab_atlases()) do recolour(name, colours, full_cell) end
    local proto = G.C['SO_'..(S.colourblind_option and 2 or 1)]
    for _, s in ipairs(SUITS) do
        G.C.SUITS[s] = colours and HEX(colours[s]) or proto[s]
    end
    if changed then
        for _, v in pairs(G.I.CARD or {}) do
            if v.config and v.config.card and v.children.front and v.ability and v.ability.effect ~= 'Stone Card' then
r 13 872 %20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20 -
l 50
            end
        end
    end
end

function suit_palette_set(i)
    local p = SUIT_PALETTES[i]
    if not p then return end
    G.SETTINGS.suit_palette = p.key
    if p.key == 'custom' and not G.SETTINGS.suit_palette_custom then
        G.SETTINGS.suit_palette_custom = {}
        for _, s in ipairs(SUITS) do G.SETTINGS.suit_palette_custom[s] = CUSTOM_DEFAULT[s] end
    end
    suit_palette_apply(true)
end

function suit_palette_setting_row(save)
    local names = {}
    for i, p in ipairs(SUIT_PALETTES) do names[i] = mod_loc(p.name) end
    local _, cur = find(SUIT_PALETTES, suit_palette_key())
    return UIK.cycle{id = 'set_suit_palette', label = mod_loc("Suit Colours"), info = mod_loc("Colour of each suit on the cards"), options = names, current = cur or 1,
        callback = function(i) suit_palette_set(i) if save then save() end UIK.refresh() end}
end

function suit_palette_custom_rows(items, save)
    if suit_palette_key() ~= 'custom' then return end
    local at
    for i, it in ipairs(items) do
        if it.uik_o and it.uik_o.id == 'set_suit_palette' then at = i end
    end
    if not at then return end
    local names = {}
    for i, c in ipairs(SUIT_COLOURS) do names[i] = mod_loc(c.name) end
    local chosen = suit_palette_colours('custom')
    for k, s in ipairs(SUITS) do
        local cur = 1
        for i, c in ipairs(SUIT_COLOURS) do
            if c.hex == chosen[s] then cur = i end
        end
        table.insert(items, at + k, UIK.cycle{id = 'set_suit_'..s, label = localize(s, 'suits_plural'), options = names, current = cur, colour = HEX(chosen[s]),
            callback = function(i)
                G.SETTINGS.suit_palette_custom = G.SETTINGS.suit_palette_custom or {}
                G.SETTINGS.suit_palette_custom[s] = SUIT_COLOURS[i].key
                suit_palette_apply(true)
                if save then save() end
                UIK.refresh()
            end})
    end
end

