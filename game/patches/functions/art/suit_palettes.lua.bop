local set_render_ref = Game.set_render_settings
function Game:set_render_settings(...)
    local r = set_render_ref(self, ...)
    if G.ASSET_ATLAS and G.ASSET_ATLAS.cards_1 then
        G.ASSET_ATLAS.cards_1.bom_pal_image = nil
        if G.ASSET_ATLAS.ui_1 then G.ASSET_ATLAS.ui_1.bom_pal_image = nil end
    end
    suit_palette_apply()
    return r
end

