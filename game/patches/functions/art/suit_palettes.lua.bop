function suit_palette_ensure(name)
    local atlas = G.ASSET_ATLAS and G.ASSET_ATLAS[name]
    if not atlas then return end
    local colours = suit_palette_colours(suit_palette_key())
    if atlas.bom_pal_sig ~= signature(colours) then recolour(name, colours, full_cell) end
end

