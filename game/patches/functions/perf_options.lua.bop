    love.graphics.setColor(1, 1, 1, 1)
    love.graphics.draw(P.bg_canvas, 0, 0, 0, cw / bw, ch / bh)
    love.graphics.pop()
    return true
end

local function fps_cap_limit(g)
    local cap = g.fps_cap or 6
    return cap > 3 and 3 or cap
end

function P.apply_mode(on)
    local g = GR()
    local St = G.SETTINGS
    P.fill_defaults()
    if on then
        local r = g._perf_mode_restore or {}
        for k, v in pairs(P.PRESET) do
            if r[k] == nil then r[k] = g[k] end
            g[k] = v
        end
        if r.perf_heavy_scoring == nil then r.perf_heavy_scoring = St.perf_heavy_scoring == true end
        St.perf_heavy_scoring = true
        if r.fps_cap == nil then r.fps_cap = g.fps_cap end
        g.fps_cap = fps_cap_limit(g)
        g._perf_mode_restore = r
    else
        local r = g._perf_mode_restore or {}
        for k in pairs(P.PRESET) do
            local v = r[k]
            if v == nil then v = P.DEFAULTS[k] end
            g[k] = v
        end
        if r.perf_heavy_scoring ~= nil then St.perf_heavy_scoring = r.perf_heavy_scoring end
        if r.fps_cap ~= nil then g.fps_cap = r.fps_cap end
        g._perf_mode_restore = nil
    end
    P.set_particles(g.perf_particle_amount or 1)
    P.set_background(g.perf_background or 1)
    if P.shadow_ref then P.shadow_ref.on = g.shadows ~= 'Off' end
    if apply_gc_tuning then apply_gc_tuning(g.perf_gc_tuning) end
end

function P.frame_cap(cap)
    local g = GR()
    if not (g and g.perf_away_slow) or cap <= P.AWAY_FPS then return cap end
    local w = love.window
    if w and w.hasFocus and not w.hasFocus() then return P.AWAY_FPS end
    return cap
end

function P.set_resolution(i)
    GR().perf_resolution = i
    if love and love.resize then love.resize(love.graphics.getDimensions()) end
end

function P.set_shine(i)
    GR().perf_shader_quality = i
end

function P.set_shadows(on)
    GR().shadows = on and 'On' or 'Off'
end

function P.set_texture_filter(i)
    local g = GR()
    g.perf_texture_filter = i
    local mode = (g.texture_scaling == 1 or i == 2) and 'nearest' or 'linear'
    love.graphics.setDefaultFilter(mode, mode, 1)
    for _, list in ipairs({G.ASSET_ATLAS or {}, G.ANIMATION_ATLAS or {}}) do
        for _, a in pairs(list) do
            if type(a) == 'table' and a.image and a.image.setFilter then pcall(a.image.setFilter, a.image, mode, mode) end
        end
    end
end

G.FUNCS.perf_reset_all = function()
    local g = GR()
    g.performance_mode = false
    g._perf_mode_restore = nil
    for k, v in pairs(P.DEFAULTS) do g[k] = v end
    G.SETTINGS.perf_heavy_scoring = false
    P.set_particles(1)
    P.set_background(1)
    P.set_texture_filter(1)
    if apply_gc_tuning then apply_gc_tuning(false) end
    P.set_resolution(1)
    if G.save_settings then pcall(function() G:save_settings() end) end
    if UIK and UIK.refresh then UIK.refresh() end
end

