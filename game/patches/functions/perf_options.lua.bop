        love.graphics.setColor(c[1], c[2], c[3], 1)
        love.graphics.rectangle('fill', 0, 0, cw, ch)
        love.graphics.pop()
        add_to_drawhash(spr)
        return true
    end
    local ps = math.sqrt(cw * cw + ch * ch) / P.BG_PIXELS
    if ps < 1 then return false end
    local bw, bh = math.ceil(cw / ps), math.ceil(ch / ps)
    local fresh = false
    if not (P.bg_canvas and P.bg_canvas:getWidth() == bw and P.bg_canvas:getHeight() == bh) then
        local ok, canvas = pcall(love.graphics.newCanvas, bw, bh)
        if not ok or not canvas then return false end
        if P.bg_canvas then P.bg_canvas:release() end
        P.bg_canvas = canvas
        P.bg_canvas:setFilter('nearest', 'nearest')
        fresh = true
    end
    local redraw = fresh or mode == 1 or P.bg_shader ~= step.shader
    if not redraw and mode == 2 then
        redraw = (G.FRAMES.DRAW % P.SLOW_EVERY) == 0
    elseif not redraw and mode == 3 then
        local s = sig_of(step, bw, bh)
        redraw = s ~= P.bg_sig
        P.bg_sig = s
    end
    if redraw then
        P.bg_shader = step.shader
        local send = step.send
        if mode == 3 then step.send = frozen_send(step) end
        love.graphics.push('all')
        love.graphics.setCanvas(P.bg_canvas)
        love.graphics.clear(0, 0, 0, 1)
