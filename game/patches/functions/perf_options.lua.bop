l 11
        love.graphics.scale(G.CANV_SCALE * bw / cw, G.CANV_SCALE * bh / ch)
        G.BG_UNZOOM = unzoom
        spr:translate_container()
        G.BG_UNZOOM = nil
        spr:draw()
        love.graphics.pop()
        step.send = send
    else
        add_to_drawhash(spr)
    end
    love.graphics.push('all')
