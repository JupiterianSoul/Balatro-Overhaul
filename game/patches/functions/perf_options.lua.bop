PERF_OPTS = PERF_OPTS or {}
local P = PERF_OPTS

P.DEFAULTS = {
    perf_resolution = 1,
    perf_shader_quality = 3,
    perf_particles = true,
    perf_particle_amount = 1,
    perf_background = 1,
    perf_bg_anims = true,
    perf_gc_tuning = false,
    perf_texture_filter = 1,
    perf_canvas_caching = false,
    perf_offscreen_culling = false,
    perf_away_slow = false,
    shadows = 'On',
}

P.PRESET = {
    perf_resolution = 2,
    perf_shader_quality = 1,
    perf_particle_amount = 2,
    perf_background = 3,
    perf_offscreen_culling = true,
    perf_gc_tuning = true,
    perf_away_slow = true,
    shadows = 'Off',
}

P.BG_SHADERS = {background = true, splash = true}
P.BG_PIXELS = 700
P.SLOW_EVERY = 3
P.AWAY_FPS = 15

local function GR() return G and G.SETTINGS and G.SETTINGS.GRAPHICS end

function P.fill_defaults()
    local g = GR()
    if not g then return end
    for k, v in pairs(P.DEFAULTS) do
        if g[k] == nil then g[k] = v end
    end
    if g.perf_particles == false and g.perf_particle_amount == 1 then g.perf_particle_amount = 3 end
end

function P.particle_mult()
    local g = GR()
    if not g then return 1 end
    local a = g.perf_particle_amount or (g.perf_particles == false and 3 or 1)
    if a >= 3 or g.perf_particles == false then return 0 end
    return a == 2 and 2 or 1
end

function P.set_particles(i)
    local g = GR()
    g.perf_particle_amount = i
    g.perf_particles = i < 3
end

function P.set_background(i)
    local g = GR()
    g.perf_background = i
    g.perf_bg_anims = i < 3
    P.bg_sig = nil
end

local function sig_of(step, w, h)
    local parts = {step.shader, w, h}
    for _, v in ipairs(step.send or {}) do
        if v.name ~= 'time' and v.name ~= 'spin_time' then
            local val = v.val
            if val == nil and v.ref_table then val = v.ref_table[v.ref_value] end
            if type(val) == 'table' then
                for i = 1, 4 do parts[#parts + 1] = val[i] or 0 end
            else
                parts[#parts + 1] = tostring(val)
            end
        end
    end
    return table.concat(parts, ':')
end

local function frozen_send(step)
    P.frozen = P.frozen or {}
    local key = step.shader
    local out = {}
    for i, v in ipairs(step.send or {}) do
        if v.name == 'time' or v.name == 'spin_time' then
            P.frozen[key .. v.name] = P.frozen[key .. v.name] or (v.val or (v.ref_table and v.ref_table[v.ref_value]) or 0)
            out[i] = {name = v.name, val = P.frozen[key .. v.name]}
        else
            out[i] = v
        end
    end
    return out
end

function P.draw_background(spr, unzoom)
    local g = GR()
    if not g or not spr or not spr.draw_steps or #spr.draw_steps ~= 1 or not G.CANVAS then return false end
    local step = spr.draw_steps[1]
    if not P.BG_SHADERS[step.shader] or not spr.states.visible or next(spr.children) then return false end
    local mode = g.perf_background or 1
    local cw, ch = G.CANVAS:getDimensions()
    if mode >= 4 then
        local c = step.shader == 'background' and G.C.BACKGROUND and G.C.BACKGROUND.C
        if not c then
            for _, v in ipairs(step.send or {}) do
                if v.name == 'colour_1' then c = v.val or (v.ref_table and v.ref_table[v.ref_value]) end
            end
        end
        c = c or G.C.BLACK
        love.graphics.push('all')
