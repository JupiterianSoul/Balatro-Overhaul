P.JIMBO_PAD = 0.1

local function jimbo_col(cfg)
  if not cfg then return end
  if P.on() then
    if (cfg.padding or 0) > P.JIMBO_PAD then
      cfg.portrait_land_pad = cfg.padding
      cfg.padding = P.JIMBO_PAD
    end
  elseif cfg.portrait_land_pad then
    cfg.padding = cfg.portrait_land_pad
    cfg.portrait_land_pad = nil
  end
end

function P.jimbo_def(t)
  local function walk(n, col)
    if type(n) ~= 'table' then return false end
    if n.n == G.UIT.C then col = n end
    if n.config and n.config.id == 'jimbo_spot' then
      if col then jimbo_col(col.config) end
      return true
    end
    for _, c in ipairs(n.nodes or {}) do
      if walk(c, col) then return true end
    end
    return false
  end
  walk(t)
  return t
end

function P.jimbo_live(box)
  local spot = box and box.get_UIE_by_ID and box:get_UIE_by_ID('jimbo_spot')
  local col = spot and spot.parent
  while col and col.UIT ~= G.UIT.C do col = col.parent end
  if col then jimbo_col(col.config) end
end

P.DECK_ROW = 4.2

local function deck_row(a)
  if not (a and a.config and a.config.view_deck and a.T) then return false end
  if P.on() then
    if a.T.w > P.DECK_ROW * G.CARD_W then
      setw(a, P.DECK_ROW * G.CARD_W)
      return true
    end
  elseif a.portrait_land_w then
    restorew(a)
    return true
  end
  return false
end

function P.deck_def(t)
  local function walk(n)
    if type(n) ~= 'table' then return end
    if n.n == G.UIT.O and n.config then deck_row(n.config.object) end
    for _, c in ipairs(n.nodes or {}) do walk(c) end
  end
  walk(t)
  local mid = t.nodes and t.nodes[2]
  local k = mid and mid.nodes
  if P.on() and k and #k == 3 and k[1].n == G.UIT.C and k[3].n == G.UIT.C then
    mid.nodes = {
      {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {k[1]}},
      {n = G.UIT.R, config = {align = 'cm', minh = 0.15, padding = 0}, nodes = {}},
      {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {k[3]}},
    }
  end
  return t
end

function P.deck_live(box)
  local boxes = {}
  local function walk(e, d)
    if not e or d > 40 then return end
    if e.UIT == G.UIT.O and e.config and deck_row(e.config.object) and e.UIBox then boxes[#boxes + 1] = e.UIBox end
    for _, c in pairs(e.children or {}) do
      if type(c) == 'table' and c.UIT then walk(c, d + 1) end
      if type(c) == 'table' and c.UIRoot then walk(c.UIRoot, d + 1) end
    end
    local o = e.config and e.config.object
    if o and o.UIRoot then walk(o.UIRoot, d + 1) end
  end
  if box and box.UIRoot then walk(box.UIRoot, 0) end
  local done = {}
  for i = #boxes, 1, -1 do
    local b = boxes[i]
    if not done[b] and b ~= box and b.recalculate then
      done[b] = true
      b:recalculate()
    end
  end
end

