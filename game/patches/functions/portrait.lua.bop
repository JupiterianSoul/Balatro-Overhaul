if raw_bc then
  function create_UIBox_blind_choice(kind, run_info, ...)
    local t = raw_bc(kind, run_info, ...)
    if P.on() and not run_info and type(t) == 'table' then pcall(squeeze, t, P.filled() and P.FILL_BLIND or 0.86, 0) end
    return t
  end
end

function P.cap_shop(area)
  if P.on() and area then area.T.w = math.min(area.T.w, P.W - 1.4) end
end

function P.shop_def(t)
  local nr = def_find(t, function(n) return n.config and n.config.id == 'next_round_button' end)
  local function parent_of(root, child)
    return def_find(root, function(n)
      for _, c in ipairs(n.nodes or {}) do if c == child then return true end end
      return false
    end)
  end
  local btns = nr and parent_of(t, nr)
  local row1 = btns and parent_of(t, btns)
  if not (btns and row1 and #row1.nodes == 2) then return t end
  for _, b in ipairs(btns.nodes) do b.n = G.UIT.C end
  btns.n = G.UIT.R
  btns.config.padding = 0.1
  row1.nodes[2].n = G.UIT.R
  local main = parent_of(t, row1)
  local last = main and main.nodes and main.nodes[#main.nodes]
  if main and main.config and last and last ~= row1 and last.nodes and #last.nodes > 0 then
    main.config.portrait_fill = 'main'
    row1.nodes[2].config.portrait_fill = 'panel'
    last.nodes[#last.nodes].config.portrait_fill = 'panel'
    if P.fill_on() then
      for i = #main.nodes - 1, 2, -1 do
        local s = main.nodes[i]
        if s ~= row1 and s.n == G.UIT.R and s.config and s.config.minh and s.config.minh <= 0.25 and #(s.nodes or {}) == 0 then table.remove(main.nodes, i) end
      end
    end
  end
  if G.shop_vouchers and G.shop_vouchers.config and (G.shop_vouchers.config.card_limit or 1) <= 1 then
    setw(G.shop_vouchers, 1.1 * G.CARD_W)
  end
  return t
end

if G.UIDEF and G.UIDEF.shop then
  local raw_shop = G.UIDEF.shop
  G.UIDEF.shop = function(...)
    local t = raw_shop(...)
    if P.on() and type(t) == 'table' then
      local ok, err = pcall(P.shop_def, t)
      if not ok then print('[PORTRAIT] shop layout failed: ' .. tostring(err)) end
    end
    return t
  end
end

local function fill_find(n, kind, out, d)
  if type(n) ~= 'table' or d > 40 then return out end
  if n.config and n.config.portrait_fill == kind then out[#out + 1] = n end
  for _, c in ipairs(n.children or {}) do fill_find(c, kind, out, d + 1) end
  return out
end

function P.fill_w()
  local pad = G.ROOM_PADDING_W or 0
  return G.TILE_W + 2 * pad - 2 * P.FILL_M
end

local function widen(n, d)
  if not (n and n.T and n.config) or d <= 0 then return end
  n.config.minw = math.max(n.config.minw or 0, n.T.w) + d
end

local function fill_box(box, fn)
  if not (type(box) == 'table' and box.UIRoot and box.T and not box.REMOVED) or box.portrait_filled then return end
  box.portrait_filled = true
  if not P.filled() then return end
  for _ = 1, 3 do
    local delta = P.fill_w() - box.T.w
    if math.abs(delta) < 0.01 then break end
    if not fn(box, delta) then break end
    box:recalculate()
  end
  force_align(box)
end

local function fill_find_minw(n, d)
  if type(n) ~= 'table' or d > 12 then return nil end
  if n.config and n.config.minw and n.config.minw >= 3.5 then return n end
  for _, c in ipairs(n.children or {}) do
    local r = fill_find_minw(c, d + 1)
    if r then return r end
  end
end

local function top_of(main, n)
  while n and n.parent and n.parent ~= main do n = n.parent end
  return n and n.parent == main and n or nil
end

function P.fill_shop(box)
  fill_box(box, function(b, delta)
    local main = fill_find(b.UIRoot, 'main', {}, 0)[1]
    if not (main and main.T) or delta < 0 then return false end
    widen(main, delta)
    b:recalculate()
    local need = main.T.w - 2 * (main.config.padding or 0)
    local panels = fill_find(b.UIRoot, 'panel', {}, 0)
    for _, n in ipairs(panels) do
      local row = top_of(main, n)
      if row and row.T and n.T and need - row.T.w > 0.01 then widen(n, need - row.T.w) end
    end
    b:recalculate()
    local last = main.children[#main.children]
    local kids = last and last.children
    if kids and #kids > 0 then
      local span = kids[#kids].T.x + kids[#kids].T.w - kids[1].T.x
      for _, n in ipairs(panels) do
        if top_of(main, n) ~= last and span - n.T.w > 0.01 then widen(n, span - n.T.w) end
      end
    end
    return true
  end)
end

function P.fill_hud(box)
  fill_box(box, function(b, delta)
    local inner = b.UIRoot.children[1] and b.UIRoot.children[1].children[1]
    local cols = inner and inner.children
    if not (cols and #cols == 2) or delta < 0 then return false end
    widen(cols[1], delta / 2)
    widen(cols[2], delta / 2)
    return true
  end)
end

function P.fill_buttons(box)
  fill_box(box, function(b, delta)
    local play, disc = b:get_UIE_by_ID('play_button'), b:get_UIE_by_ID('discard_button')
    if not (play and disc) or delta < 0 then return false end
    widen(play, delta / 2)
    widen(disc, delta / 2)
    return true
  end)
end

function P.fill_pack(box)
  if not (type(box) == 'table' and box.UIRoot and box.T and not box.REMOVED) or box.portrait_filled then return end
  box.portrait_filled = true
  if not P.filled() then return end
  local root = box.UIRoot.children[1]
  local rows = root and root.children
  local last = rows and rows[#rows]
  local kids = last and last.children
  local mid = kids and #kids == 3 and kids[2]
  local panel = mid and mid.children and mid.children[1]
  local inner = mid and fill_find_minw(mid, 0)
  local skip = kids and kids[3]
  if not (panel and inner and skip and skip.T) then return end
  kids[1].config.minw, kids[1].config.padding = 0, 0
  skip.config.minw = nil
  box.UIRoot.config.padding, root.config.padding = 0, 0
  box:recalculate()
  for _ = 1, 3 do
    local ink = skip.T.x + skip.T.w - (skip.config.padding or 0) - panel.T.x
    local delta = P.fill_w() - ink
    if math.abs(delta) < 0.01 then break end
    inner.config.minw = math.max(3.5, inner.config.minw + delta)
    box:recalculate()
  end
  force_align(box)
end

local raw_eval_def = create_UIBox_round_evaluation
if raw_eval_def then
  function create_UIBox_round_evaluation(...)
    local t = raw_eval_def(...)
    if P.filled() and type(t) == 'table' and G.hand and G.hand.T then
      local from, to = G.hand.T.w - 2, P.fill_w() - 0.53
      local function walk(n, d)
        if type(n) ~= 'table' or d > 20 then return end
        if n.config and n.config.minw and math.abs(n.config.minw - from) < 0.001 then n.config.minw = to end
        for _, c in ipairs(n.nodes or {}) do walk(c, d + 1) end
      end
      if to > from then walk(t, 0) end
    end
    return t
  end
end

function P.set_fill()
  if not (love and love.graphics and love.resize) then return end
  local w, h = love.graphics.getDimensions()
  love.resize(w, h)
  if not P.on() or G.STAGE ~= G.STAGES.RUN then return end
  P.rebuild_hud()
  P.rebuild_shop()
  P.layout_run()
  P.rebuild_buttons()
  realign(G.buttons)
  P.place_floats()
  pcall(P.settle)
end

local raw_bs = create_UIBox_blind_select
if raw_bs then
  function create_UIBox_blind_select(...)
    local t = raw_bs(...)
    if P.on() and type(t) == 'table' then
      local row = def_find(t, function(n) return n.n == G.UIT.R and n.config and n.config.padding == 0.5 end)
      if row then row.config.padding = 0.08 end
    end
    return t
  end
end

local function settle_area(a)
  if not (a and a.cards and a.T) then return end
  if a.role and a.role.role_type == 'Minor' and a.move_with_major then a:move_with_major(0) end
  a:hard_set_VT()
  if a.align_cards then a:align_cards() end
  for _, c in ipairs(a.cards) do
    c:hard_set_VT()
    for _, ch in pairs(c.children or {}) do
      if type(ch) == 'table' and ch.role then
        if ch.role.role_type == 'Glued' and ch.glue_to_major then
          ch:glue_to_major(c)
        elseif ch.role.role_type == 'Minor' and ch.alignment and ch.UIRoot then
          snap(ch)
        end
      end
    end
  end
end

function P.settle()
  for _, b in ipairs({G.HUD, G.HUD_blind, G.buttons, G.shop, G.blind_select, G.round_eval, G.booster_pack, G.MOD_FLOATING_BUTTON}) do
    if type(b) == 'table' and b.alignment and not b.REMOVED then snap(b) end
  end
  for _, t in ipairs(G.HUD_tags or {}) do
    if type(t) == 'table' and t.alignment and not t.REMOVED then snap(t) end
  end
  for _, a in ipairs({G.hand, G.play, G.jokers, G.consumeables, G.deck, G.discard, G.shop_jokers, G.shop_vouchers, G.shop_booster, G.pack_cards}) do
    settle_area(a)
  end
end

function P.place_tags()
  local t = G.HUD_tags and G.HUD_tags[1]
  if not (t and t.alignment) then return end
  if P.on() then
    t.portrait_tag = true
    local up = (G.hand and G.hand.T and G.play and G.play.T) and (G.TILE_H - P.hand_top()) or 4.5
    t:set_alignment({type = 'bli', offset = {x = P.EDGE, y = -(up + 0.25)}, major = G.ROOM_ATTACH})
  elseif t.portrait_tag then
    t.portrait_tag = nil
    t:set_alignment({type = 'bri', offset = {x = 0.7, y = 0}, major = G.ROOM_ATTACH})
  end
  snap(t)
end

function P.place_mods_button()
  local b = G.MOD_FLOATING_BUTTON
  if not (b and b.alignment and G.deck and G.deck.T) or b.cheats_pinned then return end
  if P.on() then
    b.portrait_land = b.portrait_land or {type = b.alignment.type, x = b.alignment.offset.x, y = b.alignment.offset.y}
    b:set_alignment({type = 'tri', offset = {x = -(P.EDGE + G.deck.T.w + 0.25), y = G.deck.T.y + 0.2}})
  elseif b.portrait_land then
    b:set_alignment({type = b.portrait_land.type, offset = {x = b.portrait_land.x, y = b.portrait_land.y}})
    b.portrait_land = nil
  end
  snap(b)
end

P.FLOATS = {'mps_chat_open_run', 'social_emote_open_run'}

local function float_key(node, depth)
  if type(node) ~= 'table' or depth > 6 then return nil end
  local b = node.config and node.config.button
  if b then
    for _, k in ipairs(P.FLOATS) do if k == b then return b end end
  end
  for _, c in ipairs(node.children or {}) do
    local r = float_key(c, depth + 1)
    if r then return r end
  end
end

local function float_set(box, x, y)
  if P.on() then
    local o = box.alignment.offset
    if not box.portrait_land then
      box.portrait_land = {type = box.alignment.type, x = o.x, y = o.y}
      box:set_alignment({type = 'tli', offset = {x = x, y = y}})
      snap(box)
    elseif math.abs(o.x - x) > 0.001 or math.abs(o.y - y) > 0.001 then
      o.x, o.y = x, y
      snap(box)
    end
  elseif box.portrait_land then
    local l = box.portrait_land
    box.portrait_land = nil
    box:set_alignment({type = l.type, offset = {x = l.x, y = l.y}})
    snap(box)
  end
end

function P.place_floats()
  local boxes = G.I and G.I.UIBOX
  if not (boxes and G.ROOM_ATTACH) then return end
  local race = rawget(_G, 'bom_race')
  local live = race and race.S and race.S.box
  if live and not live.REMOVED and live.alignment then live.portrait_float = 'race' end
  local by = {}
  for _, box in ipairs(boxes) do
    if box.portrait_float == nil then
      box.portrait_float = (box.role and box.role.major == G.ROOM_ATTACH and box.alignment and box.UIRoot and float_key(box.UIRoot, 0)) or false
    end
    if box.portrait_float and not box.REMOVED then by[box.portrait_float] = box end
  end
  local W, H, E = G.TILE_W, G.TILE_H, P.EDGE
  local rb = by.race and by.race.T and by.race
  if rb then float_set(rb, W - E - rb.T.w, P.stage_top()) end
  local chat, emote = by.mps_chat_open_run, by.social_emote_open_run
  local c, d = G.consumeables and G.consumeables.T, G.deck and G.deck.T
  if not (c and d) then return end
  local cx = (c.x + c.w + d.x) / 2
  local mid = d.y + d.h / 2
  local both = chat and chat.T and emote and emote.T
  if chat and chat.T then
    float_set(chat, cx - chat.T.w / 2, both and (mid - chat.T.h - 0.1) or (mid - chat.T.h / 2))
  end
  if emote and emote.T then
    float_set(emote, cx - emote.T.w / 2, both and (mid + 0.1) or (mid - emote.T.h / 2))
  end
  local wo = G.BOM_PVP_WAITING_OVERLAY
  if wo and not wo.REMOVED and wo.T and wo.alignment and G.hand and G.hand.T and G.play and G.play.T then
    local top = d.y + d.h
    if emote and emote.T then top = math.max(top, (both and (mid + 0.1) or (mid - emote.T.h / 2)) + emote.T.h) end
    if chat and chat.T and not both then top = math.max(top, mid + chat.T.h / 2) end
    local h = wo.T.h
    P.wait_top = top
    local y = top + math.max(0.2, (P.hand_top() + P.wait_drop() - top - h) / 2)
    y = math.max(top + 0.2, math.min(y, P.screen_bottom() - h - E))
    float_set(wo, (W - wo.T.w) / 2, y)
  end
end

local function trim_dots(def, width)
  local o = def and def.nodes and def.nodes[1] and def.nodes[1].config and def.nodes[1].config.object
  local c = o and o.config
  local s = c and type(c.string) == 'table' and c.string[1]
  if not (type(s) == 'string' and s:match('^%.+$') and c.W and c.W > width) then return end
  local nc = {}
  for k, v in pairs(c) do nc[k] = v end
  nc.string = {s:sub(1, math.max(1, math.floor(#s * width / c.W)))}
  o:remove()
  def.nodes[1].config.object = DynaText(nc)
end

function P.watch_eval(box)
  if not (type(box) == 'table' and box.add_child) or box.portrait_watch then return end
  box.portrait_watch = true
  local raw_add = box.add_child
  box.add_child = function(self, node, parent)
    if P.on() then pcall(trim_dots, node, self.T.w - 0.51) end
    return raw_add(self, node, parent)
  end
end

local function zone(m, x, y, w, h)
  m.T.x, m.T.y, m.T.w, m.T.h = x, y, w, h
  if m.hard_set_VT then m:hard_set_VT() end
end

function P.drag_targets(card)
  local D = G.DRAG_TARGETS
  if not P.on() then
    if D and D.portrait_born then
      for _, m in pairs(D) do if type(m) == 'table' and m.remove then m:remove() end end
      G.DRAG_TARGETS = nil
    elseif D then
      for _, m in pairs(D) do
        if type(m) == 'table' and m.portrait_land then
          zone(m, m.portrait_land.x, m.portrait_land.y, m.portrait_land.w, m.portrait_land.h)
          m.portrait_land = nil
        end
      end
    end
    return
  end
  if not (card and G.STAGE == G.STAGES.RUN and G.jokers and G.consumeables and G.deck and G.play) then return end
  if not D then
    D = {portrait_born = true}
    for _, k in ipairs({'S_buy', 'S_buy_and_use', 'C_sell', 'J_sell', 'C_use', 'P_select'}) do D[k] = Moveable{T = {x = 0, y = 0, w = 1, h = 1}} end
    G.DRAG_TARGETS = D
  end
  for _, m in pairs(D) do
    if type(m) == 'table' and m.T and not m.portrait_land and not D.portrait_born then
      m.portrait_land = {x = m.T.x, y = m.T.y, w = m.T.w, h = m.T.h}
    end
