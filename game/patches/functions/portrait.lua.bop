function P.reopen(o)
  local rec = type(o) == 'table' and o.portrait_open
  if not (rec and rec.fn) then return false end
  local cap = {}
  local ps = play_sound
  play_sound = function() end
  local pages = {}
  if rawget(_G, 'UIK') and UIK._pages then for k, v in pairs(UIK._pages) do pages[k] = v end end
  local ua = uik_state(o)
  local pre_uik = ua and {id = ua.id, cur = ua._cur}
  P._capture = cap
  local ok, err = pcall(rec.fn, unpack(rec.args, 1, rec.n))
  P._capture = nil
  if err ~= CAPTURE or type(cap.args) ~= 'table' or type(cap.args.definition) ~= 'table' then
    play_sound = ps
    if not ok and err ~= CAPTURE then print('[PORTRAIT] reopen ' .. rec.src .. ' failed: ' .. tostring(err)) end
    return type(G.OVERLAY_MENU) ~= 'table'
  end
  local okS, s = pcall(P.save_state, o)
  if okS and s then s.pages, s.uik = pages, pre_uik end
  if G.CONTROLLER and G.CONTROLLER.text_input_hook and okS and s and s.hooked then G.CONTROLLER.text_input_hook = nil end
  local a = cap.args
  a.key = G.OVERLAY_MENU_KEY
  P._reopening = true
  local ok2, err2 = pcall(G.FUNCS.overlay_menu, a)
  P._reopening = false
  if G.OVERLAY_MENU == true then G.OVERLAY_MENU = nil end
  local new = G.OVERLAY_MENU
  if type(new) == 'table' and new ~= o then
    new.portrait_open = rec
    if okS and s then
      P._reopening = true
      local okL, errL = pcall(P.load_state, new, s)
      P._reopening = false
      if not okL then print('[PORTRAIT] reopen state: ' .. tostring(errL)) end
      if G.OVERLAY_MENU == true then G.OVERLAY_MENU = nil end
      if type(G.OVERLAY_MENU) == 'table' and G.OVERLAY_MENU ~= new then
        new = G.OVERLAY_MENU
        new.portrait_open = rec
      end
    end
    pcall(new.recalculate, new)
  end
  play_sound = ps
  if not ok2 then print('[PORTRAIT] reopen ' .. rec.src .. ' open failed: ' .. tostring(err2)) end
  return type(new) == 'table' and new ~= o
end

local function keeps_own_rebuild(o, def)
  local c = def and def.config
  local a = UIK and UIK._win
  if c and (c.uik_zoom or c.uik_win) and a and a.rebuild and (not c.uik_id or a.id == c.uik_id) then return true end
  if G.OVERLAY_MENU_KEY == 'mods_menu' and c and c.back_func == 'workshop_back' then return true end
  if c and c.back_func == 'mod_menu_back' then return true end
  if G.BOM_LOBBY_OVERLAY and o == G.BOM_LOBBY_OVERLAY then return true end
  return false
end

