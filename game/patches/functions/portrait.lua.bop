local function mg_win()
  local mg = rawget(_G, 'Minigames')
  local host = mg and mg.host
  local win = host and host.win
  if win and not win.REMOVED and win.T and not host.closing then return win end
end

function P.fit_target(t)
  local win = mg_win()
  if not win then return t end
  local wt = win.T
  local c = win.UIRoot and win.UIRoot.children and win.UIRoot.children[1]
  if wt.w > G.TILE_W * 2 and c and c.T then wt = c.T end
  if not t or wt.w > t.w then return wt end
  return t
end

function P.minigames()
  local mg = rawget(_G, 'Minigames')
  local pk = mg and mg.pick
  local b = pk and pk.hidden and pk.box
  if b and b.alignment and not b.REMOVED and b.alignment.offset.y == 15 then
    b.alignment.offset.y = G.TILE_H + 5
    b:align_to_major()
  end
end

function P.idle_zoom(w, h, base)
  if not (G.STAGE == G.STAGES.MAIN_MENU and G.SPLASH_LOGO and G.SPLASH_LOGO.T) then return 1 end
  local uw = w / (G.TILESIZE * base)
  local z = math.min(1, uw * P.LOGO_FILL / G.SPLASH_LOGO.T.w)
  return math.max(0.5, math.floor(z * 20) / 20)
end

function P.bg_unzoom()
  if not (P.on() and type(G.OVERLAY_MENU) == 'table' and G.ROOM and G.ROOM.T and G.TILESIZE and G.TILESCALE) then return end
  local z = G.MENU_ZOOM or 1
  local w, h = love.graphics.getDimensions()
  local zb = 1
  if G.STAGE == G.STAGES.MAIN_MENU and ui_size_fit then zb = P.idle_zoom(w, h, ui_size_fit(w, h)) end
  if math.abs(z - zb) < 0.01 then return end
  local s = G.TILESIZE * G.TILESCALE
  local k = zb / z
  local x, y
  if zb == 1 and G.ROOM_UNZOOMED then
    x, y = G.ROOM_UNZOOMED.x, G.ROOM_UNZOOMED.y
  else
    x, y = (w / (s * k) - G.ROOM.T.w) / 2, (h / (s * k) - G.ROOM.T.h) / 2
  end
  return {tx = x * s * k, ty = y * s * k, s = k, rx = -G.ROOM.T.x * s, ry = -G.ROOM.T.y * s}
end

local function main_menu_rebuild()
  if not (G.STAGE == G.STAGES.MAIN_MENU and G.MAIN_MENU_UI and set_main_menu_UI) then return end
  G.MAIN_MENU_UI:remove()
  G.MAIN_MENU_UI = nil
  if G.collection_alert then G.collection_alert:remove() G.collection_alert = nil end
  set_main_menu_UI()
  if set_alerts then pcall(set_alerts) end
