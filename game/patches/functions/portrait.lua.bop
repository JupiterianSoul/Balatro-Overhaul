P.MOD_MENU_TABS = {'mod_tab_cheats', 'mod_tab_jokers', 'mod_tab_consumables', 'mod_tab_cards', 'mod_tab_vouchers', 'mod_tab_poker_hands', 'mod_tab_settings'}

local function chosen_tab(n)
  if not n then return end
  local c = n.config
  if c and c.button == 'change_tab' and c.chosen and c.ref_table then return c.ref_table end
  for _, ch in pairs(n.children or {}) do
    local r = chosen_tab(ch)
    if r then return r end
  end
end

function P.mod_menu_tab(box)
  local t = box and chosen_tab(box.UIRoot)
  local f = t and t.tab_definition_function
  if not f then return end
  for i, k in ipairs(P.MOD_MENU_TABS) do
    if G.UIDEF[k] == f then return i end
  end
end

P.UIK_REBUILD = {mpm_profile = true, mpm_collection = true, mp_ranked = true}

P.REBUILD_DEFS = {jokers = 'create_UIBox_your_collection_jokers', achievements = 'create_UIBox_achievements_main'}

local CAPTURE = {}
P._ov_depth = 0

local function caller_rec(def)
  for lvl = 3, 14 do
    local info = debug.getinfo(lvl, 'fSu')
    if not info then return end
    if info.what ~= 'C' and info.func ~= P._ov_wrap then
      local n = info.nparams
      local args = {}
      if not n then
        n = 0
        for i = 1, 8 do
          local name = debug.getlocal(lvl, i)
          if not name or name:sub(1, 1) == '(' then break end
          if i == 1 then n = 1 end
        end
      end
      local holds = false
      for i = 1, n do
        local _, v = debug.getlocal(lvl, i)
        args[i] = v
        if type(v) == 'table' and (v == def or v.definition == def) then holds = true end
      end
      if not holds then return {fn = info.func, args = args, n = n, src = tostring(info.short_src) .. ':' .. tostring(info.linedefined)} end
    end
  end
end

function P.hook_overlay()
  local cur = G and G.FUNCS and G.FUNCS.overlay_menu
  if not cur or cur == P._ov_wrap then return end
  local inner = cur
  local wrap
  wrap = function(args, ...)
    if P._capture then
      P._capture.args = args
      error(CAPTURE, 0)
    end
    if P._ov_depth > 0 or P._reopening or type(args) ~= 'table' then return inner(args, ...) end
    local ok, rec = pcall(caller_rec, args.definition)
    P._ov_depth = P._ov_depth + 1
    local res = {pcall(inner, args, ...)}
    P._ov_depth = P._ov_depth - 1
    if ok and rec and type(G.OVERLAY_MENU) == 'table' and not G.OVERLAY_MENU.portrait_open then G.OVERLAY_MENU.portrait_open = rec end
    if not res[1] then error(res[2], 0) end
    return unpack(res, 2)
  end
  P._ov_wrap = wrap
  G.FUNCS.overlay_menu = wrap
end

local function each_node(n, fn, d)
  if type(n) ~= 'table' or (d or 0) > 60 then return end
  fn(n)
  for _, k in pairs(n.children or {}) do each_node(k, fn, (d or 0) + 1) end
  local ob = n.config and n.config.object
  if type(ob) == 'table' and ob.UIRoot and not ob.REMOVED then each_node(ob.UIRoot, fn, (d or 0) + 1) end
end

local function ordered_nodes(box, pred)
  local out = {}
  each_node(box and box.UIRoot, function(n) if pred(n) then out[#out + 1] = n end end)
  table.sort(out, function(a, b)
    local ta, tb = a.T, b.T
    if math.abs(ta.y - tb.y) > 0.05 then return ta.y < tb.y end
    return ta.x < tb.x
  end)
  return out
end

local function is_cycle(n)
  local c = n.config
  local r = c and c.button == 'option_cycle' and c.ref_value == 'r' and c.ref_table
  return type(r) == 'table' and type(r.options) == 'table' and type(r.current_option) == 'number' and r.opt_callback ~= nil
end

local function is_text(n)
  local c = n.config
  local a = c and c.button == 'select_text_input' and n.children and n.children[1] and n.children[1].config and n.children[1].config.ref_table
  return type(a) == 'table' and type(a.text) == 'table' and type(a.text.letters) == 'table'
end

P.TAB_BUTTONS = {set_cat = true, workshop_cat = true, speedrun_board_cat = true, bo_play_sr_cat = true, jukebox_tab_mine = true}

local function tab_like(n)
  local c = n.config
  local b = c and c.button
  if type(b) ~= 'string' or b == 'change_tab' or b == 'uik_tab' or not (c.choice and c.chosen) then return false end
  return P.TAB_BUTTONS[b] or b:find('tab') or b:find('_cat$') or false
end

local function tab_label(n)
  local found
  each_node(n, function(c) if not found and c.UIT == G.UIT.T and c.config and type(c.config.text) == 'string' then found = c.config.text end end)
  return found
end

local function tab_key(n)
  local c = n.config
  local r = type(c.ref_table) == 'table' and c.ref_table or {}
  return c.button .. ':' .. tostring(c.id or r.key or r.cat or r.id or r.label or tab_label(n) or '?')
end

local function uik_state(o)
  local a = rawget(_G, 'UIK') and UIK._win
  local c = o and o.definition and o.definition.config
  if a and c and c.uik_win and (not c.uik_id or a.id == c.uik_id) then return a end
end

function P.save_state(o)
  local s = {cycles = {}, texts = {}, choices = {}}
  local h = rawget(_G, 'OVERLAY_MENU_HELPERS') or {}
  if h.chosen_tabs then s.tabs = h.chosen_tabs(o) end
  local a = uik_state(o)
  if a then s.uik = {id = a.id, cur = a._cur} end
  for _, n in ipairs(ordered_nodes(o, tab_like)) do s.choices[#s.choices + 1] = tab_key(n) end
  local hook = G.CONTROLLER and G.CONTROLLER.text_input_hook
  for _, n in ipairs(ordered_nodes(o, is_cycle)) do
    local r = n.config.ref_table
    s.cycles[#s.cycles + 1] = {cb = r.opt_callback, cur = r.current_option, n = #r.options}
  end
  for i, n in ipairs(ordered_nodes(o, is_text)) do
    local a = n.children[1].config.ref_table
    local letters = {}
    for k, v in pairs(a.text.letters) do letters[k] = v end
    s.texts[#s.texts + 1] = {letters = letters, pos = a.text.current_position, value = a.ref_table and a.ref_table[a.ref_value], hooked = hook ~= nil and hook == n.children[1].children[1]}
    if s.texts[#s.texts].hooked then s.hooked = i end
  end
  if not s.hooked and P._rehook then s.hooked = P._rehook end
  return s
end

local function set_cycle(n, cur, total)
  local r = n.config.ref_table
  r.current_option = (cur - 2) % total + 1
  pcall(G.FUNCS.option_cycle, n)
  for k = 1, total do
    local pip = n.UIBox and n.parent and n.UIBox:get_UIE_by_ID('pip_' .. k, n.parent.parent)
    if pip then pip.config.colour = k == r.current_option and G.C.WHITE or G.C.BLACK end
  end
end

local function restore_choices(list)
  for _, key in ipairs(list or {}) do
    local cur = G.OVERLAY_MENU
    if type(cur) ~= 'table' then return end
    local hit
    each_node(cur.UIRoot, function(n) if not hit and n.config and n.config.button and n.config.choice and tab_key(n) == key then hit = n end end)
    local fn = hit and not hit.config.chosen and G.FUNCS[hit.config.button]
    if fn then
      pcall(fn, hit)
      if not hit.REMOVED and hit.UIBox and hit.config.group then
        for _, v in pairs(hit.UIBox:get_group(nil, hit.config.group) or {}) do if v.config and v.config.choice then v.config.chosen = false end end
      end
      if not hit.REMOVED then hit.config.chosen = true end
    end
  end
end

function P.load_state(o, s)
  local h = rawget(_G, 'OVERLAY_MENU_HELPERS') or {}
  if s.tabs and #s.tabs > 0 and h.restore_tabs then pcall(h.restore_tabs, s.tabs) end
  local a = s.uik and uik_state(o)
  local moved = false
  if s.pages and rawget(_G, 'UIK') and UIK._pages then
    for k, v in pairs(s.pages) do
      if UIK._pages[k] ~= v then UIK._pages[k] = v moved = true end
    end
  end
  if a and a.id == s.uik.id and s.uik.cur and a._cur ~= s.uik.cur then
    pcall(UIK.open_tab, s.uik.cur)
  elseif a and moved then
    pcall(UIK.refresh)
  end
  if s.choices and #s.choices > 0 then restore_choices(s.choices) end
  if G.OVERLAY_MENU ~= o and type(G.OVERLAY_MENU) == 'table' then o = G.OVERLAY_MENU end
  local list = ordered_nodes(o, is_cycle)
  local used, redo = {}, {}
  for _, c in ipairs(s.cycles) do
    for j, n in ipairs(list) do
      local r = n.config.ref_table
      if not used[j] and r.opt_callback == c.cb and #r.options == c.n then
        used[j] = true
        if r.current_option ~= c.cur and c.cur >= 1 and c.cur <= c.n then
          set_cycle(n, c.cur, c.n)
          redo[#redo + 1] = {n = n, cur = c.cur, total = c.n}
        end
        break
      end
    end
  end
  if #redo > 0 and G.E_MANAGER then
    G.E_MANAGER:add_event(Event({blocking = false, func = function()
      for _, d in ipairs(redo) do
        if not d.n.REMOVED and d.n.config.ref_table.current_option == d.cur then pcall(set_cycle, d.n, d.cur, d.total) end
      end
      return true
    end}))
  end
  local texts = ordered_nodes(o, is_text)
  if #texts == #s.texts then
    for i, n in ipairs(texts) do
      local a, t = n.children[1].config.ref_table, s.texts[i]
      for k, v in pairs(t.letters) do a.text.letters[k] = v end
      a.text.current_position = t.pos
      if a.ref_table and a.ref_value and t.value ~= nil then a.ref_table[a.ref_value] = t.value end
      if s.hooked == i and G.CONTROLLER then
