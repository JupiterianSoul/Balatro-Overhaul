P.SHOP_AREAS = {'shop_jokers', 'shop_vouchers', 'shop_booster'}

function P.rebuild_shop()
  local old = G.shop
  if not (old and not old.REMOVED and old.alignment and old.alignment.offset and G.STATE == G.STATES.SHOP and not (G.pack_cards and not G.pack_cards.REMOVED) and G.UIDEF and G.UIDEF.shop and G.hand) then return end
  local keep = {}
  for _, k in ipairs(P.SHOP_AREAS) do keep[k] = G[k] end
  local sign = G.SHOP_SIGN
  local off = {x = old.alignment.offset.x, y = old.alignment.offset.y}
  local ok, box = pcall(function() return UIBox{definition = G.UIDEF.shop(), config = {align = 'tmi', offset = off, major = G.hand, bond = 'Weak'}} end)
  if not ok then
    for k, a in pairs(keep) do G[k] = a end
    if G.SHOP_SIGN ~= sign and G.SHOP_SIGN and G.SHOP_SIGN.remove then G.SHOP_SIGN:remove() end
    G.SHOP_SIGN = sign
    print('[PORTRAIT] shop rebuild failed: ' .. tostring(box))
    return
  end
  for _, k in ipairs(P.SHOP_AREAS) do
    local from, to = keep[k], G[k]
    if from and to and from ~= to and from.cards then
      local list = {}
      for i, c in ipairs(from.cards) do list[i] = c end
      for _, c in ipairs(list) do
        from:remove_card(c)
        to:emplace(c)
      end
    end
  end
  box.portrait_off = old.portrait_off
  old:remove()
  G.shop = box
  if sign and sign ~= G.SHOP_SIGN and not sign.REMOVED then
    local soff = sign.alignment and sign.alignment.offset
    sign:remove()
    if soff and G.SHOP_SIGN and G.SHOP_SIGN.alignment then
      G.SHOP_SIGN.alignment.offset.x, G.SHOP_SIGN.alignment.offset.y = soff.x, soff.y
      force_align(G.SHOP_SIGN)
    end
  end
end

function P.place_bot_panel()
  local B = rawget(_G, 'BOT')
  local U = type(B) == 'table' and B.ui
  local box = U and U.panel_box
  if not (box and not box.REMOVED and box.alignment and box.alignment.offset and box.T) then return end
  if box == P._botbox then return end
  P._botbox = box
  if not P._bot_folded and not U.collapsed and U.rebuild_panel then
    P._bot_folded = true
    U.collapsed = true
    pcall(U.rebuild_panel)
    return
  end
  box.alignment.offset.x = -P.EDGE
  box.alignment.offset.y = P.stage_top() + box.T.h / 2 - G.TILE_H / 2
  force_align(box)
end

function P.restore_bot_panel()
  P._botbox = nil
  local B = rawget(_G, 'BOT')
  local box = type(B) == 'table' and B.ui and B.ui.panel_box
  if P.on() or not (box and not box.REMOVED and box.alignment and box.alignment.offset) then return end
  box.alignment.offset.x, box.alignment.offset.y = -0.7, -0.5
  force_align(box)
end

function P.menu_veil()
  local m = G.MAIN_MENU_UI
  if not (m and m.states) then return end
  local hide = P.on() and G.STAGE == G.STAGES.MAIN_MENU and type(G.OVERLAY_MENU) == 'table' or false
  if hide then
    if m.states.visible then
      m.portrait_hidden = true
      m.states.visible = false
    end
  elseif m.portrait_hidden then
    m.portrait_hidden = nil
    m.states.visible = true
  end
end

function P.overlay_ink(o)
  local r = o and o.UIRoot
  if not (r and r.T) then return end
  local x1, y1, x2, y2
  local function add(x, y, w, h)
    if not (w > 0.05 and h > 0.05) then return end
    x1, y1 = math.min(x1 or x, x), math.min(y1 or y, y)
    x2, y2 = math.max(x2 or x + w, x + w), math.max(y2 or y + h, y + h)
  end
  for _, ch in ipairs(r.children or {}) do
    if ch.T and not (ch.states and ch.states.visible == false) then add(ch.T.x - r.T.x, ch.T.y - r.T.y, ch.T.w, ch.T.h) end
  end
  if not x1 then return end
  if o.infotip_node == nil and o.get_UIE_by_ID then o.infotip_node = o:get_UIE_by_ID('overlay_menu_infotip') or false end
  local n = o.infotip_node
  local tip = n and n.config and n.config.object
  if type(tip) == 'table' and tip.UIRoot and tip.T and not tip.REMOVED and n.T then
    add(n.T.x - r.T.x + tip.T.x - n.T.x, n.T.y - r.T.y + tip.T.y - n.T.y, tip.T.w, tip.T.h)
  end
  return x1, y1, x2, y2
end

function P.center_overlay(o, now)
  o = o or G.OVERLAY_MENU
  if type(o) ~= 'table' or o.REMOVED or not (o.UIRoot and o.T and o.alignment and o.role and G.ROOM_ATTACH) then return end
  if o.role.major ~= G.ROOM_ATTACH or o.alignment.type ~= 'cm' or (o.Mid ~= o.UIRoot and o.Mid ~= o) then return end
  if o.T.w < G.TILE_W * 1.5 and o.T.h < G.TILE_H * 1.5 then return end
  local x1, y1, x2, y2 = P.overlay_ink(o)
  if not x1 then return end
  local r = o.UIRoot.T
  local dx, dy = r.w / 2 - (x1 + x2) / 2, r.h / 2 - (y1 + y2) / 2
  local at, ro = G.ROOM_ATTACH.T, G.ROOM_ORIG or G.ROOM.T
  local s = G.TILESIZE * G.TILESCALE
  if ro and s and s > 0 then
    local W, H = love.graphics.getDimensions()
    dx = dx + W / s / 2 - ro.x - (at.x + at.w / 2)
    dy = dy + H / s / 2 - ro.y - (at.y + at.h / 2)
  end
  local off = o.alignment.offset
  local ink = o.portrait_ink
  if not (ink and ink.ox == off.x and ink.oy == off.y) then ink = {x = 0, y = 0} end
  if not now and math.abs(dx - ink.x) < 0.01 and math.abs(dy - ink.y) < 0.01 then return end
  off.x, off.y = off.x - ink.x + dx, off.y - ink.y + dy
  o.portrait_ink = {x = dx, y = dy, ox = off.x, oy = off.y}
  o:align_to_major()
  if now and o.move_with_major then o:move_with_major(0) end
end

P.REFLOW_FILL = 0.94
P.REFLOW_STEPS = 16

local function overlay_inner(o)
  local c = o.UIRoot and o.UIRoot.children and o.UIRoot.children[1]
  if o.T.w > G.TILE_W * 2 and c and c.T then return c end
  return o.UIRoot
end

local function reflow_keep(o)
  local def = o.definition
  local c = def and def.config
  if c and c.portrait_keep then return true end
  if mg_win() then return true end
  return false
end

local function uik_w(o)
  local c = o and o.definition and o.definition.config
  return math.min(UIK.W or P.W, c and c.uik_cw or math.huge)
end

local function uik_body(o)
  local def = o.definition
  if not (def and def.config and (def.config.uik_zoom or def.config.uik_win) and o.get_UIE_by_ID) then return end
  local b = o:get_UIE_by_ID('uik_body')
  local box = b and b.config and b.config.object
  if box and box.UIRoot and box.recalculate then return box end
end

local function flip_kids(n)
  local list = {}
  for _, k in pairs(n.children or {}) do
    if type(k) == 'table' and k.UIT == G.UIT.C and k.T and not (k.config and k.config.portrait_keep) then list[#list + 1] = k end
  end
  return list
end

local function nat_w(n)
  local c = n.content_dimensions
  if not (c and c.w) or n.UIT == G.UIT.T or n.UIT == G.UIT.O or n.UIT == G.UIT.B then return n.T.w end
  return math.max(c.w, n.config and n.config.minw or 0)
end

local function row_kids(k)
  local c = 0
  for _, x in ipairs(k.children or {}) do
    if x.UIT ~= G.UIT.R then return -1 end
    c = c + 1
  end
  return c
end

local function is_table(list)
  if #list < 4 then return false end
  local n = row_kids(list[1])
  if n < 3 then return false end
  for i = 2, #list do
    local m = row_kids(list[i])
    if math.abs(m - n) > 1 or m < 3 then return false end
  end
  return true
end

local function chunk_cols(n, list, m, box)
  local set, first = {}, nil
  for _, k in ipairs(list) do set[k] = true end
  for i = #n.children, 1, -1 do
    if set[n.children[i]] then
      first = i
      table.remove(n.children, i)
    end
  end
  local wraps = {}
  for c = 1, math.ceil(#list / m) do
    box:set_parent_child({n = G.UIT.R, config = {align = n.config and n.config.align or 'cm', padding = 0}, nodes = {}}, n)
    local w = table.remove(n.children)
    table.insert(n.children, first + c - 1, w)
    wraps[c] = w
    for q = (c - 1) * m + 1, math.min(#list, c * m) do
      list[q].parent = w
      table.insert(w.children, list[q])
    end
  end
  return {n = n, list = list, wraps = wraps, first = first}
end

local function unchunk(s)
  local n = s.n
  for _, w in ipairs(s.wraps) do
    for i, x in ipairs(n.children) do
      if x == w then table.remove(n.children, i) break end
    end
  end
  for q, k in ipairs(s.list) do
    k.parent = n
    table.insert(n.children, s.first + q - 1, k)
  end
  for _, w in ipairs(s.wraps) do
    for i = #w.children, 1, -1 do w.children[i] = nil end
    w:remove()
  end
end

local function wide_node(n, box, tw, d, skip)
  if type(n) ~= 'table' or not n.T or d > 30 or nat_w(n) <= tw then return end
  if n.config and n.config.portrait_keep then return end
  if n.UIT ~= G.UIT.O and not skip[n] and #flip_kids(n) >= 2 then return n, box end
  local kids = {}
  for _, k in pairs(n.children or {}) do
    if type(k) == 'table' and k.T and nat_w(k) > tw then kids[#kids + 1] = k end
  end
  table.sort(kids, function(a, b) return nat_w(a) > nat_w(b) end)
  for _, k in ipairs(kids) do
    local a, b = wide_node(k, box, tw, d + 1, skip)
    if a then return a, b end
  end
  local obj = n.config and n.config.object
  if n.UIT == G.UIT.O and type(obj) == 'table' and obj.UIRoot and obj.recalculate then
    return wide_node(obj.UIRoot, obj, tw, d + 1, skip)
  end
end

local function narrow(n, tw, d)
  if type(n) ~= 'table' or d > 40 then return false end
  local hit = false
  local c = n.config
  if c and c.minw and c.minw > tw and n.content_dimensions and n.content_dimensions.w <= tw and n.UIT ~= G.UIT.ROOT then
    if P._minw_rec then P._minw_rec[#P._minw_rec + 1] = {c, c.minw} end
    c.minw = tw
    hit = true
  end
  for _, k in pairs(n.children or {}) do
    if type(k) == 'table' and k.UIT and narrow(k, tw, d + 1) then hit = true end
  end
  return hit
end

P.COLL_PAD = 1.2
P.COLL_CHROME = 3.4
P.COLL_ZMAX = 1.4
P.COLL_WFRAC = 0.8

function P.collection_rows(rows, w_mod, h_mod)
  local total, widest = 0, 0
  for _, n in ipairs(rows) do
    total = total + n
    widest = math.max(widest, n)
  end
  if total == 0 then return rows end
  w_mod, h_mod = w_mod or 1, h_mod or 1
  local W, H = love.graphics.getDimensions()
  local px = G.TILESIZE * ui_size_fit(W, H) * (G.UI_SIZE or 1)
  local uw, uh = W / px, H / px
  local zs, bz = {}, 0
  for c = 1, widest do
    local r = math.ceil(total / c)
    zs[c] = math.min(0.95 * uw / ((c * w_mod + 0.25) * G.CARD_W + P.COLL_PAD), 0.92 * uh / (r * (h_mod * G.CARD_H + 0.14) + P.COLL_CHROME), P.COLL_ZMAX)
    bz = math.max(bz, zs[c])
  end
  local best = 1
  for c = 1, widest do
    if zs[c] >= bz * 0.97 then best = c end
  end
  local function wfrac(c) return zs[c] * ((c * w_mod + 0.25) * G.CARD_W + P.COLL_PAD) / uw end
  if best < widest and wfrac(best) < P.COLL_WFRAC and zs[best + 1] >= bz * 0.88 then best = best + 1 end
  if best >= widest then return rows end
  local r = math.ceil(total / best)
  local per = math.ceil(total / r)
  local out = {}
  for i = 1, r do out[i] = math.min(per, total - per * (i - 1)) end
  return out
end

function P.reflow_width()
  return (G.TILE_W + 2 * P.PAD_W) * P.REFLOW_FILL
end

P.FILL_MAX = 1.6
P.FILL_MIN = 1.08
P.FILL_ROOM = 0.96

local function grow_live(n, f, d, seen)
  if type(n) ~= 'table' or d > 40 then return end
  local c = n.config
  if c and not seen[c] then
    seen[c] = true
    if c.minw then c.minw = c.minw * f end
    if c.maxw then c.maxw = c.maxw * f end
    if c.minh then c.minh = c.minh * f end
    if c.maxh then c.maxh = c.maxh * f end
    if c.padding and n.UIT ~= G.UIT.ROOT then c.padding = c.padding * f end
    if n.UIT == G.UIT.T and c.scale then c.scale = c.scale * f end
  end
  for _, k in pairs(n.children or {}) do
    if type(k) == 'table' and k.UIT then grow_live(k, f, d + 1, seen) end
  end
end

function P.fill_uik(o, box)
  if box.portrait_filled then return false end
  box.portrait_filled = true
  local root = box.UIRoot
  local content = root and root.children and root.children[2]
  if not (content and content.T and content.T.w > 0 and content.T.h > 0) then return false end
  local W, H = uik_w(o), (UIK.H or 15) - (UIK.TOP or 0)
  local f = math.min(P.FILL_MAX, W * P.FILL_ROOM / content.T.w, H * P.FILL_ROOM / content.T.h)
  if f < P.FILL_MIN then return false end
  grow_live(content, f, 0, {})
  box:recalculate()
  if content.T.w > W + 0.05 or content.T.h > H + 0.05 then
    grow_live(content, 1 / f, 0, {})
    box:recalculate()
    return false
  end
  o.portrait_fill = {box = box, content = content, f = f}
  return true
end

function P.unflow(o)
  if type(o) ~= 'table' or not o.recalculate then return end
  local hit = false
  for _, list in ipairs(o.portrait_flips or {}) do
    for _, k in ipairs(list) do k.UIT = G.UIT.C end
    hit = true
  end
  o.portrait_flips = nil
  local fl = o.portrait_fill
  if fl and fl.box and not fl.box.REMOVED then
    grow_live(fl.content, 1 / fl.f, 0, {})
    fl.box.portrait_filled = nil
    fl.box:recalculate()
    hit = true
  end
  o.portrait_fill = nil
  if hit then
    local body = uik_body(o)
    if body then body:recalculate() end
    o:recalculate()
    force_align(o)
  end
end

P.READ_PX = 26
P.READ_REF = 1080
P.READ_Q = 0.1
P.READ_ZMAX = 2.2
P.WRAP_MIN = 2.5

local function text_hs(n, out, d)
  if type(n) ~= 'table' or d > 60 or n.REMOVED or (n.states and n.states.visible == false) then return end
  local c = n.config
  if n.UIT == G.UIT.T and n.T and n.T.h > 0.02 and c and type(c.text) == 'string' and c.text:find('%S') then out[#out + 1] = n.T.h end
  for _, k in ipairs(n.children or {}) do text_hs(k, out, d + 1) end
  local ob = c and c.object
  if n.UIT == G.UIT.O and type(ob) == 'table' and ob.UIRoot and not ob.REMOVED then text_hs(ob.UIRoot, out, d + 1) end
end

function P.read_h(o)
  local out = {}
  text_hs(o.UIRoot, out, 0)
  if #out == 0 then return end
  table.sort(out)
  return out[math.max(1, math.floor(#out * P.READ_Q + 0.5))]
end

function P.base_px()
  return G.TILESIZE * G.TILESCALE / (G.MENU_ZOOM or 1)
end

function P.land_px()
  if not (P.active and land and love and love.graphics and ui_size_fit) then return P.base_px() end
  local w, h = love.graphics.getDimensions()
  if w < h then w, h = h, w end
  local prev, tw, th = G.window_prev, G.TILE_W, G.TILE_H
  G.window_prev, G.TILE_W, G.TILE_H = land.prev, land.w, land.h
  local base = ui_size_fit(w, h)
  local ui = math.min(ui_size_wanted(w, h), math.max(UI_SIZE_MIN, ui_size_max(w, h)))
  G.window_prev, G.TILE_W, G.TILE_H = prev, tw, th
  return G.TILESIZE * base * ui
end

function P.popup_k()
  if not (P.on() and G.TILESIZE and G.TILESCALE and G.TILESCALE > 0) then return 1 end
  return P.land_px() / (G.TILESIZE * G.TILESCALE)
end

function P.read_need(o)
  local h = P.read_h(o)
  if not (h and h > 0) then return 0 end
  local w, hh = love.graphics.getDimensions()
  return P.READ_PX * math.min(w, hh) / P.READ_REF / (h * P.base_px())
end

local function land_zoom(t)
  local w, h = love.graphics.getDimensions()
  local b = P.base_px()
  return math.min(0.95 * math.max(w, h) / b / t.w, 0.92 * math.min(w, h) / b / t.h, 1.4)
end

local LIVE_KEYS = {text_drawable = true, text_drawable_text = true, text_drawable_font = true, prev_value = true, button_UIE = true}

local function piece_w(c, s)
  local f = (c.lang or G.LANG).font
  return f.FONT:getWidth(s) * f.squish * (c.scale or 1) * f.FONTSCALE / G.TILESIZE
end

local function plain_text(k)
  local c = type(k) == 'table' and k.config
  return k.UIT == G.UIT.T and c and type(c.text) == 'string' and not c.ref_table and not c.vert and not c.button and not c.func
end

local function text_row(n)
  if n.UIT ~= G.UIT.R then return false end
  local kids = n.children or {}
  if #kids == 0 then return false end
  for _, k in ipairs(kids) do
    if not plain_text(k) then return false end
  end
  return true
end

local function text_rows(n, box, d, out, inmax)
  if type(n) ~= 'table' or d > 60 or n.REMOVED or (n.states and n.states.visible == false) then return end
  local c = n.config or {}
  if c.portrait_keep or c.button or c.button_UIE then return end
  if c.maxw then inmax = true end
  if text_row(n) then
    if not inmax then out[#out + 1] = {n = n, box = box} end
    return
  end
  for _, k in ipairs(n.children or {}) do text_rows(k, box, d + 1, out, inmax) end
  local ob = c.object
  if n.UIT == G.UIT.O and type(ob) == 'table' and ob.UIRoot and ob.recalculate and not ob.REMOVED then text_rows(ob.UIRoot, ob, d + 1, out, inmax) end
end

local function chars(s)
  local out = {}
  for ch in s:gmatch('[%z\1-\127\194-\244][\128-\191]*') do out[#out + 1] = ch end
  return out
end

local function wrap_lines(row, maxw)
  local lines, cur, cw = {}, {}, 0
  local function push()
    if #cur > 0 then lines[#lines + 1] = cur end
    cur, cw = {}, 0
  end
  local function add(c, s)
    if cw == 0 then s = s:gsub('^%s+', '') end
    if s == '' then return end
    cur[#cur + 1] = {c = c, s = s}
    cw = cw + piece_w(c, s)
  end
  for _, k in ipairs(row.children) do
    local c = k.config
    local words = {}
    for w in c.text:gmatch('%s*%S+') do words[#words + 1] = w end
    local tail = c.text:match('%s+$')
    if tail and #words > 0 then words[#words] = words[#words] .. tail end
    for _, w in ipairs(words) do
      local bare = w:gsub('^%s+', ''):gsub('%s+$', '')
      if cw > 0 and cw + piece_w(c, w:gsub('%s+$', '')) > maxw and not w:match('^%s*[:;!?]+%s*$') then push() end
      if piece_w(c, bare) > maxw then
        local part = ''
        for _, ch in ipairs(chars(bare)) do
          if part ~= '' and cw + piece_w(c, part .. ch) > maxw then
            add(c, part)
            push()
            part = ''
          end
          part = part .. ch
        end
        w = part .. (w:match('%s+$') or '')
      end
      add(c, w)
    end
  end
  push()
  return lines
end

local function line_defs(lines, align)
  local defs, ids = {}, {}
  for _, ln in ipairs(lines) do
    local nodes, last = {}, nil
    for _, p in ipairs(ln) do
      if last and last.src == p.c then
        last.node.config.text = last.node.config.text .. p.s
      else
        local cfg = {}
        for kk, v in pairs(p.c) do
          if not LIVE_KEYS[kk] then cfg[kk] = v end
        end
        cfg.text = p.s
        if cfg.id then
          if ids[cfg.id] then cfg.id = nil else ids[cfg.id] = true end
        end
        local node = {n = G.UIT.T, config = cfg}
        nodes[#nodes + 1] = node
        last = {src = p.c, node = node}
      end
    end
    if last then last.node.config.text = last.node.config.text:gsub('%s+$', '') end
    defs[#defs + 1] = {n = G.UIT.R, config = {align = align or 'cm', padding = 0}, nodes = nodes}
  end
  return defs
end

local function rewrap(row, lines)
  local defs = line_defs(lines, row.config and row.config.align)
  for _, k in ipairs(row.children) do k:remove() end
  for i = #row.children, 1, -1 do table.remove(row.children, i) end
  for _, d in ipairs(defs) do row.UIBox:set_parent_child(d, row) end
  row.portrait_wrapped = true
end

local function shave(n, excess, tw, d)
  if type(n) ~= 'table' or d > 60 or n.REMOVED then return false end
  local hit = false
  local c = n.config
  local cw = n.content_dimensions and n.content_dimensions.w
  if c and c.minw and cw and c.minw > cw + 0.01 and n.T and n.T.w > tw - 1 and not c.portrait_keep then
    if P._minw_rec then P._minw_rec[#P._minw_rec + 1] = {c, c.minw} end
    c.minw = math.max(cw, c.minw - excess)
    hit = true
  end
  for _, k in ipairs(n.children or {}) do
    if shave(k, excess, tw, d + 1) then hit = true end
  end
  local ob = c and c.object
  if n.UIT == G.UIT.O and type(ob) == 'table' and ob.UIRoot and ob.recalculate and not ob.REMOVED then
    if shave(ob.UIRoot, excess, tw, d + 1) then
      ob:recalculate()
      hit = true
    end
  end
  return hit
end

function P.read_target(o, outer)
  local zt = math.max(1, P.read_need(o))
  local t = outer and outer.T
  if t and t.w > 0 and t.h > 0 then zt = math.max(zt, land_zoom(t)) end
  return math.min(zt, P.READ_ZMAX)
end

function P.reflow(o)
  if not (P.on() and type(o) == 'table' and o.UIRoot and o.T and o.recalculate) or reflow_keep(o) then return end
  local body = uik_body(o)
  local outer = overlay_inner(o)
  local inner, tw = outer, P.reflow_width() / P.read_target(o, outer)
  if body then inner, tw = body.UIRoot, uik_w(o) + 0.05 end
  if not (inner and inner.T) then return end
  local moved = false
  local skip = {}
  local flipped = {}
  local function fit(w, h)
    local sw, sh = G.TILE_W + 2 * P.PAD_W, G.TILE_H + 3 * P.PAD_H
    return math.min(sw / math.max(0.1, w or outer.T.w), sh / math.max(0.1, h or outer.T.h))
  end
  local function recalc(box)
    if box and box ~= o then box:recalculate() end
    if body and box ~= body then body:recalculate() end
    o:recalculate()
  end
  local start = fit()
  for _ = 1, P.REFLOW_STEPS do
    if inner.T.w <= tw then break end
    local n, box = wide_node(inner, body or o, tw, 0, skip)
    if n and is_table(flip_kids(n)) then
      local list = flip_kids(n)
      local before = nat_w(n)
      local m
      for d = 2, #list - 1 do
        if #list % d == 0 then
          local w = 0
          for q = 1, d do w = w + nat_w(list[q]) end
          if not m or w <= tw then m = d end
        end
      end
      skip[n] = true
      if m then
        local ch = chunk_cols(n, list, m, box)
        recalc(box)
        if nat_w(n) >= before - 0.01 then
          unchunk(ch)
          recalc(box)
        else
          moved = true
          o.portrait_chunks = o.portrait_chunks or {}
          o.portrait_chunks[#o.portrait_chunks + 1] = ch
        end
      end
    elseif n then
      local before = nat_w(n)
      local list = flip_kids(n)
      for _, k in ipairs(list) do k.UIT = G.UIT.R end
      recalc(box)
      if nat_w(n) >= before - 0.01 then
        for _, k in ipairs(list) do k.UIT = G.UIT.C end
        recalc(box)
        skip[n] = true
      else
        moved = true
        flipped[#flipped + 1] = list
        o.portrait_flips = o.portrait_flips or {}
        o.portrait_flips[#o.portrait_flips + 1] = list
      end
    elseif shave(inner, inner.T.w - tw, tw, 0) then
      recalc(body)
      moved = true
    else
      local rows = {}
      text_rows(inner, body or o, 0, rows)
      local excess = inner.T.w - tw
      local plan, grow = {}, 0
      for _, r in ipairs(rows) do
        local rw = nat_w(r.n)
        local maxw = rw - excess - 0.02
        if rw > tw * 0.5 and maxw >= P.WRAP_MIN then
          local lines = wrap_lines(r.n, maxw)
          if #lines > 1 then
            plan[#plan + 1] = {r = r, lines = lines}
            grow = grow + (#lines - 1) * r.n.T.h
          end
        end
      end
      if #plan == 0 or fit(outer.T.w - excess, outer.T.h + grow) < fit() then break end
      local boxes = {}
      for _, p in ipairs(plan) do
        rewrap(p.r.n, p.lines)
        boxes[p.r.box] = true
      end
      for b in pairs(boxes) do recalc(b) end
      moved = true
    end
  end
  if moved and fit() < start - 0.001 and #flipped > 0 then
    for _, list in ipairs(flipped) do
      for _, k in ipairs(list) do k.UIT = G.UIT.C end
    end
    recalc(body)
    o.portrait_flips = nil
  end
  if moved and inner.T.w > tw then
    local root = body and body.UIRoot or inner
    if narrow(root, tw, 0) then recalc(body) end
  end
  if body and inner.T.w <= tw and P.fill_uik(o, body) then
    o:recalculate()
    moved = true
  end
  if moved then force_align(o) end
end

P.SPLIT_MIN = 6
P.SPLIT_ROW_H = 1.0
P.SPLIT_MAX = 4
P.SPLIT_SAME = 0.15

local function small_row(k)
  return type(k) == 'table' and k.UIT == G.UIT.R and k.T and k.T.h > 0 and k.T.h < P.SPLIT_ROW_H and not (k.config and (k.config.button or k.config.portrait_keep))
end

local function list_runs(n, box, d, out)
  if type(n) ~= 'table' or d > 60 or n.REMOVED or (n.states and n.states.visible == false) then return end
  local c = n.config or {}
  if c.portrait_keep or c.button then return end
  local kids = n.children or {}
  local i = 1
  while i <= #kids do
    if small_row(kids[i]) then
      local j = i
      local h0 = kids[i].T.h
      while j + 1 <= #kids and small_row(kids[j + 1]) and math.abs(kids[j + 1].T.h - h0) <= h0 * P.SPLIT_SAME do j = j + 1 end
      if j - i + 1 >= P.SPLIT_MIN then
        local h = 0
        for q = i, j do h = h + kids[q].T.h end
        out[#out + 1] = {n = n, box = box, i = i, j = j, h = h}
      end
      i = j + 1
    else
      i = i + 1
    end
  end
  for _, k in ipairs(kids) do list_runs(k, box, d + 1, out) end
  local ob = c.object
  if n.UIT == G.UIT.O and type(ob) == 'table' and ob.UIRoot and ob.recalculate and not ob.REMOVED then list_runs(ob.UIRoot, ob, d + 1, out) end
end

local function split_run(r, k)
  local n, rows = r.n, {}
  for q = r.i, r.j do rows[#rows + 1] = n.children[q] end
  for q = r.j, r.i, -1 do table.remove(n.children, q) end
  local pad = n.config and n.config.padding or 0
  r.box:set_parent_child({n = G.UIT.R, config = {align = 'tm', padding = math.max(pad, 0.1)}, nodes = {}}, n)
  local wrap = table.remove(n.children)
  table.insert(n.children, r.i, wrap)
  local per = math.ceil(#rows / k)
  for _ = 1, math.ceil(#rows / per) do
    r.box:set_parent_child({n = G.UIT.C, config = {align = n.config and n.config.align or 'tm', padding = pad}, nodes = {}}, wrap)
  end
  for q, row in ipairs(rows) do
    local col = wrap.children[math.ceil(q / per)]
    row.parent = col
    table.insert(col.children, row)
  end
  return {n = n, wrap = wrap, rows = rows, i = r.i, box = r.box}
end

local function unsplit(s)
  local n = s.n
  for q, x in ipairs(n.children) do
    if x == s.wrap then table.remove(n.children, q) break end
  end
  for q, row in ipairs(s.rows) do
    row.parent = n
    table.insert(n.children, s.i + q - 1, row)
  end
  for _, col in ipairs(s.wrap.children) do
    for i = #col.children, 1, -1 do col.children[i] = nil end
  end
  for _, col in ipairs(s.wrap.children) do col:remove() end
  for i = #s.wrap.children, 1, -1 do s.wrap.children[i] = nil end
  s.wrap:remove()
end

local function screen_fit(outer)
  local w, h = love.graphics.getDimensions()
  local b = P.base_px()
  return math.min(0.95 * w / b / math.max(0.1, outer.T.w), 0.92 * h / b / math.max(0.1, outer.T.h)), 0.95 * w / b / math.max(0.1, outer.T.w)
end

function P.balance(o, need)
  local outer = overlay_inner(o)
  if not (outer and outer.T) then return end
  local body = uik_body(o)
  local function recalc(box)
    if box and box ~= o then box:recalculate() end
    if body and box ~= body then body:recalculate() end
    o:recalculate()
  end
  local cap = math.max(1.4, math.min(need, P.READ_ZMAX))
  local done = false
  for _ = 1, 4 do
    local cur, fw = screen_fit(outer)
    if cur >= need or cur >= fw - 0.01 then break end
    local runs = {}
    list_runs(outer, o, 0, runs)
    table.sort(runs, function(a, b) return a.h > b.h end)
    local best
    for ri = 1, math.min(3, #runs) do
      local r = runs[ri]
      for k = 2, P.SPLIT_MAX do
        local s = split_run(r, k)
        recalc(r.box)
        local f = math.min(screen_fit(outer), cap)
        unsplit(s)
        recalc(r.box)
        if f > (best and best.f or math.min(cur, cap)) + 0.01 then best = {r = r, k = k, f = f} end
      end
      if best then break end
    end
    if not best then break end
    o.portrait_splits = o.portrait_splits or {}
    o.portrait_splits[#o.portrait_splits + 1] = split_run(best.r, best.k)
    recalc(best.r.box)
    done = true
  end
  if done then force_align(o) end
end

function P.undo_read(o)
  local hit = false
  local sp = o.portrait_splits
  o.portrait_splits = nil
  for i = #(sp or {}), 1, -1 do
    local s = sp[i]
    if not (s.n.REMOVED or s.wrap.REMOVED) then unsplit(s) hit = true end
  end
  local ch = o.portrait_chunks
  o.portrait_chunks = nil
  for i = #(ch or {}), 1, -1 do
    local c = ch[i]
    if not c.n.REMOVED then unchunk(c) hit = true end
  end
  local rec = o.portrait_minw
  o.portrait_minw = nil
  for i = #(rec or {}), 1, -1 do
    rec[i][1].minw = rec[i][2]
    hit = true
  end
  if o.portrait_flips or o.portrait_fill then
    P.unflow(o)
  elseif hit then
    local body = uik_body(o)
    if body then body:recalculate() end
    o:recalculate()
  end
end

local function tab_obj(o)
  if o.portrait_tabnode == nil then
    o.portrait_tabnode = o.get_UIE_by_ID and o:get_UIE_by_ID('tab_contents') or false
  end
  local n = o.portrait_tabnode
  return n and n.config and n.config.object or false
end

local function leaf_count(n, d)
  if type(n) ~= 'table' or d > 60 or n.REMOVED then return 0 end
  local c = (n.UIT == G.UIT.T or n.UIT == G.UIT.O) and 1 or 0
  for _, k in ipairs(n.children or {}) do c = c + leaf_count(k, d + 1) end
  local ob = n.config and n.config.object
  if n.UIT == G.UIT.O and type(ob) == 'table' and ob.UIRoot and not ob.REMOVED then c = c + leaf_count(ob.UIRoot, d + 1) end
  return c
end

local function read_key(o)
  local inner = overlay_inner(o)
  local w, h = love.graphics.getDimensions()
  return string.format('%s|%.3f|%.3f|%s|%s|%.2f|%d|%d|%d', tostring((uik_body(o))), inner and inner.T and inner.T.w or 0, inner and inner.T and inner.T.h or 0, tostring((tab_obj(o))), tostring(P.on()), P.base_px(), w, h, leaf_count(o.UIRoot, 0))
end

function P.read_check(o)
  if type(o) ~= 'table' or not o.T or o.REMOVED or not o.UIRoot then return 0 end
  if o.portrait_read and o.portrait_read_key == read_key(o) then return o.portrait_read end
  local ok, err = pcall(function()
    P.undo_read(o)
    P._minw_rec = {}
    if P.on() then P.reflow(o) end
    o.portrait_minw = P._minw_rec
    P._minw_rec = nil
    if not reflow_keep(o) then
      local need = P.read_need(o)
      if need > 0 and not uik_body(o) then P.balance(o, need) end
    end
  end)
  P._minw_rec = nil
  if not ok then print('[PORTRAIT] reflow failed: ' .. tostring(err)) end
  local ok2, z = pcall(P.read_need, o)
  o.portrait_read = ok2 and z or 0
  o.portrait_read_key = read_key(o)
  return o.portrait_read
end

function P.reflow_check()
  local o = G.OVERLAY_MENU
  if type(o) ~= 'table' then return end
  P.read_check(o)
end

function P.update(dt)
  P.hook_overlay()
  P.menu_veil()
  P.center_overlay()
  if not P.on() then return end
  P.reflow_check()
  if G.STAGE == G.STAGES.RUN and G.HUD and G.jokers and (G.HUD ~= P._hud or G.jokers ~= P._jokers) then
    P._hud, P._jokers = G.HUD, G.jokers
    P.layout_run()
  end
  local t = G.HUD_tags and G.HUD_tags[1]
  if t and not t.portrait_tag then P.place_tags() end
  local mb = G.MOD_FLOATING_BUTTON
  if mb and not mb.portrait_land then P.place_mods_button() end
r 3 4157 %20%20 -
l 19
    P.place_floats()
    P.settle_boxes()
    P.place_bot_panel()
    P.fill_all()
  end
  P.minigames()
  local bs = G.blind_select
  if bs and bs ~= P._bs and bs.alignment and G.STATE == G.STATES.BLIND_SELECT then
    P._bs = bs
    bs.alignment.offset.y = P.blind_select_offset(bs)
  end
end

function P.fill_all()
  if G.shop and not G.shop.portrait_filled then P.fill_shop(G.shop) end
  if G.HUD and not G.HUD.portrait_filled and G.HUD.definition and G.HUD.definition.config and G.HUD.definition.config.portrait_hud then P.fill_hud(G.HUD) end
  if G.buttons and not G.buttons.portrait_filled then P.fill_buttons(G.buttons) end
  if G.booster_pack and not G.booster_pack.portrait_filled and G.pack_cards and G.pack_cards.cards and #G.pack_cards.cards > 0 then P.fill_pack(G.booster_pack) end
end
end
