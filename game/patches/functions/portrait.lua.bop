P.SETTLED = {shop = -5.3, round_eval = -7.8, booster_pack = -2.2}

function P.box_target(name)
  local hh = G.hand.T.h
  local hand_top = G.TILE_H - hh
  if name == 'shop' then return P.stage_top() - hand_top end
  if name == 'round_eval' then return P.stage_top() - G.TILE_H end
  if name == 'booster_pack' then
    local ob = rawget(_G, 'SMODS') and SMODS.OPENED_BOOSTER
    local fan = G.STATE == G.STATES.TAROT_PACK or G.STATE == G.STATES.SPECTRAL_PACK or (G.hand.cards and #G.hand.cards > 0)
      or (ob and ob.config and ob.config.center and ob.config.center.draw_hand)
    if fan then return P.SETTLED.booster_pack end
    return ((P.stage_top() + hand_top) / 2 - 2.4) - hand_top
  end
end

function P.settle_boxes()
  if not (G.hand and G.hand.T) then return end
  for name, land in pairs(P.SETTLED) do
    local b = G[name]
    local ready = name ~= 'round_eval' or P.eval_box == b
    if ready and type(b) == 'table' and b.alignment and b.alignment.offset and not b.REMOVED then
      local o = b.alignment.offset
      if P.on() then
        local want = P.box_target(name)
        if math.abs(o.y - land) < 0.001 or (b.portrait_off and math.abs(o.y - b.portrait_off) < 0.001 and math.abs(want - b.portrait_off) > 0.001) then
          b.portrait_off = want
          o.y = want
        end
      elseif b.portrait_off then
        if math.abs(o.y - b.portrait_off) < 0.001 then o.y = land end
        b.portrait_off = nil
      end
      if o.py and b.portrait_off and math.abs(o.py - land) < 0.001 then o.py = b.portrait_off end
    end
  end
end

if G.FUNCS and G.FUNCS.evaluate_round then
  local raw_eval = G.FUNCS.evaluate_round
  G.FUNCS.evaluate_round = function(...)
    P.eval_box = G.round_eval
    P.watch_eval(G.round_eval)
    return raw_eval(...)
  end
end

local function squeeze(n, f, d)
  if type(n) ~= 'table' or d > 30 then return end
  local c = n.config
  if c then
    if c.minw and c.minw >= 1.8 then c.minw = c.minw * f end
    if c.maxw and c.maxw >= 1.8 then c.maxw = c.maxw * f end
  end
  for _, k in ipairs(n.nodes or {}) do squeeze(k, f, d + 1) end
end

