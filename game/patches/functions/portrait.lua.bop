PORTRAIT = PORTRAIT or {}
local P = PORTRAIT

P.W = 10.8
P.PAD_W = 0.4
P.PAD_H = 0.4
P.FILL_PAD_W = 0.1
P.FILL_M = 0.2
P.FILL_BLIND = 0.9235
P.BLIND_DROP = 0.5
P.HUD_Y = -0.2
P.EDGE = 0.2
P.GAP = 0.15
P.ROW_GAP = 0.45
P.BTN_H = 1.7
P.BTN_LIFT = 0.4
P.BTN_H_MAX = 2.3
P.HAND_LIFT = 1.6
P.BTN_BOTTOM = 0.45
P.HAND_DROP = 1.9
P.MIN_GAP = 0.6
P.HAND_NUDGE = -0.06
P.ZONE_H = 2.4
P.active = P.active or false

local land

function P.allowed()
  if P.force ~= nil then return P.force end
  return _G._IS_DESKTOP == false
end

function P.on()
  return P.active == true
end

P.ORIENTS = {'auto', 'portrait', 'landscape'}

function P.orientation()
  local i = G and G.SETTINGS and G.SETTINGS.orientation
  return P.ORIENTS[i or 1] or 'auto'
end

function P.apply_orientation()
  P.orient_sent = true
  if not P.allowed() then return false end
  local ok, r = pcall(love.system.openURL, "overhaul:orient?" .. P.orientation())
  P.orient_ok = ok and r == true
  if P.orient_ok and P.orient_lock == nil then
    local ok2, r2 = pcall(love.system.openURL, "overhaul:has?rotation_lock")
    P.orient_lock = ok2 and r2 == true
  end
  return P.orient_ok
end

function P.orient_old()
  if not (P.allowed() and P.orient_sent) then return false end
  return not P.orient_ok or (not P.orient_lock and P.orientation() == 'auto')
end

function P.want(w, h)
  return P.allowed() and h > w
end

function P.fill_on()
  local GR = G and G.SETTINGS and G.SETTINGS.GRAPHICS
  return GR and GR.portrait_fill == true or false
end

function P.filled()
  return P.on() and P.fill_on()
end

function P.pad_w()
  return P.fill_on() and P.FILL_PAD_W or P.PAD_W
end

function P.fit(w, h)
  if not (G and G.window_prev and G.TILESIZE) then return false end
  if not P.orient_sent and G.SETTINGS then P.apply_orientation() end
  local want = P.want(w, h)
  if not want and not P.active then return false end
  local old_h = G.TILE_H
  if want and not P.active then
    land = {w = G.TILE_W, h = G.TILE_H, pw = G.ROOM_PADDING_W, ph = G.ROOM_PADDING_H, prev = G.window_prev}
  end
  if want then
    G.ROOM_PADDING_W, G.ROOM_PADDING_H = P.pad_w(), P.PAD_H
    G.TILE_W = P.W
    local across = P.W + 2 * P.pad_w()
    G.TILE_H = math.max(20, across * h / w - 3 * P.PAD_H)
    local s = land.prev.orig_scale
    local pw, ph = across * G.TILESIZE * s, (G.TILE_H + 3 * P.PAD_H) * G.TILESIZE * s
    G.window_prev = {orig_scale = s, w = pw, h = ph, orig_ratio = pw / ph}
  else
    G.TILE_W, G.TILE_H = land.w, land.h
    G.ROOM_PADDING_W, G.ROOM_PADDING_H = land.pw, land.ph
    G.window_prev = land.prev
  end
  local changed = want ~= P.active
  P.active = want
  if changed and UIK and UIK.sync then UIK.sync() end
  P.dirty = P.dirty or changed or math.abs((old_h or 0) - G.TILE_H) > 0.01
  return changed
end

local function force_align(box)
  if box and box.alignment and box.align_to_major then
    box.alignment.prev_type = nil
    box:align_to_major()
  end
end

local function snap(box)
  if not (box and box.alignment and box.role) then return end
  force_align(box)
  if box.role.major and box.move_with_major then box:move_with_major(0) end
  box:hard_set_VT()
  if box.recalculate then box:recalculate() end
  box:hard_set_VT()
end

local function setw(a, w)
  if not (a and a.T) then return end
  a.portrait_land_w = a.portrait_land_w or a.T.w
  a.T.w = w
end

local function restorew(a)
  if a and a.T and a.portrait_land_w then
    a.T.w = a.portrait_land_w
    a.portrait_land_w = nil
  end
end

function P.band_bottom()
  if not (G.HUD and G.HUD.T and G.HUD.alignment and G.HUD.alignment.offset) then return 6.4 end
  return P.HUD_Y + G.HUD.T.h
end

function P.shelf_bottom()
  local b = P.band_bottom() + 0.3 + 2 * (G.CARD_H or 2.6) + P.ROW_GAP
  if G.consumeables and G.consumeables.T then b = math.max(b, G.consumeables.T.y + G.consumeables.T.h) end
  if G.deck and G.deck.T then b = math.max(b, G.deck.T.y + G.deck.T.h) end
  return b
end

function P.stage_top()
  return P.shelf_bottom() + 0.45
end

function P.screen_bottom()
  local u = G.ROOM_UNZOOMED
  if not (u and love and love.graphics and G.TILESIZE and G.TILESCALE) then
    local top, sh = P.screen_span()
    return top + sh
  end
  return love.graphics.getHeight() / (G.TILESIZE * G.TILESCALE) * (G.MENU_ZOOM or 1) - u.y
end

function P.btn_h()
  if not (G.hand and G.hand.T and G.play and G.play.T) then return P.BTN_H end
  local free = P.screen_bottom() - P.BTN_BOTTOM - P.shelf_bottom() - G.hand.T.h
  return math.max(P.BTN_H, math.min(P.BTN_H_MAX, free - 2 * P.MIN_GAP - 0.3))
end

function P.btn_box_h()
  local b = G.buttons
  if b and not b.REMOVED and b.T and b.T.h > 0.5 then P.last_btn_box_h = b.T.h end
  return P.last_btn_box_h or (P.btn_h() + 0.2)
end

function P.btn_top()
  return P.screen_bottom() - P.BTN_BOTTOM - P.btn_box_h()
end

function P.hand_top()
  return (P.shelf_bottom() + P.btn_top() - G.hand.T.h) / 2 + P.HAND_NUDGE
end

function P.play_y()
  return (P.stage_top() + 0.3 + P.hand_top() + P.HAND_DROP) / 2 - G.play.T.h / 2
end

function P.wait_drop()
  local wo = G.BOM_PVP_WAITING_OVERLAY
  if not (wo and not wo.REMOVED and wo.T and P.wait_top and G.hand and G.hand.T) then return 0 end
  local need = P.wait_top + wo.T.h + 1 - P.hand_top()
  local room = P.btn_top() - (P.hand_top() + G.hand.T.h) - 0.15
  return math.max(0, math.min(need, room))
end

function P.place_buttons(hand)
  local py = G.play and G.play.T and P.play_y()
  if py and math.abs(G.play.T.y - py) > 0.01 then G.play.T.y = py end
  local b = G.buttons
  if not (b and not b.REMOVED and b.alignment and b.alignment.offset and b.role and b.role.major == hand) then return end
  local want = P.btn_top() - (P.hand_top() + P.wait_drop() + hand.T.h)
  if math.abs(b.alignment.offset.y - want) > 0.001 then b.alignment.offset.y = want end
end

function P.blind_select_offset(box)
  local rest = G.TILE_H - G.hand.T.h
  return P.stage_top() + P.BLIND_DROP - (rest + G.hand.T.h - box.T.h)
end

local function def_find(n, pred)
  if type(n) ~= 'table' then return nil end
  if pred(n) then return n end
  for _, c in ipairs(n.nodes or {}) do
    local r = def_find(c, pred)
    if r then return r end
  end
end

function P.hud_def(t)
  local col = def_find(t, function(n) return n.config and n.config.minh == 30 end)
  if not (col and col.nodes and #col.nodes >= 5) then return t end
  local function id_of(n) return n and n.config and n.config.id end
  local blind, chips, hand, round
  for _, n in ipairs(col.nodes) do
    local id = id_of(n)
    if id == 'row_blind' then blind = n
    elseif id == 'row_dollars_chips' then chips = n
    elseif id == 'hand_text_area' then hand = n
    elseif id == 'row_round' then round = n end
  end
  if not (blind and chips and hand and round) then return t end
  col.config.minh = nil
  col.config.padding = 0.06
  t.config = t.config or {}
  t.config.portrait_hud = true
  col.nodes = {
    {n = G.UIT.C, config = {align = 'tm', padding = 0.05}, nodes = {blind, chips}},
    {n = G.UIT.C, config = {align = 'tm', padding = 0.05}, nodes = {hand, round}},
  }
  return t
end

local function scale_text(n, sc)
  if type(n) ~= 'table' then return end
  if n.n == G.UIT.T and n.config then n.config.scale = sc end
  for _, c in ipairs(n.nodes or {}) do scale_text(c, sc) end
end

local function sort_walk(n, k)
  if type(n) ~= 'table' then return end
  local c = n.config or {}
  if c.button == 'sort_hand_value' or c.button == 'sort_hand_suit' then
    c.minh, c.minw = 0.95 + 0.45 * k, 1.3 + 0.25 * k
    scale_text(n, 0.4 + 0.08 * k)
    return
  end
  if n.n == G.UIT.T then c.scale = 0.42 + 0.08 * k end
  for _, x in ipairs(n.nodes or {}) do sort_walk(x, k) end
end

function P.buttons_def(t)
  local bh = P.btn_h()
  local k = (bh - P.BTN_H) / (P.BTN_H_MAX - P.BTN_H)
  for _, n in ipairs(t.nodes or {}) do
    local c = n.config or {}
    if c.id == 'play_button' or c.id == 'discard_button' then
      c.minh, c.align = bh, 'cm'
      c.minw = 2.5 + 0.3 * k
      for _, x in ipairs(n.nodes or {}) do if x.config then x.config.align = 'cm' end end
      scale_text(n, 0.55 + 0.1 * k)
    else
      sort_walk(n, k)
    end
  end
end

local raw_btns = create_UIBox_buttons
if raw_btns then
  function create_UIBox_buttons(...)
    local t = raw_btns(...)
    if P.on() and type(t) == 'table' then pcall(P.buttons_def, t) end
    return t
  end
end

function P.rebuild_buttons()
  local old = G.buttons
  if not (old and not old.REMOVED and old.UIRoot and G.hand and create_UIBox_buttons) then return end
  local shown = old.states and old.states.visible
  local ok, box = pcall(function() return UIBox{definition = create_UIBox_buttons(), config = {align = 'bm', offset = {x = 0, y = 0.3}, major = G.hand, bond = 'Weak'}} end)
  if not ok then print('[PORTRAIT] buttons rebuild failed: ' .. tostring(box)) return end
  old:remove()
  G.buttons = box
  if shown == false then box.states.visible = false end
end

local raw_hud = create_UIBox_HUD
if raw_hud then
  function create_UIBox_HUD(...)
    local t = raw_hud(...)
    if P.on() and type(t) == 'table' then
      local ok, err = pcall(P.hud_def, t)
      if not ok then print('[PORTRAIT] hud layout failed: ' .. tostring(err)) end
    end
    return t
  end
end

local function hud_config()
  if P.on() then return {align = 'tmi', offset = {x = 0, y = P.HUD_Y}, major = G.ROOM_ATTACH} end
  return {align = 'cli', offset = {x = -0.7 - (HUD_SCALE and HUD_SCALE.shift() or 0), y = 0}, major = G.ROOM_ATTACH}
end

function P.rebuild_hud()
  local old = G.HUD
  if not (old and old.UIRoot and create_UIBox_HUD and G.ROOM_ATTACH) then return end
  local bm = rawget(_G, 'bom_match')
  local was_mp = bm and bm._starting_mp_run
  if bm and old:get_UIE_by_ID('mp_lobby_info_btn') then bm._starting_mp_run = true end
  local ok, box = pcall(function() return UIBox{definition = create_UIBox_HUD(), config = hud_config()} end)
  if bm then bm._starting_mp_run = was_mp end
  if not ok then
    print('[PORTRAIT] hud rebuild failed: ' .. tostring(box))
    return
  end
  local list = G.I and G.I.UIBOX or {}
  local old_i
  for i, v in ipairs(list) do if v == old then old_i = i break end end
  old:remove()
  G.HUD = box
  if old_i then
    for i = #list, 1, -1 do if list[i] == box then table.remove(list, i) break end end
    table.insert(list, math.min(old_i, #list + 1), box)
  end
  local row = box:get_UIE_by_ID('row_blind')
  for _, b in ipairs({G.HUD_blind, G.SHOP_SIGN, G.blind_prompt_box}) do
    if type(b) == 'table' and b.role and not b.REMOVED and row then
      b.role.major = row
      force_align(b)
    end
  end
  local ta = G.hand_text_area
  if type(ta) == 'table' then
    for k, id in pairs({chips = 'hand_chips', mult = 'hand_mult', ante = 'ante_UI_count', round = 'round_UI_count', chip_total = 'hand_chip_total', handname = 'hand_name', hand_level = 'hand_level', game_chips = 'chip_UI_count', blind_spacer = 'blind_spacer'}) do
      ta[k] = box:get_UIE_by_ID(id)
    end
  end
end

function P.layout_hud()
  local hud = G.HUD
  if not (hud and hud.UIRoot) then return end
  local is_p = hud.definition and hud.definition.config and hud.definition.config.portrait_hud or false
  if is_p ~= P.on() then
    P.rebuild_hud()
    hud = G.HUD
  else
    local cfg = hud_config()
    hud:set_alignment({type = cfg.align, offset = cfg.offset})
  end
  snap(hud)
end

function P.place_run()
  local W, H, E = G.TILE_W, G.TILE_H, P.EDGE
  setw(G.jokers, W - 2 * E)
  G.jokers.T.x = E
  G.jokers.T.y = P.band_bottom() + 0.3
  G.consumeables.T.x = E
  G.consumeables.T.y = G.jokers.T.y + G.jokers.T.h + P.ROW_GAP
  G.deck.T.x = W - G.deck.T.w - E
  G.deck.T.y = G.consumeables.T.y
  setw(G.hand, W - 2 * E)
  G.hand.T.x = E
  G.hand.T.y = H - G.hand.T.h - P.BTN_LIFT
  setw(G.play, math.min(G.play.portrait_land_w or G.play.T.w, W - 2 * E))
  G.play.T.x = (W - G.play.T.w) / 2
  G.play.T.y = P.play_y()
  G.discard.T.x = W + 4
  G.discard.T.y = H / 2
  for _, a in ipairs({G.hand, G.play, G.jokers, G.consumeables, G.deck, G.discard}) do a:hard_set_VT() end
end

