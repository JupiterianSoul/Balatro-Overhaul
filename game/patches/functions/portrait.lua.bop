  local W, E = G.TILE_W, P.EDGE
  local fw = W - 2 * E
  local j, c, d = G.jokers.T, G.consumeables.T, G.deck.T
  local top = P.shelf_bottom() + 0.15
  local function above(a)
    local b = (a and a.T and a.T.y or P.stage_top() + 3) - 0.2
    local y = math.max(top, b - P.ZONE_H)
    return y, math.max(1, b - y)
  end
r 13 2158 %20%20 -
l 10
  local ay, ah = above(area)
  if D.S_buy and D.S_buy_and_use then
    local both = G.FUNCS.card_can_buy_and_use and G.FUNCS.card_can_buy_and_use(card)
    local bw = both and (fw - 0.15) * 0.6 or fw
