local raw_dtc = create_drag_target_from_card
if raw_dtc then
  function create_drag_target_from_card(card, ...)
    pcall(P.drag_targets, card)
    return raw_dtc(card, ...)
  end
end

P.LOGO_FILL = 0.78
P.MENU_FILL = 0.88

local function grow(n, fw, fh, ft, d)
  if type(n) ~= 'table' or (d or 0) > 12 then return end
  local c = n.config
  if c then
    if c.minw then c.minw = c.minw * fw end
    if c.maxw then c.maxw = c.maxw * fw end
    if c.minh then c.minh = c.minh * fh end
    if n.n == G.UIT.T and c.scale then c.scale = c.scale * ft end
  end
  for _, k in ipairs(n.nodes or {}) do grow(k, fw, fh, ft, (d or 0) + 1) end
end

local function node_w(n)
  local w = 0
  local function walk(x, d)
    if type(x) ~= 'table' or d > 12 then return end
    if x.config and x.config.minw then w = math.max(w, x.config.minw) end
    for _, k in ipairs(x.nodes or {}) do walk(k, d + 1) end
  end
  walk(n, 0)
  return w
end

function P.menu_width()
  local logo = G.SPLASH_LOGO and G.SPLASH_LOGO.T and G.SPLASH_LOGO.T.w or 14.3
  local across = (G.TILE_W or P.W) + 2 * P.PAD_W
  return math.max(across, logo / P.LOGO_FILL) * P.MENU_FILL
end

P.SIDE_H = 2.7
P.SIDE_T = 2.2
P.BELL_GROW = 1.7

function P.bell_def(t)
  local function find(n, parent)
    if type(n) ~= 'table' then return end
    if n.config and n.config.id == 'mpm_bell' then return n, parent end
    for _, c in pairs(n.nodes or {}) do
      local a, b = find(c, n)
      if a then return a, b end
    end
  end
  local bell, row = find(t)
  if not bell then return end
  if row and row.config then row.config.minw = 0.1 end
  grow(bell, P.BELL_GROW, P.BELL_GROW, P.BELL_GROW)
  if bell.config.r then bell.config.r = bell.config.r * P.BELL_GROW end
end

function P.stack_menu(t)
  local bar
  local function find(n)
    if bar or type(n) ~= 'table' then return end
    if n.config and n.config.mid and n.n == G.UIT.R and n.nodes and #n.nodes >= 3 then bar = n return end
    for _, c in pairs(n.nodes or {}) do find(c) end
  end
  find(t)
  if not bar then return end
  local kids = {}
  for i = 1, table.maxn(bar.nodes) do if bar.nodes[i] then kids[#kids + 1] = bar.nodes[i] end end
  if #kids < 3 then return end
  local left, right = kids[1], kids[#kids]
  local big = {}
  for i = 2, #kids - 1 do big[#big + 1] = kids[i] end
  local pad = bar.config.padding or 0.2
  local half = (P.menu_width() - 3 * pad) / 2
  local bw = math.max(0.1, node_w(big[2] or big[1]))
  local sw = math.max(0.1, math.max(node_w(left), node_w(right)))
  for i, b in ipairs(big) do
    local fw = half / bw
    if i == 1 and #big > 1 then fw = (2 * half + pad) / bw end
    grow(b, fw, 1.5, 1.4)
  end
  grow(left, half / sw, P.SIDE_H, P.SIDE_T)
  grow(right, half / sw, P.SIDE_H, P.SIDE_T)
  local function find(n, ok)
    if type(n) ~= 'table' then return end
    if n.config and ok(n.config) then return n end
    for _, c in pairs(n.nodes or {}) do
      local f = find(c, ok)
      if f then return f end
    end
  end
  local side_btn = find(left, function(c) return c.button and c.minh end)
  local side_h = side_btn and side_btn.config.minh
  for _, id in ipairs({'skip_tutorial_button', 'overhaul_update_button'}) do
    local b = find(t, function(c) return c.id == id end)
    if b and b.config.minh and side_h then grow(b, half / math.max(0.1, node_w(b)), side_h / b.config.minh, P.SIDE_T) end
  end
  pcall(P.bell_def, t)
  local rows = {}
  local function row(nodes) rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cm', padding = pad / 2}, nodes = nodes} end
  if #big > 0 then row({big[1]}) end
  local rest = {}
  for i = 2, #big do rest[#rest + 1] = big[i] end
  if #rest > 0 then row(rest) end
  row({left, right})
  bar.nodes = {{n = G.UIT.C, config = {align = 'cm'}, nodes = rows}}
end

P.KB_FILL = 0.94
P.KB_GAP = 0.07

local function screen_units()
  local u = G.TILESIZE * G.TILESCALE
  return love.graphics.getWidth() / u, love.graphics.getHeight() / u
end

function P.keyboard_on()
  return P.on() or (UIK and UIK.touch and UIK.touch()) or false
end

local function kb_actions(args)
  local acts = {}
  if args.back_key ~= false then acts[#acts + 1] = {'back', 'b'} end
  if args.wide then acts[#acts + 1] = {'accents'} end
  if args.wide then acts[#acts + 1] = {'symbols'} end
  if args.wide and args.lower_ok then acts[#acts + 1] = {'shift'} end
  if args.backspace_key then acts[#acts + 1] = {'backspace', 'x'} end
  if args.return_key then acts[#acts + 1] = {'return', 'start'} end
  return acts
end

local function kb_preview(w, h, k)
  local a = P._kb_args
  local t = a and a.text
  if not (t and t.ref_table and t.ref_value) then return nil end
  return {n = G.UIT.R, config = {align = 'cm', minw = w, minh = h, r = 0.1, colour = a.hooked_colour or a.colour or G.C.BLUE, padding = 0.05}, nodes = {
    {n = G.UIT.T, config = {ref_table = t.ref_table, ref_value = t.ref_value, scale = math.min(0.6, 0.45 * k), colour = G.C.UI.TEXT_LIGHT, shadow = true}},
  }}
end

function P.keyboard_def(args, rows)
  local sw, sh = screen_units()
  local gap = P.KB_GAP
  local n = 1
  for _, r in ipairs(rows) do n = math.max(n, #r) end
  local acts = kb_actions(args)
  local port = P.on()
  local k, kw, kh
  if port then
    k = math.min(1.9, (sw * P.KB_FILL - 0.6 - (n + 1) * gap) / (n * 0.8))
    kw, kh = 0.8 * k, math.max(0.95 * k, 1.1)
  else
    local nr = #rows
    local kW = (sw * P.KB_FILL - 0.6 - (n + 2) * gap) / (0.8 * n + 2.6)
    local kH = (sh * 0.7 - 0.6 - 0.8 - (nr - 1) * gap) / (0.8 * nr)
    k = math.min(1.9, kW, kH)
    kw, kh = 0.8 * k, 0.8 * k
  end
  local row_w = n * kw + (n - 1) * gap
  local key_scale = 0.5 * k
  local lines = {}
  for _, r in ipairs(rows) do
    local keys = {}
    for _, c in ipairs(r) do
      local w = c == ' ' and math.min(row_w, 6 * kw) or kw
      keys[#keys + 1] = create_keyboard_button(c, c == ' ' and 'y' or nil, {w = w, h = kh, scale = key_scale})
    end
    lines[#lines + 1] = {n = G.UIT.R, config = {align = 'cm', padding = gap / 2, colour = G.C.CLEAR}, nodes = keys}
  end
  local body
  if port then
    local aw = (row_w - (#acts - 1) * gap) / math.max(#acts, 1)
    local act_nodes = {}
    for _, a in ipairs(acts) do
      act_nodes[#act_nodes + 1] = create_keyboard_button(a[1], a[2], {w = aw, h = kh, scale = math.min(key_scale, 0.45 * k)})
    end
    lines[#lines + 1] = {n = G.UIT.R, config = {align = 'cm', minh = 0.08}, nodes = {}}
    lines[#lines + 1] = {n = G.UIT.R, config = {align = 'cm', padding = gap / 2, colour = G.C.CLEAR}, nodes = act_nodes}
    body = lines
  else
    local rows_h = #rows * (kh + gap)
    local ah = (rows_h - #acts * gap) / math.max(#acts, 1)
    local aw = 3.2 * kw
    local col = {}
    for _, a in ipairs(acts) do
      col[#col + 1] = {n = G.UIT.R, config = {align = 'cm', padding = gap / 2}, nodes = {create_keyboard_button(a[1], a[2], {w = aw, h = ah, scale = math.min(key_scale, 0.42 * k)})}}
    end
    local full_w = row_w + aw + 3 * gap
    body = {}
    local pv = kb_preview(full_w, 0.7, k)
    if pv then
      body[#body + 1] = pv
      body[#body + 1] = {n = G.UIT.R, config = {align = 'cm', minh = 0.1}, nodes = {}}
    end
    body[#body + 1] = {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {
        {n = G.UIT.C, config = {align = 'cm', padding = 0}, nodes = lines},
        {n = G.UIT.C, config = {align = 'cm', minw = gap}, nodes = {}},
        {n = G.UIT.C, config = {align = 'cm', padding = 0}, nodes = col},
      }}
  end
  return {n = G.UIT.ROOT, config = {align = 'cm', padding = 15, r = 0.1, colour = {G.C.GREY[1], G.C.GREY[2], G.C.GREY[3], 0.7}}, nodes = {
    {n = G.UIT.C, config = {align = 'cm', padding = 0.12, colour = G.C.BLACK, emboss = 0.05, r = 0.1, mid = true}, nodes = body},
  }}
end

function P.place_keyboard(kb, field)
  if not (kb and kb.T and field and field.T and G.ROOM and G.ROOM_ATTACH) then return end
  local pad = 15
  local iw, ih = kb.T.w - 2 * pad, kb.T.h - 2 * pad
  local sw, sh = screen_units()
  local left, top = -G.ROOM.T.x, -G.ROOM.T.y
  local m = 0.3
  local y = field.T.y + field.T.h + 0.35
  if not P.on() then y = top + sh - m - ih end
  if y + ih > top + sh - m then y = top + sh - m - ih end
  if y < field.T.y + field.T.h + 0.1 and y + ih > field.T.y - 0.1 then
    local above = field.T.y - 0.35 - ih
    if above >= top + m then y = above end
  end
  if y < top + m then y = top + m end
  local ra = G.ROOM_ATTACH.T
  local cx, cy = left + sw / 2, y + ih / 2
  kb:set_alignment({major = G.ROOM_ATTACH, type = 'cm', offset = {x = cx - (ra.x + ra.w / 2), y = cy - (ra.y + ra.h / 2)}})
  kb:align_to_major()
  kb:hard_set_T(kb.T.x, kb.T.y, kb.T.w, kb.T.h)
  kb:hard_set_VT()
end

