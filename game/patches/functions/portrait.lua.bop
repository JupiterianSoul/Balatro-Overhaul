function P.restore_run()
  for _, a in ipairs({G.hand, G.play, G.jokers, G.consumeables, G.deck, G.discard}) do restorew(a) end
end

local function drop_labels()
  for _, a in ipairs({G.hand, G.play, G.jokers, G.consumeables, G.deck, G.discard}) do
    local b = a.children and a.children.area_uibox
    if b then
      b:remove()
      a.children.area_uibox = nil
    end
  end
end

function P.screen_span()
  local sh = G.TILE_H
  if love and love.graphics and G.TILESIZE and G.TILESCALE then sh = love.graphics.getHeight() / (G.TILESIZE * G.TILESCALE) end
  return -((G.ROOM and G.ROOM.T and G.ROOM.T.y) or 0), sh
end

