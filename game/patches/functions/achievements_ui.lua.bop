local PAGE_SIZE = 8
local MAX_ITERATIONS = 1000

local function ach_rows()
    return (rawget(_G, 'PORTRAIT') and PORTRAIT.on()) and 4 or 2
end

local RARITY_COLORS = {
    Common = {0.65, 0.65, 0.65, 1},
    Rare = {0.3, 0.5, 0.9, 1},
    Epic = {0.6, 0.3, 0.8, 1},
    Legendary = {1, 0.75, 0.2, 1},
    Secret = {0.8, 0.2, 0.2, 1}
}


local function safe_get_color(rarity)
    if not rarity then return RARITY_COLORS.Common end
    return RARITY_COLORS[rarity] or RARITY_COLORS.Common
end

local function safe_get_ach_display(ach, unlocked)
    if not ach then return mod_loc("???"), mod_loc("Unknown achievement") end
    
    local name = mod_loc(ach.name or "???")
    local desc = mod_loc(ach.description or "")
    
    if ach.is_secret and not unlocked then
        name = mod_loc("???")
        desc = mod_loc(ach.secret_hint or "This achievement is a secret...")
    end
    
    return name, desc
end

