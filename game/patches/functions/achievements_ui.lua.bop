mod_loc_register(TR)

local AU = {}
Overhaul = Overhaul or {}
Overhaul.achievements_ui = AU

AU.TABS = {
    {key = "Runs", label = "Runs"},
    {key = "Decks & Stakes", label = "Decks"},
    {key = "Hands", label = "Hands"},
    {key = "Jokers & Cards", label = "Jokers"},
    {key = "Overhaul", label = "Overhaul"},
    {key = "Multiplayer", label = "Multiplayer"},
    {key = "Secret", label = "Secret"},
}

AU.CHIP = {Common = 1, Uncommon = 3, Rare = 5, Epic = 6, Legendary = 8, Secret = 4}
AU.HOURS = {hours_played_10 = true, hours_played_50 = true, hours_played_100 = true}

local function L(s)
    local lang = G and G.SETTINGS and G.SETTINGS.language
    if lang == "es_ES" or lang == "es_419" then lang = "es" end
    local t = TR[lang]
    if t and t[s] then return t[s] end
    return mod_loc and mod_loc(s) or s
end
AU.L = L
local function touch() return UIK.touch() end

local function fmt(v)
    v = tonumber(v) or 0
    return number_format and number_format(v) or tostring(math.floor(v))
end

local function txt(s, scale, colour, maxw)
    return {n = G.UIT.T, config = {text = tostring(s or ""), scale = scale, colour = colour or G.C.UI.TEXT_LIGHT, shadow = true, maxw = maxw}}
end

local function row(nodes, o)
    o = o or {}
    return {n = G.UIT.R, config = {align = o.align or "cl", minh = o.h, padding = 0}, nodes = nodes}
end

function AU.player(id)
    local pd = AchievementManager and AchievementManager.player_data and AchievementManager.player_data.achievements
    return pd and pd[id] or {}
end

function AU.list(cat)
    local out = {}
    local live = AchievementManager and AchievementManager.achievements or {}
    for _, a in ipairs(ACHIEVEMENT_DEFINITIONS or {}) do
        if live[a.id] and (cat == nil or a.category == cat) then out[#out + 1] = a end
    end
    table.sort(out, function(x, y) return (x.order or 999) < (y.order or 999) end)
    return out
end

function AU.count(list)
    local n = 0
    for _, a in ipairs(list) do if AU.player(a.id).unlocked then n = n + 1 end end
    return n, #list
end

function AU.progress_text(a, p)
    local goal = tonumber(a.progress_required) or 1
    local cur = math.min(tonumber(p.progress) or 0, goal)
    if AU.HOURS[a.id] then return string.format(L("%d / %d h"), math.floor(cur / 3600), math.floor(goal / 3600)) end
    return fmt(cur) .. " / " .. fmt(goal)
end

function AU.fraction(a, p)
    local goal = tonumber(a.progress_required) or 1
    if goal <= 0 then return 0 end
    return math.max(0, math.min(1, (tonumber(p.progress) or 0) / goal))
end

local function chip(a, size)
    local ok, s = pcall(get_stake_sprite, AU.CHIP[a.rarity] or 1, size)
    if ok and s then return {n = G.UIT.O, config = {object = s}} end
    return {n = G.UIT.B, config = {w = size, h = size}}
end

local function bar(frac, w)
    local h = touch() and 0.14 or 0.12
    local fill = {}
    if frac > 0 then fill[1] = {n = G.UIT.C, config = {minw = math.max(0.05, w * frac), minh = h, r = 0.04, colour = G.C.GREEN}, nodes = {}} end
    return {n = G.UIT.C, config = {align = "cl", minw = w, maxw = w, minh = h, r = 0.04, colour = G.C.UI.BACKGROUND_INACTIVE}, nodes = fill}
end

local function wrap2(str, scale, w)
    local lines, cur = {}, ""
    for word in tostring(str or ""):gmatch("%S+") do
        local try = cur == "" and word or (cur .. " " .. word)
        if cur ~= "" and #lines == 0 and UIK.text_w(try, scale) > w then
            lines[1] = cur
            cur = word
        else
            cur = try
        end
    end
    lines[#lines + 1] = cur
    return lines
end

function AU.sizes()
    local t = touch()
    return {name = t and 0.46 or 0.4, desc = t and 0.4 or 0.34, third = t and 0.4 or 0.34, chip = t and 0.56 or 0.46}
end

function AU.card(a, w, h)
    local p = AU.player(a.id)
    local un = p.unlocked and true or false
    local secret = a.is_secret and not un
    local S = AU.sizes()
    local cs = S.chip
    local tw = w - cs - 0.4
    local name = secret and L("???") or L(a.name or a.id)
    local desc = secret and L(a.secret_hint or "This achievement is a secret...") or L(a.description or "")
    local dcol = un and G.C.UI.TEXT_LIGHT or UIK.C.muted
    local _, _, h2 = AU.card_size()
    local roomy = h >= h2 - 0.01
    local tight = not roomy and UIK.text_w(desc, S.desc) > tw * 1.08
    local goal = tonumber(a.progress_required) or 1
    local third, thw
    if un then
        local when = tonumber(p.unlock_date)
        local s = when and when > 0 and string.format(L("Unlocked %s"), os.date("%d/%m/%Y", when)) or L("Unlocked")
        thw = UIK.text_w(s, S.third)
        third = {txt(s, S.third, G.C.GREEN, tw)}
    elseif goal > 1 and not secret then
        local bw = tight and math.min(1.4, tw * 0.25) or math.min(2.4, tw * 0.5)
        local s = AU.progress_text(a, p)
        thw = bw + 0.15 + UIK.text_w(s, S.third)
        third = {bar(AU.fraction(a, p), bw), {n = G.UIT.C, config = {minw = 0.15}, nodes = {}}, txt(s, S.third, UIK.C.muted, tw - bw - 0.2)}
    else
        local s = secret and L("Secret") or L("Locked")
        thw = UIK.text_w(s, S.third)
        third = {txt(s, S.third, UIK.C.muted, tw)}
    end
    local ncol = un and G.C.GOLD or G.C.WHITE
    local lines
    if tight then
        local nw = math.max(1, tw - thw - 0.2)
        lines = {row({
            {n = G.UIT.C, config = {align = "cl", minw = nw, padding = 0}, nodes = {txt(name, S.name, ncol, nw)}},
            {n = G.UIT.C, config = {align = "cr", minw = tw - nw, padding = 0}, nodes = {{n = G.UIT.R, config = {align = "cr", padding = 0}, nodes = third}}},
        }, {h = S.name + 0.04})}
    else
        lines = {row({txt(name, S.name, ncol, tw)}, {h = S.name + 0.04})}
    end
    local dl = (roomy or tight) and wrap2(desc, S.desc, tw) or {desc}
    for _, l in ipairs(dl) do lines[#lines + 1] = row({txt(l, S.desc, dcol, tw)}, {h = S.desc + 0.02}) end
    if not tight then lines[#lines + 1] = row(third, {h = S.third + 0.02}) end
    return {n = G.UIT.C, config = {align = "cm", minw = w, maxw = w, minh = h, r = 0.12, colour = G.C.BLACK, emboss = 0.05, padding = 0.06,
        outline = un and 1 or nil, outline_colour = un and G.C.GOLD or nil}, nodes = {
        {n = G.UIT.C, config = {align = "cm", minw = cs + 0.12, padding = 0}, nodes = {chip(a, cs)}},
        {n = G.UIT.C, config = {align = "cl", minw = tw, maxw = tw, padding = 0}, nodes = lines},
    }}
end

function AU.cols()
    return UIK.portrait() and 1 or 2
end

function AU.card_size()
    local cols = AU.cols()
    local gap = 0.12
    local S = AU.sizes()
    local pager_h = (touch() and 0.82 or 0.66) + 0.12
    local avail = UIK.H - UIK.TOP - pager_h - 0.08
    local step = 0.08 + 0.05 * cols
    local h1, h2 = S.name + S.desc + S.third + 0.32, S.name + 2 * S.desc + S.third + 0.32
    local rows = math.max(1, math.floor(avail / (h1 + step)))
    return (UIK.W - 2 * UIK.PAD - gap * (cols + 1)) / cols, math.min(h2, avail / rows - step), h2
end

function AU.per_page()
    local _, h = AU.card_size()
    local pager_h = (touch() and 0.82 or 0.66) + 0.12
    local fit = math.max(1, math.floor((UIK.H - UIK.TOP - pager_h - 0.08) / (h + 0.08 + 0.05 * AU.cols()) + 0.001))
    return fit * AU.cols()
end

function AU.category_tab(cat)
    local list = AU.list(cat)
    local id = "ach_" .. cat
    local per = AU.per_page()
    local pages = math.max(1, math.ceil(#list / per))
    local page = math.max(1, math.min(UIK._pages[id] or 1, pages))
    UIK._pages[id] = page
    local w, h = AU.card_size()
    local items = {}
    for i = (page - 1) * per + 1, math.min(#list, page * per) do items[#items + 1] = AU.card(list[i], w, h) end
    local pager_h = (touch() and 0.82 or 0.66) + 0.12
    local got, total = AU.count(list)
    local ps = touch() and 0.42 or 0.38
    local pt = string.format(L("Page %d of %d"), page, pages)
    local full = string.format(L("%d of %d unlocked"), got, total) .. "   " .. pt
    local room = UIK.W - 2 * (touch() and 1.3 or 1.15) - 1
    if UIK.text_w(full, ps) + 0.4 <= room then pt = full end
    return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, padding = 0}, nodes = {
        {n = G.UIT.C, config = {align = "tm", padding = 0}, nodes = {
            {n = G.UIT.R, config = {align = "tm", minw = UIK.W, minh = UIK.H - UIK.TOP - pager_h, padding = 0}, nodes = {
                {n = G.UIT.C, config = {align = "tm", padding = 0}, nodes = {
                    {n = G.UIT.R, config = {minh = 0.08}, nodes = {}},
                    UIK.grid(items, AU.cols(), {w = UIK.W - 2 * UIK.PAD, padding = 0.04}),
                }},
            }},
            UIK.pager{prev = "uik_page", next = "uik_page", prev_ref = {id = id, d = -1, n = pages}, next_ref = {id = id, d = 1, n = pages},
                prev_disabled = pages < 2, next_disabled = pages < 2,
                text = pt, text_w = math.min(room, UIK.text_w(pt, ps) + 0.4), w = UIK.W},
        }},
    }}
end

function AU.overview()
    local SU = Overhaul.stats_ui
    local all = AU.list()
    local got, total = AU.count(all)
    local latest, latest_at, close, close_f = nil, 0, nil, -1
    local rar = {Legendary = {0, 0}, Epic = {0, 0}}
    for _, a in ipairs(all) do
        local p = AU.player(a.id)
        if rar[a.rarity] then
            rar[a.rarity][2] = rar[a.rarity][2] + 1
            if p.unlocked then rar[a.rarity][1] = rar[a.rarity][1] + 1 end
        end
        if p.unlocked then
            if (tonumber(p.unlock_date) or 0) >= latest_at then latest, latest_at = a, tonumber(p.unlock_date) or 0 end
        elseif not a.is_secret and (tonumber(a.progress_required) or 1) > 1 then
            local f = AU.fraction(a, p)
            if f > close_f then close, close_f = a, f end
        end
    end
    local pct = total > 0 and math.floor(got * 100 / total) or 0
    local tiles = {
        {L("Unlocked"), got .. " / " .. total, G.C.GOLD, string.format(L("%d%% complete"), pct)},
        {L("Latest unlock"), latest and L(latest.name) or "-", G.C.GREEN, latest and latest_at > 0 and os.date("%d/%m/%Y", latest_at) or nil},
        {L("Closest to unlock"), close and L(close.name) or "-", G.C.FILTER, close and AU.progress_text(close, AU.player(close.id)) or nil},
        {L("Legendary"), rar.Legendary[1] .. " / " .. rar.Legendary[2], G.C.GOLD},
    }
    for _, tab in ipairs(AU.TABS) do
        local g, n = AU.count(AU.list(tab.key))
        tiles[#tiles + 1] = {L(tab.key), g .. " / " .. n, g > 0 and G.C.WHITE or UIK.C.muted, n > 0 and string.format(L("%d%% complete"), math.floor(g * 100 / n)) or nil}
    end
    tiles[#tiles + 1] = {L("Epic"), rar.Epic[1] .. " / " .. rar.Epic[2], G.C.WHITE}
    if SU and SU.tiles then return SU.tiles(tiles) end
    return UIK.note(tiles[1][1] .. ": " .. tiles[1][2])
end

AU.back = "exit_overlay_menu"

function create_UIBox_achievements_main()
    if not G then return nil end
    if AchievementManager and AchievementManager.init then pcall(AchievementManager.init) end
    if AchievementManager and AchievementManager.check_all then pcall(AchievementManager.check_all) end
    local tabs = {{key = "overview", label = L("Overview"), build = AU.overview}}
    for _, tab in ipairs(AU.TABS) do
        local cat = tab.key
        tabs[#tabs + 1] = {key = cat, label = L(tab.label), build = function() return AU.category_tab(cat) end}
    end
    local t = UIK.window{
        id = "ach",
        title = L("ACHIEVEMENTS"),
        tabs = tabs,
        back_func = AU.back,
        snap_back = true,
    }
    t.config.portrait_rebuild = "achievements"
    return t
end


function create_achievement_detail_popup(achievement_id)
    if not G then return nil end
    if not achievement_id then return nil end
    if not AchievementManager then return nil end
    if not AchievementManager.achievements then return nil end
    
    local ach = AchievementManager.achievements[achievement_id]
    if not ach then return nil end
    
    local player_ach = nil
    if AchievementManager.player_data and AchievementManager.player_data.achievements then
        player_ach = AchievementManager.player_data.achievements[achievement_id]
    end
    
    local unlocked = player_ach and player_ach.unlocked or false
    local progress = player_ach and player_ach.progress or 0
    local display_name, display_desc = safe_get_ach_display(ach, unlocked)
    local rar_col = safe_get_color(ach.rarity)
    
    local detail_nodes = {
r 15 723 %20%20%20%20%20%20%20%20 -
l 2
            {n=G.UIT.T, config={text = display_name, scale = 0.5, colour = unlocked and G.C.GOLD or G.C.WHITE, shadow = true}}
        }},
r 15 71 %20%20%20%20%20%20%20%20 -
l 85
            {n=G.UIT.T, config={text = mod_loc(ach.rarity or "Common"), scale = 0.35, colour = rar_col}}
        }},
        {n=G.UIT.R, config={align = "cm", padding = 0.1, maxw = 4}, nodes={
            {n=G.UIT.T, config={text = display_desc, scale = 0.3, colour = G.C.UI.TEXT_LIGHT}}
        }}
    }
    
    if ach.is_tracked and not unlocked then
        local pct = math.min(1, progress / (ach.progress_required or 1))
        table.insert(detail_nodes, {n=G.UIT.R, config={align = "cm", padding = 0.1}, nodes={
            {n=G.UIT.C, config={align = "cl", minw = 3.5, minh = 0.15, r = 0.05, colour = G.C.BLACK, outline = 0.5, outline_colour = G.C.WHITE}, nodes={
                {n=G.UIT.C, config={align = "cl", minw = 3.5 * pct, minh = 0.12, r = 0.03, colour = G.C.BLUE}, nodes={}}
            }},
        }})
        table.insert(detail_nodes, {n=G.UIT.R, config={align = "cm"}, nodes={
            {n=G.UIT.T, config={text = progress.." / "..(ach.progress_required or 1), scale = 0.28, colour = G.C.UI.TEXT_LIGHT}}
        }})
    end
    
    if unlocked and player_ach and player_ach.unlock_date then
        local date_str = nil
        pcall(function()
            date_str = os.date("%b %d, %Y", player_ach.unlock_date)
        end)
        if date_str then
            table.insert(detail_nodes, {n=G.UIT.R, config={align = "cm", padding = 0.1}, nodes={
                {n=G.UIT.T, config={text = mod_loc("Unlocked: ")..date_str, scale = 0.25, colour = G.C.GREEN}}
            }})
        end
    end
    
    if unlocked and ach.reward_data and ach.reward_data.name then
        table.insert(detail_nodes, {n=G.UIT.R, config={align = "cm", padding = 0.08}, nodes={
            {n=G.UIT.T, config={text = mod_loc("Reward: ")..mod_loc(ach.reward_data.name), scale = 0.28, colour = G.C.GOLD}}
        }})
    end
    
    return {n=G.UIT.ROOT, config={align = "cm", r = 0.1, colour = G.C.BLACK, padding = 0.15, outline = 1, outline_colour = rar_col}, nodes=detail_nodes}
end


function create_rarity_legend()
    if not G then return nil end
    
    local rarities = {"Common", "Rare", "Epic", "Legendary", "Secret"}
    local legend_nodes = {}
    
    for _, rarity in ipairs(rarities) do
        local col = safe_get_color(rarity)
        table.insert(legend_nodes, {n=G.UIT.C, config={align = "cm", padding = 0.08}, nodes={
            {n=G.UIT.T, config={text = mod_loc(rarity), scale = 0.25, colour = col}}
        }})
    end
    
    return {n=G.UIT.R, config={align = "cm", padding = 0.1, colour = G.C.L_BLACK, r = 0.08}, nodes=legend_nodes}
end


local function add_achievements_button()
    if not G then return end
    if not G.FUNCS then return end
    
    local function open_from(back, tab)
        if G.SETTINGS then G.SETTINGS.paused = true end
        AU.back = back
        if tab and UIK and UIK._last_tab then UIK._last_tab.ach = tab end
        local ui_def = create_UIBox_achievements_main()
        if ui_def then
            G.FUNCS.overlay_menu({
                definition = ui_def
            })
        end
    end

    G.FUNCS.open_achievements = function(e) open_from("high_scores") end
    G.FUNCS.open_mp_achievements = function(e) open_from("mp_stats", "Multiplayer") end
end

local init_success = pcall(add_achievements_button)
if not init_success then
    print("[ACHIEVEMENTS UI] Failed to add button hook")
end

print("[ACHIEVEMENTS UI] Module loaded (vanilla-perfect)")
return create_UIBox_achievements_main
end
