-- ============================================
-- CROSS-PROFILE DATA SHARING
-- ============================================

-- Merges unlock/discover states from ALL profiles' meta.jkr into the current
-- item prototypes. After this, any item unlocked on ANY profile is unlocked everywhere.
function merge_all_profile_unlocks()
    if not G or not G.FILES then return end
    local current = G.SETTINGS and G.SETTINGS.profile or 1
    for p = 1, 3 do
        if p ~= current then
            local meta = G.FILES[p..'/meta.jkr']
            if meta and type(meta) == 'table' then
                local mu = meta.unlocked or {}
                local md = meta.discovered or {}
                local ma = meta.alerted or {}
                -- Merge into P_CENTERS
                if G.P_CENTERS then
