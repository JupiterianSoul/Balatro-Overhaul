l 165
                        if md[k] and not v.discovered then v.discovered = true end
                        if ma[k] and v.discovered then v.alerted = true end
                    end
                end
                if G.P_STAKES then
                    for k, v in pairs(G.P_STAKES) do
                        if mu[k] and not v.unlocked then v.unlocked = true; v.discovered = true end
                        if md[k] and not v.discovered then v.discovered = true end
                    end
                end
                if G.PROFILES and G.PROFILES[p] and G.PROFILES[p].deck_usage
                   and G.PROFILES[current] then
                    G.PROFILES[current].deck_usage = G.PROFILES[current].deck_usage or {}
                    for dk, dv in pairs(G.PROFILES[p].deck_usage) do
                        if not G.PROFILES[current].deck_usage[dk] then
                            G.PROFILES[current].deck_usage[dk] = dv
                        elseif dv.wins then
                            G.PROFILES[current].deck_usage[dk].wins = G.PROFILES[current].deck_usage[dk].wins or {}
                            for stake, val in pairs(dv.wins) do
                                if val and not G.PROFILES[current].deck_usage[dk].wins[stake] then
                                    G.PROFILES[current].deck_usage[dk].wins[stake] = val
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    pcall(function() G:save_progress() end)
end

function copy_progression_from_main(target_profile)
    if not G or not G.PROFILES then return end
    if target_profile == 1 then return end
    local source = G.PROFILES[1]
    local target = G.PROFILES[target_profile]
    if not source or not target then return end
    if target.progression and target.progression.xp and target.progression.xp > 0 then return end
    if source.progression then
        target.progression = copy_table(source.progression)
    end
    if source.quests then
        target.quests = copy_table(source.quests)
    end
end

function save_icon_frame_pos(ox, oy)
    pcall(function()
        local profile_num = (G.SETTINGS and G.SETTINGS.profile) or 1
        love.filesystem.write(
            "icon_frame_pos_" .. profile_num .. ".jkr",
            "return {x=" .. ox .. ",y=" .. oy .. "}"
        )
    end)
end

function load_icon_frame_pos()
    local result = nil
    pcall(function()
        local profile_num = (G.SETTINGS and G.SETTINGS.profile) or 1
        local path = "icon_frame_pos_" .. profile_num .. ".jkr"
        if love.filesystem.getInfo and love.filesystem.getInfo(path) then
            local data = love.filesystem.read(path)
            if data then
                local fn = loadstring(data)
                if fn then
                    local ok, val = pcall(fn)
                    if ok and type(val) == 'table' and
                       type(val.x) == 'number' and type(val.y) == 'number' then
                        result = val
                    end
                end
            end
        end
    end)
    return result
end

function setup_profile_icon_frame()
    pcall(function()
        if G.PROFILE_ICON_FRAME then
            G.PROFILE_ICON_FRAME:remove()
            G.PROFILE_ICON_FRAME = nil
        end
        if not G.UIDEF or not G.UIDEF.profile_icon_frame or not G.ROOM_ATTACH then return end

        G.PROFILE_ICON_FRAME = UIBox{
            definition = G.UIDEF.profile_icon_frame(),
            config = {align="tli", offset = {x=0, y=0}, major = G.ROOM_ATTACH, bond = 'Weak'}
        }
        G.PROFILE_ICON_FRAME:align_to_major()

        local rx, ry = G.ROOM_ATTACH.T.x, G.ROOM_ATTACH.T.y
        local rw, rh = G.ROOM_ATTACH.T.w, G.ROOM_ATTACH.T.h
        local fw = G.PROFILE_ICON_FRAME.T.w
        local fh = G.PROFILE_ICON_FRAME.T.h
        local pos_x, pos_y = rx, ry

        local saved = load_icon_frame_pos()
        if saved then
            pos_x = rx + saved.x
            pos_y = ry + saved.y
        else
            local clear_y = CORNER_LABELS and CORNER_LABELS.mode_clear_y and CORNER_LABELS.mode_clear_y(pos_x)
            if clear_y then pos_y = math.max(pos_y, clear_y) end
        end

        G.PROFILE_ICON_FRAME.T.x = pos_x
        G.PROFILE_ICON_FRAME.T.y = pos_y
        G.PROFILE_ICON_FRAME.VT.x = pos_x
        G.PROFILE_ICON_FRAME.VT.y = pos_y

        G.PROFILE_ICON_FRAME.role.role_type = 'Major'
        G.PROFILE_ICON_FRAME.role.major = nil

        G.PROFILE_ICON_FRAME.states.drag.can = true
        G.PROFILE_ICON_FRAME.states.collide.can = true

        local _frame_box = G.PROFILE_ICON_FRAME
        local function _enable_drag_recursive(elem)
            if not elem then return end
            if elem.states then
                elem.states.collide.can = true
                elem.states.drag.can = true
            end
            elem.can_drag = function() return _frame_box end
            if elem.children then
                for _, child in pairs(elem.children) do
                    if child then _enable_drag_recursive(child) end
                end
            end
            if elem.config and elem.config.object then
                local obj = elem.config.object
                if obj.states then
                    obj.states.collide.can = true
                    obj.states.drag.can = true
                end
                obj.can_drag = function() return _frame_box end
            end
        end
        _enable_drag_recursive(G.PROFILE_ICON_FRAME.UIRoot)

        G.PROFILE_ICON_FRAME.drag = function(self, offset)
            Moveable.drag(self, offset)
        end

        G.PROFILE_ICON_FRAME.stop_drag = function(self)
            Node.stop_drag(self)
            local _rx = G.ROOM_ATTACH and G.ROOM_ATTACH.T.x or 0
            local _ry = G.ROOM_ATTACH and G.ROOM_ATTACH.T.y or 0
            save_icon_frame_pos(self.T.x - _rx, self.T.y - _ry)
        end
    end)
end

function main_menu_bar_offset()
    local below = 0.8
    if G.ROOM and G.TILESIZE and G.TILESCALE and love.graphics then
        below = love.graphics.getHeight()/(G.TILESIZE*G.TILESCALE) - (G.ROOM.T.y + G.ROOM.T.h)
    end
    if not _G._IS_DESKTOP then return math.min(0.4, below - 0.1) end
    return math.max(0.65, below - 0.05)
end

