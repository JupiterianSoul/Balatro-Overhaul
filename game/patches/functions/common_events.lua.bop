function notify_alert_scale(node, k, depth)
    depth = depth or 0
    if type(node) ~= "table" or depth > 12 then return node end
    local c = node.config
    if c then
        if c.scale then c.scale = c.scale * k end
        if c.maxw then c.maxw = c.maxw * k end
        if c.padding then c.padding = c.padding * math.min(k, 1.3) end
        local o = c.object
        if o and o.T and o.T.w then o.T.w, o.T.h = o.T.w * k, o.T.h * k end
    end
    for _, v in ipairs(node.nodes or {}) do notify_alert_scale(v, k, depth + 1) end
    return node
end

function notify_alert_def(_achievement, _type, from_left)
    local def = create_UIBox_notify_alert(_achievement, _type, from_left)
    if PORTRAIT and PORTRAIT.on and PORTRAIT.on() and PORTRAIT.popup_k then notify_alert_scale(def, PORTRAIT.popup_k()) end
    return def
end

