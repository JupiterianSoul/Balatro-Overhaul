    end
    G.VIBRATION = 0
end

-- Haptic feedback helper: trigger a vibration at a specific intensity level
-- level: 1=light (tap), 2=medium (score), 3=heavy (win), 4=rigid (big moment)
function haptic_buzz(level)
    if not G or not G.SETTINGS then return end
    if not G.SETTINGS.haptic_feedback then return end
    G.HAPTIC_LEVEL = math.max(G.HAPTIC_LEVEL or 0, level or 1)
