OverhaulUpdate = OverhaulUpdate or {}
local U = OverhaulUpdate

local DEFAULT_URL = "wss://balatro-overhaul-muliplayer.onrender.com/ws"
local RECHECK_SECS = 1800
local RETRY_SECS = 120
local BOOT = rawget(_G, "OVERHAUL_BOOTSTRAP")
if type(BOOT) ~= "table" or type(BOOT.feed) ~= "string" then BOOT = nil end
local TARGET = BOOT and tostring(BOOT.update or "update/patch.zip") or "update/game.love"
local PART = TARGET .. ".part"
local SUM = TARGET .. ".sha256"
local RESTART = "update/restart"
local PLATFORMS = {Android = "android", Linux = "linux", Windows = "windows"}

U.state = U.state or "none"
U.ui = U.ui or {label = ""}

local HASH_THREAD = [[
require("love.filesystem")
require "love.data"
local path, channel = ...
local ok, hex = pcall(function()
    local data = love.filesystem.newFileData(path)
    local digest = love.data.hash("sha256", data)
    data:release()
    return love.data.encode("string", "hex", digest)
end)
love.thread.getChannel(channel):push(ok and hex or "")
]]

local function platform()
    if BOOT then return BOOT.feed end
    if os.getenv("OVERHAUL_RUNTIME") == "1" then return nil end
    return love.system and PLATFORMS[love.system.getOS()]
end

function U.in_game_install()
    if BOOT then return true end
    return platform() ~= "android" and os.getenv("OVERHAUL_UPDATER") == "1"
end

local function base_url()
    local cfg = rawget(_G, "mp_config")
    local ws = (type(cfg) == "table" and cfg.SERVER_URL) or DEFAULT_URL
    return (tostring(ws):gsub("^wss://", "https://"):gsub("^ws://", "http://"):gsub("/ws/?$", ""))
end

local function decode(body)
    local ok, chunk = pcall(love.filesystem.load, "smods/libs/json/json.lua")
    if not ok or not chunk then return nil end
    local ok2, lib = pcall(chunk)
    if not ok2 then return nil end
    local ok3, data = pcall(lib.decode, body or "")
    return ok3 and type(data) == "table" and data or nil
end

function U.newer(a, b)
    local pa, pb = {}, {}
    for n in tostring(a):gmatch("%d+") do pa[#pa + 1] = tonumber(n) end
    for n in tostring(b):gmatch("%d+") do pb[#pb + 1] = tonumber(n) end
    for i = 1, math.max(#pa, #pb) do
        local x, y = pa[i] or 0, pb[i] or 0
        if x ~= y then return x > y end
    end
    return false
end

local function menu_ready()
    return G and G.STAGES and G.STAGE == G.STAGES.MAIN_MENU and G.MAIN_MENU_UI
end

function U.refresh_menu()
    if not menu_ready() then return end
    if G.collection_alert then
