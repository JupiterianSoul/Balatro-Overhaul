    local diff = BOT.difficulty and BOT.difficulty.level() or v.difficulty
    return {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR, minw = 12.2, minh = 7}, nodes = {
        {n = G.UIT.R, config = {id = "botlatro_tab", align = "cm", padding = 0.04}, nodes = {
            {n = G.UIT.C, config = {align = "cm", padding = 0.08, r = 0.1, colour = G.C.BLACK, minw = 12}, nodes = {
                {n = G.UIT.C, config = {align = "cl", minw = 5.9}, nodes = {
                    {n = G.UIT.R, config = {align = "cl"}, nodes = {
                        {n = G.UIT.T, config = {text = L("BOT-LATRO"), scale = 0.55, colour = G.C.GOLD, shadow = true}},
                    }},
                    {n = G.UIT.R, config = {align = "cl"}, nodes = {
