BOT = BOT or {}
local U = {}
BOT.ui = U

local function L(s)
    if mod_loc then return mod_loc(s) end
    return s
end

local SPEEDS = {{"Slow", 1.5}, {"Normal", 0.6}, {"Fast", 0.2}, {"Instant", 0}}
U.PAGES = {{"ai", "AI"}, {"game", "Game"}, {"options", "Options"}, {"stats", "Stats"}}

local function index_of(list, v, f)
    for i, x in ipairs(list) do
        if (f and f(x) or x) == v then return i end
    end
    return 1
end

local function col(node)
    return {n = G.UIT.C, config = {align = "cm", padding = 0.02}, nodes = {node}}
end

local function text_row(text, scale, colour)
    return {n = G.UIT.R, config = {align = "cm", padding = 0.03}, nodes = {
        {n = G.UIT.T, config = {text = text, scale = scale or 0.32, colour = colour or G.C.UI.TEXT_LIGHT, shadow = true}},
    }}
end
U.text_row = text_row

local function masked(key)
    if not key then return L("none") end
    if #key <= 8 then return string.rep("*", #key) end
    return key:sub(1, 6) .. "..." .. key:sub(-4)
end

local function short(s, n)
    s = tostring(s or "")
    if #s > n then return s:sub(1, n - 2) .. ".." end
    return s
end
U.short = short

local function cap(s)
    s = tostring(s or "")
    return s:sub(1, 1):upper() .. s:sub(2)
end

local function button(label, func, colour, w, h, scale)
    return UIBox_button({label = {label}, button = func, minw = w or 1.8, minh = h or 0.6, scale = scale or 0.36, colour = colour, col = true})
end

function U.page_key()
    local pg = U.page or 1
    if type(pg) == "number" then pg = (U.PAGES[pg] or U.PAGES[1])[1] end
    for _, p in ipairs(U.PAGES) do
        if p[1] == pg then return pg end
    end
    return "ai"
end

function U.brain_label()
    local cfg = BOT.config
    local v = cfg.values or cfg.load()
    local p = cfg.provider(v.provider)
    local R = BOT.difficulty and BOT.difficulty.results and BOT.difficulty.results()
    local ver = R and R.version
    return short(L(p.label) .. ((p.key == "w14" and ver) and (" " .. ver) or ""), 40)
end

function U.ai_rows()
    local cfg = BOT.config
    local v = cfg.values or cfg.load()
    local provs, labels = cfg.PROVIDERS, {}
    for i, p in ipairs(provs) do labels[i] = L(p.label) end
    local p = cfg.provider(v.provider)
    local rows = {}
    rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.03}, nodes = {
        create_option_cycle({label = L("Bot"), options = labels, current_option = index_of(provs, v.provider, function(x) return x.key end),
            opt_callback = "bot_set_provider", w = 4.5, scale = 0.75, colour = G.C.RED}),
    }}
    local desc = {
        w14 = {"Our trained bot. Plays fair: sees only what you see, one try per seed.", "A hand solver plays the cards, a neural net and rollouts pick shops, packs and skips."},
        seer = {"Reads the seed: knows every future draw, shop and pack.", "It cheats on purpose, so its games are kept apart from Fair's."},
    }
    for i, line in ipairs(desc[p.key] or {}) do
        rows[#rows + 1] = text_row(L(line), i == 1 and 0.3 or 0.28, i == 1 and G.C.UI.TEXT_LIGHT or G.C.UI.TEXT_INACTIVE)
    end
    rows[#rows + 1] = text_row(L("Starts its own vanilla run (no mods, no challenge). Thinks in the background."), 0.28, G.C.UI.TEXT_INACTIVE)
    local budgets = BOT.sim and BOT.sim.BUDGETS or {"fast", "normal", "deep"}
    local blabels = {}
    for i, b in ipairs(budgets) do blabels[i] = L(cap(b)) end
    rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.03}, nodes = {
        col(create_option_cycle({label = L("Thinking time"), options = blabels, current_option = index_of(budgets, v.sim_budget or "normal"),
            opt_callback = "bot_set_sim_budget", w = 2.4, scale = 0.7, colour = G.C.PURPLE})),
    }}
    rows[#rows + 1] = text_row(L("Normal is the version measured in the Stats tab. Fast thinks less, Deep thinks more."), 0.26, G.C.UI.TEXT_INACTIVE)
    return rows
end

function U.options_rows()
    local cfg = BOT.config
    local v = cfg.values or cfg.load()
    local p = cfg.provider(v.provider)
    local rows = {}
    local speed_labels = {}
    for i, s in ipairs(SPEEDS) do speed_labels[i] = L(s[1]) end
    rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.02}, nodes = {
        col(create_option_cycle({label = L("Speed"), options = speed_labels, current_option = index_of(SPEEDS, v.delay, function(x) return x[2] end),
            opt_callback = "bot_set_speed", w = 2, scale = 0.7, colour = G.C.ORANGE})),
        col(create_option_cycle({label = L("Mode"), options = {L("Auto"), L("Step")}, current_option = v.mode == "step" and 2 or 1,
            opt_callback = "bot_set_mode", w = 2, scale = 0.7, colour = G.C.ORANGE})),
    }}
    rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.02}, nodes = {
        {n = G.UIT.C, config = {align = "cm", padding = 0.02, minw = 3.6}, nodes = {
            create_toggle({label = L("Show reasoning"), ref_table = v, ref_value = "show_reasoning", callback = G.FUNCS.bot_save_settings, w = 2.6, label_scale = 0.32, scale = 0.9}),
        }},
    }}
    return rows
end

function U.page_rows()
    local key = U.page_key()
    local f = ({ai = U.ai_rows, game = U.game_rows, options = U.options_rows, versus = U.versus_rows, stats = U.stats_rows})[key]
    local rows = f and f() or {}
    if #rows == 0 then rows[1] = text_row(L("Nothing here yet"), 0.3, G.C.UI.TEXT_INACTIVE) end
    return rows
end

function U.page_buttons()
    local key = U.page_key()
    local nodes = {}
    for _, p in ipairs(U.PAGES) do
        nodes[#nodes + 1] = button(L(p[2]), "bot_settings_page_" .. p[1], key == p[1] and G.C.RED or G.C.L_BLACK, 2.2, 0.65, 0.4)
    end
    return {n = G.UIT.R, config = {align = "cm", padding = 0.04}, nodes = nodes}
end

local function page_box(minh)
    return {n = G.UIT.R, config = {align = "cm", padding = 0.04}, nodes = {
        {n = G.UIT.C, config = {align = "cm", r = 0.1, colour = G.C.BLACK, padding = 0.08, minw = 12, minh = minh or 5.5}, nodes = U.page_rows()},
    }}
end

local function big_button(label, func, colour, w)
    return {n = G.UIT.C, config = {align = "cm", padding = 0.1, minh = 0.8, minw = w, r = 0.1, hover = true, colour = colour, button = func, shadow = true}, nodes = {
        {n = G.UIT.T, config = {text = label, scale = 0.45, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
    }}
end

function U.start_buttons()
    local in_run = G.STAGE == G.STAGES.RUN and G.GAME
    local over = in_run and (G.STATE == G.STATES.GAME_OVER or (G.GAME.won and not G.GAME.bot_endless))
    local nodes = {}
    if in_run and U.solo and not over then
        nodes[#nodes + 1] = big_button(L("Stop Bot-latro"), "bot_panel_stop", G.C.RED, 5.9)
        nodes[#nodes + 1] = {n = G.UIT.B, config = {w = 0.15, h = 0.1}}
        nodes[#nodes + 1] = big_button(L("New Bot-latro run"), "botlatro_start", G.C.BLUE, 5.9)
    elseif in_run and not over then
        nodes[#nodes + 1] = big_button(L("Bot-latro plays this run"), "bot_take_over", G.C.GREEN, 5.9)
        nodes[#nodes + 1] = {n = G.UIT.B, config = {w = 0.15, h = 0.1}}
        nodes[#nodes + 1] = big_button(L("New Bot-latro run"), "botlatro_start", G.C.BLUE, 5.9)
    else
        nodes[#nodes + 1] = big_button(L("START A BOT-LATRO RUN"), "botlatro_start", G.C.BLUE, 12)
    end
    return {n = G.UIT.R, config = {align = "cm", padding = 0.06}, nodes = nodes}
end

