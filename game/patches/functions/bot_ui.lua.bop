        tc.UIBox:recalculate()
    elseif U.open then
        G.FUNCS.overlay_menu({definition = U.settings_definition()})
    end
end

function U.refresh_settings()
    if not G.E_MANAGER then return U.refresh_now() end
    if U.refresh_queued then return end
    U.refresh_queued = true
    G.E_MANAGER:add_event(Event({trigger = "immediate", blockable = false, blocking = false, no_delete = true, func = function()
        U.refresh_queued = false
        U.refresh_now()
        return true
    end}))
end

