                    }},
                    {n = G.UIT.R, config = {align = "cr"}, nodes = {
                        {n = G.UIT.T, config = {text = L(cap(diff)) .. ", " .. L(cap(v.sim_budget or "normal")), scale = 0.42, colour = G.C.ORANGE, shadow = true}},
                    }},
                }},
            }},
