local _hi_key, _hi_res, _hi_n, _hi_at = nil, {}, 0, 0
local _hi_scratch = {}

local function _hi_fill(cards, out)
    local n = 0
    local function put(v)
        n = n + 1
        if v == nil then v = false end
        out[n] = v
    end
    put(#cards)
    for i = 1, #cards do
        local c = cards[i]
        local base = c.base or false
        put(c); put(c.ability); put(c.config and c.config.center); put(c.edition); put(c.seal)
        put(c.debuff); put(c.facing); put(base and base.id); put(base and base.suit); put(base and base.value)
    end
    local jokers = G.jokers and G.jokers.cards or _hi_scratch
    put(#jokers)
    for i = 1, #jokers do
        local j = jokers[i]
        put(j); put(j.debuff); put(j.ability); put(j.config and j.config.center)
    end
    put(G.consumeables and #G.consumeables.cards)
    put(G.hand and G.hand.cards and #G.hand.cards)
    local blind = G.GAME and G.GAME.blind
    put(G.GAME); put(blind); put(blind and blind.disabled); put(blind and blind.config and blind.config.blind)
    put(G.STATE)
    return n
end

local function _hi_store(cards, ...)
    local key = {}
    local n = _hi_fill(cards, key)
    key.n = n
    _hi_key = key
    _hi_n = select("#", ...)
    for i = 1, _hi_n do _hi_res[i] = (select(i, ...)) end
    _hi_at = G.TIMERS and G.TIMERS.REAL or 0
    return ...
end

local function _hi_hit(cards)
    local key = _hi_key
    if not key then return false end
    local now = G.TIMERS and G.TIMERS.REAL or 0
    if now < _hi_at or now - _hi_at > 1 then return false end
    local scratch = _hi_scratch
    local n = _hi_fill(cards, scratch)
    local same = n == key.n
    if same then
        for i = 1, n do
            if scratch[i] ~= key[i] then same = false; break end
        end
    end
    for i = 1, n do scratch[i] = nil end
    return same
end

local function _hi_get(raw, cards)
    if P.hi_bypass then return raw(cards) end
    if _hi_hit(cards) then
        if P.hi_check then P.hi_check(raw, cards, _hi_res, _hi_n) end
        return unpack(_hi_res, 1, _hi_n)
    end
    return _hi_store(cards, raw(cards))
end

function PREVIEW.hand_info(cards)
    return _hi_get(G.FUNCS.get_poker_hand_info, cards)
end

function PREVIEW.with_hand_info(fn, ...)
    local raw = G.FUNCS.get_poker_hand_info
    G.FUNCS.get_poker_hand_info = function(cards)
        return _hi_get(raw, cards)
    end
    local res = {pcall(fn, ...)}
    G.FUNCS.get_poker_hand_info = raw
    return unpack(res, 1, table.maxn(res))
end

