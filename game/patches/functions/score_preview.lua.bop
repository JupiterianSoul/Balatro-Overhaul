local copy_left = 0
local function dcopy(v, seen)
    if type(v) ~= 'table' or getmetatable(v) ~= nil or SHARED[v] then return v end
    local done = seen[v]
    if done then return done end
    if copy_left <= 0 then return v end
    local t = {}
    seen[v] = t
    for k, x in pairs(v) do
        copy_left = copy_left - 1
        if type(x) == 'table' then t[k] = dcopy(x, seen) else t[k] = x end
    end
    return t
end

local function shallow(v)
    if type(v) ~= 'table' then return v end
    local t = {}
    for k, x in pairs(v) do t[k] = x end
    return t
end

local SW = {}
local function swap(t, k, v)
    SW[#SW + 1] = {t, k, rawget(t, k)}
    rawset(t, k, v)
end
local function unswap()
    for i = #SW, 1, -1 do
        local e = SW[i]
        rawset(e[1], e[2], e[3])
        SW[i] = nil
    end
end

local function num(v)
    local tv = type(v)
    if tv == 'number' then return v end
    if tv == 'table' or tv == 'cdata' then
        local ok, r = pcall(function() return to_number and to_number(v) or tonumber(tostring(v)) end)
        if ok and type(r) == 'number' then return r end
    end
    return nil
end

local function fx_add(real, r, depth)
    local f = SB.fx[real]
    if not f then
        f = {chips = 0, mult = 0, xmult = 1, dollars = 0, reps = 0, hits = 0}
        SB.fx[real] = f
    end
    local hit = false
    local c = num(r.chips) or num(r.chip_mod)
    if c and c ~= 0 then f.chips = f.chips + c; hit = true end
    local m = num(r.mult) or num(r.mult_mod) or num(r.h_mult)
    if m and m ~= 0 then f.mult = f.mult + m; hit = true end
    local x = num(r.x_mult) or num(r.Xmult_mod) or num(r.xmult) or num(r.Xmult) or num(r.x_mult_mod)
    if x and x ~= 1 then f.xmult = f.xmult * x; hit = true end
    local d = num(r.dollars) or num(r.p_dollars)
    if d and d ~= 0 then f.dollars = f.dollars + d; hit = true end
    local rp = num(r.repetitions)
    if rp and rp > 0 then f.reps = f.reps + rp; hit = true end
    if hit then f.hits = f.hits + 1 end
    if type(r.extra) == 'table' and getmetatable(r.extra) == nil and (depth or 0) < 4 then
        fx_add(real, r.extra, (depth or 0) + 1)
    end
end

local CARD_NOOPS = {'juice_up', 'start_dissolve', 'shatter', 'remove', 'remove_from_deck', 'add_to_deck', 'set_sprites',
    'flip', 'highlight', 'start_materialize', 'hard_set_T', 'move', 'draw', 'align', 'stop_drag', 'set_cost_UI', 'wiggle'}

local function proxy_card(c, area, map, fresh)
    if not fresh and map[c] then return map[c] end
    local p = {}
    for k, v in pairs(c) do p[k] = v end
    setmetatable(p, getmetatable(c))
    local seen = {}
    p.ability = dcopy(c.ability, seen)
    p.base = dcopy(c.base, seen)
    p.edition = dcopy(c.edition, seen)
    p.config = shallow(c.config)
    p.T = shallow(c.T)
    p.VT = shallow(c.VT)
    p.states = dcopy(c.states, seen)
    p.joker_display_values = nil
    p.children = VOID
    p.area = area
    p.highlighted = false
    p._sb_real = c._sb_real or c
    for _, k in ipairs(CARD_NOOPS) do p[k] = NOOP end
    p.set_card_area = function(self, a) self.area = a end
    if not fresh then map[c] = p end
    return p
end

local function center_is(name)
    return function(v) return v.config.center and v.config.center.name == name end
end

local TALLIES = {
    ['Steel Joker'] = {'steel_tally', center_is('Steel Card')},
    ['Stone Joker'] = {'stone_tally', center_is('Stone Card')},
    ['Cloud 9'] = {'nine_tally', function(v) return v:get_id() == 9 end},
    ["Driver's License"] = {'driver_tally', function(v) return v.config.center and v.config.center.name ~= 'Default Base' end},
}

local function fill_tally(p)
    local t = p.ability and TALLIES[p.ability.name]
    if not t or p.ability[t[1]] ~= nil then return end
    local n = 0
    for _, v in pairs(G.playing_cards or {}) do
        if t[2](v) then n = n + 1 end
    end
    p.ability[t[1]] = n
end

local function wrap_fx(p, real)
    local base = p.calculate_joker
    if type(base) ~= 'function' then return end
    p.calculate_joker = function(self, ctx, ...)
        local r, r2 = base(self, ctx, ...)
        if SB.fx and type(r) == 'table' and type(ctx) == 'table' and not ctx.blueprint then
            pcall(fx_add, real, r, 0)
        end
        return r, r2
    end
end

