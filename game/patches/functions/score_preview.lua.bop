local _orig_pm_compute = PREVIEW.compute
function PREVIEW.compute(sel, opts)
    if not (PERF_MON and PERF_MON.enabled) then return _orig_pm_compute(sel, opts) end
    local t0 = love.timer.getTime()
    local r1, r2, r3 = _orig_pm_compute(sel, opts)
    PERF_MON.add_sub("score_preview", (love.timer.getTime() - t0) * 1000)
    return r1, r2, r3
end

