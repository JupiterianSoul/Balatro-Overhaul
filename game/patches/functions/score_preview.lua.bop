local function check_line(status, real, res, extra)
    local C = P._check
    if not C then return end
    C[status] = (C[status] or 0) + 1
    local jk = {}
    for _, j in ipairs(G.jokers and G.jokers.cards or {}) do jk[#jk + 1] = j.config and j.config.center and j.config.center.key or '?' end
    local b = G.GAME and G.GAME.blind
    C.f:write(string.format("PREVIEW_CHECK %s real=%s exact=%s lo=%s hi=%s ms=%s hand=%s blind=%s jokers=%s %s\n",
        status, tostring(real), tostring(res and res.exact), tostring(res and res.lo), tostring(res and res.hi),
        res and res.ms and string.format('%.2f', res.ms) or '-', tostring(res and res.name),
        tostring(b and b.config and b.config.blind and b.config.blind.key), table.concat(jk, ','), extra or ''))
    C.f:flush()
end

local function check_after(q, n0)
    local C = P._check
    local res = C.pending
    C.pending = nil
    local real = nil
    for i = #q, n0 + 1, -1 do
        local ev = q[i]
        local e = type(ev) == 'table' and ev.ease
        if e and e.ref_table == G.GAME and e.ref_value == 'chips' then
            local ok, d = pcall(function() return e.end_val - e.start_val end)
            if ok then real = d end
            break
        end
    end
    if real == nil then return check_line('noreal', nil, res) end
    if not res then return check_line('none', real, nil, P.last_error and ('err=' .. tostring(P.last_error):gsub('%s+', '_'):sub(1, 160)) or '') end
    local okx, exact_ok = pcall(function() return math.abs(num(res.exact) - num(real)) <= 1e-6 * math.max(1, math.abs(num(real))) end)
    local okr, in_range = pcall(function() return res.lo <= real and real <= res.hi end)
    if okx and exact_ok and okr and in_range then return check_line('ok', real, res) end
    if not (okr and in_range) then return check_line('range_miss', real, res) end
    return check_line('exact_miss', real, res)
end

function PREVIEW.install_check()
    if P._check then return end
    local out = (os.getenv('SOAK_OUT') or '.') .. '/preview_check_' .. (os.getenv('SOAK_SEED') or '0') .. '.txt'
    local f = io.open(out, 'a')
    if not f then return end
    P._check = {f = f}
    local raw_play = G.FUNCS.play_cards_from_highlighted
    G.FUNCS.play_cards_from_highlighted = function(e, ...)
        if not (G.play and G.play.cards[1]) and G.hand and G.hand.highlighted and #G.hand.highlighted > 0 then
            P.clear_cache()
            local ok, res = pcall(P.compute, G.hand.highlighted, {exact = true})
            P._check.pending = ok and res or false
        end
        return raw_play(e, ...)
    end
end

local _orig_evaluate_play = G.FUNCS.evaluate_play
function G.FUNCS.evaluate_play(e, ...)
