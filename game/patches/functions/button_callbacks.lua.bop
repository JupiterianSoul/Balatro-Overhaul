function create_UIBox_mp_stats()
  local profile = G.PROFILES and G.SETTINGS and G.PROFILES[G.SETTINGS.profile]
  local progression = profile and profile.progression or {}

  -- All values start at 0 if not yet tracked
  local mp_matches = progression.mp_total_matches or 0
  local mp_wins    = progression.mp_match_wins or 0
  local mp_losses  = math.max(0, mp_matches - mp_wins)
  local mp_ratio   = (mp_matches > 0)
      and string.format("%.0f%%", (mp_wins / mp_matches) * 100)
      or "N/A"
  local mp_streak  = progression.mp_win_streak_best or 0
  local pvp_wins   = progression.mp_pvp_wins_total or 0
  local pvp_losses = progression.mp_pvp_losses_total or 0

  -- Stat row: label on left, value on right
  local function stat_row(label, value, val_col)
    val_col = val_col or G.C.GOLD
    return {n=G.UIT.R, config={align="cm", padding=0.045, r=0.06, colour=G.C.L_BLACK, minw=8}, nodes={
      {n=G.UIT.C, config={align="cl", minw=5.5, padding=0.08}, nodes={
        {n=G.UIT.T, config={text=label, scale=0.3, colour=G.C.UI.TEXT_LIGHT, shadow=true}}
      }},
      {n=G.UIT.C, config={align="cr", minw=2.5, padding=0.08}, nodes={
        {n=G.UIT.T, config={text=tostring(value), scale=0.34, colour=val_col, shadow=true}}
      }},
    }}
  end

  -- Thin section divider
  local function divider()
    return {n=G.UIT.R, config={align="cm", minw=8.5, minh=0.015, colour={1,1,1,0.12}}, nodes={}}
  end

  -- Greyed section header
  local function section_header(txt)
    return {n=G.UIT.R, config={align="cm", padding=0.05}, nodes={
      {n=G.UIT.T, config={text=txt, scale=0.26, colour=G.C.UI.TEXT_INACTIVE, shadow=true}}
    }}
  end

  return create_UIBox_generic_options({back_func='high_scores', contents={
    -- Title
    {n=G.UIT.R, config={align="cm", padding=0.07}, nodes={
      {n=G.UIT.T, config={text=mod_loc("MULTIPLAYER STATS"), scale=0.5, colour=G.C.GOLD, shadow=true}}
    }},
    -- Main panel
    {n=G.UIT.R, config={align="cm", padding=0.05, r=0.1, colour=G.C.BLACK, emboss=0.05, minw=8.8, minh=5.5}, nodes={
      {n=G.UIT.C, config={align="tm", padding=0.06}, nodes={
        section_header("MATCH RECORD"),
        divider(),
        stat_row("Matches Played", mp_matches, G.C.UI.TEXT_LIGHT),
        stat_row("Wins",           mp_wins,    G.C.GREEN),
        stat_row("Losses",         mp_losses,  G.C.RED),
        stat_row("Win Rate",       mp_ratio,   G.C.BLUE),
        stat_row("Best Win Streak",mp_streak,  G.C.GOLD),
        divider(),
        section_header("NEMESIS BLINDS (PvP)"),
        divider(),
        -- Two big numbers side by side for Nemesis W/L
        {n=G.UIT.R, config={align="cm", padding=0.05}, nodes={
          {n=G.UIT.C, config={align="cm", padding=0.1, minw=4}, nodes={
            {n=G.UIT.T, config={text=mod_loc("WON"), scale=0.25, colour=G.C.UI.TEXT_INACTIVE, shadow=true}},
            {n=G.UIT.R, config={align="cm", minh=0.04}, nodes={}},
            {n=G.UIT.T, config={text=tostring(pvp_wins),   scale=0.6, colour=G.C.GREEN, shadow=true}},
          }},
          -- Vertical divider
          {n=G.UIT.C, config={align="cm", colour={1,1,1,0.15}, minw=0.02, minh=1.4}, nodes={}},
          {n=G.UIT.C, config={align="cm", padding=0.1, minw=4}, nodes={
            {n=G.UIT.T, config={text=mod_loc("LOST"), scale=0.25, colour=G.C.UI.TEXT_INACTIVE, shadow=true}},
            {n=G.UIT.R, config={align="cm", minh=0.04}, nodes={}},
            {n=G.UIT.T, config={text=tostring(pvp_losses), scale=0.6, colour=G.C.RED,   shadow=true}},
          }},
        }},
      }},
    }},
  }})
end

