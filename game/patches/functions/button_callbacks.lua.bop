-- FIX: Block MP-gated settings from being re-enabled during a multiplayer match.
-- Wraps toggle_button so hand optimizer and score preview cannot be toggled on
-- when the host has disabled them in match settings.
local _orig_toggle_button = G.FUNCS.toggle_button
G.FUNCS.toggle_button = function(e)
  if G.GAME and G.GAME.multiplayer and G.GAME.mp_settings and e.config.ref_table then
    local rv = e.config.ref_table.ref_value
    local blocked = {
      hand_optimizer        = not G.GAME.mp_settings.allow_hand_optimizer,
      score_preview_enabled = not (G.GAME.mp_settings.allow_score_preview and not G.GAME.mp_settings.preview_disabled),
    }
    if rv and blocked[rv] then
      pcall(play_sound, 'cancel')
      return
    end
  end
  _orig_toggle_button(e)
