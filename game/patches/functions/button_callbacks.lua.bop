-- FEATURE: Replay run on the same seed + stake so the player can retry a lost/won run.
-- The seed and stake are captured into G.ARGS.replay_run when the game over / win screen opens.
G.FUNCS.replay_run = function(e)
  local saved = G.ARGS and G.ARGS.replay_run
  if not saved then
    -- Fallback: G.GAME still accessible (e.g. called from win screen before wipe)
    if G.GAME and G.GAME.pseudorandom then
      saved = {
        seed  = G.GAME.pseudorandom.seed,
        stake = G.GAME.stake or 1,
      }
    end
  end
  if not saved then return end
  if G.OVERLAY_MENU then G.OVERLAY_MENU:remove(); G.OVERLAY_MENU = nil end
  G.FUNCS.start_run(nil, {stake = saved.stake, seed = saved.seed})
