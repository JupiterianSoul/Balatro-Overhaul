local TEXT_ACCENTS_LOWER = {'à','â','ä','ç','é','è','ê','ë','î','ï','ô','ö','ù','û','ü','ÿ','œ','æ','ñ','á','í','ó','ú'}
local TEXT_ACCENTS_UPPER = {'À','Ä','Ç','É','È','Ê','Ë','Î','Ï','Ô','Ö','Ù','Û','Ü','Ÿ','Œ','Æ','Ñ','Á','Í','Ó','Ú'}
local TEXT_ACCENT_BASE = {}
local TEXT_ACCENT_UPPER_OF = {}
local TEXT_WIDE_CHARS = {["'"] = true, ['¡'] = true, ['¿'] = true}
do
  local bases = 'aaaceeeeiioouuuyoanaiou'
  for i, c in ipairs(TEXT_ACCENTS_LOWER) do
    TEXT_ACCENT_BASE[c] = bases:sub(i, i)
    TEXT_WIDE_CHARS[c] = true
  end
  local upper_bases = 'AACEEEEIIOOUUUYOANAIOU'
  for i, c in ipairs(TEXT_ACCENTS_UPPER) do
    TEXT_ACCENT_BASE[c] = upper_bases:sub(i, i):lower()
    TEXT_WIDE_CHARS[c] = true
  end
  for _, c in ipairs(TEXT_ACCENTS_LOWER) do
    for _, u in ipairs(TEXT_ACCENTS_UPPER) do
      if TEXT_ACCENT_BASE[u] == TEXT_ACCENT_BASE[c] and not TEXT_ACCENT_UPPER_OF[c] then
        local lc, uc = c:byte(2), u:byte(2)
        if c:byte(1) == u:byte(1) and lc and uc and lc - uc == 32 then TEXT_ACCENT_UPPER_OF[c] = u end
      end
    end
  end
  TEXT_ACCENT_UPPER_OF['ÿ'] = 'Ÿ'
  TEXT_ACCENT_UPPER_OF['œ'] = 'Œ'
end

G.TEXT_INPUT_CHARSET = {lower = TEXT_ACCENTS_LOWER, upper = TEXT_ACCENTS_UPPER, wide = TEXT_WIDE_CHARS}

local function text_utf8_chars(s)
  local out = {}
  for ch in (s or ''):gmatch('[%z\1-\127\194-\244][\128-\191]*') do out[#out+1] = ch end
  return out
end

local function text_utf8_len(s)
  return #text_utf8_chars(s)
end

G.FUNCS.text_input_wide = function(ref_table)
  return ref_table and ref_table.extended_corpus and not ref_table.strict_corpus and true or false
end

G.FUNCS.text_input_char = function(t)
  local hook = G.CONTROLLER and G.CONTROLLER.text_input_hook
  if not hook or not t then return end
  for _, ch in ipairs(text_utf8_chars(t)) do
    if #ch > 1 then
      G.CONTROLLER.text_input_composed = {base = TEXT_ACCENT_BASE[ch], t = love.timer.getTime()}
      G.FUNCS.text_input_key({key = ch, raw = true})
    end
  end
end

