      {n=G.UIT.T, config={text = mod_loc("Tune each option to improve performance on your device."), scale = 0.3, colour = G.C.UI.TEXT_INACTIVE}}
    }},
    {n=G.UIT.R, config={align = "tm", padding = 0.1, colour = G.C.CLEAR}, nodes={left_col, right_col}},
  }})
end

-- Performance settings callbacks
G.FUNCS.change_perf_resolution = function(args)
  G.SETTINGS.GRAPHICS.perf_resolution = args.to_key
  G:save_settings()
  if love and love.resize then
    local w, h = love.graphics.getDimensions()
    love.resize(w, h)
  end
end

G.FUNCS.change_perf_shader_quality = function(args)
  G.SETTINGS.GRAPHICS.perf_shader_quality = args.to_key
  G:save_settings()
end

G.FUNCS.toggle_perf_particles = function()
  G:save_settings()
end

G.FUNCS.toggle_perf_gc_tuning = function()
  apply_gc_tuning(G.SETTINGS.GRAPHICS.perf_gc_tuning)
  G:save_settings()
end

G.FUNCS.change_perf_texture_filter = function(args)
  G.SETTINGS.GRAPHICS.perf_texture_filter = args.to_key
  local mode = args.to_key == 2 and 'nearest' or 'linear'
  love.graphics.setDefaultFilter(mode, mode)
  G:save_settings()
end

G.FUNCS.toggle_perf_canvas_caching = function()
  G:save_settings()
end

G.FUNCS.toggle_perf_offscreen_culling = function()
  G:save_settings()
end

G.FUNCS.toggle_perf_bg_anims = function()
  if G.ANIMATIONS and not G.SETTINGS.GRAPHICS.perf_bg_anims then
    for _, anim in pairs(G.ANIMATIONS) do
      if anim and anim.float then
        anim.T.r = 0
        anim.offset = anim.offset or {x = 0, y = 0}
        anim.offset.x = 0
        anim.offset.y = 0
      end
    end
  end
  G:save_settings()
end

c 27
l 37
G.FUNCS.change_default_hand_sort = function(args)
  G.SETTINGS.default_hand_sort = args.to_key == 2 and 2 or 1
  if G.hand and G.STAGE == G.STAGES.RUN then
    G.hand:sort(G.SETTINGS.default_hand_sort == 2 and 'suit desc' or 'desc')
  end
  G:save_settings()
end

G.FUNCS.apply_focus_mute = function(focused)
  if not (love.audio and love.audio.setVolume) then return end
  if G.SETTINGS and G.SETTINGS.mute_unfocused and not focused then
    love.audio.setVolume(0)
  else
    love.audio.setVolume(1)
  end
end

local _settings_prev_focus = love.focus
function love.focus(focused)
  if _settings_prev_focus then _settings_prev_focus(focused) end
  G.FUNCS.apply_focus_mute(focused)
end

G.FUNCS.change_fps_cap = function(args)
  local fps_values = {30, 40, 60, 90, 120, 144, 165, 9999}
  G.SETTINGS.GRAPHICS.fps_cap = args.to_key
  G.SETTINGS.GRAPHICS.fps_cap_v = 2
  G.FPS_CAP = fps_values[args.to_key] or 60
  G:save_settings()
end

G.FUNCS.reset_fps_position = function(e)
  G.SETTINGS.GRAPHICS.fps_x = nil
  G.SETTINGS.GRAPHICS.fps_y = nil
  G:save_settings()
end

