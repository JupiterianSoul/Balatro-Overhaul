-- Performance Mode toggle — applies fixed preset: shader off, 75% resolution, GC tuning
G.FUNCS.toggle_performance_mode = function()
  local _g = G.SETTINGS.GRAPHICS
  PERF_OPTS.apply_mode(_g.performance_mode)
  apply_gc_tuning(_g.perf_gc_tuning)
  G:save_settings()
  if love and love.resize then
    local w, h = love.graphics.getDimensions()
    love.resize(w, h)
  end
end

