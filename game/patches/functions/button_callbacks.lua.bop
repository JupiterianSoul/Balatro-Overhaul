local function overlay_fingerprint(def)
  local fp, n = {}, 0
  local function walk(node, depth)
    if type(node) ~= 'table' or depth > 40 then return end
    local c = node.config
    if type(c) == 'table' then
      local k
      if c.button then k = 'b:'..tostring(c.button) end
      if k and not fp[k] then fp[k] = true; n = n + 1 end
      if type(c.id) == 'string' then k = 'i:'..c.id; if not fp[k] then fp[k] = true; n = n + 1 end end
    end
    if type(node.nodes) == 'table' then
      for _, v in ipairs(node.nodes) do walk(v, depth + 1) end
    end
  end
  walk(def, 0)
  return {set = fp, n = n}
end

local function overlay_same(a, b)
  if not (a and b) or a.n < 2 or b.n < 2 then return false end
  local common = 0
  for k in pairs(a.set) do if b.set[k] then common = common + 1 end end
  return common / math.max(a.n, b.n) >= 0.75
end

local function overlay_chosen_tabs(box)
  local out = {}
  local function walk(node, depth)
    if not node or depth > 60 then return end
    local c = node.config
    if c and type(c.id) == 'string' and c.id:sub(1, 8) == 'tab_but_' and c.chosen then out[#out + 1] = c.id end
    for _, v in pairs(node.children or {}) do walk(v, depth + 1) end
    if c and c.object and c.object.UIRoot then walk(c.object.UIRoot, depth + 1) end
  end
  if box and box.UIRoot then walk(box.UIRoot, 0) end
  return out
end

local function overlay_restore_tabs(tabs)
  if not (tabs and G.OVERLAY_MENU and G.OVERLAY_MENU.get_UIE_by_ID) then return end
  for _, id in ipairs(tabs) do
    local btn = G.OVERLAY_MENU:get_UIE_by_ID(id)
    if btn and not btn.config.chosen and btn.UIBox and btn.config.ref_table then
      local group = btn.UIBox:get_group(nil, btn.config.group)
      pcall(function()
        G.FUNCS.change_tab(btn)
        for _, v in pairs(group) do if v.config and v.config.choice then v.config.chosen = false end end
        btn.config.chosen = true
      end)
    end
  end
end

local function overlay_track(box, fp)
  if not box or box == true then return end
  local _remove = box.remove
  box.remove = function(self, ...)
    if not self._overlay_gone_saved then
      self._overlay_gone_saved = true
      local ok, tabs = pcall(overlay_chosen_tabs, self)
      G.OVERLAY_MENU_GONE = {fp = fp, tabs = ok and tabs or {}, t = love.timer.getTime()}
    end
    return _remove(self, ...)
  end
end

OVERLAY_MENU_HELPERS = {fingerprint = overlay_fingerprint, same = overlay_same, chosen_tabs = overlay_chosen_tabs, restore_tabs = overlay_restore_tabs}

