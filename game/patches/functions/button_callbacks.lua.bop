function G.FUNCS.check_drag_target_active(e)
  local cfg, args = e.config, e.config.args
  local live = args.active_check(args.card)
  local changed = (live and not cfg.pulse_border) or (not live and cfg.pulse_border)
  if changed or not args.init then
    if live then
      cfg.pulse_border, cfg.colour, cfg.release_func = true, args.colour, args.release_func
      args.text_colour[4] = 1
    else
      cfg.pulse_border, cfg.colour, cfg.release_func = nil, adjust_alpha(G.C.L_BLACK, 0.9), nil
      args.text_colour[4] = 0.5
    end
  end
  args.init = true
end

