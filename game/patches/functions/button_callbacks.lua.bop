G.FUNCS.change_score_speed = function(args)
  local score_options = {1.0, 0.75, 0.5, 0.25, 0}
  G.SETTINGS.fast_score_resolve = score_options[args.to_key] or 1.0
  G:save_settings()
end

-- Filter type selection callback
G.FUNCS.change_filter_type = function(args)
  G.SETTINGS.GRAPHICS.filter_type = args.to_key
end

-- Apply filter button callback
G.FUNCS.apply_filter = function(e)
  -- Filter is applied in game.lua draw function based on G.SETTINGS.GRAPHICS.filter_type
  -- This just confirms the selection is saved
  G.SETTINGS.GRAPHICS.filter_applied = true
end

-- Reset filter button callback
G.FUNCS.reset_filter = function(e)
  G.SETTINGS.GRAPHICS.filter_type = 1
  G.SETTINGS.GRAPHICS.filter_intensity = 50
  G.SETTINGS.GRAPHICS.rainbow_speed = 50
  G.SETTINGS.GRAPHICS.filter_applied = false
end

-- Apply custom colors for chips and mult (button callback)
G.FUNCS.apply_custom_colors = function(e)
  -- In-place update: modify table contents rather than replacing the table,
  -- so existing UI nodes that hold a reference see the change immediately.
  local function ic(t,a,b,c) t[1]=a; t[2]=b; t[3]=c; t[4]=1 end
  -- Apply Blue color
  if G.SETTINGS.GRAPHICS.blue_r then
    local r = (G.SETTINGS.GRAPHICS.blue_r or 0) / 255
    local g = (G.SETTINGS.GRAPHICS.blue_g or 157) / 255
    local b = (G.SETTINGS.GRAPHICS.blue_b or 255) / 255
    ic(G.C.BLUE,     r, g, b)
    ic(G.C.CHIPS,    r, g, b)
    ic(G.C.UI_CHIPS, r, g, b)
  end
  -- Apply Red color
  if G.SETTINGS.GRAPHICS.red_r then
    local r = (G.SETTINGS.GRAPHICS.red_r or 254) / 255
    local g = (G.SETTINGS.GRAPHICS.red_g or 95) / 255
    local b = (G.SETTINGS.GRAPHICS.red_b or 85) / 255
    ic(G.C.RED,     r, g, b)
    ic(G.C.MULT,    r, g, b)
    ic(G.C.XMULT,   r, g, b)
    ic(G.C.UI_MULT, r, g, b)
  end
  -- Apply Green color
  if G.SETTINGS.GRAPHICS.green_r then
    local r = (G.SETTINGS.GRAPHICS.green_r or 75) / 255
    local g = (G.SETTINGS.GRAPHICS.green_g or 194) / 255
    local b = (G.SETTINGS.GRAPHICS.green_b or 146) / 255
    ic(G.C.GREEN,      r, g, b)
    ic(G.C.CHANCE,     r, g, b)
    ic(G.C.PALE_GREEN, r * 0.85, g * 0.85, b * 0.85)
  end
  -- Apply Yellow color (also affects GOLD, ORANGE, MONEY, IMPORTANT, FILTER)
  if G.SETTINGS.GRAPHICS.yellow_r then
    local r = (G.SETTINGS.GRAPHICS.yellow_r or 255) / 255
    local g = (G.SETTINGS.GRAPHICS.yellow_g or 255) / 255
    local b = (G.SETTINGS.GRAPHICS.yellow_b or 0) / 255
    ic(G.C.YELLOW, r, g, b)
    -- Derive GOLD as a slightly muted/warm version
    ic(G.C.GOLD, r * 0.92, g * 0.75, b * 0.35 + 0.1)
    -- Derive ORANGE as a warmer/saturated version
    ic(G.C.ORANGE, math.min(r, 1), g * 0.64, b * 0.05)
    -- Money follows gold-ish warmth
    ic(G.C.MONEY, r * 0.95, g * 0.73, b * 0.35 + 0.05)
    ic(G.C.IMPORTANT, math.min(r, 1), g * 0.6, b * 0.05)
    ic(G.C.FILTER,    math.min(r, 1), g * 0.6, b * 0.05)
  end
end

-- Reset colors to defaults (button callback)
G.FUNCS.reset_custom_colors = function(e)
  -- Default Blue: 009dff = 0, 157, 255
  G.SETTINGS.GRAPHICS.blue_r = 0
  G.SETTINGS.GRAPHICS.blue_g = 157
  G.SETTINGS.GRAPHICS.blue_b = 255
  -- Default Red: FE5F55 = 254, 95, 85
  G.SETTINGS.GRAPHICS.red_r = 254
  G.SETTINGS.GRAPHICS.red_g = 95
  G.SETTINGS.GRAPHICS.red_b = 85
  -- Default Green: 4BC292 = 75, 194, 146
  G.SETTINGS.GRAPHICS.green_r = 75
  G.SETTINGS.GRAPHICS.green_g = 194
  G.SETTINGS.GRAPHICS.green_b = 146
  -- Default Yellow: FFFF00 = 255, 255, 0
  G.SETTINGS.GRAPHICS.yellow_r = 255
  G.SETTINGS.GRAPHICS.yellow_g = 255
  G.SETTINGS.GRAPHICS.yellow_b = 0

  -- Apply the reset colors in-place (keeps existing UI references valid)
  local function ic(t,a,b,c) t[1]=a; t[2]=b; t[3]=c; t[4]=1 end
  local function ihex(t, hex) local _c = HEX(hex); t[1]=_c[1]; t[2]=_c[2]; t[3]=_c[3]; t[4]=_c[4] end
  ic(G.C.BLUE,      0, 157/255, 1)
  ic(G.C.CHIPS,     0, 157/255, 1)
  ic(G.C.UI_CHIPS,  0, 157/255, 1)
  ic(G.C.RED,       254/255, 95/255, 85/255)
  ic(G.C.MULT,      254/255, 95/255, 85/255)
  ic(G.C.XMULT,     254/255, 95/255, 85/255)
  ic(G.C.UI_MULT,   254/255, 95/255, 85/255)
  ic(G.C.GREEN,     75/255, 194/255, 146/255)
  ic(G.C.CHANCE,    75/255, 194/255, 146/255)
  ic(G.C.PALE_GREEN,86/255, 168/255, 135/255)
  ic(G.C.YELLOW,    1, 1, 0)
  ihex(G.C.GOLD,      'eac058')
  ihex(G.C.ORANGE,    'fda200')
  ihex(G.C.MONEY,     'f3b958')
  ihex(G.C.IMPORTANT, 'ff9a00')
  ihex(G.C.FILTER,    'ff9a00')
