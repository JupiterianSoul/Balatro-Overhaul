function create_UIBox_performance_settings()
  local _g = G.SETTINGS.GRAPHICS

  local res_options = {"100%", "75%", "50%"}
  local shader_options = {mod_loc("Off"), mod_loc("Low"), mod_loc("Full")}
  local filter_options = {mod_loc("Bilinear"), mod_loc("Nearest")}

  local left_col = {n=G.UIT.C, config={align = "tm", padding = 0.05, colour = G.C.CLEAR}, nodes={
    create_option_cycle({id = 'sc_perf_resolution', w = 4, scale = 0.8, label = mod_loc("Resolution Scale"), options = res_options, opt_callback = 'change_perf_resolution', current_option = _g.perf_resolution or 1}),
    create_option_cycle({id = 'sc_perf_shader', w = 4, scale = 0.8, label = mod_loc("Shader Quality"), options = shader_options, opt_callback = 'change_perf_shader_quality', current_option = _g.perf_shader_quality or 3}),
    create_toggle_group({
      {id = 'sc_perf_particles', label = mod_loc("Particle Effects"), ref_table = _g, ref_value = 'perf_particles', active_colour = G.C.GREEN, callback = G.FUNCS.toggle_perf_particles},
      {id = 'sc_perf_gc', label = mod_loc("GC Tuning"), ref_table = _g, ref_value = 'perf_gc_tuning', active_colour = G.C.BLUE, callback = G.FUNCS.toggle_perf_gc_tuning},
    }, {col = false, padding = 0.05}),
  }}
  local right_col = {n=G.UIT.C, config={align = "tm", padding = 0.05, colour = G.C.CLEAR}, nodes={
    create_option_cycle({id = 'sc_perf_filter', w = 4, scale = 0.8, label = mod_loc("Texture Filter"), options = filter_options, opt_callback = 'change_perf_texture_filter', current_option = _g.perf_texture_filter or 1}),
    create_toggle_group({
      {id = 'sc_perf_canvas', label = mod_loc("Canvas Caching"), ref_table = _g, ref_value = 'perf_canvas_caching', active_colour = G.C.BLUE, callback = G.FUNCS.toggle_perf_canvas_caching},
      {id = 'sc_perf_culling', label = mod_loc("Off-screen Culling"), ref_table = _g, ref_value = 'perf_offscreen_culling', active_colour = G.C.BLUE, callback = G.FUNCS.toggle_perf_offscreen_culling},
      {id = 'sc_perf_bg', label = mod_loc("Background Animations"), ref_table = _g, ref_value = 'perf_bg_anims', active_colour = G.C.GREEN, callback = G.FUNCS.toggle_perf_bg_anims},
      {id = 'sc_perf_heavy', label = mod_loc("Auto-Skip Heavy Scoring"), ref_table = G.SETTINGS, ref_value = 'perf_heavy_scoring', active_colour = G.C.ORANGE},
    }, {col = false, padding = 0.05}),
  }}

  return create_UIBox_generic_options({back_func = 'settings', contents = {
