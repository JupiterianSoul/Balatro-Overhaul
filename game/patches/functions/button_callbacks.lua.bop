G.FUNCS.shop_check_result = function(ok, e)
  if ok == nil then return e.config.button ~= nil end
  return ok and true or false
end

G.FUNCS.card_can_buy = function(_card)
  local e = {config = {ref_table = _card}}
  return G.FUNCS.shop_check_result(G.FUNCS.can_buy(e), e)
end

G.FUNCS.card_can_buy_and_use = function(_card)
  local e = {config = {ref_table = _card}}
  return G.FUNCS.shop_check_result(G.FUNCS.can_buy_and_use(e), e)
end

