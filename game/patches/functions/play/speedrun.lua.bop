l 251
    if type(v) == 'table' and v.forge then g.banned_keys[k] = true end
  end
end

function SR.note_replay(id)
  local d = SR.load()
  d.sprps = type(d.sprps) == 'table' and d.sprps or {}
  for _, v in ipairs(d.sprps) do if v == id then return end end
  d.sprps[#d.sprps + 1] = id
  while #d.sprps > 60 do table.remove(d.sprps, 1) end
  SR.save()
end

function SR.replay_is_speedrun()
  local SPR = rawget(_G, 'BO_SPREPLAY')
  local w = SPR and SPR.watching
  if not (w and w.id and SR.playing_back()) then return false end
  if w.sr then return true end
  for _, v in ipairs(SR.load().sprps or {}) do if v == w.id then return true end end
  return false
end

function SR.keep_replays()
  local d = SR.load()
  local out, best = {}, {}
  local pending = {}
  for _, id in ipairs(d.pending or {}) do pending[id] = true end
  for _, r in ipairs(d.runs or {}) do
    if r.sprp then
      local k = SR.key(r.cat, r.deck, r.stake, r.seed_type)
      if not best[k] or r.time < best[k].time then best[k] = r end
      if (r.id and pending[r.id]) or (r.online == 'sent' and (r.rp_up == nil or r.rp_up == 'sending')) then out[r.sprp] = true end
    end
  end
  for _, r in pairs(best) do out[r.sprp] = true end
  local list = d.sprps or {}
  for i = math.max(1, #list - SR.KEEP_ATTEMPTS + 1), #list do out[list[i]] = true end
  return out
end

function SR.watch(run)
  local W = rawget(_G, 'SpeedrunWatch')
  if W and W.begin then return W.begin(run and run.sprp) end
  local SPR = rawget(_G, 'BO_SPREPLAY')
  return SPR and run and run.sprp and SPR.watch(run.sprp) or false
end

function SR.clock()
  local g = G.GAME
  if not g or SR.playing_back() then return nil end
  if g.speedrun then return g.speedrun end
  if SR.timer_on() then
    if not g.sr_clock then g.sr_clock = {t = 0, splits = {}} end
    return g.sr_clock
  end
  return nil
end

local function in_run()
  return G.STAGES and G.STAGE == G.STAGES.RUN and G.GAME and G.GAME.round_resets and not G.GAME.multiplayer
end

function SR.hook_options()
  local cur = G.FUNCS and G.FUNCS.options
  if type(cur) ~= 'function' or cur == SR._opt_w then return end
  SR._opt_w = function(...)
    if in_run() then SR._opts = true end
    return cur(...)
  end
  G.FUNCS.options = SR._opt_w
end

function SR.options_open()
  if SR._opts and not G.OVERLAY_MENU then SR._opts = nil end
  return SR._opts == true
end

function SR.rec_ms()
  local R = rawget(_G, 'bom_replay')
  local REC = R and R._rec
  local g = G.GAME
  if not (REC and REC.on and REC.local_only and g and g.bo_sprp and REC.match_id == 'sp:' .. g.bo_sprp and REC.t0) then return nil end
  return math.floor((love.timer.getTime() - REC.t0) * 1000)
end

function SR.note_pause(c, paused)
  if c ~= G.GAME.speedrun then return end
  c.pauses = c.pauses or {}
  local last = c.pauses[#c.pauses]
  if paused and not (last and last.b == nil) then
    c.pauses[#c.pauses + 1] = {a = SR.rec_ms() or -1, at = c.t}
  elseif not paused and last and last.b == nil then
    last.b = SR.rec_ms() or -1
  end
end

function SR.tick(c)
  local now = love.timer.getTime()
  local live = not c.done and not c.failed
  local paused = live and SR.options_open()
  if live and paused ~= (c.paused == true) then
    c.paused = paused or nil
    SR.note_pause(c, paused)
  end
  if SR._last and SR._last_clock == c and live then
    local dt = math.max(0, now - SR._last)
    if paused then c.paused_t = (c.paused_t or 0) + dt else c.t = c.t + dt end
  end
  SR._last, SR._last_clock = now, c
end

function SR.update()
  SR.hook_options()
  local RS = rawget(_G, 'SpeedrunResults')
  if RS and RS.update then RS.update() end
  if not in_run() then
    SR._opts = nil
    SR._last, SR._last_clock = nil, nil
    SR.hud_remove()
    if not SR.pending and not (G.GAME and G.GAME.speedrun and G.STAGE == G.STAGES.RUN) then SR.finish_settings() end
    return
  end
  local c = SR.clock()
  if not c then
    SR._last, SR._last_clock = nil, nil
    local W = rawget(_G, 'SpeedrunWatch')
    local wc = SR.playing_back() and W and W.clock and W.clock() or nil
    if wc then return SR.hud_update(wc) end
    SR.hud_remove()
    return
  end
  SR.tick(c)
  if c == G.GAME.speedrun and not c.sprp and G.GAME.bo_sprp then
    c.sprp = G.GAME.bo_sprp
    SR.note_replay(c.sprp)
  end
  if not c.done and not c.failed then
    if G.STATE == G.STATES.GAME_OVER then c.failed = true end
    if c == G.GAME.speedrun and not c.broken then
      local FL = rawget(_G, 'FairLock')
      if FL and FL.enforce then pcall(FL.enforce) end
      SR.check_rules(c)
    end
  end
  SR.hud_update(c)
end

function SR.on_end_round()
  local g = G.GAME
  if not in_run() then return end
  local c = SR.clock()
  if not c or c.done or c.failed then return end
  c.discards = (c.discards or 0) + (tonumber(g.current_round and g.current_round.discards_used) or 0)
  local ok, won = pcall(function() return g.chips >= g.blind.chips end)
  if not (ok and won) then return end
  c.blinds = (c.blinds or 0) + 1
  if not (g.blind and g.blind.boss) then return end
  SR.tick(c)
  local a = g.round_resets.ante
  if c.splits[a] == nil then
    c.splits[a] = c.t
    c.blinds_at = c.blinds_at or {}
    c.hands_at = c.hands_at or {}
    c.blinds_at[a] = c.blinds
    c.hands_at[a] = tonumber(g.hands_played) or 0
  end
  if a >= (c.target or g.win_ante or 8) then
    c.done = true
    local RS = rawget(_G, 'SpeedrunResults')
    if RS then pcall(RS.snapshot, c) end
    if c == g.speedrun and not c.broken then
      SR.record(c)
      if RS then pcall(RS.arm, c) end
    end
    play_sound('timpani', 1, 0.6)
  end
end

function SR.record(c)
  local d = SR.load()
  local prev = SR.best(c.cat, c.deck, c.stake, c.seed_type)
  local splits = {}
  for k, v in pairs(c.splits or {}) do splits[k] = v end
  local blinds, hands = {}, {}
  for k, v in pairs(c.blinds_at or {}) do blinds[k] = v end
  for k, v in pairs(c.hands_at or {}) do hands[k] = v end
  local run = {id = c.id, cat = c.cat, deck = c.deck, stake = c.stake, seed_type = c.seed_type, seed = c.seed,
    time = c.t, splits = splits, blinds = blinds, hands = hands, date = os.time(), v = SR.VERSION,
    pauses = c.pauses and #c.pauses or nil, paused_t = c.paused_t, hands_n = c.hands_n, discards = c.discards, rerolls = c.rerolls, money = c.money}
  local SPR, buf = SR.sp_replay()
  if SPR then
    local cat = SR.cat(c.cat)
    run.rp = cat and SR.replay_digest(buf, cat.target, c.pauses) or nil
    if SPR.set_extra and cat then
      local sa, pa = {}, {}
      for a = 1, cat.target do
        sa[a] = tonumber(splits[a]) or -1
        pa[a] = c.pb_splits and tonumber(c.pb_splits[a]) or -1
      end
      local pz = {}
      for i, p in ipairs(c.pauses or {}) do pz[i] = {a = tonumber(p.a) or -1, b = tonumber(p.b) or -1} end
      SPR.set_extra('sr', {cat = c.cat, deck = c.deck, stake = c.stake, seed_type = c.seed_type, seed = c.seed, time = c.t,
        splits = sa, pb_splits = pa, pz = pz, paused_t = c.paused_t or 0})
    end
    if SPR.write_final and SPR.write_final() then
      run.sprp = G.GAME.bo_sprp
      if SPR.prune then pcall(SPR.prune) end
    end
  end
  d.runs[#d.runs + 1] = run
  if run.id then
    d.pending = type(d.pending) == 'table' and d.pending or {}
    d.pending[#d.pending + 1] = run.id
  end
  SR.save()
  if SR.flush then pcall(SR.flush) end
  c.pb = (not prev) or c.t < prev.time
  c.prev_best = prev and prev.time or nil
end

function SR.after_start(args, pending)
  local g = G.GAME
  if not g or g.multiplayer then return end
  if SR.replay_is_speedrun() then SR.ban_forge(g) end
  if args and args.savetext then
    if g.speedrun and not g.speedrun.done and not g.speedrun.failed then
      g.speedrun.broken = g.speedrun.broken or "Run was resumed"
    end
    return
  end
  if not pending then return end
  local cat = SR.cat(pending.cat) or SR.CATS[#SR.CATS]
  g.speedrun = {id = SR.new_id(), cat = cat.key, target = cat.target, deck = pending.deck, stake = pending.stake, seed_type = pending.seed_type,
    seed = g.pseudorandom and g.pseudorandom.seed or pending.seed, t = 0, splits = {}, v = SR.VERSION}
  local pb = SR.best(cat.key, pending.deck, pending.stake, pending.seed_type)
  if pb then g.speedrun.pb_splits = pb.splits end
  SR.force_settings()
  SR.ban_forge(g)
  local d = SR.load()
  local key = SR.key(cat.key, pending.deck, pending.stake, pending.seed_type)
  d.attempts[key] = (d.attempts[key] or 0) + 1
  SR.save()
end

