local _sr_end_round = end_round
function end_round(...)
  local ok, err = pcall(SR.on_end_round)
  if not ok then print("[Speedrun] end_round: " .. tostring(err)) end
  return _sr_end_round(...)
end

SR.HUD_W = 2.5
SR.HUD_Y = 0.36

function SR.hud_def()
  local t = touch()
  local w = t and SR.HUD_W + 0.3 or SR.HUD_W
  local en = G.LANGUAGES and G.LANGUAGES['en-us']
  return {n = G.UIT.ROOT, config = {align = 'cm', colour = G.C.CLEAR, padding = 0}, nodes = {
    {n = G.UIT.C, config = {id = 'sr_hud_box', align = 'cm', padding = 0.05, minw = w, colour = G.C.DYN_UI.BOSS_MAIN, emboss = 0.05, r = 0.1}, nodes = {
      {n = G.UIT.R, config = {align = 'cm', r = 0.1, minw = w - 0.1, minh = t and 0.62 or 0.56, colour = G.C.DYN_UI.BOSS_DARK}, nodes = {
        {n = G.UIT.T, config = {ref_table = SR.view, ref_value = 'time', scale = t and 0.62 or 0.56, colour = SR.view.col, shadow = true, lang = en}},
      }},
      {n = G.UIT.R, config = {align = 'cm', minh = t and 0.36 or 0.32, maxw = w - 0.1}, nodes = {
        {n = G.UIT.T, config = {ref_table = SR.view, ref_value = 'line', scale = t and 0.34 or 0.3, colour = SR.view.line_col, shadow = true}},
      }},
    }},
  }}
end

function SR.hud_remove()
  if SR.hud then
    if not SR.hud.REMOVED then SR.hud:remove() end
    SR.hud = nil
  end
  SR.hud_split = nil
end

function SR.last_split(c)
  local last
  for a in pairs(c.splits or {}) do if type(a) == 'number' and (not last or a > last) then last = a end end
  return last
end

function SR.hud_text(c)
  local g = G.GAME
  local v = SR.view
  v.time = fmt(c.t)
  local col, line, lcol = G.C.GOLD, '', G.C.UI.TEXT_LIGHT
  local speedrun = c == g.speedrun or c.watch
  if speedrun then
    local cat = SR.cat(c.cat)
    line = cat and (L("Goal") .. ": " .. L(cat.label)) or ''
  else
    line = L("Run time")
  end
  local last = SR.last_split(c)
  if last then
    line = localize('k_ante') .. " " .. last .. "  " .. fmt(c.splits[last])
    local pb = c.pb_splits and c.pb_splits[last]
    if pb then
      local d = c.splits[last] - pb
      line = line .. "  " .. delta(d)
      lcol = d <= 0 and G.C.GREEN or G.C.RED
    end
  end
  if c.paused and not c.done and not c.failed and not c.broken then
    line, lcol = L("Paused"), G.C.UI.TEXT_LIGHT
  end
  if speedrun and c.broken then
    col, line, lcol = G.C.UI.TEXT_INACTIVE, L("Not timed") .. ": " .. L(c.broken), G.C.RED
  elseif c.done then
    col = G.C.GREEN
    if speedrun and c.pb then line, lcol = L("New personal best!"), G.C.GOLD end
  elseif c.failed then
    col = G.C.UI.TEXT_INACTIVE
  end
  v.line = line
  set_col(v.col, col)
  set_col(v.line_col, lcol)
end

function SR.hud_juice()
  local e = SR.hud and SR.hud.get_UIE_by_ID and SR.hud:get_UIE_by_ID('sr_hud_box')
  if e and e.juice_up then e:juice_up(0.3, 0.3) end
end

function SR.hud_update(c)
  SR.hud_text(c)
  if SR.hud and SR.hud.REMOVED then SR.hud = nil end
  if not SR.hud and G.consumeables then
    SR.hud = UIBox{definition = SR.hud_def(), config = {align = 'bm', offset = {x = 0, y = SR.HUD_Y}, major = G.consumeables, bond = 'Weak'}}
    SR.hud_split = SR.last_split(c) or 0
  end
  if SR.hud and G.consumeables then
    local A, H = G.consumeables.T, SR.hud.T
    local P = c.watch and G.PB_BAR and not G.PB_BAR.REMOVED and G.PB_BAR.T
    local x, y
    if P then
      x = P.x + P.w / 2 - A.x - A.w / 2
      y = P.y + P.h + 0.12 - A.y - A.h
    else
      local right = A.x + A.w
      local b = G.MOD_FLOATING_BUTTON
      if b and b.T and not b.REMOVED then
        local top = A.y + A.h + SR.HUD_Y
        if b.T.y < top + H.h and b.T.y + b.T.h > top and b.T.x < right and b.T.x + b.T.w / 2 > right - H.w / 2 then right = b.T.x - 0.1 end
      end
      x, y = right - A.x - H.w / 2 - A.w / 2, SR.HUD_Y
    end
    local o = SR.hud.alignment and SR.hud.alignment.offset
    if o and (math.abs((o.x or 0) - x) > 0.01 or math.abs((o.y or 0) - y) > 0.01) then SR.hud:set_alignment({offset = {x = x, y = y}}) end
  end
  local last = SR.last_split(c) or 0
  if SR.hud and last ~= SR.hud_split then
    SR.hud_split = last
    SR.hud_juice()
  end
end

local function swap(id, def)
  local e = G.OVERLAY_MENU and G.OVERLAY_MENU:get_UIE_by_ID(id)
r 4 1300 %20%20 -
l 164
  if e.config.object then e.config.object:remove() end
  e.config.object = UIBox{definition = def, config = {offset = {x = 0, y = 0}, parent = e, type = 'cm'}}
  e.UIBox:recalculate()
end

function SR.tab_def()
  local cfg = SR.get_cfg()
  local t = touch()
  local cw = t and 6.2 or 5.8
  local decks = SR.decks()
  local deck_names, deck_i = {}, 1
  for i, d in ipairs(decks) do
    deck_names[i] = deck_name(d.key)
    if d.key == cfg.deck then deck_i = i end
  end
  local stakes = {}
  for i = 1, SR.max_stake(cfg.deck) do stakes[i] = stake_name(i) end
  local cat_names, cat_i = {}, 1
  for i, c in ipairs(SR.CATS) do
    cat_names[i] = L(c.label)
    if c.key == cfg.cat then cat_i = i end
  end
  local cat = SR.CATS[cat_i]
  local weekly = cfg.seed == 'weekly'
  local function changed() SR.refresh_tab() end
  local left = {
    UIK.cycle{id = 'sr_goal', label = L("Goal"), info = cat.target >= 8 and L("Win the run: beat the ante 8 boss") or (L("Beat the boss of ante") .. " " .. cat.target),
      options = cat_names, current = cat_i, w = cw, callback = function(i) cfg.cat = SR.CATS[i].key changed() end},
    UIK.cycle{id = 'sr_deck', label = localize('k_deck'), options = deck_names, current = deck_i, w = cw,
      callback = function(i) cfg.deck = decks[i].key changed() end},
    UIK.cycle{id = 'sr_stake', label = localize('k_stake'), options = stakes, current = cfg.stake, w = cw,
      callback = function(i) cfg.stake = i changed() end},
    UIK.cycle{id = 'sr_seed', label = L("Seed"), info = weekly and (L("Same seed for everyone this week") .. ": " .. SR.week_seed()) or L("A new seed every run"),
      options = {L("Random seed"), L("Weekly seed")}, current = weekly and 2 or 1, w = cw, callback = function(i) cfg.seed = i == 2 and 'weekly' or 'random' changed() end},
  }
  if not t then table.insert(left, 1, UIK.header(L("Category"), {w = cw})) end
  local pb = SR.best(cat.key, cfg.deck, cfg.stake, cfg.seed)
  local tries = SR.load().attempts[SR.key(cat.key, cfg.deck, cfg.stake, cfg.seed)] or 0
  local right = {
    UIK.section(L("Rules"), {UIK.note(SR.rule_lines(), {w = cw - 0.3})}, {w = cw}),
    UIK.value{id = 'sr_pb', label = L("Personal best"), value = pb and fmt(pb.time) or L("No time yet"), colour = pb and G.C.GOLD or UIK.C.muted,
      info = L("Attempts") .. ": " .. tries, w = cw},
  }
  local blocked = SR.blocked()
  local col = function(nodes)
    return {n = G.UIT.C, config = {align = 'tm', minw = cw, padding = 0}, nodes = (function()
      local out = {}
      for _, n in ipairs(nodes) do out[#out + 1] = {n = G.UIT.R, config = {align = 'cm', padding = 0.03}, nodes = {n}} end
      return out
    end)()}
  end
  return {n = G.UIT.ROOT, config = {align = 'cm', colour = G.C.CLEAR, padding = 0}, nodes = {
    {n = G.UIT.R, config = {align = 'tm', padding = 0}, nodes = {col(left), {n = G.UIT.C, config = {minw = 0.3}}, col(right)}},
    {n = G.UIT.R, config = {align = 'cm', minh = t and (blocked and 0.4 or 0.12) or 0.34, padding = 0}, nodes = {
      UIK.text(blocked and (L("Speedruns are off") .. ": " .. blocked) or '', {scale = t and 0.32 or 0.3, colour = G.C.RED}),
    }},
    UIK.button_bar({
      UIK.button{label = L("START SPEEDRUN"), button = 'speedrun_start', colour = UIK.C.ok, disabled = blocked ~= nil, id = 'sr_start', w = t and 4.4 or 4},
    }),
  }}
end

function SR.refresh_tab()
  pcall(function() G:save_settings() end)
  swap('play_speedrun_body', SR.tab_def())
end

G.UIDEF.speedrun_tab = function()
  return {n = G.UIT.ROOT, config = {align = 'cm', colour = G.C.CLEAR, padding = 0.1, minh = 6.4, minw = 12.4}, nodes = {
    {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {
      {n = G.UIT.O, config = {id = 'play_speedrun_body', object = UIBox{definition = SR.tab_def(), config = {offset = {x = 0, y = 0}}}}},
    }},
  }}
end

G.FUNCS.speedrun_start = function()
  SR.start(SR.get_cfg())
end

function SR.settings_rows(items)
  local S = G.SETTINGS
  local row = UIK.toggle{id = 'set_speedrun_timer', label = L("Speedrun timer"), info = L("A timer and ante splits in solo runs"), ref_table = S, ref_value = 'speedrun_timer',
    callback = function() pcall(function() G:save_settings() end) end}
  local run_h = mod_loc("Run")
  local in_run_section = false
  for i, n in ipairs(items) do
    if n.uik_header then
      if in_run_section then
        table.insert(items, i, row)
        return
      end
      in_run_section = n.uik_title == run_h
    end
  end
  items[#items + 1] = row
end

