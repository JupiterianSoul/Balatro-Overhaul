Speedrun = Speedrun or {}
local SR = Speedrun

do
  local ok, err = pcall(require, "functions/fair_lock")
  if not ok then print("[Speedrun] fair_lock: " .. tostring(err)) end
end

SR.VERSION = 1
SR.SPEED = 4
SR.FILE = 'speedruns.jkr'
SR.KEEP_ATTEMPTS = 20
SR.DECKS = {'b_red', 'b_blue', 'b_yellow', 'b_green', 'b_black', 'b_magic', 'b_nebula', 'b_ghost', 'b_abandoned',
  'b_checkered', 'b_zodiac', 'b_painted', 'b_anaglyph', 'b_plasma', 'b_erratic'}
SR.CATS = {
  {key = 'ante2', label = "Ante 2", target = 2},
  {key = 'ante4', label = "Ante 4", target = 4},
  {key = 'any', label = "Any%", target = 8},
}
SR.SEEDS = {{key = 'random', label = "Random seed"}, {key = 'weekly', label = "Weekly seed"}}
SR.FORCED = {GAMESPEED = 4, fast_score_resolve = 1.0, skip_score_animation = false,
  hand_optimizer = false, score_preview_enabled = false, joker_display = false, qol_fast_packs = false}
SR.view = SR.view or {time = '0:00.0', line = '', col = {1, 1, 1, 1}, line_col = {1, 1, 1, 1}}

local function L(s) return mod_loc(s) end
local function touch() return UIK.touch() end

local function fmt(t)
  t = math.max(0, tonumber(t) or 0)
  local h = math.floor(t / 3600)
  local m = math.floor((t % 3600) / 60)
  local s = t % 60
  if h > 0 then return string.format("%d:%02d:%04.1f", h, m, s) end
  return string.format("%d:%04.1f", m, s)
end
SR.fmt = fmt

local function delta(d)
  if math.abs(d) < 0.05 then return "0.0" end
  return (d < 0 and "-" or "+") .. fmt(math.abs(d))
end

local function set_col(dst, src)
  dst[1], dst[2], dst[3], dst[4] = src[1], src[2], src[3], src[4] or 1
end

function SR.timer_on()
  return G.SETTINGS and G.SETTINGS.speedrun_timer == true
end

function SR.cat(key)
  for i, c in ipairs(SR.CATS) do if c.key == key then return c, i end end
end

function SR.week_id(t)
  local days = math.floor((t or os.time()) / 86400)
  return math.floor((days + 3) / 7)
end

function SR.week_seed(w)
  local chars = "123456789ABCDEFGHIJKLMNPQRSTUVWXYZ"
  local x = ((w or SR.week_id()) * 7919 + 104729) % 2147483647
  local out = {}
  for i = 1, 8 do
    x = (x * 48271) % 2147483647
    local k = x % #chars + 1
    out[i] = chars:sub(k, k)
  end
  return table.concat(out)
end

function SR.decks()
  local out = {}
  for _, k in ipairs(SR.DECKS) do
    local c = G.P_CENTERS[k]
    if c and c.unlocked then out[#out + 1] = c end
  end
  if #out == 0 and G.P_CENTERS.b_red then out[1] = G.P_CENTERS.b_red end
  return out
end

function SR.max_stake(key)
  if PlayRandom and PlayRandom.max_stake then return PlayRandom.max_stake(key) end
  return 1
end

function SR.get_cfg()
  local S = G.SETTINGS
  S.speedrun_cfg = type(S.speedrun_cfg) == 'table' and S.speedrun_cfg or {}
  local c = S.speedrun_cfg
  if not SR.cat(c.cat) then c.cat = 'any' end
  local ok = false
  for _, d in ipairs(SR.decks()) do if d.key == c.deck then ok = true end end
  if not ok then c.deck = SR.decks()[1].key end
  c.stake = math.max(1, math.min(tonumber(c.stake) or 1, SR.max_stake(c.deck)))
  if c.seed ~= 'weekly' then c.seed = 'random' end
  return c
end

local function deck_name(key)
  local ok, n = pcall(localize, {type = 'name_text', set = 'Back', key = key})
  if ok and type(n) == 'string' and n ~= '' and n ~= 'ERROR' then return n end
  return G.P_CENTERS[key] and G.P_CENTERS[key].name or key
end

local function stake_name(i)
  local c = G.P_CENTER_POOLS.Stake[i]
  if not c then return tostring(i) end
  local ok, n = pcall(localize, {type = 'name_text', set = 'Stake', key = c.key})
  if ok and type(n) == 'string' and n ~= '' and n ~= 'ERROR' then return n end
  return c.name or c.key
end
SR.deck_name, SR.stake_name = deck_name, stake_name

local function data_path()
  return tostring(G.SETTINGS.profile or 1) .. '/' .. SR.FILE
end

function SR.load()
  local prof = G.SETTINGS.profile
  if SR._data and SR._data_profile == prof then return SR._data end
  local d
  pcall(function()
    local raw = get_compressed(data_path())
    if raw then d = STR_UNPACK(raw) end
  end)
  if type(d) ~= 'table' then d = {} end
  d.runs = type(d.runs) == 'table' and d.runs or {}
  d.attempts = type(d.attempts) == 'table' and d.attempts or {}
  SR._data, SR._data_profile = d, prof
  return d
end

function SR.save()
  local d = SR.load()
  local ok, err = pcall(compress_and_save, data_path(), d)
  if not ok then print("[Speedrun] save: " .. tostring(err)) end
end

function SR.new_id()
  local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
  local out = {}
  for i = 1, 16 do
    local k = math.random(#chars)
    out[i] = chars:sub(k, k)
  end
  return table.concat(out)
end

function SR.key(cat, deck, stake, seed)
  return table.concat({tostring(cat), tostring(deck), tostring(stake), tostring(seed)}, '|')
end

function SR.best(cat, deck, stake, seed)
  local best
  for _, r in ipairs(SR.load().runs) do
    if r.cat == cat and r.deck == deck and r.stake == stake and r.seed_type == seed and (not best or r.time < best.time) then best = r end
  end
  return best
end

function SR.blocked()
  if MODLOADER and MODLOADER.modded then return L("Mods are on") end
  if DebugManager and DebugManager.is_enabled and DebugManager.is_enabled() then return L("Debug mode is on") end
  if G.GAME and G.GAME.multiplayer then return L("Not in multiplayer") end
  return nil
end

function SR.rule_lines()
  return {
    L("Game speed 4x, score speed 100%"),
    L("No Hand Optimizer or Score Preview"),
    L("No fast packs"),
    L("No mods, Debug, Forge jokers or boosters"),
    L("No custom rules or challenges"),
    L("The timer stops while Options is open"),
    L("Leaving the run ends the attempt"),
    L("Breaking a rule stops the timing"),
  }
end

function SR.force_settings()
  local S = G.SETTINGS
  if not S.sr_saved then
    local saved = {}
    for k in pairs(SR.FORCED) do
      if S[k] == nil then saved[k] = 'nil' else saved[k] = S[k] end
    end
    S.sr_saved = saved
  end
  for k, v in pairs(SR.FORCED) do S[k] = v end
  pcall(function() G:save_settings() end)
end

function SR.finish_settings()
  local S = G.SETTINGS
  local saved = S and S.sr_saved
  if not saved then return end
  S.sr_saved = nil
  for k, v in pairs(saved) do
    if S[k] == SR.FORCED[k] then
      if v == 'nil' then S[k] = nil else S[k] = v end
    end
  end
  pcall(function() G:save_settings() end)
end

function SR.break_run(c, reason)
  if c.broken or c.done then return end
  c.broken = reason
  play_sound('cancel', 0.8, 0.6)
end

function SR.check_rules(c)
  local S, g = G.SETTINGS, G.GAME
  local reason
  if (tonumber(S.GAMESPEED) or 1) ~= SR.SPEED then reason = "Game speed changed"
  elseif (tonumber(S.fast_score_resolve) or 1) ~= 1 then reason = "Score speed changed"
  elseif S.skip_score_animation then reason = "Score animation skipped"
  elseif S.hand_optimizer ~= false then reason = "Hand Optimizer turned on"
  elseif S.score_preview_enabled ~= false then reason = "Score Preview turned on"
  elseif S.qol_fast_packs then reason = "Fast packs turned on"
  elseif g.modded_run then reason = "Cheats used"
  elseif MODLOADER and MODLOADER.modded then reason = "Mods are on"
  elseif DebugManager and DebugManager.is_enabled and DebugManager.is_enabled() then reason = "Debug mode is on"
  elseif g.challenge then reason = "Challenge run"
  elseif type(g.run_rules) == 'table' and next(g.run_rules) then reason = "Custom rules"
  end
  if reason then SR.break_run(c, reason) end
end

function SR.playing_back()
  local P = rawget(_G, 'bom_playback')
  return P and P.active and P.active() and true or false
end

function SR.sp_replay()
  local SPR = rawget(_G, 'BO_SPREPLAY')
  local g = G.GAME
  if not (SPR and g and g.bo_sprp and SPR.cur and SPR.cur.id == g.bo_sprp and not SPR.cur.off) then return nil end
  local R = rawget(_G, 'bom_replay')
  local REC = R and R._rec
  if not (REC and REC.local_only and REC.match_id == 'sp:' .. g.bo_sprp and REC.batch and REC.batch.buf) then return nil end
  return SPR, REC.batch.buf
end

function SR.paused_before(pauses, t)
  local out = 0
  for _, p in ipairs(pauses or {}) do
    local a, b = tonumber(p.a), tonumber(p.b)
    if a and a >= 0 and a < t then out = out + (math.min(b and b >= a and b or t, t) - a) end
  end
  return out
end

function SR.replay_digest(entries, target, pauses)
  local R = rawget(_G, 'bom_replay')
  local kinds = R and R.ACTION_KINDS or {}
  local ante, n = 0, 0
  local pl, bs, fb, lp = {}, {}, {}, {}
  for _, e in ipairs(entries or {}) do
    if type(e) == 'table' then
      if (e.k == 'bs' or e.k == 'sk') and tonumber(e.a) then ante = tonumber(e.a) end
      local t = tonumber(e.t)
      if t and pauses then t = t - SR.paused_before(pauses, t) end
      if ante >= 1 and ante <= target and t then
        if kinds[e.k] then n = n + 1 end
        if e.k == 'bs' then
          bs[ante] = (bs[ante] or 0) + 1
          if not fb[ante] then fb[ante] = t end
        elseif e.k == 'pl' then
          pl[ante] = (pl[ante] or 0) + 1
          lp[ante] = t
        end
      end
    end
  end
  local out = {n = n, pl = {}, bs = {}, fb = {}, lp = {}}
  for a = 1, target do
    if not (fb[a] and lp[a]) then return nil end
    out.pl[a], out.bs[a] = pl[a] or 0, bs[a] or 0
    out.fb[a], out.lp[a] = math.floor(fb[a] / 10 + 0.5) / 100, math.floor(lp[a] / 10 + 0.5) / 100
  end
  return out
end

function SR.ban_forge(g)
  g.banned_keys = g.banned_keys or {}
