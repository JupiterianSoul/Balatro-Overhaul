G.FUNCS.sr_res_again = function()
  local c = RS.shown or RS.cur
  RS.shown = nil
  if not c then return end
  SR.start({cat = c.cat, deck = c.deck, stake = c.stake, seed = c.seed_type})
end

G.FUNCS.sr_res_watch = function()
  local run = RS.run_of(RS.shown or RS.cur)
  local SPR = rawget(_G, 'BO_SPREPLAY')
  if not (run and run.sprp and SPR and SPR.exists(run.sprp)) then return end
  RS.shown = nil
r 13 1375 %20%20 -
l 5
  if SR.watch then SR.watch(run) else SPR.watch(run.sprp) end
end

G.FUNCS.sr_res_menu = function()
  RS.shown = nil
