PlayRandom = PlayRandom or {}
local PR = PlayRandom

PR.state = PR.state or {stake = 1, rules = {}, roll_id = 0, deck_name = '', stake_name = ''}
PR.QUEUE = 'play_random'

local function L(s) return mod_loc(s) end
local function touch() return UIK.touch() end
local function pick(list) return list[math.random(#list)] end

