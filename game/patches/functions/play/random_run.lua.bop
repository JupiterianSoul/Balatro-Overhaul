  rarity_uncommon = {'rarity_rare'},
  price_pct = {'random_prices'},
}

PR.ROLL = {boon = {1, 3}, twist = {1, 2}, neutral = {0, 1}}
PR.MAX_RULES = 6

function PR.ban_candidates(pool)
  local out = {}
  if pool == 'Blind' then
    for k, v in pairs(G.P_BLINDS or {}) do
      if type(v) == 'table' and v.boss and not v.boss.showdown then out[#out + 1] = k end
    end
  else
    for _, v in ipairs((G.P_CENTER_POOLS and G.P_CENTER_POOLS[pool]) or {}) do
      if type(v) == 'table' and v.key then out[#out + 1] = v.key end
    end
  end
  table.sort(out)
  return out
end

function PR.ban_list(pool, n)
  local cands = PR.ban_candidates(pool)
  local out = {}
  n = math.min(n, #cands - 1)
  for _ = 1, n do
    local i = math.random(#cands)
    out[#out + 1] = table.remove(cands, i)
  end
  return out
end

function PR.roll_value(e)
  local v = pick(e[2])
  if e[4] == 'ban' then
    local d = RunRules.by_key[e[1]]
    local list = PR.ban_list(d and d.pool or '', v)
    if #list == 0 then return nil end
    return list
  end
  return v
end

function PR.clashes(a, b)
  for _, k in ipairs(PR.CLASH[a] or {}) do if k == b then return true end end
  for _, k in ipairs(PR.CLASH[b] or {}) do if k == a then return true end end
  return false
end

PR.TONE = {
  boon = function() return G.C.GREEN end,
  twist = function() return G.C.RED end,
  neutral = function() return G.C.BLUE end,
}

local function profile()
  return (G.PROFILES and G.SETTINGS and G.PROFILES[G.SETTINGS.profile]) or {}
end

function PR.decks()
  local out = {}
  for _, v in ipairs((G.P_CENTER_POOLS and G.P_CENTER_POOLS.Back) or {}) do
    if v.unlocked and not v.omit and v.key and G.P_CENTERS[v.key] then out[#out + 1] = v end
  end
  if #out == 0 and G.P_CENTERS.b_red then out[1] = G.P_CENTERS.b_red end
  return out
end

function PR.max_stake(key)
  local n = math.min(12, #((G.P_CENTER_POOLS and G.P_CENTER_POOLS.Stake) or {}))
  if n < 1 then return 1 end
  local p = profile()
  local m = (get_deck_win_stake(key) or 0) + 1
  if p.all_unlocked or p.debug_unlocked then m = n end
  return math.max(1, math.min(m, n))
end

function PR.pick_run()
  local decks = PR.decks()
  local s = PR.state
  local deck, stake
  for _ = 1, 8 do
    deck = pick(decks)
    stake = math.random(PR.max_stake(deck.key))
    if not (deck.key == s.deck and stake == s.stake) then break end
  end
  return deck.key, stake
end

function PR.roll_rules()
  if not (RunRules and RunRules.by_key) then return {} end
  local groups = {boon = {}, twist = {}, neutral = {}}
  for _, e in ipairs(PR.POOL) do
    if RunRules.by_key[e[1]] then table.insert(groups[e[3]], e) end
  end
  local want = {}
  for tone, r in pairs(PR.ROLL) do want[tone] = math.random(r[1], r[2]) end
  local used, out = {}, {}
  local function free(k)
    if used[k] then return false end
    for u in pairs(used) do if PR.clashes(k, u) then return false end end
    return true
  end
  for _, tone in ipairs({'boon', 'twist', 'neutral'}) do
    local list, n = groups[tone], 0
    for _ = 1, 60 do
      if n >= want[tone] or #list == 0 or #out >= PR.MAX_RULES then break end
      local e = pick(list)
      local v
      if free(e[1]) then v = PR.roll_value(e) end
      if v ~= nil then
        used[e[1]] = true
        n = n + 1
        out[#out + 1] = {key = e[1], value = v, tone = tone}
        local c = PR.COMPANION[e[1]]
        if c and not used[c[1]] and RunRules.by_key[c[1]] and #out < PR.MAX_RULES then
          used[c[1]] = true
          out[#out + 1] = {key = c[1], value = pick(c[2]), tone = tone}
        end
      end
    end
  end
  local order = {}
  for i, d in ipairs(RunRules.registry) do order[d.key] = i end
  table.sort(out, function(a, b) return (order[a.key] or 0) < (order[b.key] or 0) end)
  return out
end

function PR.values()
  local s = PR.state
  local v = {back = s.deck, stake = s.stake}
  for _, r in ipairs(s.rules or {}) do v[r.key] = r.value end
  return v
end

local function deck_name(key)
  local c = G.P_CENTERS[key]
  if not c then return '' end
  local ok, n = pcall(localize, {type = 'name_text', set = 'Back', key = key})
  if ok and type(n) == 'string' and n ~= '' and n ~= 'ERROR' then return n end
  return c.name or key
end

local function stake_name(i)
  local c = G.P_CENTER_POOLS.Stake[i]
  if not c then return '' end
  local ok, n = pcall(localize, {type = 'name_text', set = 'Stake', key = c.key})
  if ok and type(n) == 'string' and n ~= '' and n ~= 'ERROR' then return n end
  return c.name or c.key
end

local function back_atlas(c)
  return (c and c.atlas and G.ASSET_ATLAS[c.atlas]) or G.ASSET_ATLAS["centers"]
end

local function set_card_deck(card, key)
  local c = G.P_CENTERS[key]
  local spr = card and card.children and card.children.back
  if not (c and spr) then return end
  spr.atlas = back_atlas(c)
  spr:set_sprite_pos(c.pos)
  card.sticker = get_deck_win_sticker and get_deck_win_sticker(c) or nil
end

local function set_chip(chip, i)
  local c = G.P_CENTER_POOLS.Stake[i]
  if chip and c then chip:set_sprite_pos(c.pos) end
end

local function mode()
  return UIK._last_tab.play_random == 'custom' and 'custom' or 'plain'
end

local function sizes()
  local custom = mode() == 'custom'
  local t = touch()
  local pw = UIK.portrait() and UIK.W or nil
  return {
    deck_w = pw or (custom and 4.7 or 5.6),
    stake_w = pw or (custom and 4.7 or 5.6),
    rules_w = pw or 5.2,
    h = 6.35,
    vis_h = 2.95,
    name_h = t and 0.62 or 0.56,
    name_scale = t and 0.5 or 0.46,
    desc_h = 1.8,
  }
end

local function name_row(ref_value, w, z)
  return {n = G.UIT.R, config = {align = 'cm', minw = w, maxw = w, minh = z.name_h, padding = 0}, nodes = {
    {n = G.UIT.T, config = {ref_table = PR.state, ref_value = ref_value, scale = z.name_scale, colour = G.C.WHITE, shadow = true}},
  }}
end

local function desc_def(nodes, w, z)
  return {n = G.UIT.ROOT, config = {align = 'cm', colour = G.C.CLEAR, padding = 0}, nodes = {
    {n = G.UIT.R, config = {align = 'cm', minw = w, maxw = w, minh = z.desc_h, r = 0.1, padding = 0.05, colour = G.C.WHITE}, nodes = nodes},
  }}
end

local function deck_desc(w, z)
  local s = PR.state
  local nodes = {}
  if not s.rolling and s.deck and G.P_CENTERS[s.deck] then
    local back = Back(G.P_CENTERS[s.deck])
    nodes[1] = {n = G.UIT.O, config = {object = UIBox{definition = back:generate_UI(nil, 0.85, 0.6), config = {offset = {x = 0, y = 0}}}}}
  end
  return desc_def(nodes, w, z)
end

local function stake_desc(w, z)
  local s = PR.state
  local nodes = {}
  local c = G.P_CENTER_POOLS.Stake[s.stake or 1]
  if not s.rolling and c then
    local loc = {}
    pcall(localize, {type = 'descriptions', key = c.key, set = c.set, nodes = loc})
    for _, v in ipairs(loc) do
      nodes[#nodes + 1] = {n = G.UIT.R, config = {align = 'cm', maxw = w - 0.2}, nodes = v}
    end
  end
  return desc_def(nodes, w, z)
end

local function rules_def(w, z)
  local s = PR.state
  local rw = w
  local rh = touch() and 0.7 or 0.62
  local sc = touch() and 0.38 or 0.35
  local rows = {}
  local list = s.rules or {}
  for i = 1, PR.MAX_RULES do
    local r = list[i]
    local label, value, col = '', '', UIK.C.muted
    if r and not s.rolling then
      local d = RunRules and RunRules.by_key[r.key]
      label = d and L(d.label) or r.key
      value = RunRules and RunRules.value_label(r.key, r.value) or tostring(r.value)
      col = (PR.TONE[r.tone] or PR.TONE.neutral)()
    elseif r then
      label = '?'
    end
    local filled = label ~= ''
    rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cm', padding = 0.04}, nodes = {
      {n = G.UIT.R, config = {align = 'cm', minw = rw, minh = rh, r = 0.1, colour = filled and {0, 0, 0, 0.22} or G.C.CLEAR, padding = 0}, nodes = {
        {n = G.UIT.C, config = {align = 'cl', minw = rw - 1.55, maxw = rw - 1.55, padding = 0.08}, nodes = {
          {n = G.UIT.T, config = {text = label, scale = sc, colour = r and not s.rolling and G.C.WHITE or UIK.C.muted, shadow = true}},
        }},
        {n = G.UIT.C, config = {align = 'cr', minw = 1.45, maxw = 1.45, padding = 0.08}, nodes = {
          {n = G.UIT.T, config = {text = value, scale = sc, colour = col, shadow = true}},
        }},
      }},
    }}
  end
  return {n = G.UIT.ROOT, config = {align = 'tm', colour = G.C.CLEAR, padding = 0.04}, nodes = rows}
end

local function slot_obj(id, def)
  return {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {
    {n = G.UIT.O, config = {id = id, object = UIBox{definition = def, config = {offset = {x = 0, y = 0}}}}},
  }}
end

local function panel(title, w, z, nodes)
  local inner = w - 2 * UIK.PAD
  local list = {UIK.header(title, {w = inner})}
  for _, n in ipairs(nodes) do list[#list + 1] = n end
  return {n = G.UIT.C, config = {align = 'tm', minw = w, maxw = w, minh = z.h, r = 0.12, padding = UIK.PAD, colour = UIK.C.section}, nodes = list}
end

local function deck_panel(z)
  local s = PR.state
  local w = z.deck_w
  local inner = w - 2 * UIK.PAD
  local cw, ch = G.CARD_W, G.CARD_H
  local area = CardArea(G.ROOM.T.x, G.ROOM.T.y, cw, ch, {card_limit = 1, type = 'title', highlight_limit = 0})
  local c = G.P_CENTERS[s.shown_deck or s.deck] or G.P_CENTERS.b_red
  local card = Card(area.T.x, area.T.y, cw, ch, nil, G.P_CENTERS.c_base, {bypass_back = c.pos})
