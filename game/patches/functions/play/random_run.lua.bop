PR.COMPANION = {
  number_randomizer = {'random_chaos', {20, 80, 100}},
}

PR.CLASH = {
  no_bosses = {'boss_extra', 'showdown_bosses'},
  endless = {'win_ante'},
  all_eternal = {'eternal_stickers'},
  shop_jokers = {'eternal_stickers', 'perishable_stickers', 'rental_stickers', 'rarity_common', 'rarity_uncommon', 'rarity_rare', 'edition_rate'},
  hand_per_dollar = {'hand_size'},
