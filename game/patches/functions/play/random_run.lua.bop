local function stake_panel(z)
  local s = PR.state
  local w = z.stake_w
  local inner = w - 2 * UIK.PAD
  local shown = s.shown_stake or s.stake or 1
  local chip = get_stake_sprite(s.rolling and 1 or shown, touch() and 1.9 or 2)
  if s.rolling then set_chip(chip, shown) end
  PR.chip = chip
  return panel(localize('k_stake'), w, z, {
    {n = G.UIT.R, config = {align = 'cm', minw = inner, minh = z.vis_h, padding = 0}, nodes = {{n = G.UIT.O, config = {object = chip}}}},
    name_row('stake_name', inner, z),
    slot_obj('play_random_stake_desc', stake_desc(inner - 0.2, z)),
  })
end

local function rules_panel(z)
  local inner = z.rules_w - 2 * UIK.PAD
  return panel(L("Rules"), z.rules_w, z, {
    slot_obj('play_random_rules', rules_def(inner - 0.2, z)),
  })
end

local function swap(id, def)
  local e = G.OVERLAY_MENU and G.OVERLAY_MENU:get_UIE_by_ID(id)
r 4 1300 %20%20 -
l 160
  if e.config.object then e.config.object:remove() end
  e.config.object = UIBox{definition = def, config = {offset = {x = 0, y = 0}, parent = e, type = 'cm'}}
  e.UIBox:recalculate()
end

function PR.reveal()
  local z = sizes()
  local s = PR.state
  if PR.chip and s.rolling then
    PR.chip.draw = nil
  elseif PR.chip then
    local fresh = get_stake_sprite(s.stake or 1, 1)
    PR.chip.draw = fresh.draw ~= Sprite.draw and fresh.draw or nil
    fresh:remove()
  end
  swap('play_random_deck_desc', deck_desc(z.deck_w - 2 * UIK.PAD - 0.2, z))
  swap('play_random_stake_desc', stake_desc(z.stake_w - 2 * UIK.PAD - 0.2, z))
  swap('play_random_rules', rules_def(z.rules_w - 2 * UIK.PAD - 0.2, z))
end

function PR.build()
  local z = sizes()
  local cols = {deck_panel(z), {n = G.UIT.C, config = {minw = UIK.GAP}}, stake_panel(z)}
  if mode() == 'custom' then
    local s = PR.state
    if not s.rolling and (not s.rules or #s.rules == 0) then s.rules = PR.roll_rules() end
    cols[#cols + 1] = {n = G.UIT.C, config = {minw = UIK.GAP}}
    cols[#cols + 1] = rules_panel(z)
  end
  return {n = G.UIT.R, config = {align = 'tm', minw = UIK.W, padding = 0}, nodes = cols}
end

local function tick_sound(i)
  play_sound('card1', 0.85 + i * 0.04, 0.45)
end

local function land_fx()
  play_sound('tarot1', 1, 0.7)
  play_sound('chips2', 1.1, 0.45)
  if PR.card and PR.card.juice_up then PR.card:juice_up(0.45, 0.4) end
  if PR.chip and PR.chip.juice_up then PR.chip:juice_up(0.45, 0.4) end
end

local function queue(ev)
  G.E_MANAGER.queues[PR.QUEUE] = G.E_MANAGER.queues[PR.QUEUE] or {}
  G.E_MANAGER:add_event(ev, PR.QUEUE)
end

function PR.roll()
  local s = PR.state
  s.roll_id = (s.roll_id or 0) + 1
  local id = s.roll_id
  if G.E_MANAGER.queues[PR.QUEUE] then G.E_MANAGER:clear_queue(PR.QUEUE) end
  local final_deck, final_stake = PR.pick_run()
  local final_rules = PR.roll_rules()
  s.rolling = true
  s.deck, s.stake, s.rules = final_deck, final_stake, final_rules
  s.shown_deck, s.shown_stake = pick(PR.decks()).key, 1
  s.deck_name, s.stake_name = '?', '?'
  local decks = PR.decks()
  local steps = 9
  for i = 1, steps do
    queue(Event({trigger = 'after', delay = 0.02 + 0.009 * i, timer = 'REAL', blocking = true, func = function()
      if s.roll_id ~= id then return true end
      if PR.card then PR.card.pinch.x = true end
      if PR.chip then PR.chip.pinch.x = true end
      return true
    end}))
    queue(Event({trigger = 'after', delay = 0.06, timer = 'REAL', blocking = true, func = function()
      if s.roll_id ~= id then return true end
      local last = i == steps
      local dk = last and final_deck or pick(decks).key
      local st = last and final_stake or math.random(PR.max_stake(dk))
      s.shown_deck, s.shown_stake = dk, st
      s.deck_name, s.stake_name = deck_name(dk), stake_name(st)
      set_card_deck(PR.card, dk)
      set_chip(PR.chip, st)
      if PR.card then PR.card.pinch.x = false end
      if PR.chip then PR.chip.pinch.x = false end
      tick_sound(i)
      return true
    end}))
  end
  queue(Event({trigger = 'after', delay = 0.1, timer = 'REAL', blocking = true, func = function()
    if s.roll_id ~= id then return true end
    s.rolling = false
    s.shown_deck, s.shown_stake = nil, nil
    s.deck_name, s.stake_name = deck_name(s.deck), stake_name(s.stake)
    if G.OVERLAY_MENU and UIK._win and UIK._win.id == 'play_random' then PR.reveal() end
    land_fx()
    return true
  end}))
end

function PR.open(tab)
  local s = PR.state
  s.rolling = true
  s.deck_name, s.stake_name = '?', '?'
  G.FUNCS.overlay_menu{definition = UIK.window{
    id = 'play_random',
    title = L("RANDOM RUN"),
    tab = tab,
    tabs = {
      {key = 'plain', label = L("Random run"), build = PR.build},
      {key = 'custom', label = L("Custom random"), build = PR.build},
    },
    back_func = 'play_random_back',
    footer = {
      UIK.button{label = localize('k_reroll'), button = 'play_random_reroll', colour = UIK.C.purple, id = 'play_random_reroll'},
      UIK.button{label = L("START"), button = 'play_random_start', colour = UIK.C.ok, id = 'play_random_start', func = 'play_random_can_start'},
    },
  }}
  PR.roll()
end

G.FUNCS.play_random_open = function()
  PR.open()
end

G.FUNCS.play_random_reroll = function()
  if not (G.OVERLAY_MENU and UIK._win and UIK._win.id == 'play_random') then return end
  PR.state.rolling = true
  PR.state.deck_name, PR.state.stake_name = '?', '?'
  PR.reveal()
  PR.roll()
end

G.FUNCS.play_random_can_start = function(e)
  local s = PR.state
  local ok = not s.rolling and s.deck and G.P_CENTERS[s.deck] and G.P_CENTERS[s.deck].unlocked
  e.config.colour = ok and UIK.C.ok or UIK.C.inactive
  e.config.button = ok and 'play_random_start' or nil
end

function PR.select_new_run_tab()
  local target = localize('b_new_run')
  local function walk(n)
    if type(n) ~= 'table' then return end
    if n.config and n.config.button == 'change_tab' and n.config.ref_table and n.config.ref_table.label == target then
      if not n.config.chosen then G.FUNCS.change_tab(n) end
      return true
    end
    for _, c in ipairs(n.children or {}) do if walk(c) then return true end end
  end
  if G.OVERLAY_MENU then walk(G.OVERLAY_MENU.UIRoot) end
end

G.FUNCS.play_random_back = function()
  PR.state.roll_id = (PR.state.roll_id or 0) + 1
  PR.state.rolling = false
  G.FUNCS.overlay_menu{definition = G.UIDEF.run_setup()}
  PR.select_new_run_tab()
end

G.FUNCS.play_random_start = function()
  local s = PR.state
  if s.rolling or not s.deck then return end
  local center = G.P_CENTERS[s.deck]
  if not (center and center.unlocked) then return end
  local custom = mode() == 'custom'
r 4 1375 %20%20 -
l 1
  if G.SAVED_GAME ~= nil and G.SAVED_GAME.GAME and not G.SAVED_GAME.GAME.won and not (G.GAME and G.GAME.seeded) then
r 23 900 %20%20%20%20 -
l 61
    G:save_settings()
  end
  if custom and RunRules then
    RunRules.start(PR.values(), {rules_source = 'custom', stake = s.stake, back = center, bo_origin_tag = 'random'})
  else
    if RunRules then RunRules.disarm() end
    if G.GAME.viewed_back then G.GAME.viewed_back:change_to(center) else G.GAME.viewed_back = Back(center) end
    G.FUNCS.start_run(nil, {stake = s.stake, bo_origin_tag = 'random'})
  end
end

local function find_mods_button(n, parent)
  if type(n) ~= 'table' then return end
  if n.config and n.config.button == 'open_mod_menu_fullscreen' then return n, parent end
  for _, c in ipairs(n.nodes or {}) do
    local a, b = find_mods_button(c, n)
    if a then return a, b end
  end
end

function PR.add_button(t)
  local mods, col = find_mods_button(t)
  if not (mods and col) then return end
  local w = touch() and 2.3 or 2.1
  local h = touch() and 0.5 or 0.42
  local sc = touch() and 0.44 or 0.4
  mods.config.minw, mods.config.minh, mods.config.padding = w, h, 0.08
  for _, c in ipairs(mods.nodes or {}) do
    if c.n == G.UIT.T then c.config.scale = sc end
  end
  local random = {n = G.UIT.C, config = {align = 'cm', minw = w, minh = h, padding = 0.08, r = 0.1, hover = true, colour = G.C.PURPLE, button = 'play_random_open', shadow = true, id = 'play_random_button'}, nodes = {
    {n = G.UIT.T, config = {text = L("RANDOM"), scale = sc, colour = G.C.UI.TEXT_LIGHT}},
  }}
  col.nodes = {
    {n = G.UIT.R, config = {align = 'cm', padding = 0.05}, nodes = {random}},
    {n = G.UIT.R, config = {align = 'cm', padding = 0.05}, nodes = {mods}},
  }
end

local _pr_setup_option = G.UIDEF.run_setup_option
G.UIDEF.run_setup_option = function(kind, ...)
  local t = _pr_setup_option(kind, ...)
  if kind == 'New Run' and not (G.GAME and G.GAME.multiplayer) then
    local ok, err = pcall(PR.add_button, t)
    if not ok then print("[PlayRandom] button: " .. tostring(err)) end
  end
  return t
end

mod_loc_register{
  fr = {
    ["RANDOM RUN"] = "PARTIE AU HASARD",
    ["Random run"] = "Partie au hasard", ["Custom random"] = "Hasard perso",
  },
  es = {
    ["RANDOM RUN"] = "PARTIDA AL AZAR",
    ["Random run"] = "Partida al azar", ["Custom random"] = "Azar personalizado",
  },
}

return PR
end
