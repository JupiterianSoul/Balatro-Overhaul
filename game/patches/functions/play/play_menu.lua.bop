  G.FUNCS.start_run(nil, {stake = stake, seed = seed, back = center, cheats = (PM.sel.cheats and PM.cheats_on()) or nil})
end

G.FUNCS.bo_play_random_deck = function()
  local list = decks()
  PM.sel.deck = list[math.random(#list)].key
  PM.refresh('bo_play_random_deck')
end

G.FUNCS.bo_play_random_stake = function()
  PM.sel.stake = math.random(max_stake(new_run_deck().key))
  PM.refresh('bo_play_random_stake')
end

G.FUNCS.bo_play_random_plain = function()
  local PR = rawget(_G, 'PlayRandom')
  if PR and PR.open then PR.open('plain') end
end

G.FUNCS.bo_play_random_custom = function()
  local PR = rawget(_G, 'PlayRandom')
  if PR and PR.open then PR.open('custom') end
end

G.FUNCS.bo_play_ch_pick = function(e)
  local k = e and e.config and e.config.ref_table and e.config.ref_table.k
  if not k or PM.sel.challenge == k then return end
  PM.sel.challenge = k
  PM.refresh('bo_play_ch_' .. k)
end

G.FUNCS.bo_play_ch_page = function(e)
  local d = e and e.config and e.config.ref_table and e.config.ref_table.d or 1
  local per = touch() and 5 or 6
  local pages = math.max(1, math.ceil(#G.CHALLENGES / per))
  PM.page.ch = ((PM.page.ch or 1) - 1 + d) % pages + 1
  PM.sel.challenge = (PM.page.ch - 1) * per + 1
  PM.refresh(d < 0 and 'bo_play_ch_pager_prev' or 'bo_play_ch_pager_next')
end

G.FUNCS.bo_play_challenge = function()
  local k = PM.sel.challenge
  if not (k and G.CHALLENGES[k] and challenge_open(k)) then return end
  G.FUNCS.start_challenge_run({config = {id = k}})
end

G.FUNCS.bo_play_daily = function()
  local DY = daily()
  if not DY then return end
  play_sound('button')
  DY.start(DY.today())
end

G.FUNCS.bo_play_daily_board = function()
  local DB = rawget(_G, 'BO_DAILY_BOARD')
  if DB and DB.open then DB.open('daily_tab') end
end

G.FUNCS.bo_play_sr_cat = function(e)
  local SR = speedrun()
  local k = e and e.config and e.config.ref_table and e.config.ref_table.key
  if not (SR and k) then return end
  local cfg = SR.get_cfg()
  if cfg.cat == k then return end
  cfg.cat = k
  pcall(function() G:save_settings() end)
  PM.refresh('bo_play_sr_' .. k)
end

G.FUNCS.bo_play_bot_settings = function()
  local B = bot()
  if not (B and B.ui and B.ui.open_settings) then return end
  PM._bot_back = true
  B.ui.open_settings()
end

if G.FUNCS.bot_close_settings and not PM._bot_wrapped then
  PM._bot_wrapped = true
  local base = G.FUNCS.bot_close_settings
  G.FUNCS.bot_close_settings = function(...)
    local back = PM._bot_back
    PM._bot_back = nil
    local r = base(...)
    if back and PM.ENABLED and G.FUNCS.setup_run then
      PM.sel.mode = 'botlatro'
      G.FUNCS.setup_run({config = {id = PM.from_game_over}})
    end
    return r
  end
end

if G.FUNCS.setup_run and not PM._setup_wrapped then
  PM._setup_wrapped = true
  local base = G.FUNCS.setup_run
  G.FUNCS.setup_run = function(e, ...)
    if e and e.config and e.config.id == 'main_menu_play' then PM.sel.mode = nil end
    return base(e, ...)
  end
end

local function prepare(from_game_over)
  pcall(G.UIDEF.custom_run_tab)
  local RR = rawget(_G, 'RunRules')
  if RR and RR.disarm then RR.disarm() end
  if G.CUSTOM_RUN then G.CUSTOM_RUN.enabled = false end
r 15 5225 %20%20 -
l 43
  if G._cr_select_custom_tab then PM.sel.mode = 'custom' end
  G._cr_select_custom_tab = nil
  local B = bot()
  if B and B.ui and B.ui.select_tab then PM.sel.mode = 'botlatro' B.ui.select_tab = nil end
  if from_game_over == 'challenge_list' then PM.sel.mode = 'challenges' end
end

if G.UIDEF.run_setup and not PM._wrapped then
  PM._wrapped = true
  local base = G.UIDEF.run_setup
  G.UIDEF.run_setup = function(from_game_over, ...)
    if PM.ENABLED and not (G.GAME and G.GAME.multiplayer) then
      local ok, def = pcall(function()
        prepare(from_game_over)
        return PM.def((from_game_over == 'from_game_over' or from_game_over == 'from_game_won') and from_game_over or nil)
      end)
      if ok and def then return def end
      print("[PlayMenu] " .. tostring(def))
    end
    return base(from_game_over, ...)
  end
end

