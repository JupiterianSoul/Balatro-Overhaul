local function refocus(id)
  local c = G.CONTROLLER
  if not (c and c.HID and c.HID.controller and G.OVERLAY_MENU) then return end
  local e = G.OVERLAY_MENU:get_UIE_by_ID(id)
  if e then c:snap_to{node = e} end
end

function PM.refresh(focus)
  UIK.refresh()
  if focus then refocus(focus) end
end

G.FUNCS.bo_play_mode = function(e)
  local k = e and e.config and e.config.ref_table and e.config.ref_table.key
  if not (k and available(mode(k))) or PM.current() == k then return end
  PM.sel.mode = k
  PM.refresh('bo_play_mode_' .. k)
end

G.FUNCS.bo_play_step = function(e)
  local r = e and e.config and e.config.ref_table
  if not r then return end
  if r.what == 'deck' then
    local list = decks()
    local cur = new_run_deck().key
    local i = 1
    for j, d in ipairs(list) do if d.key == cur then i = j end end
    i = (i - 1 + r.d) % #list + 1
    PM.sel.deck = list[i].key
  elseif r.what == 'stake' then
    local top = max_stake(new_run_deck().key)
    PM.sel.stake = ((PM.sel.stake or 1) - 1 + r.d) % top + 1
  end
  PM.refresh('bo_play_' .. r.what .. (r.d < 0 and '_prev' or '_next'))
end

G.FUNCS.bo_play_continue = function()
  if not saved() then return end
