G.FUNCS.bo_play_new_run = function()
  local center = new_run_deck()
  if not (center and center.unlocked ~= false) then return end
  local stake = math.max(1, math.min(PM.sel.stake or 1, max_stake(center.key)))
  local seed = PM.sel.seeded and PM.sel.seed and PM.sel.seed ~= '' and PM.sel.seed or nil
  local p = profile()
  if G.SAVED_GAME ~= nil and G.SAVED_GAME.GAME and not G.SAVED_GAME.GAME.won and p.high_scores then
    p.high_scores.current_streak.amt = 0
  end
  p.MEMORY = p.MEMORY or {}
  p.MEMORY.deck, p.MEMORY.stake = center.name, stake
  pcall(function() G:save_settings() end)
