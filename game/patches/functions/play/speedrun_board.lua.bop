  return {n = G.UIT.R, config = {align = 'cm', padding = 0.08}, nodes = {
    UIBox_button({label = {L("SPEEDRUNS")}, button = 'open_speedrun_board', minw = 5, minh = 1, colour = G.C.SECONDARY_SET.Planet}),
  }}
end

