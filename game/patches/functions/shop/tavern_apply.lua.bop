l 77
  end
  base.children.tavern_sleeve = spr
  return base
end

local function blind_colours()
  return G and G.C and G.C.BLIND
end

function A.apply_felt()
  local b = blind_colours()
  if not b then return end
  for _, k in ipairs({"Small", "Big", "won"}) do
    if b[k] and not A.defaults[k] then A.defaults[k] = {b[k][1], b[k][2], b[k][3], b[k][4]} end
  end
  local f = S.def("felt", active_key("felt"))
  local c = f and hex(f.colour)
  for _, k in ipairs({"Small", "Big", "won"}) do
    local t, d = b[k], A.defaults[k]
    if t and d then
      local src = c or d
      if c and k == "won" then src = {c[1] * 0.85, c[2] * 0.85, c[3] * 0.85, 1} end
      t[1], t[2], t[3], t[4] = src[1], src[2], src[3], src[4] or 1
    end
  end
end

function A.apply_flames()
  local f = S.def("flame", active_key("flame"))
  if not (G and G.ARGS) then return end
  local pairs_ = {chip_flames = f and f.chips, mult_flames = f and f.mult}
  for tab, cols in pairs(pairs_) do
    local a = G.ARGS[tab]
    if a then
      if cols then
        a.colour_1, a.colour_2 = hex(cols[1]), hex(cols[2])
      elseif G.ARGS.flame_handler then
        local h = tab == "chip_flames" and G.ARGS.flame_handler.chips or G.ARGS.flame_handler.mult
        if h then a.colour_1, a.colour_2 = h.colour, h.accent end
      end
    end
  end
end

function A.celebrate()
  local c = S.def("celebration", active_key("celebration"))
  if not (c and G and G.ROOM_ATTACH and Particles) then return end
  local cols = {}
  for _, h in ipairs(c.colours or {}) do cols[#cols + 1] = hex(h) end
  if #cols == 0 then return end
  for i = 1, 2 do
    local p = Particles(0, 0, 0, 0, {timer = 0.01, scale = 0.25, speed = 3, lifespan = 3.5, attach = G.ROOM_ATTACH, colours = cols, fill = true, padding = -0.5, initialize = true})
    p.fade_alpha = 0
    G.E_MANAGER:add_event(Event({trigger = "after", delay = 2.5 + i * 0.5, blockable = false, blocking = false, func = function()
      if p and p.fade then p:fade(0.6) end
      return true
    end}))
    G.E_MANAGER:add_event(Event({trigger = "after", delay = 4 + i * 0.5, blockable = false, blocking = false, func = function()
      if p and p.remove then p:remove() end
      return true
    end}))
  end
  pcall(play_sound, "holo1", 1.2, 0.5)
end

function A.effect_steps(key)
  if not key then return nil end
  for _, e in ipairs(rawget(_G, "SHOP_ICON_EFFECTS") or {}) do
    if e.id == key then return e.steps or (e.shader and {e.shader}) or nil end
  end
  return nil
end

