function A.portrait_sprite(key, w, h)
  local it = key and S.get("portrait:" .. key)
  if not it then return nil end
  return A.sprite("tavern_portraits", it.pos, w, h)
end

function A.icon_sprite(w, h, opts)
  opts = opts or {}
  w, h = w or 0.9 * G.CARD_W, h or 0.9 * G.CARD_H
  local pkey = opts.portrait
  if pkey == nil then pkey = S.equipped("portrait") end
  local spr, soul
  if pkey then spr = A.portrait_sprite(pkey, w, h) end
  if not spr then
    local jkey = opts.joker
    if jkey == nil and ProfileRewardsManager and ProfileRewardsManager.get_equipped_icon then jkey = ProfileRewardsManager.get_equipped_icon() end
    local center = jkey and G.P_CENTERS and G.P_CENTERS[jkey]
    if not center and opts.fallback then center = G.P_CENTERS[opts.fallback] end
    if not center then return nil end
    local atlas = G.ASSET_ATLAS[center.atlas or "Joker"] or G.ASSET_ATLAS.Joker
    spr = Sprite(0, 0, w, h, atlas, center.pos)
    spr.states.drag.can = false
    spr.states.collide.can = false
    if center.soul_pos then
      soul = Sprite(0, 0, w, h, atlas, center.soul_pos)
      soul.states.drag.can = false
      soul.states.collide.can = false
    end
  end
  local ekey = opts.effect
  if ekey == nil then ekey = S.equipped("effect") end
  return A.shine_sprite(spr, A.effect_steps(ekey), soul)
end

function A.icon_frame_def()
  local spr = A.icon_sprite()
  return {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR}, nodes = {
    {n = G.UIT.C, config = {align = "cm", padding = 0.1}, nodes = {
      {n = G.UIT.R, config = {align = "cm", padding = 0.08, r = 0.1, colour = G.C.L_BLACK, emboss = 0.05}, nodes = {
        {n = G.UIT.R, config = {align = "cm", padding = 0.06, r = 0.08, colour = G.C.BLACK, outline = 1, outline_colour = G.C.GOLD,
          minw = 0.9 * G.CARD_W, minh = 0.9 * G.CARD_H}, nodes = spr and {{n = G.UIT.O, config = {object = spr}}}
          or {{n = G.UIT.T, config = {text = "?", scale = 0.7, colour = G.C.GREY, shadow = true}}}},
      }},
    }},
  }}
end

function A.refresh_icon()
  pcall(function() if setup_profile_icon_frame then setup_profile_icon_frame() end end)
end

function A.install_hooks()
  if A.hooked then return end
  A.hooked = true
  A.register()
  if G and G.UIDEF and G.UIDEF.profile_icon_frame then
    local orig = G.UIDEF.profile_icon_frame
    G.UIDEF.profile_icon_frame = function(...)
      local ok, def = pcall(A.icon_frame_def)
      if ok and def then return def end
      return orig(...)
    end
  end
  if G and G.FUNCS and G.FUNCS.flame_handler then
    local orig = G.FUNCS.flame_handler
r 13 1963 %20%20%20%20 -
l 27
      orig(e)
      if A.preview and A.preview.flame ~= nil or S.equipped("flame") then pcall(A.apply_flames) end
    end
  end
  if rawget(_G, "ease_background_colour_blind") then
    local orig = ease_background_colour_blind
    ease_background_colour_blind = function(...)
      pcall(A.apply_felt)
      return orig(...)
    end
  end
  if rawget(_G, "win_game") then
    local orig = win_game
    win_game = function(...)
      local r = orig(...)
      pcall(A.celebrate)
      return r
    end
  end
  S.on_equip = function(it)
    if it.type == "portrait" or it.type == "effect" then A.refresh_icon() end
    if it.type == "felt" then pcall(A.apply_felt) end
    if it.type == "flame" then pcall(A.apply_flames) end
  end
end

return A
end
