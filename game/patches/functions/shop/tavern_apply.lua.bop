local C = require("functions/shop/tavern_catalog")
local S = require("functions/shop/tavern_store")
local SL = require("functions/shop/tavern_sleeves")

local A = {shared = {}, defaults = {}}

local function hex(h)
  if type(h) ~= "string" then return nil end
  return {tonumber(h:sub(1, 2), 16) / 255, tonumber(h:sub(3, 4), 16) / 255, tonumber(h:sub(5, 6), 16) / 255, 1}
end
A.hex = hex

function A.register()
  if A.registered then return end
  A.registered = true
  local sets = rawget(_G, "SHOP_COLOR_SETS")
  local rar = rawget(_G, "SHOP_RARITY")
  if sets and rar then
    local have = {}
    for _, s in ipairs(sets) do have[s.id] = true end
    local map = {common = rar.COMMON, uncommon = rar.UNCOMMON, rare = rar.RARE, epic = rar.EPIC, legendary = rar.LEGENDARY}
    for _, p in ipairs(C.NEW_PALETTES) do
      if not have[p.id] and TAVERN_PALETTES.kept(p.id) then
        sets[#sets + 1] = {id = p.id, name = p.name, rarity = map[p.rarity] or rar.COMMON, group = "Tavern", bonus = true, tavern = true,
          blue = p.blue, red = p.red, green = p.green, yellow = p.yellow, price = 0}
      end
    end
  end
  local effects = rawget(_G, "SHOP_ICON_EFFECTS")
  if effects and rar then
    local have = {}
    for _, e in ipairs(effects) do have[e.id] = true end
    local map = {common = rar.COMMON, uncommon = rar.UNCOMMON, rare = rar.RARE, epic = rar.EPIC, legendary = rar.LEGENDARY}
    for _, e in ipairs(C.NEW_EFFECTS) do
      if not have[e.id] then
        effects[#effects + 1] = {id = e.id, name = e.name, rarity = map[e.rarity] or rar.COMMON, shader = e.steps[1], steps = e.steps, tavern = true, price = 0}
      end
    end
  end
  local titles = rawget(_G, "TITLES")
  if titles then
    local have = {}
    for _, t in ipairs(titles) do have[t.id] = true end
    for _, t in ipairs(C.NEW_TITLES) do
      if not have[t.id] then
        titles[#titles + 1] = {id = t.id, name = t.name, description = "Found in a Title Pack", unlock_type = "tavern", category = "tavern"}
      end
    end
  end
end

local ATLASES = {
  tavern_packs = "TavernPacks.png",
  tavern_portraits = "TavernPortraits.png",
  tavern_backs = "TavernBacks.png",
}

function A.atlas(name)
  if not (G and G.ASSET_ATLAS) then return nil end
  local a = G.ASSET_ATLAS[name]
  if a then return a end
  if A.shared["miss:" .. name] then return nil end
  local file = ATLASES[name]
  local scale = G.SETTINGS and G.SETTINGS.GRAPHICS and G.SETTINGS.GRAPHICS.texture_scaling or 2
  if name == "tavern_sleeves" then
    local ok, img = pcall(function() return love.graphics.newImage(SL.build(scale), {mipmaps = true, dpiscale = scale}) end)
    if not ok then
      print("[tavern_sleeves] " .. tostring(img))
      A.shared["miss:" .. name] = true
      return nil
    end
    G.ASSET_ATLAS[name] = {name = name, image = img, px = 71, py = 95}
    return G.ASSET_ATLAS[name]
  end
  local path = file and ("resources/textures/" .. scale .. "x/" .. file)
  if not (path and (love.filesystem.getInfo(path) or (release_art and release_art.has(path)) or (booster_tints and booster_tints.has(path)))) then
    A.shared["miss:" .. name] = true
    return nil
  end
  local ok, img = pcall(function()
    if name == "tavern_backs" then
      local data = love.image.newImageData(path)
      return love.graphics.newImage(SL.coat_all(data, scale), {mipmaps = true, dpiscale = scale})
    end
    return love.graphics.newImage(path, {mipmaps = true, dpiscale = scale})
  end)
  if not ok then
    A.shared["miss:" .. name] = true
    return nil
  end
  G.ASSET_ATLAS[name] = {name = name, image = img, px = 71, py = 95}
  return G.ASSET_ATLAS[name]
end

function A.sprite(atlas_name, pos, w, h)
  local a = A.atlas(atlas_name) or (G.ASSET_ATLAS and G.ASSET_ATLAS[atlas_name])
  if not a or not pos then return nil end
  local spr = Sprite(0, 0, w or G.CARD_W, h or G.CARD_H, a, pos)
  spr.states.drag.can = false
  spr.states.collide.can = false
  return spr
end

function A.pack_sprite(pack, w, h)
  local art = S.art.packs and S.art.packs[pack.art]
  local spr
  if art and A.atlas("tavern_packs") then spr = A.sprite("tavern_packs", art, w, h) end
  if not spr then spr = A.sprite("Booster", pack.booster, w, h) end
  return spr
end

function A.ranked_now()
  local now = G and G.TIMERS and G.TIMERS.REAL
  if now and A._rk_at == now then return A._rk end
  local r = false
  local ui = rawget(_G, "bom_ui")
  if ui and ui.is_ranked_match then
    local ok, v = pcall(ui.is_ranked_match)
    r = ok and v and true or false
  end
  A._rk_at, A._rk = now, r
  return r
end

local function active_key(type_key)
  if A.preview and A.preview[type_key] ~= nil then return A.preview[type_key] or nil end
  if A.ranked_now() then return nil end
  return S.equipped(type_key)
end

local function back_item(key)
  if not key then return nil end
  return S.get("back:" .. key)
end

local function shared_back(it)
  local sk = "back:" .. it.base
  local spr = A.shared[sk]
  if spr then return spr end
  spr = A.sprite(it.atlas or "tavern_backs", it.pos)
  A.shared[sk] = spr
  return spr
end

function A.draw_back(card)
  if not (card and card.playing_card and card.children and card.children.back and G.GAME) then return end
  local it = back_item(active_key("back"))
  if not it then return end
  local spr = shared_back(it)
  if not spr then return end
  card.ARGS.send_to_shader = card.ARGS.send_to_shader or {0, 0}
  local base = card.children.back
  spr.role.draw_major = card
  if card.area and card.area.config and card.area.config.type == "deck" and card.area.cards and card.area.cards[1] ~= card then
    local prev = G.BRUTE_OVERLAY
    G.BRUTE_OVERLAY = (card.rank or 0) > 3 and card.back_overlay or G.C.WHITE
    spr:draw_from(base)
    G.BRUTE_OVERLAY = prev
    return
  end
  spr:draw_shader("dissolve", nil, nil, true, base)
  local send = card.ARGS.send_to_shader
  if it.finish == "negative" then
    spr:draw_shader("negative", nil, send, true, base)
    spr:draw_shader("negative_shine", nil, send, true, base)
  elseif it.finish then
    spr:draw_shader(it.finish, nil, send, true, base)
  end
end

function A.coat(base)
  if not (base and base.T and base.children and G and G.GAME) then return base end
  local it = back_item(active_key("back"))
  local a = it and A.atlas(it.atlas or "tavern_backs")
  if not (a and it.pos) then return base end
  local spr = Sprite(base.T.x, base.T.y, base.T.w, base.T.h, a, it.pos)
  spr.states.drag.can = false
  spr.states.collide.can = false
  spr.states.hover.can = false
  spr:set_role({major = base, role_type = "Glued", draw_major = base})
  local send = {0, 0}
  spr.draw = function(self)
    if not (self.states.visible and base.states.visible) then return end
    self:draw_self()
    if it.finish then
      send[1], send[2] = G.TIMERS.REAL / 28, G.TIMERS.REAL
      if it.finish == "negative" then
        self:draw_shader("negative", nil, send)
        self:draw_shader("negative_shine", nil, send)
      else
        self:draw_shader(it.finish, nil, send)
      end
    end
