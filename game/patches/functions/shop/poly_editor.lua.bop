local PE = {}

local KEYS = {"blue", "red", "green", "yellow"}
local NAMES = {blue = "Chips", red = "Mult", green = "Chance", yellow = "Money"}
local DEFAULT = {blue = {0, 157, 255}, red = {254, 95, 85}, green = {75, 194, 146}, yellow = {255, 255, 0}}
local QUICK = {
  "ff4b4b", "ff8a3d", "ffc23d", "fff34d", "b8ff4d", "4dff88", "3dffd1", "3dc8ff",
  "4d8aff", "8a5cff", "d05cff", "ff5cc8", "ffffff", "b0b8c0", "6b7480", "2b2f36",
}

local function L(s) return mod_loc and mod_loc(s) or s end
local function touch() return UIK and UIK.touch and UIK.touch() end
local function port() return UIK and UIK.portrait and UIK.portrait() end

local function clamp(v, a, b) return math.max(a, math.min(b, v)) end

local function rgb_to_hsv(r, g, b)
  r, g, b = r / 255, g / 255, b / 255
  local mx, mn = math.max(r, g, b), math.min(r, g, b)
  local d = mx - mn
  local h = 0
  if d > 0 then
    if mx == r then h = ((g - b) / d) % 6
    elseif mx == g then h = (b - r) / d + 2
    else h = (r - g) / d + 4 end
    h = h * 60
  end
  return math.floor(h + 0.5) % 360, math.floor((mx > 0 and d / mx or 0) * 100 + 0.5), math.floor(mx * 100 + 0.5)
end

local function hsv_to_rgb(h, s, v)
  h, s, v = (h % 360) / 60, clamp(s, 0, 100) / 100, clamp(v, 0, 100) / 100
  local c = v * s
  local x = c * (1 - math.abs(h % 2 - 1))
  local m = v - c
  local r, g, b
  if h < 1 then r, g, b = c, x, 0
  elseif h < 2 then r, g, b = x, c, 0
  elseif h < 3 then r, g, b = 0, c, x
  elseif h < 4 then r, g, b = 0, x, c
  elseif h < 5 then r, g, b = x, 0, c
  else r, g, b = c, 0, x end
  return math.floor((r + m) * 255 + 0.5), math.floor((g + m) * 255 + 0.5), math.floor((b + m) * 255 + 0.5)
end

local function from_hex(h)
  return {tonumber(h:sub(1, 2), 16), tonumber(h:sub(3, 4), 16), tonumber(h:sub(5, 6), 16)}
end

local function sync(key)
  local st = PE.state
  local v, c = st.rgb[key], st.cols[key]
  c[1], c[2], c[3], c[4] = v[1] / 255, v[2] / 255, v[3] / 255, 1
  local d = st.dark[key]
  d[1], d[2], d[3], d[4] = c[1] * 0.55, c[2] * 0.55, c[3] * 0.55, 1
  st.hex[key] = string.format("#%02X%02X%02X", v[1], v[2], v[3])
end

local function set_rgb(key, rgb)
  local st = PE.state
  st.rgb[key] = {clamp(rgb[1], 0, 255), clamp(rgb[2], 0, 255), clamp(rgb[3], 0, 255)}
  sync(key)
end

local function load_hsv()
  local st = PE.state
  local v = st.rgb[st.sel]
  st.hsv.h, st.hsv.s, st.hsv.v = rgb_to_hsv(v[1], v[2], v[3])
end

local function load_all(src)
  for _, k in ipairs(KEYS) do set_rgb(k, src[k]) end
  load_hsv()
end

local function poly_to_src(poly)
  local src = {}
  for _, k in ipairs(KEYS) do
    local d = DEFAULT[k]
    src[k] = {tonumber(poly and poly[k .. "_r"]) or d[1], tonumber(poly and poly[k .. "_g"]) or d[2], tonumber(poly and poly[k .. "_b"]) or d[3]}
  end
  return src
end

local function owned_sets()
  local list = {{name = L("Default"), src = DEFAULT}}
  local p = G.PROFILES and G.PROFILES[G.SETTINGS.profile]
  local owned = {}
  for _, id in ipairs(p and p.progression and p.progression.owned_color_sets or {}) do owned[id] = true end
  for _, set in ipairs(SHOP_COLOR_SETS or {}) do
    if owned[set.id] and set.blue and set.red and set.green and set.yellow then
      list[#list + 1] = {name = set.name and L(set.name) or set.id, src = {blue = set.blue, red = set.red, green = set.green, yellow = set.yellow}}
    end
  end
  return list
end

function PE.open(from)
  local poly = AshCardManager and AshCardManager.get_poly_colors and AshCardManager.get_poly_colors() or nil
  PE.state = {cols = {}, dark = {}, rgb = {}, hex = {}, hsv = {}, sel = "blue", start = 1, from = from}
  for _, k in ipairs(KEYS) do PE.state.cols[k], PE.state.dark[k] = {0, 0, 0, 1}, {0, 0, 0, 1} end
  load_all(poly_to_src(poly))
