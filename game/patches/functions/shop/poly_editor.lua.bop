  G.FUNCS.overlay_menu{definition = PE.def()}
end

local function txt(s, scale, colour, o)
  o = o or {}
  return {n = G.UIT.T, config = {text = s, scale = scale, colour = colour or G.C.UI.TEXT_LIGHT, shadow = o.shadow ~= false, ref_table = o.ref_table, ref_value = o.ref_value}}
end

local function row(nodes, o)
  o = o or {}
  return {n = G.UIT.R, config = {align = o.align or "cm", minw = o.w, minh = o.h, padding = o.padding or 0.04}, nodes = nodes}
end

local function ink(k)
  local v = PE.state.rgb[k]
  return (0.299 * v[1] + 0.587 * v[2] + 0.114 * v[3]) / 255 > 0.68 and G.C.UI.TEXT_DARK or G.C.UI.TEXT_LIGHT
end

local function chip_box(colour, label, value, w, h)
  return {n = G.UIT.C, config = {align = "cm", minw = w, minh = h, r = 0.1, colour = colour, emboss = 0.05, padding = 0.04}, nodes = {
    row({txt(label, 0.28, G.C.UI.TEXT_LIGHT)}, {padding = 0}),
    row({txt(value, 0.5, G.C.UI.TEXT_LIGHT)}, {padding = 0}),
  }}
end

local function fake_button(label, k, w, h)
  return {n = G.UIT.C, config = {align = "cm", minw = w, minh = h, r = 0.1, colour = PE.state.cols[k], shadow = true, padding = 0.05}, nodes = {
    txt(label, touch() and 0.36 or 0.32, ink(k), {shadow = ink(k) == G.C.UI.TEXT_LIGHT}),
  }}
end

local function preview(w)
  local st = PE.state
  local c = st.cols
  local half = (w - 0.5) / 2
  local bh = touch() and 0.62 or 0.55
  local rows = {
    row({
      chip_box(c.blue, L("Chips"), "120", half, 0.9),
      {n = G.UIT.C, config = {align = "cm", minw = 0.3}, nodes = {txt("X", 0.5, c.red)}},
      chip_box(c.red, L("Mult"), "8", half, 0.9),
    }, {w = w}),
    row({
      {n = G.UIT.C, config = {align = "cm", minw = half}, nodes = {txt("$25", 0.6, c.yellow)}},
      {n = G.UIT.C, config = {align = "cm", minw = 0.3}, nodes = {}},
      {n = G.UIT.C, config = {align = "cm", minw = half}, nodes = {txt(L("1 in 4"), 0.42, c.green)}},
    }, {w = w, h = 0.7}),
    row({
      fake_button(L("Play Hand"), "blue", half, bh),
      {n = G.UIT.C, config = {align = "cm", minw = 0.3}, nodes = {}},
      fake_button(L("Discard"), "red", half, bh),
    }, {w = w}),
    row({
      fake_button(L("Cash Out"), "yellow", half, bh),
      {n = G.UIT.C, config = {align = "cm", minw = 0.3}, nodes = {}},
      fake_button(L("Reroll"), "green", half, bh),
    }, {w = w}),
  }
  return UIK.section(L("PREVIEW"), rows, {w = w})
end

local function swatch_row(k, w)
  local st = PE.state
  local on = st.sel == k
  local sw = touch() and 1.5 or 1.3
  local h = touch() and 0.82 or 0.72
  return {n = G.UIT.R, config = {align = "cm", padding = 0.03}, nodes = {
    {n = G.UIT.C, config = {align = "cm", minw = w, minh = h + 0.1, r = 0.12, padding = 0.05, hover = true, shadow = true,
      colour = G.C.BLACK, button = "poly_pick", ref_table = {key = k},
      outline = on and 1.5 or nil, outline_colour = on and G.C.GOLD or nil}, nodes = {
      {n = G.UIT.C, config = {align = "cm", minw = sw, minh = h, r = 0.1, colour = st.cols[k], emboss = 0.05}, nodes = {}},
      {n = G.UIT.C, config = {align = "cl", minw = w - sw - 0.3, padding = 0.08}, nodes = {
        row({txt(L(NAMES[k]), touch() and 0.42 or 0.38, on and G.C.GOLD or G.C.UI.TEXT_LIGHT)}, {align = "cl", padding = 0}),
        row({txt("", 0.3, G.C.UI.TEXT_INACTIVE, {shadow = false, ref_table = st.hex, ref_value = k})}, {align = "cl", padding = 0}),
      }},
    }},
  }}
end

local function swatch_grid(w)
  local s = touch() and 0.56 or 0.46
  local per = 8
  local rows = {}
  for r = 1, math.ceil(#QUICK / per) do
    local cells = {}
    for i = (r - 1) * per + 1, math.min(#QUICK, r * per) do
      cells[#cells + 1] = {n = G.UIT.C, config = {align = "cm", padding = 0.03}, nodes = {
        {n = G.UIT.C, config = {align = "cm", minw = s, minh = s, r = 0.08, colour = HEX(QUICK[i]), hover = true, shadow = true,
          button = "poly_quick", ref_table = {hex = QUICK[i]}}, nodes = {}},
      }}
    end
    rows[#rows + 1] = row(cells, {w = w, padding = 0})
  end
  return rows
end

local function editor(w)
  local st = PE.state
  local k = st.sel
  local function cb() local r, g, b = hsv_to_rgb(st.hsv.h, st.hsv.s, st.hsv.v); set_rgb(k, {r, g, b}) end
  local rows = {
    row({
      {n = G.UIT.C, config = {align = "cm", minw = w - 0.3, minh = touch() and 0.62 or 0.52, r = 0.1, colour = st.cols[k], emboss = 0.05}, nodes = {
        txt("", 0.36, ink(k), {ref_table = st.hex, ref_value = k, shadow = ink(k) == G.C.UI.TEXT_LIGHT}),
      }},
    }, {w = w}),
    UIK.slider{label = L("Hue"), ref_table = st.hsv, ref_value = "h", min = 0, max = 359, w = w, colour = st.cols[k], callback = cb},
    UIK.slider{label = L("Saturation"), ref_table = st.hsv, ref_value = "s", min = 0, max = 100, w = w, colour = st.cols[k], callback = cb},
    UIK.slider{label = L("Brightness"), ref_table = st.hsv, ref_value = "v", min = 0, max = 100, w = w, colour = st.cols[k], callback = cb},
    row({txt(L("Quick colours"), 0.3, G.C.UI.TEXT_INACTIVE, {shadow = false})}, {w = w, padding = 0.02}),
  }
  for _, r in ipairs(swatch_grid(w)) do rows[#rows + 1] = r end
  return UIK.section(string.format(L("EDIT %s"), string.upper(L(NAMES[k]))), rows, {w = w, colour = st.cols[k]})
end

local function start_from(w)
  local st = PE.state
  local sets = owned_sets()
  local names = {}
  for i, s in ipairs(sets) do names[i] = s.name end
  st.start = clamp(st.start or 1, 1, #names)
  return UIK.cycle{label = L("Start from a palette"), options = names, current = st.start, w = w, no_pips = #names > 12, callback = function(i)
    st.start = i
    if sets[i] then load_all(sets[i].src) end
    UIK.refresh()
  end}
end

local function body()
  local W = UIK.W
  local st = PE.state
  if port() then
    local w = W - 0.2
    local strip = {}
    for _, k in ipairs(KEYS) do
      local on = st.sel == k
      strip[#strip + 1] = {n = G.UIT.C, config = {align = "cm", padding = 0.05}, nodes = {
        {n = G.UIT.C, config = {align = "cm", minw = (w - 0.6) / 4, minh = 1.0, r = 0.12, colour = st.cols[k], hover = true, shadow = true,
          button = "poly_pick", ref_table = {key = k}, outline = on and 1.5 or nil, outline_colour = on and G.C.GOLD or nil, padding = 0.05}, nodes = {
          row({txt(L(NAMES[k]), 0.36, ink(k), {shadow = ink(k) == G.C.UI.TEXT_LIGHT})}, {padding = 0}),
        }},
      }}
    end
    return {n = G.UIT.R, config = {align = "tm", minw = W, padding = 0.05}, nodes = {
      {n = G.UIT.C, config = {align = "tm"}, nodes = {
        preview(w),
        row(strip, {w = w}),
        editor(w),
        start_from(w),
      }},
    }}
  end
  local cw = (W - 0.5) / 3
  local mid = {}
  mid[#mid + 1] = row({txt(L("Tap a colour to edit it"), 0.3, G.C.UI.TEXT_INACTIVE, {shadow = false})}, {w = cw, padding = 0.02})
  for _, k in ipairs(KEYS) do mid[#mid + 1] = swatch_row(k, cw - 0.2) end
  return {n = G.UIT.R, config = {align = "tm", minw = W, padding = 0.05}, nodes = {
    {n = G.UIT.C, config = {align = "tm", minw = cw, padding = 0.04}, nodes = {preview(cw), start_from(cw)}},
    {n = G.UIT.C, config = {align = "tm", minw = cw, padding = 0.04}, nodes = {UIK.section(L("COLOURS"), mid, {w = cw})}},
    {n = G.UIT.C, config = {align = "tm", minw = cw, padding = 0.04}, nodes = {editor(cw)}},
  }}
end

function PE.def()
  return UIK.window{
    id = "poly_editor",
    title = L("POLYCHROMATIC"),
    tabs = {{key = "edit", label = L("Polychromatic"), build = body}},
    back_func = "poly_back",
    footer = {
      UIK.button{label = L("RESET"), button = "poly_reset", colour = UIK.C.warn},
      UIK.button{label = L("APPLY"), button = "poly_apply", colour = UIK.C.ok},
    },
  }
end

local function back_to_tailor()
  local from = PE.state and PE.state.from
  PE.state = nil
  if G.FUNCS.tavern_custom then
    return G.FUNCS.tavern_custom({config = {ref_table = {tab = "palette", from = from}}})
  end
