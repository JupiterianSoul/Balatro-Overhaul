end

G.FUNCS.poly_pick = function(e)
  local st = PE.state
  local k = e and e.config and e.config.ref_table and e.config.ref_table.key
  if not st or not k or st.sel == k then return end
  st.sel = k
  load_hsv()
  play_sound("paper1", 1.1, 0.5)
  UIK.refresh()
end

G.FUNCS.poly_quick = function(e)
  local st = PE.state
  local h = e and e.config and e.config.ref_table and e.config.ref_table.hex
  if not st or not h then return end
  set_rgb(st.sel, from_hex(h))
  load_hsv()
  play_sound("generic1", 1.2, 0.4)
  UIK.refresh()
end

G.FUNCS.poly_reset = function()
  if not PE.state then return end
  PE.state.start = 1
  load_all(DEFAULT)
  play_sound("cancel", 1, 0.5)
  UIK.refresh()
end

G.FUNCS.poly_apply = function()
  local st = PE.state
  if not st then return end
  local poly = {}
  for _, k in ipairs(KEYS) do
    poly[k .. "_r"], poly[k .. "_g"], poly[k .. "_b"] = st.rgb[k][1], st.rgb[k][2], st.rgb[k][3]
  end
  if AshCardManager and AshCardManager.save_poly_colors then AshCardManager.save_poly_colors(poly) end
  local S = require("functions/shop/tavern_store")
  if not S.equip({type = "palette", key = "polychromatic", id = "palette:polychromatic"}) and apply_color_set then
    pcall(apply_color_set, "polychromatic")
  end
  play_sound("polychrome1", 1.2, 0.6)
  back_to_tailor()
end

G.FUNCS.poly_back = function()
  back_to_tailor()
end

