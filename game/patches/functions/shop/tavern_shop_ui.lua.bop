  local w, h = G.CARD_W * scale, G.CARD_H * scale
  local spr = A.pack_sprite(pack, w, h)
  if not spr then return {n = G.UIT.R, config = {minw = w, minh = h}, nodes = {}} end
  local send = {0, 0}
  spr.draw = function(self)
