    send[1] = t / 28
    send[2] = t
    self:draw_shader("dissolve", 0.1)
    self:draw_shader("dissolve")
    self:draw_shader("booster", nil, send)
r 2 461 %20%20%20%20 -
l 150
  end
  return {n = G.UIT.O, config = {object = spr}}
end

local function pack_tile(pack, w)
  local empty = S.pool_size(pack) == 0
  local can = S.balance() >= pack.price and not empty
  local t = touch()
  local scale = t and 0.72 or 0.95
  local ts = t and 0.42 or 0.26
  local lines = {
    row({U.pack_sprite(pack, scale)}, {w = w, padding = 0.08}),
    row({txt(L(pack.name), t and 0.44 or 0.36, G.C.WHITE, {shadow = true, maxw = w - 0.1})}, {w = w, h = t and 0.5 or 0.42}),
    row({txt(pack.cards .. " " .. L("cards"), t and 0.42 or 0.28, G.C.UI.TEXT_LIGHT, {maxw = w - 0.1})}, {w = w, h = t and 0.44 or 0.3}),
    row({{n = G.UIT.C, config = {align = "cm", minh = t and 3 * (ts + 0.04) or 0.52}, nodes = types_rows(pack, w + 0.1, ts)}}, {w = w}),
    row({txt(extra_text(pack), t and 0.42 or 0.24, pack.last and G.C.GOLD or G.C.UI.TEXT_INACTIVE, {maxw = w - 0.1})}, {w = w, h = t and 0.44 or 0.3}),
    row(odds_row(pack), {w = w, h = t and 0.44 or 0.34}),
    row({UIK.button{label = L("OPEN") .. "  " .. fmt(pack.price), button = "tavern_buy_pack", ref_table = {id = pack.id}, colour = G.C.MONEY, w = w - 0.35, disabled = not can}}, {w = w, padding = 0.06}),
  }
  return {n = G.UIT.C, config = {align = "tm", minw = w, padding = 0.04, r = 0.12, colour = UIK.C.section, emboss = 0.04}, nodes = lines}
end

local function balance_row()
  local nodes = {txt(fmt(S.balance()) .. " " .. L("Balacoin"), 0.4, G.C.MONEY, {shadow = true})}
  return row(nodes, {w = UIK.W, h = 0.5})
end

local function tiles(ids)
  local per = (UIK.portrait and UIK.portrait()) and (#ids == 4 and 2 or 3) or #ids
  local n = math.min(per, #ids)
  local gap = 0.18
  local w = math.min(3.4, (UIK.W - 0.3 - gap * (n - 1)) / n)
  local out = {balance_row()}
  local nodes = {}
  for i, id in ipairs(ids) do
    if #nodes > 0 then nodes[#nodes + 1] = {n = G.UIT.C, config = {minw = gap}, nodes = {}} end
    nodes[#nodes + 1] = pack_tile(C.PACK_BY_ID[id], w)
    if i % per == 0 or i == #ids then
      out[#out + 1] = {n = G.UIT.R, config = {align = "tm", padding = 0.05}, nodes = nodes}
      nodes = {}
    end
  end
  if #out == 2 then return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, padding = 0}, nodes = out} end
  return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = "tm", padding = 0}, nodes = out},
  }}
end

local function tab_packs() return tiles({"palette", "jester", "sleeve", "shine", "title"}) end
local function tab_big() return tiles({"palette_jumbo", "jester_jumbo", "crate", "legend"}) end

local function cell(s, w, colour, scale)
  local sc = scale or (touch() and 0.42 or 0.34)
  return {n = G.UIT.C, config = {align = "cm", minw = w, minh = touch() and 0.56 or 0.5}, nodes = {txt(s, sc, colour, {maxw = w - 0.1})}}
end

local function head_cell(s, w)
  local port = UIK.portrait and UIK.portrait()
  local sc = touch() and 0.42 or 0.34
  if not port and UIK.text_w(s, sc) <= w - 0.35 then return cell(s, w, G.C.GOLD) end
  local nodes = {}
  for l in tostring(s):gmatch("%S+") do nodes[#nodes + 1] = row({txt(l, sc, G.C.GOLD, {maxw = w - 0.06})}, {h = sc + 0.06}) end
  return {n = G.UIT.C, config = {align = "cm", minw = w, minh = 1.45}, nodes = nodes}
end

local function tab_odds()
  local port = UIK.portrait and UIK.portrait()
  local cwv = port and (UIK.W - 0.3) / 5 or 2.6
  local cw = {cwv, cwv, cwv, cwv, cwv}
  local head = {L("Rarity"), L("Each card"), L("Tavern Crate last"), L("Legend Crate last"), L("Duplicate gives")}
  if port then head[5] = L("Duplicate gives") .. " " .. L("Balacoin") end
  local rows = {}
  local hn = {}
  for i, h in ipairs(head) do hn[#hn + 1] = head_cell(h, cw[i]) end
  rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", colour = UIK.C.section, r = 0.08}, nodes = hn}
  local function oc(str, w, colour)
    local c = cell(str, w, colour, port and 0.46 or nil)
    if port then c.config.minh = 0.82 end
    return c
  end
  for i, r in ipairs(C.RARITIES) do
    local function pct(v) return v > 0 and (v .. "%") or "-" end
    rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm"}, nodes = {
      oc(L(r.name), cw[1], TC.rarity_colour(r.key)),
      oc(pct(C.ODDS[i]), cw[2]),
      oc(pct(C.ODDS_RARE_PLUS[i]), cw[3]),
      oc(pct(C.ODDS_EPIC_PLUS[i]), cw[4]),
      oc("+" .. r.refund .. (port and "" or (" " .. L("Balacoin"))), cw[5], G.C.MONEY),
    }}
  end
  local have, all = S.counts()
  local notes = {
    L("Items you do not own yet are three times as likely."),
    L("Legend Crate: a Legendary at least every 40 cards."),
    L("Next one within") .. " " .. S.pity_left() .. " " .. L("cards"),
    L("Collection") .. ": " .. have .. " / " .. all,
  }
  if not port then
    notes[2] = notes[2] .. " " .. notes[3]
    table.remove(notes, 3)
  end
  local ns = touch() and (port and 0.44 or 0.39) or 0.34
  if port then
    local wrapped = {}
    for _, n in ipairs(notes) do
      local cur = ""
      for word in n:gmatch("%S+") do
        local try = cur == "" and word or (cur .. " " .. word)
        if cur ~= "" and UIK.text_w(try, ns) > UIK.W - 0.5 then
          wrapped[#wrapped + 1] = cur
          cur = word
        else
          cur = try
        end
      end
      if cur ~= "" then wrapped[#wrapped + 1] = cur end
    end
    notes = wrapped
    rows[#rows + 1] = {n = G.UIT.R, config = {minh = 0.3}}
  end
  for _, n in ipairs(notes) do rows[#rows + 1] = row({txt(n, ns, G.C.UI.TEXT_LIGHT, {maxw = UIK.W - 0.3})}, {h = ns + 0.12}) end
  if port then rows[#rows + 1] = {n = G.UIT.R, config = {minh = 0.3}} end
  local st = S.state() or {}
  U.fast = U.fast or {}
  U.fast.on = st.fast == true
  rows[#rows + 1] = row({UIK.toggle{label = L("Fast opening"), ref_table = U.fast, ref_value = "on", w = 5,
    callback = function(v) local s = S.state(); if s then s.fast = v and true or false end end}}, {padding = 0.1})
  return {n = G.UIT.R, config = {align = "tm", minw = UIK.W}, nodes = {
    {n = G.UIT.C, config = {align = "tm", padding = 0.04}, nodes = rows},
  }}
end

function U.shop_def(tab)
  S.invalidate()
  return UIK.window{
    id = "tavern_shop",
    title = L("MARKET"),
    tab = tab,
    tabs = {
      {key = "packs", label = L("Packs"), build = tab_packs},
      {key = "big", label = L("Jumbo and Crates"), build = tab_big},
      {key = "odds", label = L("Odds"), build = tab_odds},
    },
    back_func = "tavern_shop_back",
    back_inline = 'land',
    footer = {UIK.button{label = L("CUSTOMIZE"), button = "tavern_open_custom", colour = G.C.BLUE}},
  }
end

G.FUNCS.tavern_open_shop = function(e)
