local C = require("functions/shop/tavern_catalog")
local S = require("functions/shop/tavern_store")
local A = require("functions/shop/tavern_apply")
local TC = require("functions/shop/tavern_cards")
local FX = require("functions/shop/tavern_open_fx")

local U = {open = nil}

local function L(s) return mod_loc and mod_loc(s) or s end
local function touch() return UIK and UIK.touch and UIK.touch() end

local function txt(s, scale, colour, o)
  o = o or {}
  local t = {n = G.UIT.T, config = {text = s, scale = scale, colour = colour or G.C.UI.TEXT_LIGHT, shadow = o.shadow}}
  if o.maxw then return {n = G.UIT.C, config = {align = "cm", maxw = o.maxw}, nodes = {t}} end
  return t
end

local function row(nodes, o)
  o = o or {}
  return {n = G.UIT.R, config = {align = o.align or "cm", minw = o.w, minh = o.h, padding = o.padding or 0}, nodes = nodes}
end

local function fmt(n)
  local s = tostring(math.floor(n or 0))
  local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
  return (out:gsub("^,", ""))
end
U.fmt = fmt

local function types_lines(pack)
  if not pack.types then return {L("Everything")} end
  local parts = {}
  for _, t in ipairs(pack.types) do
    local def = C.TYPES[C.TYPE_INDEX[t]]
    parts[#parts + 1] = L(def and def.plural or t)
  end
  if touch() then return parts end
  local lines = {}
  for i = 1, #parts, 2 do
    lines[#lines + 1] = parts[i + 1] and (parts[i] .. ", " .. parts[i + 1] .. (parts[i + 2] and "," or "")) or parts[i]
  end
  return lines
end

local function types_rows(pack, w, scale)
  local rows = {}
  for _, line in ipairs(types_lines(pack)) do
    rows[#rows + 1] = row({txt(line, scale, G.C.UI.TEXT_INACTIVE, {maxw = w - 0.2})}, {w = w, h = touch() and scale + 0.04 or 0.26})
  end
  return rows
end

local function extra_text(pack)
  if S.pool_size(pack) == 0 then return L("Nothing to find yet") end
  if pack.last == "rare" then return L("Last card Rare or better") end
  if pack.last == "epic" then return L("Last card Epic or better") end
  local have, all = S.pack_progress(pack)
  return L("Owned") .. " " .. have .. " / " .. all
end

local function odds_row(pack)
  local odds = pack.last and C.pack_odds(pack, pack.cards) or C.ODDS
  local nodes = {}
  for i, w in ipairs(odds) do
    if w > 0 then
      if #nodes > 0 then nodes[#nodes + 1] = {n = G.UIT.C, config = {minw = 0.12}, nodes = {}} end
      nodes[#nodes + 1] = {n = G.UIT.C, config = {align = "cm"}, nodes = {txt(w .. "%", touch() and 0.42 or 0.28, TC.rarity_colour(C.RARITIES[i].key))}}
    end
  end
  return nodes
end

