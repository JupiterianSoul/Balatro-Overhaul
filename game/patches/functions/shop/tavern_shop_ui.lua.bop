  G.FUNCS.overlay_menu{definition = open_def()}
  if o.phase == "pack" then
    local pack_card = Card(0, 0, G.CARD_W * 1.27, G.CARD_H * 1.27, G.P_CARDS.empty, G.P_CENTERS.p_arcana_normal_1, {bypass_discovery_center = true, bypass_discovery_ui = true})
    local art = S.art.packs and S.art.packs[pack.art]
    local a = art and A.atlas("tavern_packs")
    if a then
      pack_card.children.center.atlas = a
      pack_card.children.center:set_sprite_pos(art)
    else
      pack_card.children.center:set_sprite_pos(pack.booster)
    end
    pack_card.states.drag.can = false
    pack_card.states.hover.can = false
    pack_card.states.collide.can = false
    pack_card.hover = function(self) Node.hover(self) end
    o.pack_area:emplace(pack_card)
    o.pack_card = pack_card
    FX.play(o, pack_card, function() return U.open == o end, function()
      o.phase = "cards"
      UIK.refresh()
      FX.clear(o)
      deal(o)
    end)
  else
    deal(o)
  end
end

G.FUNCS.tavern_reveal_all = function() U.reveal_all() end

G.FUNCS.tavern_open_again = function()
  local o = U.open
  if not (o and o.done) then return end
  if S.balance() < o.pack.price then
    pcall(play_sound, "cancel", 1, 0.6)
    return
  end
  U.start_open(o.pack)
end

G.FUNCS.tavern_btn_state = function(e)
  local r = e.config.ref_table or {}
  local o = U.open
  local on = true
  if r.kind == "reveal" then on = o and not o.done and o.phase == "cards"
  elseif r.kind == "again" then on = o and o.done and S.balance() >= o.pack.price
  elseif r.kind == "custom" then on = o and o.done end
  r.base = r.base or e.config.colour
  r.btn = r.btn or e.config.button
  e.config.colour = on and r.base or G.C.UI.BACKGROUND_INACTIVE
  e.config.button = on and r.btn or nil
end

G.FUNCS.tavern_equip_state = function(e)
  local col = e.config.ref_table
  local it = col and col.res and col.res.item
  local can = col and col.revealed and it and it.type ~= "deck"
  local eq = can and S.is_equipped(it)
  e.config.colour = can and (eq and G.C.GREEN or G.C.BLUE) or G.C.UI.BACKGROUND_INACTIVE
  e.config.button = (can and not eq) and "tavern_equip_drawn" or nil
  if can then col.btn = eq and L("EQUIPPED") or L("EQUIP") end
end

G.FUNCS.tavern_equip_drawn = function(e)
  local col = e.config.ref_table
  local it = col and col.res and col.res.item
  if not it then return end
  if S.equip(it) then
    pcall(play_sound, "card1", 1.1, 0.6)
    if U.open then
      for _, c in ipairs(U.open.cols) do
        if c.revealed then c.btn = S.is_equipped(c.res.item) and L("EQUIPPED") or L("EQUIP") end
      end
    end
  end
end

G.FUNCS.tavern_open_custom = function(e)
  local it
  local o = U.open
  if o and o.done then
    for _, c in ipairs(o.cols) do
      if not c.res.dupe then it = c.res.item break end
    end
    it = it or (o.cols[1] and o.cols[1].res.item)
  end
  local tab
  if it and Tavern and Tavern.custom then
    for _, t in ipairs(Tavern.custom.TABS) do
      for _, ty in ipairs(t.types) do if ty == it.type then tab = tab or t.key end end
    end
  end
  if G.FUNCS.tavern_custom then return G.FUNCS.tavern_custom({config = {ref_table = {from = "shop", tab = tab}}}) end
  if G.FUNCS.open_profile_menu then return G.FUNCS.open_profile_menu(e) end
end

return U
end
