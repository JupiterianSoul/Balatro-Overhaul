G.FUNCS.tavern_shop_back = function(e)
  if G.FUNCS.open_tavern_hub then return G.FUNCS.open_tavern_hub(e) end
  G.FUNCS.exit_overlay_menu(e)
end

G.FUNCS.tavern_buy_pack = function(e)
  local ref = e and e.config and e.config.ref_table or {}
  local pack = ref.id and C.PACK_BY_ID[ref.id]
  if not pack then return end
  if S.balance() < pack.price then
    pcall(play_sound, "cancel", 1, 0.6)
    return
  end
  if pack.price >= 500 and not ref.confirmed then return U.confirm(pack) end
  U.start_open(pack)
end

function U.confirm(pack)
  U.pending = pack
  G.FUNCS.overlay_menu{definition = UIK.window{
    id = "tavern_confirm",
    compact = true,
    w = 7,
    title = L(pack.name),
    tabs = {{key = "c", label = "", build = function()
      return UIK.stack({
        row({U.pack_sprite(pack, 0.9)}, {padding = 0.1}),
        row({txt(L("Open it for") .. " " .. fmt(pack.price) .. " " .. L("Balacoin") .. "?", 0.36, G.C.WHITE, {maxw = 6.4})}, {h = 0.5}),
        row({txt(fmt(S.balance()) .. " " .. L("Balacoin"), 0.3, G.C.MONEY)}, {h = 0.4}),
      }, {w = 7})
    end}},
    back_func = "tavern_open_shop",
    footer = {UIK.button{label = L("OPEN"), button = "tavern_confirm_yes", colour = G.C.MONEY}},
  }}
end

G.FUNCS.tavern_confirm_yes = function()
  local pack = U.pending
  U.pending = nil
  if pack then G.FUNCS.tavern_buy_pack({config = {ref_table = {id = pack.id, confirmed = true}}}) end
end

G.FUNCS.tavern_col_state = function(e)
  local col = e.config.ref_table
  local want = (col and col.revealed) and 1.4 or 0
  if e.config.outline ~= want then e.config.outline = want end
end

local function rarity_sound(rk)
  local i = C.RARITY_INDEX[rk] or 1
  if i >= 5 then
    pcall(play_sound, "polychrome1", 1.2, 0.7)
    pcall(play_sound, "explosion_release1", 1.0, 0.45)
  elseif i == 4 then
    pcall(play_sound, "polychrome1", 1.0, 0.6)
  elseif i == 3 then
    pcall(play_sound, "holo1", 1.0, 0.55)
  elseif i == 2 then
    pcall(play_sound, "foil1", 1.0, 0.5)
  else
    pcall(play_sound, "tarot2", 1.0, 0.45)
  end
end

local function ev(delay, fn)
  G.E_MANAGER:add_event(Event({trigger = "after", delay = delay, blockable = false, blocking = false, timer = "REAL", func = function()
    fn()
    return true
  end}))
end

local function fast() local st = S.state(); return st and st.fast end

function U.reveal(i)
  local o = U.open
  if not o or not o.cols[i] or o.cols[i].shown then return end
  local col = o.cols[i]
  col.shown = true
  local card = col.card
  if card and not card.REMOVED then
    card:flip()
    pcall(play_sound, "card1", 0.9 + 0.05 * i, 0.6)
  end
  ev(fast() and 0.05 or 0.18, function()
    if U.open ~= o then return end
    local r = col.res
    local it = r.item
    col.name = TC.name(it)
    col.kind = L((C.TYPES[C.TYPE_INDEX[it.type]] or {}).name or it.type)
    col.rarity = L((C.RARITIES[C.RARITY_INDEX[it.rarity]] or {}).name or "")
    col.status = r.dupe and ("+" .. r.refund .. " " .. L("Balacoin")) or L("NEW")
    col.btn = S.is_equipped(it) and L("EQUIPPED") or L("EQUIP")
    col.revealed = true
    if card and not card.REMOVED then
      card:juice_up(0.5, 0.4)
      local ri = C.RARITY_INDEX[it.rarity] or 1
      if ri >= 4 and G.ROOM then G.ROOM.jiggle = (G.ROOM.jiggle or 0) + (ri >= 5 and 1.2 or 0.5) end
      if ri >= 3 and Particles then
        local p = Particles(1, 1, 0, 0, {timer = 0.015, scale = 0.3, initialize = true, lifespan = 0.9, speed = 3 + ri, padding = -1,
          attach = card, colours = {TC.rarity_colour(it.rarity), G.C.WHITE}, fill = true})
        ev(0.6, function() if p and not p.REMOVED then p:fade(0.4) end end)
        ev(1.1, function() if p and not p.REMOVED then p:remove() end end)
      end
    end
    rarity_sound(it.rarity)
    o.left = o.left - 1
    if o.left <= 0 then o.done = true end
  end)
end

function U.reveal_all()
  local o = U.open
  if not o then return end
  for i = 1, #o.cols do
    if not o.cols[i].shown then ev((i - 1) * 0.06, function() if U.open == o then U.reveal(i) end end) end
  end
end

local function deal(o)
  local step = fast() and 0.04 or 0.14
  for i, col in ipairs(o.cols) do
    ev(step * i, function()
      if U.open ~= o then return end
      local card = TC.make(col.res.item, G.CARD_W, G.CARD_H)
      card.facing = "back"
      card.sprite_facing = "back"
      local at = o.burst_at
      if at then
        card:hard_set_T(at.x - card.T.w / 2, at.y - card.T.h / 2, card.T.w, card.T.h)
        card.VT.scale = 0.3
      else
        card:hard_set_T(col.area.T.x + col.area.T.w / 2 - card.T.w / 2, G.ROOM.T.h + 2, card.T.w, card.T.h)
      end
      col.area:emplace(card, nil, true)
      col.card = card
      pcall(play_sound, "card1", 1 + 0.04 * i, 0.5)
    end)
  end
  local start = step * #o.cols + (fast() and 0.1 or 0.45)
  local gap = fast() and 0.06 or 0.42
  for i = 1, #o.cols do
    ev(start + gap * (i - 1), function() if U.open == o then U.reveal(i) end end)
  end
end

local function open_body()
  local o = U.open
  if not o then return {n = G.UIT.R, config = {}, nodes = {}} end
  if o.phase == "pack" then
    o.pack_area = TC.area(G.CARD_W * 1.4, G.CARD_H * 1.4, 1)
    return {n = G.UIT.R, config = {align = "cm", minw = UIK.W, minh = UIK.H - 0.3}, nodes = {
      {n = G.UIT.C, config = {align = "cm"}, nodes = {
        row({{n = G.UIT.O, config = {object = o.pack_area}}}, {padding = 0.1}),
        row({txt(L(o.pack.name), 0.45, G.C.WHITE, {shadow = true})}, {h = 0.6}),
      }},
    }}
  end
  local t = touch()
  local per = (UIK.portrait and UIK.portrait() and #o.cols > 3) and 3 or #o.cols
  local n = per
  local gap = 0.15
  local w = math.min(3.6, (UIK.W - 0.3 - gap * (n - 1)) / n)
  local nodes = {}
  local grid = {}
  for i, col in ipairs(o.cols) do
    col.area = TC.area(G.CARD_W * 1.05, G.CARD_H * 1.05, 1)
    col.name = col.name or "?"
    col.kind = col.kind or ""
    col.rarity = col.rarity or ""
    col.status = col.status or ""
    col.btn = col.btn or L("EQUIP")
    local rc = TC.rarity_colour(col.res.item.rarity)
    if #nodes > 0 then nodes[#nodes + 1] = {n = G.UIT.C, config = {minw = gap}, nodes = {}} end
    nodes[#nodes + 1] = {n = G.UIT.C, config = {align = "tm", minw = w, padding = 0.04, r = 0.12, colour = UIK.C.section, emboss = 0.04,
      func = "tavern_col_state", ref_table = col, outline = 0, outline_colour = rc}, nodes = {
      row({{n = G.UIT.O, config = {object = col.area}}}, {w = w, padding = 0.06}),
      row({{n = G.UIT.C, config = {align = "cm", maxw = w - 0.2}, nodes = {{n = G.UIT.T, config = {ref_table = col, ref_value = "name", scale = t and 0.44 or 0.34, colour = G.C.WHITE, shadow = true}}}}}, {w = w, h = t and 0.5 or 0.4}),
      row({{n = G.UIT.C, config = {align = "cm", maxw = w - 0.2}, nodes = {{n = G.UIT.T, config = {ref_table = col, ref_value = "kind", scale = t and 0.39 or 0.27, colour = G.C.UI.TEXT_INACTIVE}}}}}, {w = w, h = t and 0.44 or 0.3}),
      row({{n = G.UIT.C, config = {align = "cm", maxw = w - 0.2}, nodes = {{n = G.UIT.T, config = {ref_table = col, ref_value = "rarity", scale = t and 0.39 or 0.3, colour = rc}}}}}, {w = w, h = t and 0.44 or 0.32}),
      row({{n = G.UIT.C, config = {align = "cm", maxw = w - 0.2}, nodes = {{n = G.UIT.T, config = {ref_table = col, ref_value = "status", scale = t and 0.39 or 0.32, colour = col.res.dupe and G.C.MONEY or G.C.GOLD, shadow = true}}}}}, {w = w, h = t and 0.44 or 0.36}),
      row({{n = G.UIT.C, config = {align = "cm", minw = w - 0.35, minh = touch() and 0.8 or 0.62, r = 0.1, hover = true, shadow = true, colour = G.C.UI.BACKGROUND_INACTIVE,
        button = "tavern_equip_drawn", func = "tavern_equip_state", ref_table = col, focus_args = {nav = "wide"}}, nodes = {
        {n = G.UIT.T, config = {ref_table = col, ref_value = "btn", scale = touch() and 0.42 or 0.36, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
      }}}, {w = w, padding = 0.06}),
    }}
    if i % per == 0 or i == #o.cols then
      grid[#grid + 1] = {n = G.UIT.R, config = {align = "tm", padding = 0.05}, nodes = nodes}
      nodes = {}
    end
  end
  local out = {balance_row()}
  for _, r in ipairs(grid) do out[#out + 1] = r end
  return {n = G.UIT.R, config = {align = "tm", minw = UIK.W}, nodes = out}
end

local function open_def()
  local o = U.open
  local next_ok = {}
  return UIK.window{
    id = "tavern_open",
    title = L(o.pack.name),
    tabs = {{key = "open", label = L(o.pack.name), build = open_body}},
    back_func = "tavern_open_shop",
    footer = {
      UIK.button{label = L("REVEAL ALL"), button = "tavern_reveal_all", colour = G.C.ORANGE, func = "tavern_btn_state", ref_table = {kind = "reveal"}},
      UIK.button{label = L("BUY ANOTHER") .. "  " .. fmt(o.pack.price), button = "tavern_open_again", colour = G.C.MONEY, func = "tavern_btn_state", ref_table = {kind = "again", ok = next_ok}},
      UIK.button{label = L("CUSTOMIZE"), button = "tavern_open_custom", colour = G.C.BLUE, func = "tavern_btn_state", ref_table = {kind = "custom"}},
    },
  }
end

function U.start_open(pack)
  local res, err = S.open(pack.id)
  if not res then
    pcall(play_sound, "cancel", 1, 0.6)
    print("[TAVERN] open failed: " .. tostring(err))
    return
  end
  local o = {pack = pack, res = res, cols = {}, left = #res.cards, phase = fast() and "cards" or "pack"}
  for i, r in ipairs(res.cards) do o.cols[i] = {res = r, i = i} end
  U.open = o
