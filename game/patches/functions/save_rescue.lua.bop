SaveRescue = SaveRescue or {}
local R = SaveRescue
local SIO = require("functions/save_io")

R.DIR = "backups"
R.STATE = "backups/rescue.txt"
R.KEEP = 6
R.SCAN = 10
R.MIN_ROUNDS = 10

local fs = love.filesystem

local function L(s)
  return mod_loc and mod_loc(s) or s
end

local function keep_settings(name)
  return SIO.skip(name) and not SIO.SKIP_FILES[name]
end

function R.read_state()
  local st = {since = 0, declined = {}}
  local raw = fs.read(R.STATE) or ""
  for line in raw:gmatch("[^\r\n]+") do
    local k, v = line:match("^(%S+)%s+(.+)$")
    if k == "since" then st.since = math.max(st.since, tonumber(v) or 0)
    elseif k == "declined" then st.declined[v] = true end
  end
  return st
end

local function append_state(line)
  fs.createDirectory(R.DIR)
  local raw = fs.read(R.STATE) or ""
  fs.write(R.STATE, raw .. line .. "\n")
end

function R.mark_reset(when)
  pcall(append_state, "since " .. tostring(when or os.time()))
end

function R.decline(name)
  pcall(append_state, "declined " .. tostring(name))
end

function R.score_of(p)
  if type(p) ~= "table" or p.deleted then return {rounds = 0, wins = 0, level = 0} end
  local cs = type(p.career_stats) == "table" and p.career_stats or {}
  local pr = type(p.progression) == "table" and p.progression or {}
  return {rounds = tonumber(cs.c_rounds) or 0, wins = tonumber(cs.c_wins) or 0, level = tonumber(pr.level) or 0}
end

function R.lost(now, back)
  if back.rounds < R.MIN_ROUNDS then return false end
  if now.rounds * 2 > back.rounds then return false end
  return back.level >= now.level
end

function R.auto_name(when)
  return R.DIR .. "/auto-" .. os.date("%Y-%m-%d", when or os.time()) .. ".zip"
end

function R.prune()
  local autos = {}
  for _, name in ipairs(fs.getDirectoryItems(R.DIR)) do
    if name:match("^auto%-%d+%-%d+%-%d+%.zip$") then autos[#autos + 1] = name end
  end
  table.sort(autos, function(a, b) return a > b end)
  for i = R.KEEP + 1, #autos do fs.remove(R.DIR .. "/" .. autos[i]) end
end

function R.snapshot(slot, when)
  local now = R.score_of(G.PROFILES and G.PROFILES[slot])
  if now.rounds <= 0 then return nil end
  local name = R.auto_name(when)
  if fs.getInfo(name) then return nil end
  local files = SIO.collect(fs, "", keep_settings)
  if not next(files) then return nil end
  fs.createDirectory(R.DIR)
  local data = SIO.zip(SIO.entries(files))
  if not fs.write(name, data) then return nil end
  R.prune()
  return name
end

function R.backups()
  local out = {}
  for _, name in ipairs(fs.getDirectoryItems(R.DIR)) do
    local rel = R.DIR .. "/" .. name
    local info = fs.getInfo(rel)
    if name:lower():match("%.zip$") and info and info.type == "file" then
      out[#out + 1] = {rel = rel, name = name, time = info.modtime or 0}
    end
  end
  table.sort(out, function(a, b)
    if a.time ~= b.time then return a.time > b.time end
    return a.name > b.name
  end)
  return out
end

function R.find(slot)
  local st = R.read_state()
  local now = R.score_of(G.PROFILES and G.PROFILES[slot])
  local best
  for i, e in ipairs(R.backups()) do
    if i > R.SCAN then break end
    if not st.declined[e.name] and e.time >= st.since then
      local files = SaveTransfer and SaveTransfer.read(fs.read(e.rel) or "", e.name)
      local p = files and SIO.read_jkr(files[slot .. "/profile.jkr"])
      if p then
        local back = R.score_of(p)
        if R.lost(now, back) and (not best or back.rounds > best.score.rounds) then
          best = {name = e.name, rel = e.rel, time = e.time, files = files, score = back}
        end
      end
    end
  end
  if best then best.now, best.slot = now, slot end
  return best
end

function R.restore_files(found)
  local slot = tostring(found.slot)
  local out = {}
  for name, data in pairs(found.files) do
    if SIO.slot_of(name) == slot then out[name] = data end
  end
  for _, pair in ipairs(SIO.MODDED) do
    if pair[1] == slot then
      for _, f in ipairs({"profile.jkr", "meta.jkr"}) do
        local cur = fs.read(pair[2] .. "/" .. f)
        if cur and cur ~= "" then out[pair[2] .. "/" .. f] = cur end
      end
    end
  end
  return out
end

local function score_text(s)
  return string.format(L("Level %d, %d rounds, %d wins"), math.max(1, s.level), s.rounds, s.wins)
end

function R.window(found)
  local w = UIK.portrait() and 7.2 or 8.6
  return UIK.window{
    id = 'save_rescue', title = L("RESTORE YOUR PROGRESS?"), compact = true, w = w + 0.6,
    back_func = 'save_rescue_later',
    build = function()
      local rows = {
        UIK.note({L("Your profile has much less progress than a copy the game made earlier."), L("This can happen when the game closes while saving.")}, {w = w}),
        UIK.value{label = L("Now"), value = score_text(found.now), w = w, vw = w - 2},
        UIK.value{label = L("Copy"), value = score_text(found.score), info = os.date("%Y-%m-%d %H:%M", found.time), w = w, vw = w - 2},
        UIK.note({L("Your current profile is backed up first. The game restarts to load the copy.")}, {w = w}),
      }
      return UIK.stack(rows, {w = w})
    end,
    footer = {
      UIK.button{label = L("RESTORE"), button = 'save_rescue_restore', ref_table = found, colour = UIK.C.ok, w = 3},
      UIK.button{label = L("KEEP THIS ONE"), button = 'save_rescue_keep', ref_table = found, colour = UIK.C.accent, w = 3},
    },
  }
end

function R.offer(found)
  R.found = found
