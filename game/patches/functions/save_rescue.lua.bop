if not R.hooked then
  R.hooked = true
  local main_menu_ui = set_main_menu_UI
  function set_main_menu_UI(...)
    local ret = {main_menu_ui(...)}
    pcall(R.watch)
    return unpack(ret)
  end
  local delete_profile = G.FUNCS.delete_profile
  if delete_profile then
    G.FUNCS.delete_profile = function(...)
      R.mark_reset()
      return delete_profile(...)
    end
  end
  if Game and Game.empty_profile then
    local empty_profile = Game.empty_profile
    function Game:empty_profile(...)
      R.mark_reset()
      return empty_profile(self, ...)
    end
  end
  if SaveTransfer and SaveTransfer.just_imported then R.mark_reset() end
end

