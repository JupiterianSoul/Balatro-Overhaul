local function menu_ready()
  if not (G.STAGES and G.STAGE == G.STAGES.MAIN_MENU and G.MAIN_MENU_UI) then return false end
  if G.OVERLAY_MENU or G.OVERLAY_TUTORIAL then return false end
  local S = G.SETTINGS
  if not S or not S.language_chosen then return false end
  return true
end

function R.check()
  local slot = G.SETTINGS and G.SETTINGS.profile
  if not slot or not G.PROFILES then return end
  local found = R.find(slot)
  if found then
    print(string.format("[SAVES] rescue: profile %s has %d rounds, %s has %d", tostring(slot), found.now.rounds, found.name, found.score.rounds))
    R.offer(found)
    return found
  end
  R.snapshot(slot)
end

function R.watch()
  if R.watching or R.checked then return end
  R.watching = true
  local started = G.TIMERS.REAL
r 1 112 %20%20 -
l 19
    blocking = false, blockable = false, no_delete = true, timer = 'REAL',
    func = function()
      if R.checked then R.watching = false return true end
      if G.TIMERS.REAL - started > 600 then R.watching = false return true end
      if G.TIMERS.REAL - started < 1.5 or not menu_ready() then return false end
      R.checked, R.watching = true, false
      local ok, err = pcall(R.check)
      if not ok then print("[SAVES] rescue check failed: " .. tostring(err)) end
      return true
    end,
  }))
end

G.FUNCS.save_rescue_restore = function(e)
  local found = e and e.config and e.config.ref_table or R.found
  if not found then return end
  local files = R.restore_files(found)
  if SaveTransfer and SaveTransfer.load({files = files, name = found.name}) then return end
  R.decline(found.name)
