l 24
  if e.config.object then e.config.object:remove() end
  e.config.object = UIBox{definition = UI.footer_def(win._cur), config = {offset = {x = 0, y = 0}, parent = e, type = "cm"}}
  G.OVERLAY_MENU:recalculate()
end

function UI.definition(tab)
  local tabs = UI.tabs()
  local cur = tab or UIK._last_tab.forge
  local found = false
  for _, t in ipairs(tabs) do if t.key == cur then found = true end end
  if not found then cur = "my" end
  return UIK.window{
    id = "forge",
    title = mod_loc("THE FORGE"),
    tabs = tabs,
    tab = cur,
    back_func = "forge_back",
    back_inline = 'land',
    footer = function() return {{n = G.UIT.O, config = {id = "forge_footer", object = UIBox{definition = UI.footer_def(UIK._last_tab.forge or cur), config = {offset = {x = 0, y = 0}}}}}} end,
  }
end

