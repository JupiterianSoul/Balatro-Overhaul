local Store = require("functions/forge/forge_store")
local FJ = require("functions/forge/forge_joker")

local UI = {}

UI.PER_PAGE = 4
UI.state = UI.state or {from = nil, page = 1, pending_delete = nil}
UI.tabs_extra = UI.tabs_extra or {}

local function touch() return UIK.touch() end
local function col_w() return UIK.portrait() and 3.85 or touch() and 3.4 or 3.3 end
local function small_h() return touch() and 0.82 or 0.62 end
local function small_scale() return touch() and 0.44 or 0.4 end

local function fit_scale(label, w, scale)
  local lw = UIK.text_w(label, scale)
  if lw > w - 0.25 then return scale * (w - 0.25) / lw end
  return scale
end

function UI.card_node(c, o)
  o = o or {}
  local center = c and FJ.center_of(c.id)
  local s = o.scale or 1
  local w, h = G.CARD_W * s, G.CARD_H * s
  if not center then return {n = G.UIT.R, config = {align = "cm", minw = w, minh = h}, nodes = {}} end
  local area = CardArea(G.ROOM.T.x, G.ROOM.T.y, w, h, {card_limit = 1, type = "title", highlight_limit = 0, collection = true})
  local card = Card(area.T.x, area.T.y, w, h, nil, center)
  card.forge_preview = true
  if o.still then
r 9 1460 %20%20%20%20 -
r 6 220 %20%20%20%20 -
l 239
  end
  area:emplace(card)
  return {n = G.UIT.R, config = {align = "cm", minw = w, minh = h, padding = 0}, nodes = {{n = G.UIT.O, config = {object = area}}}}
end

local function name_line(c, w)
  return {n = G.UIT.R, config = {align = "cm", minw = w, minh = touch() and 0.5 or 0.45, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = "cm", maxw = w - 0.1}, nodes = {UIK.text(c.name, {scale = touch() and 0.44 or 0.4, colour = c.enabled and UIK.C.text or UIK.C.muted})}},
  }}
end

local function small_button(label, func, id, colour, w)
  return UIK.button{label = label, button = func, ref_table = {id = id}, colour = colour, w = w, h = small_h(), scale = fit_scale(label, w, small_scale()), col = true}
end

function UI.item_node(c, o)
  o = o or {}
  local s = o.scale or 1
  local w, h = G.CARD_W * s, G.CARD_H * s
  local Cat = require("functions/forge/forge_catalog")
  local k = Cat.kind(c.kind)
  local a = c.art or {}
  local spr
  if a.file and love.filesystem.getInfo(a.file) then
    local ok, data = pcall(love.image.newImageData, a.file)
    if ok and data and data:getWidth() == 71 and data:getHeight() == 95 then
      local atlas = FJ.atlas_from_data("forge_" .. c.id, data)
      if atlas then spr = Sprite(0, 0, w, h, atlas, {x = 0, y = 0}) end
    end
  end
  if not spr and a.atlas and G.ANIMATION_ATLAS[a.atlas] then
    spr = AnimatedSprite(0, 0, 1.1 * s * 1.3, 1.1 * s * 1.3, G.ANIMATION_ATLAS[a.atlas], {x = a.x or 0, y = a.y or 0})
  elseif not spr and a.atlas and G.ASSET_ATLAS[a.atlas] then
    local small = k.shape == "tag" or k.shape == "stake"
    spr = Sprite(0, 0, small and 0.9 * s * 1.3 or w, small and 0.9 * s * 1.3 or h, G.ASSET_ATLAS[a.atlas], {x = a.x or 0, y = a.y or 0})
  end
  local B = rawget(_G, "ForgeBuilder")
  if not spr and B and B.sprite then spr = B.sprite(c.kind, k.sample, s) end
  if not spr then return {n = G.UIT.R, config = {align = "cm", minw = w, minh = h}, nodes = {}} end
  spr.states.drag.can = false
  spr.states.collide.can = false
  return {n = G.UIT.R, config = {align = "cm", minw = w, minh = h, padding = 0}, nodes = {{n = G.UIT.O, config = {object = spr}}}}
end

function UI.any_node(c, o)
  if c and c.kind and c.kind ~= "joker" then return UI.item_node(c, o) end
  return UI.card_node(c, o)
end

function UI.filtered()
  local k = UI.state.kind
  if k == nil or k == "all" then
    local out = {}
    for _, c in ipairs(Store.all()) do out[#out + 1] = c end
    for _, c in ipairs(Store.items()) do out[#out + 1] = c end
    return out
  end
  return Store.of_kind(k)
end

local function creation_column(c)
  local w = col_w()
  local half = (w - 0.12) / 2
  local dw, xw = (w - 0.12) * 0.58, (w - 0.12) * 0.42
  local box = {on = c.enabled}
  return {n = G.UIT.C, config = {align = "tm", minw = w, padding = 0.04}, nodes = {
    UI.any_node(c, {scale = UIK.portrait() and 0.95 or touch() and 0.86 or 1}),
    name_line(c, w),
    UIK.toggle{label = mod_loc("Use in runs"), ref_table = box, ref_value = "on", w = w, callback = function(v) UI.set_enabled(c.id, v) end},
    {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.03}, nodes = {small_button(mod_loc("Edit"), "forge_edit", c.id, UIK.C.accent, w)}},
    {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.03}, nodes = {
      small_button(mod_loc("Duplicate"), "forge_duplicate", c.id, UIK.C.ok, dw),
      {n = G.UIT.C, config = {minw = 0.12}, nodes = {}},
      small_button(mod_loc("Delete"), "forge_delete", c.id, UIK.C.danger, xw),
    }},
  }}
end

function UI.set_enabled(id, on)
  if Store.get(id) then
    Store.set_enabled(id, on)
    FJ.refresh(id)
  else
    local c = Store.get_item(id)
    if c then c.enabled = on and true or false; Store.save_items() end
    local K = rawget(_G, "ForgeKinds")
    if K and K.refresh then pcall(K.refresh, id) end
  end
  play_sound("generic1", on and 1.1 or 0.9, 0.5)
  UIK.refresh()
end

local function wrap_lines(list, w, scale)
  local out = {}
  for _, str in ipairs(type(list) == "table" and list or {list}) do
    local cur = ""
    for word in tostring(str):gmatch("%S+") do
      local try = cur == "" and word or (cur .. " " .. word)
      if cur ~= "" and UIK.text_w(try, scale) > w then
        out[#out + 1] = cur
        cur = word
      else
        cur = try
      end
    end
    if cur ~= "" then out[#out + 1] = cur end
  end
  return out
end

local function empty_body()
  local port = UIK.portrait()
  local lines = {mod_loc("Make jokers, tarots, decks, blinds and more,"), mod_loc("with their own rules and art, and play them in your runs.")}
  local ns = touch() and (port and 0.5 or 0.42) or 0.31
  if port then lines = wrap_lines({table.concat(lines, " ")}, UIK.W - 0.8, ns) end
  return {n = G.UIT.R, config = {align = "cm", minw = UIK.W, minh = UIK.H - 0.4, padding = 0.1}, nodes = {
    {n = G.UIT.C, config = {align = "cm", padding = 0.1}, nodes = {
      {n = G.UIT.R, config = {align = "cm", padding = 0.08}, nodes = {UIK.text(mod_loc("Nothing made yet"), {scale = port and 0.8 or 0.6, colour = UIK.C.title})}},
      UIK.note(lines, {w = math.min(9, UIK.W - 0.4), scale = touch() and ns or nil}),
      {n = G.UIT.R, config = {align = "cm", padding = 0.2}, nodes = {UIK.button{label = mod_loc("MAKE SOMETHING"), button = "forge_new", colour = UIK.C.ok, w = port and 6 or 4, h = port and 1.2 or nil, scale = port and 0.6 or nil}}},
    }},
  }}
end

local function kind_filter()
  local Cat = require("functions/forge/forge_catalog")
  local values, labels, cur = {"all"}, {string.format("%s (%d)", mod_loc("Everything"), Store.count())}, 1
  for _, k in ipairs(Cat.KINDS) do
    local n = Store.count(k.id)
    if n > 0 or UI.state.kind == k.id then
      values[#values + 1] = k.id
      labels[#labels + 1] = string.format("%s (%d)", mod_loc(k.plural), n)
      if UI.state.kind == k.id then cur = #values end
    end
  end
  return {n = G.UIT.R, config = {align = "cm", minw = UIK.W, padding = 0.02}, nodes = {
    UIK.cycle{options = labels, current = cur, w = touch() and 5.4 or 5, cw = touch() and 5.2 or 4.8, no_pips = true, callback = function(i)
      UI.state.kind = values[i]
      UI.state.page = 1
      UIK.refresh()
    end},
  }}
end

function UI.my_tab()
  if Store.count() == 0 then return empty_body() end
  local list = UI.filtered()
  local pages = math.max(1, math.ceil(#list / UI.PER_PAGE))
  UI.state.page = math.min(math.max(1, UI.state.page or 1), pages)
  local first = (UI.state.page - 1) * UI.PER_PAGE
  local cols = {}
  for i = first + 1, math.min(first + UI.PER_PAGE, #list) do
    if #cols > 0 then cols[#cols + 1] = {n = G.UIT.C, config = {minw = 0.2}, nodes = {}} end
    cols[#cols + 1] = creation_column(list[i])
  end
  local grid = {{n = G.UIT.R, config = {align = "tm", minw = UIK.W, padding = 0}, nodes = cols}}
  if UIK.portrait() then
    grid = {}
    for i = 1, #cols, 4 do
      if i > 1 then grid[#grid + 1] = {n = G.UIT.R, config = {minh = 0.3}, nodes = {}} end
      grid[#grid + 1] = {n = G.UIT.R, config = {align = "tm", minw = UIK.W, padding = 0}, nodes = {cols[i], cols[i + 1], cols[i + 2]}}
    end
  end
  local nodes = {kind_filter()}
  for _, r in ipairs(grid) do nodes[#nodes + 1] = r end
  if pages > 1 then
    nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", minw = UIK.W, padding = 0.05}, nodes = {
      UIK.pager{prev = "forge_page", next = "forge_page", prev_ref = {d = -1}, next_ref = {d = 1}, text = string.format(mod_loc("Page %d of %d"), UI.state.page, pages), w = UIK.W},
    }}
  end
  return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, padding = 0}, nodes = {{n = G.UIT.C, config = {align = "tm", padding = 0}, nodes = nodes}}}
end

function UI.placeholder(title, lines)
  return {n = G.UIT.R, config = {align = "cm", minw = UIK.W, minh = UIK.H - 0.4, padding = 0.1}, nodes = {
    {n = G.UIT.C, config = {align = "cm", padding = 0.1}, nodes = {
      {n = G.UIT.R, config = {align = "cm", padding = 0.08}, nodes = {UIK.text(title, {scale = 0.55, colour = UIK.C.title})}},
      UIK.note(lines, {w = 9}),
    }},
  }}
end

function UI.builder_tab()
  local B = rawget(_G, "ForgeBuilder")
  if B and B.tab then return B.tab() end
  return UI.placeholder(mod_loc("Builder"), {mod_loc("Rules, name, rarity and cost of a joker.")})
end

function UI.pixel_tab()
  local P = rawget(_G, "ForgePixelUI")
  UI.tabs_extra.pixel = P and P.footer or nil
  if P and P.tab then return P.tab() end
  return UI.placeholder(mod_loc("Pixel editor"), {mod_loc("Draw or touch up a joker's art.")})
end

function UI.tabs()
  local tabs = {
    {key = "my", label = mod_loc("Creations"), build = UI.my_tab},
    {key = "builder", label = mod_loc("Builder"), build = UI.builder_tab},
    {key = "pixel", label = mod_loc("Pixel editor"), build = UI.pixel_tab},
  }
  return tabs
end

function UI.footer(tab)
  local extra = UI.tabs_extra[tab]
  if extra then
    local ok, r = pcall(extra)
    if ok and type(r) == "table" then return r end
  end
  if tab == "my" and Store.count() > 0 then
    return {UIK.button{label = mod_loc("MAKE SOMETHING"), button = "forge_new", colour = UIK.C.ok}, UIK.button{label = mod_loc("EXPORT A MOD"), button = "forge_export_open", colour = UIK.C.warn, id = "forge_export_open"}}
  end
  return nil
end

function UI.footer_def(tab)
  local list = UI.footer(tab) or {}
  local nodes = {}
  local per = (UIK.portrait() and #list > 2) and 2 or #list
  local rows, cur = {}, nodes
  for i, b in ipairs(list) do
    if per < #list and (i - 1) % per == 0 then
      cur = {}
      rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.06}, nodes = cur}
    elseif i > 1 then
      cur[#cur + 1] = {n = G.UIT.C, config = {minw = 0.24}, nodes = {}}
    end
    if b.n == G.UIT.R then b.n = G.UIT.C end
    cur[#cur + 1] = b
  end
  if #rows > 0 then nodes = {{n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = rows}} end
  return {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR, minh = touch() and 0.9 or 0.78, padding = 0}, nodes = nodes}
end

function UI.refresh_footer()
  local win = UIK._win
  if not (win and win.id == "forge" and G.OVERLAY_MENU) then return end
  local e = G.OVERLAY_MENU:get_UIE_by_ID("forge_footer")
