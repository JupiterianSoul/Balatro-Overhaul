function UI.reopen(tab)
  UI.open(tab or (UIK._last_tab and UIK._last_tab.forge) or "my")
end

local function front_buttons(w)
  local list = {
    {label = mod_loc("Creations"), tab = "my", colour = UIK.C.accent},
    {label = mod_loc("Builder"), tab = "builder", colour = UIK.C.ok},
    {label = mod_loc("Pixel editor"), tab = "pixel", colour = UIK.C.purple},
  }
  local gap = 0.2
  local bw = math.min(touch() and 3.0 or 2.85, (w - 0.4 - gap * (#list - 1)) / #list)
  local nodes = {}
  for i, b in ipairs(list) do
    if i > 1 then nodes[#nodes + 1] = {n = G.UIT.C, config = {minw = gap}, nodes = {}} end
    nodes[#nodes + 1] = UIK.button{label = b.label, button = "forge_from_mods", ref_table = {tab = b.tab}, colour = b.colour, w = bw, scale = fit_scale(b.label, bw, touch() and 0.5 or 0.47), col = true, id = "forge_front_" .. b.tab}
  end
  return {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.1}, nodes = nodes}
end

function UI.mods_tab()
  local W = rawget(_G, "ModWorkshop")
  if W and W.layout then pcall(W.layout) end
  local w = (W and W.TAB_W) or 11.6
  local h = W and W.TAB_H or nil
  local list = Store.all()
  local shown = math.min(#list, 5)
  local cards = {}
  for i = 1, shown do
    if i > 1 then cards[#cards + 1] = {n = G.UIT.C, config = {minw = 0.15}, nodes = {}} end
    cards[#cards + 1] = {n = G.UIT.C, config = {align = "cm"}, nodes = {UI.card_node(list[i])}}
  end
  local middle
  if shown > 0 then
    middle = {n = G.UIT.R, config = {align = "cm", minw = w, minh = G.CARD_H + 0.3, padding = 0.05}, nodes = cards}
  else
    middle = {n = G.UIT.R, config = {align = "cm", minw = w, minh = G.CARD_H + 0.3, padding = 0.05}, nodes = {
      {n = G.UIT.C, config = {align = "cm"}, nodes = {UIK.note({mod_loc("No jokers yet")}, {w = 6, scale = 0.4})}},
    }}
  end
  local count = #list == 1 and mod_loc("1 joker") or string.format(mod_loc("%d jokers"), #list)
  return {n = G.UIT.ROOT, config = {align = "tm", colour = G.C.CLEAR, minw = w, minh = h}, nodes = {
    {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.1}, nodes = {UIK.text(mod_loc("THE FORGE"), {scale = 0.6, colour = UIK.C.title})}},
    UIK.note({mod_loc("Make jokers, tarots, decks, blinds and more,"), mod_loc("with their own rules and art, and play them in your runs.")}, {w = w}),
    {n = G.UIT.R, config = {align = "cm", minw = w, minh = 0.15}, nodes = {}},
    middle,
    {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.02}, nodes = {UIK.text(#list > 0 and count or "", {scale = 0.36, colour = UIK.C.muted, shadow = false})}},
    front_buttons(w),
  }}
end

if not UI.tab_hooked and G.FUNCS.uik_tab then
  UI.tab_hooked = true
  local orig_tab = G.FUNCS.uik_tab
  G.FUNCS.uik_tab = function(e)
    orig_tab(e)
    if UIK._win and UIK._win.id == "forge" then UI.refresh_footer() end
  end
  local orig_open = UIK.open_tab
  UIK.open_tab = function(key)
    orig_open(key)
    if UIK._win and UIK._win.id == "forge" then UI.refresh_footer() end
  end
end

G.FUNCS.open_joker_forge = function(e)
  UI.state.page = 1
  UI.open("my", "tavern")
end

G.FUNCS.forge_from_mods = function(e)
  local tab = e and e.config and e.config.ref_table and e.config.ref_table.tab or "my"
  UI.open(tab, "mods")
end

function UI.back_inside()
  local win = UIK._win
  if not (win and win.id == "forge") then return false end
  local cur = win._cur
  local B = rawget(_G, "ForgeBuilder")
  if cur == "builder" and B then
    for _, f in ipairs({B.back_step, B.back_page}) do
      if f then
        local ok, used = pcall(f)
        if ok and used then return true end
      end
    end
  end
  if cur == "pixel" then
    local PX = rawget(_G, "ForgePixelUI")
    local t = PX and PX.state and PX.state.target
    if t and t.kind == "draft" and B and B.state and B.state.draft then
      UI.reopen("builder")
      return true
    end
  end
  if cur and cur ~= "my" then
    UI.reopen("my")
    return true
  end
  return false
end

