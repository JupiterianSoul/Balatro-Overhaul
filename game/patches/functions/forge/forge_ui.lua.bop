G.FUNCS.forge_page = function(e)
  local d = e and e.config and e.config.ref_table and e.config.ref_table.d or 1
  local pages = math.max(1, math.ceil(#UI.filtered() / UI.PER_PAGE))
  UI.state.page = ((UI.state.page or 1) - 1 + d) % pages + 1
  UIK.refresh()
end

G.FUNCS.forge_new = function(e)
  local B = rawget(_G, "ForgeBuilder")
  if B and B.start_new then pcall(B.start_new) end
  UI.reopen("builder")
end

G.FUNCS.forge_edit = function(e)
  local id = e and e.config and e.config.ref_table and e.config.ref_table.id
  local B = rawget(_G, "ForgeBuilder")
  if id and B and B.edit then pcall(B.edit, id) end
  UI.reopen("builder")
end

G.FUNCS.forge_duplicate = function(e)
  local id = e and e.config and e.config.ref_table and e.config.ref_table.id
  if not id then return end
  local d
  if Store.get(id) then
    d = Store.duplicate(id, mod_loc("copy"))
    if d then FJ.register_all() end
  else
    local c = Store.get_item(id)
    if c then
      local x = Store.copy(c)
      x.id = Store.new_id()
      x.created = os.time()
      x.name = (tostring(c.name) .. " " .. mod_loc("copy")):sub(1, Store.MAX_NAME)
      if x.art and x.art.file then x.art = nil end
      d = Store.put_item(x)
    end
  end
  if d then
    local list = UI.filtered()
    for i, c in ipairs(list) do if c.id == d.id then UI.state.page = math.ceil(i / UI.PER_PAGE) end end
    play_sound("card1", 1.1, 0.6)
  end
  UIK.refresh()
end

G.FUNCS.forge_delete = function(e)
  local id = e and e.config and e.config.ref_table and e.config.ref_table.id
  local c = id and Store.find(id)
  if not c then return end
  UI.state.pending_delete = id
  G.FUNCS.overlay_menu{definition = UIK.window{
    id = "forge_delete",
    compact = true,
    w = 7,
    keep_w = true,
    title = c.kind and c.kind ~= "joker" and mod_loc("DELETE IT?") or mod_loc("DELETE THIS JOKER?"),
    tabs = {{key = "a", label = "", build = function()
      return UIK.stack({
        {n = G.UIT.R, config = {align = "cm", padding = 0.1}, nodes = {UI.any_node(c, {still = true})}},
        {n = G.UIT.R, config = {align = "cm", padding = 0.05}, nodes = {UIK.text(c.name, {scale = 0.45})}},
        UIK.note({mod_loc("It leaves the collection and the shop for good.")}, {w = 6.6}),
      }, {w = 6.6})
    end}},
    back_func = "forge_delete_cancel",
    back_inline = true,
    footer = {UIK.button{label = mod_loc("DELETE"), button = "forge_delete_confirm", colour = UIK.C.danger}},
  }}
end

G.FUNCS.forge_delete_confirm = function(e)
  local id = UI.state.pending_delete
  UI.state.pending_delete = nil
  if id and Store.delete(id) then
    FJ.register_all()
    play_sound("crumple1", 1, 0.6)
  elseif id and Store.delete_item(id) then
    local K = rawget(_G, "ForgeKinds")
    if K and K.refresh then pcall(K.refresh, id) end
    play_sound("crumple1", 1, 0.6)
  end
  UI.reopen("my")
end

G.FUNCS.forge_delete_cancel = function(e)
  UI.state.pending_delete = nil
  UI.reopen("my")
end

return UI
end
