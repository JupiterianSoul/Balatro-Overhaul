G.FUNCS.forge_b_restart = function()
  B.start_new()
  refresh()
end

G.FUNCS.forge_b_text = function()
  local d = draft()
  if not d then return end
  local lines = D.lines(d, lang())
  B.state.text = {lang = lang(), lines = lines}
  refresh()
end

G.FUNCS.forge_b_brush = function(e)
  local st = B.state.text
  local c = ref(e).c
  if not st or type(c) ~= "string" then return end
  if c == "custom" then
    st.picking = not st.picking
    if not st.picking and not DE.hex(st.brush) then st.brush = nil end
  else
    st.picking = nil
    st.brush = c ~= "plain" and DE.NAMES[c] and c or nil
  end
  refresh()
  B.text_focus(true)
end

G.FUNCS.forge_b_rgb_use = function()
  local st = B.state.text
  if not st then return end
  st.brush = DE.custom(st.rgb.r, st.rgb.g, st.rgb.b)
  st.picking = nil
  refresh()
  B.text_focus(true)
end

G.FUNCS.forge_b_word = function(e)
  local st = B.state.text
  local i = ref(e).i
  if not (st and st.chars and i and st.chars[i]) then return end
  local a, b = DE.word_at(st.chars, i)
  if a then
    local same = true
    for k = a, b do if st.chars[k].c ~= st.brush then same = false end end
    for k = a, b do st.chars[k].c = (not same) and st.brush or nil end
    st.cur = b
    if play_sound then play_sound("paper1", 1.2, 0.5) end
  end
  B.text_focus(true)
end

G.FUNCS.forge_b_box = function()
  local st = B.state.text
  if not st then return end
  B.text_focus(true)
end

G.FUNCS.forge_b_text_done = function()
  local d = draft()
  local t = B.state.text
  if d and t and t.chars then
    local lines = {}
    for _, l in ipairs(DE.from_chars(t.chars)) do lines[#lines + 1] = l end
    while #lines > 0 and lines[#lines]:gsub("[%s{}]", "") == "" do lines[#lines] = nil end
    d.text = type(d.text) == "table" and d.text or {}
    d.text[t.lang] = #lines > 0 and lines or nil
    if not next(d.text) then d.text = nil end
    B.dirty = true
  end
  B.text_focus(false)
  B.state.text = nil
  refresh()
end

G.FUNCS.forge_b_text_auto = function()
  local d = draft()
  local t = B.state.text
  if d and t and type(d.text) == "table" then d.text[t.lang] = nil end
  if d and type(d.text) == "table" and not next(d.text) then d.text = nil end
  B.text_focus(false)
  B.state.text = nil
  G.FUNCS.forge_b_text()
end

G.FUNCS.forge_b_text_back = function()
  B.text_focus(false)
  B.state.text = nil
  refresh()
end

local function register_strings()
  if not mod_loc_register then return end
