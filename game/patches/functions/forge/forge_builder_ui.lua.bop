local Store = require("functions/forge/forge_store")
local FJ = require("functions/forge/forge_joker")
local R = require("functions/forge/forge_rules")
local T = require("functions/forge/forge_text")
local Cat = require("functions/forge/forge_catalog")
local D = require("functions/forge/forge_doc")
local DE = require("functions/forge/forge_desc")

local B = {}
ForgeBuilder = B

B.KEY = "j_forge_draft"
B.DRAFT_ART = "forge/art/draft.png"
B.TEXT_LINES = 5
B.state = B.state or {draft = nil, start = nil, pick = nil, text = nil, rule_i = 1, page = 1}

local function touch() return UIK.touch() end
local function lang() return D.lang() end
local function draft() return B.state.draft end
local function kind() return Cat.kind(draft() and draft().kind or "joker") end
local function advanced() return draft() and (draft().kind == "joker" or draft().mode == "advanced") end
local function refresh() JokerForge.ui.reopen("builder") end
local UP = {["é"] = "É", ["è"] = "È", ["ê"] = "Ê", ["ë"] = "Ë", ["à"] = "À", ["â"] = "Â", ["á"] = "Á", ["ç"] = "Ç", ["î"] = "Î", ["ï"] = "Ï", ["í"] = "Í", ["ô"] = "Ô", ["ó"] = "Ó", ["û"] = "Û", ["ù"] = "Ù", ["ú"] = "Ú", ["ü"] = "Ü", ["ñ"] = "Ñ"}
local function upper(str) return (tostring(str or ""):upper():gsub("\195[\128-\191]", UP)) end
local function btn_h() return touch() and 0.78 or 0.62 end
local function sc() return touch() and 0.42 or 0.38 end

local function fit(label, w, scale)
  local lw = UIK.text_w(label, scale)
  if lw > w - 0.2 then return scale * (w - 0.2) / lw end
  return scale
end

local function button(label, func, ref, colour, w, h, id)
  return UIK.button{label = label, button = func, ref_table = ref, colour = colour, w = w, h = h or btn_h(), scale = fit(label, w, sc()), col = true, id = id}
end

local function hrow(nodes, w, pad)
  local list = {}
  for i, n in ipairs(nodes) do
    if i > 1 then list[#list + 1] = {n = G.UIT.C, config = {minw = pad or 0.12}, nodes = {}} end
    if n.n == G.UIT.R then n.n = G.UIT.C end
    list[#list + 1] = n
  end
  return {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.04}, nodes = list}
end

local function title(str, w, colour)
  return {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.06}, nodes = {UIK.text(str, {scale = touch() and 0.5 or 0.46, colour = colour or UIK.C.title})}}
end

local function step_title(n, str, w)
  return {n = G.UIT.R, config = {align = "cl", minw = w, padding = 0.04}, nodes = {
    {n = G.UIT.C, config = {align = "cm", minw = 0.42, minh = 0.42, r = 0.21, colour = G.C.RED}, nodes = {UIK.text(tostring(n), {scale = 0.36})}},
    {n = G.UIT.C, config = {minw = 0.12}, nodes = {}},
    {n = G.UIT.C, config = {align = "cm"}, nodes = {UIK.text(str, {scale = touch() and 0.44 or 0.4, colour = UIK.C.title})}},
  }}
end

local function word(str)
  return {n = G.UIT.C, config = {align = "cm", padding = 0.04}, nodes = {UIK.text(str, {scale = touch() and 0.42 or 0.38})}}
end

local function still(obj)
  obj.states.drag.can = false
  obj.states.collide.can = false
  return obj
end

function B.sprite(kind_id, key, s)
  local k = Cat.kind(kind_id)
  s = s or 1
  local w, h = G.CARD_W * s, G.CARD_H * s
  if k.shape == "tag" then
    local t = G.P_TAGS[key] or G.P_TAGS.tag_double
    return still(Sprite(0, 0, 0.9 * s * 1.9, 0.9 * s * 1.9, G.ASSET_ATLAS[t.atlas or "tags"], t.pos))
  end
  if k.shape == "blind" then
    local b = G.P_BLINDS[key] or G.P_BLINDS.bl_wall
    return still(AnimatedSprite(0, 0, 1.1 * s * 1.6, 1.1 * s * 1.6, G.ANIMATION_ATLAS[b.atlas or "blind_chips"], b.pos))
  end
  if k.shape == "stake" then
    local st = G.P_STAKES[key] or G.P_STAKES.stake_red or G.P_STAKES.stake_white
    return still(Sprite(0, 0, 0.9 * s * 1.7, 0.9 * s * 1.7, G.ASSET_ATLAS[st and st.atlas or "chips"], st and st.pos or {x = 0, y = 0}))
  end
  if kind_id == "seal" or kind_id == "collab" or kind_id == "edition" or kind_id == "enhancement" then
    local card
    if kind_id == "edition" then
      card = Card(0, 0, w, h, nil, G.P_CENTERS.j_joker)
      card:set_edition({[key] = true}, true, true)
    elseif kind_id == "enhancement" then
      card = Card(0, 0, w, h, G.P_CARDS.S_A, G.P_CENTERS[key] or G.P_CENTERS.m_bonus)
    else
      card = Card(0, 0, w, h, G.P_CARDS[kind_id == "collab" and key or "S_A"] or G.P_CARDS.H_K, G.P_CENTERS.c_base)
      if kind_id == "seal" then card:set_seal(G.shared_seals[key] and key or "Red", true, true) end
    end
