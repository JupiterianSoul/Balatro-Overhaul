G.FUNCS.forge_b_restart = function()
  B.start_new()
  refresh()
end

G.FUNCS.forge_b_text = function()
  local d = draft()
  if not d then return end
  local lines = D.lines(d, lang())
  local t = {lang = lang()}
  for i = 1, B.TEXT_LINES do t["l" .. i] = lines[i] or "" end
  B.state.text = t
  refresh()
end

G.FUNCS.forge_b_brush = function(e)
  local st = B.state.text
  local c = ref(e).c
  if not st or type(c) ~= "string" then return end
  B.text_sync()
  st.brush = c ~= "plain" and DE.NAMES[c] and c or nil
  refresh()
end

G.FUNCS.forge_b_word = function(e)
  local st = B.state.text
  local r = ref(e)
  if not st or not st.words or not st.words[r.l] then return end
  B.text_sync()
  DE.paint(st.words[r.l], r.k, st.brush)
  st.touched[r.l] = true
  st.sel = r.l
  B.text_sync()
  if play_sound then play_sound("paper1", 1.2, 0.5) end
  refresh()
end

G.FUNCS.forge_b_line = function(e)
  local st = B.state.text
  local l = ref(e).l
  if not st or not st.words or not st.words[l] then return end
  B.text_sync()
  st.sel = l
  st.input = DE.plain(st.words[l])
  refresh()
end

G.FUNCS.forge_b_text_done = function()
  local d = draft()
  local t = B.state.text
  B.text_sync()
  if d and t then
    local lines = {}
    for i = 1, B.TEXT_LINES do
      local l = tostring(t["l" .. i] or "")
      if l:gsub("%s", "") ~= "" then lines[#lines + 1] = l end
    end
    d.text = type(d.text) == "table" and d.text or {}
    d.text[t.lang] = #lines > 0 and lines or nil
    if not next(d.text) then d.text = nil end
    B.dirty = true
  end
  B.state.text = nil
  refresh()
end

G.FUNCS.forge_b_text_auto = function()
  local d = draft()
  local t = B.state.text
  if d and t and type(d.text) == "table" then d.text[t.lang] = nil end
  if d and type(d.text) == "table" and not next(d.text) then d.text = nil end
  B.state.text = nil
  G.FUNCS.forge_b_text()
end

G.FUNCS.forge_b_text_back = function()
  B.state.text = nil
  refresh()
end

