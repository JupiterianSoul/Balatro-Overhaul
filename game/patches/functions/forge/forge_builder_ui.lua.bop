function B.card_node(scale)
  local d = draft()
  if not d then return nil end
  local k = Cat.kind(d.kind)
  local s = scale or 1
  local w, h = G.CARD_W * s, G.CARD_H * s
  B.preview_card = nil
  if d.kind == "joker" then
    local card = Card(G.ROOM.T.x, G.ROOM.T.y, w, h, nil, B.preview_center())
    card.forge_preview = true
    B.preview_card = card
    return area_for(w, h, card)
  end
  if k.shape == "tag" or k.shape == "blind" or k.shape == "stake" or k.shape == "back" then
    local spr = B.sprite(d.kind, d.from or k.sample, s)
    local atlas, pos = art_atlas(d)
    local KM = require("functions/forge/forge_kinds_more")
    local Spr = rawget(_G, "Sprite")
    if k.shape == "tag" and KM.small_art(d, "forge_draft_tag", 34, 34) then
      spr = still(Sprite(0, 0, 0.9 * s * 1.9, 0.9 * s * 1.9, G.ASSET_ATLAS.forge_draft_tag, {x = 0, y = 0}))
    elseif k.shape == "blind" and KM.small_art(d, "forge_draft_blind", 34, 34) then
      spr = still(Spr(0, 0, 1.1 * s * 1.6, 1.1 * s * 1.6, G.ASSET_ATLAS.forge_draft_blind, {x = 0, y = 0}))
    elseif k.shape == "stake" and KM.small_art(d, "forge_draft_stake", 29, 29) then
      spr = still(Spr(0, 0, 0.9 * s * 1.7, 0.9 * s * 1.7, G.ASSET_ATLAS.forge_draft_stake, {x = 0, y = 0}))
    end
    if atlas and k.shape == "back" then spr = still(Sprite(0, 0, w, h, G.ASSET_ATLAS[atlas], pos)) end
    return {n = G.UIT.R, config = {align = "cm", minw = w, minh = h, padding = 0}, nodes = {obj(spr)}}
  end
  local node, pcard = B.kind_preview(d, s, "forge_draft_suit", B.state.suit_rank)
  if node then
    B.preview_card = pcard
    return node
  end
  local card
  if d.kind == "enhancement" then
    card = Card(G.ROOM.T.x, G.ROOM.T.y, w, h, G.P_CARDS.S_A, B.draft_center(d, k))
  elseif d.kind == "seal" then
    card = Card(G.ROOM.T.x, G.ROOM.T.y, w, h, G.P_CARDS.S_A, G.P_CENTERS.c_base)
    local atlas = art_atlas(d)
    if atlas then
      local spr = rawget(_G, "Sprite")(card.T.x, card.T.y, w, h, G.ASSET_ATLAS[atlas], {x = 0, y = 0})
      spr:set_role({major = card, role_type = "Glued", draw_major = card})
      card.children.forge_seal = spr
    else
      card:set_seal(G.P_SEALS and G.P_SEALS[d.from or ""] and d.from or "Red", true, true)
    end
  elseif d.kind == "edition" then
    card = B.blank_joker(Card(G.ROOM.T.x, G.ROOM.T.y, w, h, nil, G.P_CENTERS.j_joker))
    B.edition_look(card, d)
  elseif d.kind == "collab" then
    local pre = ({Hearts = "H", Diamonds = "D", Spades = "S", Clubs = "C"})[d.fields.suit] or "H"
    local face = B.state.face or "K"
    local oid = R.own_id("suit", d.fields.suit)
    local os = oid and require("functions/forge/forge_suits").of_id(oid)
    if os then pre = os.code end
    card = Card(G.ROOM.T.x, G.ROOM.T.y, w, h, G.P_CARDS[pre .. "_" .. face] or G.P_CARDS["H_" .. face], G.P_CENTERS.c_base)
    local file = d.faces and d.faces[face] or (face == "K" and d.art and d.art.file)
    if file and love.filesystem.getInfo(file) and card.children.front then
      local ok, data = pcall(love.image.newImageData, file)
      if ok and data and data:getWidth() == 71 and data:getHeight() == 95 and FJ.atlas_from_data("forge_draft_face", data) then
        card.children.front.atlas = G.ASSET_ATLAS.forge_draft_face
        card.children.front:set_sprite_pos({x = 0, y = 0})
      end
    end
  else
    card = Card(G.ROOM.T.x, G.ROOM.T.y, w, h, nil, B.draft_center(d, k))
  end
  card.forge_preview = true
r 7 1460 %20%20 -
r 5 219 %20%20 -
l 1833
  B.preview_card = card
  return area_for(w, h, card)
end

function B.scale_nodes(list, f)
  for _, n in ipairs(list or {}) do
    if type(n) == "table" then
      if type(n.config) == "table" and type(n.config.scale) == "number" then n.config.scale = n.config.scale * f end
      if n.nodes then B.scale_nodes(n.nodes, f) end
      if n[1] then B.scale_nodes(n, f) end
    end
  end
end

local function desc_box(d, w)
  local lines = B.set_desc(d)
  local max = UIK.portrait() and 8 or (touch() and 5 or 6)
  local shrink = 1
  if #lines > max and #lines <= math.floor(max * 1.5) then
    shrink = max / #lines
  elseif #lines > max then
    local short = {}
    for i = 1, max - 1 do short[i] = lines[i] end
    short[max] = "{C:inactive}...{}"
    local o = G.localization.descriptions.Other.forge_draft_desc
    o.text, o.text_parsed = short, parsed_lines(short)
  end
  local nodes = {}
  local ok = pcall(localize, {type = "other", key = "forge_draft_desc", nodes = nodes, vars = T.vars(nil, R.clean_vars(d.vars), nil, d.rules)})
  if not ok or #nodes == 0 then return nil end
  if shrink < 1 then B.scale_nodes(nodes, shrink) end
  local box = desc_from_rows(nodes)
  box.config.minw = w - 0.2
  return {n = G.UIT.R, config = {align = "cm", minw = w, maxw = w, padding = 0.04}, nodes = {box}}
end

function B.new_draft(o)
  o = o or {}
  if love.filesystem.getInfo(B.DRAFT_ART) then love.filesystem.remove(B.DRAFT_ART) end
  local kind_id = o.kind or "joker"
  if o.mode == nil or kind_id == "joker" then o.mode = "advanced" end
  B.state.draft = D.new(kind_id, o)
  B.state.warned = nil
  B.state.draft.id = o.id
  B.state.start = nil
  B.state.pick = nil
  B.state.text = nil
  B.state.rule_i = 1
  B.state.art = nil
  B.state.sec = "rules"
  B.dirty = false
  return B.state.draft
end

function B.start_new()
  B.state.draft = nil
  B.state.start = nil
  B.state.pick = nil
  B.state.text = nil
end

function B.edit(id)
  local c = Store.find(id)
  if not c then return end
  local d = Store.copy(c)
  d.kind = Store.kind_of(id)
  B.new_draft(d)
  B.state.draft.id = c.id
end

function B.face_draft(r) return "forge/art/draft_" .. r .. ".png" end

function B.art_changed(path)
  local d = draft()
  if not d then return end
  if d.kind == "collab" and B.state.face then
    local raw = love.filesystem.read(path)
    local to = B.face_draft(B.state.face)
    if raw and love.filesystem.write(to, raw) then
      d.faces = d.faces or {}
      d.faces[B.state.face] = to
    end
    B.dirty = true
    return
  end
  d.art = {file = path}
  local base = B.state.art_base
  if base then d.art.atlas, d.art.x, d.art.y = base.atlas, base.x, base.y end
  B.dirty = true
end

function B.on_leave() B.state.pick = nil; B.state.text = nil; B.state.art = nil; B.state.typing = nil end

function B.back_step()
  local s = B.state
  if s.pick then G.FUNCS.forge_b_pick_back() return true end
  if s.typing then
    s.typing = nil
    B.type_box = nil
    refresh()
    return true
  end
  if s.art then G.FUNCS.forge_b_art_back() return true end
  if s.text then G.FUNCS.forge_b_text_back() return true end
  return false
end

function B.leave_draft()
  local d = B.state.draft
  B.state.draft = nil
  B.state.pick, B.state.text, B.state.art, B.state.typing = nil, nil, nil, nil
  B.dirty = false
  if d and d.id and Store.find(d.id) then JokerForge.ui.reopen("my") return end
  B.state.start = d and Cat.BY_ID[d.kind] and d.kind or nil
  B.state.page = 1
  refresh()
end

function B.ask_save()
  G.FUNCS.overlay_menu{definition = UIK.window{
    id = "forge_unsaved",
    compact = true,
    w = 8,
    title = mod_loc("SAVE YOUR CHANGES?"),
    tabs = {{key = "a", label = "", build = function()
      return UIK.stack({UIK.note({mod_loc("This card has changes that are not saved yet.")}, {w = 7.4})}, {w = 7.4})
    end}},
    back_func = "forge_b_unsaved_keep",
    back_label = mod_loc("KEEP EDITING"),
    back_inline = true,
    footer = {
      UIK.button{label = mod_loc("SAVE"), button = "forge_b_unsaved_save", colour = UIK.C.ok},
      UIK.button{label = mod_loc("DON'T SAVE"), button = "forge_b_unsaved_drop", colour = UIK.C.danger},
    },
  }}
end

function B.back_page()
  local s = B.state
  if s.draft then
    if B.dirty then B.ask_save() else B.leave_draft() end
    return true
  end
  if s.start then
    s.start = nil
    s.page = 1
    refresh()
    return true
  end
  return false
end

G.FUNCS.forge_b_unsaved_keep = function()
  refresh()
end

G.FUNCS.forge_b_unsaved_save = function()
  local c = B.save()
  if not c then refresh() return end
  play_sound("card1", 1.1, 0.6)
  B.state.draft = nil
  local U = JokerForge.ui
  if U.state then U.state.kind = Store.kind_of(c.id) end
  U.reopen("my")
end

G.FUNCS.forge_b_unsaved_drop = function()
  B.leave_draft()
end

G.ESC_BACK_FUNCS = G.ESC_BACK_FUNCS or {}
G.ESC_BACK_FUNCS.forge_b_unsaved_keep = true

local function kinds_body()
  local per = UIK.portrait() and 3 or 7
  local tw = UIK.portrait() and ((UIK.W - 0.4) / per - 0.12) or ((UIK.W - 0.3) / per - 0.12)
  local items = {}
  for _, k in ipairs(Cat.KINDS) do
    items[#items + 1] = tile(mod_loc(k.label), "forge_b_kind", {kind = k.id}, B.sprite(k.id, k.sample, UIK.portrait() and 0.58 or touch() and 0.55 or 0.5), tw, "forge_kind_" .. k.id, 0.62)
  end
  return {n = G.UIT.R, config = {align = "cm", minw = UIK.W, minh = UIK.H - 0.4, padding = 0}, nodes = {{n = G.UIT.C, config = {align = "cm", padding = 0.05}, nodes = {
    title(mod_loc("WHAT ARE YOU MAKING?"), UIK.W),
    UIK.grid(items, per, {w = UIK.W - 0.2, padding = 0.04}),
  }}}}
end

function B.make_title(label)
  local fmt = mod_loc("MAKE A %s")
  if fmt == "MAKE A %s" and label:match("^[AEIOU]") then fmt = "MAKE AN %s" end
  return string.format(fmt, label)
end

function B.start_list_def()
  local kid = B.state.start
  local list = D.templates(kid)
  local per = UIK.portrait() and 3 or 7
  local rows = UIK.portrait() and 3 or touch() and 1 or 2
  local cap = per * rows
  local shown = {}
  local E = package.loaded["functions/forge/forge_easy"]
  for i, t in ipairs(list) do
    if not E or E.matches(D.template_name(kid, t), B.state.start_q) then shown[#shown + 1] = i end
  end
  local pages = math.max(1, math.ceil(#shown / cap))
  B.state.page = math.max(1, math.min(B.state.page or 1, pages))
  local tw = (UIK.W - 0.6) / per - 0.12
  local items = {}
  for j = (B.state.page - 1) * cap + 1, math.min(#shown, B.state.page * cap) do
    local i = shown[j]
    local t = list[i]
    items[#items + 1] = tile(D.template_name(kid, t), "forge_b_template", {i = i}, B.sprite(kid, t.key, UIK.portrait() and 0.72 or touch() and 0.55 or 0.5), tw, "forge_tpl_" .. i, nil, true)
  end
  return items, pages, per, #shown
end

local function start_body()
  local kid = B.state.start
  local k = Cat.kind(kid)
  local list = D.templates(kid)
  local items, pages, per = B.start_list_def()
  local nodes = {
    title(B.make_title(upper(mod_loc(k.label))), UIK.W),
    hrow({
      button(mod_loc("Blank"), "forge_b_blank", nil, UIK.C.ok, touch() and 3.2 or 2.85, nil, "forge_blank"),
      button(mod_loc("Another kind"), "forge_b_kinds", nil, UIK.C.accent, touch() and 3.2 or 2.85, nil, "forge_other_kind"),
    }, UIK.W, 0.3),
  }
  if #list > 0 then
    nodes[#nodes + 1] = title(mod_loc(kid == "challenge" and "Or start from a game challenge:" or "Or start from a game card:"), UIK.W, UIK.C.muted)
    if #list > 14 and B.start_search_row then
      nodes[#nodes + 1] = B.start_search_row()
      local box = UIBox{definition = B.start_grid_def(), config = {offset = {x = 0, y = 0}}}
      nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", func = "forge_b_start_watch"}, nodes = {{n = G.UIT.O, config = {object = box, id = "forge_start_list"}}}}
    else
      nodes[#nodes + 1] = UIK.grid(items, per, {w = UIK.W - 0.2, padding = 0.04})
      if pages > 1 then
        nodes[#nodes + 1] = UIK.pager{prev = "forge_b_page", next = "forge_b_page", prev_ref = {d = -1}, next_ref = {d = 1}, text = string.format(mod_loc("Page %d of %d"), B.state.page, pages), w = UIK.W}
      end
    end
  end
  return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, minh = UIK.H - 0.4, padding = 0}, nodes = {{n = G.UIT.C, config = {align = "tm", padding = 0.04}, nodes = nodes}}}
end

local function left_column(w)
  local d = draft()
  local nodes = {B.card_node(touch() and 0.72 or 0.78)}
  nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm"}, nodes = {boxed(UIK.input{ref_table = d, ref_value = "name", max_length = Store.MAX_NAME, w = w, iw = w - 0.2, extended_corpus = true, callback = function() if #B.warnings(d) > 0 then refresh() end end})}}
  local okb, bal = pcall(require("functions/forge/forge_balance").builder_node, d, w, {scale = touch() and 0.32 or 0.3})
  B.balance_h = okb and bal and bal.bal_h or 0
  if okb and bal then nodes[#nodes + 1] = bal end
  local bw = w - 0.2
  local art = {button(mod_loc("Draw its art"), "forge_b_art", nil, UIK.C.purple, bw, touch() and 0.7 or 0.56, "forge_draw")}
  if B.ART_SETS[d.kind] then
    local hw = (bw - 0.1) / 2
    art = {hrow({
      button(mod_loc("Game art"), "forge_b_art_pick", nil, UIK.C.accent, hw, touch() and 0.7 or 0.56, "forge_art_pick"),
      button(mod_loc("Draw it"), "forge_b_art", nil, UIK.C.purple, hw, touch() and 0.7 or 0.56, "forge_draw"),
    }, bw, 0.1)}
    if d.kind == "joker" and require("functions/forge/forge_extras").ink_available() then
      art[#art + 1] = button(mod_loc("InkJoker art"), "forge_x_ink", nil, G.C.SECONDARY_SET.Spectral, bw, touch() and 0.7 or 0.56, "forge_ink")
    end
  end
  if d.kind == "hand" or d.kind == "challenge" or d.kind == "rarity" or d.kind == "sticker" or d.kind == "fusion" then art = {} end
  if d.kind == "ctype" then art = {button(mod_loc("Draw its pack art"), "forge_b_art", nil, UIK.C.purple, bw, touch() and 0.7 or 0.56, "forge_draw")} end
  if d.kind == "collab" then
    local fw = (bw - 0.16) / 3
    local faces = {}
    for _, r in ipairs({"J", "Q", "K"}) do
      local label = localize(({J = "Jack", Q = "Queen", K = "King"})[r], "ranks")
      faces[#faces + 1] = button(label, "forge_b_face", {face = r}, (B.state.face or "K") == r and UIK.C.purple or UIK.C.inactive, fw, touch() and 0.7 or 0.56, "forge_face_" .. r)
    end
    art = {{n = G.UIT.R, config = {align = "cm"}, nodes = {UIK.text(mod_loc("Draw a face card:"), {scale = touch() and 0.4 or 0.32})}}, hrow(faces, bw, 0.08)}
  end
  local xb = require("functions/forge/forge_extras").item_buttons
  local extra = xb and xb(d, bw, touch() and 0.7 or 0.56)
  if extra then art[#art + 1] = extra end
  for _, a in ipairs(art) do nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.03}, nodes = {a}} end
  local box = desc_box(d, w)
  if box then nodes[#nodes + 1] = box end
  return {n = G.UIT.C, config = {align = "tm", minw = w, padding = 0.02}, nodes = (function()
    local out = {}
    for _, n in ipairs(nodes) do if n then if n.n == G.UIT.C then n.n = G.UIT.R end out[#out + 1] = n end end
    return out
  end)()}
end

local function sections()
  local d = draft()
  if d.kind == "joker" then return {"rules", "vars", "looks", "basics", "try"} end
  local k = kind()
  if not advanced() then return {} end
  local has_fields = #(k.fields or {}) + #(k.adv_fields or {}) > 0
  local out = {}
  if Cat.max_for(d, true) > 0 and has_fields then out = {"rules", "basics"} end
  if host_rules() then
    if #out == 0 then out = {"rules"} end
    out[#out + 1] = "logic"
    out[#out + 1] = "vars"
  end
  return out
end

local function mode_buttons(h)
  local d = draft()
  local adv = advanced()
  local locked = false
  if d.kind == "joker" then adv = not B.sentence_on() end
  local ms = touch() and 0.42 or 0.36
  local bw = math.max(touch() and 1.9 or 1.6, UIK.text_w(mod_loc("Simple"), ms) + 0.5, UIK.text_w(mod_loc("Advanced"), ms) + 0.5)
  local function seg(label, m, on)
    return UIK.button{label = label, button = (locked or on) and "nil" or "forge_b_mode", ref_table = {mode = m}, colour = on and UIK.C.accent or UIK.C.inactive, text_colour = (locked and not on) and UIK.C.inactive_text or nil, w = bw, h = h, scale = ms, col = true, id = "forge_mode_" .. m}
  end
  local nodes = {seg(mod_loc("Simple"), "simple", not adv), {n = G.UIT.C, config = {minw = 0.06}, nodes = {}}, seg(mod_loc("Advanced"), "advanced", adv)}
  local w = bw * 2 + 0.06
  local box = {n = G.UIT.C, config = {align = "cm", padding = 0.05, r = 0.12, colour = UIK.C.section}, nodes = nodes}
  if not locked then return box, w + 0.1 end
  local ns = touch() and 0.4 or 0.34
  local note = {n = G.UIT.C, config = {align = "cm", padding = 0.04}, nodes = {UIK.text(mod_loc("Jokers use every setting"), {scale = ns, colour = UIK.C.muted})}}
  return {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = {box, {n = G.UIT.C, config = {minw = 0.12}, nodes = {}}, note}}, w + 0.22 + UIK.text_w(mod_loc("Jokers use every setting"), ns) + 0.08
end

local function mode_switch(w)
  local d = draft()
  local k = kind()
  local h = touch() and 0.7 or 0.56
  local secs = sections()
  local sec = B.state.sec or "rules"
  local found = false
  for _, id in ipairs(secs) do if id == sec then found = true end end
  if not found then sec = secs[1] or "rules" end
  local tabs = {}
  local sw = touch() and 2.2 or 1.9
  if #secs > 0 then sw = math.min(sw, (w - 0.1 * #secs) / #secs - 0.04) end
  for _, id in ipairs(secs) do
    local label = mod_loc(d.kind ~= "joker" and id == "rules" and (Cat.max_for(d, true) > 0 and "Effects" or "Basics") or B.SEC_LABEL[id])
    tabs[#tabs + 1] = button(label, "forge_b_sec", {sec = id}, sec == id and G.C.RED or UIK.C.inactive, sw, h, "forge_sec_" .. id)
  end
  local tw = #tabs > 0 and (#tabs * (sw + 0.1)) or 0
  local switch, mw = mode_buttons(h)
  local ts = touch() and 0.5 or 0.46
  local label = upper(mod_loc(k.label))
  local title_w = UIK.text_w(label, ts)
  local function title_c(maxw) return {n = G.UIT.C, config = {align = "cm", maxw = maxw}, nodes = {UIK.text(label, {scale = ts, colour = UIK.C.title})}} end
  local function row(nodes, pad) return {n = G.UIT.R, config = {align = "cm", minw = w, padding = pad or 0.02}, nodes = nodes} end
  local gap = {n = G.UIT.C, config = {minw = 0.4}, nodes = {}}
  if not UIK.portrait() and title_w + 0.4 + mw + (tw > 0 and tw + 0.4 or 0) <= w then
    local nodes = {title_c(title_w + 0.1), gap, switch}
    if tw > 0 then
      nodes[#nodes + 1] = {n = G.UIT.C, config = {minw = 0.4}, nodes = {}}
      local t = hrow(tabs, tw, 0.1)
      t.n = G.UIT.C
      nodes[#nodes + 1] = t
    end
    return row(nodes)
  end
  local out = {}
  if not UIK.portrait() and title_w + 0.4 + mw <= w then
    out[1] = row({title_c(w - mw - 0.5), gap, switch})
  else
    out[1] = row({title_c(w - 0.2)})
    out[2] = row({switch}, 0.04)
  end
  if tw > 0 then out[#out + 1] = hrow(tabs, w, 0.1) end
  return {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0}, nodes = {{n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = out}}}
end

B.SECS = {"rules", "vars", "basics"}
B.SEC_LABEL = {rules = "Rules", vars = "Variables", basics = "Basics", logic = "Rules", try = "Sample hand"}
B.kit = {button = button, hrow = hrow, title = title, step_title = step_title, obj = obj, still = still}

local ONLY_LABEL = {var = "Variable", hand = "Poker hand", suit = "Suit", rank = "Rank", enhancement = "Enhancement", seal = "Seal", edition = "Edition", cards_played = "Cards played", money = "Money", hands_left = "Hands left", discards_left = "Discards left", first_hand = "First hand", last_hand = "Last hand", ante = "Ante", jokers = "Jokers", boss = "Boss blind", chance = "Chance", blind = "Blind type", deck_cards = "Cards in deck", held_cards = "Cards in hand", consumables = "Consumables", hand_level = "Hand level", round = "Round"}
local GIVE_LABEL = {chips = "+Chips", mult = "+Mult", xmult = "XMult", money = "Money", retrigger = "Retrigger", gain_chips = "Gains Chips", gain_mult = "Gains Mult", gain_xmult = "Gains XMult", create = "Create a card", level_up = "Level up the hand", change = "Change the card", hand = "+Hands", discard = "+Discards", destroy_self = "Destroys itself", var_add = "Change a variable", var_set = "Set a variable", var_chips = "+Chips for each point", var_mult = "+Mult for each point", destroy_card = "Destroy the card", add_card = "Add a card to the deck", sell_value = "Gains sell value", perma_chips = "Card gains Chips forever", copy_card = "Copy the card", tag = "Create a tag", disable_boss = "Disable the Boss Blind", destroy_joker = "Destroy a random joker", make_card = "Create a chosen card"}
local OP_SPEC = {var = true, cards_played = true, money = true, hands_left = true, discards_left = true, ante = true, jokers = true, deck_cards = true, held_cards = true, consumables = true, hand_level = true, round = true, amount = true, select_limit = true}
for k, v in pairs(R.LABEL_ONLY or {}) do ONLY_LABEL[k] = ONLY_LABEL[k] or v end
for k, v in pairs(R.LABEL_GIVE or {}) do GIVE_LABEL[k] = GIVE_LABEL[k] or v end
GIVE_LABEL.var_pick = "Set a variable"
for k in pairs(R.FILTER_ONLY or {}) do OP_SPEC[k] = true end

local function plain(s)
  local p = G.GAME and G.GAME.probabilities and G.GAME.probabilities.normal or 1
  return (tostring(s or ""):gsub("%s*%({[^}]*}#%d+#{}%)", ""):gsub("{[^}]*}", ""):gsub("#1#", T.fmt_n(p)))
end

local function rule()
  local d = draft()
  d.rules = d.rules or {}
  if #d.rules == 0 then
    B.state.rule_i = 1
    return {when = host_rules() and B.first_rule(d.kind).when or "hand_played", only = {}, give = {}}
  end
  B.state.rule_i = math.max(1, math.min(B.state.rule_i or 1, #d.rules))
  local r = d.rules[B.state.rule_i]
  r.only = r.only or {}
  r.give = r.give or {}
  return r
end

local function dvars() return R.clean_vars(draft() and draft().vars) end
local function typed(v) return v and v.type and v.type ~= "number" end
local function count_vars(want_typed)
  local n = 0
  for _, v in ipairs(dvars()) do if (typed(v) and true or false) == want_typed then n = n + 1 end end
  return n
end
B.VAR_TYPE_LABEL = {number = "Number", suit = "Suit", rank = "Rank", hand = "Poker hand", edition = "Edition", enhancement = "Enhancement", seal = "Seal"}
local function only_label(o) return plain(T.only_text(o, lang(), dvars()) or mod_loc(ONLY_LABEL[o.id] or o.id)) end
local function give_label(g)
  local d = draft()
  local r = d and d.rules and d.rules[B.state.rule_i or 1]
  local prev = T.cur_kind
  T.cur_kind = d and d.kind ~= "joker" and d.kind or prev
  local ok, txt = pcall(T.give_text, g, lang(), dvars(), r and r.when)
  T.cur_kind = prev
  return plain(ok and txt or mod_loc(GIVE_LABEL[g.id] or g.id))
end
function B.num_vars()
  local out = {}
  for i, v in ipairs(dvars()) do if not typed(v) then out[#out + 1] = i end end
  return out
end

local VAR_STEP = {var_pick = "Set %s to", var_add = "Add to %s", var_set = "Set %s to", var_chips = "Chips for each %s", var_mult = "Mult for each %s", var_xmult = "XMult for each %s", var_xchips = "XChips for each %s", var_money = "Money for each %s"}
for k, v in pairs(R.VAR_STEP or {}) do VAR_STEP[k] = VAR_STEP[k] or v end
local function run_give_spec(g)
  if not (g and g.run) then return nil end
  local HR = package.loaded["functions/forge/forge_hostrules"]
  return HR and HR.run_spec(draft() and draft().kind or "voucher", g.id) or nil
end
B.run_give_spec = run_give_spec

local function give_num(g)
  local spec = run_give_spec(g)
  if spec then return spec.num end
  return R.NUM[g.id]
end
B.give_num = give_num

local function num_label(x, map)
  if R.NUM_LABEL and R.NUM_LABEL[x.id] then return R.NUM_LABEL[x.id](x, map[x.id]) end
  local rs = run_give_spec(x)
  if rs then return mod_loc(rs.label) end
  if x.var and VAR_STEP[x.id] then return string.format(mod_loc(VAR_STEP[x.id]), T.var_name(dvars(), x.var)) end
  if x.id == "create_rarity" then return mod_loc(map[x.id]) .. ": " .. (R.own_id("rarity", x.v) and R.own_label("rarity", x.v) or mod_loc(x.v or "Common")) end
  if x.id == "make_ed_joker" or x.id == "ed_joker" then return mod_loc(map[x.id]) .. ": " .. R.ed_name(x.v or "foil") end
  if R.PER_GIVE[x.id] and x.per then
    local what = mod_loc(R.LABEL_COUNT[x.per] or x.per)
    if R.COUNT_MATCH[x.per] then what = what .. " (" .. plain(R.count_m_label(x.per, x.m, lang())) .. ")" end
    return mod_loc(map[x.id] or x.id) .. ": " .. what
  end
  return mod_loc(map[x.id] or x.id)
end

local function blank(label, colour, func, ref, w, id, exact)
  local h = touch() and 0.7 or 0.56
  local s = touch() and 0.4 or 0.36
  local tw = UIK.text_w(label, s)
  local bw = exact and w or math.min(w or 6, math.max(1.3, tw + 0.4))
  local lab, ls = wrap_label(label, bw, s)
  local node = UIK.button{label = lab, button = func, ref_table = ref, colour = colour, w = bw, h = h, scale = ls, col = true, id = id}
  node.uik_w = bw + 0.12
  return node
end

local function flow_rows(parts, w)
  local rows, cur, used = {}, {}, 0
  for _, p in ipairs(parts) do
    local pw = (p.config and p.config.minw or 1.5) + 0.12
    if p.uik_w then pw = p.uik_w end
    if #cur > 0 and used + pw > w then
      rows[#rows + 1] = hrow(cur, w, 0.08)
      cur, used = {}, 0
    end
    cur[#cur + 1] = p
    used = used + pw
  end
  if #cur > 0 then rows[#rows + 1] = hrow(cur, w, 0.08) end
  return rows
end

local OP_WORD = {at_least = "At least", at_most = "At most", exactly = "Exactly"}

local function gap(w) return {n = G.UIT.C, config = {minw = w or 0.1}, nodes = {}} end

local function spaced(list, pad)
  local out = {}
  for i, n in ipairs(list) do
    if i > 1 then out[#out + 1] = gap(pad or 0.1) end
    if n.n == G.UIT.R then n.n = G.UIT.C end
    out[#out + 1] = n
  end
  return out
end

local function num_fmt(id)
  if R.NUM_FMT and R.NUM_FMT[id] then return R.NUM_FMT[id] end
  if id == "chance" then return function(v) return "1 / " .. T.fmt_n(v) end end
  if id == "money" or id == "sell_value" or id == "money_per" then return function(v) v = tonumber(v) or 0 return (v < 0 and "-$" or "$") .. T.fmt_n(math.abs(v)) end end
  if id == "xmult" or id == "xchips" then return function(v) return "X" .. T.fmt_n(v) end end
  if R.EXP_IDS and R.EXP_IDS[id] then return function(v) return "^" .. T.fmt_n(v) end end
  return function(v) return T.fmt_n(v) end
end

function B.row_h() return touch() and 0.74 or 0.89 end

function B.line_h(kind)
  if kind == "pager" then return touch() and 1.02 or 0.86 end
  return touch() and 0.82 or 0.68
end

function B.step_w(stw) return stw end

local function block_lines(r, w)
  local lw = touch() and 1.9 or 1.7
  local cw = w - lw - 0.25
  local stw = touch() and 2.6 or 2.3
  local out = {}
  local function line(label, nodes, tall)
    local lab = label ~= "" and UIK.text(label, {scale = fit(label, lw, touch() and 0.4 or 0.36), colour = UIK.C.title}) or nil
    out[#out + 1] = {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.02}, nodes = {
      {n = G.UIT.C, config = {align = "cr", minw = lw, maxw = lw}, nodes = {lab}},
      gap(0.25),
      {n = G.UIT.C, config = {align = "cl", minw = cw, maxw = cw}, nodes = spaced(nodes, 0.1)},
    }, uik_h = B.line_h(tall and "num")}
  end
  local function flow(label, chips)
    local rows, cur, used = {}, {}, 0
    for _, c in ipairs(chips) do
      local cwid = c.uik_w or ((c.config and c.config.minw or 1.5) + 0.12)
      if #cur > 0 and used + cwid > cw then rows[#rows + 1] = cur; cur, used = {}, 0 end
      cur[#cur + 1] = c
      used = used + cwid
    end
    if #cur > 0 then rows[#rows + 1] = cur end
    for i, row in ipairs(rows) do line(i == 1 and label or "", row) end
  end
  local sx = B.step_w(stw)
  local jx = 2 * (B.jump_w() + 0.05)
  local nvs = B.num_vars()
  local vx = #nvs > 0 and (B.type_w() + 0.05) or 0
  local compact = cw - sx - jx - B.type_w() - vx - 0.25 < 3.0
  local nmax = cw - sx - (compact and 0 or jx) - B.type_w() - vx - 0.25
  local stack = vx > 0 and nmax < 1.6
  if stack then nmax = cw end
  local nw = 0
  local function want(str) nw = math.max(nw, math.min(nmax, math.max(1.3, UIK.text_w(str, touch() and 0.4 or 0.36) + 0.4))) end
  for _, o in ipairs(r.only) do
    if R.NUM[o.id == "money" and "money_cond" or o.id] and o.n ~= nil then
      local name = o.id == "var" and T.var_name(dvars(), o.var) or mod_loc(ONLY_LABEL[o.id] or o.id)
      if R.FILTER_ONLY[o.id] then name = name .. ": " .. plain(o.id == "jokers_with" and R.ed_name(R.ed_match(o.v) or "any") or R.match_label(o.v, lang())) end
      if o.op and OP_WORD[o.op] then name = name .. ": " .. mod_loc(OP_WORD[o.op]) end
      if o.neg then name = mod_loc("NOT:") .. " " .. name end
      want(name)
    end
  end
  for _, list in ipairs({r.give, r.alt or {}}) do
    for _, g in ipairs(list) do if give_num(g) and g.n ~= nil then want(num_label(g, GIVE_LABEL)) end end
  end
  local function numeric(label, chip, ref, key, spec, id)
    local row = {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = {B.num_row(nil, ref, key, spec, num_fmt(id), stw, compact, true, nvs)}}
    if stack then
      line(label, {chip})
      line("", {row})
    else
      line(label, {chip, row})
    end
  end
  line(mod_loc("WHEN"), {blank(plain(T.when_text(r.when, lang(), draft() and draft().kind)), G.C.ORANGE, "forge_b_pick_when", nil, cw, "forge_when")})
  local max_only = advanced() and 6 or 2
  local max_give = advanced() and 6 or 2
  local has_chance = false
  for _, o in ipairs(r.only) do if o.id == "chance" then has_chance = true end end
  local chips, first_if = {}, true
  for i, o in ipairs(r.only) do
    local spec = R.NUM[o.id == "money" and "money_cond" or o.id]
    if spec and o.n ~= nil then
      local name = o.id == "var" and T.var_name(dvars(), o.var) or mod_loc(ONLY_LABEL[o.id] or o.id)
      if R.FILTER_ONLY[o.id] then name = name .. ": " .. plain(o.id == "jokers_with" and R.ed_name(R.ed_match(o.v) or "any") or R.match_label(o.v, lang())) end
      if o.op and OP_WORD[o.op] then name = name .. ": " .. mod_loc(OP_WORD[o.op]) end
      if o.neg then name = mod_loc("NOT:") .. " " .. name end
      numeric(first_if and mod_loc("IF") or "", blank(name, G.C.BLUE, "forge_b_pick_only", {slot = i}, nw, "forge_only_" .. i, true), o, "n", spec, o.id)
      first_if = false
    else
      chips[#chips + 1] = blank((o.neg and (mod_loc("NOT:") .. " ") or "") .. only_label(o), G.C.BLUE, "forge_b_pick_only", {slot = i}, cw, "forge_only_" .. i)
    end
  end
  local can_if = r.when ~= "passive"
  if can_if and #r.only < max_only then chips[#chips + 1] = blank(mod_loc("+ Only if"), UIK.C.accent, "forge_b_pick_only", {slot = #r.only + 1}, cw, "forge_add_only") end
  if can_if and not has_chance and #r.only < max_only then chips[#chips + 1] = blank(mod_loc("+ With a chance"), G.C.GREEN, "forge_b_add_chance", nil, cw, "forge_add_chance") end
  if #chips > 0 then flow(first_if and mod_loc("IF") or "", chips) end
  local function chip_w(str) return math.min(cw, math.max(1.3, UIK.text_w(str, touch() and 0.4 or 0.36) + 0.4)) end
  local num_w = nw + 0.1 + sx + (compact and 0 or jx) + 0.05 + B.type_w() + vx
  if stack then num_w = sx + (compact and 0 or jx) + 0.05 + B.type_w() + vx end
  local function gives(label, list, func, prefix, add_label, add_ref, add_id, add_colour)
    local pend = {}
    for i, g in ipairs(list) do
      local spec = give_num(g)
      if spec and g.n ~= nil then
        local chip = blank(num_label(g, GIVE_LABEL), G.C.RED, func, {slot = i}, nw, prefix .. i, true)
        local fmt = num_fmt(g.run and ({["$"] = "money", x = "xmult"})[spec.fmt] or g.id)
        local row = {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = {B.num_row(nil, g, "n", spec, fmt, stw, compact, true, nvs)}}
        if stack then
          pend[#pend + 1] = {nodes = {chip}, w = nw}
          pend[#pend + 1] = {nodes = {row}, w = num_w}
        else
          pend[#pend + 1] = {nodes = {chip, row}, w = num_w}
        end
      else
        local txt = give_label(g)
        pend[#pend + 1] = {nodes = {blank(txt, G.C.RED, func, {slot = i}, cw, prefix .. i)}, w = chip_w(txt)}
      end
    end
    if add_label then
      local add = blank(add_label, add_colour, func, add_ref, cw, add_id)
      local last = pend[#pend]
      if last and last.w + 0.1 + chip_w(add_label) <= cw then last.nodes[#last.nodes + 1] = add else pend[#pend + 1] = {nodes = {add}, w = chip_w(add_label)} end
    end
    for i, l in ipairs(pend) do line(i == 1 and label or "", l.nodes, l.tall) end
  end
  if #r.give == 0 then
    line(mod_loc("DO"), {blank(mod_loc("+ Pick what it does"), G.C.RED, "forge_b_pick_give", {slot = 1}, cw, "forge_give_1")})
  else
    local more = #r.give < max_give
    gives(mod_loc("DO"), r.give, "forge_b_pick_give", "forge_give_", more and mod_loc("+ Give more") or nil, {slot = #r.give + 1}, "forge_add_give", G.C.RED)
  end
  if advanced() and #r.only > 0 and #r.give > 0 then
    local alt = r.alt or {}
    gives(mod_loc("OTHERWISE"), alt, "forge_b_pick_alt", "forge_alt_", #alt < 2 and mod_loc("+ Otherwise") or nil, {slot = #alt + 1}, "forge_add_alt", UIK.C.inactive)
  end
  return out
end

local function rule_block(r, w, avail)
  local lines = block_lines(r, w - 0.28)
  local pages, cur, used = {}, {}, 0
  local pager_h = B.line_h("pager")
  local total = 0
  for _, l in ipairs(lines) do total = total + l.uik_h end
  local room = total <= avail and avail or avail - pager_h
  for _, l in ipairs(lines) do
    if #cur > 0 and used + l.uik_h > room then pages[#pages + 1] = cur; cur, used = {}, 0 end
    cur[#cur + 1] = l
    used = used + l.uik_h
  end
  if #cur > 0 then pages[#pages + 1] = cur end
  B.state.part_page = math.max(1, math.min(B.state.part_page or 1, #pages))
  local nodes = {}
  for _, l in ipairs(pages[B.state.part_page] or {}) do nodes[#nodes + 1] = l end
  if #pages > 1 then
    nodes[#nodes + 1] = UIK.pager{prev = "forge_b_part_page", next = "forge_b_part_page", prev_ref = {d = -1}, next_ref = {d = 1}, text = string.format(mod_loc("Page %d of %d"), B.state.part_page, #pages), w = w - 0.28}
  end
  return {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = "tm", minw = w, r = 0.15, padding = 0.08, colour = UIK.C.section}, nodes = nodes},
  }}
end

local function rule_nav(d, w)
  local n = #d.rules
  local h = touch() and 0.7 or 0.56
  local ls = touch() and 0.42 or 0.38
  local label = {n = G.UIT.C, config = {align = "cm", padding = 0.02}, nodes = {UIK.text(mod_loc("Rule"), {scale = ls, colour = UIK.C.title})}}
  local lw = UIK.text_w(mod_loc("Rule"), ls) + 0.04
  local names = {}
  if n < D.MAX_RULES then names = n > 0 and {"+ New", "Copy"} or {"+ New"} end
  if n > 0 then names[#names + 1] = "Remove" end
  local function layout(cw, bw0, gw)
    local bw = bw0
    for _, l in ipairs(names) do bw = math.max(bw, UIK.text_w(mod_loc(l), sc()) + 0.3) end
    local total = lw + 0.08 + n * (cw + 0.16) + gw + 0.08 + #names * (bw + 0.16) + 0.08
    return cw, bw, gw, total
  end
  local cw, bw, gw, total = layout(touch() and 0.66 or 0.55, touch() and 1.6 or 1.35, 0.3)
  if total > w then
    local cw2, bw2, gw2, total2 = layout(touch() and 0.6 or 0.48, 0, 0.15)
    if total2 <= w then cw, bw, gw, total = cw2, bw2, gw2, total2 end
  end
  local tabs = {}
  for i = 1, n do
    tabs[#tabs + 1] = UIK.button{label = tostring(i), button = "forge_b_rule_go", ref_table = {i = i}, colour = i == B.state.rule_i and G.C.RED or UIK.C.inactive, w = cw, h = h, scale = sc(), col = true, id = "forge_rule_" .. i}
  end
  local acts = {}
  local funcs = {["+ New"] = {"forge_b_add_rule", UIK.C.ok, "forge_add_rule"}, Copy = {"forge_b_copy_rule", UIK.C.accent, "forge_copy_rule"}, Remove = {"forge_b_del_rule", UIK.C.danger, "forge_del_rule"}}
  for _, l in ipairs(names) do
    local f = funcs[l]
    acts[#acts + 1] = button(mod_loc(l), f[1], nil, f[2], bw, h, f[3])
  end
  if total <= w then
    local list = {label}
    for _, t in ipairs(tabs) do list[#list + 1] = t end
    list[#list + 1] = gap(gw)
    for _, a in ipairs(acts) do list[#list + 1] = a end
    return {hrow(list, w, 0.08)}
  end
  local cur = B.state.rule_i or 1
  local aw = touch() and 0.7 or 0.55
  local txt = string.format(mod_loc("Rule %d of %d"), cur, n)
  local mw = UIK.text_w(txt, ls) + 0.3
  local pager = {
    UIK.button{label = "<", button = "forge_b_rule_go", ref_table = {i = cur > 1 and cur - 1 or n}, colour = G.C.RED, w = aw, h = h, scale = sc(), col = true, id = "forge_rule_prev"},
    {n = G.UIT.C, config = {align = "cm", minw = mw, minh = h, r = 0.1, colour = UIK.C.inactive}, nodes = {UIK.text(txt, {scale = ls, colour = G.C.UI.TEXT_LIGHT})}},
    UIK.button{label = ">", button = "forge_b_rule_go", ref_table = {i = cur < n and cur + 1 or 1}, colour = G.C.RED, w = aw, h = h, scale = sc(), col = true, id = "forge_rule_next"},
  }
  local pw = 2 * (aw + 0.16) + mw + 0.08
  if pw + gw + #acts * (bw + 0.16) + 0.08 <= w then
    local list = {}
    for _, t in ipairs(pager) do list[#list + 1] = t end
    list[#list + 1] = gap(gw)
    for _, a in ipairs(acts) do list[#list + 1] = a end
    return {hrow(list, w, 0.08)}
  end
  return {hrow(pager, w, 0.08), hrow(acts, w, 0.1)}
end

local function warnings(d)
  local out = {}
  local name = tostring(d and d.name or ""):gsub("%c", "")
  if #name > Store.MAX_NAME then out[#out + 1] = string.format(mod_loc("Name too long, it will be saved as: %s"), Store.cut(name, Store.MAX_NAME)) end
  if d and d.kind == "joker" and #(d.rules or {}) > R.MAX_RULES then out[#out + 1] = string.format(mod_loc("Only the first %d rules are kept, %d will be dropped"), R.MAX_RULES, #d.rules - R.MAX_RULES) end
  return out
end
B.warnings = warnings

local function problems_row(d, w)
  local list = D.problems(d)
  if #list == 0 then
    local warn = warnings(d)
    if #warn == 0 then return nil end
    if B.state.warned == table.concat(warn, "|") then warn[#warn + 1] = mod_loc("Save again to keep it this way.") end
    return UIK.note(warn, {w = w, colour = G.C.ORANGE, scale = touch() and 0.36 or 0.33})
  end
  return UIK.note({list[1]}, {w = w, colour = G.C.RED, scale = touch() and 0.36 or 0.33})
end

local function warned_first()
  local warn = warnings(draft())
  if #warn == 0 then return false end
  local sig = table.concat(warn, "|")
  if B.state.warned == sig then return false end
  B.state.warned = sig
  play_sound("cancel", 0.8, 0.6)
  refresh()
  return true
end

local function joker_price(d, w)
  local cw = touch() and 3.2 or 2.9
  local names, own = {}, R.own_values("rarity")
  for i = 1, 4 do names[i] = Cat.value_label("rarity", i) end
  local cur = d.rarity or 1
  for i, v in ipairs(own) do
    names[4 + i] = R.own_label("rarity", v)
    if d.own_rarity == v then cur = 4 + i end
  end
  local nodes = hrow({
    UIK.cycle{options = names, current = cur, w = cw, cw = cw - 0.2, no_pips = true, callback = function(i)
      if i > 4 then d.own_rarity, d.rarity = own[i - 4], 3 else d.own_rarity, d.rarity = nil, i end
      B.dirty = true; refresh()
    end},
    UIK.stepper{ref_table = d, ref_value = "cost", min = 1, max = 20, step = 1, w = cw, cw = cw - 0.2, format = function(v) return "$" .. tostring(v) end, callback = function() B.dirty = true; refresh() end},
  }, w, 0.3)
  local b = D.balance(d)
  local colour = b == "weak" and G.C.ORANGE or b == "strong" and G.C.RED or G.C.GREEN
  return {nodes, hrow({word(D.balance_label(b)), {n = G.UIT.C, config = {minw = 0.4}, nodes = {}}, {n = G.UIT.C, config = {align = "cm"}, nodes = {UIK.text(D.cost_hint(d), {scale = 0.34, colour = UIK.C.muted})}}}, w), colour}
end

mod_loc_register{
  fr = {["Numbers each card with it remembers. A rule can change one, check it, or give Chips or Mult for each point."] = "Des nombres que chaque carte qui l'a retient. Une règle peut en changer un, le vérifier, ou donner des Jetons ou du Multi par point.",
    ["Numbers kept for the whole run. A rule can change one, check it, or give Chips or Mult for each point."] = "Des nombres gardés pour toute la partie. Une règle peut en changer un, le vérifier, ou donner des Jetons ou du Multi par point."},
  es = {["Numbers each card with it remembers. A rule can change one, check it, or give Chips or Mult for each point."] = "Números que recuerda cada carta que la tiene. Una regla puede cambiar uno, comprobarlo o dar Fichas o multi por cada punto.",
    ["Numbers kept for the whole run. A rule can change one, check it, or give Chips or Mult for each point."] = "Números que se guardan toda la partida. Una regla puede cambiar uno, comprobarlo o dar Fichas o multi por cada punto."},
}

B.VARS_NOTE = {
  joker = "Values this joker remembers: a number, or a suit, rank, hand, edition, enhancement or seal. A rule can change one or check it, and a number can give Chips or Mult for each point.",
  card = "Numbers each card with it remembers. A rule can change one, check it, or give Chips or Mult for each point.",
  run = "Numbers kept for the whole run. A rule can change one, check it, or give Chips or Mult for each point.",
}

local function vars_body(w)
  local d = draft()
  d.vars = d.vars or {}
  local nodes = {step_title(1, mod_loc("VARIABLES"), w)}
  local note = mod_loc(B.VARS_NOTE[host()] or B.VARS_NOTE.run)
  local n1, n2 = note:match("^(.-[%.!?])%s+(.+)$")
  local ns = touch() and 0.38 or 0.34
  local lines = {}
  for _, l in ipairs(n1 and {n1, n2} or {note}) do
    local mid, cut = #l / 2, nil
    for i in l:gmatch("() ") do if not cut or math.abs(i - mid) < math.abs(cut - mid) then cut = i end end
    if cut and UIK.text_w(l, ns) > w - 0.2 then
      lines[#lines + 1] = l:sub(1, cut - 1)
      lines[#lines + 1] = l:sub(cut + 1)
    else
      lines[#lines + 1] = l
    end
  end
  nodes[#nodes + 1] = UIK.note(lines, {w = w, scale = ns})
  local iw = touch() and 2.8 or 3.2
  local cw = touch() and 2.7 or 3.0
  local bw = touch() and 2.0 or 2.1
  local stack = iw + 0.2 + cw + 0.4 + cw + 0.2 + 2 * B.jump_w() + B.type_w() + 0.2 + bw + 0.6 > w
  for i, v in ipairs(d.vars) do
    local name = boxed(UIK.input{ref_table = v, ref_value = "name", max_length = R.VAR_NAME, w = iw + 0.2, iw = iw, extended_corpus = true})
    local start
    local kind = button(string.format(mod_loc("Type: %s"), mod_loc(B.VAR_TYPE_LABEL[v.type or "number"] or "Number")), "forge_b_var_type", {i = i}, UIK.C.accent, (stack and cw + 0.8 or cw) + 0.2, nil, "forge_var_type_" .. i)
    if typed(v) then
      start = button(string.format(mod_loc("Starts as %s"), R.var_show(v.type, v.start or "random", lang())), "forge_b_var_start", {i = i}, UIK.C.accent, (stack and cw + 0.8 or cw) + 0.2, nil, "forge_var_start_" .. i)
    else
      start = B.num_row(nil, v, "start", R.NUM.var_start, function(x) return string.format(mod_loc("Starts at %s"), T.fmt_n(x)) end, (stack and cw + 0.8 or cw) + 0.2, nil, true)
    end
    local del = button(mod_loc("Remove it"), "forge_b_var_del", {i = i}, UIK.C.danger, bw, nil, "forge_var_del_" .. i)
    if stack then
      nodes[#nodes + 1] = hrow({name, del}, w, 0.15)
      nodes[#nodes + 1] = hrow({kind}, w)
      nodes[#nodes + 1] = hrow({start}, w)
    else
      nodes[#nodes + 1] = hrow({name, kind, start, del}, w, 0.15)
    end
  end
  if #d.vars < R.MAX_VARS then
    nodes[#nodes + 1] = hrow({button(mod_loc("+ Add a variable"), "forge_b_var_add", nil, UIK.C.ok, math.max(touch() and 3.4 or 3.0, UIK.text_w(mod_loc("+ Add a variable"), sc()) + 0.4), nil, "forge_var_add")}, w)
  end
  nodes[#nodes + 1] = problems_row(d, w)
  return nodes
end

function B.jump_w() return touch() and 0.85 or 0.75 end

function B.type_w() return touch() and 1.35 or 1.15 end

local function type_row(label, ty, cw, extra)
  local jw = B.jump_w()
  local h = extra and (touch() and 0.7 or 0.56) or (touch() and 0.62 or 0.5)
  local tw = B.type_w()
  local iw = cw + (extra or (2 * jw)) + 0.1
  local input = create_text_input({ref_table = ty, ref_value = "text", max_length = 18, w = iw, h = h, text_scale = touch() and 0.38 or 0.34, extended_corpus = true, prompt_text = "", callback = function() B.type_commit() end})
  local box = UIBox{definition = {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR, padding = 0}, nodes = {input}}, config = {offset = {x = 0, y = 0}}}
  B.type_box = box
  local ok = UIK.button{label = mod_loc("OK"), button = "forge_b_type_ok", colour = UIK.C.ok, w = tw, h = h, scale = fit(mod_loc("OK"), tw, touch() and 0.38 or 0.34), col = true, id = "forge_type_ok"}
  local row = {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = {obj(box), {n = G.UIT.C, config = {minw = 0.1}, nodes = {}}, ok}}
  if ty.err and not label then
    local nw = iw + 0.1 + tw
    local note = UIK.note({ty.err}, {w = nw, scale = touch() and 0.36 or 0.32, colour = G.C.UI.TEXT_LIGHT})
    local bad = {n = G.UIT.C, config = {align = "cm", r = 0.08, padding = 0.04, colour = UIK.C.danger}, nodes = {note}}
    return {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = {row, {n = G.UIT.R, config = {align = "cm", padding = 0.03}, nodes = {bad}}}}
  end
  if not label then return {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = {row}} end
  return {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = {
    {n = G.UIT.R, config = {align = "cm", minh = touch() and 0.54 or 0.46, padding = 0}, nodes = {{n = G.UIT.C, config = {align = "cm", maxw = cw + 2 * jw + tw}, nodes = {UIK.text(label, {scale = touch() and 0.44 or 0.4, colour = UIK.C.text})}}}},
    row,
  }}
end

function B.type_commit()
  local ty = B.state.typing
  if not ty then return end
  local txt = tostring(ty.text or ""):gsub(",", "."):gsub("[^%d%.%-eE+]", "")
  local v = tonumber(txt)
  local spec = ty.spec
  if v and v == v and spec and type(ty.t) == "table" then
    local note = B.easy_range_note and B.easy_range_note(ty)
    if note then
      ty.err = note
      refresh()
      B.focus_type()
      return
    end
    v = math.max(spec.lo, math.min(spec.hi, v))
    if spec.step % 1 == 0 and spec.lo % 1 == 0 then v = math.floor(v + 0.5) else v = math.floor(v * 100 + 0.5) / 100 end
    ty.t[ty.k] = v
    B.touched(ty.t, ty.k)
    B.dirty = true
  end
  B.state.typing = nil
  B.type_box = nil
  refresh()
end

function B.touched(t, k)
  local d = draft()
  if d and t == d.fields then D.choose(d, k) end
end

function B.flat_step(ref, key, spec, fmt, cw, h)
  local aw = touch() and 0.6 or 0.5
  local vw = cw - 2 * aw - 0.1
  local s = touch() and 0.4 or 0.36
  local v = tonumber(ref[key]) or spec.lo
  local disp = {s = fmt and fmt(v) or T.fmt_n(v), fmt = fmt}
  local function arrow(d, glyph)
    return UIK.button{label = glyph, button = "forge_b_jump", func = "forge_b_hold", ref_table = {t = ref, k = key, d = d, spec = spec, disp = disp}, colour = G.C.RED, w = aw, h = h, scale = s, col = true, id = "forge_step_" .. key .. "_" .. (d > 0 and "up" or "down")}
  end
  local mid = {n = G.UIT.C, config = {align = "cm", minw = vw, maxw = vw, minh = h, r = 0.1, colour = G.C.RED}, nodes = {
    {n = G.UIT.C, config = {align = "cm", maxw = vw - 0.3, padding = 0}, nodes = {
      {n = G.UIT.T, config = {ref_table = disp, ref_value = "s", scale = s * 1.15, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
    }},
  }}
  local g = {n = G.UIT.C, config = {minw = 0.05}, nodes = {}}
  return {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = {arrow(-spec.step, "<"), g, mid, {n = G.UIT.C, config = {minw = 0.05}, nodes = {}}, arrow(spec.step, ">")}}
end

function B.nv_button(ref, nvs, h)
  local tw = B.type_w()
  local on = ref.nv ~= nil
  local tl = mod_loc(on and "Number" or "Variable")
  local colour = on and UIK.C.accent or G.C.PURPLE
  return UIK.button{label = tl, button = "forge_b_nv", ref_table = {t = ref, list = nvs}, colour = colour, w = tw, h = h, scale = fit(tl, tw, touch() and 0.36 or 0.32), col = true, id = "forge_nv"}
end

function B.nv_step(ref, nvs, w, h)
  local aw = touch() and 0.6 or 0.5
  local s = touch() and 0.4 or 0.36
  local many = #nvs > 1
  local vw = many and (w - 2 * aw - 0.1) or w
  local name = "[" .. T.var_name(dvars(), ref.nv) .. "]"
  local mid = {n = G.UIT.C, config = {align = "cm", minw = vw, maxw = vw, minh = h, r = 0.1, colour = G.C.PURPLE}, nodes = {
    {n = G.UIT.C, config = {align = "cm", maxw = vw - 0.3, padding = 0}, nodes = {
      {n = G.UIT.T, config = {text = name, scale = s * 1.15, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
    }},
  }}
  if not many then return mid end
  local function arrow(d, glyph)
    local id = "forge_nv_" .. (d > 0 and "up" or "down")
    return UIK.button{label = glyph, button = "forge_b_nv_step", ref_table = {t = ref, d = d, list = nvs}, colour = G.C.PURPLE, w = aw, h = h, scale = s, col = true, id = id}
  end
  local g = function() return {n = G.UIT.C, config = {minw = 0.05}, nodes = {}} end
  return {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = {arrow(-1, "<"), g(), mid, g(), arrow(1, ">")}}
end

function B.num_row(label, ref, key, spec, fmt, cw, compact, flat, nvs)
  local ty = B.state.typing
  local h = flat and (touch() and 0.7 or 0.56) or (touch() and 0.62 or 0.5)
  local vb = flat and key == "n" and type(nvs) == "table" and #nvs > 0
  local function with_nv(cells)
    if not vb then return cells end
    cells[#cells + 1] = {n = G.UIT.C, config = {minw = 0.05}, nodes = {}}
    cells[#cells + 1] = B.nv_button(ref, nvs, h)
    return cells
  end
  if ty and ty.t == ref and ty.k == key then
    local tr = type_row(label, ty, cw, flat and (compact and -0.15 or 2 * B.jump_w() - 0.05) or nil)
    if not vb then return tr end
    return {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = with_nv({tr})}
  end
  local jw = B.jump_w()
  if vb and ref.nv ~= nil then
    local full = (spec.big and not compact) and (cw + 2 * jw + 0.15 + B.type_w()) or (cw + 0.05 + B.type_w())
    return {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = with_nv({B.nv_step(ref, nvs, full, h)})}
  end
  local st = flat and B.flat_step(ref, key, spec, fmt, cw, h) or UIK.stepper{ref_table = ref, ref_value = key, min = spec.lo, max = spec.hi, step = spec.step, w = cw, cw = cw - 0.2, format = fmt, callback = function() B.dirty = true; refresh() end}
  local tw = B.type_w()
  local tl = mod_loc("Type")
  local typer = UIK.button{label = tl, button = "forge_b_type", ref_table = {t = ref, k = key, spec = spec}, colour = UIK.C.accent, w = tw, h = h, scale = fit(tl, tw, touch() and 0.36 or 0.32), col = true, id = "forge_type_" .. key}
  local function jump(d)
    local txt = (d > 0 and "+" or "-") .. T.fmt_n(math.abs(d))
    return UIK.button{label = txt, button = "forge_b_jump", ref_table = {t = ref, k = key, d = d, spec = spec}, colour = UIK.C.inactive, w = jw, h = h, scale = fit(txt, jw, touch() and 0.36 or 0.32), col = true, id = "forge_jump_" .. key .. "_" .. (d > 0 and "up" or "down")}
  end
  if st.n == G.UIT.R then st.n = G.UIT.C end
  local gap = function() return {n = G.UIT.C, config = {minw = 0.05}, nodes = {}} end
  local cells = (spec.big and not compact) and {jump(-spec.big), gap(), st, gap(), jump(spec.big), gap(), typer} or {st, gap(), typer}
  with_nv(cells)
  if not label then return {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = cells} end
  return {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = {
    {n = G.UIT.R, config = {align = "cm", minh = touch() and 0.54 or 0.46, padding = 0}, nodes = {{n = G.UIT.C, config = {align = "cm", maxw = cw + 2 * jw + tw}, nodes = {UIK.text(label, {scale = touch() and 0.44 or 0.4, colour = UIK.C.text})}}}},
    {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = cells},
  }}
end

local function joker_body(w)
  local d = draft()
  local r = rule()
  local nodes = {}
  local sec = advanced() and (B.state.sec or "rules") or "all"
  if sec == "vars" then return vars_body(w) end
  if sec == "looks" and B.looks_body then return B.looks_body(w) end
  if sec == "try" and B.sample_body then return B.sample_body(w) end
  if sec == "basics" then
    local price = joker_price(d, w)
    nodes[#nodes + 1] = step_title(1, mod_loc("PRICE AND RARITY"), w)
    nodes[#nodes + 1] = price[1]
    nodes[#nodes + 1] = price[2]
    d.compat = d.compat or {blueprint = true, eternal = true, perishable = true}
    nodes[#nodes + 1] = step_title(2, mod_loc("SWITCHES"), w)
    local labels = {mod_loc("Blueprint copies it"), mod_loc("Can be Eternal"), mod_loc("Can be Perishable")}
    local lw = 0
    for _, l in ipairs(labels) do lw = math.max(lw, UIK.text_w(l, touch() and 0.42 or 0.38)) end
    local tw = math.min(w, lw + 1.6)
    for i, key in ipairs({"blueprint", "eternal", "perishable"}) do
      nodes[#nodes + 1] = hrow({UIK.toggle{label = labels[i], ref_table = d.compat, ref_value = key, w = tw, uik_lw = math.min(lw + 0.1, tw - 1.2)}}, w)
    end
    local Always = require("functions/forge/forge_always")
    local af = Always.JOKER_FIELD
    nodes[#nodes + 1] = step_title(3, upper(Always.title()), w)
    local per = Always.per_row()
    local fw = (w - 0.2 * (per - 1)) / per - 0.05
    local _, ch, cw = B.cell_dims(fw)
    local shop = B.requires_cell("Appears in shops", d.requires, fw)
    local ed = B.cell(Always.label(), B.flat_cycle(af, Cat.value_label("always_edition", d.always_ed), cw, ch), fw)
    if per == 2 then
      nodes[#nodes + 1] = hrow({shop, ed}, w, 0.2)
    else
      nodes[#nodes + 1] = hrow({shop}, w, 0.2)
      nodes[#nodes + 1] = hrow({ed}, w, 0.2)
    end
    return nodes
  end
  local nav = rule_nav(d, w)
  for _, row in ipairs(nav) do nodes[#nodes + 1] = row end
  local has_problem = #D.problems(d) > 0
  local mode_h = (touch() and 0.84 or 0.7) + (UIK.portrait() and 0.6 or 0)
  local avail = UIK.H - 0.16 - mode_h - (touch() and 0.8 or 0.64) * #nav - (has_problem and 0.45 or 0) - (UIK.portrait() and B.port_top_h or 0)
  nodes[#nodes + 1] = {n = G.UIT.R, config = {minh = 0.06}, nodes = {}}
  B.last_avail = avail
  local block = #d.rules > 0 and (B.sentence_on() and B.sentence_block(r, w) or rule_block(r, w, avail))
  nodes[#nodes + 1] = #d.rules == 0 and hrow({UIK.text(mod_loc("No rules. Press + New to add one."), {scale = touch() and 0.4 or 0.36, colour = UIK.C.muted})}, w) or block
  nodes[#nodes + 1] = problems_row(d, w)
  if sec == "rules" then return nodes end
  local price = joker_price(d, w)
  nodes[#nodes + 1] = step_title(2, mod_loc("PRICE AND RARITY"), w)
  nodes[#nodes + 1] = price[1]
  nodes[#nodes + 1] = price[2]
  return nodes
end

function B.requires_text(v)
  if not v or v == "none" then return mod_loc("Directly, no voucher needed") end
  local gate = require("functions/forge/forge_gates").text(v)
  if gate then return gate end
  return string.format(mod_loc("After %s is bought"), Cat.value_label("voucher", v))
end

function B.cell_dims(fw)
  local lh = touch() and 0.54 or 0.46
  local ch = touch() and 0.7 or 0.56
  local cw = math.min(fw - 0.1, (touch() and 2.9 or 2.6) + B.type_w() + 0.05)
  return lh, ch, cw
end

function B.cell(label, control, fw)
  local lh, ch = B.cell_dims(fw)
  if control.n == G.UIT.R then control.n = G.UIT.C end
  return {n = G.UIT.C, config = {align = "tm", minw = fw, maxw = fw, padding = 0}, nodes = {
    {n = G.UIT.R, config = {align = "cm", minw = fw, minh = lh, padding = 0}, nodes = {{n = G.UIT.C, config = {align = "cm", maxw = fw - 0.1}, nodes = {UIK.text(label, {scale = touch() and 0.44 or 0.4, colour = UIK.C.text})}}}},
    {n = G.UIT.R, config = {align = "cm", minw = fw, minh = ch + 0.1, padding = 0}, nodes = {control}},
  }}
end

function B.empty_cell(fw) return {n = G.UIT.C, config = {minw = fw, maxw = fw}, nodes = {}} end

function B.field_set(d, f, v)
  if f.top then
    d[f.id] = v ~= "none" and v or nil
    B.dirty = true
    return
  end
  d.fields[f.id] = v
  D.choose(d, f.id)
  local More = rawget(_G, "ForgeKinds") and ForgeKinds.more
  if d.kind == "booster" and f.id == "size" and More and More.PACK_SHOWN[v] then
    d.fields.shown, d.fields.choose = More.PACK_SHOWN[v], More.PACK_CHOOSE[v]
  end
  B.dirty = true
end

function B.flat_cycle(f, label, cw, h)
  local aw = touch() and 0.6 or 0.5
  local vw = cw - 2 * aw - 0.1
  local s = touch() and 0.4 or 0.36
  local function arrow(dir, glyph)
    return UIK.button{label = glyph, button = "forge_b_fcycle", ref_table = {f = f, d = dir}, colour = G.C.RED, w = aw, h = h, scale = s, col = true, id = "forge_cyc_" .. f.id .. "_" .. (dir > 0 and "up" or "down")}
  end
  local mid = {n = G.UIT.C, config = {align = "cm", minw = vw, maxw = vw, minh = h, r = 0.1, colour = G.C.RED}, nodes = {
    {n = G.UIT.C, config = {align = "cm", maxw = vw - 0.2, padding = 0}, nodes = {
      {n = G.UIT.T, config = {text = label, scale = s * 1.15, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
    }},
  }}
  local g = function() return {n = G.UIT.C, config = {minw = 0.05}, nodes = {}} end
  return {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = {arrow(-1, "<"), g(), mid, g(), arrow(1, ">")}}
end

G.FUNCS.forge_b_fcycle = function(e)
  local r2 = e and e.config and e.config.ref_table or {}
  local d, f = draft(), r2.f
  if not (d and f) then return end
  local values = Cat.field_values(f)
  if #values == 0 then return end
  local cur = 1
  local now = f.top and (d[f.id] or "none") or d.fields[f.id]
  for i, v in ipairs(values) do if v == now then cur = i end end
  if not f.top and D.unset(d, f.id) then cur = (r2.d or 1) > 0 and 0 or #values + 1 end
  cur = (cur - 1 + (r2.d or 1)) % #values + 1
  B.field_set(d, f, values[cur])
  play_sound("paper1", 1, 0.3)
  refresh()
end

function B.requires_cell(label, v, w)
  local _, h, cw = B.cell_dims(w)
  local txt, s = wrap_label(B.requires_text(v), cw, sc())
  return B.cell(mod_loc(label), UIK.button{label = txt, button = "forge_b_requires", ref_table = {}, colour = UIK.C.accent, w = cw, h = h, scale = s, col = true, id = "forge_requires"}, w)
end

local function field_row(d, f, w)
  local fields = d.fields
  local _, h, cw = B.cell_dims(w)
  local label = mod_loc(f.label)
  if f.dynamic == "voucher" then return B.requires_cell(f.label, fields[f.id], w) end
  if f.dynamic == "joker" then
    local txt = D.unset(d, f.id) and mod_loc("Not chosen yet") or R.card_label(fields[f.id])
    return B.cell(label, UIK.button{label = txt, button = "forge_b_pick_joker", ref_table = {field = f.id, label = label}, colour = UIK.C.accent, w = cw, h = h, scale = fit(txt, cw, sc()), col = true, id = "forge_pick_" .. f.id}, w)
  end
  if f.type == "num" then
    return B.cell(label, B.num_row(nil, fields, f.id, f.num, function(v) if D.unset(d, f.id) then return mod_loc("Not chosen yet") end return Cat.fmt(f.num, v) end, cw - B.type_w() - 0.05, true, true), w)
  end
  if f.type == "toggle" then
    local box = UIK.checkbox({ref_table = fields, ref_value = f.id, callback = function() B.dirty = true; refresh() end})
    local ts = touch() and 0.44 or 0.4
    local bw = (touch() and 1.15 or 1) * 0.5 + 0.06
    local lw = math.min(UIK.text_w(label, ts) + 0.05, w - bw - 0.25)
    return {n = G.UIT.C, config = {align = "cm", minw = w, maxw = w, minh = h + 0.1, padding = 0, focus_args = {funnel_from = true}}, nodes = {
      {n = G.UIT.C, config = {align = "cr", maxw = lw, padding = 0}, nodes = {UIK.text(label, {scale = ts, colour = UIK.C.text})}},
      {n = G.UIT.C, config = {minw = 0.15}, nodes = {}},
      box,
    }}
  end
  return B.cell(label, B.flat_cycle(f, D.unset(d, f.id) and mod_loc("Not chosen yet") or Cat.value_label(Cat.field_what(f), fields[f.id]), cw, h), w)
end

local function num_cell(t, key, spec, w)
  local nw = math.max(1.8, math.min(touch() and 2.9 or 2.6, w - B.type_w() - 0.15))
  return B.num_row(nil, t, key, spec, function(v) return Cat.fmt(spec, v) end, nw, true, true)
end

local function num_cell_w(w) return math.max(1.8, math.min(touch() and 2.9 or 2.6, w - B.type_w() - 0.15)) + B.type_w() + 0.15 end

function B.look_toggle(e, w)
  local label = mod_loc(LK.REPLACE)
  local box = UIK.checkbox({ref_table = e, ref_value = "replace", callback = function() B.dirty = true; refresh() end})
  local ts = touch() and 0.44 or 0.4
  local bw = (touch() and 1.15 or 1) * 0.5 + 0.06
  local lw = math.min(UIK.text_w(label, ts) + 0.05, w - bw - 0.25)
  return {n = G.UIT.C, config = {align = "cm", minw = lw + bw + 0.15, minh = btn_h(), padding = 0, focus_args = {funnel_from = true}}, nodes = {
    {n = G.UIT.C, config = {align = "cr", maxw = lw, padding = 0}, nodes = {UIK.text(label, {scale = ts, colour = UIK.C.text})}},
    {n = G.UIT.C, config = {minw = 0.15}, nodes = {}},
    box,
  }}
end

local function look_rows(d, i, e, spec, w)
  local rows = {}
  local tl, ll = Cat.value_label(spec.v, e.v), LK.look_label(e.lk, e.look)
  local extra = advanced() or (tonumber(e.n) or 1) > 1 or e.replace
  if UIK.portrait() then
    local hw = (w - 0.23) / 2
    rows[1] = hrow({button(mod_loc(spec.label), "forge_b_pick_effect", {slot = i}, G.C.RED, w, nil, "forge_eff_" .. i)}, w)
    rows[2] = hrow({button(tl, "forge_b_pick_value", {slot = i}, UIK.C.accent, hw, nil, "forge_val_" .. i),
      button(ll, "forge_b_pick_look", {slot = i}, UIK.C.accent, hw, nil, "forge_look_" .. i)}, w, 0.15)
    if extra then
      local nw = math.min(num_cell_w(w), w * 0.5)
      rows[3] = hrow({num_cell(e, "n", spec.num, nw), B.look_toggle(e, w - nw - 0.2)}, w, 0.12)
    end
  else
    local vw = touch() and 3.0 or 2.7
    local lw = math.max(2.6, math.min(touch() and 4.6 or 4.2, w - 2 * vw - 0.4))
    rows[1] = hrow({button(mod_loc(spec.label), "forge_b_pick_effect", {slot = i}, G.C.RED, lw, nil, "forge_eff_" .. i),
      button(tl, "forge_b_pick_value", {slot = i}, UIK.C.accent, vw, nil, "forge_val_" .. i),
      button(ll, "forge_b_pick_look", {slot = i}, UIK.C.accent, vw, nil, "forge_look_" .. i)}, w, 0.12)
    if extra then
      local rw = 2 * vw + 0.12
      rows[2] = hrow({{n = G.UIT.C, config = {align = "cm", minw = lw, maxw = lw, padding = 0}, nodes = {num_cell(e, "n", spec.num, lw)}},
        {n = G.UIT.C, config = {align = "cm", minw = rw, maxw = rw, padding = 0}, nodes = {B.look_toggle(e, rw)}}}, w, 0.12)
    end
  end
  return rows, #rows
end

local function effect_rows(d, i, e, w)
  local spec = Cat.effect(d.kind, e.id)
  if spec and spec.look then return look_rows(d, i, e, spec, w) end
  local port = UIK.portrait()
  local rows = {}
  local has_v, has_n = spec and spec.v, spec and spec.num
  local nw = has_n and num_cell_w(w) or 0
  if port then
    local vw = has_v and (has_n and math.max(2.2, w - nw - 0.15) or w) or 0
    rows[1] = hrow({button(mod_loc(spec and spec.label or e.id), "forge_b_pick_effect", {slot = i}, G.C.RED, w, nil, "forge_eff_" .. i)}, w)
    local parts = {}
    if has_v then parts[#parts + 1] = button(Cat.value_label(spec.v, e.v), "forge_b_pick_value", {slot = i}, UIK.C.accent, vw, nil, "forge_val_" .. i) end
    if has_n then parts[#parts + 1] = num_cell(e, "n", spec.num, w - (has_v and vw + 0.15 or 0)) end
    if #parts > 0 then rows[2] = hrow(parts, w, 0.12) end
  else
    local vw = has_v and (touch() and 3.0 or 2.7) or 0
    local lw = math.max(2.6, math.min(touch() and 4.6 or 4.2, w - vw - nw - 0.4))
    local parts = {button(mod_loc(spec and spec.label or e.id), "forge_b_pick_effect", {slot = i}, G.C.RED, lw, nil, "forge_eff_" .. i)}
    if has_v then parts[#parts + 1] = button(Cat.value_label(spec.v, e.v), "forge_b_pick_value", {slot = i}, UIK.C.accent, vw, nil, "forge_val_" .. i) end
    if has_n then parts[#parts + 1] = num_cell(e, "n", spec.num, nw) end
    rows[1] = hrow(parts, w, 0.12)
  end
  local head = #rows
  local whens = spec and spec.run and Cat.whens_for(d.kind, e.id)
  if whens and #whens > 0 and (advanced() or #whens > 1 and e.when and e.when ~= whens[1]) then
    local only = e.only or {}
    local wl = Cat.when_label(d.kind, e.when or whens[1])
    local add = #only < Cat.MAX_ONLY and advanced()
    local aw = add and math.min(touch() and 3.2 or 2.9, w * 0.38) or 0
    local ww = w - aw - (add and 0.15 or 0)
    local parts = {button(plain(wl), "forge_b_fx_when", {slot = i}, G.C.ORANGE, ww, nil, "forge_when_" .. i)}
    if add then parts[#parts + 1] = button(mod_loc("+ Only if"), "forge_b_add_only", {slot = i}, G.C.BLUE, aw, nil, "forge_add_only_" .. i) end
    rows[#rows + 1] = hrow(parts, w, 0.12)
    local S = T.S[lang()] or T.S.en
    for j, o in ipairs(only) do
      local ospec = Cat.only_spec(o.id)
      local text = plain(S["if"] .. " " .. Cat.only_line(o))
      local cw = (o.n ~= nil and ospec) and num_cell_w(w) or 0
      if port and cw > 0 then
        rows[#rows + 1] = hrow({button(text, "forge_b_pick_only_fx", {slot = i, j = j}, G.C.BLUE, w, nil, "forge_only_" .. i .. "_" .. j)}, w)
        rows[#rows + 1] = hrow({num_cell(o, "n", ospec, w)}, w)
      else
        local p2 = {button(text, "forge_b_pick_only_fx", {slot = i, j = j}, G.C.BLUE, w - cw - (cw > 0 and 0.15 or 0), nil, "forge_only_" .. i .. "_" .. j)}
        if cw > 0 then p2[#p2 + 1] = num_cell(o, "n", ospec, cw) end
        rows[#rows + 1] = hrow(p2, w, 0.12)
      end
    end
  end
  return rows, head
end

function B.logic_body(w)
  local d = draft()
  local r = rule()
  local nodes = {}
  local nav = rule_nav(d, w)
  for _, row in ipairs(nav) do nodes[#nodes + 1] = row end
  local has_problem = #D.problems(d) > 0
  local mode_h = (touch() and 0.84 or 0.7) + (UIK.portrait() and 0.6 or 0)
  local avail = UIK.H - 0.16 - mode_h - (touch() and 0.8 or 0.64) * #nav - (has_problem and 0.45 or 0) - (UIK.portrait() and B.port_top_h or 0)
  nodes[#nodes + 1] = {n = G.UIT.R, config = {minh = 0.06}, nodes = {}}
  B.last_avail = avail
  nodes[#nodes + 1] = #d.rules == 0 and hrow({UIK.text(mod_loc("No rules. Press + New to add one."), {scale = touch() and 0.4 or 0.36, colour = UIK.C.muted})}, w) or rule_block(r, w, avail)
  nodes[#nodes + 1] = problems_row(d, w)
  return nodes
end

local function items_body(w)
  local d = draft()
  local k = kind()
  local nodes = {}
  if advanced() and host_rules() then
    if B.state.sec == "logic" then return B.logic_body(w) end
    if B.state.sec == "vars" then return vars_body(w) end
  end
  local fields = {}
  for _, f in ipairs(k.fields or {}) do fields[#fields + 1] = f end
  if advanced() then for _, f in ipairs(k.adv_fields or {}) do fields[#fields + 1] = f end end
  for i = #fields, 1, -1 do
    local f = fields[i]
    if f.id == "ctype" and #R.own_values("ctype") == 0 and ((d.fields or {}).ctype or "none") == "none" then table.remove(fields, i)
    elseif d.kind == "hand" and f.id == "group2" and not require("functions/forge/forge_hands").GROUPS[(d.fields or {}).pattern] then table.remove(fields, i)
    elseif d.kind == "blind" and f.id == "showdown" and require("functions/forge/forge_parity").slot_of(d) then table.remove(fields, i) end
  end
  local pick_field
  if d.kind == "tarot" or d.kind == "spectral" then
    for i = #fields, 1, -1 do if fields[i].id == "select" then pick_field = table.remove(fields, i) end end
  end
  local step = 1
  local sec = advanced() and (B.state.sec or "rules") or "all"
  if sec == "vars" then sec = "rules" end
  if sec == "rules" and #fields > 0 and Cat.max_for(d, true) == 0 then sec = "basics" end
  if sec == "rules" then fields = {} end
  if #fields > 0 then
    nodes[#nodes + 1] = step_title(step, mod_loc("ITS BASICS"), w)
    step = step + 1
    local per = (UIK.portrait() or #fields == 1) and 1 or 2
    local toggles = {}
    for i = #fields, 1, -1 do if fields[i].type == "toggle" then table.insert(toggles, 1, table.remove(fields, i)) end end
    for _, f in ipairs(toggles) do fields[#fields + 1] = f end
    local fw = (w - 0.2 * (per - 1)) / per - 0.05
    local cur = {}
    for i, f in ipairs(fields) do
      if #cur > 0 and f.type == "toggle" and fields[i - 1] and fields[i - 1].type ~= "toggle" then
        while #cur < per do cur[#cur + 1] = B.empty_cell(fw) end
        nodes[#nodes + 1] = hrow(cur, w, 0.2); cur = {}
      end
      cur[#cur + 1] = field_row(d, f, fw)
      if #cur >= per then nodes[#nodes + 1] = hrow(cur, w, 0.2); cur = {} end
    end
    if #cur > 0 then
      while #cur < per do cur[#cur + 1] = B.empty_cell(fw) end
      nodes[#nodes + 1] = hrow(cur, w, 0.2)
    end
  end
  local max = Cat.max_for(d, advanced())
  if sec ~= "basics" and Cat.max_for(d, true) > 0 and (max > 0 or #(d.effects or {}) > 0) then
    nodes[#nodes + 1] = step_title(step, k.id == "booster" and upper(mod_loc("Cards inside")) or mod_loc("WHAT IT DOES"), w)
    if pick_field then nodes[#nodes + 1] = hrow({field_row(d, pick_field, UIK.portrait() and w - 0.05 or (w - 0.2) / 2 - 0.05)}, w, 0.2) end
    local list = d.effects or {}
    local adding = #list < max
    if k.id == "booster" then
      local per = UIK.portrait() and 2 or 3
      local bw = (w - 0.15 * (per - 1)) / per - 0.05
      local items = {}
      for i, e in ipairs(list) do items[#items + 1] = button(Cat.value_label("card", e.v), "forge_b_pack_card", {slot = i}, UIK.C.accent, bw, nil, "forge_val_" .. i) end
      if adding then items[#items + 1] = button(mod_loc("+ Add a card"), "forge_b_pick_effect", {slot = #list + 1}, UIK.C.ok, bw, nil, "forge_add_effect") end
      local size = 12
      local pages = math.max(1, math.ceil(#items / size))
      if B.state.fx_focus then
        B.state.fx_page = math.ceil(B.state.fx_focus / size)
        B.state.fx_focus = nil
      end
      B.fx_pages = pages
      B.state.fx_page = math.max(1, math.min(B.state.fx_page or 1, pages))
      local shown = {}
      for i = (B.state.fx_page - 1) * size + 1, math.min(#items, B.state.fx_page * size) do shown[#shown + 1] = items[i] end
      nodes[#nodes + 1] = UIK.grid(shown, per, {w = w, padding = 0.05})
      if pages > 1 then
        nodes[#nodes + 1] = UIK.pager{prev = "forge_b_fx_page", next = "forge_b_fx_page", prev_ref = {d = -1}, next_ref = {d = 1}, text = string.format(mod_loc("Page %d of %d"), B.state.fx_page, pages), w = w - 0.28}
      end
      nodes[#nodes + 1] = problems_row(d, w)
      return nodes
    end
    local eh = btn_h() + 0.12
    local fper = UIK.portrait() and 1 or 2
    local field_h = (#fields > 0 and (0.5 + math.ceil(#fields / fper) * (btn_h() + 0.6)) or 0) + (pick_field and (btn_h() + 0.6) or 0)
    local mode_h = (touch() and 0.84 or 0.7) + (UIK.portrait() and 0.6 or 0)
    local avail = UIK.H - 0.16 - mode_h - (UIK.portrait() and B.port_top_h or 0) - ((#D.problems(d) > 0 or #warnings(d) > 0) and 0.45 * math.max(1, #warnings(d) + (B.state.warned and 1 or 0)) or 0) - field_h - (#fields > 0 and 0.5 or 0.1)
    local units = {}
    for i, e in ipairs(list) do
      local rows, head = effect_rows(d, i, e, w)
      units[#units + 1] = {rows = rows, head = head}
    end
    if adding then
      units[#units + 1] = {rows = {hrow({button(mod_loc("+ Add an effect"), "forge_b_pick_effect", {slot = #list + 1}, UIK.C.ok, math.max(touch() and 3.4 or 3.0, UIK.text_w(mod_loc("+ Add an effect"), sc()) + 0.4), nil, "forge_add_effect")}, w)}}
    end
    local total = 0
    for _, u in ipairs(units) do total = total + #u.rows * eh end
    local pages = {{}}
    local page_of = {}
    local room = total > avail and (avail - B.line_h("pager")) or avail
    local used = 0
    local fit = math.max(1, math.floor(room / eh + 1e-6))
    local function add(r)
      local pg = pages[#pages]
      pg[#pg + 1] = r
      used = used + 1
    end
    local function new_page() pages[#pages + 1] = {}; used = 0 end
    for _, u in ipairs(units) do
      local rows, head = u.rows, u.head or #u.rows
      local split = head < #rows
      if used > 0 and used + #rows > fit and not (split and fit - used >= head) then new_page() end
      page_of[#page_of + 1] = #pages
      for j, r in ipairs(rows) do
        if used >= fit and used > 0 and split and j > head then
          new_page()
          for h = 1, head do add(rows[h]) end
        end
        add(r)
      end
    end
    if B.state.fx_focus then
      B.state.fx_page = page_of[math.min(B.state.fx_focus, #page_of)] or 1
      B.state.fx_focus = nil
    end
    B.fx_pages = #pages
    B.state.fx_page = math.max(1, math.min(B.state.fx_page or 1, #pages))
    for _, r in ipairs(pages[B.state.fx_page]) do nodes[#nodes + 1] = r end
    if #pages > 1 then
      nodes[#nodes + 1] = UIK.pager{prev = "forge_b_fx_page", next = "forge_b_fx_page", prev_ref = {d = -1}, next_ref = {d = 1}, text = string.format(mod_loc("Page %d of %d"), B.state.fx_page, #pages), w = w - 0.28}
    end
  end
  nodes[#nodes + 1] = problems_row(d, w)
  return nodes
end

local function editor_port()
  local W = UIK.W
  local cw = G.CARD_W * 0.72 + 0.3
  local tw = W - cw - 0.3
  local rw = W - 0.1
  local col = left_column(tw)
  local card = table.remove(col.nodes, 1)
  B.port_top_h = G.CARD_H * 0.72 + 2.4 + (B.balance_h or 0)
  local body = draft().kind == "joker" and joker_body(rw) or items_body(rw)
  local nodes = {
    {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = {
      {n = G.UIT.C, config = {align = "cm", minw = cw, padding = 0}, nodes = {card}},
      {n = G.UIT.C, config = {minw = 0.1}, nodes = {}},
      col,
    }},
    {n = G.UIT.R, config = {minh = 0.12}, nodes = {}},
    mode_switch(rw),
    {n = G.UIT.R, config = {minh = 0.08}, nodes = {}},
  }
  for _, n in ipairs(body) do if n then nodes[#nodes + 1] = n end end
  return {n = G.UIT.R, config = {align = "tm", minw = W, minh = UIK.H - 0.4, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = "tm", padding = 0, portrait_keep = true}, nodes = nodes},
  }}
end

local function editor_body()
  if UIK.portrait() then return editor_port() end
  local lw = touch() and 4.0 or 3.6
  local rw = UIK.W - lw - 0.35
  local body = draft().kind == "joker" and joker_body(rw) or items_body(rw)
  local right = {mode_switch(rw), {n = G.UIT.R, config = {minh = 0.08}, nodes = {}}}
  for _, n in ipairs(body) do if n then right[#right + 1] = n end end
  return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, minh = UIK.H - 0.4, padding = 0}, nodes = {
    left_column(lw),
    {n = G.UIT.C, config = {minw = 0.25}, nodes = {}},
    {n = G.UIT.C, config = {align = "tm", minw = rw, padding = 0}, nodes = right},
  }}
end

B.ART_SETS = {joker = {"Joker"}, tarot = {"Tarot", "Planet", "Spectral"}, planet = {"Planet", "Tarot", "Spectral"}, spectral = {"Spectral", "Tarot", "Planet"}, voucher = {"Voucher"}}

function B.art_list(kind_id)
  local out, seen = {}, {}
  for _, set in ipairs(B.ART_SETS[kind_id] or {}) do
    local list = {}
    for _, c in ipairs(G.P_CENTER_POOLS[set] or {}) do
      local atlas = c.atlas or set
      if c.pos and c.order and not c.forge and not c.forge_draft and not c.mod and not c.no_collection and atlas == set and G.ASSET_ATLAS[atlas] then list[#list + 1] = c end
    end
    table.sort(list, function(a, b) return a.order < b.order end)
    for _, c in ipairs(list) do
      local id = (c.atlas or set) .. ":" .. c.pos.x .. ":" .. c.pos.y
      if not seen[id] then
        seen[id] = true
        out[#out + 1] = {atlas = c.atlas or set, x = c.pos.x, y = c.pos.y, key = c.key}
      end
    end
  end
  return out
end

function B.art_grid()
  if UIK.portrait() then return 6, 6 end
  if touch() then return 9, 3 end
  return 10, 3
end

local function art_body()
  local st = B.state.art
  local d = draft()
  local XT = require("functions/forge/forge_extras")
  local list = st.ink and XT.ink_list() or B.art_list(d.kind)
  local per_row, rows = B.art_grid()
  local per = per_row * rows
  local pages = math.max(1, math.ceil(#list / per))
  st.page = math.max(1, math.min(st.page or 1, pages))
  local s2 = touch() and 0.55 or 0.48
  local tw = G.CARD_W * s2 + 0.16
  local a = d.art or {}
  local items = {}
  for i = (st.page - 1) * per + 1, math.min(#list, st.page * per) do
    local it = list[i]
    local on = not it.ink and a.atlas == it.atlas and a.x == it.x and a.y == it.y
    local atlas = it.ink and (XT.ink_atlas(it, i - (st.page - 1) * per) or "Joker") or it.atlas
    local spr = still(Sprite(0, 0, G.CARD_W * s2, G.CARD_H * s2, G.ASSET_ATLAS[atlas], {x = it.x or 0, y = it.y or 0}))
    items[#items + 1] = {n = G.UIT.C, config = {align = "cm", minw = tw, padding = 0.06, r = 0.1, colour = on and G.C.RED or UIK.C.section, button = "forge_b_art_choose", ref_table = {i = i}, hover = true, shadow = true, id = "forge_art_" .. i}, nodes = {obj(spr)}}
  end
  local nodes = {title(mod_loc(st.ink and "PICK INKJOKER ART" or "PICK ITS ART"), UIK.W), UIK.grid(items, per_row, {w = UIK.W - 0.2, padding = 0.06})}
  if #items == 0 then nodes[2] = UIK.note({mod_loc("No InkJoker art found")}, {w = UIK.W - 0.4}) end
  if pages > 1 then
    nodes[#nodes + 1] = UIK.pager{prev = "forge_b_art_page", next = "forge_b_art_page", prev_ref = {d = -1}, next_ref = {d = 1}, text = string.format(mod_loc("Page %d of %d"), st.page, pages), w = UIK.W}
  end
  return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, minh = UIK.H - 0.4, padding = 0}, nodes = {{n = G.UIT.C, config = {align = "tm", padding = 0.04}, nodes = nodes}}}
end

function B.pick(o)
  o.page = 1
  if B.easy_simple_list then o = B.easy_simple_list(o) end
  o.tools = #(o.options or {}) > 15 and B.pick_list_def ~= nil
  B.state.pick = o
  refresh()
end

function B.ask_card(title, choose, remove, sets)
  local kinds = {}
  for _, set in ipairs(sets or R.CARD_KINDS) do kinds[#kinds + 1] = {label = Cat.value_label("set", set), value = set} end
  local function pick_set(set)
    local opts = {}
    for _, v in ipairs(R.card_values(set)) do opts[#opts + 1] = {label = R.card_label(v), value = v, colour = R.own_id("card", v) and G.C.GREEN or nil} end
    if #opts == 0 then
      B.state.pick = nil
      refresh()
      return
    end
    B.pick{title = title, note = mod_loc("Your own creations come first, in green."), options = opts, choose = function(v)
      choose(v)
      B.state.pick = nil
      B.dirty = true
      refresh()
    end}
  end
  if #kinds == 1 then return pick_set(kinds[1].value) end
  B.pick{title = mod_loc("WHICH KIND OF CARD?"), options = kinds, colour = UIK.C.accent, remove = remove, choose = pick_set}
end

local function pick_body()
  local p = B.state.pick
  if p.tools then
    local nodes = {title(p.title, UIK.W)}
    if p.note then nodes[#nodes + 1] = UIK.note({p.note}, {w = 12, scale = 0.34}) end
    nodes[#nodes + 1] = B.pick_search_row(p)
    local list = UIBox{definition = B.pick_list_def(p), config = {offset = {x = 0, y = 0}}}
    nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "tm", func = "forge_b_pick_watch"}, nodes = {{n = G.UIT.O, config = {object = list, id = "forge_pick_list"}}}}
    return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, minh = UIK.H - 0.4, padding = 0}, nodes = {{n = G.UIT.C, config = {align = "tm", padding = 0.04}, nodes = nodes}}}
  end
  local per_row = UIK.portrait() and 1 or 3
  local rows = UIK.portrait() and 12 or (touch() and (#p.options <= 18 and 6 or 5) or (#p.options <= 21 and 7 or 6))
  local per = per_row * rows
  local pages = math.max(1, math.ceil(#p.options / per))
  p.page = math.max(1, math.min(p.page or 1, pages))
  local bw = UIK.portrait() and 6.2 or (touch() and 4.3 or 4.5)
  local items = {}
  for i = (p.page - 1) * per + 1, math.min(#p.options, p.page * per) do
    local op = p.options[i]
    items[#items + 1] = button(op.label, "forge_b_choose", {i = i}, op.colour or p.colour or UIK.C.accent, bw, touch() and 0.82 or 0.66, "forge_opt_" .. i)
  end
  local nodes = {title(p.title, UIK.W)}
  if p.note then nodes[#nodes + 1] = UIK.note({p.note}, {w = 12, scale = 0.34}) end
  nodes[#nodes + 1] = UIK.grid(items, per_row, {w = UIK.W - 0.4, padding = 0.05})
  if pages > 1 then
    nodes[#nodes + 1] = UIK.pager{prev = "forge_b_pick_page", next = "forge_b_pick_page", prev_ref = {d = -1}, next_ref = {d = 1}, text = string.format(mod_loc("Page %d of %d"), p.page, pages), w = UIK.W}
  end
  return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, minh = UIK.H - 0.4, padding = 0}, nodes = {{n = G.UIT.C, config = {align = "tm", padding = 0.04}, nodes = nodes}}}
end

local function text_preview(lines, w)
  local d = draft()
  local list = {}
  for _, l in ipairs(lines) do if l:gsub("%s", "") ~= "" then list[#list + 1] = l end end
  if #list == 0 then list = {"{C:inactive}...{}"} end
  G.localization.descriptions.Other.forge_text_preview = {name = d.name, text = list, text_parsed = parsed_lines(list), name_parsed = {loc_parse_string(d.name or "")}}
  local nodes = {}
  local ok = pcall(localize, {type = "other", key = "forge_text_preview", nodes = nodes, vars = T.vars(nil, R.clean_vars(d.vars), nil, d.rules)})
  if not ok or #nodes == 0 then return nil end
  local box = desc_from_rows(nodes)
  box.config.minw = w - 0.2
  return {n = G.UIT.R, config = {align = "cm", minw = w, maxw = w, padding = 0.04}, nodes = {box}}
end

B.TEXT_MAX_LINES = 8
B.TEXT_MAX_LINE = 64

local function text_colour(c) return c and loc_colour(c, G.C.UI.TEXT_DARK) or G.C.UI.TEXT_DARK end

local function text_lines_of(st)
  return DE.from_chars(st.chars)
end

local function swatches(w)
  local st = B.state.text
  local s = touch() and 0.66 or 0.5
  local gap = 0.1
  local list = {"plain"}
  for _, c in ipairs(DE.COLOURS) do list[#list + 1] = c end
  list[#list + 1] = "custom"
  local per = math.max(1, math.min(#list, math.floor((w + gap) / (s + 0.11 + gap))))
  per = math.ceil(#list / math.ceil(#list / per))
  local rows, cur = {}, {}
  for _, c in ipairs(list) do
    local on = (st.brush or "plain") == c or (c == "custom" and DE.hex(st.brush) ~= nil)
    local fill = c == "plain" and G.C.WHITE or c == "custom" and st.rgb_col or loc_colour(c)
    local inner = {}
    if c == "plain" then inner = {UIK.text("A", {scale = touch() and 0.42 or 0.34, colour = G.C.UI.TEXT_DARK, shadow = false})} end
    if c == "custom" then inner = {UIK.text("+", {scale = touch() and 0.5 or 0.42, colour = G.C.WHITE})} end
    cur[#cur + 1] = {n = G.UIT.C, config = {align = "cm", padding = 0.055, r = 0.14, colour = on and G.C.WHITE or G.C.CLEAR}, nodes = {
      {n = G.UIT.C, config = {align = "cm", minw = s, minh = s, maxw = s, r = 0.1, colour = fill, button = "forge_b_brush", ref_table = {c = c}, hover = true, shadow = true, id = "forge_brush_" .. c}, nodes = inner},
    }}
    if #cur >= per then rows[#rows + 1] = hrow(cur, w, gap - 0.11); cur = {} end
  end
  if #cur > 0 then rows[#rows + 1] = hrow(cur, w, gap - 0.11) end
  if st.picking then
    local sw = math.min(w - 0.2, touch() and 6 or 5.4)
    for _, k in ipairs({"r", "g", "b"}) do
      local names = {r = "Red", g = "Green", b = "Blue"}
      local cols = {r = G.C.RED, g = G.C.GREEN, b = G.C.BLUE}
      rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", minw = w}, nodes = {UIK.slider{id = "forge_rgb_" .. k, label = mod_loc(names[k]), ref_table = st.rgb, ref_value = k, min = 0, max = 255, w = sw, colour = cols[k], callback = function() B.text_rgb() end}}}
    end
    rows[#rows + 1] = hrow({
      {n = G.UIT.C, config = {align = "cm", minw = 1.2, minh = touch() and 0.66 or 0.5, r = 0.1, colour = st.rgb_col, outline = 1, outline_colour = G.C.WHITE}, nodes = {}},
      button(mod_loc("USE THIS COLOUR"), "forge_b_rgb_use", {}, UIK.C.ok, touch() and 3.6 or 3.2, touch() and 0.66 or 0.5, "forge_rgb_use"),
    }, w, 0.2)
  end
  local name = DE.hex(st.brush) and mod_loc("Custom colour") or mod_loc(st.brush and DE.NAMES[st.brush] or "Plain")
  local hint = string.format(mod_loc("%s: what you type now is in this colour. Tap a word to paint it."), name)
  rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.04}, nodes = {UIK.text(hint, {scale = fit(hint, w, touch() and 0.36 or 0.32), colour = st.brush and loc_colour(st.brush) or UIK.C.text})}}
  return rows
end

function B.text_rgb()
  local st = B.state.text
  if not st then return end
  local r, g, b = st.rgb.r / 255, st.rgb.g / 255, st.rgb.b / 255
  st.rgb_col[1], st.rgb_col[2], st.rgb_col[3], st.rgb_col[4] = r, g, b, 1
end

local function box_def(st, w)
  local scale = touch() and 0.4 or 0.36
  local lh = scale * 1.45
  local focused = B.text_focused()
  local lines = {{}}
  for i, x in ipairs(st.chars) do
    if x.ch == "\n" then lines[#lines + 1] = {} else table.insert(lines[#lines], {x = x, i = i}) end
  end
  local cursor_line, idx = 1, 0
  for li, l in ipairs(lines) do
    if st.cur <= idx + #l then cursor_line = li break end
    idx = idx + #l + 1
  end
  local rows = {}
  local start = 0
  for li, l in ipairs(lines) do
    local sc = scale
    local total = 0
    for _, y in ipairs(l) do total = total + UIK.text_w(y.x.ch, scale) end
    if total > w - 0.5 then sc = scale * (w - 0.5) / total end
    local nodes = {}
    local function caret()
      nodes[#nodes + 1] = {n = G.UIT.C, config = {align = "cm", minw = 0.04, minh = lh * 0.9, colour = G.C.UI.TEXT_DARK, id = "forge_caret"}, nodes = {}}
    end
    local k = 1
    while k <= #l do
      if focused and li == cursor_line and st.cur == start + k - 1 then caret() end
      local first = l[k]
      local c = first.x.c
      local buf = {first.x.ch}
      local j = k + 1
      local is_sp = first.x.ch == " "
      while j <= #l and l[j].x.c == c and (l[j].x.ch == " ") == is_sp and not (focused and li == cursor_line and st.cur == start + j - 1) do
        buf[#buf + 1] = l[j].x.ch
        j = j + 1
      end
      local t = table.concat(buf)
      nodes[#nodes + 1] = {n = G.UIT.C, config = {align = "cm", padding = 0, button = not is_sp and "forge_b_word" or nil, ref_table = {i = first.i}, colour = G.C.CLEAR, id = "forge_run_" .. first.i}, nodes = {
        {n = G.UIT.T, config = {text = t, scale = sc, colour = text_colour(c)}},
      }}
      k = j
    end
    if focused and li == cursor_line and st.cur == start + #l then caret() end
    rows[#rows + 1] = {n = G.UIT.R, config = {align = "cl", minh = lh, padding = 0}, nodes = nodes}
    start = start + #l + 1
  end
  local min_lines = touch() and 4 or 5
  local box_h = math.max(min_lines, #lines) * lh + 0.3
  return {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = "tl", minw = w, maxw = w, minh = box_h, r = 0.1, padding = 0.15, colour = G.C.WHITE, outline = focused and 1.5 or 0.8, outline_colour = focused and UIK.C.title or UIK.C.inactive, button = "forge_b_box", id = "forge_text_box"}, nodes = {
      {n = G.UIT.R, config = {align = "tl", padding = 0}, nodes = rows},
    }},
  }}
end

local function preview_def(st, w)
  local box = B.text_preview_node(text_lines_of(st), w)
  return {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR, padding = 0}, nodes = {box or {n = G.UIT.R, config = {minw = w, minh = 1}, nodes = {}}}}
end

function B.text_preview_node(lines, w) return text_preview(lines, w) end

local function soft_set(id, def)
  local holder = G.OVERLAY_MENU and G.OVERLAY_MENU:get_UIE_by_ID(id)
  if not (holder and holder.config.object) then return false end
  holder.config.object:remove()
  holder.config.object = UIBox{definition = def, config = {offset = {x = 0, y = 0}, parent = holder, type = "cm"}}
  holder.UIBox:recalculate()
  return true
end

function B.text_redraw()
  local st = B.state.text
  if not (st and st.chars) then return end
  local ok = soft_set("forge_text_holder", box_def(st, st.box_w))
  if ok then soft_set("forge_preview_holder", preview_def(st, st.pv_w)) else refresh() end
end

local function holder(id, def)
  local box = UIBox{definition = def, config = {offset = {x = 0, y = 0}}}
  return {n = G.UIT.O, config = {object = box, id = id}}
end

local function text_body()
  local st = B.state.text
  if not st.chars then
    st.chars = DE.to_chars(st.lines or {})
    st.cur = #st.chars
  end
  st.rgb = st.rgb or {r = 255, g = 140, b = 0}
  st.rgb_col = st.rgb_col or {1, 0.55, 0, 1}
  B.text_rgb()
  local port = UIK.portrait()
  local W = UIK.W - 0.6
  local pw = port and W or (touch() and 3.9 or 3.7)
  local ew = port and W or math.min(W - pw - 0.3, touch() and 9.0 or 8.4)
  st.box_w, st.pv_w = ew, pw
  local ed = {}
  for _, r in ipairs(swatches(ew)) do ed[#ed + 1] = r end
  ed[#ed + 1] = UIK.spacer(0.06)
  ed[#ed + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = {holder("forge_text_holder", box_def(st, ew))}}
  local hint = mod_loc("Type with your keyboard. Return starts a new line.")
  ed[#ed + 1] = {n = G.UIT.R, config = {align = "cm", minw = ew, padding = 0.04}, nodes = {UIK.text(hint, {scale = fit(hint, ew, touch() and 0.34 or 0.3), colour = UIK.C.text})}}
  local pv = {{n = G.UIT.R, config = {align = "cm", padding = 0.06}, nodes = {UIK.text(mod_loc("On the card"), {scale = touch() and 0.4 or 0.36, colour = UIK.C.title})}}}
  pv[#pv + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = {holder("forge_preview_holder", preview_def(st, pw))}}
  local function col(nodes, w2) return {n = G.UIT.C, config = {align = "tm", minw = w2, padding = 0.03}, nodes = nodes} end
  local body
  if port then
    local all = {}
    for _, n in ipairs(ed) do all[#all + 1] = n end
    all[#all + 1] = UIK.spacer(0.15)
    for _, n in ipairs(pv) do all[#all + 1] = n end
    body = {col(all, W)}
  else
    body = {col(pv, pw), {n = G.UIT.C, config = {minw = 0.3}, nodes = {}}, col(ed, ew)}
  end
  if not st.started then
    st.started = true
    G.E_MANAGER:add_event(Event({blockable = false, blocking = false, func = function() B.text_focus(true) return true end}))
  end
  return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, padding = 0}, nodes = {{n = G.UIT.C, config = {align = "tm", padding = 0}, nodes = {
    title(mod_loc("CARD TEXT"), W),
    {n = G.UIT.R, config = {align = "tm", padding = 0}, nodes = body},
  }}}}
end

B.TEXT_HOOK = B.TEXT_HOOK or {forge_text = true, config = {ref_table = {}}, states = {}, REMOVED = false}

function B.text_active()
  return B.state.text ~= nil and B.state.text.chars ~= nil and G.OVERLAY_MENU ~= nil
end

function B.text_focused()
  return G.CONTROLLER and G.CONTROLLER.text_input_hook == B.TEXT_HOOK and B.text_active() or false
end

function B.text_focus(on)
  local c = G.CONTROLLER
  if not c then return end
  if on and B.text_active() then
    if c.text_input_hook and c.text_input_hook ~= B.TEXT_HOOK then c.text_input_hook = nil end
    c.text_input_hook = B.TEXT_HOOK
    if love.keyboard and love.keyboard.setTextInput then pcall(love.keyboard.setTextInput, true) end
  elseif c.text_input_hook == B.TEXT_HOOK then
    c.text_input_hook = nil
    if UIK.touch() and love.keyboard and love.keyboard.setTextInput then pcall(love.keyboard.setTextInput, false) end
  end
  if B.text_active() then B.text_redraw() end
end

function B.text_insert(t)
  local st = B.state.text
  if not (st and st.chars) then return end
  for _, ch in ipairs(DE.utf8(t)) do
    if ch == "\r" then ch = "\n" end
    if ch ~= "{" and ch ~= "}" and (ch == "\n" or ch:byte(1) >= 32) then
      local lines = 1
      for _, x in ipairs(st.chars) do
        if x.ch == "\n" then lines = lines + 1 end
      end
      local a = st.cur
      while a > 0 and st.chars[a].ch ~= "\n" do a = a - 1 end
      local b = st.cur + 1
      while st.chars[b] and st.chars[b].ch ~= "\n" do b = b + 1 end
      local len = b - a - 1
      local ok = (ch == "\n" and lines < B.TEXT_MAX_LINES) or (ch ~= "\n" and len < B.TEXT_MAX_LINE)
      if ok then
        table.insert(st.chars, st.cur + 1, {ch = ch, c = ch ~= "\n" and st.brush or nil})
        st.cur = st.cur + 1
      end
    end
  end
  B.text_redraw()
end

function B.text_key(key)
  local st = B.state.text
  if not (st and st.chars) then return end
  local n = #st.chars
  if key == "backspace" then
    if st.cur > 0 then table.remove(st.chars, st.cur); st.cur = st.cur - 1 end
  elseif key == "delete" then
    if st.cur < n then table.remove(st.chars, st.cur + 1) end
  elseif key == "return" then
    B.text_insert("\n")
    return
  elseif key == "left" then
    st.cur = math.max(0, st.cur - 1)
  elseif key == "right" then
    st.cur = math.min(n, st.cur + 1)
  elseif key == "home" or key == "end" or key == "up" or key == "down" then
    local a = st.cur
    while a > 0 and st.chars[a].ch ~= "\n" do a = a - 1 end
    local b = st.cur + 1
    while st.chars[b] and st.chars[b].ch ~= "\n" do b = b + 1 end
    local col = st.cur - a
    if key == "home" then st.cur = a
    elseif key == "end" then st.cur = b - 1
    elseif key == "up" then
      if a > 0 then
        local pa = a - 1
        while pa > 0 and st.chars[pa].ch ~= "\n" do pa = pa - 1 end
        st.cur = math.min(pa + col, a - 1)
      end
    else
      if st.chars[b] then
        local nb = b + 1
        while st.chars[nb] and st.chars[nb].ch ~= "\n" do nb = nb + 1 end
        st.cur = math.min(b + col, nb - 1)
      end
    end
  else
    return
  end
  B.text_redraw()
end

do
  local Hooks = require("overhaul.hooks")
  Hooks.wrap("G.FUNCS", "text_input_key", function(orig) return function(args, ...)
    if G.CONTROLLER and G.CONTROLLER.text_input_hook == B.TEXT_HOOK then
      if B.text_active() then B.text_key(args and args.key) else G.CONTROLLER.text_input_hook = nil end
      return
    end
    return orig(args, ...)
  end end, {id = "forge.text.key"})
  Hooks.wrap("G.FUNCS", "text_input_char", function(orig) return function(t, ...)
    if G.CONTROLLER and G.CONTROLLER.text_input_hook == B.TEXT_HOOK then
      if B.text_active() then B.text_insert(t) else G.CONTROLLER.text_input_hook = nil end
      return
    end
    return orig(t, ...)
  end end, {id = "forge.text.char", allow_missing = true})
  Hooks.wrap("Controller", "update", function(orig) return function(self, ...)
    if self.text_input_hook == B.TEXT_HOOK and not B.text_active() then
r 17 775 %20%20%20%20%20%20 -
l 1088
      if UIK.touch() and love.keyboard and love.keyboard.setTextInput then pcall(love.keyboard.setTextInput, false) end
    end
    local r = Hooks.pack(orig(self, ...))
    local f = B.text_focused()
    if B.text_active() and f ~= B._text_was_focused then B.text_redraw() end
    B._text_was_focused = f
    return Hooks.unpack(r)
  end end, {id = "forge.text.unhook"})
end

function B.tab()
  if B.state.pick then return pick_body() end
  if B.state.art and draft() then return art_body() end
  if B.state.text then return text_body() end
  if draft() then return editor_body() end
  if B.state.start then return start_body() end
  return kinds_body()
end

function B.footer_w(keys)
  local base = touch() and 3.0 or 2.85
  if touch() and not UIK.portrait() then return base end
  local need = base
  for _, k in ipairs(keys) do need = math.max(need, UIK.text_w(mod_loc(k), touch() and 0.5 or 0.47) + 0.45) end
  return math.max(base, math.min(need, (UIK.W - 0.6) / (UIK.portrait() and 2 or #keys) - 0.3))
end

function B.footer()
  if B.state.pick then
    local list = {UIK.button{label = mod_loc("BACK A STEP"), button = "forge_b_pick_back", colour = UIK.C.accent}}
    if B.state.pick.flip then list[#list + 1] = UIK.button{label = mod_loc(B.state.pick.flipped and "FLIP TO IF" or "FLIP TO NOT"), button = "forge_b_pick_flip", colour = G.C.BLUE} end
    if B.state.pick.remove then list[#list + 1] = UIK.button{label = mod_loc("REMOVE IT"), button = "forge_b_pick_remove", colour = UIK.C.danger} end
    return list
  end
  if B.state.art and draft() then return {UIK.button{label = mod_loc("BACK A STEP"), button = "forge_b_art_back", colour = UIK.C.accent}} end
  if B.state.text then
    return {
      UIK.button{label = mod_loc("USE IT"), button = "forge_b_text_done", colour = UIK.C.ok},
      UIK.button{label = mod_loc("WRITE IT AGAIN"), button = "forge_b_text_auto", colour = UIK.C.accent},
      UIK.button{label = mod_loc("BACK A STEP"), button = "forge_b_text_back", colour = UIK.C.accent},
    }
  end
  local d = draft()
  if not d then return {} end
  local bad = #D.problems(d) > 0
  local fw = B.footer_w({"SAVE", "TRY IT IN A RUN", "CARD TEXT", "START OVER"})
  local fs = touch() and 0.5 or 0.47
  local function fb(label, func, colour, off)
    local lab, ls = wrap_label(mod_loc(label), fw, fs)
    return UIK.button{label = lab, scale = ls, button = func, colour = colour, disabled = off, w = fw, id = (func:gsub("^forge_b_", "forge_"))}
  end
  return {
    fb("SAVE", "forge_b_save", UIK.C.ok, bad),
    fb("TRY IT IN A RUN", "forge_b_try", UIK.C.money, bad or not (d.kind == "joker" or (rawget(_G, "ForgeKinds") and ForgeKinds.can_try(d.kind)))),
    fb("CARD TEXT", "forge_b_text", UIK.C.purple),
    fb("START OVER", "forge_b_restart", UIK.C.accent),
  }
end

local function fs_write(path, data)
  local ok, F = pcall(require, "functions/fast_fs")
  if ok and F and F.write then return F.write(path, data) end
  return love.filesystem.write(path, data)
end

local function keep_faces(d, id)
  if type(d.faces) ~= "table" then return nil end
  local out = {}
  for r, file in pairs(d.faces) do
    if file == B.face_draft(r) and love.filesystem.getInfo(file) then
      local raw = love.filesystem.read(file)
      local to = Store.art_path(id .. "_" .. r)
      if raw and fs_write(to, raw) then out[r] = to end
    else
      out[r] = file
    end
  end
  return out
end

local function keep_art(d, id)
  local art = d.art
  if art and art.file == B.DRAFT_ART and love.filesystem.getInfo(B.DRAFT_ART) then
    local raw = love.filesystem.read(B.DRAFT_ART)
    local to = Store.art_path(id)
    if raw and fs_write(to, raw) then art = {file = to} end
  end
  return art
end

function B.save()
  local d = draft()
  if not d or #D.problems(d) > 0 then return nil end
  local id = d.id or Store.new_id()
  Store.ensure_dirs()
  local art = keep_art(d, id)
  local c
  if d.kind == "joker" then
    c = Store.put({id = id, name = d.name, rarity = d.rarity, own_rarity = d.own_rarity, cost = d.cost, enabled = d.enabled, art = art, rules = R.clean_rules(d.rules), vars = R.clean_vars(d.vars), text = d.text, created = d.created, mode = d.mode, compat = d.compat, requires = d.requires, always_ed = d.always_ed, look = d.look})
    if c then FJ.register_all() end
  else
    local rules = {}
    for _, r in ipairs(d.rules or {}) do if #(r.give or {}) > 0 then rules[#rules + 1] = r end end
    c = Store.put_item({id = id, kind = d.kind, name = d.name, mode = d.mode, enabled = d.enabled, created = d.created, fields = d.fields, effects = d.effects, text = d.text, art = art, from = d.from, faces = keep_faces(d, id), rules = rules, vars = d.vars, unset = d.unset, look = d.look})
    local K = rawget(_G, "ForgeKinds")
    if c and K and K.refresh then pcall(K.refresh, c.id) end
  end
  if not c then return nil end
  d.id = c.id
  d.art = c.art
  B.dirty = false
  return c
end

local function when_options()
  local out = {}
  for _, w in ipairs(R.whens(draft() and draft().kind or "joker")) do
    if advanced() or Cat.JOKER.when_simple[w] then out[#out + 1] = {label = plain(T.when_text(w, lang(), draft() and draft().kind)), value = w, colour = G.C.ORANGE} end
  end
  return out
end

local function only_options(r)
  local out = {}
  for _, id in ipairs(R.ONLY) do
    if R.allowed_only(r.when, id, host()) and (advanced() or Cat.JOKER.only_simple[id] or R.SIMPLE_ONLY[id]) and (id ~= "var" or count_vars(false) > 0) then out[#out + 1] = {label = mod_loc(ONLY_LABEL[id] or id), value = id, colour = G.C.BLUE} end
  end
  return out
end

local function give_options(r, alt)
  local out = {}
  for _, id in ipairs(R.GIVE) do
    if R.allowed_give(r.when, id, host()) and (advanced() or Cat.JOKER.give_simple[id] or R.SIMPLE_GIVE[id]) and not (alt and id == "change") and (not R.VAR_GIVE[id] or count_vars(id == "var_pick") > 0) and not (id == "var_pick" and count_vars(false) > 0) then out[#out + 1] = {label = mod_loc(GIVE_LABEL[id] or id), value = id, colour = G.C.RED} end
  end
  local HR = package.loaded["functions/forge/forge_hostrules"]
  if host_rules() and HR then
    for _, e in ipairs(HR.extra_values(draft().kind)) do
      if not (e.whens and not member_of(e.whens, r.when)) then out[#out + 1] = {label = mod_loc(e.label), value = "run:" .. e.id, colour = UIK.C.purple} end
    end
  end
  return out
end

local RANK_LABEL = {face = "Face card", number = "Number card", even = "Even rank", odd = "Odd rank"}

local function only_values(o)
  if R.VALUES_ONLY and R.VALUES_ONLY[o.id] then return R.VALUES_ONLY[o.id]() end
  local out = {}
  local function add(v, label) out[#out + 1] = {label = label, value = v} end
  if o.id == "hand" then
    for _, h in ipairs(R.HANDS) do add(h, T.hand_name(h)) end
    for _, h in ipairs(R.own_values("hand")) do add(h, R.own_label("hand", h)) end
  end
  if o.id == "suit" then
    for _, s in ipairs(R.SUITS) do add(s, s == "red" and mod_loc("Red") or s == "black" and mod_loc("Black") or T.suit_name(s, true)) end
    for _, s in ipairs(R.own_values("suit")) do add(s, R.own_label("suit", s)) end
  end
  if o.id == "rank" then for _, v in ipairs(R.RANKS) do add(v, RANK_LABEL[v] and mod_loc(RANK_LABEL[v]) or T.rank_name(v, lang())) end end
  if o.id == "enhancement" then for _, v in ipairs(R.enhancements()) do add(v, T.enh_name(v)) end end
  if o.id == "seal" then for _, v in ipairs(R.seals()) do add(v, T.seal_name(v)) end end
  if o.id == "edition" then for _, v in ipairs(R.editions()) do add(v, T.edition_name(v)) end end
  if o.id == "blind" then
    for _, v in ipairs(R.BLINDS) do add(v, T.blind_name(v)) end
    for _, v in ipairs(Cat.values("bossblind")) do add(v, Cat.value_label("bossblind", v)) end
  end
  if o.id == "played_rank" then for _, v in ipairs(R.RANKS) do add(v, RANK_LABEL[v] and mod_loc(RANK_LABEL[v]) or T.rank_name(v, lang())) end end
  if o.id == "played_suit" or o.id == "held_all" then
    for _, s in ipairs(R.SUITS) do add(s, s == "red" and mod_loc("Red") or s == "black" and mod_loc("Black") or T.suit_name(s, true)) end
    for _, s in ipairs(R.own_values("suit")) do add(s, R.own_label("suit", s)) end
  end
  if o.id == "suit_and_other" then for _, s in ipairs(R.suits()) do add(s, T.suit_name(s, true)) end end
  if o.id == "used_kind" then
    for _, v in ipairs(R.USE_KINDS) do add(v, Cat.value_label("set", v)) end
    for _, v in ipairs(R.own_values("ctype")) do add(v, R.own_label("ctype", v)) end
  end
  if R.FILTER_ONLY[o.id] and not o.op_next then
    for _, v in ipairs(R.filter_values(o.id)) do if R.FILTER_LABEL and R.FILTER_LABEL(o.id, v) then add(v, R.FILTER_LABEL(o.id, v)) elseif R.ed_match(v) then add(v, R.ed_name(R.ed_match(v))) else add(v, v == "any" and mod_loc("Any card") or v == "enhanced" and mod_loc("Enhanced card") or RANK_LABEL[v] and mod_loc(RANK_LABEL[v]) or tonumber(v) and T.rank_name(v, lang()) or (R.member(R.FOUR_SUITS, v) or R.own_id("suit", v)) and T.suit_name(v, true) or (v == "red" or v == "black") and mod_loc(v == "red" and "Red" or "Black") or T.enh_name(v)) end end
    return out
  end
  if o.id == "every" then
    if count_vars(false) == 0 then return out end
    add("event", mod_loc("Each time it triggers"))
    for i, v in ipairs(dvars()) do if not typed(v) then add("watch:" .. i, string.format(mod_loc("Variable: %s"), v.name)) end end
    return out
  end
  if R.VAR_FOR_ONLY[o.id] then
    for i, v in ipairs(dvars()) do if v.type == R.VAR_FOR_ONLY[o.id] then add("var:" .. i, string.format(mod_loc("Variable: %s"), v.name)) end end
  end
  if OP_SPEC[o.id] then for _, v in ipairs(R.OPS) do add(v, mod_loc(({at_least = "At least", at_most = "At most", exactly = "Exactly"})[v])) end end
  return out
end

local function give_values(g)
  if R.VALUES_GIVE and R.VALUES_GIVE[g.id] then return R.VALUES_GIVE[g.id]() end
  local out = {}
  local rs = run_give_spec(g)
  if rs then
    if rs.v then for _, v in ipairs(Cat.values(rs.v)) do out[#out + 1] = {label = Cat.value_label(rs.v, v), value = v} end end
    return out
  end
  if g.id == "create" then
    for _, v in ipairs(R.KINDS) do out[#out + 1] = {label = Cat.value_label("set", v), value = v} end
    for _, v in ipairs(R.own_values("ctype")) do out[#out + 1] = {label = R.own_label("ctype", v), value = v} end
  end
  if g.id == "add_card" then for _, v in ipairs(R.add_cards()) do out[#out + 1] = {label = v == "c_base" and mod_loc("Random card") or T.enh_name(v), value = v} end end
  if g.id == "tag" then out[#out + 1] = {label = mod_loc("Random Tag"), value = R.TAG_RANDOM} end
  if g.id == "create_rarity" then
    for _, v in ipairs(R.RARITIES) do out[#out + 1] = {label = mod_loc(v), value = v} end
    for _, v in ipairs(R.own_values("rarity")) do out[#out + 1] = {label = R.own_label("rarity", v), value = v} end
  end
  if g.id == "add_to_hand" then
    out[#out + 1] = {label = mod_loc("Random seal"), value = "random"}
    for _, v in ipairs(R.seals()) do out[#out + 1] = {label = T.seal_name(v), value = v} end
  end
  if g.id == "make_ed_joker" or g.id == "ed_joker" then for _, v in ipairs(R.ed_values()) do out[#out + 1] = {label = R.ed_name(v), value = v} end end
  if g.id == "tag" then for _, v in ipairs(R.tags()) do if G.P_TAGS and G.P_TAGS[v] then out[#out + 1] = {label = T.tag_name(v), value = v} end end end
  if g.id == "var_pick" then
    local v = dvars()[g.var or 1]
    if typed(v) then
      out[#out + 1] = {label = mod_loc("Random"), value = "random"}
      for _, x in ipairs(R.var_values(v.type)) do out[#out + 1] = {label = R.var_show(v.type, x, lang()), value = x} end
    end
    return out
  end
  if g.id == "change" then
    for i, v in ipairs(dvars()) do
      for _, what in ipairs(R.CHANGES) do
        if v.type == what then out[#out + 1] = {label = string.format(mod_loc("Variable: %s"), v.name), value = {what = what, v = "var:" .. i}} end
      end
    end
    for _, what in ipairs(R.CHANGES) do
      for _, v in ipairs(R.change_values(what)) do
        local label = what == "suit" and T.suit_name(v, true) or what == "rank" and T.rank_name(v, lang()) or what == "seal" and T.seal_name(v) or what == "edition" and T.edition_name(v) or T.enh_name(v)
        out[#out + 1] = {label = label, value = {what = what, v = v}}
      end
    end
  end
  return out
end

local function ask_var(x, after)
  local want = x.id == "var_pick"
  local opts = {}
  for i, v in ipairs(dvars()) do if (typed(v) and true or false) == want then opts[#opts + 1] = {label = v.name, value = i} end end
  if #opts == 0 then x.var = 1 return after() end
  if #opts == 1 then x.var = opts[1].value return after() end
  B.pick{title = mod_loc("WHICH VARIABLE?"), options = opts, colour = UIK.C.accent, choose = function(i)
    x.var = i
    B.state.pick = nil
    after()
  end}
end

local function ask_only_value(o)
  if o.id == "var" and not o.var_asked then
    o.var_asked = true
    return ask_var(o, function() ask_only_value(o) end)
  end
  o.var_asked = nil
  local opts = only_values(o)
  if #opts == 0 then refresh() return end
  local filter = R.FILTER_ONLY[o.id] and not o.op_next
  B.pick{title = filter and mod_loc(o.id == "jokers_with" and "WHICH EDITION?" or "WHICH CARDS?") or mod_loc(ONLY_LABEL[o.id] or o.id), options = opts, colour = G.C.BLUE, choose = function(v)
    B.state.pick = nil
    if filter then
      o.v = v
      o.op_next = true
      return ask_only_value(o)
    end
    o.op_next = nil
    if o.id == "every" then
      local w = tonumber(tostring(v):match("^watch:(%d)$"))
      o.v, o.var = w and "var" or "event", w
    elseif OP_SPEC[o.id] then o.op = v else o.v = v end
    refresh()
  end}
end

local function ask_give_value(g)
  if g.id == "var_set" and not g.var_asked and count_vars(true) > 0 then
    g.var_asked = true
    local opts = {}
    for i, v in ipairs(dvars()) do opts[#opts + 1] = {label = v.name, value = i} end
    return B.pick{title = mod_loc("WHICH VARIABLE?"), options = opts, colour = UIK.C.accent, choose = function(i)
      B.state.pick = nil
      if typed(dvars()[i]) then
        for k in pairs(g) do g[k] = nil end
        for k, x in pairs(B.default_give("var_pick")) do g[k] = x end
      end
      g.var, g.var_asked = i, true
      ask_give_value(g)
    end}
  end
  if R.VAR_GIVE[g.id] and not g.var_asked then
    g.var_asked = true
    return ask_var(g, function() ask_give_value(g) end)
  end
  g.var_asked = nil
  if R.ASK_GIVE and R.ASK_GIVE[g.id] then return R.ASK_GIVE[g.id](g) end
  if g.id == "make_card" then return B.ask_card(mod_loc(GIVE_LABEL.make_card), function(v) g.v = v end) end
  if R.PER_GIVE[g.id] then
    local when = rule().when
    local opts = {}
    if g.m_next then
      for _, v in ipairs(R.count_matches(g.per)) do opts[#opts + 1] = {label = R.ed_match(v) and R.ed_name(R.ed_match(v)) or plain(R.one_label(v, lang())), value = v} end
    else
      for _, v in ipairs(R.COUNTS) do if R.count_ok(when, v) then opts[#opts + 1] = {label = mod_loc(R.LABEL_COUNT[v] or v), value = v} end end
    end
    B.pick{title = g.m_next and mod_loc(g.per == "jokers_match" and "WHICH EDITION?" or "WHICH CARDS?") or mod_loc("FOR EACH WHAT?"), options = opts, colour = G.C.RED, choose = function(v)
      B.state.pick = nil
      if g.m_next then
        g.m, g.m_next = v, nil
      else
        g.per = v
        if R.COUNT_MATCH[v] then
          g.m_next = true
          return ask_give_value(g)
        end
        g.m = nil
      end
      refresh()
    end}
    return
  end
  local opts = give_values(g)
  if #opts == 0 then refresh() return end
  local rs = B.run_give_spec(g)
  B.pick{title = rs and mod_loc(rs.label) or mod_loc(GIVE_LABEL[g.id] or g.id), options = opts, colour = G.C.RED, choose = function(v)
    if g.id == "change" then g.what, g.v = v.what, v.v else g.v = v end
    B.state.pick = nil
    refresh()
  end}
end

local function effect_options(d)
  local out = {}
  for _, e in ipairs(Cat.effects_for(d.kind)) do
    if advanced() or e.simple then out[#out + 1] = {label = mod_loc(e.label), value = e.id, colour = G.C.RED} end
  end
  return out
end

function B.ask_look(e)
  local opts = {}
  for _, x in ipairs(LK.looks(e.v)) do opts[#opts + 1] = {label = LK.look_label(x.lk, x.v), value = x.lk .. ":" .. x.v, colour = x.own and G.C.GREEN or nil} end
  B.pick{title = mod_loc(LK.ASK_LOOK), options = opts, choose = function(v)
    local lk, look = tostring(v):match("^(%a+):(.+)$")
    if lk then e.lk, e.look = lk, look end
    B.state.pick = nil
    B.dirty = true
    refresh()
  end}
end

function B.ask_look_target(e)
  local opts = {}
  for _, t in ipairs(LK.TARGETS) do opts[#opts + 1] = {label = LK.target_label(t), value = t} end
  B.pick{title = mod_loc(LK.ASK_TARGET), options = opts, choose = function(t)
    e.v = t
    if not LK.look_ok(t, e.lk, e.look) then e.lk, e.look = LK.default_look(t) end
    B.dirty = true
    B.ask_look(e)
  end}
end

local function ask_effect_value(d, e)
  local spec = Cat.effect(d.kind, e.id)
  if not (spec and spec.v) then refresh() return end
  if spec.look then return B.ask_look_target(e) end
  if spec.v == "card" then return B.ask_card(mod_loc(spec.label), function(v) e.v = v end) end
  if spec.v == "joker" then return B.ask_card(mod_loc(spec.label), function(v) e.v = v end, nil, {"Joker"}) end
  if spec.v == "consumable" then return B.ask_card(mod_loc(spec.label), function(v) e.v = v end, nil, {"Tarot", "Planet", "Spectral"}) end
  local opts = {}
  local me = spec.v == "chdeck" and d.id and (R.OWN_PREFIX.challenge .. tostring(d.id))
  for _, v in ipairs(Cat.values(spec.v, spec.base)) do
    if v ~= me then opts[#opts + 1] = {label = Cat.value_label(spec.v, v), value = v} end
  end
  B.pick{title = mod_loc(spec.label), options = opts, choose = function(v)
    e.v = v
    B.state.pick = nil
    B.dirty = true
    refresh()
  end}
end

local function ref(e) return e and e.config and e.config.ref_table or {} end

ONLY_LABEL.every = "Every N times"

local function fx_of(e)
  local d = draft()
  local eff = d and d.effects and d.effects[ref(e).slot or 0]
  return d, eff
end

local function run_only_options(when)
  local out = {}
  for _, id in ipairs(Cat.RUN_ONLY) do
    if Cat.only_allowed(when, id) then out[#out + 1] = {label = mod_loc(ONLY_LABEL[id] or id), value = id, colour = G.C.BLUE} end
  end
  return out
end

local function ask_run_only(list, j, when)
  local cur = list[j]
  B.pick{title = mod_loc("ONLY IF"), options = run_only_options(when), remove = cur and function() table.remove(list, j) end or nil, choose = function(id)
    local o = Cat.default_only(id)
    list[j] = o
    B.state.pick = nil
    B.dirty = true
    ask_only_value(o)
  end}
end

G.FUNCS.forge_b_fx_when = function(e)
  local d, eff = fx_of(e)
  if not eff then return end
  local opts = {}
  for _, w in ipairs(Cat.whens_for(d.kind, eff.id) or {}) do opts[#opts + 1] = {label = plain(Cat.when_label(d.kind, w)), value = w, colour = G.C.ORANGE} end
  B.pick{title = mod_loc("WHEN DOES IT HAPPEN?"), options = opts, choose = function(w)
    eff.when = w ~= "now" and w or nil
    local only = Cat.clean_only(w, eff.only)
    eff.only = #only > 0 and only or nil
    B.state.pick = nil
    B.dirty = true
    refresh()
  end}
end

G.FUNCS.forge_b_pick_look = function(e)
  local _, eff = fx_of(e)
  if eff then B.ask_look(eff) end
end

G.FUNCS.forge_b_add_only = function(e)
  local d, eff = fx_of(e)
  if not eff then return end
  eff.only = eff.only or {}
  ask_run_only(eff.only, #eff.only + 1, eff.when or Cat.default_when(d.kind, eff.id) or "now")
end

G.FUNCS.forge_b_pick_only_fx = function(e)
  local d, eff = fx_of(e)
  if not (eff and eff.only) then return end
  ask_run_only(eff.only, ref(e).j or 1, eff.when or Cat.default_when(d.kind, eff.id) or "now")
end

G.FUNCS.forge_b_pick_joker = function(e)
  local d = draft()
  local t = e and e.config and e.config.ref_table or {}
  if not (d and t.field) then return end
  if d.kind == "fusion" then
    local Fu = require("functions/forge/forge_fusion")
    local on = d.fields.on == "Consumables" and "Consumables" or "Jokers"
    if t.field == "out" then
      B.ask_card(t.label or mod_loc("Joker"), function(v) d.fields[t.field] = v; D.choose(d, t.field) end, nil, on == "Consumables" and {"Tarot", "Planet", "Spectral"} or {"Joker"})
    else
      local opts = Fu.ingredient_options(on)
      if t.field == "c" then table.insert(opts, 1, {label = mod_loc("Nothing"), value = "j_none", colour = UIK.C.inactive}) end
      B.pick{title = t.label or mod_loc("Joker"), options = opts, choose = function(v)
        d.fields[t.field] = v
        D.choose(d, t.field)
        B.state.pick = nil
        B.dirty = true
        refresh()
      end}
    end
    refresh()
    return
  end
  B.ask_card(t.label or mod_loc("Joker"), function(v) d.fields[t.field] = v; D.choose(d, t.field) end, nil, {"Joker"})
  refresh()
end

G.FUNCS.forge_b_requires = function()
  local d = draft()
  if not (d and (d.fields or d.kind == "joker")) then return end
  local own = d.kind == "voucher" and d.id and ("v_forge_" .. tostring(d.id)) or nil
  local opts = {{label = mod_loc("Directly, no voucher needed"), value = "none", colour = UIK.C.ok}}
  for _, center in ipairs(G.P_CENTER_POOLS.Voucher or {}) do
    local blocked = center.key == own or center.key == "v_forge_draft" or (center.forge_kind and not center.forge_on)
    if center.requires and own then for _, r in ipairs(center.requires) do if r == own then blocked = true end end end
    if not blocked then opts[#opts + 1] = {label = Cat.value_label("voucher", center.key), value = center.key} end
  end
  local Gates = require("functions/forge/forge_gates")
  local function set(v)
    if d.kind == "joker" then d.requires = v ~= "none" and v or nil else d.fields.requires = v end
    B.state.pick = nil
    B.dirty = true
    refresh()
  end
  if d.kind ~= "voucher" then
    for i, gk in ipairs(Gates.ORDER) do table.insert(opts, 1 + i, {label = mod_loc(Gates.ASK[gk]) .. "...", value = "?" .. gk, colour = G.C.PURPLE}) end
  end
  B.pick{title = mod_loc("WHEN DOES IT SHOW UP?"), options = opts, choose = function(v)
    local gk = type(v) == "string" and v:match("^%?(%a+)$")
    if gk == "played" then
      local hopts = {}
      for _, h in ipairs(Cat.field_values({options = Cat.HANDS, own = "hand"})) do hopts[#hopts + 1] = {label = Cat.value_label("hand", h), value = h, colour = R.own_id("hand", h) and G.C.GREEN or nil} end
      B.pick{title = upper(mod_loc(Gates.ASK.played)), options = hopts, choose = function(h) set(Gates.make("played", h)) end}
    elseif gk then
      B.ask_card(upper(mod_loc(Gates.ASK[gk])), function(j) set(Gates.make(gk, j)) end, nil, {"Joker"})
    else
      set(v)
    end
  end}
end

G.FUNCS.forge_b_kinds = function()
  B.start_new()
  refresh()
end

G.FUNCS.forge_b_kind = function(e)
  local k = ref(e).kind
  if not Cat.BY_ID[k] then return end
  B.state.start = k
  B.state.start_q = ""
  B.state.page = 1
  refresh()
end

G.FUNCS.forge_b_page = function(e)
  B.state.page = (B.state.page or 1) + (ref(e).d or 0)
  if B.start_redraw and B.start_redraw() then return end
  refresh()
end

function B.blank(k)
  B.new_draft{kind = k}
  local d = D.blank(k)
  B.state.draft = d
  local src = D.blank_art(k)
  local raw = src and love.filesystem.getInfo(src) and love.filesystem.read(src)
  if raw then
    Store.ensure_dirs()
    if fs_write(B.DRAFT_ART, raw) then d.art = {file = B.DRAFT_ART} end
  end
  return d
end

G.FUNCS.forge_b_blank = function()
  B.blank(B.state.start or "joker")
  refresh()
end

G.FUNCS.forge_b_template = function(e)
  local k = B.state.start or "joker"
  local t = D.templates(k)[ref(e).i or 0]
  if not t then return end
  play_sound("card1", 1.1, 0.5)
  local d = D.from_template(k, t)
  d.mode = "advanced"
  B.state.draft = d
  B.state.warned = nil
  B.state.start, B.state.pick, B.state.text, B.state.rule_i, B.state.sec, B.state.art = nil, nil, nil, 1, "rules", nil
  B.dirty = true
  refresh()
end

G.FUNCS.forge_b_mode = function(e)
  local d = draft()
  local m = ref(e).mode
  if not d or (m ~= "simple" and m ~= "advanced") then return end
  if d.kind == "joker" then
    B.state.jview = m
    B.state.typing = nil
    Store.set_setting("joker_view", m)
    return refresh()
  end
  d.mode = m
  Store.set_setting("builder_mode2", m)
  if m == "simple" and d.kind == "joker" then B.state.rule_i = 1 end
  refresh()
end

G.FUNCS.forge_b_sec = function(e)
  local s2 = ref(e).sec
  if s2 ~= "rules" and s2 ~= "basics" and s2 ~= "vars" and s2 ~= "logic" and s2 ~= "looks" and s2 ~= "try" then return end
  B.state.sec = s2
  refresh()
end

G.FUNCS.forge_b_pick_when = function()
  local r = rule()
  B.pick{title = mod_loc("WHEN SHOULD IT WORK?"), list = "when", options = when_options(), choose = function(v)
    r.when = v
    local fixed = R.clean_rule(r)
    if fixed then r.only, r.give, r.alt = fixed.only, fixed.give, fixed.alt end
    B.state.pick = nil
    B.dirty = true
    refresh()
  end}
end

G.FUNCS.forge_b_pick_only = function(e)
  local r = rule()
  local slot = ref(e).slot or (#r.only + 1)
  local cur = r.only[slot]
  local flip = advanced() and cur and cur.id ~= "chance" and cur.id ~= "every" and function() cur.neg = not cur.neg or nil end or nil
  B.pick{title = mod_loc("ONLY IF"), list = "only", options = only_options(r), flip = flip, flipped = cur and cur.neg, remove = cur and function()
    table.remove(r.only, slot)
    if #r.only == 0 then r.alt = nil end
  end or nil, choose = function(v)
    local o = R.default_only(v)
    r.only[slot] = o
    B.state.pick = nil
    B.dirty = true
    ask_only_value(o)
  end}
end

G.FUNCS.forge_b_add_chance = function()
  local r = rule()
  r.only[#r.only + 1] = R.default_only("chance")
  B.dirty = true
  refresh()
end

G.FUNCS.forge_b_pick_give = function(e)
  local r = rule()
  local slot = ref(e).slot or (#r.give + 1)
  local list = give_options(r)
  B.pick{title = mod_loc("WHAT DOES IT GIVE?"), list = "give", options = list, remove = r.give[slot] and #r.give > 1 and function() table.remove(r.give, slot) end or nil, choose = function(v)
    local g = B.default_give(v)
    r.give[slot] = g
    B.state.pick = nil
    B.dirty = true
    ask_give_value(g)
  end}
end

G.FUNCS.forge_b_pick_alt = function(e)
  local r = rule()
  r.alt = r.alt or {}
  local slot = ref(e).slot or (#r.alt + 1)
  B.pick{title = mod_loc("OTHERWISE, WHAT DOES IT GIVE?"), list = "give", options = give_options(r, true), remove = r.alt[slot] and function()
    table.remove(r.alt, slot)
    if #r.alt == 0 then r.alt = nil end
  end or nil, choose = function(v)
    local g = B.default_give(v)
    r.alt[slot] = g
    B.state.pick = nil
    B.dirty = true
    ask_give_value(g)
  end}
end

G.FUNCS.forge_b_pick_flip = function()
  local p = B.state.pick
  if p and p.flip then p.flip() end
  B.state.pick = nil
  B.dirty = true
  refresh()
end

G.FUNCS.forge_b_pick_effect = function(e)
  local d = draft()
  if not d then return end
  d.effects = d.effects or {}
  local slot = ref(e).slot or (#d.effects + 1)
  if d.kind == "booster" and not d.effects[slot] then
    return B.ask_card(mod_loc("Card in the pack"), function(v)
      local eff = Cat.default_effect(d.kind, "pack_card")
      eff.v = v
      d.effects[slot] = eff
      B.state.fx_focus = slot
    end)
  end
  B.pick{title = mod_loc("WHAT DOES IT DO?"), options = effect_options(d), remove = d.effects[slot] and function() table.remove(d.effects, slot) end or nil, choose = function(v)
    local eff = Cat.default_effect(d.kind, v)
    d.effects[slot] = eff
    B.state.fx_focus = slot
    B.state.pick = nil
    B.dirty = true
    ask_effect_value(d, eff)
  end}
end

G.FUNCS.forge_b_pack_card = function(e)
  local d = draft()
  local slot = ref(e).slot or 0
  local eff = d and d.effects and d.effects[slot]
  if not eff then return end
  B.ask_card(mod_loc("Card in the pack"), function(v) eff.v = v end, function() table.remove(d.effects, slot) end)
end

G.FUNCS.forge_b_pick_value = function(e)
  local d = draft()
  local eff = d and d.effects and d.effects[ref(e).slot or 0]
  if eff then ask_effect_value(d, eff) end
end

G.FUNCS.forge_b_choose = function(e)
  local p = B.state.pick
  local i = ref(e).i
  if not (p and i and p.options[i]) then return end
  if B.easy_more and B.easy_more(p, p.options[i].value) then return end
  play_sound("button", 1, 0.5)
  p.choose(p.options[i].value)
end

G.FUNCS.forge_b_pick_page = function(e)
  local p = B.state.pick
  if not p then return end
  p.page = (p.page or 1) + (ref(e).d or 0)
  if p.tools and B.pick_redraw then return B.pick_redraw() end
  refresh()
end

G.FUNCS.forge_b_pick_back = function()
  B.state.pick = nil
  refresh()
end

G.FUNCS.forge_b_pick_remove = function()
  local p = B.state.pick
  if p and p.remove then p.remove() end
  B.state.pick = nil
  B.dirty = true
  refresh()
end

G.FUNCS.forge_b_var_add = function()
  local d = draft()
  if not d then return end
  d.vars = d.vars or {}
  if #d.vars >= R.MAX_VARS then return end
  d.vars[#d.vars + 1] = {name = mod_loc("Count") .. (#d.vars > 0 and (" " .. (#d.vars + 1)) or ""), start = 0}
  B.dirty = true
  refresh()
end

G.FUNCS.forge_b_var_type = function(e)
  local d = draft()
  local i = ref(e).i
  local v = d and d.vars and i and d.vars[i]
  if not v then return end
  local opts = {}
  for _, t in ipairs(R.VAR_TYPES) do opts[#opts + 1] = {label = mod_loc(B.VAR_TYPE_LABEL[t]), value = t} end
  B.pick{title = mod_loc("WHAT DOES IT HOLD?"), options = opts, colour = UIK.C.accent, choose = function(t)
    B.state.pick = nil
    if (v.type or "number") ~= t then
      v.type = t ~= "number" and t or nil
      v.start = t == "number" and 0 or "random"
      if t ~= "number" then
        for _, r in ipairs(d.rules or {}) do
          for _, k in ipairs({"only", "give", "alt"}) do
            for _, x in ipairs(r[k] or {}) do if tonumber(x.nv) == i then x.nv = nil end end
          end
        end
      end
      B.dirty = true
    end
    refresh()
  end}
end

G.FUNCS.forge_b_var_start = function(e)
  local d = draft()
  local i = ref(e).i
  local v = d and d.vars and i and d.vars[i]
  if not (v and typed(v)) then return end
  local opts = {{label = mod_loc("Random"), value = "random"}}
  for _, x in ipairs(R.var_values(v.type)) do opts[#opts + 1] = {label = R.var_show(v.type, x, lang()), value = x} end
  B.pick{title = mod_loc("STARTS AS"), options = opts, colour = UIK.C.accent, choose = function(x)
    B.state.pick = nil
    v.start = x
    B.dirty = true
    refresh()
  end}
end

G.FUNCS.forge_b_var_del = function(e)
  local d = draft()
  local i = ref(e).i
  if not (d and d.vars and i and d.vars[i]) then return end
  table.remove(d.vars, i)
  local function fix(list)
    local out = {}
    for _, x in ipairs(list or {}) do
      if not ((R.VAR_GIVE[x.id] or x.id == "var") and (x.var or 1) == i) then
        if x.var and x.var > i then x.var = x.var - 1 end
        local nv = tonumber(x.nv)
        if nv == i then x.nv = nil elseif nv and nv > i then x.nv = nv - 1 end
        out[#out + 1] = x
      end
    end
    return out
  end
  for _, r in ipairs(d.rules or {}) do
    r.give = fix(r.give)
    r.only = fix(r.only)
    if r.alt then
      r.alt = fix(r.alt)
      if #r.alt == 0 or #r.only == 0 then r.alt = nil end
    end
  end
  B.dirty = true
  refresh()
end

G.FUNCS.forge_b_rule = function(e)
  local d = draft()
  if not d then return end
  B.state.rule_i = math.max(1, math.min(#d.rules, (B.state.rule_i or 1) + (ref(e).d or 0)))
  refresh()
end

function B.step_value(spec, cur, d)
  local v = (tonumber(cur) or spec.lo) + d
  v = math.max(spec.lo, math.min(spec.hi, v))
  if spec.step % 1 == 0 and spec.lo % 1 == 0 then return math.floor(v + 0.5) end
  return math.floor(v * 100 + 0.5) / 100
end

B.HOLD_START = 0.4

function B.hold_rate(held)
  if held > 3.2 then return 100, 0.05 end
  if held > 2 then return 10, 0.06 end
  if held > 1.2 then return 1, 0.05 end
  return 1, 0.12
end

G.FUNCS.forge_b_hold = function(e)
  local r2 = e and e.config and e.config.ref_table
  local C = G.CONTROLLER
  if not (r2 and r2.spec and C) then return end
  local down = C.is_cursor_down and C.cursor_down and C.cursor_down.target == e
  if not down then
    if r2.held then
      r2.held = nil
      r2.skip_click = true
      G.E_MANAGER:add_event(Event({blockable = false, blocking = false, func = function() if B.state.draft then refresh() end return true end}))
    end
    return
  end
  local now = G.TIMERS.UPTIME
  local held = now - (C.cursor_down.time or now)
  if held < B.HOLD_START or (r2.next or 0) > now then return end
  local mult, wait = B.hold_rate(held)
  r2.next = now + wait
  r2.held = true
  local v = B.step_value(r2.spec, r2.t[r2.k], (tonumber(r2.d) or 0) * mult)
  if v == r2.t[r2.k] then return end
  r2.t[r2.k] = v
  B.touched(r2.t, r2.k)
  B.dirty = true
  if r2.disp then r2.disp.s = r2.disp.fmt and r2.disp.fmt(v) or T.fmt_n(v) end
  play_sound("button", 1 + math.min(held, 3) * 0.05, 0.25)
end

G.FUNCS.forge_b_jump = function(e)
  local r2 = ref(e)
  local spec, t, k = r2.spec, r2.t, r2.k
  if not (spec and type(t) == "table" and k) then return end
  if r2.held or r2.skip_click then
    r2.held, r2.skip_click = nil, nil
    refresh()
    return
  end
  local v = B.step_value(spec, t[k], tonumber(r2.d) or 0)
  if v == t[k] then return end
  t[k] = v
  B.touched(t, k)
  play_sound("button", 1, 0.4)
  B.dirty = true
  refresh()
end

G.FUNCS.forge_b_type = function(e)
  local r2 = ref(e)
  if not (r2.spec and type(r2.t) == "table" and r2.k) then return end
  B.state.typing = {t = r2.t, k = r2.k, spec = r2.spec, text = T.fmt_n(r2.t[r2.k])}
  refresh()
  B.focus_type()
end

function B.focus_type()
  if G.F_MOBILE then return end
  G.E_MANAGER:add_event(Event({blockable = false, blocking = false, func = function()
    local inp = B.type_box and B.type_box.get_UIE_by_ID and B.type_box:get_UIE_by_ID("text_input")
    if inp and not G.CONTROLLER.text_input_hook then G.FUNCS.select_text_input(inp) end
    return true
  end}))
end

G.FUNCS.forge_b_type_ok = function() B.type_commit() end

G.FUNCS.forge_b_nv = function(e)
  local r2 = ref(e)
  local t = r2.t
  if type(t) ~= "table" then return end
  if t.nv ~= nil then t.nv = nil else t.nv = r2.list and r2.list[1] end
  if B.state.typing and B.state.typing.t == t then B.state.typing = nil; B.type_box = nil end
  play_sound("button", 1, 0.4)
  B.dirty = true
  refresh()
end

G.FUNCS.forge_b_nv_step = function(e)
  local r2 = ref(e)
  local t, list = r2.t, r2.list or {}
  if type(t) ~= "table" or #list == 0 then return end
  local at = 1
  for i, x in ipairs(list) do if x == t.nv then at = i end end
  t.nv = list[(at - 1 + (tonumber(r2.d) or 1)) % #list + 1]
  play_sound("button", 1, 0.4)
  B.dirty = true
  refresh()
end

G.FUNCS.forge_b_fx_page = function(e)
  B.state.fx_page = math.max(1, (B.state.fx_page or 1) + (ref(e).d or 0))
  refresh()
end

G.FUNCS.forge_b_part_page = function(e)
  B.state.part_page = math.max(1, (B.state.part_page or 1) + (ref(e).d or 0))
  refresh()
end

G.FUNCS.forge_b_rule_go = function(e)
  B.state.part_page = 1
  local d = draft()
  local i = ref(e).i
  if not d or type(i) ~= "number" or i < 1 or i > #d.rules then return end
  B.state.rule_i = i
  refresh()
end

local function deep(v)
  if type(v) ~= "table" then return v end
  local out = {}
  for k2, x in pairs(v) do out[k2] = deep(x) end
  return out
end

G.FUNCS.forge_b_copy_rule = function()
  B.state.part_page = 1
  local d = draft()
  if not d or #d.rules >= D.MAX_RULES then return end
  local cur = d.rules[B.state.rule_i or 1]
  if not cur then return end
  table.insert(d.rules, (B.state.rule_i or 1) + 1, deep(cur))
  B.state.rule_i = (B.state.rule_i or 1) + 1
  B.dirty = true
  refresh()
end

G.FUNCS.forge_b_add_rule = function()
  B.state.part_page = 1
  local d = draft()
  if not d or #d.rules >= D.MAX_RULES then return end
  d.rules[#d.rules + 1] = host_rules() and B.first_rule(d.kind) or {when = "hand_played", only = {}, give = {R.default_give("mult")}}
  B.state.rule_i = #d.rules
  B.dirty = true
  refresh()
end

G.FUNCS.forge_b_del_rule = function()
  B.state.part_page = 1
  local d = draft()
  if not d or #d.rules < 1 then return end
  table.remove(d.rules, B.state.rule_i)
  B.state.rule_i = math.max(1, B.state.rule_i - 1)
  B.dirty = true
  refresh()
end

G.FUNCS.forge_b_art_pick = function()
  local d = draft()
  if not (d and B.ART_SETS[d.kind]) then return end
  local list = B.art_list(d.kind)
  local a = d.art or {}
  local page = 1
  for i, it in ipairs(list) do
    if a.atlas == it.atlas and a.x == it.x and a.y == it.y then
      local pr, rows = B.art_grid()
      page = math.ceil(i / (pr * rows))
    end
  end
  B.state.art = {page = page}
  refresh()
end

G.FUNCS.forge_b_art_page = function(e)
  if not B.state.art then return end
  B.state.art.page = (B.state.art.page or 1) + (ref(e).d or 0)
  refresh()
end

G.FUNCS.forge_b_art_choose = function(e)
  local d = draft()
  if d and B.state.art and B.state.art.ink then
    local XT = require("functions/forge/forge_extras")
    return XT.ink_use(XT.ink_list()[ref(e).i or 0])
  end
  local it = d and B.art_list(d.kind)[ref(e).i or 0]
  if not it then return end
  d.art = {atlas = it.atlas, x = it.x, y = it.y}
  B.state.art = nil
  B.dirty = true
  play_sound("card1", 1.1, 0.5)
  refresh()
end

G.FUNCS.forge_b_art_back = function()
  B.state.art = nil
  refresh()
end

B.PX_KIND = {joker = "joker", tarot = "tarot", planet = "planet", spectral = "spectral", voucher = "voucher", booster = "booster", ctype = "booster", deck = "back", enhancement = "enhancement", seal = "seal", edition = "edition", tag = "tag", blind = "blind", stake = "stake", collab = "skin", suit = "suit"}
B.PX_FAMILY = {tarot = {"tarot", "planet", "spectral"}, planet = {"planet", "tarot", "spectral"}, spectral = {"spectral", "tarot", "planet"}}

G.FUNCS.forge_b_art = function()
  local d = draft()
  if not d then return end
  local P = require("functions/forge/forge_pixel")
  local PX = ForgePixelUI
  local ak = B.PX_KIND[d.kind] or "joker"
  local pk = PX.kind(ak)
  local w, h = pk.w or P.W, pk.h or P.H
  local a = d.art or D.sample_art(d.kind == "ctype" and "booster" or d.kind) or {}
  B.state.art_base = (pk.w and a.atlas) and {atlas = a.atlas, x = a.x or 0, y = a.y or 0} or nil
  if a.file ~= B.DRAFT_ART then
    local doc
    if a.file and love.filesystem.getInfo(a.file) then
      local ok, data = pcall(love.image.newImageData, a.file)
      if ok and data and data:getWidth() == w and data:getHeight() == h then doc = P.from_image_data(data) end
    elseif a.atlas and not a.anim then
      doc = PX.sprite_data(a.atlas, {x = a.x or 0, y = a.y or 0}, w, h)
    end
    if not doc and d.kind == "suit" then
      local ok, data = pcall(require("functions/forge/forge_suits").start_symbol, d)
      if ok and data then doc = P.from_image_data(data) end
    end
    Store.ensure_dirs()
    if doc then
      local data = love.image.newImageData(w, h)
      P.write_image_data(doc, data)
      fs_write(B.DRAFT_ART, data:encode("png"):getString())
      d.art = {file = B.DRAFT_ART, atlas = B.state.art_base and B.state.art_base.atlas, x = B.state.art_base and B.state.art_base.x, y = B.state.art_base and B.state.art_base.y}
    elseif love.filesystem.getInfo(B.DRAFT_ART) then
      love.filesystem.remove(B.DRAFT_ART)
    end
  end
  local look = nil
  if d.kind == "edition" then look = require("functions/forge/forge_shine").look_of(d.fields) or false end
  PX.open_for({kind = "draft", art_kind = ak, family = B.PX_FAMILY[d.kind], no_soul = d.kind == "ctype" or nil,
    edition = d.kind == "edition" and d.fields and d.fields.shader ~= "none" and d.fields.shader or nil, look = look})
end

G.FUNCS.forge_b_face = function(e)
  local d = draft()
  local r = e and e.config and e.config.ref_table and e.config.ref_table.face
  if not (d and r) then return end
  B.state.face = r
  local More = rawget(_G, "ForgeKinds") and ForgeKinds.more
  local ok, data = pcall(function() return More and More.face_image(d, r, More.collab_suit and More.collab_suit(d) or d.fields and d.fields.suit or "Hearts") end)
  if ok and data then
    Store.ensure_dirs()
    fs_write(B.DRAFT_ART, data:encode("png"):getString())
  end
  ForgePixelUI.open_for({kind = "draft"})
end

