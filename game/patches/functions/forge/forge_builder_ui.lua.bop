l 148
    local area = CardArea(0, 0, w, h, {card_limit = 1, type = "title", highlight_limit = 0, collection = true, card_w = w})
    area:emplace(card)
    return area
  end
  local c = G.P_CENTERS[key] or G.P_CENTERS[k.sample]
  local atlas = c and (c.atlas or (k.set == "Joker" and "Joker") or (k.set == "Enhanced" and "centers") or (k.set == "Back" and "centers") or k.set) or "Joker"
  return still(Sprite(0, 0, w, h, G.ASSET_ATLAS[atlas] or G.ASSET_ATLAS.Joker, c and c.pos or {x = 0, y = 0}))
end

local function obj(o) return {n = G.UIT.O, config = {object = o}} end

local function boxed(node)
  local box = UIBox{definition = {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR, padding = 0}, nodes = {node}}, config = {offset = {x = 0, y = 0}}}
  return {n = G.UIT.C, config = {align = "cm"}, nodes = {obj(box)}}
end

local function label_rows(label, w, base)
  local lines = {label}
  if UIK.text_w(label, base) > w - 0.2 and touch() then
    local words = {}
    for wd in tostring(label):gmatch("%S+") do words[#words + 1] = wd end
    if #words > 1 then
      local best, bi = math.huge, 1
      for i = 1, #words - 1 do
        local d = math.abs(UIK.text_w(table.concat(words, " ", 1, i), base) - UIK.text_w(table.concat(words, " ", i + 1), base))
        if d < best then best, bi = d, i end
      end
      lines = {table.concat(words, " ", 1, bi), table.concat(words, " ", bi + 1)}
    end
  end
  local sc = base
  for _, l in ipairs(lines) do sc = math.min(sc, fit(l, w, base)) end
  local rows = {}
  for _, l in ipairs(lines) do rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", maxw = w - 0.12}, nodes = {UIK.text(l, {scale = sc})}} end
  return rows
end

local function tile(label, func, ref, spr, w, id, ph)
  local nodes = {{n = G.UIT.R, config = {align = "cm", minh = G.CARD_H * (UIK.portrait() and (ph or 0.8) or touch() and 0.62 or 0.56), padding = 0.02}, nodes = {obj(spr)}}}
  for _, r in ipairs(label_rows(label, w, UIK.portrait() and 0.46 or touch() and 0.42 or 0.34)) do nodes[#nodes + 1] = r end
  return {n = G.UIT.C, config = {align = "cm", padding = 0.05}, nodes = {
    {n = G.UIT.C, config = {align = "cm", minw = w, padding = 0.07, r = 0.1, colour = UIK.C.accent, button = func, ref_table = ref, hover = true, shadow = true, id = id}, nodes = nodes},
  }}
end

local function art_atlas(d)
  local a = d.art or {}
  if a.file and love.filesystem.getInfo(a.file) then
    local ok, data = pcall(love.image.newImageData, a.file)
    if ok and data and data:getWidth() == 71 and data:getHeight() == 95 then
      FJ.atlas_from_data("forge_draft", data)
      return "forge_draft", {x = 0, y = 0}
    end
  end
  if a.atlas and G.ASSET_ATLAS[a.atlas] then return a.atlas, {x = a.x or 0, y = a.y or 0} end
  return nil
end

local function parsed_lines(lines)
  local out = {}
  for _, l in ipairs(lines) do out[#out + 1] = loc_parse_string(l) end
  return out
end

function B.set_desc(d)
  local lines = D.lines(d, lang())
  local Other = G.localization.descriptions.Other
  Other.forge_draft_desc = {name = d.name, text = lines, text_parsed = parsed_lines(lines), name_parsed = {loc_parse_string(d.name or "")}}
  return lines
end

function B.preview_center()
  local d = draft()
  if not d or d.kind ~= "joker" then return nil end
  local c = G.P_CENTERS[B.KEY]
  if not c then
    c = {key = B.KEY, order = FJ.ORDER, unlocked = true, discovered = true, alerted = true, set = "Joker", effect = "", cost_mult = 1, name = "Forge draft", rarity = 1, cost = 4,
      pos = {x = 0, y = 0}, atlas = "Joker", config = {extra = {chips = 0, mult = 0, xmult = 1}}, no_collection = true, forge_preview = true, blueprint_compat = true}
    G.P_CENTERS[B.KEY] = c
  end
  c.rarity, c.cost = d.rarity, d.cost
  local atlas, pos = art_atlas(d)
  c.atlas, c.pos = atlas or "Joker", pos or {x = 0, y = 0}
  FJ.set_loc(B.KEY, d.name, D.lines(d, lang()))
  return c
end

local function draft_center(d, k)
  local sample = G.P_CENTERS[d.from or ""] or G.P_CENTERS[k.sample] or {}
  local atlas, pos = art_atlas(d)
  local c = {key = D.DRAFT_KEY[d.kind] or "c_forge_draft", set = k.set, name = d.name, unlocked = true, discovered = true, alerted = true, order = 1, cost = d.fields and d.fields.cost or 3,
    atlas = atlas or sample.atlas or k.set, pos = pos or sample.pos or {x = 0, y = 0}, config = {}, forge_draft = true, effect = "", cost_mult = 1, consumeable = (k.set == "Tarot" or k.set == "Planet" or k.set == "Spectral") or nil}
  if d.kind == "planet" then c.config.hand_type = d.fields.hand ~= "all" and d.fields.hand or "Pair" end
  if d.kind == "booster" then c.config = {extra = 3, choose = 1}; c.kind = d.fields.pack end
  if d.kind == "enhancement" then c.atlas = atlas or sample.atlas or "centers" end
  return c
end

local function area_for(w, h, card)
  local area = CardArea(G.ROOM.T.x, G.ROOM.T.y, w, h, {card_limit = 1, type = "title", highlight_limit = 0, collection = true, card_w = w})
  area:emplace(card)
  return {n = G.UIT.R, config = {align = "cm", minw = w, minh = h, padding = 0}, nodes = {obj(area)}}
end

function B.card_node(scale)
  local d = draft()
  if not d then return nil end
  local k = Cat.kind(d.kind)
  local s = scale or 1
  local w, h = G.CARD_W * s, G.CARD_H * s
  B.preview_card = nil
  if d.kind == "joker" then
    local card = Card(G.ROOM.T.x, G.ROOM.T.y, w, h, nil, B.preview_center())
    card.forge_preview = true
    B.preview_card = card
    return area_for(w, h, card)
  end
  if k.shape == "tag" or k.shape == "blind" or k.shape == "stake" or k.shape == "back" then
    local spr = B.sprite(d.kind, d.from or k.sample, s)
    local atlas, pos = art_atlas(d)
    if atlas and k.shape == "back" then spr = still(Sprite(0, 0, w, h, G.ASSET_ATLAS[atlas], pos)) end
    return {n = G.UIT.R, config = {align = "cm", minw = w, minh = h, padding = 0}, nodes = {obj(spr)}}
  end
  local card
  if d.kind == "enhancement" then
    card = Card(G.ROOM.T.x, G.ROOM.T.y, w, h, G.P_CARDS.S_A, draft_center(d, k))
  elseif d.kind == "seal" then
    card = Card(G.ROOM.T.x, G.ROOM.T.y, w, h, G.P_CARDS.S_A, G.P_CENTERS.c_base)
    card:set_seal(G.P_SEALS and G.P_SEALS[d.from or ""] and d.from or "Red", true, true)
  elseif d.kind == "edition" then
    card = Card(G.ROOM.T.x, G.ROOM.T.y, w, h, nil, G.P_CENTERS.j_joker)
    card:set_edition({[d.fields.shader or "foil"] = true}, true, true)
  elseif d.kind == "collab" then
    local pre = ({Hearts = "H", Diamonds = "D", Spades = "S", Clubs = "C"})[d.fields.suit] or "H"
    local face = B.state.face or "K"
    card = Card(G.ROOM.T.x, G.ROOM.T.y, w, h, G.P_CARDS[pre .. "_" .. face], G.P_CENTERS.c_base)
    local file = d.faces and d.faces[face] or (face == "K" and d.art and d.art.file)
    if file and love.filesystem.getInfo(file) and card.children.front then
      local ok, data = pcall(love.image.newImageData, file)
      if ok and data and data:getWidth() == 71 and data:getHeight() == 95 and FJ.atlas_from_data("forge_draft_face", data) then
        card.children.front.atlas = G.ASSET_ATLAS.forge_draft_face
        card.children.front:set_sprite_pos({x = 0, y = 0})
      end
    end
  else
    card = Card(G.ROOM.T.x, G.ROOM.T.y, w, h, nil, draft_center(d, k))
  end
  card.forge_preview = true
r 9 1460 %20%20 -
