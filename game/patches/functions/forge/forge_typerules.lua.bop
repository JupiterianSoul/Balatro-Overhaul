      ["Its cards sell for {C:money}$%d{} more"] = "Sus cartas se venden por {C:money}$%d{} más", ["{C:dark_edition}Negative{} {C:attention}%d%%{} of the time"] = "{C:dark_edition}Negativa{} el {C:attention}%d%%{} de las veces",
