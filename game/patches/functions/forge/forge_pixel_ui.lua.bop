local P = require("functions/forge/forge_pixel")
local Store = require("functions/forge/forge_store")
local FJ = require("functions/forge/forge_joker")

local PX = {}
ForgePixelUI = PX

PX.SIMPLE = {"pencil", "eraser", "fill", "picker", "line", "box", "pan", "@flip", "@clear", "@import"}
PX.GROUPS = {
  {key = "draw", tools = {"pencil", "eraser", "fill", "picker", "dither", "gradient", "shade", "light"}},
  {key = "shape", tools = {"line", "box", "block", "oval", "disc", "pan"}},
  {key = "select", tools = {"select", "lasso", "wand", "move", "@copy", "@cut", "@paste", "@deselect"}},
  {key = "edit", tools = {"@flip", "@flip_v", "@rotate", "@outline", "@clear", "@import", "@layer", "@soul"}},
}
PX.TOOLS = {"pencil", "eraser", "fill", "line", "box", "picker", "move"}
PX.ZOOMS = {1, 1.5, 2, 3, 4, 6, 8}
PX.BRUSH_MAX = 5
PX.MINE_MAX = 24
PX.PREVIEW = "j_forge_preview"
PX.EDITIONS = {"base", "foil", "holo", "polychrome", "negative"}

PX.KINDS = {
  {key = "joker", label = "Joker", pool = "Joker", atlas = "Joker", soul = true},
  {key = "tarot", label = "Tarot", pool = "Tarot", atlas = "Tarot", soul = true},
  {key = "planet", label = "Planet", pool = "Planet", atlas = "Tarot"},
  {key = "spectral", label = "Spectral", pool = "Spectral", atlas = "Tarot", soul = true},
  {key = "voucher", label = "Voucher", pool = "Voucher", atlas = "Voucher"},
  {key = "booster", label = "Booster", pool = "Booster", atlas = "Booster"},
  {key = "back", label = "Deck back", pool = "Back", atlas = "centers"},
  {key = "enhancement", label = "Enhancement", pool = "Enhanced", atlas = "centers"},
  {key = "seal", label = "Seal", atlas = "centers", empty_blank = true},
  {key = "skin", label = "Card skin", atlas = "cards_1"},
  {key = "blind", label = "Blind chip", w = 34, h = 34, atlas = "blind_chips", game = 1.4},
  {key = "tag", label = "Tag", w = 34, h = 34, atlas = "tags", game = 0.8},
  {key = "stake", label = "Stake", w = 29, h = 29, atlas = "chips", game = 0.8},
}
PX.SEALS = {{key = "Gold", pos = {x = 2, y = 0}}, {key = "Red", pos = {x = 5, y = 4}}, {key = "Blue", pos = {x = 6, y = 4}}, {key = "Purple", pos = {x = 4, y = 4}}}

local function settings() return G and G.SETTINGS or {} end

PX.state = PX.state or {tool = "pencil", colour = P.hex("374244"), colour2 = P.hex("ffffff"), zoom_i = 1, pan = {x = 0, y = 0}, grid = false, mirror = false, guide = true,
  target = nil, picker_page = 1, kind = "joker", group = "draw", panel = "options", pal = "balatro", brush = 1, tol = 0, every = false, grad = "smooth", edition = 1,
  import_page = 1, snap = true, remove = false}

local function touch() return UIK.touch() end

function PX.kind(key)
  key = key or PX.state.kind
  for _, k in ipairs(PX.KINDS) do if k.key == key then return k end end
  return PX.KINDS[1]
end

local function kind_size(k)
  return k.w or P.W, k.h or P.H
end

local function is_card(k) return not k.w end

function PX.mode()
  local m = settings().forge_px_mode
  return m == "advanced" and "advanced" or "simple"
end

local function adv() return PX.mode() == "advanced" end

local LABELS = {
  pencil = "Pencil", eraser = "Eraser", fill = "Fill", picker = "Pick colour", line = "Line", box = "Box", pan = "Pan", move = "Move",
  dither = "Dither", gradient = "Gradient", shade = "Shade", light = "Light", block = "Block", oval = "Oval", disc = "Disc",
  select = "Select", lasso = "Lasso", wand = "Wand",
  ["@flip"] = "Flip", ["@flip_v"] = "Upside down", ["@rotate"] = "Rotate", ["@outline"] = "Outline", ["@clear"] = "Clear", ["@import"] = "Import",
  ["@copy"] = "Copy", ["@cut"] = "Cut", ["@paste"] = "Paste", ["@deselect"] = "Deselect", ["@layer"] = "+ Layer", ["@soul"] = "+ Soul",
}

local function tool_label(t) return mod_loc(LABELS[t] or t) end

local function rgba(c, a)
  local r, g, b, al = P.unpack(c)
  return {r / 255, g / 255, b / 255, a or al / 255}
end

local function fs_write(path, data)
  local ok, F = pcall(require, "functions/fast_fs")
  if ok and F and F.write then return F.write(path, data) end
  return love.filesystem.write(path, data)
end

local function ensure_dir(dir)
  if not love.filesystem.getInfo(dir) then love.filesystem.createDirectory(dir) end
end

function PX.target_path()
  local t = PX.state.target
  if t and t.kind == "creation" then return Store.art_path(t.id) end
  if t and t.kind == "draft" then return "forge/art/draft.png" end
  if PX.state.kind ~= "joker" then return "forge/art/scratch_" .. PX.state.kind .. ".png" end
  return "forge/art/scratch.png"
end

function PX.paths(base)
  base = base or PX.target_path()
  local stem = base:gsub("%.png$", "")
  return {x1 = base, x2 = stem .. "_2x.png", soul = stem .. "_soul.png", soul2x = stem .. "_soul_2x.png"}
end

function PX.atlas_name()
  local t = PX.state.target
  if t and t.kind == "creation" then return "forge_" .. t.id end
  return "forge_preview"
end

local function find_atlas(name)
  return (G.ASSET_ATLAS and G.ASSET_ATLAS[name]) or (G.ANIMATION_ATLAS and G.ANIMATION_ATLAS[name])
end

