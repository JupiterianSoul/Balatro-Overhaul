l 115
    if PX.canvas.stroke then PX.canvas:stop_drag() end
    return true
  end
  return PAD_DIRS[button] ~= nil
end

function PX.active()
  local w = UIK and UIK._win
  return w and w.id == "forge" and w._cur == "pixel" and G.OVERLAY_MENU and PX.canvas and not PX.canvas.REMOVED and true or false
end

local function kp_on()
  local KP = package.loaded["functions/extras/keyboard_play"]
  if type(KP) ~= "table" or not KP.enabled then return false end
  local ok, on = pcall(KP.enabled)
  return ok and on
end

PX.KEYS = {b = "pencil", g = "fill", i = "picker", l = "line", u = "box", o = "oval", m = "select", w = "wand", v = "move", h = "pan", d = "dither"}

function PX.key(key)
  if not PX.active() or not PX.doc then return false end
  local ctrl = G.CONTROLLER
  if ctrl and ctrl.text_input_hook then return false end
  local mod = love.keyboard.isDown("lctrl", "rctrl", "lgui", "rgui")
  local shift = love.keyboard.isDown("lshift", "rshift")
  if mod then
    if key == "z" and shift then G.FUNCS.forge_px_redo(); return true end
    if key == "z" then G.FUNCS.forge_px_undo(); return true end
    if key == "y" then G.FUNCS.forge_px_redo(); return true end
    if not adv() then return false end
    if key == "c" then ACTS.copy(); return true end
    if key == "x" then ACTS.cut(); return true end
    if key == "v" then ACTS.paste(); return true end
    if key == "a" then P.select_all(PX.doc); return true end
    return false
  end
  if key == "e" and not kp_on() then G.FUNCS.forge_px_tool({config = {ref_table = {tool = "eraser"}}}); return true end
  local t = PX.KEYS[key]
  if t then
    local simple_ok = false
    for _, s in ipairs(PX.SIMPLE) do if s == t then simple_ok = true end end
    if not adv() and not simple_ok then return false end
    if adv() then
      for _, g in ipairs(PX.GROUPS) do for _, gt in ipairs(g.tools) do if gt == t then PX.state.group = g.key end end end
    end
    G.FUNCS.forge_px_tool({config = {ref_table = {tool = t}}})
    return true
  end
  if key == "x" then G.FUNCS.forge_px_swap(); return true end
  if key == "[" then G.FUNCS.forge_px_brush({config = {ref_table = {d = -1}}}); return true end
  if key == "]" then G.FUNCS.forge_px_brush({config = {ref_table = {d = 1}}}); return true end
  if key == "=" or key == "kp+" then G.FUNCS.forge_px_zoom({config = {ref_table = {d = 1}}}); return true end
  if key == "-" or key == "kp-" then G.FUNCS.forge_px_zoom({config = {ref_table = {d = -1}}}); return true end
  if (key == "delete" or key == "backspace") and PX.doc.sel then ACTS.clear(); return true end
  return false
end

function PX.wheel(_, y)
  if not PX.active() or y == 0 then return false end
  local inside, _, _, lx, ly = PX.canvas:over()
  if not inside then return false end
  if PX.zoom_to(PX.state.zoom_i + (y > 0 and 1 or -1), lx, ly) then UIK.refresh() end
  return true
end

function PX.right_click(x, y, button)
  if button ~= 2 or not PX.active() or not PX.doc then return false end
  local inside, px, py = PX.canvas:over()
  if not inside then return false end
  local c = P.get(PX.doc, px, py)
  if c and c ~= P.CLEAR then
    PX.state.colour = c
    PX.later(UIK.refresh)
  end
  return true
end

function PX.dropped(file)
  if not PX.active() and not PX.import_open then return false end
  local ok, data = pcall(function()
    file:open("r")
    local raw = file:read()
    file:close()
    return love.image.newImageData(love.filesystem.newFileData(raw, "drop.png"))
  end)
  if ok and data then
    PX.import_data(data, PX.state.snap)
    PX.import_open = nil
    G.FUNCS.forge_px_back()
  end
  return true
end

function PX.init()
  if PX._wrapped or not Controller then return end
  PX._wrapped = true
  local kpu = Controller.key_press_update
  Controller.key_press_update = function(self, key, ...)
    local ok, used = pcall(PX.key, key)
    if not ok then print("[FORGE] pixel key: " .. tostring(used)) end
    if ok and used then return end
    return kpu(self, key, ...)
  end
  local wheel = love.wheelmoved
  love.wheelmoved = function(x, y, ...)
    local ok, used = pcall(PX.wheel, x, y)
    if ok and used then return end
    if wheel then return wheel(x, y, ...) end
  end
  local bpu = Controller.button_press_update
  Controller.button_press_update = function(self, button, ...)
    local ok, used = pcall(PX.pad_press, button)
    if not ok then print("[FORGE] pixel pad: " .. tostring(used)) end
    if ok and used then
r 23 692 %20%20%20%20%20%20 -
l 8
      return
    end
    return bpu(self, button, ...)
  end
  local bru = Controller.button_release_update
  Controller.button_release_update = function(self, button, ...)
    local ok, used = pcall(PX.pad_release, button)
    if ok and used then
r 23 762 %20%20%20%20%20%20 -
l 66
      return
    end
    return bru(self, button, ...)
  end
  local fd = love.filedropped
  love.filedropped = function(file, ...)
    local ok, used = pcall(PX.dropped, file)
    if ok and used then return end
    if fd then return fd(file, ...) end
  end
end

