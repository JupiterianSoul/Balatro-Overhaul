function PX.blank_card()
  local ok, src = pcall(love.image.newImageData, "resources/textures/1x/Enhancers.png")
  if not ok or not src then return P.new() end
  local out = love.image.newImageData(P.W, P.H)
  out:paste(src, 0, 0, 71, 0, 71, 95)
  return P.from_image_data(out)
end

local function silhouette(doc)
  local w, h = doc.w, doc.h
  local out = P.new(w, h)
  local fillc, edge = P.hex("5f7377"), P.hex("374244")
  local function solid(x, y)
    local c = P.get(doc, x, y)
    return c and select(4, P.unpack(c)) > 0
  end
  for y = 0, h - 1 do
    for x = 0, w - 1 do
      if solid(x, y) then
        local rim = not (solid(x - 1, y) and solid(x + 1, y) and solid(x, y - 1) and solid(x, y + 1))
        out.px[y * w + x + 1] = rim and edge or fillc
      end
    end
  end
  return out
end

local function sorted_by_order(t)
  local out = {}
  for k, v in pairs(t or {}) do if type(v) == "table" and v.pos then out[#out + 1] = {key = k, c = v} end end
  table.sort(out, function(a, b) return (a.c.order or 0) < (b.c.order or 0) or ((a.c.order or 0) == (b.c.order or 0) and a.key < b.key) end)
  return out
end

function PX.sprites(kind_key)
  local k = PX.kind(kind_key)
  local out = {}
  if k.pool then
    for _, c in ipairs(G.P_CENTER_POOLS and G.P_CENTER_POOLS[k.pool] or {}) do
      if c.pos and not c.forge_preview and not c.display_size and not c.pixel_size and (k.pool ~= "Joker" or c.unlocked ~= false or c.forge) then
        out[#out + 1] = {key = c.key, atlas = c.atlas or k.atlas, pos = c.pos}
      end
    end
  elseif k.key == "seal" then
    for _, s in ipairs(PX.SEALS) do out[#out + 1] = {key = s.key, atlas = "centers", pos = s.pos} end
  elseif k.key == "skin" then
    local list = {}
    for key, c in pairs(G.P_CARDS or {}) do if c.pos then list[#list + 1] = {key = key, c = c} end end
    table.sort(list, function(a, b) return a.c.pos.y < b.c.pos.y or (a.c.pos.y == b.c.pos.y and a.c.pos.x < b.c.pos.x) end)
    for _, e in ipairs(list) do out[#out + 1] = {key = e.key, atlas = "cards_1", pos = e.c.pos} end
  elseif k.key == "blind" then
    for _, e in ipairs(sorted_by_order(G.P_BLINDS)) do out[#out + 1] = {key = e.key, atlas = e.c.atlas or "blind_chips", pos = {x = 0, y = e.c.pos.y}} end
  elseif k.key == "tag" then
    for _, e in ipairs(sorted_by_order(G.P_TAGS)) do out[#out + 1] = {key = e.key, atlas = e.c.atlas or "tags", pos = e.c.pos} end
  elseif k.key == "stake" then
    for _, e in ipairs(sorted_by_order(G.P_STAKES)) do out[#out + 1] = {key = e.key, atlas = e.c.atlas or "chips", pos = e.c.pos} end
  end
  return out
end

local function sprite_of(kind_key, s)
  local w, h = kind_size(PX.kind(kind_key))
  return PX.sprite_data(s.atlas, s.pos, w, h)
end

function PX.blank_of(kind_key)
  local k = PX.kind(kind_key)
  local w, h = kind_size(k)
  if k.empty_blank then return P.new(w, h) end
  if is_card(k) then return PX.blank_card() end
  local first = PX.sprites(k.key)[1]
  local doc = first and sprite_of(k.key, first)
  return doc and silhouette(doc) or P.new(w, h)
end

function PX.guide_of(kind_key)
  local k = PX.kind(kind_key)
  if k.key == "seal" then
    local base = PX.blank_card()
    local seal = PX.sprite_data("centers", PX.SEALS[1].pos)
    if seal then
      for i = 1, #base.px do if select(4, P.unpack(seal.px[i])) > 0 then base.px[i] = seal.px[i] end end
    end
    return base
  end
  if is_card(k) then return PX.blank_card() end
  local first = PX.sprites(k.key)[1]
  return first and sprite_of(k.key, first) or nil
end

local function to_image(px, w, h, old)
  local data = love.image.newImageData(w, h)
  data:mapPixel(function(x, y)
    local r, g, b, a = P.unpack(px[y * w + x + 1])
    return r / 255, g / 255, b / 255, a / 255
  end)
  if old and old:getWidth() == w and old:getHeight() == h then
    old:replacePixels(data)
    return old, data
  end
  local img = love.graphics.newImage(data)
  img:setFilter("nearest", "nearest")
  return img, data
end

function PX.build_guide()
  PX.guide_image = nil
  local g = PX.guide_of(PX.state.kind)
  if g and PX.doc and g.w == PX.doc.w and g.h == PX.doc.h then PX.guide_image = to_image(g.px, g.w, g.h) end
end

local function stack_px(a, b)
  local out = {}
  for i = 1, #a do
    local _, _, _, al = P.unpack(b[i])
    out[i] = al > 0 and b[i] or a[i]
  end
  return out
end

function PX.composite()
  local d = PX.doc
  return stack_px(P.flatten(d, "art"), P.flatten(d, "soul"))
end

local function data_of(px, w, h)
  local data = love.image.newImageData(w, h)
  data:mapPixel(function(x, y)
    local r, g, b, a = P.unpack(px[y * w + x + 1])
    return r / 255, g / 255, b / 255, a / 255
  end)
  return data
end
PX.data_of = data_of

local function doubled_px(px, w, h)
  local d = P.new(w, h)
  d.layers[1].px = px
  P.relink(d)
  local o = P.to_2x(d)
  return o.px
end

local function make_atlas(name, px, w, h, cols)
  if not (G and G.ASSET_ATLAS) then return nil end
  local s = (G.SETTINGS and G.SETTINGS.GRAPHICS and G.SETTINGS.GRAPHICS.texture_scaling) or 1
  local fw, fh = w * cols, h
  local src = px
  if s == 2 then src, fw, fh = doubled_px(px, fw, fh), fw * 2, fh * 2 end
  local ok, img = pcall(love.graphics.newImage, data_of(src, fw, fh), {mipmaps = true, dpiscale = s})
  if not ok or not img then return nil end
  pcall(img.setFilter, img, "nearest", "nearest")
  local atlas = G.ASSET_ATLAS[name] or {name = name, type = "asset_atli"}
  atlas.image, atlas.px, atlas.py = img, w, h
  G.ASSET_ATLAS[name] = atlas
  return atlas
end

local function side_by_side(a, b, w, h)
  local out = {}
  for y = 0, h - 1 do
    for x = 0, w - 1 do
      out[y * 2 * w + x + 1] = a[y * w + x + 1]
      out[y * 2 * w + w + x + 1] = b[y * w + x + 1]
    end
  end
  return out
end

function PX.update_preview_atlas()
  local d = PX.doc
  if not d then return end
  local art, soul = P.flatten(d, "art"), P.flatten(d, "soul")
  PX.has_soul = P.has_pixels(soul)
  if PX.state.kind == "seal" and d.w == P.W and d.h == P.H then
    PX._blank_px = PX._blank_px or PX.blank_card().px
    art = stack_px(PX._blank_px, art)
  end
  if is_card(PX.kind()) and d.w == P.W and d.h == P.H then
    make_atlas("forge_px_preview", side_by_side(art, soul, d.w, d.h), d.w, d.h, 2)
  else
    make_atlas("forge_px_preview", stack_px(art, soul), d.w, d.h, 1)
  end
end

local function read_png(path, w, h)
  if not love.filesystem.getInfo(path) then return nil end
  local ok, data = pcall(love.image.newImageData, path)
  if ok and data and data:getWidth() == w and data:getHeight() == h then return P.from_image_data(data) end
  return nil
end

function PX.load_target(target)
  PX.state.target = target
  if target and target.art_kind then PX.state.kind = PX.kind(target.art_kind).key end
  if target and target.kind == "creation" and not target.art_kind then PX.state.kind = "joker" end
  PX.state.zoom_i, PX.state.pan = 1, {x = 0, y = 0}
  local w, h = kind_size(PX.kind())
  local paths = PX.paths()
  local doc = read_png(paths.x1, w, h)
  if not doc and target and target.kind == "creation" then
    local c = Store.get(target.id)
    if c and c.art and c.art.atlas then doc = PX.sprite_data(c.art.atlas, {x = c.art.x or 0, y = c.art.y or 0}) end
  end
  doc = doc or PX.blank_of(PX.state.kind)
  doc.layers[1].name = "art"
  local soul = PX.kind().soul and read_png(paths.soul, w, h)
  if soul then
    P.add_layer(doc, "soul")
    doc.layers[#doc.layers].px = soul.px
    doc.active = 1
    P.relink(doc)
  end
  doc.undo, doc.redo = {}, {}
  PX.doc = doc
  PX.doc.mirror = PX.state.mirror
  PX.build_guide()
  PX.sync_image()
end

function PX.ensure()
  if not PX.doc then PX.load_target(PX.state.target) end
end

function PX.sync_image()
  if not PX.doc then return end
  local d = PX.doc
  local px = PX.composite()
  PX.image, PX.image_data = to_image(px, d.w, d.h, PX.image)
  PX.update_preview_atlas()
end

function PX.flat_doc()
  PX.ensure()
  return PX.doc and P.flat_doc(PX.doc, "art") or nil
end

local function preview_center()
  local c = G.P_CENTERS[PX.PREVIEW]
  if not c then
    c = {key = PX.PREVIEW, order = FJ.ORDER, unlocked = true, discovered = true, alerted = true, set = "Joker", effect = "", cost_mult = 1, name = "Preview", rarity = 1, cost = 1,
      pos = {x = 0, y = 0}, config = {extra = {}}, no_collection = true, forge_preview = true}
    G.P_CENTERS[PX.PREVIEW] = c
  end
  c.atlas = "forge_px_preview"
  c.soul_pos = PX.has_soul and {x = 1, y = 0} or nil
  local t = PX.state.target
  local cr = t and t.kind == "creation" and Store.get(t.id)
  local k = PX.kind()
  local name = cr and cr.name or (k.key == "joker" and mod_loc("New joker") or mod_loc(k.label))
  FJ.set_loc(PX.PREVIEW, name, {k.key == "joker" and mod_loc("Does nothing yet") or mod_loc("Art preview")})
  return c
end

local function write_px(path, px, w, h)
  local ok, raw = pcall(function() return data_of(px, w, h):encode("png"):getString() end)
  if ok and raw then fs_write(path, raw) end
  return ok
end

function PX.export_files(paths)
  local d = PX.doc
  if not d then return nil end
  Store.ensure_dirs()
  ensure_dir("forge")
  ensure_dir("forge/art")
  local art, soul = P.flatten(d, "art"), P.flatten(d, "soul")
  write_px(paths.x1, art, d.w, d.h)
  write_px(paths.x2, doubled_px(art, d.w, d.h), d.w * 2, d.h * 2)
  local has_soul = P.has_pixels(soul)
  if has_soul then
    write_px(paths.soul, soul, d.w, d.h)
    write_px(paths.soul2x, doubled_px(soul, d.w, d.h), d.w * 2, d.h * 2)
  else
    if love.filesystem.getInfo(paths.soul) then love.filesystem.remove(paths.soul) end
    if love.filesystem.getInfo(paths.soul2x) then love.filesystem.remove(paths.soul2x) end
  end
  return {x1 = paths.x1, x2 = paths.x2, soul = has_soul and paths.soul or nil, soul2x = has_soul and paths.soul2x or nil, w = d.w, h = d.h, kind = PX.state.kind}
end

function PX.save()
  if not PX.doc then return end
  local info = PX.export_files(PX.paths())
  if not info then return end
  local name = PX.atlas_name()
  if name ~= "forge_preview" or PX.state.kind == "joker" then
    local data = data_of(P.flatten(PX.doc, "art"), PX.doc.w, PX.doc.h)
    if PX.doc.w == P.W and PX.doc.h == P.H then FJ.atlas_from_data(name, data) end
  end
  local t = PX.state.target
  if t and t.kind == "creation" then
    local c = Store.get(t.id)
    if c then
      local a = c.art or {}
      local was = a.file
      if a.file ~= info.x1 or a.file2x ~= info.x2 or a.soul ~= info.soul or a.kind ~= info.kind then
        c.art = {file = info.x1, file2x = info.x2, soul = info.soul, soul2x = info.soul2x, kind = info.kind}
        Store.put(c)
        if was ~= info.x1 then
          FJ.refresh(t.id)
          PX.rebuild_preview = true
        end
      end
    end
  end
  local B = rawget(_G, "ForgeBuilder")
  if t and t.kind == "draft" and B and B.art_changed then pcall(B.art_changed, info.x1, info) end
end

function PX.export(target)
  if target then PX.open_for(target) end
  PX.ensure()
  if not PX.doc then return nil end
  ensure_dir("forge")
  ensure_dir("forge/export")
  local t = PX.state.target
  local cr = t and t.kind == "creation" and Store.get(t.id)
  local stem = tostring((cr and cr.name) or PX.state.kind):lower():gsub("[^%w]+", "_"):gsub("^_+", ""):gsub("_+$", "")
  if stem == "" then stem = "art" end
  local info = PX.export_files({x1 = "forge/export/" .. stem .. ".png", x2 = "forge/export/" .. stem .. "_2x.png", soul = "forge/export/" .. stem .. "_soul.png", soul2x = "forge/export/" .. stem .. "_soul_2x.png"})
  PX.notice_t = love.timer.getTime()
  PX.notice = info and string.format(mod_loc("Saved in %s"), "forge/export/" .. stem .. ".png") or nil
  return info
end

local Canvas = Moveable:extend()
PX.Canvas = Canvas

function Canvas:init(w, h)
  Moveable.init(self, 0, 0, w, h)
r 2 14 %20%20 -
r 2 22 %20%20 -
r 3 21 %20%20 -
r 3 19 %20%20 -
l 126
  self.map = nil
end

local function doc_wh()
  local d = PX.doc
  if d then return d.w, d.h end
  return P.W, P.H
end

function Canvas:pixel_size()
  local w, h = doc_wh()
  return math.min(self.T.w / w, self.T.h / h) * PX.ZOOMS[PX.state.zoom_i]
end

function Canvas:origin()
  local ps = self:pixel_size()
  local pan = PX.state.pan
  local w, h = doc_wh()
  return (self.T.w - w * ps) / 2 + pan.x * ps, (self.T.h - h * ps) / 2 + pan.y * ps, ps
end

function Canvas:local_of(sx, sy)
  local m = self.map
  if not m then return nil end
  return (sx - m.x) / m.k, (sy - m.y) / m.k
end

function Canvas:cursor_pixel()
  local lx, ly = self:local_of(love.mouse.getPosition())
  if not lx then return nil end
  local ox, oy, ps = self:origin()
  return math.floor((lx - ox) / ps), math.floor((ly - oy) / ps), lx, ly
end

function Canvas:over()
  local px, py, lx, ly = self:cursor_pixel()
  if not px then return false end
  return lx >= 0 and ly >= 0 and lx <= self.T.w and ly <= self.T.h, px, py, lx, ly
end

function Canvas:handle_pinch()
  local ok, touches = pcall(love.touch.getTouches)
  if not ok or not touches or #touches < 2 then
    self.two_finger = nil
    return
  end
  local ax, ay = love.touch.getPosition(touches[1])
  local bx, by = love.touch.getPosition(touches[2])
  ax, ay = self:local_of(ax, ay)
  bx, by = self:local_of(bx, by)
  if not ax then return end
  local d = math.max(0.01, math.sqrt((ax - bx) ^ 2 + (ay - by) ^ 2))
  local mx, my = (ax + bx) / 2, (ay + by) / 2
  if self.stroke then
    if self.stroke.began then P.cancel(PX.doc) end
    self.stroke = nil
    PX.sync_image()
  end
  self.pinching = true
  if not self.two_finger then
    self.two_finger = {d = d, x = mx, y = my, zoom = PX.ZOOMS[PX.state.zoom_i], pan = {x = PX.state.pan.x, y = PX.state.pan.y}}
    return
  end
  local want = self.two_finger.zoom * d / self.two_finger.d
  local best = 1
  for i, z in ipairs(PX.ZOOMS) do if math.abs(z - want) < math.abs(PX.ZOOMS[best] - want) then best = i end end
  PX.state.zoom_i = best
  local ps = self:pixel_size()
  PX.state.pan.x = self.two_finger.pan.x + (mx - self.two_finger.x) / ps
  PX.state.pan.y = self.two_finger.pan.y + (my - self.two_finger.y) / ps
  PX.clamp_pan()
end

function PX.clamp_pan()
  local z = PX.ZOOMS[PX.state.zoom_i]
  local w, h = doc_wh()
  local lim_x, lim_y = w * (z - 1) / (2 * z) + 8, h * (z - 1) / (2 * z) + 8
  if z == 1 then lim_x, lim_y = 0, 0 end
  PX.state.pan.x = math.max(-lim_x, math.min(lim_x, PX.state.pan.x))
  PX.state.pan.y = math.max(-lim_y, math.min(lim_y, PX.state.pan.y))
end

local function sel_edges(d)
  local s = d.sel
  if not s then return nil end
  if PX.edges_for == s then return PX.edges end
  local e = {}
  local w = d.w
  local m = s.mask
  for i in pairs(m) do
    local x, y = (i - 1) % w, math.floor((i - 1) / w)
    if x == 0 or not m[i - 1] then e[#e + 1] = {x, y, x, y + 1} end
    if x == w - 1 or not m[i + 1] then e[#e + 1] = {x + 1, y, x + 1, y + 1} end
    if y == 0 or not m[i - w] then e[#e + 1] = {x, y, x + 1, y} end
    if y == d.h - 1 or not m[i + w] then e[#e + 1] = {x, y + 1, x + 1, y + 1} end
  end
  PX.edges_for, PX.edges = s, e
  return e
end

local function shape_points(st)
  local pts = {}
  local d = PX.doc
  if st.tool == "line" or st.tool == "gradient" then
    pts = P.line_points(st.x0, st.y0, st.x1, st.y1)
  elseif st.tool == "box" or st.tool == "block" or st.tool == "select" then
    local tmp = P.new(d.w, d.h)
    P.rect(tmp, st.x0, st.y0, st.x1, st.y1, 1, st.tool == "block")
    for i = 1, #tmp.px do if tmp.px[i] == 1 then pts[#pts + 1] = {(i - 1) % d.w, math.floor((i - 1) / d.w)} end end
  elseif st.tool == "oval" or st.tool == "disc" then
    pts = P.ellipse_points(st.x0, st.y0, st.x1, st.y1, st.tool == "disc")
  elseif st.tool == "lasso" and st.pts then
    for k = 1, #st.pts - 1 do
      for _, q in ipairs(P.line_points(st.pts[k][1], st.pts[k][2], st.pts[k + 1][1], st.pts[k + 1][2])) do pts[#pts + 1] = q end
    end
  end
  if PX.state.mirror and st.tool ~= "select" and st.tool ~= "lasso" and st.tool ~= "gradient" then
    local n = #pts
    for k = 1, n do pts[#pts + 1] = {d.w - 1 - pts[k][1], pts[k][2]} end
  end
  return pts
end

local BRUSHES = {pencil = "paint", eraser = "erase", dither = "dither", shade = "shade", light = "light"}

