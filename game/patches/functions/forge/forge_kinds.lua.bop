K.TRY_MORE = {seal = true, edition = true, booster = true, tag = true, blind = true}
K.TRY_START = {deck = true, stake = true}

function K.can_try(kind) return K.CONS[kind] or kind == "voucher" or kind == "enhancement" or K.TRY_MORE[kind] or K.TRY_START[kind] or false end

function K.try_args(c)
  local args = {stake = 1}
  if c.kind == "deck" and G.P_CENTERS[K.key_of(c)] then
    G.GAME.viewed_back = Back(G.P_CENTERS[K.key_of(c)])
  elseif c.kind == "stake" then
    args.stake = More.stake_base(c)
    args.forge_stake = c.id
  end
  return args
end

K.TRY_CARDS = 5

function K.try_give(c)
  if K.TRY_START[c.kind] then return true end
  if K.TRY_MORE[c.kind] then return More.try_give(c) end
  local key = K.key_of(c)
  if not (G.P_CENTERS[key] and G.consumeables) then return false end
  if c.kind == "voucher" then
    G.GAME.used_vouchers[key] = true
    Card.apply_to_run(nil, G.P_CENTERS[key])
    return true
  end
  if c.kind == "enhancement" then
    local pile = G.deck and G.deck.cards or {}
    local n = 0
    for i = #pile, 1, -1 do
      if n >= K.TRY_CARDS then break end
      pile[i]:set_ability(G.P_CENTERS[key], nil, true)
      n = n + 1
    end
    return n > 0
  end
  local card = create_card(K.SET[c.kind], G.consumeables, nil, nil, nil, nil, key, "forge_try")
  card:add_to_deck()
r 1 191 %20%20 -
l 4
  return true
end

