function K.install_hooks()
  if K.hooked then return end
  K.hooked = true
  if Game and Game.init_item_prototypes then
    local orig = Game.init_item_prototypes
    Game.init_item_prototypes = function(self, ...)
      local r = orig(self, ...)
      local ok, err = pcall(K.register_all)
      if not ok then log_once("register", "register failed: " .. tostring(err)) end
      return r
    end
  end
  if type(init_localization) == "function" then
    local orig = init_localization
    init_localization = function(...)
      local r = orig(...)
      pcall(K.inject_loc)
      pcall(More.inject_loc)
      return r
    end
  end
  if type(get_current_pool) == "function" then
    local orig = get_current_pool
    get_current_pool = function(...)
      pcall(K.sync_pools)
      return orig(...)
    end
  end
  if Card and Card.use_consumeable then
    local orig = Card.use_consumeable
    Card.use_consumeable = function(self, area, copier)
      local center = self.config and self.config.center
      if center and K.CONS[center.forge_kind] then
        local ok, err = pcall(K.use, self, area, copier)
        if not ok then log_once("use", "use failed: " .. tostring(err)) end
        return
      end
      return orig(self, area, copier)
    end
  end
  if Card and Card.can_use_consumeable then
    local orig = Card.can_use_consumeable
    Card.can_use_consumeable = function(self, any_state, skip_check)
      local center = self.config and self.config.center
      if center and K.CONS[center.forge_kind] then
        local ok, r = pcall(K.can_use, self, any_state, skip_check)
        return ok and r or false
      end
      return orig(self, any_state, skip_check)
    end
  end
  if type(generate_card_ui) == "function" then
    local orig = generate_card_ui
    generate_card_ui = function(_c, ...)
      if type(_c) == "table" and _c.forge_kind == "planet" then
        _c = setmetatable({set = "Tarot"}, {__index = _c})
      end
      return orig(_c, ...)
    end
  end
  if Card and Card.apply_to_run then
    local orig = Card.apply_to_run
    Card.apply_to_run = function(self, center)
      local cen = center or (self and self.config and self.config.center)
      if cen and cen.forge_kind == "voucher" then
        local ok, err = pcall(K.apply_voucher, cen)
        if not ok then log_once("voucher", "voucher failed: " .. tostring(err)) end
        return
      end
      return orig(self, center)
    end
  end
  if Back and Back.apply_to_run then
    local orig = Back.apply_to_run
    Back.apply_to_run = function(self, ...)
      local r = orig(self, ...)
      local ok, err = pcall(K.apply_deck, self)
      if not ok then log_once("deck", "deck failed: " .. tostring(err)) end
      return r
    end
  end
  if type(create_UIBox_your_collection_planets) == "function" then
    local orig = create_UIBox_your_collection_planets
    create_UIBox_your_collection_planets = function(...)
      if G.P_CENTER_POOLS and G.P_CENTER_POOLS.Planet and #G.P_CENTER_POOLS.Planet > 12 then
        local ok, r = pcall(K.collection_planets)
        if ok and r then return r end
        log_once("coll", "planet collection failed: " .. tostring(r))
      end
      return orig(...)
    end
  end
  if G and G.FUNCS and G.FUNCS.get_poker_hand_info and not K.hand_hooked then
    K.hand_hooked = true
    local orig = G.FUNCS.get_poker_hand_info
    G.FUNCS.get_poker_hand_info = function(cards, ...)
      local a, b, c2, scoring, e = orig(cards, ...)
      pcall(function()
        if type(scoring) ~= "table" or type(cards) ~= "table" then return end
        for _, card in ipairs(cards) do
          local cen = card.config and card.config.center
          if cen and cen.forge_always and not card.debuff then
            local inside = false
            for _, s2 in ipairs(scoring) do if s2 == card then inside = true end end
            if not inside then scoring[#scoring + 1] = card end
          end
        end
      end)
      return a, b, c2, scoring, e
    end
  end
  if Card and Card.load then
    local orig = Card.load
    Card.load = function(self, cardTable, other_card)
      pcall(function()
        local sf = cardTable and cardTable.save_fields
        local key = sf and sf.center
        if type(key) == "string" and key:sub(1, 8) == "m_forge_" and not G.P_CENTERS[key] then
          sf.center = "c_base"
        elseif type(key) == "string" and key:sub(1, 8) == "p_forge_" and not G.P_CENTERS[key] then
          sf.center = "p_arcana_normal_1"
        elseif type(key) == "string" and (key:sub(1, #K.PREFIX) == K.PREFIX or key:sub(1, 8) == "v_forge_") and not G.P_CENTERS[key] then
          lost_center()
          K.inject_loc()
          sf.center = K.LOST
        end
      end)
      return orig(self, cardTable, other_card)
    end
  end
  More.install_hooks()
  local ok_run, err_run = pcall(Run.install)
  if not ok_run then log_once("run", "run hooks failed: " .. tostring(err_run)) end
  if G and G.P_CENTERS and next(G.P_CENTERS) then pcall(K.register_all) end
end

if mod_loc_register then
  mod_loc_register{
    fr = {["Scores extra chips"] = "Marque des jetons en plus"},
    es = {["Scores extra chips"] = "Anota fichas extra"},
  }
end

return K
end
