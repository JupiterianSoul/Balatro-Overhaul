        return true
      end}))
    end
  end
end

function K.use(card, area, copier)
  stop_use()
  if not copier then set_consumeable_usage(card) end
  if card.debuff then return end
  local c = item_of(card)
  if not c then return end
  local used = copier or card
  local f = fields(c)
  local hl = highlighted()
  if c.kind == "planet" then
    local levels = math.max(1, math.floor(tonumber(f.levels) or 1))
    if f.hand == "all" then level_every(used, levels) else level(used, f.hand or "Pair", levels, f, c) end
  end
  for _, e in ipairs(c.effects or {}) do
    local ok, err = pcall(effect, e, c, used, hl)
    if not ok then log_once("use_" .. c.id .. "_" .. tostring(e.id), "effect " .. tostring(e.id) .. " of " .. c.id .. " failed: " .. tostring(err)) end
  end
  if #hl > 0 then
    G.E_MANAGER:add_event(Event({trigger = "after", delay = 0.2, func = function() G.hand:unhighlight_all(); return true end}))
  end
end

function K.apply_voucher(center)
  local c = Store.get_item(center.forge_id)
  if not c then return end
  Run.count_buy(center.key)
  Run.apply_now(c, {key = center.key})
end

