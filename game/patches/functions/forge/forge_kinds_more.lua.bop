      M.blind_keep = nil
      M.blind_exit = exit
      local shown = {}
      for key, p in pairs(G.P_BLINDS) do
        if p.forge_kind == "blind" then
          local c = Store.get_item(p.forge_id)
          if c and c.enabled and not p.forge_gone then shown[#shown + 1] = key end
        end
      end
      table.sort(shown, function(a, b) return (G.P_BLINDS[a].order or 0) < (G.P_BLINDS[b].order or 0) end)
      local per = 30
      local pages = #shown > 0 and 1 + math.ceil(#shown / per) or 1
      local page = math.max(1, math.min(M.blind_page or 1, pages))
      local keep = {}
      if page > 1 then
        for i = (page - 2) * per + 1, math.min(#shown, (page - 1) * per) do keep[shown[i]] = true end
      end
      local plain = 0
      for _, p in pairs(G.P_BLINDS) do if p.forge_kind ~= "blind" and not p.rr_plain then plain = plain + 1 end end
      local hidden = {}
      for key, p in pairs(G.P_BLINDS) do
        local forge = p.forge_kind == "blind"
        if (page == 1 and forge) or (page > 1 and not keep[key]) then hidden[key] = p end
      end
      local was = {}
      for key, p in pairs(hidden) do was[key] = p.rr_plain; p.rr_plain = true end
      local ok, t = pcall(orig, exit)
      for key, p in pairs(hidden) do p.rr_plain = was[key] end
      if not ok then error(t) end
      if pages > 1 then
        pcall(function()
          local column = t.nodes[1].nodes[1].nodes[1].nodes[1].nodes[1].nodes
          local grid = t.nodes[1].nodes[1].nodes[1].nodes[1].nodes[2]
          if page > 1 and grid and grid.config then
            grid.config.minw = math.min(5, plain) * 1.5 + (plain >= 5 and 0.5 or 0)
            grid.config.minh = math.ceil(plain / 5) * 1.5
            grid.config.align = "tm"
          end
          local options = {}
          for i = 1, pages do options[i] = localize("k_page") .. " " .. i .. "/" .. pages end
          column[#column + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.1}, nodes = {
            create_option_cycle({options = options, w = 2.6, scale = 0.8, cycle_shoulders = true, opt_callback = "forge_collection_blind_page", focus_args = {snap_to = true, nav = "wide"}, current_option = page, colour = G.C.RED, no_pips = true}),
          }}
        end)
      end
      return t
    end
  end
end

