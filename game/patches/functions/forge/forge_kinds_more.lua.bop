local function pack_key(v)
  if v == "Forge" then
    local live = M.live("booster")
    if live[1] and G.P_CENTERS["p_forge_" .. live[1].id] then return "p_forge_" .. live[1].id end
    return M.MEGA.Buffoon
  end
  return M.MEGA[v] or M.MEGA.Arcana
end

local function level_hand(tag, hand, n)
  if not (G.GAME.hands[hand]) then return end
  update_hand_text({sound = "button", volume = 0.7, pitch = 0.8, delay = 0.3}, {handname = localize(hand, "poker_hands"), chips = G.GAME.hands[hand].chips, mult = G.GAME.hands[hand].mult, level = G.GAME.hands[hand].level})
  level_up_hand(tag, hand, nil, n)
  update_hand_text({sound = "button", volume = 0.7, pitch = 1.1, delay = 0}, {mult = 0, chips = 0, handname = "", level = ""})
end

