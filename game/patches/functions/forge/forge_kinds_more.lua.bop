function M.try_give(c)
  if c.kind == "seal" or c.kind == "edition" then
    local pile = G.deck and G.deck.cards or {}
    local n = 0
    for i = #pile, 1, -1 do
      if n >= 5 then break end
      if c.kind == "seal" then pile[i]:set_seal(M.seal_key(c), true, true) else pile[i]:set_edition({forge = c.id}, true, true) end
      n = n + 1
    end
    return n > 0
  end
  if c.kind == "tag" then
    local key = M.tag_key(c)
    if not G.P_TAGS[key] then return false end
    local tag = Tag(key)
    add_tag(tag)
    local ty = G.P_TAGS[key].config.type
    if ty == "immediate" or ty == "new_blind_choice" then tag:apply_to_run({type = ty}) end
    return true
  end
  if c.kind == "blind" then
    local key = M.blind_key(c)
    if not (G.P_BLINDS[key] and G.blind_select_opts and G.blind_select_opts.boss) then return false end
    G.GAME.bosses_used[key] = G.GAME.bosses_used[key] or 0
    G.FORCE_BOSS = key
r 5 288 %20%20%20%20 -
r 5 289 %20%20%20%20 -
l 15
    G.E_MANAGER:add_event(Event({trigger = "after", delay = 0.5, func = function() G.FORCE_BOSS = nil; return true end}))
    return true
  end
  if c.kind == "booster" then
    if not (G.P_CENTERS["p_forge_" .. c.id] and G.play) then return false end
    open_pack("p_forge_" .. c.id)
    return true
  end
  return false
end


