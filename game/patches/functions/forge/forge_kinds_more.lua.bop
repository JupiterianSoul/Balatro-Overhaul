  wrap(Card, "get_chip_bonus", function(orig) return function(self, ...)
    local r = orig(self, ...)
    local c = not self.debuff and seal_item(self)
    return c and r + sum(c, "scored_chips") or r
  end end)
  wrap(Card, "get_chip_mult", function(orig) return function(self, ...)
    local r = orig(self, ...)
    local c = not self.debuff and seal_item(self)
    return c and r + sum(c, "scored_mult") or r
  end end)
  wrap(Card, "get_chip_x_mult", function(orig) return function(self, ...)
    local r = orig(self, ...)
    local c = not self.debuff and seal_item(self)
    if not c then return r end
    local x = prod(c, "scored_xmult")
    if x == 1 then return r end
    return (r > 0 and r or 1) * x
  end end)
  wrap(Card, "get_p_dollars", function(orig) return function(self, ...)
    local r = orig(self, ...)
    local c = not self.debuff and seal_item(self)
    local extra = c and sum(c, "scored_money") or 0
    if extra > 0 then
      G.GAME.dollar_buffer = (G.GAME.dollar_buffer or 0) + extra
      G.E_MANAGER:add_event(Event({func = function() G.GAME.dollar_buffer = 0; return true end}))
    end
    return r + extra
  end end)
  wrap(Card, "get_end_of_round_effect", function(orig) return function(self, ...)
    local r = orig(self, ...)
    local c = not self.debuff and seal_item(self)
    if not c then return r end
    local _, planet = sum(c, "held_planet")
    if planet and seal_planet(self) then r.effect = true end
    local money = sum(c, "held_money")
    if money > 0 then
      r.h_dollars = (r.h_dollars or 0) + money
      r.card = self
    end
    return r
  end end)
  wrap(Card, "set_seal", function(orig) return function(self, seal, silent, immediate)
    if seal and M.SEAL_POS[seal] and not self.area and G.STATE == G.STATES.STANDARD_PACK then
      local ok, pick = pcall(function()
        local live = {}
        for _, c in ipairs(M.live("seal")) do if G.P_SEALS[M.seal_key(c)] then live[#live + 1] = M.seal_key(c) end end
        if #live == 0 then return nil end
        if pseudorandom(pseudoseed("forge_seal")) >= #live / (#live + 4) then return nil end
        return (pseudorandom_element(live, pseudoseed("forge_seal_pick")))
      end)
      if ok and pick then seal = pick end
    end
    return orig(self, seal, silent, immediate)
  end end)
  wrap(Card, "set_edition", function(orig) return function(self, edition, immediate, silent)
    local before = self.edition and self.edition.forge_slot and not self.edition.negative
    local c = type(edition) == "table" and edition.forge and Store.get_item(edition.forge)
    local t = c and M.edition_table(c)
    if not t then
      local r = orig(self, edition, immediate, silent)
      if before and self.added_to_deck then slot_change(self, -1) end
      return r
    end
    local shader = nil
    for _, s in ipairs({"negative", "polychrome", "holo", "foil"}) do if t[s] then shader = {[s] = true} end end
    if shader then orig(self, shader, immediate, silent) else orig(self, nil, immediate, silent) end
    self.edition = t
    if t.forge_slot and not before and self.added_to_deck then slot_change(self, 1) end
    if before and not t.forge_slot and self.added_to_deck then slot_change(self, -1) end
    if self.set_cost then self:set_cost() end
  end end)
  wrap(Card, "add_to_deck", function(orig) return function(self, from_debuff, ...)
    local was = self.added_to_deck
    local r = orig(self, from_debuff, ...)
    if not was and not from_debuff and self.edition and self.edition.forge_slot and not self.edition.negative then slot_change(self, 1) end
    return r
  end end)
  wrap(Card, "remove_from_deck", function(orig) return function(self, from_debuff, ...)
    local was = self.added_to_deck
    local r = orig(self, from_debuff, ...)
    if was and not from_debuff and self.edition and self.edition.forge_slot and not self.edition.negative and G.jokers then slot_change(self, -1) end
    return r
  end end)
  if type(poll_edition) == "function" then
    local orig = poll_edition
    poll_edition = function(_key, _mod, _no_neg, _guaranteed, ...)
      local r = orig(_key, _mod, _no_neg, _guaranteed, ...)
      if r == nil and not _guaranteed then
        local ok, f = pcall(forge_edition_poll, _key, _mod, _no_neg)
        if ok and f then return f end
      end
      return r
    end
  end
  wrap(Card, "open", function(orig) return function(self, ...)
    if self.ability and self.ability.set == "Booster" and G.GAME then
      G.GAME.forge_only_pack = self.config and self.config.center and self.config.center.forge_only or nil
    end
    return orig(self, ...)
  end end)
  if type(create_card) == "function" then
    local orig = create_card
    create_card = function(_type, area, legendary, _rarity, skip_materialize, soulable, forced_key, key_append, ...)
      if G.GAME and G.GAME.forge_only_pack and _type == "Joker" and area and area == G.pack_cards and not forced_key then
        local ok, key = pcall(function()
          local keys = {}
          local FJm = rawget(_G, "JokerForge") and JokerForge.joker
          for _, it in ipairs(Store.live_jokers and Store.live_jokers() or {}) do
            local k = FJm and FJm.key_of and FJm.key_of(it.id)
            if it.enabled ~= false and k and G.P_CENTERS[k] then keys[#keys + 1] = k end
          end
          table.sort(keys)
          if #keys == 0 then return nil end
          return (pseudorandom_element(keys, pseudoseed("forge_pack")))
        end)
        if ok and key then forced_key = key end
      end
      return orig(_type, area, legendary, _rarity, skip_materialize, soulable, forced_key, key_append, ...)
    end
  end
  if type(generate_card_ui) == "function" then
    local orig = generate_card_ui
    generate_card_ui = function(_c, full_UI_table, specific_vars, card_type, badges, ...)
      local first = not full_UI_table
      local booster = type(_c) == "table" and _c.forge_kind == "booster"
      if booster then _c = setmetatable({set = "Other"}, {__index = _c}) end
      local r = orig(_c, full_UI_table, specific_vars, card_type, badges, ...)
      if first and type(r) == "table" then
        pcall(function()
          if booster and not r.name then r.name = localize{type = "name", set = "Other", key = _c.key, nodes = {}} end
          if type(badges) == "table" and _c.set ~= "Edition" then
            for _, b in ipairs(badges) do
              if type(b) == "string" and b:sub(1, 6) == "forge_" then
                if b:sub(-5) == "_seal" then
                  if G.localization.descriptions.Other[b] then generate_card_ui({key = b, set = "Other"}, r) end
                elseif G.P_CENTERS["e_" .. b] then
                  generate_card_ui(G.P_CENTERS["e_" .. b], r)
                end
              end
            end
          end
        end)
      end
      return r
    end
  end
  if Card and Card.load then
    local orig = Card.load
    Card.load = function(self, cardTable, other_card)
      pcall(function()
        local s = cardTable and cardTable.seal
        if type(s) == "string" and s:sub(1, 6) == "Forge_" and not (G.shared_seals and G.shared_seals[s]) then cardTable.seal = nil end
        local e = cardTable and cardTable.edition
        if type(e) == "table" and e.forge and not G.P_CENTERS["e_forge_" .. tostring(e.forge)] then cardTable.edition = nil end
      end)
      return orig(self, cardTable, other_card)
    end
  end
  M.install_tags_blinds()
  M.install_stakes()
  collection_hook("create_UIBox_your_collection_seals", function() return forge_count(G.P_CENTER_POOLS.Seal) > 0 end, M.collection_seals)
  collection_hook("create_UIBox_your_collection_enhancements", function() return forge_count(G.P_CENTER_POOLS.Enhanced) > 0 end, M.collection_enhancements)
  collection_hook("create_UIBox_your_collection_editions", function() return forge_count(G.P_CENTER_POOLS.Edition) > 0 end, M.collection_editions)
  if G and G.P_SEALS then pcall(M.register_all) end
end

return M
end
