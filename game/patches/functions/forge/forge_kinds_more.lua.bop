function M.stake_base(c)
  local f = fields(c)
  for i, k in ipairs(Cat.STAKES) do if k == f.base then return i end end
  return 1
end

function M.stake_choices()
  local out = {}
  for _, c in ipairs(M.live("stake")) do out[#out + 1] = {id = c.id, name = c.name, stake = M.stake_base(c)} end
  return out
end

function M.apply_stake(id)
  local c = Store.get_item(id)
  if not (c and c.kind == "stake" and G.GAME) then return false end
  local g = G.GAME
  local sp, mods = g.starting_params, g.modifiers
  for _, e in ipairs(c.effects or {}) do
    local n = tonumber(e.n) or 1
    local k = e.id
    if k == "blind_scaling" then sp.ante_scaling = (sp.ante_scaling or 1) * (1 + n / 100)
    elseif k == "discards_minus" then sp.discards = math.max(0, sp.discards - math.floor(n))
    elseif k == "hands_minus" then sp.hands = math.max(1, sp.hands - math.floor(n))
    elseif k == "no_interest" then mods.no_interest = true
    elseif k == "small_no_reward" then mods.no_blind_reward = mods.no_blind_reward or {}; mods.no_blind_reward.Small = true
    elseif k == "prices_plus" then g.inflation = (g.inflation or 0) + math.floor(n)
    elseif k == "eternal" then mods.enable_eternals_in_shop = true
    elseif k == "perishable" then mods.enable_perishables_in_shop = true
    elseif k == "rental" then mods.enable_rentals_in_shop = true
    elseif k == "win_ante" then g.win_ante = math.max(1, math.floor(n)) end
  end
  g.forge_stake = c.id
  g.forge_stake_name = c.name
  return true
end

M.FACES = {{"J", "Jack", 0}, {"Q", "Queen", 1}, {"K", "King", 2}}
M.SUIT_PRE = {Hearts = "H", Diamonds = "D", Spades = "S", Clubs = "C"}

function M.collab_key(c) return "collab_forge_" .. c.id end

local function face_file(c, r)
  local f = c.faces and c.faces[r]
  if not f and r == "K" and c.art and c.art.file then f = c.art.file end
  return f
end

local function deck_data(opt)
  M.deck_cache = M.deck_cache or {}
  local name = opt and "8BitDeck_opt2.png" or "8BitDeck.png"
  if M.deck_cache[name] == nil then
    local ok, data = pcall(love.image.newImageData, "resources/textures/1x/" .. name)
    M.deck_cache[name] = ok and data or false
  end
  return M.deck_cache[name] or nil
end

function M.face_image(c, r, suit, opt)
  local f = face_file(c, r)
  if f and love.filesystem.getInfo(f) then
    local ok, data = pcall(love.image.newImageData, f)
    if ok and data and data:getWidth() == 71 and data:getHeight() == 95 then return data end
  end
  local deck = deck_data(opt)
  local card = G.P_CARDS[(M.SUIT_PRE[suit] or "H") .. "_" .. r]
  local out = love.image.newImageData(71, 95)
  if deck and card then out:paste(deck, 0, 0, card.pos.x * 71, card.pos.y * 95, 71, 95) end
  return out
end

local function collab_unlocked()
  local PRM = rawget(_G, "ProfileRewardsManager")
  if not (PRM and type(PRM.is_deck_unlocked) == "function") or M.prm_hooked == PRM then return end
  M.prm_hooked = PRM
  local orig = PRM.is_deck_unlocked
  PRM.is_deck_unlocked = function(id, ...)
    if type(id) == "string" and id:sub(1, 13) == "collab_forge_" then return true end
    return orig(id, ...)
  end
end

function M.register_collabs()
  if not (G and G.COLLABS and G.COLLABS.options and G.ASSET_ATLAS and G.P_CARDS) then return end
  collab_unlocked()
  local want = {}
  for _, c in ipairs(Store.live_items()) do
    if c.kind == "collab" and c.enabled then
      local suit = fields(c).suit
      if G.COLLABS.options[suit] then
        local key = M.collab_key(c)
        want[key] = {c = c, suit = suit}
        for opt = 1, 2 do
          local ok, err = pcall(function()
            local img = love.image.newImageData(213, 95)
            for _, face in ipairs(M.FACES) do img:paste(M.face_image(c, face[1], suit, opt == 2), face[3] * 71, 0, 0, 0, 71, 95) end
            FJ.atlas_from_data(key .. "_" .. opt, img)
          end)
          if not ok then log_once("collab_" .. c.id, "collab art failed: " .. tostring(err)) end
        end
      end
    end
  end
  for suit, list in pairs(G.COLLABS.options) do
    for i = #list, 1, -1 do
      local key = list[i]
      if type(key) == "string" and key:sub(1, 13) == "collab_forge_" and not (want[key] and want[key].suit == suit) then table.remove(list, i) end
    end
  end
  local keys = {}
  for key in pairs(want) do keys[#keys + 1] = key end
  table.sort(keys)
  for _, key in ipairs(keys) do
    local list = G.COLLABS.options[want[key].suit]
    local at = nil
    for i, v in ipairs(list) do if v == key then at = i end end
    if not at then list[#list + 1] = key end
  end
  M.collab_names()
end

function M.collab_names()
  local names = G.localization and G.localization.misc and G.localization.misc.collabs
  if not (names and G.COLLABS and G.COLLABS.options) then return end
  for suit, list in pairs(G.COLLABS.options) do
    names[suit] = names[suit] or {}
    for i, key in ipairs(list) do
      if type(key) == "string" and key:sub(1, 13) == "collab_forge_" then
        local c = Store.get_item(key:sub(14))
        if c then names[suit][tostring(i)] = c.name end
      end
    end
  end
end

local function slot_area(card)
  if card.ability and card.ability.consumeable then return G.consumeables end
  if card.ability and card.ability.set == "Joker" then return G.jokers end
  return nil
end

local function slot_change(card, n)
  local area = slot_area(card)
  if area and area.config then area.config.card_limit = area.config.card_limit + n end
end

