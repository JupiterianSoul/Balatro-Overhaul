local function blind_item(blind)
  local p = blind and blind.config and blind.config.blind
  if not (p and p.forge_kind == "blind") then return nil end
  return Store.get_item(p.forge_id)
end

function M.blind_set(blind)
  local c = blind_item(blind)
  if not c then return end
  local _, flags = blind_effects(c)
  if flags.no_discards then
    blind.discards_sub = G.GAME.current_round.discards_left
    ease_discard(-blind.discards_sub)
  end
  if flags.one_hand then
    blind.hands_sub = G.GAME.round_resets.hands - 1
    ease_hands_played(-blind.hands_sub)
  end
  if flags.hand_size_minus then G.hand:change_size(-math.floor(tonumber(flags.hand_size_minus) or 1)) end
end

function M.blind_restore(blind, disabling)
  local c = blind_item(blind)
  if not c then return end
  local _, flags = blind_effects(c)
  if disabling then
    if flags.no_discards and blind.discards_sub then ease_discard(blind.discards_sub) end
    if flags.one_hand and blind.hands_sub then ease_hands_played(blind.hands_sub) end
    if flags.face_down_first then
      for _, v in ipairs(G.hand.cards) do if v.facing == "back" then v:flip() end end
    end
  end
  if flags.hand_size_minus then
    local n = math.floor(tonumber(flags.hand_size_minus) or 1)
    G.hand:change_size(n)
    if disabling then G.FUNCS.draw_from_deck_to_hand(n) end
  end
end

function M.install_stakes()
  if Game and Game.start_run then
    local orig = Game.start_run
    Game.start_run = function(self, args, ...)
      M.pending_stake = type(args) == "table" and not args.savetext and args.forge_stake or nil
      if M.pending_stake and not FJ.allowed_here() then M.pending_stake = nil end
      local r = orig(self, args, ...)
      M.pending_stake = nil
      return r
    end
  end
  if Back and Back.apply_to_run then
    local orig = Back.apply_to_run
    Back.apply_to_run = function(self, ...)
      local id = M.pending_stake
      M.pending_stake = nil
      if id then
        local ok, err = pcall(M.apply_stake, id)
        if not ok then log_once("stake", "stake failed: " .. tostring(err)) end
      end
      return orig(self, ...)
    end
  end
end

