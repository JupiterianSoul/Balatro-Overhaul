local Store = require("functions/forge/forge_store")
local Cat = require("functions/forge/forge_catalog")
local D = require("functions/forge/forge_doc")
local FJ = require("functions/forge/forge_joker")

local M = {}
M.SEAL_POS = {Gold = {x = 2, y = 0}, Purple = {x = 4, y = 4}, Red = {x = 5, y = 4}, Blue = {x = 6, y = 4}}
M.SEAL_ORDER = 100
M.PACK_SHOWN = {Normal = 3, Jumbo = 5, Mega = 5}
M.PACK_CHOOSE = {Normal = 1, Jumbo = 1, Mega = 2}
M.PACK_SAMPLE = {Arcana = "arcana", Celestial = "celestial", Spectral = "spectral", Standard = "standard", Buffoon = "buffoon", Forge = "buffoon"}

local function log_once(key, msg) FJ.log_once("more_" .. key, msg) end

local function wrap(obj, name, make)
  if obj and type(obj[name]) == "function" then obj[name] = make(obj[name]) end
end

local function fields(c)
  local f = {}
  for k, v in pairs(Cat.default_fields(c.kind) or {}) do f[k] = v end
  for k, v in pairs(c.fields or {}) do f[k] = v end
  return f
end
M.fields = fields

local function sum(c, id)
  local n, found = 0, false
  for _, e in ipairs(c and c.effects or {}) do
    if e.id == id then n = n + (tonumber(e.n) or 1); found = true end
  end
  return n, found
end

local function prod(c, id)
  local n = 1
  for _, e in ipairs(c and c.effects or {}) do if e.id == id then n = n * (tonumber(e.n) or 1) end end
  return n
end

local function badge_col(key, col)
  if type(get_badge_colour) == "function" then pcall(get_badge_colour, key) end
  G.BADGE_COL = G.BADGE_COL or {}
  G.BADGE_COL[key] = col
end

local function lines_of(c)
  local ok, lines = pcall(D.lines, c, FJ.lang())
  if not ok or type(lines) ~= "table" or #lines == 0 then
    log_once("text_" .. tostring(c.id), "text failed for " .. tostring(c.id) .. ": " .. tostring(lines))
    lines = {mod_loc("Does nothing yet")}
  end
  return lines
end

function M.seal_key(c) return "Forge_" .. c.id end
function M.seal_badge(key) return string.lower(key) .. "_seal" end
function M.edition_type(c) return "forge_" .. c.id end

local function seal_item(card)
  local s = card and card.seal
  if type(s) ~= "string" or s:sub(1, 6) ~= "Forge_" then return nil end
  local p = G.P_SEALS and G.P_SEALS[s]
  return p and p.forge_id and Store.get_item(p.forge_id) or nil
end
M.seal_item = seal_item

local function seal_sprite(c)
  local key = M.seal_key(c)
  local atlas, pos
  if c.art and c.art.file then atlas, pos = FJ.load_art(c) end
  if not atlas or atlas == "Joker" then
    atlas = "centers"
    pos = M.SEAL_POS[c.from or ""] or M.SEAL_POS.Red
  end
  G.shared_seals = G.shared_seals or {}
  local spr = G.shared_seals[key]
  if spr then
    spr.atlas = G.ASSET_ATLAS[atlas]
    spr:set_sprite_pos(pos)
  else
    G.shared_seals[key] = Sprite(0, 0, G.CARD_W, G.CARD_H, G.ASSET_ATLAS[atlas], pos)
  end
end

local function register_seal(c, i)
  local key = M.seal_key(c)
  local p = G.P_SEALS[key] or {discovered = true, unlocked = true, alerted = true, set = "Seal", key = key}
  p.order = M.SEAL_ORDER + i
  p.forge_kind = "seal"
  p.forge_id = c.id
  p.forge_on = c.enabled
  G.P_SEALS[key] = p
  local ok, err = pcall(seal_sprite, c)
  if not ok then log_once("seal_spr_" .. c.id, "seal sprite failed: " .. tostring(err)) end
end

function M.edition_table(c)
  local f = fields(c)
  local shader = f.shader or "foil"
  local t = {type = M.edition_type(c), forge = c.id}
  if shader == "negative" then t.negative = true
  elseif shader == "holo" or shader == "polychrome" or shader == "foil" then t[shader] = true end
  if (tonumber(f.chips) or 0) > 0 then t.chips = tonumber(f.chips) end
  if (tonumber(f.mult) or 0) > 0 then t.mult = tonumber(f.mult) end
  if (tonumber(f.xmult) or 1) > 1 then t.x_mult = tonumber(f.xmult) end
  if f.slot and not t.negative then t.forge_slot = true end
  return t
end

function M.edition_center(c, center)
  local f = fields(c)
  center.set = "Edition"
  center.config = {forge = true}
  center.cost = 0
  if not (c.art and (c.art.file or c.art.atlas)) then center.atlas, center.pos = "Joker", {x = 0, y = 0} end
  center.forge_shader = f.shader or "foil"
end

function M.pack_shape(c)
  local f = fields(c)
  local size = M.PACK_SHOWN[f.size] and f.size or "Normal"
  local shown, choose = M.PACK_SHOWN[size], M.PACK_CHOOSE[size]
  if c.mode == "advanced" then
    shown = math.max(1, math.floor(tonumber(f.shown) or shown))
    choose = math.max(1, math.floor(tonumber(f.choose) or choose))
  end
  return math.min(choose, shown), shown, size
end

function M.booster_center(c, center)
  local f = fields(c)
  local pack = M.PACK_SAMPLE[f.pack] and f.pack or "Arcana"
  local choose, shown, size = M.pack_shape(c)
  center.set = "Booster"
  center.kind = pack
  center.forge_only = pack == "Forge" or nil
  center.name = "Forge " .. (pack == "Forge" and "Buffoon" or pack) .. " Pack"
  center.weight = c.mode == "advanced" and math.max(0.05, (tonumber(f.weight) or 4) / 4) or 1
  center.cost = tonumber(f.cost) or 4
  center.config = {extra = shown, choose = choose}
  if not (c.art and (c.art.file or c.art.atlas)) then
    local sample = G.P_CENTERS["p_" .. M.PACK_SAMPLE[pack] .. "_" .. string.lower(size) .. "_1"] or G.P_CENTERS.p_arcana_normal_1
    center.atlas, center.pos = sample.atlas or "Booster", sample.pos
  end
end

function M.register_all()
  if not (G and G.P_SEALS) then return end
  local live = {}
  for i, c in ipairs(Store.live_items()) do
    if c.kind == "seal" then
      register_seal(c, i)
      live[M.seal_key(c)] = true
    end
  end
  for key, p in pairs(G.P_SEALS) do
    if p.forge_kind and not live[key] then p.forge_on = false end
  end
  M.register_tags_blinds()
  M.inject_loc()
  M.sync_pools()
  local ok, err = pcall(M.register_collabs)
  if not ok then log_once("collabs", "collabs failed: " .. tostring(err)) end
end

function M.refresh(id)
  local c = Store.get_item(id)
  if c and c.kind == "seal" and G.P_SEALS then
    for i, it in ipairs(Store.live_items()) do if it.id == id then register_seal(c, i) end end
  end
  if not c and G.P_SEALS then
    for _, p in pairs(G.P_SEALS) do if p.forge_id == id then p.forge_on = false end end
  end
  M.register_tags_blinds()
  M.inject_loc()
  M.sync_pools()
  local ok, err = pcall(M.register_collabs)
  if not ok then log_once("collabs", "collabs failed: " .. tostring(err)) end
end

function M.inject_loc()
  if not (G and G.localization and G.localization.descriptions) then return end
  pcall(M.collab_names)
  local d = G.localization.descriptions
  local labels = G.localization.misc and G.localization.misc.labels
  d.Other = d.Other or {}
  for _, c in ipairs(Store.live_items()) do
    if c.kind == "seal" then
      local badge = M.seal_badge(M.seal_key(c))
      d.Other[badge] = FJ.parsed({name = c.name, text = lines_of(c)})
      if labels then labels[badge] = c.name end
      badge_col(badge, G.C.SECONDARY_SET and G.C.SECONDARY_SET.Spectral or G.C.PURPLE)
    elseif c.kind == "edition" then
      local t = M.edition_type(c)
      if labels then labels[t] = c.name end
      badge_col(t, G.C.DARK_EDITION)
    elseif c.kind == "booster" then
      d.Other["p_forge_" .. c.id] = FJ.parsed({name = c.name, text = lines_of(c)})
    elseif c.kind == "tag" then
      d.Tag = d.Tag or {}
      d.Tag[M.tag_key(c)] = FJ.parsed({name = c.name, text = lines_of(c)})
    elseif c.kind == "blind" then
      d.Blind = d.Blind or {}
      local lines = M.blind_text(c)
      d.Blind[M.blind_key(c)] = FJ.parsed({name = c.name, text = #lines > 0 and lines or {""}})
    end
  end
end

local function pool_toggle(pool, item, want)
  if not pool then return end
  local at
  for i, v in ipairs(pool) do if v == item then at = i end end
  if want and not at then pool[#pool + 1] = item
  elseif not want and at then table.remove(pool, at) end
end

function M.sync_pools()
  if not (G and G.P_SEALS and G.P_CENTER_POOLS) then return end
  local here = FJ.allowed_here()
  for key, p in pairs(G.P_SEALS) do
    if p.forge_kind == "seal" then
      local c = Store.get_item(p.forge_id)
      pool_toggle(G.P_CENTER_POOLS.Seal, p, (c and c.enabled and here and M.seal_key(c) == key) and true or false)
    end
  end
  M.sync_tags_blinds()
end

function M.live(kind)
  local out = {}
  if not FJ.allowed_here() then return out end
  for _, c in ipairs(Store.live_items()) do
    if c.kind == kind and c.enabled then out[#out + 1] = c end
  end
  table.sort(out, function(a, b) return a.id < b.id end)
  return out
end

local function forge_edition_poll(key, mod, no_neg)
  local live = {}
  for _, c in ipairs(M.live("edition")) do
    local f = fields(c)
    if not (no_neg and (f.shader == "negative" or f.slot)) then live[#live + 1] = c end
  end
  if #live == 0 then return nil end
  local total, weights = 0, {}
  for i, c in ipairs(live) do
    local f = fields(c)
    weights[i] = (c.mode == "advanced" and tonumber(f.weight) or 5) * 0.002 * ((G.GAME and G.GAME.edition_rate) or 1) * (mod or 1)
    total = total + weights[i]
  end
  local roll = pseudorandom(pseudoseed("forge_ed" .. tostring(key or "")))
  if roll > total then return nil end
  local acc = 0
  for i, c in ipairs(live) do
    acc = acc + weights[i]
    if roll <= acc and G.P_CENTERS["e_forge_" .. c.id] then return {forge = c.id} end
  end
  return nil
end

M.TAG_CTX = {{"free_joker", "store_joker_create"}, {"coupon", "shop_final_pass"}, {"free_pack", "new_blind_choice"}, {"double", "tag_add"}, {"hand_size", "round_start_bonus"}, {"free_rerolls", "shop_start"}}
M.TAG_WHEN = {now = "immediate", shop = "shop_start", round = "round_start_bonus"}
M.MEGA = {Arcana = "p_arcana_mega_1", Celestial = "p_celestial_mega_1", Spectral = "p_spectral_mega_1", Standard = "p_standard_mega_1", Buffoon = "p_buffoon_mega_1"}
M.RARITY_ROLL = {[1] = 0, [2] = 0.8, [3] = 0.99}
M.TAG_ORDER = 100
M.BLIND_ORDER = 100

function M.tag_key(c) return "tag_forge_" .. c.id end
function M.blind_key(c) return "bl_forge_" .. c.id end

function M.tag_type(c)
  local has = {}
  for _, e in ipairs(c.effects or {}) do has[e.id] = true end
  for _, pair in ipairs(M.TAG_CTX) do if has[pair[1]] then return pair[2] end end
  return M.TAG_WHEN[fields(c).when] or "immediate"
end

local function register_tag(c, i)
  local key = M.tag_key(c)
  local p = G.P_TAGS[key] or {set = "Tag", discovered = true, unlocked = true, alerted = true, key = key}
  local a = c.art or {}
  local from = c.from and G.P_TAGS[c.from]
  p.name = "Forge Tag " .. c.id
  p.order = M.TAG_ORDER + i
  p.config = {type = M.tag_type(c)}
  p.pos = (a.atlas == "tags" and {x = a.x or 0, y = a.y or 0}) or (from and from.pos) or G.P_TAGS.tag_double.pos
  p.forge_kind = "tag"
  p.forge_id = c.id
  p.forge_copy = sum(c, "double") > 0 or nil
  p.min_ante = nil
  G.P_TAGS[key] = p
end

local function blind_effects(c)
  local debuff, flags = {}, {}
  for _, e in ipairs(c.effects or {}) do
    local n = tonumber(e.n) or 1
    if e.id == "debuff_suit" then debuff.suit = e.v or "Clubs"
    elseif e.id == "debuff_face" then debuff.is_face = "face"
    elseif e.id == "must_play" then debuff.h_size_ge = math.max(1, math.floor(n))
    else flags[e.id] = e.v or n end
  end
  return debuff, flags
end

local function register_blind(c, i)
  local key = M.blind_key(c)
  local f = fields(c)
  local p = G.P_BLINDS[key] or {set = "Blind", discovered = true, unlocked = true, alerted = true, key = key, defeated = false, demo = false, vars = {}}
  local a = c.art or {}
  local from = c.from and G.P_BLINDS[c.from]
  local debuff = blind_effects(c)
  p.name = "Forge Blind " .. c.id
  p.order = M.BLIND_ORDER + i
  p.dollars = math.floor(tonumber(f.reward) or 5)
  p.mult = tonumber(f.size) or 2
  p.debuff = debuff
  p.pos = (a.atlas == "blind_chips" and {x = 0, y = a.y or 0}) or (from and from.pos) or G.P_BLINDS.bl_wall.pos
  p.atlas = nil
  local adv = c.mode == "advanced"
  p.boss = {min = adv and math.max(1, math.floor(tonumber(f.min_ante) or 1)) or 1, max = 10, showdown = adv and f.showdown and true or nil}
  p.boss_colour = (adv and G.C[f.colour or ""]) or (from and from.boss_colour) or G.C[f.colour or ""] or G.C.RED
  p.forge_kind = "blind"
  p.forge_id = c.id
  G.P_BLINDS[key] = p
end

function M.register_tags_blinds()
  if not (G and G.P_TAGS and G.P_BLINDS) then return end
  local live = {}
  for i, c in ipairs(Store.live_items()) do
    if c.kind == "tag" then register_tag(c, i); live[M.tag_key(c)] = true end
    if c.kind == "blind" then register_blind(c, i); live[M.blind_key(c)] = true end
  end
  for _, t in ipairs({G.P_TAGS, G.P_BLINDS}) do
    for key, p in pairs(t) do if p.forge_kind and not live[key] then p.forge_gone = true else p.forge_gone = nil end end
  end
end

function M.blind_text(c)
  local own = type(c.text) == "table" and type(c.text[FJ.lang()]) == "table" and #c.text[FJ.lang()] > 0
  local lines = lines_of(c)
  if not own then
    local out = {}
    for i = 2, #lines do out[#out + 1] = lines[i] end
    lines = out
  end
  if #lines > 2 then
    local best, cut = nil, 1
    for k = 1, #lines - 1 do
      local a = table.concat(lines, ", ", 1, k)
      local b = table.concat(lines, ", ", k + 1, #lines)
      local w = math.max(#a, #b)
      if not best or w < best then best, cut = w, k end
    end
    lines = {table.concat(lines, ", ", 1, cut), table.concat(lines, ", ", cut + 1, #lines)}
  end
  return lines
end

function M.sync_tags_blinds()
  if not (G and G.P_TAGS and G.P_BLINDS and G.P_CENTER_POOLS) then return end
  local here = FJ.allowed_here()
  for _, p in pairs(G.P_TAGS) do
    if p.forge_kind == "tag" then
      local c = Store.get_item(p.forge_id)
      pool_toggle(G.P_CENTER_POOLS.Tag, p, (c and c.enabled and here and not p.forge_gone) and true or false)
    end
  end
  for key, p in pairs(G.P_BLINDS) do
    if p.forge_kind == "blind" then
      local c = Store.get_item(p.forge_id)
      p.in_pool = (c and c.enabled and here and not p.forge_gone) and true or false
      p.no_collection = not (c and c.enabled and not p.forge_gone) or nil
      if G.GAME and G.GAME.bosses_used then G.GAME.bosses_used[key] = G.GAME.bosses_used[key] or 0 end
    end
  end
end

local function tag_joker(rarity, area)
  local r = tonumber(rarity) or 1
  return create_card("Joker", area, r == 4, M.RARITY_ROLL[r], nil, nil, nil, "forge_tag")
end

local function open_pack(key)
  local center = G.P_CENTERS[key]
  if not (center and G.play) then return end
  local card = Card(G.play.T.x + G.play.T.w / 2 - G.CARD_W * 1.27 / 2, G.play.T.y + G.play.T.h / 2 - G.CARD_H * 1.27 / 2, G.CARD_W * 1.27, G.CARD_H * 1.27, G.P_CARDS.empty, center, {bypass_discovery_center = true, bypass_discovery_ui = true})
  card.cost = 0
  card.from_tag = true
