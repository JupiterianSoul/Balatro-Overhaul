local function card_at(area, center, front)
  return Card(area.T.x + area.T.w / 2, area.T.y, G.CARD_W, G.CARD_H, front or G.P_CARDS.empty, center)
end

function M.collection_seals(exit)
  return M.paged{items = G.P_CENTER_POOLS.Seal, cols = 4, rows = 2, back = exit, make = function(v, area)
    local card = card_at(area, G.P_CENTERS.c_base)
    if G.shared_seals and G.shared_seals[v.key] then card:set_seal(v.key, true) end
    return card
  end}
end

function M.collection_enhancements(exit)
  return M.paged{items = G.P_CENTER_POOLS.Enhanced, cols = 4, rows = 2, back = exit, make = function(v, area) return card_at(area, v) end}
end

function M.collection_editions()
  local items = {}
  for _, k in ipairs({"e_base", "e_foil", "e_holo", "e_polychrome", "e_negative"}) do items[#items + 1] = G.P_CENTERS[k] end
  for _, v in ipairs(G.P_CENTER_POOLS.Edition) do if v.forge_kind == "edition" then items[#items + 1] = v end end
  return M.paged{items = items, cols = 5, rows = 2, make = function(v, area)
    local card = card_at(area, v)
    if v.forge_kind == "edition" then card:set_edition({forge = v.forge_id}, true, true)
    elseif v.discovered and v.key ~= "e_base" then card:set_edition({[v.key:sub(3)] = true}, true, true) end
    return card
  end}
end

local function forge_count(pool)
  local n = 0
  for _, v in ipairs(pool or {}) do if v.forge_kind then n = n + 1 end end
  return n
end

local function collection_hook(name, test, build)
  if type(_G[name]) ~= "function" then return end
  local orig = _G[name]
  _G[name] = function(...)
    if G.P_CENTER_POOLS and test() then
      local ok, r = pcall(build, ...)
      if ok and r then return r end
      log_once("coll_" .. name, "collection failed: " .. tostring(r))
    end
    return orig(...)
  end
end

function M.install_hooks()
  if M.hooked then return end
  M.hooked = true
  wrap(Card, "calculate_seal", function(orig) return function(self, context)
    local c = not self.debuff and seal_item(self)
    if not c then return orig(self, context) end
