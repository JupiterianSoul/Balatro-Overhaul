      end
      if mode == "money" and add ~= 0 then
        G.GAME.dollar_buffer = (G.GAME.dollar_buffer or 0) + add
        G.E_MANAGER:add_event(Event({func = function() G.GAME.dollar_buffer = 0; return true end}))
      end
      return (r or 0) + add
    end end)
  end
  card_hook("get_chip_bonus", "chips")
  card_hook("get_chip_mult", "mult")
  card_hook("get_chip_x_mult", "xmult", "x")
  card_hook("get_p_dollars", "money", "money")
  wrap(Blind, "set_blind", function(orig) return function(self, blind, reset, silent, ...)
    local r = orig(self, blind, reset, silent, ...)
    if blind and not reset and G.GAME and G.GAME.round_resets then Run.fire("blind_selected") end
    return r
  end end)
  if type(end_round) == "function" then
    local orig = end_round
    end_round = function(...)
      Run.fire("round_end")
      return orig(...)
    end
  end
  if type(ease_ante) == "function" then
    local orig = ease_ante
    ease_ante = function(mod, ...)
      local r = orig(mod, ...)
      if (tonumber(mod) or 0) > 0 then Run.fire("ante_up") end
      return r
    end
  end
  if type(get_current_pool) == "function" then
    local orig = get_current_pool
    get_current_pool = function(_type, ...)
      local pool, key = orig(_type, ...)
      if _type == "Voucher" and type(pool) == "table" then
        local ok, err = pcall(Run.voucher_pool, pool)
        if not ok then log_once("pool", "voucher pool failed: " .. tostring(err)) end
      elseif type(pool) == "table" and NEED_TYPES[_type] then
        local ok, err = pcall(Run.need_pool, _type, pool)
        if not ok then log_once("need_pool", "pool rule failed: " .. tostring(err)) end
      end
      return pool, key
    end
  end
  if type(get_pack) == "function" then
    local orig = get_pack
    get_pack = function(...)
      local ok, added = pcall(Run.need_bans)
      local r = {orig(...)}
      if ok and added then for _, k in ipairs(added) do G.GAME.banned_keys[k] = nil end end
      return unpack(r)
    end
  end
  Run.wrap_funcs()
end

