local function level(hand, n)
  local g = game()
  if hand == "all" then
    for k in pairs(g.hands) do level_up_hand(nil, k, true, n) end
    return
  end
  if hand == "random" then
    local list = {}
    for k, v in pairs(g.hands) do if v.visible then list[#list + 1] = k end end
    table.sort(list)
    hand = pseudorandom_element(list, pseudoseed("forge_run_level"))
  end
  if hand and g.hands[hand] then level_up_hand(nil, hand, true, n) end
end
Run.level = level

local function random_cards(n)
  local pool, out = {}, {}
  for _, v in ipairs(G.playing_cards or {}) do pool[#pool + 1] = v end
  for _ = 1, math.min(#pool, n) do
    local v, at = pseudorandom_element(pool, pseudoseed("forge_run_cards"))
    out[#out + 1] = v
    table.remove(pool, at)
  end
  return out
end

