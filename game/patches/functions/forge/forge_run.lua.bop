    local left = g.current_round and g.current_round.hands_left or 0
    ease_hands_played(math.max(whole, -left))
  elseif id == "discards_round" then
    local left = g.current_round and g.current_round.discards_left or 0
    ease_discard(math.max(whole, -left))
  elseif id == "disable_boss" then
    local b = g.blind
    if b and b.boss and not b.disabled and b.disable then b:disable() end
  end
end

local function juice(s)
  if s.deck and G.deck and G.deck.cards and G.deck.cards[1] then G.deck.cards[1]:juice_up(0.3, 0.3) end
end

function Run.fire(when, ctx)
  if Run.firing or not game() then return end
  if when == "now" then return end
  Run.firing = true
  local ok, err = pcall(function()
    ctx = ctx or Run.ctx()
    each(when, function(s, i, e)
      if Run.SCORE[e.id] then return end
      if when == "card_scored" then return end
      if Run.pass(e, ctx, s.key .. "_" .. i) then
        for _ = 1, s.times do Run.apply(e, s) end
        juice(s)
      end
    end)
  end)
  Run.firing = false
  if not ok then log_once("fire_" .. tostring(when), "run effect failed: " .. tostring(err)) end
end

function Run.apply_now(c, src)
  for i, e in ipairs(c.effects or {}) do
    local spec = Cat.effect(c.kind, e.id)
    if spec and spec.run and (e.when or "now") == "now" and not (src and src.skip and src.skip[e.id] and not (e.only and #e.only > 0)) then
      local ok, err = pcall(function()
        if Run.pass(e, Run.ctx(), (src and src.key or c.id) .. "_now_" .. i) then Run.apply(e, src) end
      end)
      if not ok then log_once("now_" .. c.id .. "_" .. tostring(e.id), "effect " .. tostring(e.id) .. " failed: " .. tostring(err)) end
    end
  end
end

function Run.score(chips, mult)
  local changed = false
  local ctx = Run.ctx()
  each("hand_played", function(s, i, e)
    if not Run.SCORE[e.id] then return end
    if not Run.pass(e, ctx, s.key .. "_" .. i) then return end
    local n = tonumber(e.n) or 0
    for _ = 1, s.times do
      if e.id == "chips" then chips = chips + n
      elseif e.id == "mult" then mult = mult + n
      else mult = mult * n end
    end
    changed = true
  end)
  return math.max(0, chips), math.max(0, mult), changed
end

function Run.previewing()
  local P = rawget(_G, "PREVIEW")
  return type(P) == "table" and P._in_sandbox == true
end

function Run.scoring()
  return G.STATE == G.STATES.HAND_PLAYED or Run.previewing()
end

function Run.card_bonus(card, id)
  if not (G.play and card.area == G.play and not card.debuff and Run.scoring()) then return nil end
  local total = nil
  local ctx = Run.ctx(card)
  each("card_scored", function(s, i, e)
    if e.id ~= id then return end
    if not Run.pass(e, ctx, s.key .. "_" .. i) then return end
    local n = tonumber(e.n) or 0
    for _ = 1, s.times do
      if id == "xmult" then total = (total or 1) * n else total = (total or 0) + n end
    end
  end)
  return total
end

function Run.voucher_ok(c, key, f)
  local g = game()
  if not g then return false end
  if (tonumber(f.min_ante) or 1) > (g.round_resets and g.round_resets.ante or 1) then return false end
  local need = f.requires
  if need and need ~= "none" and G.P_CENTERS[need] and not (g.used_vouchers or {})[need] then return false end
  local max = math.max(1, math.floor(tonumber(f.max_buys) or 1))
  local buys = tonumber(g.forge_buys and g.forge_buys[key]) or ((g.used_vouchers or {})[key] and 1 or 0)
  if buys >= max then return false end
  for _, card in ipairs(G.shop_vouchers and G.shop_vouchers.cards or {}) do
    if card.config and card.config.center and card.config.center.key == key then return false end
  end
  if g.banned_keys and g.banned_keys[key] then return false end
  return true
end

function Run.voucher_pool(pool)
  for _, center in ipairs(G.P_CENTER_POOLS.Voucher or {}) do
    if center.forge_kind == "voucher" and center.forge_on then
      local c = center_item(center)
      if c then
        local key = center.key
        local f = fields_of(c)
        local at = nil
        for i, k in ipairs(pool) do if k == key then at = i end end
        local ok = Run.voucher_ok(c, key, f)
        local w = math.max(0, math.floor(tonumber(f.weight) or 1))
        if at and (not ok or w == 0) then pool[at] = "UNAVAILABLE"; at = nil end
        if ok and w > 0 then
          local add = at and (w - 1) or w
          for _ = 1, math.min(add, 1000) do pool[#pool + 1] = key end
        end
      end
    end
  end
  local real = false
  for _, k in ipairs(pool) do if k ~= "UNAVAILABLE" then real = true end end
  if not real then pool[#pool + 1] = "v_blank" end
end

local NEED_TYPES = {Joker = "j_joker", Tarot = "c_strength", Planet = "c_pluto", Spectral = "c_incantation", Tarot_Planet = "c_strength", Consumeables = "c_strength"}

function Run.need_of(center)
  if not (center and center.forge_id and not center.forge_lost) then return nil end
  local need
  if center.forge_kind then
    local c = center_item(center)
    need = c and fields_of(c).requires
  elseif center.forge then
    local c = Store.get(center.forge_id)
    need = c and c.requires
  end
  if not need or need == "none" or need == center.key then return nil end
  local v = G.P_CENTERS[need]
  if not v or v.forge_on == false then return nil end
  return need
end

function Run.need_met(center)
  local need = Run.need_of(center)
  if not need then return true end
  local g = game()
  return (g and g.used_vouchers or {})[need] and true or false
end

function Run.need_pool(_type, pool)
  local fallback = NEED_TYPES[_type]
  if not fallback then return end
  local real = false
  for i, k in ipairs(pool) do
    if k ~= "UNAVAILABLE" then
      local center = G.P_CENTERS[k]
      if center and not Run.need_met(center) then pool[i] = "UNAVAILABLE" else real = true end
    end
  end
  if not real then pool[#pool + 1] = fallback end
end

function Run.need_bans()
  local g = game()
  if not (g and g.banned_keys) then return nil end
  local added = nil
  for _, center in ipairs(G.P_CENTER_POOLS.Booster or {}) do
    if center.forge_kind and not g.banned_keys[center.key] and not Run.need_met(center) then
      g.banned_keys[center.key] = true
      added = added or {}
      added[#added + 1] = center.key
    end
  end
  return added
end

function Run.count_buy(key)
  local g = game()
  if not g then return 1 end
  g.forge_buys = g.forge_buys or {}
  g.forge_buys[key] = (tonumber(g.forge_buys[key]) or 0) + 1
  return g.forge_buys[key]
end

function Run.fix_requires()
  for _, center in ipairs(G.P_CENTER_POOLS and G.P_CENTER_POOLS.Voucher or {}) do
    if center.forge_kind == "voucher" then
      local c = center_item(center)
      local need = c and fields_of(c).requires
      if need and need ~= "none" and need ~= center.key and G.P_CENTERS[need] and (G.P_CENTERS[need].forge_on ~= false) then center.requires = {need}
      else center.requires = nil end
    end
  end
end

local function wrap(obj, name, make)
  if obj and type(obj[name]) == "function" then obj[name] = make(obj[name]) end
end

function Run.wrap_rules()
  local RR = rawget(_G, "RunRules")
  if not RR or RR.forge_wrapped or type(RR.active) ~= "function" then return end
  RR.forge_wrapped = true
  local orig = RR.active
  RR.active = function(key, ...)
    local v = orig(key, ...)
    local base = Run.BASE[key]
    if base then
      local add = Run.bonus(key)
      if add ~= 0 then return math.max(0, (tonumber(v) or base) + add) end
    end
    return v
  end
end

