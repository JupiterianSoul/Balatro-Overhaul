r 3 617 %20%20%20%20%20%20 -
l 3
        local n = Run.bonus("free_rerolls")
        if n ~= 0 and G.GAME.current_round then
          G.GAME.current_round.free_rerolls = math.max(0, (G.GAME.current_round.free_rerolls or 0) + n)
r 3 603 %20%20%20%20%20%20%20%20%20%20 -
l 106
        end
        Run.fire("shop_enter")
        return true
      end}))
      return r
    end
  end
  if F.reroll_shop then
    local orig = F.reroll_shop
    F.reroll_shop = function(e, ...)
      local r = orig(e, ...)
      Run.fire("reroll")
      return r
    end
  end
  if F.discard_cards_from_highlighted then
    local orig = F.discard_cards_from_highlighted
    F.discard_cards_from_highlighted = function(e, hook, ...)
      if not hook and G.hand and #G.hand.highlighted > 0 then Run.fire("discard") end
      return orig(e, hook, ...)
    end
  end
end

