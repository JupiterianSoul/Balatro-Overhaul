local Store = require("functions/forge/forge_store")
local Cat = require("functions/forge/forge_catalog")
local R = require("functions/forge/forge_rules")
local FJ = require("functions/forge/forge_joker")

local Run = {}
ForgeRun = Run

Run.RATE = {Joker = "joker_rate", Tarot = "tarot_rate", Planet = "planet_rate", Spectral = "spectral_rate", Playing = "playing_card_rate"}
Run.RARE = {[1] = "rarity_common", [2] = "rarity_uncommon", [3] = "rarity_rare"}
Run.BASE = {pack_slots = 2, voucher_slots = 1, rarity_common = 70, rarity_uncommon = 25, rarity_rare = 5}
Run.SCORE = {chips = true, mult = true, xmult = true}

local function log_once(key, msg) FJ.log_once("run_" .. key, msg) end

local function game() return G and G.GAME end

function Run.bonus(key)
  local g = game()
  local b = g and g.forge_bonus
  return b and tonumber(b[key]) or 0
end

local function add_bonus(key, n)
  local g = game()
  g.forge_bonus = g.forge_bonus or {}
  g.forge_bonus[key] = (tonumber(g.forge_bonus[key]) or 0) + n
end

local function fields_of(c)
  local f = Cat.default_fields(c.kind)
  for k, v in pairs(c.fields or {}) do f[k] = v end
  return f
end
Run.fields = fields_of

local function center_item(center)
  if not (center and center.forge_id and not center.forge_lost) then return nil end
  return Store.get_item(center.forge_id)
end

function Run.sources()
  local out = {}
  local g = game()
  if not g then return out end
  local keys = {}
  for key, on in pairs(g.used_vouchers or {}) do
    if on and type(key) == "string" and key:sub(1, 8) == "v_forge_" then keys[#keys + 1] = key end
  end
  table.sort(keys)
  for _, key in ipairs(keys) do
    local c = center_item(G.P_CENTERS[key])
    if c and c.kind == "voucher" then out[#out + 1] = {c = c, key = key, times = math.max(1, math.floor(tonumber(g.forge_buys and g.forge_buys[key]) or 1))} end
  end
  local back = g.selected_back and g.selected_back.effect and g.selected_back.effect.center
  if back and back.forge_kind == "deck" then
    local c = center_item(back)
    if c then out[#out + 1] = {c = c, key = back.key, times = 1, deck = true} end
  end
  if g.forge_stake then
    local c = Store.get_item(g.forge_stake)
    if c and c.kind == "stake" then out[#out + 1] = {c = c, key = "stake_forge_" .. c.id, times = 1} end
  end
  local b = g.blind
  local p = b and b.config and b.config.blind
  if p and p.forge_kind == "blind" and not b.disabled then
    local c = Store.get_item(p.forge_id)
    if c then out[#out + 1] = {c = c, key = p.key or ("bl_forge_" .. c.id), times = 1, blind = true} end
  end
  return out
end

function Run.ctx(other)
  return {scoring_name = Run.hand_name, poker_hands = Run.poker_hands, full_hand = G.play and G.play.cards, other = other}
end

function Run.pass(e, ctx, key)
  local every = nil
  for _, o in ipairs(e.only or {}) do
    if o.id == "every" then every = o
    else
      local ok = R.check(o, ctx, nil, ctx.other, "forge_run_" .. key)
      if o.neg then ok = not ok end
      if not ok then return false end
    end
  end
  if every then
    local g = game()
    g.forge_count = g.forge_count or {}
    g.forge_count[key] = (tonumber(g.forge_count[key]) or 0) + 1
    if g.forge_count[key] % math.max(1, math.floor(tonumber(every.n) or 1)) ~= 0 then return false end
  end
  return true
end

local function each(when, fn)
  for _, s in ipairs(Run.sources()) do
    for i, e in ipairs(s.c.effects or {}) do
      local spec = Cat.effect(s.c.kind, e.id)
      if spec and spec.run and (e.when or "now") == when then fn(s, i, e, spec) end
    end
  end
end
Run.each = each

