local R = {}

R.WHEN = {"card_scored", "card_held", "hand_played", "before", "after", "discard", "first_hand", "blind_selected", "round_end", "blind_skipped", "reroll", "shop_end", "card_sold", "self_sold", "pack_opened", "consumable_used", "card_bought", "pack_skipped", "cards_destroyed", "card_added"}
