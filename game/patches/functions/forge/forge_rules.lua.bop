R.OLD_HI = {chips = 300, mult = 50, xmult = 5, money = 20, retrigger = 3, gain_chips = 50, gain_mult = 10, gain_xmult = 1, hand = 3, discard = 3, chance = 20, money_cond = 100, hands_left = 5, discards_left = 5, ante = 8, jokers = 5, var_add = 10, var_set = 100, var_chips = 50, var_mult = 10, var = 100, var_start = 100}
