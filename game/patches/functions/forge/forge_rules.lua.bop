R.NEW_IDS = {card_bought = true, pack_skipped = true, cards_destroyed = true, card_added = true, blind = true, deck_cards = true, held_cards = true, consumables = true, hand_level = true, round = true, destroy_card = true, add_card = true, sell_value = true}

R.warned = {}
R.errors = 0

local function log_once(key, msg)
  if R.warned[key] then return end
  R.warned[key] = true
  R.errors = R.errors + 1
  print("[FORGE] " .. tostring(msg))
end

local function num_key(id)
  if id == "money" then return "money_cond" end
  return id
end

function R.num(kind, v, is_cond)
  local spec = R.NUM[is_cond and num_key(kind) or kind]
  if not spec then return tonumber(v) or 0 end
  v = tonumber(v) or spec.def
  if v ~= v then v = spec.def end
  if v < spec.lo then v = spec.lo end
  if v > spec.hi then v = spec.hi end
  if spec.step % 1 == 0 and spec.lo % 1 == 0 then return math.floor(v + 0.5) end
  return math.floor(v * 100 + 0.5) / 100
end

local function member(list, v)
  for _, x in ipairs(list) do if x == v then return true end end
  return false
end

function R.allowed_give(when, give)
  if give == "var_chips" then give = "chips" elseif give == "var_mult" then give = "mult" end
  if give == "chips" then return when == "card_scored" or when == "hand_played" end
  if give == "mult" or give == "xmult" then return when == "card_scored" or when == "card_held" or when == "hand_played" end
  if give == "retrigger" then return when == "card_scored" or when == "card_held" end
  if give == "level_up" then return when == "before" or when == "hand_played" or when == "after" end
  if give == "change" then return when == "card_scored" end
  if give == "hand" or give == "discard" then return R.ROUND_WHEN[when] or false end
  if give == "destroy_card" or give == "copy_card" then return when == "card_scored" or when == "discard" end
  if give == "perma_chips" then return when == "card_scored" end
  if give == "disable_boss" then return R.ROUND_WHEN[when] or false end
  return member(R.GIVE, give)
end

function R.allowed_only(when, only)
  if R.CARD_ONLY[only] then return R.CARD_WHEN[when] or false end
  if only == "hand" or only == "cards_played" then return R.HAND_WHEN[when] or when == "discard" end
  if only == "first_hand" or only == "last_hand" or only == "hands_left" or only == "discards_left" then return R.ROUND_WHEN[when] or when == "round_end" end
  if only == "hand_level" then return R.HAND_WHEN[when] or false end
  return member(R.ONLY, only)
end

function R.default_only(id)
  if id == "hand" then return {id = "hand", v = "Pair", mode = "contains"} end
  if id == "suit" then return {id = "suit", v = "Hearts"} end
  if id == "rank" then return {id = "rank", v = "face"} end
  if id == "enhancement" then return {id = "enhancement", v = "m_gold"} end
  if id == "seal" then return {id = "seal", v = "Red"} end
  if id == "edition" then return {id = "edition", v = "foil"} end
  if id == "chance" then return {id = "chance", n = R.NUM.chance.def} end
  if id == "var" then return {id = "var", var = 1, op = "at_least", n = R.NUM.var.def} end
  if id == "blind" then return {id = "blind", v = "Small"} end
  if id == "money" then return {id = "money", op = "at_least", n = R.NUM.money_cond.def} end
  if R.NUM[id] then return {id = id, op = "at_least", n = R.NUM[id].def} end
  return {id = id}
end

function R.default_give(id)
  if id == "create" then return {id = "create", v = "Tarot"} end
  if id == "change" then return {id = "change", what = "enhancement", v = "m_gold"} end
  if id == "add_card" then return {id = "add_card", v = "m_stone"} end
  if id == "tag" then return {id = "tag", v = "tag_double"} end
  if id == "level_up" or id == "destroy_self" or id == "destroy_card" or id == "copy_card" or id == "disable_boss" or id == "destroy_joker" then return {id = id} end
  if R.VAR_GIVE[id] then return {id = id, var = 1, n = R.NUM[id].def} end
  return {id = id, n = R.NUM[id] and R.NUM[id].def or 1}
end

function R.change_values(what)
  if what == "suit" then return {"Hearts", "Diamonds", "Spades", "Clubs"} end
  if what == "rank" then return {14, 13, 12, 11, 10, 9, 8, 7, 6, 5, 4, 3, 2} end
  if what == "seal" then return R.SEALS end
  if what == "edition" then return R.EDITIONS end
  return R.ENHANCEMENTS
end

local function var_index(v)
  v = math.floor(tonumber(v) or 1)
  if v < 1 then v = 1 end
  if v > R.MAX_VARS then v = R.MAX_VARS end
  return v
end

function R.clean_name(str)
  str = tostring(str or ""):gsub("[%c{}#%%\\]", ""):gsub("^%s+", ""):gsub("%s+$", "")
  if #str > R.VAR_NAME then
    str = str:sub(1, R.VAR_NAME)
    while #str > 0 and str:byte(#str) >= 128 do
      local b = str:byte(#str)
      str = str:sub(1, -2)
      if b >= 192 then break end
    end
  end
  return str
end

function R.clean_vars(list)
  local out = {}
  for _, v in ipairs(type(list) == "table" and list or {}) do
    if type(v) == "table" and #out < R.MAX_VARS then
      local name = R.clean_name(v.name)
      if name == "" then name = "V" .. (#out + 1) end
      out[#out + 1] = {name = name, start = R.num("var_start", v.start)}
    end
  end
  return out
end

function R.clean_rule(r)
  if type(r) ~= "table" or not member(R.WHEN, r.when) then return nil end
  local out = {when = r.when, only = {}, give = {}}
  for _, o in ipairs(type(r.only) == "table" and r.only or {}) do
    if type(o) == "table" and member(R.ONLY, o.id) and R.allowed_only(r.when, o.id) then
      local c = {id = o.id, v = o.v, mode = o.mode, op = o.op, n = o.n, neg = o.neg == true and o.id ~= "chance" or nil, var = o.id == "var" and var_index(o.var) or nil}
      if c.n ~= nil then c.n = R.num(o.id, c.n, true) end
      if c.op and not member(R.OPS, c.op) then c.op = "at_least" end
      if c.id == "blind" and not member(R.BLINDS, c.v) then c.v = "Small" end
      out.only[#out.only + 1] = c
    end
  end
  for _, g in ipairs(type(r.give) == "table" and r.give or {}) do
    if type(g) == "table" and member(R.GIVE, g.id) and R.allowed_give(r.when, g.id) then
      local e = {id = g.id, v = g.v, what = g.what, n = g.n, var = R.VAR_GIVE[g.id] and var_index(g.var) or nil}
      if R.NUM[g.id] then e.n = R.num(g.id, g.n) end
      if e.id == "add_card" and not member(R.ADD_CARDS, e.v) then e.v = "c_base" end
      if e.id == "tag" and not member(R.TAGS, e.v) then e.v = "tag_double" end
      out.give[#out.give + 1] = e
    end
  end
  if #out.only > 0 and type(r.alt) == "table" then
    for _, g in ipairs(r.alt) do
      if type(g) == "table" and g.id ~= "change" and member(R.GIVE, g.id) and R.allowed_give(r.when, g.id) and #(out.alt or {}) < 4 then
        local e = {id = g.id, v = g.v, what = g.what, n = g.n, var = R.VAR_GIVE[g.id] and var_index(g.var) or nil}
        if R.NUM[g.id] then e.n = R.num(g.id, g.n) end
        if e.id == "add_card" and not member(R.ADD_CARDS, e.v) then e.v = "c_base" end
        if e.id == "tag" and not member(R.TAGS, e.v) then e.v = "tag_double" end
        out.alt = out.alt or {}
        out.alt[#out.alt + 1] = e
      end
    end
  end
  return out
end

function R.clean_rules(list)
  local out = {}
  for _, r in ipairs(type(list) == "table" and list or {}) do
    local c = R.clean_rule(r)
    if c then out[#out + 1] = c end
    if #out >= R.MAX_RULES then break end
  end
  return out
end

