local function compare(op, a, b)
  a, b = tonumber(a) or 0, tonumber(b) or 0
  if op == "at_most" then return a <= b end
  if op == "exactly" then return a == b end
  return a >= b
end

local function card_rank_ok(card, v)
  local id = card:get_id()
  if v == "face" then return card:is_face() end
  if v == "number" then return id >= 2 and id <= 10 end
  if v == "even" then return id >= 2 and id <= 10 and id % 2 == 0 end
  if v == "odd" then return id == 14 or (id >= 3 and id <= 9 and id % 2 == 1) end
  return id == tonumber(v)
end

local function card_suit_ok(card, v)
  if v == "red" then return card:is_suit("Hearts") or card:is_suit("Diamonds") end
  if v == "black" then return card:is_suit("Spades") or card:is_suit("Clubs") end
  return card:is_suit(v)
end

local function round() return G.GAME and G.GAME.current_round or {} end

local function count(area) return area and area.cards and #area.cards or 0 end

local function blind_type()
  local b = G.GAME and G.GAME.blind
  if not b then return nil end
  if b.boss then return "Boss" end
  if type(b.get_type) == "function" then
    local ok, t = pcall(b.get_type, b)
    if ok and t then return t end
  end
  if b.name == "Big Blind" then return "Big" end
  if b.name == "Small Blind" then return "Small" end
  return nil
end
R.blind_type = blind_type

local function hand_level(context)
  local name = context.scoring_name
  local h = name and G.GAME and G.GAME.hands and G.GAME.hands[name]
  return h and tonumber(h.level) or 0
end

local function var_val(card, i)
  local x = card and card.ability and card.ability.extra
  local vars = type(x) == "table" and type(x.vars) == "table" and x.vars or {}
  return tonumber(vars[i or 1]) or 0
end
R.var_val = var_val

function R.vars_state(card, defs)
  local x = R.state(card)
  x.vars = type(x.vars) == "table" and x.vars or {}
  for i, d in ipairs(type(defs) == "table" and defs or {}) do
    if tonumber(x.vars[i]) == nil then x.vars[i] = tonumber(d.start) or 0 end
  end
  return x.vars
end

function R.check(o, context, card, other, seed)
  local id = o.id
  if R.CARD_ONLY[id] then
    if not other then return false end
    if id == "suit" then return card_suit_ok(other, o.v) end
    if id == "rank" then return card_rank_ok(other, o.v) end
    if id == "enhancement" then return other.config and other.config.center and other.config.center.key == o.v end
    if id == "seal" then return other.seal == o.v end
    if id == "edition" then return other.edition and other.edition[o.v] and true or false end
  end
  if id == "hand" then
    if o.mode == "is" then return context.scoring_name == o.v end
    local ph = context.poker_hands
    if ph and ph[o.v] then return next(ph[o.v]) ~= nil end
    return context.scoring_name == o.v
  end
  if id == "cards_played" then return compare(o.op, context.full_hand and #context.full_hand or 0, o.n) end
  if id == "money" then return compare(o.op, G.GAME and G.GAME.dollars or 0, o.n) end
  if id == "hands_left" then return compare(o.op, round().hands_left, o.n) end
  if id == "discards_left" then return compare(o.op, round().discards_left, o.n) end
  if id == "first_hand" then return (round().hands_played or 0) == 0 end
  if id == "last_hand" then return (round().hands_left or 1) == 0 end
  if id == "ante" then return compare(o.op, G.GAME and G.GAME.round_resets and G.GAME.round_resets.ante or 1, o.n) end
  if id == "jokers" then return compare(o.op, G.jokers and G.jokers.cards and #G.jokers.cards or 0, o.n) end
  if id == "boss" then return G.GAME and G.GAME.blind and G.GAME.blind.boss and true or false end
  if id == "blind" then return blind_type() == o.v end
  if id == "deck_cards" then return compare(o.op, count(G.deck), o.n) end
  if id == "held_cards" then return compare(o.op, count(G.hand), o.n) end
  if id == "consumables" then return compare(o.op, count(G.consumeables), o.n) end
  if id == "hand_level" then return compare(o.op, hand_level(context), o.n) end
  if id == "round" then return compare(o.op, G.GAME and G.GAME.round or 0, o.n) end
  if id == "var" then return compare(o.op, var_val(card, o.var), o.n) end
  if id == "chance" then
    local p = G.GAME and G.GAME.probabilities and G.GAME.probabilities.normal or 1
    return pseudorandom(seed) < p / (tonumber(o.n) or 4)
  end
  return false
end

local function all_ok(rule, context, card, other, seed)
  for _, o in ipairs(rule.only or {}) do
    local ok = R.check(o, context, card, other, seed)
    if o.neg then ok = not ok end
    if not ok then return false end
  end
  return true
end

function R.state(card)
  local ab = card.ability
  ab.extra = type(ab.extra) == "table" and ab.extra or {}
  local x = ab.extra
  x.chips = tonumber(x.chips) or 0
  x.mult = tonumber(x.mult) or 0
  x.xmult = tonumber(x.xmult) or 1
  return x
end

local function msg_var(key, n) return localize{type = "variable", key = key, vars = {n}} end

local function status(card, text, colour)
  card_eval_status_text(card, "extra", nil, nil, nil, {message = text, colour = colour})
end

