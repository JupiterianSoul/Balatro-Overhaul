local function side_effect(g, card, src, context, other, out)
  local id = g.id
  if id == "money" then
    if out.card_ctx and out.when == "card_scored" then
      out.ret.dollars = (out.ret.dollars or 0) + g.n
    else
      ease_dollars(g.n)
      status(src, localize("$") .. g.n, G.C.MONEY)
    end
  elseif id == "gain_chips" or id == "gain_mult" or id == "gain_xmult" then
    if context.blueprint then return end
    local x = R.state(card)
    if id == "gain_chips" then x.chips = x.chips + g.n
    elseif id == "gain_mult" then x.mult = x.mult + g.n
    else x.xmult = math.floor((x.xmult + g.n) * 100 + 0.5) / 100 end
    status(src, localize("k_upgrade_ex"), id == "gain_chips" and G.C.CHIPS or G.C.MULT)
  elseif id == "create" then
    if create_one(member(R.KINDS, g.v) and g.v or "Tarot", card) then
      status(src, "+1", G.C.SECONDARY_SET and G.C.SECONDARY_SET[g.v == "Joker" and "Tarot" or g.v] or G.C.FILTER)
    end
  elseif id == "level_up" then
    if context.scoring_name then
      status(src, localize("k_level_up_ex"), G.C.SECONDARY_SET and G.C.SECONDARY_SET.Planet)
      level_up_hand(src, context.scoring_name)
    end
  elseif id == "hand" then
    ease_hands_played(g.n)
    status(src, localize{type = "variable", key = "a_hands", vars = {g.n}}, G.C.BLUE)
  elseif id == "discard" then
    ease_discard(g.n)
    status(src, "+" .. g.n, G.C.RED)
  elseif id == "destroy_self" then
    if not context.blueprint then destroy(card) end
  elseif id == "destroy_card" then
    if out.when == "discard" and other then out.remove = true end
  elseif id == "add_card" then
    local center = G.P_CENTERS[g.v] or G.P_CENTERS.c_base
