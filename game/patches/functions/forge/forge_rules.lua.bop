R.create_one = create_one

local SUIT_PREFIX = {Hearts = "H", Diamonds = "D", Spades = "S", Clubs = "C"}
local RANK_SUFFIX = {[14] = "A", [13] = "K", [12] = "Q", [11] = "J", [10] = "T"}

function R.change_card(other, g)
  if g.what == "suit" and SUIT_PREFIX[g.v] then
    other:change_suit(g.v)
  elseif g.what == "rank" then
    local r = tonumber(g.v)
    if not r then return end
    local suit = SUIT_PREFIX[other.base and other.base.suit] or "S"
    local key = suit .. "_" .. (RANK_SUFFIX[r] or tostring(r))
    if G.P_CARDS[key] then other:set_base(G.P_CARDS[key]) end
  elseif g.what == "seal" then
    other:set_seal(g.v, nil, true)
  elseif g.what == "edition" then
    if member(R.EDITIONS, g.v) then other:set_edition({[g.v] = true}, true) end
  elseif G.P_CENTERS[g.v] then
    other:set_ability(G.P_CENTERS[g.v], nil, true)
  end
end

local function destroy(card)
  if card.forge_dying then return end
  card.forge_dying = true
