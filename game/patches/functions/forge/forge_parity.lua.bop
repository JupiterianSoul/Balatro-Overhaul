l 46
  G.blind_select_opts[key].parent = par
end

function P.try_slot(c, key)
  local slot = P.slot_of(c)
  if not slot then return false end
  local rr = G.GAME and G.GAME.round_resets
  if not (rr and rr.blind_choices and G.P_BLINDS[key] and G.blind_select_opts) then return false end
  local name = P.SLOT_NAME[slot]
  rr.blind_choices[name] = key
  pcall(P.redraw, name)
  return true
end

function P.install()
  if P.hooked then return end
  local okh, Hooks = pcall(require, "overhaul.hooks")
  if not (okh and Hooks) then return end
  P.hooked = true
  Hooks.wrap("Back", "trigger_effect", function(orig) return function(self, args, ...)
    local nc, nm = orig(self, args, ...)
    if type(args) == "table" and args.context == "final_scoring_step" and G.GAME and G.GAME.forge_balance and self == G.GAME.selected_back then
      local a = {chips = nc or args.chips, mult = nm or args.mult}
      local ok, c2, m2 = pcall(P.balance, a)
      if ok then return c2, m2 end
    end
    return nc, nm
  end end, {id = "forge_parity.balance"})
  Hooks.wrap(_G, "generate_card_ui", function(orig) return function(center, full, vars, ctype, badges, hide, main_start, main_end, card, ...)
    if type(center) == "table" and center.forge_kind and full == nil and main_end == nil and G.GAME then
      local c = forge_item(center.key)
      if c and P.makes_last(c) then
        local ok, box, last = pcall(P.fool_box, c)
        if ok then
          local out = orig(center, full, vars, ctype, badges, hide, main_start, box, card, ...)
          if last and type(out) == "table" then pcall(orig, last, out) end
          return out
        end
      end
    end
    return orig(center, full, vars, ctype, badges, hide, main_start, main_end, card, ...)
  end end, {id = "forge_parity.fool_box"})
  Hooks.wrap("Card", "check_use", function(orig) return function(self, ...)
    local center = self and self.config and self.config.center
    local c = center and center.forge_kind and forge_item(center.key)
    if c and P.no_space(c) then
r 3 1584 %20%20%20%20%20%20 -
l 72
      return true
    end
    return orig(self, ...)
  end end, {id = "forge_parity.check_use"})
  Hooks.wrap("Blind", "get_type", function(orig) return function(self, ...)
    local b = self and self.config and self.config.blind
    local slot = type(b) == "table" and rawget(b, "forge_slot")
    if slot then return P.SLOT_NAME[slot] end
    return orig(self, ...)
  end end, {id = "forge_parity.get_type"})
  Hooks.wrap(_G, "reset_blinds", function(orig) return function(...)
    local rr = G.GAME and G.GAME.round_resets
    local fresh = not (rr and rr.blind_states) or rr.blind_states.Boss == "Defeated"
    local r = {orig(...)}
    if fresh then pcall(P.pick_slots) end
    return unpack(r)
  end end, {id = "forge_parity.reset_blinds"})
  Hooks.wrap("Game", "start_run", function(orig) return function(self, args, ...)
    local r = {orig(self, args, ...)}
    if not (args and args.savetext) then
      local ok, err = pcall(P.pick_slots)
      if not ok then print("[FORGE] blind slots failed: " .. tostring(err)) end
    end
    pcall(P.link_eq)
    return unpack(r)
  end end, {id = "forge_parity.start_run"})
end

function P.strings()
  if not mod_loc_register or P.registered then return end
  P.registered = true
  mod_loc_register{
    fr = {
      ["With a chance"] = "Avec une chance", ["{C:green}1 in %d{} chance for the next effects"] = "{C:green}1 chance sur %d{} pour les effets suivants",
