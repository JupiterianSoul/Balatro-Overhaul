local function eq(a, b)
  local fa, fb = rawget(a, "forge_slot"), rawget(b, "forge_slot")
  local sa = fa or rawget(a, "forge_vanilla_slot")
  local sb = fb or rawget(b, "forge_vanilla_slot")
  return sa ~= nil and sa == sb and ((fa == nil) ~= (fb == nil))
end
P.eq = eq

function P.mark_blind(p, c)
  local slot = P.slot_of(c)
  p.forge_slot = slot
  if not slot then return end
  p.boss = nil
  p.blind_types = {slot}
  p.forge_min_ante = c.mode == "advanced" and math.max(1, math.floor(tonumber(c.fields.min_ante) or 1)) or 1
  P.MT = P.MT or {__eq = eq}
  if getmetatable(p) == nil then setmetatable(p, P.MT) end
  P.link_eq()
end



function P.link_eq()
  if not (G and G.P_BLINDS) then return end
  P.MT = P.MT or {__eq = eq}
  for slot, key in pairs({small = "bl_small", big = "bl_big"}) do
    local b = G.P_BLINDS[key]
    if b and (getmetatable(b) == nil or getmetatable(b) == P.MT) then
      b.forge_vanilla_slot = slot
      setmetatable(b, P.MT)
    end
  end
  for _, p in pairs(G.P_BLINDS) do
    if type(p) == "table" and rawget(p, "forge_slot") and (getmetatable(p) == nil or getmetatable(p) == P.MT) then setmetatable(p, P.MT) end
  end
end

function P.pool(slot)
  local out = {}
  local ante = G.GAME and G.GAME.round_resets and G.GAME.round_resets.ante or 1
  for key, p in pairs(G.P_BLINDS or {}) do
    if type(p) == "table" and rawget(p, "forge_slot") == slot and not p.forge_gone then
      local on = true
      if type(p.in_pool) == "function" then on = p.in_pool() end
      if on and ante >= (p.forge_min_ante or 1) then out[#out + 1] = key end
    end
  end
  table.sort(out)
  return out
end

function P.pick_slots()
  local rr = G.GAME and G.GAME.round_resets
  if not (rr and rr.blind_choices) then return end
  local More = require("functions/forge/forge_kinds_more")
  pcall(More.sync_tags_blinds)
  for slot, name in pairs(P.SLOT_NAME) do
    if not (rr.pvp_blind_choices and rr.pvp_blind_choices[name]) then
      local cur = rr.blind_choices[name]
      local plain = name == "Small" and "bl_small" or "bl_big"
      local pool = P.pool(slot)
      if #pool > 0 then
        rr.blind_choices[name] = pseudorandom_element(pool, pseudoseed("forge_" .. slot .. "_" .. tostring(rr.ante or 1)))
      elseif cur and G.P_BLINDS[cur] and rawget(G.P_BLINDS[cur], "forge_slot") then
        rr.blind_choices[name] = plain
      end
    end
  end
end

function P.redraw(name)
  local key = string.lower(name)
  local box = G.blind_select_opts and G.blind_select_opts[key]
  if not (box and box.parent and create_UIBox_blind_choice) then return end
  local par = box.parent
  box:remove()
  G.blind_select_opts[key] = UIBox{T = {par.T.x, 0, 0, 0}, definition = {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR}, nodes = {
    UIBox_dyn_container({create_UIBox_blind_choice(name)}, false, get_blind_main_colour(name)),
  }}, config = {align = "bmi", offset = {x = 0, y = 0}, major = par, xy_bond = "Weak"}}
  par.config.object = G.blind_select_opts[key]
