register_strings()

do
  local R = package.loaded["functions/forge/forge_rules"]
  if R and R.card_label and not R.forge_fu_label then
    R.forge_fu_label = true
    local base = R.card_label
    R.card_label = function(v, ...)
      if Fu.special(v) then return Fu.label(v) end
      return base(v, ...)
    end
  end
end

return Fu
end
