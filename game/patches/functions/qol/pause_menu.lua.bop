local Q = QOL
local M = Q.feature("pause_menu", {})

Q.default("qol_quick_restart", true)
Q.default("qol_confirm_leave", true)

function M.can_restart()
    return Q.on("qol_quick_restart") and Q.solo() and G.GAME.pseudorandom ~= nil
end

function M.swap(args, button)
    if args.id == 'restart_button' and M.can_restart() then
        local a, b = {}, {label = {mod_loc("Restart")}, button = 'qol_restart', minw = 2.4, col = true, id = 'qol_restart_button'}
        for k, v in pairs(args) do a[k] = v end
        a.minw, a.col = 2.4, true
        return {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = {button(a), {n = G.UIT.C, config = {minw = 0.2}}, button(b)}}
    end
    if args.button == 'go_to_menu' and Q.in_run() and Q.on("qol_confirm_leave") then
        args.button = 'qol_leave_run'
    end
end

local function button_of(node)
    local c = type(node) == 'table' and type(node.nodes) == 'table' and node.nodes[1]
    return type(c) == 'table' and c.config and c.config.button
end

function M.pair(node, button, depth)
    depth = depth or 0
    if type(node) ~= 'table' or type(node.nodes) ~= 'table' or depth > 8 then return false end
    local stats, coll
