local function strings()
    if not mod_loc_register then return end
    mod_loc_register{
        fr = {["Restart"] = "Recommencer", ["Restart this run?"] = "Recommencer cette partie ?", ["Same deck and stake"] = "Même jeu et même mise",
            ["Same seed"] = "Même seed", ["New seed"] = "Nouvelle seed", ["Same seed makes it a seeded run"] = "Même seed en fait une partie avec seed",
            ["Leave this run?"] = "Quitter cette partie ?", ["Your run is saved, Continue brings you back"] = "Votre partie est sauvegardée, Continuer vous y ramène",
            ["You leave the match"] = "Vous quittez le match",
            ["Quick restart"] = "Recommencer vite", ["Restart button in the pause menu"] = "Bouton Recommencer dans la pause",
            ["Confirm leaving"] = "Confirmer le départ", ["Main Menu in the pause menu asks first"] = "Menu principal en pause : confirmation d'abord"},
        es = {["Restart"] = "Reiniciar", ["Restart this run?"] = "¿Reiniciar esta partida?", ["Same deck and stake"] = "Misma baraja y mismo pozo",
            ["Same seed"] = "Mismo código", ["New seed"] = "Nuevo código", ["Same seed makes it a seeded run"] = "Mismo código la vuelve una partida con código",
            ["Leave this run?"] = "¿Salir de esta partida?", ["Your run is saved, Continue brings you back"] = "Tu partida se guarda, Continuar te devuelve",
            ["You leave the match"] = "Sales de la partida",
            ["Quick restart"] = "Reinicio rápido", ["Restart button in the pause menu"] = "Botón Reiniciar en la pausa",
            ["Confirm leaving"] = "Confirmar salida", ["Main Menu in the pause menu asks first"] = "Menú principal en la pausa pide confirmación"},
    }
end

Q.row("Run", function()
    return Q.toggle('set_qol_quick_restart', "Quick restart", "Restart button in the pause menu", 'qol_quick_restart')
end)
Q.row("Run", function()
    return Q.toggle('set_qol_confirm_leave', "Confirm leaving", "Main Menu in the pause menu asks first", 'qol_confirm_leave')
end)

function M.init()
    strings()
    if M._wrapped or not (G and G.FUNCS and create_UIBox_options and UIBox_button) then return end
    M._wrapped = true
    local build = create_UIBox_options
    local plain = UIBox_button
    local function button(args)
        if type(args) == "table" and M.building_port and not args.bo_big and (args.scale or 0.5) >= 0.45 then
            args.bo_big = true
            args.minh = math.max(args.minh or 0.9, 1.2)
            args.scale = (args.scale or 0.5) * 1.3
        end
        return plain(args)
    end
    create_UIBox_options = function(...)
        M.building_port = PORTRAIT and PORTRAIT.on and PORTRAIT.on() or false
        M.building = true
        local ok, t = pcall(build, ...)
        M.building = false
        if not ok then M.building_port = false error(t, 0) end
        if G.STAGE == G.STAGES.RUN then pcall(M.pair, t, button) end
        M.building_port = false
        return t
    end
    UIBox_button = function(args)
        if M.building and type(args) == "table" then
            local ok, r = pcall(M.swap, args, button)
            if ok and r then return r end
        end
        return button(args)
    end
    G.FUNCS.qol_restart = function()
        if not M.can_restart() then return end
        local lines = {mod_loc("Same deck and stake")}
        if not G.GAME.seeded then lines[2] = mod_loc("Same seed makes it a seeded run") end
        local buttons = {
            {label = mod_loc("Same seed"), button = 'qol_restart_same', colour = G.C.BLUE, id = 'qol_restart_same'},
            {label = mod_loc("New seed"), button = 'qol_restart_new', colour = G.C.RED, id = 'qol_restart_new'}}
        local RO = rawget(_G, "RunOrigin")
        local o = RO and RO.current and RO.current()
        if o then
            lines = {RO.mode_label(o), RO.setup_line(o), RO.note(o)}
            buttons = {}
            for _, c in ipairs(RO.choices(o)) do
                local same = c.key == 'same'
                buttons[#buttons + 1] = {label = c.label, button = same and 'qol_restart_same' or 'qol_restart_new', colour = same and G.C.BLUE or G.C.RED, id = same and 'qol_restart_same' or 'qol_restart_new'}
            end
        end
        G.FUNCS.overlay_menu{definition = dialog(mod_loc("Restart this run?"), lines, buttons)}
    end
    G.FUNCS.qol_restart_same = function() M.restart(true) end
    G.FUNCS.qol_restart_new = function() M.restart(false) end
    G.FUNCS.qol_leave_run = function()
        local mp = G.GAME and G.GAME.multiplayer
        G.FUNCS.overlay_menu{definition = dialog(mod_loc("Leave this run?"),
            {mp and mod_loc("You leave the match") or mod_loc("Your run is saved, Continue brings you back")},
            {{label = localize('b_main_menu'), button = 'qol_leave_yes', colour = G.C.RED, id = 'qol_leave_yes'}})}
    end
    G.FUNCS.qol_leave_yes = function(e)
        G.FUNCS.go_to_menu(e)
    end
end

strings()

return M
end
