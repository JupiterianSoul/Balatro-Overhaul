        node.nodes[first] = {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = {
            button{label = {localize('b_stats')}, button = 'high_scores', minw = 2.4, col = true},
            {n = G.UIT.C, config = {minw = 0.2}},
            button{label = {localize('b_collection')}, button = 'your_collection', minw = 2.4, col = true, id = 'your_collection'}}}
        node.nodes[second] = nil
        return true
    end
    for _, v in pairs(node.nodes) do
        if M.pair(v, button, depth + 1) then return true end
    end
    return false
end

local function text_row(text, scale, colour)
    return {n = G.UIT.R, config = {align = "cm", padding = 0.04, maxw = 7}, nodes = {
        {n = G.UIT.T, config = {text = text, scale = scale, colour = colour or G.C.UI.TEXT_LIGHT, shadow = true}}}}
end

local function dialog(title, lines, buttons)
    local nodes = {text_row(title, 0.6, G.C.GOLD), {n = G.UIT.R, config = {minh = 0.08}}}
    for _, l in ipairs(lines) do nodes[#nodes + 1] = text_row(l, 0.4) end
    local row = {}
    for i, b in ipairs(buttons) do
        if i > 1 then row[#row + 1] = {n = G.UIT.C, config = {minw = 0.2}} end
        row[#row + 1] = UIBox_button{label = {b.label}, button = b.button, colour = b.colour, minw = 3.4, minh = 0.8, col = true, id = b.id, focus_args = i == 1 and {snap_to = true} or nil}
    end
    nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.15}, nodes = row}
    return create_UIBox_generic_options{back_func = 'options', contents = {
        {n = G.UIT.R, config = {align = "cm", padding = 0.1, minw = 7.5}, nodes = {{n = G.UIT.C, config = {align = "cm"}, nodes = nodes}}}}}
end

