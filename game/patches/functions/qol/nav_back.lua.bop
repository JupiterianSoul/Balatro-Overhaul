    dc_open_deck_creator = true, tavern_open_shop = true, tavern_custom = true}
M.UNSAFE = {"exit", "confirm", "cancel", "_yes", "_no$", "back", "submit", "save", "buy", "start", "quit", "leave",
    "remove", "delete", "reset", "join", "create", "ready", "accept", "decline", "kick", "send", "^mp_", "^bom_", "^party_"}
M.ALIAS = {guide_back_to_guide_tab = "settings", guide_back_to_settings = "settings", cr_back_to_run_setup = "setup_run",
    mods_menu_back = "mods_button", mods_menu_config_back = "mods_button", workshop_back = "mods_button"}
M.NOT_BACK = {continue_unlock = true, quit = true, go_to_demo_cta = true, booster_skip_and_start = true,
    overhaul_update_later = true}
M.ESC = {"options", "settings", "your_collection", "high_scores", "setup_run", "deck_info", "open_jukebox",
    "guide_back_to_guide_tab", "guide_back_to_settings", "mods_menu_back", "mods_menu_config_back", "workshop_back",
    "cr_back_to_run_setup",
    "dc_back_from_editor", "dc_back_from_list", "dc_picker_back", "dc_rename_cancel", "mod_menu_back",
    "mod_browse_back_cards", "mod_browse_back_jokers", "mod_browse_back_vouchers", "seed_lib_edit_cancel",
    "seed_lib_rename_cancel", "shop_confirm_no", "bot_close_settings", "tavern_shop_back", "tavern_custom_back"}

local function helpers() return rawget(_G, "OVERLAY_MENU_HELPERS") or {} end

M.nav = Nav.new(function(a, b)
    local same = helpers().same
    return same and same(a, b) or false
end)

function M.safe(name)
    if type(name) ~= "string" then return false end
    for _, p in ipairs(M.UNSAFE) do
        if name:find(p) then return false end
    end
    if M.OPENERS[name] then return true end
    return name:find("^open_") ~= nil or name:find("^your_collection") ~= nil or name:find("^mod_browse_") ~= nil
end

local function now() return G and G.TIMERS and G.TIMERS.REAL or 0 end

function M.backing()
    return M.back_t ~= nil and M.back_t == now()
end

local function snap(arg)
    if type(arg) ~= "table" or type(rawget(arg, "config")) ~= "table" then return nil end
    local c = {}
    for k, v in pairs(arg.config) do c[k] = v end
    return c
end

local function wrapped(fn, key, alt, depth)
    for i = 1, 60 do
        local up, v = debug.getupvalue(fn, i)
        if not up then break end
        if type(v) == "function" and (up == key or up == "_" .. key or up:find("^_?orig") or up:find("^_?old")) then
            if alt[v] == nil then alt[v] = key end
            if depth < 3 then wrapped(v, key, alt, depth + 1) end
        end
    end
end

local function names()
    local map, alt = {}, {}
    for k, v in pairs(G.FUNCS) do
