            local prev = map[v]
            if not prev or (not M.safe(prev) and M.safe(k)) then map[v] = k end
        end
    end
    for k, v in pairs(G.FUNCS) do
        if type(v) == "function" and type(k) == "string" then wrapped(v, k, alt, 1) end
    end
    return map, alt
end

local function walk(map)
    for level = 5, 40 do
        local info = debug.getinfo(level, "f")
        if not info then break end
        local name = info.func and map[info.func]
        if name and name ~= "overlay_menu" and name ~= "exit_overlay_menu" then
            local _, arg = debug.getlocal(level, 1)
            return M.ALIAS[name] or name, arg
        end
    end
end

function M.opener()
    local map, alt = names()
    local name, arg = walk(map)
    if name then return name, arg end
    name, arg = walk(alt)
    if name then return name, arg end
    local c = M.click
    if c and c.t == now() then return M.ALIAS[c.name] or c.name, c.e end
end

function M.before_open(args)
    local h = helpers()
    local was = G.OVERLAY_MENU
    local was_open = type(was) == "table"
    local fp = h.fingerprint and h.fingerprint(args.definition) or nil
    local name, arg = M.opener()
    local tabs = was_open and h.chosen_tabs and h.chosen_tabs(was) or nil
    local how, e = M.nav:opened{name = name, arg = snap(arg), fp = fp, was_open = was_open, backing = M.backing(),
        reopening = M.reopening, tabs = tabs, safe = M.safe(name)}
    M.last = how
    M.pending_tabs = (how == "return" or how == "reopen") and e and e.tabs or nil
end

function M.after_open()
    local tabs = M.pending_tabs
    M.pending_tabs = nil
    local restore = helpers().restore_tabs
    if tabs and #tabs > 0 and restore then restore(tabs) end
end

function M.reopen()
    local e = M.nav:back()
    if not e then return false end
    local fn = G.FUNCS[e.name]
    if type(fn) ~= "function" then
        M.nav:reset()
        return false
    end
    local old = G.OVERLAY_MENU
    local layered = G.NO_MOD_CURSOR_STACK
