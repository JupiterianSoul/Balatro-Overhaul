local Q = QOL
local Nav = require("functions/qol/nav_history")
local M = Q.feature("nav_back", {})

M.OPENERS = {options = true, settings = true, high_scores = true, setup_run = true, deck_info = true, run_info = true,
    challenge_list = true, customize_deck = true, language_selection = true, profile_select = true, usage = true,
