local function wrap_overlay()
    local open = G.FUNCS.overlay_menu
    G.FUNCS.overlay_menu = function(args)
        if type(args) == "table" and not args.key then
            local c = debug.getinfo(2, "Sl")
            if c then args.key = tostring(c.short_src) .. ":" .. tostring(c.currentline) end
        end
        if type(args) == "table" then
            local ok, err = pcall(M.before_open, args)
            if not ok then
                print("[QoL] nav: " .. tostring(err))
                M.nav:reset()
            end
        end
        open(args)
        local ok, err = pcall(M.after_open)
        if not ok then print("[QoL] nav tabs: " .. tostring(err)) end
    end
    local exit = G.FUNCS.exit_overlay_menu
    G.FUNCS.exit_overlay_menu = function(...)
        if M.backing() and not M.reopening and type(G.OVERLAY_MENU) == "table" and M.nav:depth() > 0 then
            M.back_t = nil
            if G.FUNCS.end_menu_sub_showcase then pcall(G.FUNCS.end_menu_sub_showcase) end
            if M.reopen() then return end
        end
        M.nav:reset()
        return exit(...)
    end
end

local function wrap_click()
    local click = UIElement.click
    UIElement.click = function(self, ...)
        local c = self.config
        local b = c and c.button
        if b then M.click = {name = b, e = self, t = now()} end
        local back = b and (c.id == "overlay_menu_back_button" or b == "exit_overlay_menu") and not M.NOT_BACK[b]
        if back then M.back_t = now() end
        click(self, ...)
        if back then M.back_t = nil end
    end
end

local function wrap_esc()
    local kpu = Controller.key_press_update
    Controller.key_press_update = function(self, key, ...)
        local esc = key == "escape" and type(G.OVERLAY_MENU) == "table" and not self.text_input_hook and not self.locks.frame
        if esc then M.back_t = now() end
        kpu(self, key, ...)
        if esc then M.back_t = nil end
    end
end

function M.init()
    if M._wrapped or not (G and G.FUNCS and G.FUNCS.overlay_menu and UIElement and Controller) then return end
    M._wrapped = true
    G.ESC_BACK_FUNCS = G.ESC_BACK_FUNCS or {}
    for _, name in ipairs(M.ESC) do G.ESC_BACK_FUNCS[name] = true end
    wrap_overlay()
    wrap_click()
    wrap_esc()
end

return M
end
