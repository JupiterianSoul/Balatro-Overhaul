        definition = {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR, padding = 0.02}, nodes = e.config.ref_table},
        config = {offset = {x = -0.03, y = 0}, align = "cl", parent = e}
    }
    local info = e.children.info
    info:align_to_major()
    local room_w = G.ROOM and G.ROOM.T and G.ROOM.T.w or 0
    if info.T and room_w > 0 and info.T.x < 0 then
        info:set_alignment({type = "cr", offset = {x = 0.03, y = 0}, major = e, lr_clamp = true})
        info:align_to_major()
    end
    if touch() then disable_tip_collision(info) end
