end

function M.init()
    if M._wrapped or not Card then return end
    M._wrapped = true

    if type(Card.align_h_popup) == "function" then
        local prev = Card.align_h_popup
        Card.align_h_popup = function(self, ...)
            return M.clamp_popup(prev(self, ...))
        end
    end

    if G and G.FUNCS and type(G.FUNCS.show_infotip) == "function" then
        G.FUNCS.show_infotip = M.place_infotip
    end

    if type(Card.hover) == "function" then
        local prev_hover = Card.hover
        Card.hover = function(self, ...)
            local ret = prev_hover(self, ...)
            if touch() and has_card_tip(self) then disable_tip_collision(self.children.h_popup) end
            return ret
        end
    end

    local function wrap_tap(method_name)
        local prev = Card[method_name]
        if type(prev) ~= "function" then return end
        Card[method_name] = function(self, ...)
            local prev_focus = touch() and G.CONTROLLER and G.CONTROLLER.focused and G.CONTROLLER.focused.target
            local ret = prev(self, ...)
            if prev_focus and prev_focus ~= self and getmetatable(prev_focus) == Card
                and prev_focus.ability and prev_focus.ability.consumeable and prev_focus.children then
                clear_card_ui(prev_focus)
            end
            return ret
        end
    end

    wrap_tap("click")
    wrap_tap("single_tap")
end

return M
end
