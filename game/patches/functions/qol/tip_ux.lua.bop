local Q = QOL
local M = Q.feature("tip_ux", {})

local function touch()
    return UIK and UIK.touch and UIK.touch() and true or false
end

local function disable_tip_collision(node, depth)
    depth = depth or 0
    if not node or depth > 80 then return end
    if node.states then
        if node.states.collide then node.states.collide.can = false end
        if node.states.hover then node.states.hover.can = false end
        if node.states.click then node.states.click.can = false end
    end
    if node.UIRoot then
        disable_tip_collision(node.UIRoot, depth + 1)
    end
    if node.children then
        for _, child in pairs(node.children) do
            disable_tip_collision(child, depth + 1)
        end
    end
end

local function has_card_tip(card)
    return card and card.children and card.children.h_popup and true or false
end

local function clear_card_ui(card)
    pcall(function()
        if card.stop_hover then card:stop_hover() end
        for _, k in ipairs({"h_popup", "focused_ui", "use_button"}) do
            if card.children[k] then
                card.children[k]:remove()
                card.children[k] = nil
            end
        end
        if card.states and card.states.focus then card.states.focus.is = false end
        if card.states and card.states.hover then card.states.hover.is = false end
    end)
end

function M.clamp_popup(cfg)
    if type(cfg) ~= "table" then return cfg end
    cfg.lr_clamp = true
    return cfg
end

function M.fit_popup(card, cfg)
    if type(cfg) ~= "table" or cfg.type ~= "tm" or not (card and card.T) then return cfg end
    local pop = card.children and card.children.h_popup
    local h = pop and pop.T and pop.T.h
    if not h or h <= 0 then return cfg end
    local top = card.T.y
    if card.children.focused_ui and card.children.focused_ui.T then
        top = math.min(top, card.children.focused_ui.T.y)
    end
    local off = cfg.offset and cfg.offset.y or -0.13
    if top + off - h < 0.1 then
        cfg.type = "bm"
        cfg.offset = {x = cfg.offset and cfg.offset.x or 0, y = card.children.focused_ui and 0.12 or 0.1}
    end
    return cfg
end

function M.stack_info(e, info)
    local R = G.ROOM and G.ROOM.T
    local B = e and (e.UIBox and e.UIBox.T or e.T)
    if not (R and R.w and R.w > 0 and info and info.T and B) then return end
    local gap = 0.03
    local want
    if B.x - info.T.w - gap >= 0 then
        want = {type = "cl", offset = {x = -gap, y = 0}}
    elseif B.x + B.w + info.T.w + gap <= R.w then
        want = {type = "cr", offset = {x = gap, y = 0}}
    else
        local below = R.h - (B.y + B.h)
        local above = B.y
        if below >= info.T.h + gap or below >= above then
            want = {type = "bm", offset = {x = 0, y = gap}}
        else
            want = {type = "tm", offset = {x = 0, y = -gap}}
        end
    end
    want.major = e
    want.lr_clamp = true
    local cur = info.alignment
    if cur and cur.type == want.type then return end
    info:set_alignment(want)
    info:align_to_major()
    info.VT.x, info.VT.y = info.T.x, info.T.y
end

function M.restack(pop)
    local e = pop and pop.UIRoot and pop.UIRoot.children and pop.UIRoot.children[1]
    local info = e and e.children and e.children.info
    if info then M.stack_info(e, info) end
end

function M.place_infotip(e)
    if not (e and e.config and e.config.ref_table) then return end
r 32 2145 %20%20%20%20 -
l 7
        definition = {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR, padding = 0.02}, nodes = e.config.ref_table},
        config = {offset = {x = -0.03, y = 0}, align = "cl", parent = e}
    }
    local info = e.children.info
    info:align_to_major()
    M.stack_info(e, info)
    if touch() then disable_tip_collision(info) end
