local function mode_name(key)
  local mc = rawget(_G, 'bom_mode_content')
  if mc and mc.mode_name then return mc.mode_name(key) end
  return tostring(key)
end

local function mp_level()
  local f = rawget(_G, 'get_mp_progression_display')
  local ok, d = pcall(function() return f and f() end)
  return ok and type(d) == 'table' and d or nil
end

local function rank_info()
  local R = rawget(_G, 'bom_ranked')
  local name = R and R.cached_rank_name and select(2, pcall(R.cached_rank_name))
  local c = G.SETTINGS.mp_ranked_rank
  local col = R and R.rank_colour and type(c) == 'table' and select(2, pcall(R.rank_colour, c.r))
  return type(name) == 'string' and name or nil, type(col) == 'table' and col or G.C.WHITE
end

local function mp_overview()
  local d = ST().data()
  local t = ST().mp_totals(d)
  local lv = mp_level()
  local fav, fav_n = nil, 0
  for k, m in pairs(d.mp.modes) do if type(m) == 'table' and m.played > fav_n then fav, fav_n = k, m.played end end
  local best_ante, best_hand, modes_n, top, top_w = 0, 0, 0, nil, 0
  for k, m in pairs(d.mp.modes) do
    if type(m) == 'table' then
      best_ante, best_hand = math.max(best_ante, m.best_ante), math.max(best_hand, num(m.best_hand))
      if m.played > 0 then modes_n = modes_n + 1 end
      if m.wins > top_w then top, top_w = k, m.wins end
    end
  end
  local rname, rcol = rank_info()
  return SU.tiles({
    {L("Matches played"), fmt(t.played), C('plain')},
    {L("Wins"), fmt(t.wins), C('win')},
    {L("Losses"), fmt(t.losses), C('loss')},
    {L("Win rate"), ST().rate(t.wins, t.wins + t.losses), C('rate')},
    {L("Current streak"), fmt(d.mp.cur), C('win')},
    {L("Best win streak"), fmt(math.max(num(d.mp.best), t.wins > 0 and 1 or 0)), C('win')},
    {L("Blinds won"), fmt(d.mp.pvp_w), C('win')},
    {L("Blinds lost"), fmt(d.mp.pvp_l), C('loss')},
    {L("MP level"), lv and fmt(lv.level) or "1", C('ante'), lv and type(lv.rank) == 'table' and lv.rank.name and L(lv.rank.name) or nil},
    {L("Ranked"), rname or L("Unranked"), rname and rcol or UIK.C.muted},
    {L("Favourite mode"), fav and mode_name(fav) or "-", C('plain'), fav and counted(fav_n, L("%s match"), L("%s matches")) or nil},
    {L("Best ante"), best_ante > 0 and fmt(best_ante) or "-", C('ante')},
    {L("Best hand"), best_hand > 0 and fmt(best_hand) or "-", C('chips')},
    {L("Draws"), fmt(t.draws), C('plain')},
    {L("Modes played"), modes_n .. " / " .. #ST().MP_MODES, C('plain')},
    {L("Most wins"), top and mode_name(top) or "-", C('win'), top and counted(top_w, L("%s win"), L("%s wins")) or nil},
  })
end

local function mp_modes()
  local d = ST().data()
  local port = UIK.portrait()
  local cols = port and {
    {label = L("Mode"), w = 2.6}, {label = L("W / L"), w = 1.5}, {label = L("Win rate"), w = 1.1}, {label = L("Best streak"), w = 1.1},
  } or {
    {label = L("Mode"), w = 2.6}, {label = L("Played"), w = 1}, {label = L("Wins"), w = 1}, {label = L("Losses"), w = 1}, {label = L("Win rate"), w = 1.1},
    {label = L("Best streak"), w = 1.2}, {label = L("Blinds W / L"), w = 1.4}, {label = L("Best ante"), w = 1}, {label = L("Best hand"), w = 1.5},
  }
  local rows = {}
  local list = {}
  for _, k in ipairs(ST().MP_MODES) do list[#list + 1] = k end
  for k in pairs(d.mp.modes) do
    local known = false
    for _, x in ipairs(list) do if x == k then known = true end end
    if not known then list[#list + 1] = k end
  end
  local order = {}
  for i, k in ipairs(list) do order[k] = i end
  table.sort(list, function(a, b)
    local pa, pb = d.mp.modes[a] and d.mp.modes[a].played or 0, d.mp.modes[b] and d.mp.modes[b].played or 0
    if (pa > 0) ~= (pb > 0) then return pa > 0 end
    return order[a] < order[b]
  end)
  for _, k in ipairs(list) do
    local m = d.mp.modes[k] or ST().new_mode()
    local dim = m.played == 0
    local mc = dim and UIK.C.muted or nil
    local function v(x, col) return txt(x, 0.34, dim and UIK.C.muted or col or G.C.UI.TEXT_LIGHT) end
    if port then
      rows[#rows + 1] = {v(mode_name(k)), {v(fmt(m.wins), C('win')), v(" / ", UIK.C.muted), v(fmt(m.losses), C('loss'))}, v(ST().rate(m.wins, m.wins + m.losses), C('rate')), v(fmt(m.best), C('win'))}
    else
      rows[#rows + 1] = {v(mode_name(k)), v(fmt(m.played)), v(fmt(m.wins), C('win')), v(fmt(m.losses), C('loss')), v(ST().rate(m.wins, m.wins + m.losses), C('rate')),
        v(fmt(m.best), C('win')), {v(fmt(m.pvp_w), C('win')), v(" / ", UIK.C.muted), v(fmt(m.pvp_l), C('loss'))}, v(m.best_ante > 0 and fmt(m.best_ante) or "-", mc), v(num(m.best_hand) > 0 and fmt(m.best_hand) or "-", C('chips'))}
    end
  end
  if d.mp.legacy.played > 0 then
    local lg = d.mp.legacy
    local lost = math.max(0, lg.played - lg.wins)
    local function v(x, col) return txt(x, 0.34, col or UIK.C.muted) end
    if port then
      rows[#rows + 1] = {v(L("Before 2.0")), {v(fmt(lg.wins), C('win')), v(" / "), v(fmt(lost), C('loss'))}, v(ST().rate(lg.wins, lg.played), C('rate')), v("-")}
    else
      rows[#rows + 1] = {v(L("Before 2.0")), v(fmt(lg.played)), v(fmt(lg.wins), C('win')), v(fmt(lost), C('loss')), v(ST().rate(lg.wins, lg.played), C('rate')), v("-"), v("-"), v("-"), v("-")}
    end
  end
  return SU.table{id = 'omps_modes', cols = cols, rows = rows}
end

local function mp_favourites()
  local d = ST().data()
  local port = UIK.portrait()
  local w = port and (UIK.W - 2 * UIK.PAD) or ((UIK.W - UIK.GAP) / 2 - 2 * UIK.PAD)
  local jk = top(d.mp.jokers, SU.fav_n(), function(k, v) return G.P_CENTERS[k] and type(v) == 'table' and num(v.count) or nil end)
  local jentries = {}
  for i, e in ipairs(jk) do
    jentries[i] = {icon = joker_icon(e.key), name = joker_name(e.key), value = {
      txt(counted(e.v.count, L("%s match"), L("%s matches")), SU.small(), G.C.UI.TEXT_LIGHT), txt("  ", SU.small(), G.C.CLEAR), txt(counted(e.v.wins, L("%s win"), L("%s wins")), SU.small(), C('win'))}}
  end
  local dk = top(d.mp.decks, SU.fav_n(), function(k, v) return G.P_CENTERS[k] and type(v) == 'table' and num(v.count) or nil end)
  local dentries = {}
  for i, e in ipairs(dk) do
    dentries[i] = {icon = deck_icon(e.key), name = deck_name(e.key), value = {
      txt(counted(e.v.count, L("%s match"), L("%s matches")), SU.small(), G.C.UI.TEXT_LIGHT), txt("  ", SU.small(), G.C.CLEAR), txt(counted(e.v.wins, L("%s win"), L("%s wins")), SU.small(), C('win'))}}
  end
  local a = fav_section(L("Favourite Jokers"), jentries, w, L("Finish a match to see your jokers."))
  local b = fav_section(L("Favourite decks"), dentries, w, L("Finish a match to see your decks."))
  SU.even(a, b)
  if port then
    return {n = G.UIT.R, config = {align = 'tm', minw = UIK.W, padding = 0}, nodes = {
      {n = G.UIT.C, config = {align = 'tm', padding = 0.06}, nodes = {
        {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {a}},
        {n = G.UIT.R, config = {minh = 0.15}, nodes = {}},
        {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {b}},
      }},
    }}
  end
  return {n = G.UIT.R, config = {align = 'tm', minw = UIK.W, padding = 0}, nodes = {
    {n = G.UIT.R, config = {minh = 0.1}, nodes = {}},
    {n = G.UIT.R, config = {align = 'tm', padding = 0}, nodes = {a, {n = G.UIT.C, config = {minw = UIK.GAP}, nodes = {}}, b}},
  }}
end

local function mp_recent()
  local d = ST().data()
  local port = UIK.portrait()
  local cols = port and {
    {label = L("Result"), w = 1.1}, {label = L("Mode"), w = 1.8}, {label = L("Opponent"), w = 2}, {label = L("Ante"), w = 0.8},
  } or {
    {label = L("Result"), w = 1.1}, {label = L("Mode"), w = 2}, {label = L("Opponent"), w = 2.6}, {label = L("Ante"), w = 0.8},
    {label = L("Blinds W / L"), w = 1.4}, {label = L("When"), w = 1.5},
  }
  local rows = {}
  for _, h in ipairs(d.mp.history or {}) do
    local res = h.result == 'win' and txt(L("WIN"), 0.36, C('win')) or h.result == 'draw' and txt(L("DRAW"), 0.36, UIK.C.muted) or txt(L("LOSS"), 0.36, C('loss'))
    local opp = h.place and string.format(L("Place %s"), fmt(h.place)) or h.opp or "-"
    if port then
      rows[#rows + 1] = {res, mode_name(h.mode), opp, fmt(h.ante)}
    else
      rows[#rows + 1] = {res, mode_name(h.mode), opp, fmt(h.ante),
        {txt(fmt(h.pvp_w), 0.34, C('win')), txt(" / ", 0.34, UIK.C.muted), txt(fmt(h.pvp_l), 0.34, C('loss'))}, txt(when(h.at), 0.3, UIK.C.muted)}
    end
  end
  return SU.table{id = 'omps_recent', cols = cols, rows = rows, empty = L("Your last matches will show up here.")}
end

function create_UIBox_mp_stats()
  return UIK.window{
    id = 'omps',
    title = L("MULTIPLAYER STATS"),
    tabs = {
      {key = 'overview', label = L("Overview"), build = mp_overview},
      {key = 'modes', label = L("Modes"), build = mp_modes},
      {key = 'favs', label = L("Favourites"), build = mp_favourites},
      {key = 'recent', label = L("Recent matches"), build = mp_recent},
    },
    back_func = 'high_scores',
    back_inline = 'land',
    snap_back = true,
    footer = (not G.F_NO_ACHIEVEMENTS and G.FUNCS.open_mp_achievements) and {
      UIK.button{label = L("Achievements"), button = 'open_mp_achievements', w = SU.foot_w(), scale = SU.foot_scale({L("Achievements")}), col = true},
    } or nil,
  }
end

return SU
end
