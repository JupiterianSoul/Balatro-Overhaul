mod_loc_register(TR)

local function L(s)
  local lang = G and G.SETTINGS and G.SETTINGS.language
  if lang == "es_ES" or lang == "es_419" then lang = "es" end
  local t = TR[lang]
  if t and t[s] then return t[s] end
  return mod_loc and mod_loc(s) or s
end
SU.L = L
local function num(v) return tonumber(v) or 0 end
local function touch() return UIK.touch() end
local function ST() return Overhaul.stats end

local function profile()
  return G.PROFILES and G.SETTINGS and G.PROFILES[G.SETTINGS.profile] or {}
end

local function C(k)
  local t = {
    win = G.C.GREEN, loss = G.C.RED, rate = G.C.GOLD, money = G.C.MONEY, chips = G.C.CHIPS or G.C.BLUE,
    plain = G.C.WHITE, ante = G.C.FILTER, time = G.C.UI.TEXT_LIGHT, mult = G.C.MULT or G.C.RED,
  }
  return t[k] or G.C.WHITE
end

local function fmt(v)
  return number_format and number_format(num(v)) or tostring(math.floor(num(v)))
end

local function txt(s, scale, colour, o)
  local cfg = {text = tostring(s or ''), scale = math.max(scale or 0, touch() and 0.4 or 0.34), colour = colour or G.C.UI.TEXT_LIGHT, shadow = true}
  if o and o.maxw then cfg.maxw = o.maxw end
  return {n = G.UIT.T, config = cfg}
end

local function per_row()
  return UIK.portrait() and 2 or 4
end

local function tile_w(n)
  n = n or per_row()
  local gap = 0.12
  return (UIK.W - 2 * UIK.PAD - gap * (n + 1)) / n
end

function SU.tile(label, value, colour, sub, w, h)
  w = w or tile_w()
  local t = touch()
  h = h or (t and 1.2 or 1.08)
  local vs = t and 0.62 or 0.56
  local value_node
  if type(value) == 'table' then
    value_node = value
  else
    value_node = txt(value, vs, colour or C('plain'), {maxw = w - 0.3})
  end
  local lh, vh, sh = t and 0.44 or 0.38, t and 0.6 or 0.52, t and 0.42 or 0.36
  local fit = math.min(1, (h - 0.16 - sh) / (lh + vh))
  local rows = {
    {n = G.UIT.R, config = {align = 'cm', minh = lh * fit, padding = 0}, nodes = {txt(label, t and 0.34 or 0.3, UIK.C.muted, {maxw = w - 0.2})}},
    {n = G.UIT.R, config = {align = 'cm', minh = vh * fit, padding = 0}, nodes = {value_node}},
  }
  if sub then
    rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cm', minh = sh, padding = 0}, nodes = {txt(sub, t and 0.27 or 0.25, UIK.C.muted, {maxw = w - 0.35})}}
  else
    rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cm', minh = sh, padding = 0}, nodes = {}}
  end
  return {n = G.UIT.C, config = {align = 'cm', minw = w, maxw = w, minh = h, r = 0.12, colour = G.C.BLACK, emboss = 0.05, padding = 0.04}, nodes = rows}
end

function SU.tiles(list)
  local n = per_row()
  local w = tile_w(n)
  local rows = math.max(1, math.ceil(#list / n))
  local h = math.min(touch() and 1.6 or 1.4, (UIK.H - UIK.TOP - 0.1) / rows - 0.12 - 0.05 * math.min(n, #list))
  local items = {}
  for _, t in ipairs(list) do items[#items + 1] = SU.tile(t[1], t[2], t[3], t[4], w, h) end
  return {n = G.UIT.R, config = {align = 'tm', minw = UIK.W, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = 'tm', padding = 0}, nodes = {
      {n = G.UIT.R, config = {minh = 0.08}, nodes = {}},
      UIK.grid(items, n, {w = UIK.W - 2 * UIK.PAD, padding = 0.06}),
    }},
  }}
end

local function row_h() return touch() and 0.64 or 0.52 end

local function cell(content, w, align)
  local nodes
  if type(content) == 'table' and content.n then nodes = {content}
  elseif type(content) == 'table' then nodes = content
  else nodes = {txt(content, touch() and 0.36 or 0.32, G.C.UI.TEXT_LIGHT, {maxw = w - 0.12})} end
  return {n = G.UIT.C, config = {align = align or 'cm', minw = w, maxw = w, minh = row_h(), padding = 0}, nodes = nodes}
end

local function scale_cols(cols, total)
  local sum = 0
  for _, c in ipairs(cols) do sum = sum + c.w end
  local out = {}
  for i, c in ipairs(cols) do out[i] = c.w * total / sum end
  return out
end

function SU.table(o)
  local total = UIK.W - 2 * UIK.PAD - 0.3
  local ws = scale_cols(o.cols, total)
  local hs = touch() and 0.4 or 0.34
  local lines = {}
  local two = false
  for i, c in ipairs(o.cols) do
    local l = tostring(c.label)
    lines[i] = {l}
    if UIK.text_w(l, hs) > ws[i] - 0.08 and l:find(' ') then
      local best, bw = nil, math.huge
      for pos in l:gmatch('() ') do
        local a, b = l:sub(1, pos - 1), l:sub(pos + 1)
        local w = math.max(UIK.text_w(a, hs), UIK.text_w(b, hs))
        if w < bw then best, bw = {a, b}, w end
      end
      if best then lines[i], two = best, true end
    end
  end
  local hh = two and (touch() and 0.62 or 0.54) or (touch() and 0.44 or 0.38)
  local hdr = {}
  for i in ipairs(o.cols) do
    local rows = {}
    for _, l in ipairs(lines[i]) do rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {txt(l, hs, UIK.C.gold, {maxw = ws[i] - 0.08})}} end
    hdr[i] = {n = G.UIT.C, config = {align = 'cm', minw = ws[i], maxw = ws[i], minh = hh, padding = 0}, nodes = rows}
  end
  local pager_h = (touch() and 0.82 or 0.66) + 0.12
  local avail = UIK.H - UIK.TOP - hh - 0.2
  local step = row_h() + 0.18
  local fit = math.max(1, math.floor(avail / step))
  local rows = o.rows or {}
  local paged = #rows > fit
  if paged then fit = math.max(1, math.floor((avail - pager_h) / step)) end
  local pages = math.max(1, math.ceil(#rows / fit))
  local page = math.max(1, math.min(UIK._pages[o.id] or 1, pages))
  UIK._pages[o.id] = page
  local body = {{n = G.UIT.R, config = {align = 'cm', padding = 0, minh = 0.1}, nodes = {}},
    {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = hdr}}
  for i = (page - 1) * fit + 1, math.min(#rows, page * fit) do
    local r = rows[i]
    local cells = {}
    for j = 1, #o.cols do cells[j] = cell(r[j], ws[j], o.cols[j].align) end
    body[#body + 1] = {n = G.UIT.R, config = {align = 'cm', padding = 0.04, r = 0.1, colour = r.colour or G.C.BLACK, emboss = 0.04}, nodes = cells}
    body[#body + 1] = {n = G.UIT.R, config = {minh = 0.04}, nodes = {}}
  end
  if #rows == 0 then
    body[#body + 1] = {n = G.UIT.R, config = {align = 'cm', padding = 0.4}, nodes = {txt(o.empty or L("Nothing here yet."), touch() and 0.4 or 0.36, UIK.C.muted)}}
  end
  local out = {n = G.UIT.R, config = {align = 'tm', minw = UIK.W, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = 'tm', padding = 0}, nodes = body},
  }}
  if not paged then return out end
  return {n = G.UIT.R, config = {align = 'tm', minw = UIK.W, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = 'tm', padding = 0}, nodes = {
      {n = G.UIT.R, config = {align = 'tm', minw = UIK.W, minh = UIK.H - UIK.TOP - pager_h, padding = 0}, nodes = {out}},
      UIK.pager{prev = 'uik_page', next = 'uik_page', prev_ref = {id = o.id, d = -1, n = pages}, next_ref = {id = o.id, d = 1, n = pages},
        text = string.format(L("Page %d of %d"), page, pages), w = UIK.W},
    }},
  }}
end

local function deck_name(key)
  local c = G.P_CENTERS[key]
  if not c then return tostring(key) end
  local ok, n = pcall(localize, {type = 'name_text', set = 'Back', key = key})
  if ok and type(n) == 'string' and n ~= 'ERROR' and n ~= '' then return n end
  return c.name or key
end

local function joker_name(key)
  local c = G.P_CENTERS[key]
  if not c then return tostring(key) end
  local ok, n = pcall(localize, {type = 'name_text', set = c.set or 'Joker', key = key})
  if ok and type(n) == 'string' and n ~= 'ERROR' and n ~= '' then return n end
  return c.name or key
end

local function stake_name(i)
  local s = G.P_CENTER_POOLS.Stake[i]
  if not s then return tostring(i) end
  local ok, n = pcall(localize, {type = 'name_text', set = 'Stake', key = s.key})
  if ok and type(n) == 'string' and n ~= 'ERROR' and n ~= '' then return n end
  return s.name or s.key
end

local function sprite_node(atlas, pos, w, h)
  local a = G.ASSET_ATLAS[atlas]
  if not (a and pos) then return nil end
  local s = Sprite(0, 0, w, h, a, pos)
  s.states.drag.can = false
  return {n = G.UIT.O, config = {object = s}}
end

local function deck_icon(key)
  local c = G.P_CENTERS[key]
  if not c then return nil end
  local h = touch() and 0.5 or 0.42
  return sprite_node(c.atlas or 'centers', c.pos, h * 0.71, h)
end

local function joker_icon(key)
  local c = G.P_CENTERS[key]
  if not c then return nil end
  local h = touch() and 0.56 or 0.46
  return sprite_node(c.atlas or 'Joker', c.pos, h * 0.71, h)
end

local function stake_icon(i)
  if not G.P_CENTER_POOLS.Stake[i] then return nil end
  local ok, s = pcall(get_stake_sprite, i, touch() and 0.36 or 0.3)
  if not ok or not s then return nil end
  return {n = G.UIT.O, config = {object = s}}
end

local function sum_tab(t)
  local s = 0
  for _, v in pairs(t or {}) do s = s + num(v) end
  return s
end

local function max_key(t)
  local m = 0
  for k, v in pairs(t or {}) do if num(v) > 0 and tonumber(k) and tonumber(k) > m then m = tonumber(k) end end
  return m
end

local function icon_label(icon, label, w)
  local nodes = {}
  if icon then nodes[#nodes + 1] = icon; nodes[#nodes + 1] = {n = G.UIT.C, config = {minw = 0.12}, nodes = {}} end
  nodes[#nodes + 1] = txt(label, touch() and 0.36 or 0.32, G.C.UI.TEXT_LIGHT, {maxw = w - (icon and 0.75 or 0.15)})
  return {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = nodes}
end

local function when(at)
  at = tonumber(at)
  if not at or at <= 0 then return "-" end
  return os.date("%d/%m %H:%M", at)
end

local function sp_overview()
  local p = profile()
  local hs = p.high_scores or {}
  local cs = p.career_stats or {}
  local d = ST().data() or {sp = {}}
  local t = ST().sp_totals(p)
  local function hsv(k) return hs[k] and num(hs[k].amt) or 0 end
  local fav_hand, fav_n = nil, 0
  for _, v in pairs(p.hand_usage or {}) do if num(v.count) > fav_n then fav_hand, fav_n = v.order, num(v.count) end end
  local fav_label = fav_hand and localize(fav_hand, 'poker_hands') or "-"
  local fast = num(d.sp.fastest)
  return SU.tiles({
    {L("Runs played"), fmt(t.runs), C('plain')},
    {L("Wins"), fmt(t.wins), C('win')},
    {L("Losses"), fmt(t.losses), C('loss')},
    {L("Win rate"), ST().rate(t.wins, t.wins + t.losses), C('rate')},
    {L("Best hand"), fmt(hsv('hand')), C('chips')},
    {L("Highest ante"), fmt(hsv('furthest_ante')), C('ante')},
    {L("Highest round"), fmt(hsv('furthest_round')), C('ante')},
    {L("Most money"), localize('$') .. fmt(hsv('most_money')), C('money')},
    {L("Best win streak"), fmt(hsv('win_streak')), C('win'), string.format(L("Current: %s"), fmt(hsv('current_streak')))},
    {L("Time played"), ST().format_time(d.time), C('time'), string.format(L("In runs: %s"), ST().format_time(d.run_time))},
    {L("Fastest win"), fast > 0 and ST().format_time(fast) or "-", C('time'), fast > 0 and d.sp.fastest_deck ~= '' and deck_name(d.sp.fastest_deck) or nil},
    {L("Money earned"), localize('$') .. fmt(cs.c_dollars_earned), C('money')},
    {L("Hands played"), fmt(cs.c_hands_played), C('plain')},
    {L("Favourite hand"), fav_label, C('plain'), fav_n > 0 and string.format(L("%s times"), fmt(fav_n)) or nil},
    {L("Rounds beaten"), fmt(cs.c_rounds), C('plain')},
    {L("Shop rerolls"), fmt(cs.c_shop_rerolls), C('plain')},
  })
end

local function deck_rows()
  local p = profile()
  local d = ST().data() or {sp = {deck_ante = {}}}
  local rows = {}
  for key, u in pairs(p.deck_usage or {}) do
    if G.P_CENTERS[key] and num(u.count) > 0 then
      local w, l = sum_tab(u.wins), sum_tab(u.losses)
      rows[#rows + 1] = {key = key, runs = num(u.count), wins = w, losses = l, stake = max_key(u.wins), ante = num(d.sp.deck_ante[key])}
    end
  end
  table.sort(rows, function(a, b) if a.runs ~= b.runs then return a.runs > b.runs end return a.key < b.key end)
  return rows
end

local function sp_decks()
  local port = UIK.portrait()
  local cols = port and {
    {label = L("Deck"), w = 3}, {label = L("Runs"), w = 1}, {label = L("W / L"), w = 1.4}, {label = L("Best stake"), w = 1},
  } or {
    {label = L("Deck"), w = 3.4}, {label = L("Runs"), w = 1}, {label = L("Wins"), w = 1}, {label = L("Losses"), w = 1},
    {label = L("Win rate"), w = 1.1}, {label = L("Best stake won"), w = 1.6}, {label = L("Best ante"), w = 1.1},
  }
  local ws = scale_cols(cols, UIK.W - 2 * UIK.PAD - 0.3)
  local rows = {}
  for _, r in ipairs(deck_rows()) do
    local stake = r.stake > 0 and (stake_icon(r.stake) or txt(stake_name(r.stake), 0.3, G.C.WHITE)) or txt("-", 0.32, UIK.C.muted)
    if port then
      rows[#rows + 1] = {icon_label(deck_icon(r.key), deck_name(r.key), ws[1]), fmt(r.runs),
        {txt(fmt(r.wins), 0.34, C('win')), txt(" / ", 0.34, UIK.C.muted), txt(fmt(r.losses), 0.34, C('loss'))}, stake}
    else
      rows[#rows + 1] = {icon_label(deck_icon(r.key), deck_name(r.key), ws[1]), fmt(r.runs),
        txt(fmt(r.wins), 0.34, C('win')), txt(fmt(r.losses), 0.34, C('loss')),
        txt(ST().rate(r.wins, r.wins + r.losses), 0.34, C('rate')), stake, r.ante > 0 and fmt(r.ante) or "-"}
    end
  end
  return SU.table{id = 'ostats_decks', cols = cols, rows = rows, empty = L("Play a run to see your decks here.")}
end

local function sp_stakes()
  local p = profile()
  local agg = {}
  for _, u in pairs(p.deck_usage or {}) do
    for k, v in pairs(u.wins or {}) do local i = tonumber(k); if i then agg[i] = agg[i] or {w = 0, l = 0, decks = 0}; agg[i].w = agg[i].w + num(v); if num(v) > 0 then agg[i].decks = agg[i].decks + 1 end end end
    for k, v in pairs(u.losses or {}) do local i = tonumber(k); if i then agg[i] = agg[i] or {w = 0, l = 0, decks = 0}; agg[i].l = agg[i].l + num(v) end end
  end
  local cols = {
    {label = L("Stake"), w = 3.4}, {label = L("Wins"), w = 1}, {label = L("Losses"), w = 1}, {label = L("Win rate"), w = 1.1}, {label = L("Decks won"), w = 1.2},
  }
  local ws = scale_cols(cols, UIK.W - 2 * UIK.PAD - 0.3)
  local rows = {}
  for i = 1, #G.P_CENTER_POOLS.Stake do
    local a = agg[i]
    if a and (a.w + a.l) > 0 then
      rows[#rows + 1] = {icon_label(stake_icon(i), stake_name(i), ws[1]), txt(fmt(a.w), 0.34, C('win')), txt(fmt(a.l), 0.34, C('loss')),
        txt(ST().rate(a.w, a.w + a.l), 0.34, C('rate')), fmt(a.decks)}
    end
  end
  return SU.table{id = 'ostats_stakes', cols = cols, rows = rows, empty = L("Win or lose a run to fill this table.")}
end

local function top(t, n, score)
  local list = {}
  for k, v in pairs(t or {}) do
    local s = score(k, v)
    if s and s > 0 then list[#list + 1] = {key = k, v = v, s = s} end
  end
  table.sort(list, function(a, b) if a.s ~= b.s then return a.s > b.s end return tostring(a.key) < tostring(b.key) end)
  local out = {}
  for i = 1, math.min(n, #list) do out[i] = list[i] end
  return out
end

function SU.fav_n()
  if UIK.portrait() then return 6 end
  return touch() and 6 or 8
end

function SU.small() return touch() and 0.37 or 0.33 end

local function fav_section(title, entries, w, empty)
  local rows = {}
  local inner = w - 2 * UIK.PAD
  for i, e in ipairs(entries) do
    rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cm', minw = inner, minh = touch() and 0.66 or 0.56, r = 0.1, colour = G.C.BLACK, emboss = 0.04, padding = 0.04}, nodes = {
      {n = G.UIT.C, config = {align = 'cm', minw = 0.45}, nodes = {txt(tostring(i), touch() and 0.36 or 0.32, UIK.C.gold)}},
      {n = G.UIT.C, config = {align = 'cl', minw = inner - 0.45 - 2.3 - 0.16, maxw = inner - 0.45 - 2.3 - 0.16}, nodes = {icon_label(e.icon, e.name, inner - 0.45 - 2.3 - 0.16)}},
      {n = G.UIT.C, config = {align = 'cm', minw = 2.3, maxw = 2.3}, nodes = e.value},
    }}
  end
  if #rows == 0 then rows[1] = UIK.note(empty, {w = inner}) end
  return UIK.section(title, rows, {w = w, col = true})
end

function SU.even(a, b)
  local h = math.max(a.uik_h or 0, b.uik_h or 0)
  a.config.minh, b.config.minh = h, h
end

local function counted(n, label_one, label_many)
  return string.format(num(n) == 1 and label_one or label_many, fmt(n))
end

local function sp_favourites()
  local p = profile()
  local port = UIK.portrait()
  local w = port and (UIK.W - 2 * UIK.PAD) or ((UIK.W - UIK.GAP) / 2 - 2 * UIK.PAD)
  local jk = top(p.joker_usage, SU.fav_n(), function(k, v) return G.P_CENTERS[k] and num(v.count) or nil end)
  local jentries = {}
  for i, e in ipairs(jk) do
    local wins = sum_tab(e.v.wins)
    jentries[i] = {icon = joker_icon(e.key), name = joker_name(e.key), value = {
      txt(counted(e.v.count, L("%s run"), L("%s runs")), SU.small(), G.C.UI.TEXT_LIGHT), txt("  ", SU.small(), G.C.CLEAR), txt(counted(wins, L("%s win"), L("%s wins")), SU.small(), C('win'))}}
  end
  local hd = top(p.hand_usage, SU.fav_n(), function(k, v) return num(v.count) end)
  local hentries = {}
  for i, e in ipairs(hd) do
    hentries[i] = {name = localize(e.v.order or e.key, 'poker_hands'), value = {txt(counted(e.v.count, L("%s time"), L("%s times")), SU.small(), G.C.UI.TEXT_LIGHT)}}
  end
  local a = fav_section(L("Favourite Jokers"), jentries, w, L("Finish a run to see your jokers."))
  local b = fav_section(L("Favourite hands"), hentries, w, L("Play a hand to see this list."))
  SU.even(a, b)
  if port then
    return {n = G.UIT.R, config = {align = 'tm', minw = UIK.W, padding = 0}, nodes = {
      {n = G.UIT.C, config = {align = 'tm', padding = 0.06}, nodes = {
        {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {a}},
        {n = G.UIT.R, config = {minh = 0.15}, nodes = {}},
        {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {b}},
      }},
    }}
  end
  return {n = G.UIT.R, config = {align = 'tm', minw = UIK.W, padding = 0}, nodes = {
    {n = G.UIT.R, config = {minh = 0.1}, nodes = {}},
    {n = G.UIT.R, config = {align = 'tm', padding = 0}, nodes = {a, {n = G.UIT.C, config = {minw = UIK.GAP}, nodes = {}}, b}},
  }}
end

local KIND = {normal = "Run", seeded = "Seeded", challenge = "Challenge", daily = "Daily", custom = "Custom"}

local function sp_recent()
  local d = ST().data() or {sp = {history = {}}}
  local port = UIK.portrait()
  local cols = port and {
    {label = L("Result"), w = 1.1}, {label = L("Deck"), w = 2.6}, {label = L("Ante"), w = 0.8}, {label = L("Time"), w = 1.3},
  } or {
    {label = L("Result"), w = 1.1}, {label = L("Deck"), w = 3}, {label = L("Stake"), w = 0.9}, {label = L("Type"), w = 1.2},
    {label = L("Ante"), w = 0.8}, {label = L("Best hand"), w = 1.6}, {label = L("Time"), w = 1.2}, {label = L("When"), w = 1.5},
  }
  local ws = scale_cols(cols, UIK.W - 2 * UIK.PAD - 0.3)
  local rows = {}
  for _, h in ipairs(d.sp.history or {}) do
    local res = h.won and txt(L("WIN"), 0.36, C('win')) or txt(L("LOSS"), 0.36, C('loss'))
    local dk = h.deck and G.P_CENTERS[h.deck] and icon_label(deck_icon(h.deck), deck_name(h.deck), ws[2]) or "-"
    if port then
      rows[#rows + 1] = {res, dk, fmt(h.ante), ST().format_time(h.t)}
    else
      rows[#rows + 1] = {res, dk, stake_icon(num(h.stake)) or "-", L(KIND[h.kind] or "Run"), fmt(h.ante),
        num(h.best) > 0 and txt(fmt(h.best), 0.32, C('chips')) or "-", ST().format_time(h.t), txt(when(h.at), 0.3, UIK.C.muted)}
    end
  end
  return SU.table{id = 'ostats_recent', cols = cols, rows = rows, empty = L("Your last runs will show up here.")}
end

local function progress_section(title, entries, w)
  local t = touch()
  local inner = w - 2 * UIK.PAD
  local vw = t and 2.3 or 2.1
  local nw = math.min(3.4, (inner - vw) * 0.62)
  local bw = inner - nw - vw - 0.56
  local bh = t and 0.2 or 0.16
  local rows = {}
  for _, e in ipairs(entries) do
    local of = math.max(1, num(e.of))
    local f = math.max(0, math.min(1, num(e.tally) / of))
    local fill = {}
    if f > 0 then fill[1] = {n = G.UIT.C, config = {minw = math.max(0.06, bw * f), minh = bh, r = 0.05, colour = f >= 1 and C('win') or (G.C.BLUE or C('chips'))}, nodes = {}} end
    rows[#rows + 1] = {n = G.UIT.R, config = {align = 'cm', minw = inner, minh = t and 0.66 or 0.56, r = 0.1, colour = G.C.BLACK, emboss = 0.04, padding = 0.04}, nodes = {
      {n = G.UIT.C, config = {minw = 0.12}, nodes = {}},
      {n = G.UIT.C, config = {align = 'cl', minw = nw, maxw = nw}, nodes = {txt(e.label, t and 0.36 or 0.32, e.colour or G.C.UI.TEXT_LIGHT, {maxw = nw - 0.1})}},
      {n = G.UIT.C, config = {align = 'cm', minw = bw + 0.1}, nodes = {
        {n = G.UIT.C, config = {align = 'cl', minw = bw, maxw = bw, minh = bh, r = 0.05, colour = G.C.UI.BACKGROUND_INACTIVE}, nodes = fill},
      }},
      {n = G.UIT.C, config = {align = 'cr', minw = vw, maxw = vw}, nodes = {
        txt(math.floor(0.01 + 100 * f) .. '%', t and 0.36 or 0.32, f >= 1 and C('win') or G.C.WHITE),
        not e.pct_only and txt('  ' .. fmt(e.tally) .. '/' .. fmt(e.of), SU.small(), UIK.C.muted) or nil,
      }},
      {n = G.UIT.C, config = {minw = 0.08}, nodes = {}},
    }}
  end
  return UIK.section(title, rows, {w = w, col = true})
end

local function sp_progress()
  local ok = pcall(set_profile_progress)
  pcall(set_discover_tallies)
  local pr = ok and profile().progress
  if not (pr and pr.discovered and G.DISCOVER_TALLIES) then return UIK.note(L("Progress could not be read.")) end
  local DT = G.DISCOVER_TALLIES
  local OA = Overhaul.achievements
  local ag, at = 0, 0
  if OA and OA.count then
    local okc, a, b = pcall(OA.count)
    if okc then ag, at = num(a), num(b) end
  end
  local function part(t) return num(t and t.tally) / math.max(1, num(t and t.of)) end
  local overall = (part(pr.discovered) + part(pr.challenges) + part(pr.joker_stickers) + part(pr.deck_stakes)) / 4
  local port = UIK.portrait()
  local w = port and (UIK.W - 2 * UIK.PAD) or ((UIK.W - UIK.GAP) / 2 - 2 * UIK.PAD)
  local a = progress_section(L("Completion"), {
    {label = L("Overall"), tally = math.floor(0.01 + overall * 100), of = 100, colour = UIK.C.gold, pct_only = true},
    {label = localize('k_collection'), tally = pr.discovered.tally, of = pr.discovered.of},
    {label = localize('k_challenges'), tally = pr.challenges and pr.challenges.tally, of = pr.challenges and pr.challenges.of},
    {label = localize('k_joker_stickers'), tally = pr.joker_stickers and pr.joker_stickers.tally, of = pr.joker_stickers and pr.joker_stickers.of},
    {label = localize('k_deck_stake_wins'), tally = pr.deck_stakes and pr.deck_stakes.tally, of = pr.deck_stakes and pr.deck_stakes.of},
    {label = L("Achievements"), tally = ag, of = at},
  }, w)
  local b = progress_section(localize('k_collection'), {
    {label = localize('b_jokers'), tally = DT.jokers.tally, of = DT.jokers.of},
    {label = localize('b_decks'), tally = DT.backs.tally, of = DT.backs.of},
    {label = localize('b_vouchers'), tally = DT.vouchers.tally, of = DT.vouchers.of},
    {label = localize('b_stat_consumables'), tally = DT.consumeables.tally, of = DT.consumeables.of},
    {label = localize('b_blinds'), tally = DT.blinds.tally, of = DT.blinds.of},
    {label = localize('b_tags'), tally = DT.tags.tally, of = DT.tags.of},
  }, w)
  SU.even(a, b)
  if port then
    return {n = G.UIT.R, config = {align = 'tm', minw = UIK.W, padding = 0}, nodes = {
      {n = G.UIT.C, config = {align = 'tm', padding = 0.06}, nodes = {
        {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {a}},
        {n = G.UIT.R, config = {minh = 0.15}, nodes = {}},
        {n = G.UIT.R, config = {align = 'cm', padding = 0}, nodes = {b}},
      }},
    }}
  end
  return {n = G.UIT.R, config = {align = 'tm', minw = UIK.W, padding = 0}, nodes = {
    {n = G.UIT.R, config = {minh = 0.1}, nodes = {}},
    {n = G.UIT.R, config = {align = 'tm', padding = 0}, nodes = {a, {n = G.UIT.C, config = {minw = UIK.GAP}, nodes = {}}, b}},
  }}
end

function SU.foot_w()
  UIK.sync()
  if UIK.portrait() then return (UIK.W - 0.6) / 3 end
  if touch() then return math.min(3.6, (UIK.W - 3.0 * 1.5 - 0.2 - 0.12 * 5 - 0.2) / 3) end
  return math.min(3.6, (UIK.W - 0.8) / 3)
end

function SU.foot_scale(labels)
  local sc = UIK.portrait() and 0.4 or (touch() and 0.5 or 0.47)
  local room = SU.foot_w() - 0.4
  for _, l in ipairs(labels or {}) do
    local w = UIK.text_w(l, sc)
    if w > room then sc = sc * room / w end
  end
  return sc
end

