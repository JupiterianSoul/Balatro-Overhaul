function ui_numbers_en(node)
  if type(node) ~= 'table' then return node end
  local c = node.config
  if c and node.n == G.UIT.T and not c.lang then
    local t = c.text
    if type(t) == 'number' or (type(t) == 'string' and t:match('^[%d%.,%s%$%+%-e]+$') and t:match('[%d%$]')) then c.lang = G.LANGUAGES['en-us'] end
  end
  for i = 1, table.maxn(node.nodes or {}) do ui_numbers_en(node.nodes[i]) end
  return node
end

local hand_row_raw = create_UIBox_current_hand_row
function create_UIBox_current_hand_row(...)
  port = rawget(_G, 'PORTRAIT') and PORTRAIT.on()
  nw, lw, cw = port and 3.4 or 4.5, port and 1.1 or 1.5, port and 0.95 or 1.1
  return ui_numbers_en(hand_row_raw(...))
