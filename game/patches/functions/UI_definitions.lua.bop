function CR.credits_sounds_port(text_scale)
  local sc = text_scale*0.5
  local w = CR.w('(https://freesound.org/people/', sc) + 0.3
  local pages = {}
  for s = 1, #CR.SOUNDS_P, 2 do
    local nodes = {}
    if s == 1 then
      nodes[1] = {n=G.UIT.R, config={align = "cm", padding = 0.05}, nodes={
        CR.line({{"All sounds not listed here fall under", sc}}),
        CR.line({{"Creative Commons - CC0", sc, G.C.BLUE}}),
      }}
    end
    for e = s, math.min(#CR.SOUNDS_P, s + 1) do
      local rows = {}
      for _, ln in ipairs(CR.SOUNDS_P[e]) do
        local parts = {}
        for _, p in ipairs(ln) do parts[#parts+1] = {p[1], sc, p[2] and G.C[p[2]] or nil} end
        rows[#rows+1] = CR.line(parts)
      end
      nodes[#nodes+1] = {n=G.UIT.R, config={align = "cm", padding = 0.1, outline_colour = G.C.JOKER_GREY, r = 0.1, outline = 1, minw = w}, nodes=rows}
    end
    pages[#pages+1] = {first = s, node = {n=G.UIT.C, config={align = "cm", padding = 0.1}, nodes=nodes}}
  end
  return CR.pager('sounds', 'Sounds', pages)
end

