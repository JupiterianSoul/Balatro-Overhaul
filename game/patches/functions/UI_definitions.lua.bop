CREDITS_PAGES = CREDITS_PAGES or {}
local CR = {}

CR.GAP = 0.3

function CR.port()
  return PORTRAIT and PORTRAIT.on and PORTRAIT.on() or false
end

function CR.s()
  return CR.port() and 0.3 or 0.36
end

function CR.w(s, sc)
  local f = G.LANG and G.LANG.font
  if not (f and f.FONT) then return #s * sc * 0.5 end
  return f.FONT:getWidth(s) * (f.squish or 1) * sc * (f.FONTSCALE or 0.1) / G.TILESIZE
end

function CR.wrap(s, sc, maxw)
  local lines, cur = {}, ''
  for w in s:gmatch('%S+') do
    local nxt = cur == '' and w or (cur..' '..w)
    if cur ~= '' and CR.w(nxt, sc) > maxw then
      lines[#lines+1] = cur
      cur = w
    else
      cur = nxt
    end
  end
  if cur ~= '' then lines[#lines+1] = cur end
  return lines
end

function CR.t(s, sc, col)
  return {n=G.UIT.T, config={text = s, scale = sc, colour = col or G.C.UI.TEXT_LIGHT, shadow = true}}
end

function CR.line(parts, align)
  local nodes = {}
  for _, p in ipairs(parts) do nodes[#nodes+1] = CR.t(p[1], p[2], p[3]) end
  return {n=G.UIT.R, config={align = align or "cm", padding = 0.01}, nodes=nodes}
end

function CR.box(kind, nodes, minw)
  return {n=kind, config={align = "tm", padding = 0.12, outline_colour = G.C.JOKER_GREY, r = 0.1, outline = 1, minw = minw}, nodes=nodes}
end

function CR.pairs(list, sa, sb, ca, cb)
  local wa, wb = 0, 0
  for _, p in ipairs(list) do
    wa = math.max(wa, CR.w(p[1], sa))
    wb = math.max(wb, CR.w(p[2], sb))
  end
  local rows = {}
  for _, p in ipairs(list) do
    rows[#rows+1] = {n=G.UIT.R, config={align = "cl", padding = 0.015}, nodes={
      {n=G.UIT.C, config={align = "cl", minw = wa + CR.GAP}, nodes={CR.t(p[1], sa, ca)}},
      {n=G.UIT.C, config={align = "cl", minw = wb}, nodes={CR.t(p[2], sb, cb)}},
    }}
  end
  return {n=G.UIT.C, config={align = "tm", padding = 0.04}, nodes=rows}, wa + CR.GAP + wb
end

function CR.grid(names, cols, sc, col)
  local per = math.ceil(#names / cols)
  local w = 0
  for _, s in ipairs(names) do w = math.max(w, CR.w(s, sc)) end
  local out = {}
  for c = 1, cols do
    local rows = {}
    for i = (c-1)*per + 1, math.min(#names, c*per) do
      rows[#rows+1] = {n=G.UIT.R, config={align = "cm", padding = 0.015}, nodes={CR.t(names[i], sc, col)}}
    end
    if #rows > 0 then out[#out+1] = {n=G.UIT.C, config={align = "tm", padding = 0.04, minw = w + 0.2}, nodes=rows} end
  end
  return {n=G.UIT.R, config={align = "cm", padding = 0}, nodes=out}
end

function CR.groups(list, cols, fn)
  local per = math.ceil(#list / cols)
  local out = {}
  for c = 1, cols do
    local part = {}
    for i = (c-1)*per + 1, math.min(#list, c*per) do part[#part+1] = list[i] end
    if #part > 0 then
      out[#out+1] = fn(part)
      if c < cols and (c*per) < #list then out[#out+1] = {n=G.UIT.C, config={minw = 0.4}, nodes={}} end
    end
  end
  return {n=G.UIT.R, config={align = "tm", padding = 0}, nodes=out}
end

function CR.pager(key, label, pages)
  local st = CREDITS_PAGES[key] or 1
  local cur = 1
  local firsts = {}
  for i, p in ipairs(pages) do
    firsts[i] = p.first
    if p.first <= st then cur = i end
  end
  local nodes = {{n=G.UIT.R, config={align = "cm", padding = 0}, nodes={pages[cur].node}}}
  if #pages > 1 then
    local opts = {}
    for i = 1, #pages do opts[i] = localize('k_page')..' '..i..'/'..#pages end
    nodes[#nodes+1] = {n=G.UIT.R, config={align = "cm", padding = 0}, nodes={
      create_option_cycle({options = opts, w = CR.port() and 2.6 or 4.5, cycle_shoulders = not CR.port(), opt_callback = 'credits_page', current_option = cur, colour = G.C.RED, no_pips = true, focus_args = {snap_to = true, nav = 'wide'}, credits_key = key, credits_label = label, credits_firsts = firsts})
    }}
  end
  local port = CR.port()
  return {n=G.UIT.ROOT, config={align = "cm", padding = 0.15, colour = G.C.BLACK, r = 0.1, emboss = 0.05, minh = not port and 6 or nil, minw = not port and 10 or nil}, nodes=nodes}
end

G.FUNCS.credits_page = function(args)
  local c = args and args.cycle_config
  if not (c and c.credits_key and c.credits_firsts) then return end
  CREDITS_PAGES[c.credits_key] = c.credits_firsts[args.to_key] or 1
  local b = type(G.OVERLAY_MENU) == 'table' and G.OVERLAY_MENU:get_UIE_by_ID('tab_but_'..c.credits_label)
  if b then G.FUNCS.change_tab(b) end
end

