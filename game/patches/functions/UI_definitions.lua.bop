local blind_choice_raw = create_UIBox_blind_choice
function create_UIBox_blind_choice(...)
  local def = blind_choice_raw(...)
  local function walk(node)
    if type(node) ~= 'table' then return end
    local o = node.config and node.config.object
    if node.n == G.UIT.O and o and o.config and o.config.y_offset == -4 and o.text_offset and o.font then
      o.config.y_offset = 0
      o.text_offset.y = o.font.TEXT_OFFSET.y*o.scale
    end
    for i = 1, table.maxn(node.nodes or {}) do walk(node.nodes[i]) end
  end
  walk(def)
  local run_info = select(2, ...)
  local ri = (run_info and UIK and UIK.touch and UIK.touch() and not (PORTRAIT and PORTRAIT.on and PORTRAIT.on())) and 1.3 or 1
  if ri ~= 1 then
    local function grow(node)
      if type(node) ~= 'table' then return end
      local c = node.config
      if c and node.n == G.UIT.T and c.scale then c.scale = c.scale*ri end
      if c and node.n == G.UIT.R and c.maxw then c.maxw = c.maxw*ri end
      for i = 1, table.maxn(node.nodes or {}) do grow(node.nodes[i]) end
    end
    local function find(node)
      if type(node) ~= 'table' then return end
      local c = node.config
      if node.n == G.UIT.R and c and c.minh == 0.7 and c.minw == 2.9 and c.padding == 0.05 then
        for i = 1, table.maxn(node.nodes or {}) do grow(node.nodes[i]) end
        return
      end
      for i = 1, table.maxn(node.nodes or {}) do find(node.nodes[i]) end
    end
    find(def)
  end
  return ui_numbers_en(def)
end

