function CR.credits_production(text_scale)
  local port = CR.port()
  local kind = port and G.UIT.R or G.UIT.C
  local soundtrack = {
    CR.line({{"Original Soundtrack", text_scale*0.8}}),
    CR.line({{"composed by ", text_scale*0.8}, {"LouisF", text_scale*0.8, G.C.BLUE}}),
r 15 6292 %20%20%20%20 -
r 15 4348 %20%20%20%20%20%20 -
l 149
    }} or nil,
    {n=G.UIT.R, config={align = "cm", padding = 0.1}, nodes={CR.t("Modified with their permission", text_scale*0.5)}},
  }
  local porting_t, pw = CR.pairs(CR.PORTING, CR.s(), CR.s(), G.C.GOLD, G.C.UI.TEXT_LIGHT)
  local qa = CR.grid(CR.QA, 2, CR.s())
  local bw = port and math.max(pw, CR.w("Original Soundtrack", text_scale*0.8), 2*(CR.w('CampfireCollective', CR.s()) + 0.2)) + 0.3 or nil
  local page1 = {n=port and G.UIT.C or G.UIT.R, config={align = "cm", padding = 0.12}, nodes={
    CR.box(kind, soundtrack, bw),
    CR.box(kind, {CR.line({{"Porting", text_scale*0.6, G.C.WHITE}}), {n=G.UIT.R, config={align = "cm"}, nodes={porting_t}}}, bw),
    CR.box(kind, {CR.line({{"Testing/QA", text_scale*0.6, G.C.WHITE}}), qa}, bw),
  }}
  local loc = CR.groups(CR.LOC, port and 1 or 2, function(part)
    return (CR.pairs(part, CR.s(), CR.s(), G.C.FILTER, G.C.UI.TEXT_LIGHT))
  end)
  local page2 = {n=G.UIT.C, config={align = "cm", padding = 0.1}, nodes={
    CR.box(G.UIT.R, {
      CR.line({{"Localization", text_scale*0.6, G.C.WHITE}}),
      CR.line({{"Universally Speaking", text_scale*0.6, G.C.FILTER}}),
      loc,
    }),
  }}
  return CR.pager('production', 'Production', {{first = 1, node = page1}, {first = 4, node = page2}})
end

function CR.credits_publishing(text_scale)
  local port = CR.port()
  local cols = port and 1 or 2
  local per = 20
  local pages = {}
  for s = 1, #CR.PUB, per do
    local part = {}
    for i = s, math.min(#CR.PUB, s + per - 1) do part[#part+1] = CR.PUB[i] end
    local body = CR.groups(part, cols, function(p)
      return (CR.pairs(p, CR.port() and CR.s()*1.1 or CR.s(), CR.s(), G.C.UI.TEXT_LIGHT, G.C.GOLD))
    end)
    pages[#pages+1] = {first = s, node = {n=G.UIT.C, config={align = "cm", padding = 0.1}, nodes={
      CR.box(G.UIT.R, {CR.line({{"Playstack", text_scale*0.6, G.C.RED}}), body}),
    }}}
  end
  return CR.pager('publishing', 'Publishing', pages)
end

