function G.UIDEF.achievements_list_page(_page)
  local rows = {}
  local all_achs = {}

  if G.ACHIEVEMENTS then
    for id, data in pairs(G.ACHIEVEMENTS) do
      local name = id
      if localize then
        local n = localize(id, 'achievement_names')
        if n and n ~= "ERROR" then name = n end
      end
      local rarity = "Common"
      if data.tier == 1 then rarity = "Legendary"
      elseif data.tier == 2 then rarity = "Rare" end
      table.insert(all_achs, {
        id = id,
        name = name,
        rarity = rarity,
        unlocked = data.earned == true,
        order = data.order or 999
      })
    end
  end

  table.sort(all_achs, function(a, b)
    return (a.order or 999) < (b.order or 999)
  end)

  for k, ach in ipairs(all_achs) do
    if k > G.ACH_PAGE_SIZE * (_page or 0) and k <= G.ACH_PAGE_SIZE * ((_page or 0) + 1) then
      local rar_col = G.C.GREY
      if ach.rarity == "Rare" then rar_col = G.C.BLUE
      elseif ach.rarity == "Legendary" then rar_col = G.C.GOLD end

      local status_col = ach.unlocked and G.C.GREEN or darken(G.C.RED, 0.3)
      local status_text = ach.unlocked and "UNLOCKED" or "LOCKED"

r 15 2663 %20%20%20%20%20%20 -
l 24
        {n=G.UIT.C, config={align = "cl", padding = 0.05, minw = 3.2, maxw = 3.2}, nodes={
          {n=G.UIT.T, config={text = ach.name, scale = 0.38, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
        }},
        {n=G.UIT.C, config={align = "cm", r = 0.1, minh = 0.5, minw = 1.2, colour = G.C.BLACK, emboss = 0.05, padding = 0.03}, nodes={
          {n=G.UIT.C, config={align = "cm", r = 0.1, minw = 1.1, colour = rar_col, padding = 0.02}, nodes={
            {n=G.UIT.T, config={text = ach.rarity, scale = 0.25, colour = G.C.WHITE}}
          }},
        }},
        {n=G.UIT.C, config={align = "cm", r = 0.1, minh = 0.5, minw = 1.4, colour = G.C.BLACK, emboss = 0.05, padding = 0.03}, nodes={
          {n=G.UIT.C, config={align = "cm", r = 0.1, minw = 1.3, colour = status_col, padding = 0.02}, nodes={
            {n=G.UIT.T, config={text = status_text, scale = 0.22, colour = G.C.WHITE}}
          }},
        }},
      }}
    end
  end

  if #rows == 0 then
    rows[#rows + 1] = {n=G.UIT.R, config={align = "cm", padding = 0.5, r = 0.1, colour = darken(G.C.JOKER_GREY, 0.1), emboss = 0.05}, nodes={
      {n=G.UIT.T, config={text = mod_loc("No achievements"), scale = 0.4, colour = G.C.UI.TEXT_INACTIVE}}
    }}
  end

  return {n=G.UIT.ROOT, config={align = "cm", padding = 0.1, colour = G.C.CLEAR}, nodes=rows}
