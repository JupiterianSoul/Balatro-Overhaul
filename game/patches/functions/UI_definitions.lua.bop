function create_keyboard_button(key, binding, size)
  local overall_scale = ((G.F_MOBILE or (UIK and UIK.thumb and UIK.thumb())) and 1.9) or 1
  if size then
    local b = create_keyboard_button(key, binding)
    local but = b.nodes and b.nodes[1]
    if but and but.config then
      but.config.minw, but.config.minh = size.w, size.h
      for _, r in ipairs(but.nodes or {}) do
        if r.config then r.config.minw, r.config.maxw = size.w, size.w - 0.15 end
        for _, t in ipairs(r.nodes or {}) do if t.n == G.UIT.T and t.config then t.config.scale = size.scale end end
      end
    end
    return b
  end
  local key_label = (key == 'backspace' and 'Backspace') or (key == ' ' and 'Space') or (key == 'back' and 'Back') or (key == 'return' and 'Enter') or (key == 'accents' and (G.CONTROLLER and G.CONTROLLER.kb_accents and 'ABC' or 'ÀÉÑ')) or key
