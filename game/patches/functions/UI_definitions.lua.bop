G.UIDEF.profile_icon_frame = function()
  local profile_icon_nodes = {}
  pcall(function()
    if ProfileRewardsManager and ProfileRewardsManager.get_equipped_icon then
      local icon_key = ProfileRewardsManager.get_equipped_icon()
      if icon_key and G.P_CENTERS and G.P_CENTERS[icon_key] then
        local center = G.P_CENTERS[icon_key]
        local icon_sprite = Sprite(0, 0, 0.9*G.CARD_W, 0.9*G.CARD_H,
          G.ASSET_ATLAS[center.atlas or "Joker"] or G.ASSET_ATLAS["Joker"], center.pos)
        icon_sprite.states.drag.can = false
        icon_sprite.states.collide.can = false

        local icon_effect = nil
        pcall(function()
          if AshCardManager and AshCardManager.get_equipped_icon_effect then
            icon_effect = AshCardManager.get_equipped_icon_effect()
          end
        end)
        if icon_effect then
          local effect_def = nil
          pcall(function()
            for _, eff in ipairs(SHOP_ICON_EFFECTS) do
              if eff.id == icon_effect then effect_def = eff; break end
            end
          end)
          if effect_def and effect_def.shader then
            icon_sprite:define_draw_steps({
r 15 662 %20%20%20%20%20%20%20%20%20%20%20%20%20%20 -
r 5 505 %20%20%20%20%20%20%20%20%20%20%20%20%20%20 -
l 46
              {shader = effect_def.shader},
            })
          end
        end

        if center.soul_pos then
          local soul_sprite = Sprite(0, 0, 0.9*G.CARD_W, 0.9*G.CARD_H,
            G.ASSET_ATLAS[center.atlas or "Joker"] or G.ASSET_ATLAS["Joker"], center.soul_pos)
          soul_sprite.states.drag.can = false
          soul_sprite.states.collide.can = false
          soul_sprite:set_role({major = icon_sprite, role_type = 'Glued', draw_major = icon_sprite})
          icon_sprite.children = icon_sprite.children or {}
          icon_sprite.children.floating_sprite = soul_sprite
          local _orig_draw = icon_sprite.draw
          local _soul_effect_def = effect_def
          icon_sprite.draw = function(self)
            if _orig_draw then _orig_draw(self) end
            if self.children and self.children.floating_sprite then
              local fs = self.children.floating_sprite
              local scale_mod = 0.07 + 0.02*math.sin(1.8*G.TIMERS.REAL)
              local rotate_mod = 0.05*math.sin(1.219*G.TIMERS.REAL)
              fs:draw_shader('dissolve', 0, nil, nil, self, scale_mod, rotate_mod, nil, 0.1 + 0.03*math.sin(1.8*G.TIMERS.REAL), nil, 0.6)
              fs:draw_shader('dissolve', nil, nil, nil, self, scale_mod, rotate_mod)
              if _soul_effect_def and _soul_effect_def.shader then
                fs:draw_shader(_soul_effect_def.shader, nil, nil, nil, self, scale_mod, rotate_mod)
              end
            end
          end
        end
        profile_icon_nodes = {{n=G.UIT.O, config={object = icon_sprite}}}
      end
    end
  end)
  return {n=G.UIT.ROOT, config={align="cm", colour=G.C.CLEAR}, nodes={
    {n=G.UIT.C, config={align="cm", padding=0.1}, nodes={
      {n=G.UIT.R, config={align="cm", padding=0.08, r=0.1, colour=G.C.L_BLACK, emboss=0.05}, nodes={
        {n=G.UIT.R, config={align="cm", padding=0.06, r=0.08, colour=G.C.BLACK,
          outline=1, outline_colour=G.C.GOLD, minw=0.9*G.CARD_W, minh=0.9*G.CARD_H}, nodes=
          #profile_icon_nodes > 0 and profile_icon_nodes or
          {{n=G.UIT.T, config={text="?", scale=0.7, colour=G.C.GREY, shadow=true}}}
        },
      }},
    }},
  }}
end

