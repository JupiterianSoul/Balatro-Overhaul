local hud_blind_raw = create_UIBox_HUD_blind
function create_UIBox_HUD_blind(...)
  local def = hud_blind_raw(...)
  local en = G.LANGUAGES['en-us']
  local function walk(node)
    if type(node) ~= 'table' then return end
    local c = node.config or {}
    if c.id == 'HUD_blind_count' and not c.lang then c.lang = en end
    local o = c.object
    if node.n == G.UIT.O and o and o.config and type(o.config.string) == 'table' and type(o.config.string[1]) == 'table' and o.config.string[1].ref_value == 'dollars_to_be_earned' and not o.config.font then
      o.config.font = en.font
      o.font = en.font
      o.text_offset = {x = o.font.TEXT_OFFSET.x*o.scale + (o.config.x_offset or 0), y = o.font.TEXT_OFFSET.y*o.scale + (o.config.y_offset or 0)}
      o:update_text(true)
    end
    for i = 1, table.maxn(node.nodes or {}) do walk(node.nodes[i]) end
  end
  walk(def)
  return def
end

