function G.UIDEF.achievements_list()
  G.ACH_PAGE_SIZE = 5

  local total = 0
  local unlocked = 0

  if G.ACHIEVEMENTS then
    for id, data in pairs(G.ACHIEVEMENTS) do
      total = total + 1
      if data.earned then unlocked = unlocked + 1 end
    end
  end

  local pct = total > 0 and (unlocked / total) or 0

  local ach_pages = {}
  local page_count = math.max(1, math.ceil(total / G.ACH_PAGE_SIZE))
  for i = 1, page_count do
    table.insert(ach_pages, localize('k_page')..' '..tostring(i)..'/'..tostring(page_count))
  end

  G.ACH_PROGRESS = {tally = unlocked, of = total}

