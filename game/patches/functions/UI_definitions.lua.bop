function ui_touch_text(def, k)
  if not (UIK and UIK.touch and UIK.touch()) or type(def) ~= 'table' then return def end
  local function walk(n)
    if type(n) ~= 'table' then return end
    if n.n == G.UIT.T and n.config and n.config.scale then n.config.scale = n.config.scale * k end
    if n.config and n.config.maxw then n.config.maxw = n.config.maxw * k end
    for _, c in ipairs(n.nodes or {}) do walk(c) end
  end
  walk(def)
  return def
end

