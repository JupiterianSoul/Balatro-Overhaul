local function settings_window_dirty()
  local q, W = G.SETTINGS.QUEUED_CHANGE or {}, G.SETTINGS.WINDOW
  return (q.screenmode and q.screenmode ~= W.screenmode) or q.screenres or q.vsync or (q.selected_display and q.selected_display ~= W.selected_display) or false
end

local function settings_tab_display()
  local GR = G.SETTINGS.GRAPHICS
  local items = {}
  local fps_cap = UIK.cycle{id = 'set_fps_cap', label = mod_loc("FPS Cap"), info = mod_loc("Lower saves battery"), options = {"30", "40", "60", "90", "120", "144", "165", mod_loc("UNCAPPED")}, current = GR.fps_cap,
    callback = function(i) G.FUNCS.change_fps_cap{to_key = i} end}
  if G.F_VIDEO_SETTINGS then
    local W, q = G.SETTINGS.WINDOW, G.SETTINGS.QUEUED_CHANGE
    local disp = q.selected_display or W.selected_display
    local mode = q.screenmode or W.screenmode
    local res_option = GET_DISPLAYINFO(mode, disp)
    local res = W.DISPLAYS[disp].screen_resolutions
    if q.screenres then
      for i, v in ipairs(res.values) do if v.w == q.screenres.w and v.h == q.screenres.h then res_option = i break end end
    end
    local vsync_on = (q.vsync or W.vsync) ~= 0
    items[#items+1] = UIK.header(mod_loc("Window"))
    items[#items+1] = UIK.cycle{id = 'set_screenmode', label = localize('b_set_windowmode'), info = mod_loc("Windowed, fullscreen or borderless"), options = localize('ml_windowmode_opt'), current = ({Windowed = 1, Fullscreen = 2, Borderless = 3})[mode] or 1,
      callback = function(i) q.screenmode = ({"Windowed", "Fullscreen", "Borderless"})[i] q.screenres = nil UIK.refresh() end}
    items[#items+1] = UIK.cycle{id = 'set_resolution', label = mod_loc("Resolution"), info = mod_loc("Size of the game window"), options = res.strings, current = res_option or 1,
      callback = function(i) G.FUNCS.change_screen_resolution{to_key = i} UIK.refresh() end}
    items[#items+1] = UIK.action{id = 'set_apply_window', label = mod_loc("Apply Window Changes"), info = settings_window_dirty() and mod_loc("You have changes to apply") or mod_loc("Nothing to apply"),
      button_label = localize('b_set_apply'), button = 'settings_apply_window', colour = UIK.C.ok, disabled = not settings_window_dirty()}
    items[#items+1] = UIK.header(mod_loc("Screen"))
    items[#items+1] = UIK.cycle{id = 'set_monitor', label = localize('b_set_monitor'), info = mod_loc("Screen the game opens on"), options = W.display_names, current = disp,
      callback = function(i) q.selected_display = i UIK.refresh() end}
    items[#items+1] = UIK.cycle{id = 'set_vsync', label = mod_loc("VSync"), info = mod_loc("Stops screen tearing"), options = localize('ml_vsync_opt'), current = vsync_on and 1 or 2,
      callback = function(i) q.vsync = ((i == 1 and 1 or 0) ~= W.vsync) and (i == 1 and 1 or 0) or nil UIK.refresh() end}
    items[#items+1] = fps_cap
  else
    items[#items+1] = UIK.header(mod_loc("Frame Rate"))
    items[#items+1] = fps_cap
  end
  items[#items+1] = UIK.header(mod_loc("Performance"))
  items[#items+1] = UIK.toggle{id = 'set_perf', label = mod_loc("Performance Mode"), info = mod_loc("Lighter shaders for slow devices"), ref_table = GR, ref_value = 'performance_mode', callback = G.FUNCS.toggle_performance_mode}
  items[#items+1] = UIK.action{id = 'set_perf_settings', label = mod_loc("Performance Settings"), info = mod_loc("Resolution, particles, memory"), button_label = mod_loc("Open"), button = 'open_performance_settings', colour = UIK.C.warn}
  return UIK.flow{id = 'set_display', items = items, sections = true}
end

