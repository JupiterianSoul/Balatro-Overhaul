function COLL.rows(rows, w_mod, h_mod)
  if rawget(_G, 'PORTRAIT') and PORTRAIT.on() and PORTRAIT.collection_rows then return PORTRAIT.collection_rows(rows, w_mod, h_mod) end
  return rows
end

