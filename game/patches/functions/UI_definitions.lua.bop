local function settings_save()
  if G and G.save_settings then pcall(function() G:save_settings() end) end
end

local function settings_defaults()
  local S, GR = G.SETTINGS, G.SETTINGS.GRAPHICS
  GR.fps_cap = GR.fps_cap or (G.F_MOBILE and 3 or 6)
  GR.show_fps = GR.show_fps or false
  GR.fps_opacity = GR.fps_opacity or 80
  if S.mod_menu_disabled == nil then S.mod_menu_disabled = false end
  if GR.show_online_status == nil then GR.show_online_status = true end
  if GR.show_mode_indicator == nil then GR.show_mode_indicator = true end
  if S.score_preview_enabled == nil then S.score_preview_enabled = false end
  if GR.performance_mode == nil then GR.performance_mode = false end
  S.joker_display = false
  if S.drag_select == nil then S.drag_select = true end
  if S.fast_score_resolve == nil then S.fast_score_resolve = 1.0 end
  if S.jimbo_comments_enabled == nil then S.jimbo_comments_enabled = false end
  if S.skip_score_animation == nil then S.skip_score_animation = false end
  if S.haptic_feedback == nil then S.haptic_feedback = true end
  if S.haptic_intensity == nil then S.haptic_intensity = 50 end
  if S.mute_unfocused == nil then S.mute_unfocused = false end
  if S.default_hand_sort == nil then S.default_hand_sort = 1 end
  if S.keyboard_play == nil then S.keyboard_play = true end
  if S.safe_sell == nil then S.safe_sell = false end
  if S.spectate_follow == nil then S.spectate_follow = true end
  GR.filter_type = GR.filter_type or 1
  GR.filter_intensity = GR.filter_intensity or 50
  GR.rainbow_speed = GR.rainbow_speed or 50
r 9 1136 %20%20 -
l 183
end

local function settings_mp_locked(key)
  return (FairLock and FairLock.mp_setting_locked and FairLock.mp_setting_locked(key)) or false
end

local function settings_find(list, value, default)
  for i, v in ipairs(list) do if v == value then return i end end
  return default or 1
end

local function settings_tab_game()
  local S = G.SETTINGS
  local function mp_rule(what) return bom_match and bom_match.speed_rule and bom_match.speed_rule(what) or false end
  local mp_speed, mp_score, mp_skip = mp_rule("speed"), mp_rule("score"), mp_rule("skip")
  local speeds = mp_speed and {0.5, 1, 2, 4} or {0.5, 1, 2, 4, 6, 8, 10, 12, 16, 20}
  local scores = {1.0, 0.75, 0.5, 0.25, 0}
  local done = S.tutorial_complete and not G.OVERLAY_TUTORIAL
  local ov_done = G.FUNCS.overhaul_tutorial_done and G.FUNCS.overhaul_tutorial_done() or false
  local mp_info = mod_loc("Locked in multiplayer")
  local items = {
    UIK.header(mod_loc("Speed")),
    UIK.cycle{id = 'set_gamespeed', label = localize('b_set_gamespeed'), info = mp_speed and mod_loc("Up to 4x in multiplayer") or mod_loc("How fast the whole game plays"), options = speeds, current = settings_find(speeds, S.GAMESPEED, 2),
      callback = function(i, v) G.FUNCS.change_gamespeed{to_key = i, to_val = v} settings_save() end},
    UIK.cycle{id = 'set_score_speed', label = mod_loc("Score Speed"), info = mp_score and mp_info or mod_loc("Speed of the scoring count"), options = {'100%', '75%', '50%', '25%', mod_loc("Instant")}, current = settings_find(scores, S.fast_score_resolve, 1),
      disabled = mp_score, callback = function(i) G.FUNCS.change_score_speed{to_key = i} end},
    UIK.toggle{id = 'set_skip_score', label = mod_loc("Skip Score Animation"), info = mp_skip and mp_info or mod_loc("Jump straight to the final score"), ref_table = S, ref_value = 'skip_score_animation', disabled = mp_skip, callback = settings_save},
    UIK.header(mod_loc("Hand")),
    UIK.cycle{id = 'set_play_pos', label = localize('b_set_play_discard_pos'), info = mod_loc("Side of the Play and Discard buttons"), options = localize('ml_play_discard_pos_opt'), current = S.play_button_pos or 1,
      callback = function(i) G.FUNCS.change_play_discard_position{to_key = i} settings_save() end},
    UIK.header(mod_loc("Run")),
    UIK.toggle{id = 'set_stake_sticker', label = mod_loc("Display Stake Sticker"), info = mod_loc("Show the stake sticker during runs"), ref_table = S, ref_value = 'run_stake_stickers', callback = settings_save},
    UIK.action{id = 'set_replay_tutorial', label = mod_loc("Balatro tutorial"), info = mod_loc("Your first run with Jimbo's tips"), button_label = mod_loc("Play"), button = 'start_tutorial', colour = UIK.C.accent,
      disabled = G.GAME and G.GAME.multiplayer and G.STAGE == G.STAGES.RUN},
    UIK.action{id = 'set_skip_tutorial', label = mod_loc("Skip Balatro tutorial"), info = done and mod_loc("The Balatro tutorial is done") or mod_loc("Mark Jimbo's first run as done"),
      button_label = done and mod_loc("Done") or mod_loc("Skip"), button = 'skip_vanilla_tutorial', colour = UIK.C.warn, disabled = done},
    UIK.action{id = 'set_replay_overhaul_tutorial', label = mod_loc("Overhaul tutorial"), info = G.STAGE == G.STAGES.MAIN_MENU and mod_loc("Hologram shows every Overhaul feature") or mod_loc("Open it from the main menu"),
      button_label = mod_loc("Play"), button = 'replay_overhaul_tutorial', colour = UIK.C.accent, disabled = G.STAGE ~= G.STAGES.MAIN_MENU},
    UIK.action{id = 'set_skip_overhaul_tutorial', label = mod_loc("Skip Overhaul tutorial"), info = ov_done and mod_loc("The Overhaul tutorial is done") or mod_loc("No tour and no Hologram tips"),
      button_label = ov_done and mod_loc("Done") or mod_loc("Skip"), button = 'skip_overhaul_tutorial', colour = UIK.C.warn, disabled = ov_done},
  }
  local kp = Extras and Extras.modules and Extras.modules.keyboard_play
  if Controls and Controls.settings_rows then
    for _, r in ipairs(Controls.settings_rows()) do items[#items+1] = r end
  elseif kp and not kp.touch_only() then
    items[#items+1] = UIK.header(mod_loc("Keyboard"))
    items[#items+1] = UIK.toggle{id = 'set_keyboard_play', label = mod_loc("Keyboard play"), info = mod_loc("Play a whole run with the keyboard"), ref_table = S, ref_value = 'keyboard_play',
      callback = function(v) Extras.set('keyboard_play', v) settings_save() UIK.refresh() end}
    items[#items+1] = UIK.action{id = 'set_keyboard_binds', label = mod_loc("Keyboard keys"), info = mod_loc("See and change every key"), button_label = mod_loc("Open"), button = 'open_keyboard_binds', colour = UIK.C.accent, disabled = not kp.enabled()}
  end
  if Speedrun and Speedrun.settings_rows then Speedrun.settings_rows(items) end
  return UIK.flow{id = 'set_game', items = items, sections = true}
end

local function settings_tab_helpers()
  local S = G.SETTINGS
  local lock_opt = settings_mp_locked('hand_optimizer')
  local rates = {mod_loc("Rarely"), mod_loc("Sometimes"), mod_loc("Often")}
  local items = {
    UIK.header(mod_loc("Hand Optimizer")),
    UIK.toggle{id = 'set_optimizer', label = mod_loc("Hand Optimizer"), info = lock_opt and mod_loc("Locked by the host") or mod_loc("Suggests the best hand to play"), ref_table = S, ref_value = 'hand_optimizer', disabled = lock_opt, callback = settings_save},
    UIK.header(mod_loc("Jimbo")),
    UIK.toggle{id = 'set_jimbo_comments', label = mod_loc("Jimbo Comments"), info = mod_loc("Jimbo reacts to what happens"), ref_table = S, ref_value = 'jimbo_comments_enabled', callback = settings_save},
    UIK.cycle{id = 'set_jimbo_rate', label = mod_loc("How often Jimbo talks"), info = mod_loc("From quiet to chatty"), options = rates, current = S.jimbo_comments_rate or 2,
      callback = function(i) S.jimbo_comments_rate = i settings_save() end},
  }
  return UIK.flow{id = 'set_helpers', items = items, sections = true}
end

local function settings_window_dirty()
  local q, W = G.SETTINGS.QUEUED_CHANGE or {}, G.SETTINGS.WINDOW
  return (q.screenmode and q.screenmode ~= W.screenmode) or q.screenres or q.vsync or (q.selected_display and q.selected_display ~= W.selected_display) or false
end

local function settings_tab_display()
  local GR = G.SETTINGS.GRAPHICS
  local items = {}
  local fps_cap = UIK.cycle{id = 'set_fps_cap', label = mod_loc("FPS Cap"), info = mod_loc("Lower saves battery"), options = {"30", "40", "60", "90", "120", "144", "165", mod_loc("UNCAPPED")}, current = GR.fps_cap,
    callback = function(i) G.FUNCS.change_fps_cap{to_key = i} end}
  if G.F_VIDEO_SETTINGS then
    local W, q = G.SETTINGS.WINDOW, G.SETTINGS.QUEUED_CHANGE
    local disp = q.selected_display or W.selected_display
    local mode = q.screenmode or W.screenmode
    local res_option = GET_DISPLAYINFO(mode, disp)
    local res = W.DISPLAYS[disp].screen_resolutions
    if q.screenres then
      for i, v in ipairs(res.values) do if v.w == q.screenres.w and v.h == q.screenres.h then res_option = i break end end
    end
    local vsync_on = (q.vsync or W.vsync) ~= 0
    items[#items+1] = UIK.header(mod_loc("Window"))
    items[#items+1] = UIK.cycle{id = 'set_screenmode', label = localize('b_set_windowmode'), info = mod_loc("Windowed, fullscreen or borderless"), options = localize('ml_windowmode_opt'), current = ({Windowed = 1, Fullscreen = 2, Borderless = 3})[mode] or 1,
      callback = function(i) q.screenmode = ({"Windowed", "Fullscreen", "Borderless"})[i] q.screenres = nil UIK.refresh() end}
    items[#items+1] = UIK.cycle{id = 'set_resolution', label = mod_loc("Resolution"), info = mod_loc("Size of the game window"), options = res.strings, current = res_option or 1,
      callback = function(i) G.FUNCS.change_screen_resolution{to_key = i} UIK.refresh() end}
    items[#items+1] = UIK.action{id = 'set_apply_window', label = mod_loc("Apply Window Changes"), info = settings_window_dirty() and mod_loc("You have changes to apply") or mod_loc("Nothing to apply"),
      button_label = localize('b_set_apply'), button = 'settings_apply_window', colour = UIK.C.ok, disabled = not settings_window_dirty()}
    items[#items+1] = UIK.header(mod_loc("Screen"))
    items[#items+1] = UIK.cycle{id = 'set_monitor', label = localize('b_set_monitor'), info = mod_loc("Screen the game opens on"), options = W.display_names, current = disp,
      callback = function(i) q.selected_display = i UIK.refresh() end}
    items[#items+1] = UIK.cycle{id = 'set_vsync', label = mod_loc("VSync"), info = mod_loc("Stops screen tearing"), options = localize('ml_vsync_opt'), current = vsync_on and 1 or 2,
      callback = function(i) q.vsync = ((i == 1 and 1 or 0) ~= W.vsync) and (i == 1 and 1 or 0) or nil UIK.refresh() end}
    items[#items+1] = fps_cap
  else
    items[#items+1] = UIK.header(mod_loc("Frame Rate"))
    items[#items+1] = fps_cap
  end
  items[#items+1] = UIK.header(mod_loc("Performance"))
  items[#items+1] = UIK.toggle{id = 'set_perf', label = mod_loc("Performance Mode"), info = mod_loc("Lighter shaders for slow devices"), ref_table = GR, ref_value = 'performance_mode', callback = G.FUNCS.toggle_performance_mode}
  items[#items+1] = UIK.action{id = 'set_perf_settings', label = mod_loc("Performance Settings"), info = mod_loc("Resolution, particles, memory"), button_label = mod_loc("Open"), button = 'open_performance_settings', colour = UIK.C.warn}
  return UIK.flow{id = 'set_display', items = items, sections = true}
end

local function settings_tab_interface()
  local GR = G.SETTINGS.GRAPHICS
  G.UI_SIZE_EDIT = G.UI_SIZE_EDIT or {value = math.floor((G.UI_SIZE or 1)*(G.UI_SIZE_EXTRA or 1)*100 + 0.5)}
  local fill_i = math.floor(window_fill()*100 + 0.5)
  local items = {
    UIK.header(mod_loc("Scale")),
    UIK.slider{id = 'set_ui_size', label = mod_loc("UI Size"), info = mod_loc("Scale of the whole interface"), ref_table = G.UI_SIZE_EDIT, ref_value = 'value', min = UI_SIZE_MIN*100, max = math.floor(ui_size_max()*UI_SIZE_OVER*100 + 0.5),
      callback = function() G.UI_SIZE_PENDING = true end},
    UIK.cycle{id = 'set_window_size', label = mod_loc("Window Size"), info = mod_loc("How much of the screen menus fill"), options = {mod_loc("Classic"), "75%", "80%", "85%", "90%", "95%"},
      current = ({[0] = 1, [75] = 2, [80] = 3, [85] = 4, [90] = 5, [95] = 6})[fill_i] or 4,
      callback = function(i) GR.window_size = i settings_save() end},
    UIK.header(mod_loc("On Screen")),
    UIK.toggle{id = 'set_online', label = mod_loc("Online Status"), info = mod_loc("Server status in the corner"), ref_table = GR, ref_value = 'show_online_status', callback = settings_save},
    UIK.toggle{id = 'set_mode', label = mod_loc("Mode Indicator"), info = mod_loc("Normal or modded label in the corner"), ref_table = GR, ref_value = 'show_mode_indicator', callback = settings_save},
    UIK.toggle{id = 'set_show_fps', label = mod_loc("Show FPS Counter"), info = mod_loc("Drag it to move it"), ref_table = GR, ref_value = 'show_fps', callback = function() settings_save() UIK.refresh() end},
    UIK.header(mod_loc("FPS Counter")),
    UIK.slider{id = 'set_fps_opacity', label = mod_loc("FPS Opacity"), info = mod_loc("How see-through the counter is"), ref_table = GR, ref_value = 'fps_opacity', min = 0, max = 100, disabled = not GR.show_fps, callback = settings_save},
    UIK.action{id = 'set_fps_reset', label = mod_loc("Reset FPS Position"), info = mod_loc("Back to the default corner"), button_label = mod_loc("Reset"), button = 'reset_fps_position', colour = UIK.C.danger, disabled = not GR.show_fps},
  }
  return UIK.flow{id = 'set_interface', items = items, sections = true}
end

local function settings_tab_graphics()
  local GR = G.SETTINGS.GRAPHICS
  local items = {
    UIK.header(mod_loc("Look")),
    UIK.cycle{id = 'set_shadows', label = localize("b_set_shadows"), info = mod_loc("Drop shadows under cards"), options = localize('ml_shadow_opt'), current = GR.shadows == 'On' and 1 or 2,
      callback = function(i) G.FUNCS.change_shadows{to_key = i} end},
    UIK.cycle{id = 'set_smoothing', label = localize("b_set_pixel_smoothing"), info = mod_loc("Soft or sharp pixels"), options = localize('ml_smoothing_opt'), current = GR.texture_scaling or 2,
      callback = function(i) G.FUNCS.change_pixel_smoothing{to_key = i} end},
    suit_palette_setting_row and suit_palette_setting_row(settings_save) or UIK.toggle{id = 'set_contrast', label = localize('b_high_contrast_cards'), info = mod_loc("Easier to tell suits apart"), ref_table = G.SETTINGS, ref_value = 'colourblind_option', callback = function() G.FUNCS.refresh_contrast_mode() settings_save() end},
    UIK.header(mod_loc("Effects")),
    UIK.slider{id = 'set_crt', label = localize('b_set_CRT'), info = mod_loc("Old TV screen effect"), ref_table = GR, ref_value = 'crt', min = 0, max = 100, callback = settings_save},
    UIK.slider{id = 'set_shake', label = localize('b_set_screenshake'), info = mod_loc("Shake on big scores"), ref_table = G.SETTINGS, ref_value = 'screenshake', min = 0, max = 100, callback = settings_save},
    UIK.toggle{id = 'set_motion', label = localize('b_reduced_motion'), info = mod_loc("Fewer moving backgrounds"), ref_table = G.SETTINGS, ref_value = 'reduced_motion', callback = settings_save},
    UIK.header(mod_loc("Colour Filter")),
    UIK.cycle{id = 'set_filter', label = mod_loc("Filter Type"), info = mod_loc("Tints the whole screen"), options = {mod_loc("None"), mod_loc("Sepia"), mod_loc("B&W"), mod_loc("Rainbow RGB")}, current = GR.filter_type,
      callback = function(i) G.FUNCS.change_filter_type{to_key = i} settings_save() UIK.refresh() end},
    UIK.slider{id = 'set_filter_int', label = mod_loc("Filter Intensity"), info = mod_loc("Strength of the filter"), ref_table = GR, ref_value = 'filter_intensity', min = 0, max = 100, disabled = GR.filter_type == 1, callback = settings_save},
  }
  if suit_palette_custom_rows then suit_palette_custom_rows(items, settings_save) end
  if GR.filter_type == 4 then
    items[#items+1] = UIK.slider{id = 'set_rainbow', label = mod_loc("Rainbow Speed"), info = mod_loc("How fast the colours cycle"), ref_table = GR, ref_value = 'rainbow_speed', min = 10, max = 200, callback = settings_save}
  end
  return UIK.flow{id = 'set_graphics', items = items, sections = true}
end

