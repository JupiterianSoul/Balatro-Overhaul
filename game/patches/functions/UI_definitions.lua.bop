function ui_text_width(text, scale)
  local f = G.LANG and G.LANG.font
  if not f or not f.FONT then return 0 end
  return f.FONT:getWidth(tostring(text or '')) * f.squish * (scale or 1) * f.FONTSCALE / G.TILESIZE
end

function create_toggle_group(list, opts)
  opts = opts or {}
  local widest = 0
  for _, a in ipairs(list) do
    local lw = ui_text_width(a.label or 'TEST?', a.label_scale or 0.4)
    local cap = a.w or 3
    if cap > 0 and lw > cap then lw = cap end
    if lw > widest then widest = lw end
  end
  local rows = {}
  for _, a in ipairs(list) do
    a.label_w = widest
    a.col = nil
    rows[#rows+1] = create_toggle(a)
  end
  return {n = opts.col == false and G.UIT.R or G.UIT.C, config = {align = opts.align or "cm", padding = opts.padding or 0}, nodes = rows}
