    items[#items+1] = UIK.slider{id = 'set_rainbow', label = mod_loc("Rainbow Speed"), info = mod_loc("How fast the colours cycle"), ref_table = GR, ref_value = 'rainbow_speed', min = 10, max = 200, callback = settings_save}
  end
