  local map = {Game = settings_tab_game, QoL = QOL and QOL.settings_tab or nil, Helpers = settings_tab_helpers, Display = settings_tab_display, Video = settings_tab_display, Interface = settings_tab_interface,
    Graphics = settings_tab_graphics, Audio = settings_tab_audio, Account = settings_tab_account, Other = settings_tab_account,
    Guide = settings_tab_guide, Debug = BOM_DEBUG_BUILD and settings_tab_debug or nil}
  settings_defaults()
  if map[tab] then return map[tab]() end
  return vanilla_settings_tab(tab)
end

