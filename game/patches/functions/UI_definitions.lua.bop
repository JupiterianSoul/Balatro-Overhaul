function create_UIBox_your_collection_stakes()
  local stake_list = {}
  for k, v in pairs(G.P_STAKES) do
    table.insert(stake_list, {key = k, data = v})
  end
  table.sort(stake_list, function(a, b) return (a.data.order or 0) < (b.data.order or 0) end)

  local stake_descriptions = {
    stake_white = "Base difficulty. No modifiers.",
    stake_red = "+1 required ante to win.",
    stake_green = "Required score scales faster.",
    stake_black = "Shop can have Eternal jokers.",
    stake_blue = "Shop items cost $1 more. Rerolls go up $2 each.",
    stake_purple = "Required score scales even faster.",
    stake_orange = "Shop can have Perishable jokers.",
    stake_gold = "Shop can have Rental jokers.",
    stake_chaos = "Booster Packs have -1 choice.",
    stake_apocalypse = "Boss Blinds gain an additional effect.",
    stake_oblivion = "1 random Joker slot disabled each round.",
    stake_transcendent = "Boss Blinds are always Finisher Blinds.",
  }

  local stake_colors = {
    stake_white = G.C.WHITE,
    stake_red = G.C.RED,
    stake_green = G.C.GREEN,
    stake_black = G.C.BLACK,
    stake_blue = G.C.BLUE,
    stake_purple = G.C.PURPLE,
    stake_orange = G.C.ORANGE,
    stake_gold = G.C.GOLD,
    stake_chaos = HEX('1a3a6b'),
    stake_apocalypse = HEX('8b0000'),
    stake_oblivion = G.C.BLACK,
    stake_transcendent = HEX('e8d5b7'),
  }

  local highest_stake_beaten = 0
  if G.PROFILES and G.SETTINGS and G.PROFILES[G.SETTINGS.profile] then
    local profile = G.PROFILES[G.SETTINGS.profile]
    if profile.all_unlocked or profile.debug_unlocked then
      highest_stake_beaten = 13
    elseif profile.deck_usage then
      for _, deck in pairs(profile.deck_usage) do
        if deck.wins then
          for s, _ in pairs(deck.wins) do
            if type(s) == "number" and s > highest_stake_beaten then
              highest_stake_beaten = s
            end
          end
        end
      end
    end
    if profile.stake_progress then
      for i = 1, 13 do
        if profile.stake_progress[i] and i > highest_stake_beaten then
          highest_stake_beaten = i
        end
      end
    end
  end

  local stake_matrix = {}
  for k, entry in ipairs(stake_list) do
    local v = entry.data
    local stake_level = v.stake_level or v.order or 0
    local is_unlocked = stake_level <= 1 or stake_level <= (highest_stake_beaten + 1)
    local col  = stake_colors[entry.key] or G.C.WHITE
    local desc = stake_descriptions[entry.key] or ""

    local temp_sprite
    if stake_level >= 9 and type(get_stake_sprite) == "function" then
      temp_sprite = get_stake_sprite(stake_level, 1.0)
    else
      temp_sprite = Sprite(0, 0, 1.0, 1.0, G.ASSET_ATLAS['chips'], v.pos or {x=0,y=0})
    end

    temp_sprite.states.hover.can    = true
    temp_sprite.states.drag.can     = false
    temp_sprite.states.collide.can  = true
    temp_sprite:tilt_on_touch()
    temp_sprite.config = {force_focus = true}

    local ok_name, loc_name = pcall(localize, {type = 'name_text', set = 'Stake', key = entry.key})
    local display_name  = (ok_name and type(loc_name) == "string" and loc_name ~= "ERROR" and loc_name) or v.name
    local display_level = tostring(v.stake_level or v.order or "?")
    local display_desc  = desc
    local display_col   = col == G.C.BLACK and G.C.UI.TEXT_LIGHT or col

    local popup_nodes = {
      {n=G.UIT.R, config={align="cm"}, nodes={
        {n=G.UIT.T, config={text=display_name, scale=0.4, colour=display_col, shadow=true}}
      }},
      {n=G.UIT.R, config={align="cm", padding=0.03}, nodes={
        {n=G.UIT.T, config={text=mod_loc("Stake Level ")..display_level, scale=0.3, colour=G.C.WHITE}}
      }},
      {n=G.UIT.R, config={align="cm", padding=0.03, maxw=4}, nodes={
        {n=G.UIT.T, config={text=mod_loc(display_desc), scale=0.25, colour=G.C.UI.TEXT_LIGHT}}
      }},
      {n=G.UIT.R, config={align="cm", padding=0.03}, nodes={
        {n=G.UIT.T, config={text=is_unlocked and mod_loc("UNLOCKED") or mod_loc("LOCKED"), scale=0.28,
          colour=is_unlocked and G.C.GREEN or G.C.RED}}
      }},
    }
    if not is_unlocked then
      table.insert(popup_nodes, {n=G.UIT.R, config={align="cm", padding=0.03, maxw=4}, nodes={
        {n=G.UIT.T, config={text=mod_loc("Reach the previous stake to unlock this."), scale=0.25, colour=G.C.UI.TEXT_INACTIVE}}
      }})
    end

    temp_sprite.hover = function()
r 2 429 %20%20%20%20%20%20 -
l 4
        if not temp_sprite.hovering and temp_sprite.states.visible then
          temp_sprite.hovering = true
          temp_sprite.hover_tilt = 3
          temp_sprite:juice_up(0.05, 0.02)
r 2 434 %20%20%20%20%20%20%20%20%20%20 -
l 34
          temp_sprite.config.h_popup = {n=G.UIT.ROOT, config={align="cm", r=0.1, colour=G.C.L_BLACK, padding=0.1}, nodes=popup_nodes}
          temp_sprite.config.h_popup_config = {align='cl', offset={x=-0.1,y=0}, parent=temp_sprite}
          Node.hover(temp_sprite)
        end
      end
      temp_sprite.stop_hover = function() temp_sprite.hovering = false; Node.stop_hover(temp_sprite); temp_sprite.hover_tilt = 0 end
    end

    local row_idx = math.ceil(k / 4)
    if not stake_matrix[row_idx] then stake_matrix[row_idx] = {} end
    table.insert(stake_matrix[row_idx], {n=G.UIT.C, config={align="cm", padding=0.10}, nodes={
      {n=G.UIT.O, config={object=temp_sprite, focus_with_object=true}},
    }})
  end

  local matrix_rows = {}
  for _, row in ipairs(stake_matrix) do
    if #row > 0 then
      table.insert(matrix_rows, {n=G.UIT.R, config={align="cm", padding=0.05}, nodes=row})
    end
  end

  local t = create_UIBox_generic_options({back_func='your_collection', contents={
    {n=G.UIT.R, config={align="cm", padding=0.05}, nodes={
      {n=G.UIT.T, config={text=mod_loc("STAKES"), scale=0.5, colour=G.C.GOLD, shadow=true}}
    }},
    {n=G.UIT.R, config={align="cm", padding=0.03}, nodes={
      {n=G.UIT.T, config={text=#stake_list.." "..mod_loc("difficulty stakes"), scale=0.28, colour=G.C.UI.TEXT_INACTIVE}}
    }},
    {n=G.UIT.R, config={align="cm", r=0.1, colour=G.C.BLACK, emboss=0.05, padding=0.15}, nodes=matrix_rows},
  }})
  return t
end

