local function settings_tab_guide()
  local t = UIK.touch()
  local pad = t and 0.07 or 0.06
  local h = t and 0.76 or 0.66
  local bw = (UIK.W - UIK.GAP - 4*UIK.PAD) / 4 - 2*pad - 0.02
  local rows_per = t and 5 or 6
  local n = math.max(math.ceil(#SETTINGS_GUIDE / (3 * rows_per)), math.ceil(#SETTINGS_GUIDE_MP / rows_per), 1)
  local idx = math.max(1, math.min(UIK._pages.set_guide or 1, n))
  UIK._pages.set_guide = idx
  local pager_h = n > 1 and ((t and 0.82 or 0.66) + 0.12) or 0
  local function card(title, list, per_row, colour)
    local btns = {}
    local per_page = per_row * rows_per
    for i = (idx - 1) * per_page + 1, math.min(#list, idx * per_page) do
      local g = list[i]
      btns[#btns+1] = UIK.button{id = 'set_guide_'..g[2], label = mod_loc(g[1]), button = g[2], colour = colour, w = bw, h = h}
    end
    local inner = per_row * (bw + 2*pad) + 0.02
    return {n=G.UIT.C, config={align = "tm", minw = inner + 2*UIK.PAD, minh = UIK.H - UIK.TOP - pager_h, r = 0.12, padding = UIK.PAD, colour = UIK.C.section}, nodes={
      UIK.header(title, {w = inner}),
      #btns > 0 and UIK.grid(btns, per_row, {w = inner, padding = pad}) or nil,
    }}
  end
  local rows = {{n=G.UIT.R, config={align = "tm", padding = 0}, nodes={
    card(mod_loc("Overhaul"), SETTINGS_GUIDE, 3, UIK.C.accent),
    {n=G.UIT.B, config={w = UIK.GAP, h = 0.1}},
    card(mod_loc("Multiplayer"), SETTINGS_GUIDE_MP, 1, UIK.C.warn),
  }}}
  if n > 1 then
    rows[2] = UIK.pager{prev = 'uik_page', next = 'uik_page', prev_ref = {id = 'set_guide', d = -1, n = n}, next_ref = {id = 'set_guide', d = 1, n = n},
      text = string.format(mod_loc("Page %d of %d"), idx, n), w = UIK.W}
  end
  return {n=G.UIT.R, config={align = "tm", minw = UIK.W, padding = 0}, nodes = rows}
end

local function settings_tab_debug()
  local on = DebugManager and DebugManager.is_enabled and DebugManager.is_enabled()
  if not on then
    return UIK.flow{id = 'set_debug', items = {
      UIK.header(mod_loc("Debug Mode"), {colour = UIK.C.danger}),
      UIK.action{id = 'set_debug_unlock', label = mod_loc("Unlock Debug"), info = mod_loc("Developer access, needs a PIN"), button_label = mod_loc("Unlock"), button = 'open_debug_pin', colour = UIK.C.warn},
    }}
  end
  return UIK.flow{id = 'set_debug', items = {
    UIK.header(mod_loc("Debug Active"), {colour = UIK.C.ok}),
    UIK.action{id = 'set_debug_content', label = mod_loc("Content Unlock"), info = mod_loc("Unlock cards, decks and more"), button_label = mod_loc("Open"), button = 'open_debug_menu_overlay', colour = UIK.C.ok},
    UIK.action{id = 'set_debug_coin', label = mod_loc("+10000 Balacoin"), info = mod_loc("Adds coins to this profile"), button_label = mod_loc("Add"), button = 'debug_add_balacoin', colour = UIK.C.money},
    UIK.action{id = 'set_debug_xp', label = mod_loc("+50000 XP"), info = mod_loc("Adds XP to this profile"), button_label = mod_loc("Add"), button = 'debug_add_xp', colour = UIK.C.add},
    UIK.action{id = 'set_debug_lock', label = mod_loc("Lock Debug"), info = mod_loc("Turns debug mode off"), button_label = mod_loc("Lock"), button = 'debug_reset', colour = UIK.C.danger},
  }}
end

function create_UIBox_settings(selected_tab)
  local new_ui = rawget(_G, "SettingsUI")
  if new_ui and new_ui.window then
    local ok, def = pcall(new_ui.window, selected_tab)
    if ok and def then return def end
    print("[Settings] new window failed: " .. tostring(def))
  end
  settings_defaults()
  local tabs = {
    {key = 'Game', label = localize('b_set_game'), build = settings_tab_game},
    QOL and QOL.settings_tab and {key = 'QoL', label = mod_loc("QoL"), build = QOL.settings_tab} or false,
    {key = 'Helpers', label = mod_loc("Helpers"), build = settings_tab_helpers},
    {key = 'Display', label = mod_loc("Display"), build = settings_tab_display},
    {key = 'Interface', label = mod_loc("Interface"), build = settings_tab_interface},
    {key = 'Graphics', label = localize('b_set_graphics'), build = settings_tab_graphics},
    {key = 'Audio', label = localize('b_set_audio'), build = settings_tab_audio},
    {key = 'Jukebox', label = mod_loc("Jukebox"), build = function() return G.UIDEF.jukebox_tab() end},
    {key = 'Account', label = mod_loc("Account"), build = settings_tab_account},
    {key = 'Guide', label = mod_loc("Guide"), build = settings_tab_guide},
    QOL and QOL.search_tab and {key = 'Search', label = mod_loc("Search"), build = QOL.search_tab} or false,
  }
  if BOM_DEBUG_BUILD and DebugManager and DebugManager.is_enabled and DebugManager.is_enabled() then
    tabs[#tabs+1] = {key = 'Debug', label = mod_loc("Debug"), build = settings_tab_debug}
  end
  local legacy = {Video = 'Display', Other = 'Game'}
  return UIK.window{
    id = 'settings',
    title = localize('b_settings'),
    tabs = tabs,
    tab = selected_tab and (legacy[selected_tab] or selected_tab) or nil,
    back_func = 'options',
  }
