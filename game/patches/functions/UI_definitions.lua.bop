local vanilla_settings, vanilla_settings_tab = create_UIBox_settings, G.UIDEF.settings_tab

local function settings_node_texts(node, out)
  if type(node) ~= 'table' then return out end
  if node.config and type(node.config.text) == 'string' then out[node.config.text] = true end
  if node.config and type(node.config.label) == 'string' then out[node.config.label] = true end
  for _, n in ipairs(node.nodes or {}) do settings_node_texts(n, out) end
  return out
end

function settings_mod_extras()
  local tabs, loose = {}, {}
  local cap
  local ct, cg = create_tabs, create_UIBox_generic_options
  create_tabs = function(args) cap = args and args.tabs; return {} end
  create_UIBox_generic_options = function() return {} end
  local ok, err = pcall(vanilla_settings)
  create_tabs, create_UIBox_generic_options = ct, cg
  if not ok then print("[Settings] mod tabs: " .. tostring(err)) end
  local own = {Game = true, Video = true, Graphics = true, Audio = true}
  for _, t in ipairs(ok and cap or {}) do
    if type(t) == 'table' and type(t.tab_definition_function) == 'function' and not (t.tab_definition_function == G.UIDEF.settings_tab and own[t.tab_definition_function_args]) then
      tabs[#tabs + 1] = t
    end
  end
  local ok2, def = pcall(vanilla_settings_tab, 'Game')
  if ok2 and type(def) == 'table' then
    local known = {}
    for _, k in ipairs({'b_set_gamespeed', 'b_set_play_discard_pos', 'b_set_rumble', 'b_set_screenshake', 'ph_display_stickers', 'b_high_contrast_cards', 'b_reduced_motion', 'b_set_crash_reports'}) do
      known[localize(k)] = true
    end
    for i = 1, table.maxn(def.nodes or {}) do
      local n = def.nodes[i]
      local own_row = false
      for s in pairs(settings_node_texts(n, {})) do if known[s] then own_row = true end end
      if type(n) == 'table' and not own_row then loose[#loose + 1] = n end
    end
  elseif not ok2 then
    print("[Settings] mod options: " .. tostring(def))
  end
  return tabs, loose
end

function create_UIBox_settings(selected_tab)
  local new_ui = rawget(_G, "SettingsUI")
  if new_ui and new_ui.window then
    local ok, def = pcall(new_ui.window, selected_tab)
    if ok and def then return def end
    print("[Settings] new window failed: " .. tostring(def))
  end
  settings_defaults()
  local tabs = {
    {key = 'Game', label = localize('b_set_game'), build = settings_tab_game},
    QOL and QOL.settings_tab and {key = 'QoL', label = mod_loc("QoL"), build = QOL.settings_tab} or false,
    {key = 'Helpers', label = mod_loc("Helpers"), build = settings_tab_helpers},
    {key = 'Display', label = mod_loc("Display"), build = settings_tab_display},
    {key = 'Interface', label = mod_loc("Interface"), build = settings_tab_interface},
    {key = 'Graphics', label = localize('b_set_graphics'), build = settings_tab_graphics},
    {key = 'Audio', label = localize('b_set_audio'), build = settings_tab_audio},
    {key = 'Jukebox', label = mod_loc("Jukebox"), build = function() return G.UIDEF.jukebox_tab() end},
    {key = 'Account', label = mod_loc("Account"), build = settings_tab_account},
    {key = 'Guide', label = mod_loc("Guide"), build = settings_tab_guide},
    QOL and QOL.search_tab and {key = 'Search', label = mod_loc("Search"), build = QOL.search_tab} or false,
  }
  if BOM_DEBUG_BUILD and DebugManager and DebugManager.is_enabled and DebugManager.is_enabled() then
    tabs[#tabs+1] = {key = 'Debug', label = mod_loc("Debug"), build = settings_tab_debug}
  end
  local legacy = {Video = 'Display', Other = 'Game'}
  return UIK.window{
    id = 'settings',
    title = localize('b_settings'),
    tabs = tabs,
    tab = selected_tab and (legacy[selected_tab] or selected_tab) or nil,
    back_func = 'options',
  }
end

