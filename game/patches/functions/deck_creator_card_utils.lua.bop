local function applyRandomAbilities(card_protos, config)
    if not card_protos or #card_protos == 0 then return end
    if not config then return end

    local abilities = {
        {key = "random_polychrome_cards", func = function(card) card.edition = "Polychrome" end},
        {key = "random_holographic_cards", func = function(card) card.edition = "Holographic" end},
        {key = "random_foil_cards", func = function(card) card.edition = "Foil" end},
        {key = "random_edition_cards", func = function(card)
            local editions = {"Foil", "Holographic", "Polychrome"}
            card.edition = editions[math.random(#editions)]
        end},
        {key = "random_bonus_cards", func = function(card) card.enhancement = "Bonus" end},
        {key = "random_glass_cards", func = function(card) card.enhancement = "Glass" end},
        {key = "random_lucky_cards", func = function(card) card.enhancement = "Lucky" end},
        {key = "random_steel_cards", func = function(card) card.enhancement = "Steel" end},
        {key = "random_stone_cards", func = function(card) card.enhancement = "Stone" end},
        {key = "random_wild_cards", func = function(card) card.enhancement = "Wild" end},
        {key = "random_mult_cards", func = function(card) card.enhancement = "Mult" end},
        {key = "random_gold_cards", func = function(card) card.enhancement = "Gold" end},
        {key = "random_enhancement_cards", func = function(card)
            local enhancements = {"Bonus", "Glass", "Lucky", "Steel", "Stone", "Wild", "Mult", "Gold"}
            card.enhancement = enhancements[math.random(#enhancements)]
        end},
    }

    for _, ability in ipairs(abilities) do
        local count = config[ability.key]
        if count and type(count) == "number" and count > 0 then
            local indices = {}
            for i = 1, #card_protos do indices[#indices+1] = i end
            shuffleDeck(indices)
            local applied = 0
            for _, idx in ipairs(indices) do
                if applied >= count then break end
                ability.func(card_protos[idx])
                applied = applied + 1
            end
        end
    end
end

function DeckCreatorCardUtils.initializeCustomCardList(deckObj)
    if not G then return end
    if not G.playing_cards then return end

    local config = deckObj and deckObj.config or (deckObj and deckObj.effect and deckObj.effect.config)
    if not config then return end
    if not config.customCardList or #config.customCardList == 0 then return end

    local ok, err = pcall(function()
        DeckCreatorCardUtils.flushGPlayingCards()

        local card_protos = {}
        for _, proto in ipairs(config.customCardList) do
            card_protos[#card_protos + 1] = {
                suit = proto.suit,
                rank = proto.rank,
                edition = proto.edition,
                enhancement = proto.enhancement,
                seal = proto.seal,
            }
        end

        if config.randomize_ranks then
            local ranks = DeckCreatorUtils.protoRanks()
            for _, card in ipairs(card_protos) do
                card.rank = ranks[math.random(#ranks)]
            end
        end
        if config.randomize_suits then
            local suits = DeckCreatorUtils.protoSuits()
            for _, card in ipairs(card_protos) do
                card.suit = suits[math.random(#suits)]
            end
        end

        if config.no_faces or config.remove_faces then
            local filtered = {}
            for _, card in ipairs(card_protos) do
                if card.rank ~= "J" and card.rank ~= "Q" and card.rank ~= "K" then
                    filtered[#filtered + 1] = card
                end
            end
            card_protos = filtered
        end
        if config.no_aces then
            local filtered = {}
            for _, card in ipairs(card_protos) do
                if card.rank ~= "A" then
                    filtered[#filtered + 1] = card
                end
            end
            card_protos = filtered
        end
        if config.no_numbered_cards then
            local filtered = {}
            local numbered = {["2"]=true,["3"]=true,["4"]=true,["5"]=true,["6"]=true,["7"]=true,["8"]=true,["9"]=true,["T"]=true,["10"]=true}
            for _, card in ipairs(card_protos) do
                if not numbered[card.rank] then
                    filtered[#filtered + 1] = card
                end
            end
            card_protos = filtered
        end

        applyRandomAbilities(card_protos, config)

        for _, proto in ipairs(card_protos) do
            pcall(function()
                DeckCreatorCardUtils.cardProtoToCardObject(proto)
            end)
        end
    end)
    if not ok then
        DeckCreatorUtils.log("Error initializing custom card list: " .. tostring(err))
        if G.playing_cards and #G.playing_cards == 0 then
            DeckCreatorUtils.log("CRITICAL: Deck empty after failed init - creating standard 52-card fallback")
            pcall(function()
                local suits = {'S','H','D','C'}
                local ranks = {'2','3','4','5','6','7','8','9','T','J','Q','K','A'}
                for _, s in ipairs(suits) do
                    for _, r in ipairs(ranks) do
                        pcall(function()
                            local _card = Card(G.deck.T.x, G.deck.T.y, G.CARD_W, G.CARD_H, G.P_CARDS[s..'_'..r], G.P_CENTERS.c_base)
                            _card:add_to_deck()
