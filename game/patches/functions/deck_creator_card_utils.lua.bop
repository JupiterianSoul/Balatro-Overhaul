function DeckCreatorCardUtils.getBannedBoostersFromBannedBoosterList(deck)
    if not G then return end
    if not deck or not deck.config then return end
    if not deck.config.bannedBoosterList or #deck.config.bannedBoosterList == 0 then return end

    for _, banned in ipairs(deck.config.bannedBoosterList) do
        pcall(function()
            local key = banned.id or banned.key
            if key and G.P_CENTERS[key] then
                DeckCreatorCardUtils.bannedItems.boosters[#DeckCreatorCardUtils.bannedItems.boosters + 1] = key
            end
        end)
    end
end

function DeckCreatorCardUtils.isStone(card)
    if not card then return false end
    return card.ability and card.ability.name == "Stone Card"
end

function DeckCreatorCardUtils.receiveRandomNegativeJoker()
    if not G then return end
    if not G.jokers then return end

    pcall(function()
        local _card = create_card("Joker", G.jokers, nil, nil, nil, nil, nil, nil)
        if _card then
            _card:set_edition({negative = true}, true, true)
            _card:add_to_deck()
            G.jokers:emplace(_card)
        end
    end)
end

function DeckCreatorCardUtils.destroyRandomJoker()
    if not G then return end
    if not G.jokers then return end
    if not G.jokers.cards or #G.jokers.cards == 0 then return end

    pcall(function()
        local pool = {}
        for _, c in ipairs(G.jokers.cards) do
            if not (c.ability and c.ability.eternal) and not c.getting_sliced then pool[#pool + 1] = c end
        end
        if #pool == 0 then return end
        local card = pool[math.random(#pool)]
        card.getting_sliced = true
        card:start_dissolve()
    end)
end

function DeckCreatorCardUtils.removeAllJokersFromShop()
    if not G then return end
    if not G.shop_jokers then return end
    if not G.shop_jokers.cards then return end

    for i = #G.shop_jokers.cards, 1, -1 do
        pcall(function()
            local card = G.shop_jokers.cards[i]
            if card then
                card:start_dissolve()
            end
        end)
    end
end

function DeckCreatorCardUtils.addFourJokersToShop()
    if not G then return end
    if not G.shop_jokers then return end

    for i = 1, 4 do
        pcall(function()
            local _card = create_card("Joker", G.shop_jokers, nil, nil, nil, nil, nil, nil)
            if _card then
                create_shop_card_ui(_card, "Joker", G.shop_jokers)
                G.shop_jokers:emplace(_card)
            end
        end)
    end
end

function DeckCreatorCardUtils.setupBigJokerShop()
    if not G then return end
    if not G.shop_jokers then return end

    DeckCreatorCardUtils.removeAllJokersFromShop()
    for i = 1, 8 do
        pcall(function()
            local _card = create_card("Joker", G.shop_jokers, nil, nil, nil, nil, nil, nil)
            if _card then
                create_shop_card_ui(_card, "Joker", G.shop_jokers)
                G.shop_jokers:emplace(_card)
            end
        end)
    end
end

function DeckCreatorCardUtils.applyAllBans(deck)
    if not deck then return end
    DeckCreatorCardUtils.flushBannedItems()
    DeckCreatorCardUtils.getBannedJokersFromBannedJokerList(deck)
    DeckCreatorCardUtils.getBannedTarotsFromBannedTarotList(deck)
    DeckCreatorCardUtils.getBannedPlanetsFromBannedPlanetList(deck)
    DeckCreatorCardUtils.getBannedSpectralsFromBannedSpectralList(deck)
    DeckCreatorCardUtils.getBannedVouchersFromBannedVoucherList(deck)
    DeckCreatorCardUtils.getBannedTagsFromBannedTagList(deck)
    DeckCreatorCardUtils.getBannedBlindsFromBannedBlindList(deck)
    DeckCreatorCardUtils.getBannedBoostersFromBannedBoosterList(deck)
end

function DeckCreatorCardUtils.applyAllStartingItems(deck)
    if not deck then return end
    DeckCreatorCardUtils.flushStartingItems()
    DeckCreatorCardUtils.getVouchersFromCustomVoucherList(deck)
    DeckCreatorCardUtils.getTagsFromCustomTagList(deck)
    if G.E_MANAGER then
        local _deck = deck
r 1 112 %20%20%20%20%20%20%20%20 -
l 12
            func = function()
                pcall(function()
                    DeckCreatorCardUtils.getJokersFromCustomJokerList(_deck)
                    DeckCreatorCardUtils.getTarotsFromCustomTarotList(_deck)
                    DeckCreatorCardUtils.getPlanetsFromCustomPlanetList(_deck)
                    DeckCreatorCardUtils.getSpectralsFromCustomSpectralList(_deck)
                end)
                return true
            end
        }))
    end
end
