function DeckCreatorCardUtils.getVouchersFromCustomVoucherList(deck)
    if not G then return end
    if not G.GAME then return end
    if not deck or not deck.config then return end
    if not deck.config.customVoucherList or #deck.config.customVoucherList == 0 then return end

    for _, voucherData in ipairs(deck.config.customVoucherList) do
        pcall(function()
            local key = voucherData.id or voucherData.key
            if not key or not G.P_CENTERS[key] then return end

            G.GAME.used_vouchers[key] = true
            local voucherCenter = G.P_CENTERS[key]
            if voucherCenter then
                Card.apply_to_run(nil, voucherCenter)
            end
            DeckCreatorCardUtils.startingItems.vouchers[#DeckCreatorCardUtils.startingItems.vouchers + 1] = key
        end)
    end
end

function DeckCreatorCardUtils.getTagsFromCustomTagList(deck)
    if not G then return end
    if not deck or not deck.config then return end
    if not deck.config.customTagList or #deck.config.customTagList == 0 then return end

    for _, tagData in ipairs(deck.config.customTagList) do
        pcall(function()
            local key = tagData.id or tagData.key
            if not key then return end
            DeckCreatorUtils.addTag(key)
            DeckCreatorCardUtils.startingItems.tags[#DeckCreatorCardUtils.startingItems.tags + 1] = key
        end)
    end
end

function DeckCreatorCardUtils.addItemToDeck(args)
    local deck = args.deck
    local itemType = args.type
    local key = args.key
    if not deck or not deck.config or not itemType or not key then return end

    local typeMap = {
        Joker = "customJokerList",
        Tarot = "customTarotList",
        Planet = "customPlanetList",
        Spectral = "customSpectralList",
        Voucher = "customVoucherList",
        Tag = "customTagList",
    }

    if itemType == "Random" then
        local types = {"Joker", "Tarot", "Planet", "Spectral", "Voucher", "Tag"}
        itemType = types[math.random(#types)]
        local keyFunc = {
            Joker = DeckCreatorUtils.jokerKeys,
            Tarot = DeckCreatorUtils.tarotKeys,
            Planet = DeckCreatorUtils.planetKeys,
            Spectral = DeckCreatorUtils.spectralKeys,
            Tag = DeckCreatorUtils.tagKeys,
        }
        if keyFunc[itemType] then
            local keys = keyFunc[itemType]()
            if #keys > 0 then
                key = keys[math.random(#keys)].id
            end
        elseif itemType == "Voucher" then
            local vouchers = DeckCreatorUtils.vouchers(true)
            if #vouchers > 0 then
                key = vouchers[math.random(#vouchers)].id
            end
        end
    end

    local listKey = typeMap[itemType]
    if not listKey then return end

    if not deck.config[listKey] then
        deck.config[listKey] = {}
    end

    local entry = {
        id = key,
        key = key,
        edition = args.edition or "None",
        eternal = args.eternal or false,
        pinned = args.pinned or false,
    }
    deck.config[listKey][#deck.config[listKey] + 1] = entry
end

function DeckCreatorCardUtils.banItem(args)
    local deck = args.deck
    local itemType = args.type
    local key = args.key
    if not deck or not deck.config or not itemType or not key then return end

    local typeMap = {
        Joker = "bannedJokerList",
        Tarot = "bannedTarotList",
        Planet = "bannedPlanetList",
        Spectral = "bannedSpectralList",
        Voucher = "bannedVoucherList",
        Tag = "bannedTagList",
        Blind = "bannedBlindList",
        Booster = "bannedBoosterList",
    }

    if itemType == "Random" then
        local types = {"Joker", "Tarot", "Planet", "Spectral", "Voucher", "Tag", "Blind", "Booster"}
        itemType = types[math.random(#types)]
        local keyFunc = {
            Joker = DeckCreatorUtils.jokerKeys,
            Tarot = DeckCreatorUtils.tarotKeys,
            Planet = DeckCreatorUtils.planetKeys,
            Spectral = DeckCreatorUtils.spectralKeys,
            Tag = DeckCreatorUtils.tagKeys,
            Blind = DeckCreatorUtils.blindKeys,
            Booster = DeckCreatorUtils.boosterKeys,
        }
        if keyFunc[itemType] then
            local keys = keyFunc[itemType]()
            if #keys > 0 then
                key = keys[math.random(#keys)].id
            end
        elseif itemType == "Voucher" then
            local vouchers = DeckCreatorUtils.vouchers(true)
            if #vouchers > 0 then
                key = vouchers[math.random(#vouchers)].id
            end
        end
    end

    local listKey = typeMap[itemType]
    if not listKey then return end

    if not deck.config[listKey] then
        deck.config[listKey] = {}
    end

    deck.config[listKey][#deck.config[listKey] + 1] = {
        id = key,
        key = key,
    }
end

function DeckCreatorCardUtils.getBannedJokersFromBannedJokerList(deck)
    if not G then return end
    if not deck or not deck.config then return end
    if not deck.config.bannedJokerList or #deck.config.bannedJokerList == 0 then return end

    for _, banned in ipairs(deck.config.bannedJokerList) do
        pcall(function()
            local key = banned.id or banned.key
            if key and G.P_CENTERS[key] then
                DeckCreatorCardUtils.bannedItems.jokers[#DeckCreatorCardUtils.bannedItems.jokers + 1] = key
            end
        end)
    end
end

