function T.swipe(dir)
    local mode = T.bind("swipe")
    if mode == "off" then return false end
    local K = kp()
    if mode == "move" and not G.OVERLAY_MENU and K and K.move_card then
        local card = T.selected_card() or T.single_hand_card()
        if card then
            K.move_card(card, dir)
            return true
        end
    end
    if T.next_tab(dir) then return true end
    if T.show_focus() then return true end
    pad(dir < 0 and "dpleft" or "dpright")
    return true
end

function T.wheel(x, y)
    if not T.can() then return false end
    if T.minigame() then return true end
    if y ~= 0 and math.abs(y) >= math.abs(x) and scroll_list_open() then return false end
    local now = love.timer.getTime()
    if now - T.last_t > T.IDLE then T.acc.x, T.acc.y = 0, 0 end
    T.last_t = now
    T.acc.x = math.max(-1, math.min(1, T.acc.x + (x or 0)))
    T.acc.y = math.max(-1, math.min(1, T.acc.y + (y or 0)))
    local horiz = math.abs(T.acc.x) > math.abs(T.acc.y)
    local v = horiz and T.acc.x or T.acc.y
    if math.abs(v) < 1 then return true end
    if now - T.last_step < T.GAP then return true end
    T.acc.x, T.acc.y = 0, 0
    T.last_step = now
    T.steps = T.steps + 1
    if horiz then T.swipe(v > 0 and 1 or -1) else T.scroll(v > 0 and -1 or 1) end
    return true
end

function T.back()
    local c = G.CONTROLLER
    local reg = c.button_registry and c.button_registry.b
    local r = reg and reg[1]
    if r and r.node and not r.node.REMOVED and not r.node.under_overlay and r.menu == (G.OVERLAY_MENU ~= nil) then
        r.node:click()
        return true
    end
