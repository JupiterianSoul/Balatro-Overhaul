    end
    if act == "speed" and not G.OVERLAY_MENU then
        local H = QOL and QOL.modules and QOL.modules.hotkeys
        if not H then return false end
        if not QOL.on("qol_speed_key") then pcall(play_sound, "cancel") return true end
        if C.refuse("speed_key") then return true end
        if H.speed_allowed() then H.cycle_speed(false) else pcall(play_sound, "cancel") end
        return true
    end
    if act == "run_info" and not G.OVERLAY_MENU and G.STAGE == G.STAGES.RUN and G.FUNCS.run_info then
        G.FUNCS.run_info({config = {}})
        return true
    end
    if act == "back" or G.OVERLAY_MENU then return T.back() end
    return false
end

function T.to_pointer()
    local cp = G.CONTROLLER.cursor_position
    T.moved = 0
    if not (cp and cp.x and cp.y) then return nil end
    pcall(love.mouse.setPosition, cp.x, cp.y)
    if T._mm then T._mm(cp.x, cp.y, 0, 0, false) end
    return cp.x, cp.y
end

function T.on_mode(m)
    T.acc.x, T.acc.y = 0, 0
    if T.tap_down then
        T.tap_down = nil
        pad("a", "up")
    end
    T.restore_drag()
end

function T.sweep_on()
    if not (C.trackpad_on() and T.bind("drag") == "off") then return false end
    if G.SETTINGS.drag_select == false or G.STATE ~= G.STATES.SELECTING_HAND or G.OVERLAY_MENU then return false end
    return G.hand ~= nil and not playback()
end

function T.toggle(card)
    local h = G.hand.highlighted or {}
    for _, x in ipairs(h) do
        if x == card then
            G.hand:remove_from_highlighted(card)
            return
        end
    end
    local limit = G.hand.config and G.hand.config.highlighted_limit or 5
    if #h < limit then G.hand:add_to_highlighted(card, false) end
end

function T.sweep_step(ctrl)
    local s = T.sweep
    if not s then return end
    if not T.sweep_on() or not ctrl.is_cursor_down then
        T.sweep = nil
        return
    end
    for _, node in ipairs(ctrl.collision_list or {}) do
        if is_card(node) and node.area == G.hand then
            if node ~= s.start and not s.active then
                s.active = true
                s.visited[s.start] = true
                pcall(play_sound, "card1", 1, 0.6)
                pcall(T.toggle, s.start)
            end
            if s.active and not s.visited[node] then
                s.visited[node] = true
                pcall(T.toggle, node)
            end
            break
        end
    end
end

function T.restore_drag()
    local n = T.undrag
    T.undrag = nil
    if n and n.states and n.states.drag and n.states.drag.can == false then n.states.drag.can = true end
end

function T.init()
    if T._wrapped or not (Controller and Controller.L_cursor_press) then return end
    T._wrapped = true

    local wheel = love.wheelmoved
    love.wheelmoved = function(x, y, ...)
        local ok, used = pcall(T.wheel, x, y)
        if ok and used then return end
        if not ok then print("[Trackpad] " .. tostring(used)) end
        if wheel then return wheel(x, y, ...) end
    end

    local mp = love.mousepressed
    love.mousepressed = function(x, y, button, touch, ...)
        if not touch and C.trackpad_on() then
            if button == 1 and T.can() and T.focus_shown() and not T.minigame() then
                local f = G.CONTROLLER.focused.target
                if is_card(f) and f.area ~= G.hand then
                    local fx, fy = T.to_pointer()
                    if fx then x, y = fx, fy end
                    return mp(x, y, button, touch, ...)
                end
                T.tap_down = true
                pad("a", "down")
                return
            end
            if button == 2 then
                local ok, used = pcall(T.two_tap)
                if ok and used then return end
                local r = mp(x, y, button, touch, ...)
                if DRAG_SELECT and T.bind("drag") == "off" then DRAG_SELECT._rclick_down = false end
                return r
            end
        end
        return mp(x, y, button, touch, ...)
    end

    local mr = love.mousereleased
    love.mousereleased = function(x, y, button, ...)
        if button == 1 and T.tap_down then
            T.tap_down = nil
            pad("a", "up")
            return
        end
        return mr(x, y, button, ...)
    end

    local mm = love.mousemoved
    T._mm = mm
    love.mousemoved = function(x, y, dx, dy, istouch, ...)
        if not istouch and C.trackpad_on() and T.focus_shown() and not T.tap_down and not T.minigame() then
            T.moved = T.moved + math.abs(dx or 0) + math.abs(dy or 0)
            if T.moved < T.MOVE_PX then return end
            local cp = G.CONTROLLER.cursor_position
            T.moved = 0
            if cp and cp.x and cp.y then
                pcall(love.mouse.setPosition, cp.x, cp.y)
                x, y = cp.x, cp.y
            end
        end
        return mm(x, y, dx, dy, istouch, ...)
    end

    local press = Controller.L_cursor_press
    Controller.L_cursor_press = function(self, x, y, ...)
        T.restore_drag()
        local r = press(self, x, y, ...)
        if C.trackpad_on() and T.bind("drag") == "off" and self.HID.mouse then
            local t = self.cursor_down and self.cursor_down.target
            if is_card(t) and t.states.drag.can then
                t.states.drag.can = false
                T.undrag = t
                T.down_xy = {x = x, y = y}
            end
            T.sweep = nil
            if is_card(t) and t.area == G.hand and T.sweep_on() then T.sweep = {start = t, visited = {}} end
        end
        return r
    end

    local upd = Controller.update
    if type(upd) == "function" then
        Controller.update = function(self, dt, ...)
            local r = upd(self, dt, ...)
            if T.sweep then
                local ok, err = pcall(T.sweep_step, self)
                if not ok then T.sweep = nil print("[Trackpad] sweep: " .. tostring(err)) end
            end
            return r
        end
    end

    local release = Controller.L_cursor_release
    Controller.L_cursor_release = function(self, x, y, ...)
        local s = T.sweep
        T.sweep = nil
        if s and s.active then
            T.restore_drag()
            T.down_xy = nil
            local r = release(self, x, y, ...)
r 23 1046 %20%20%20%20%20%20%20%20%20%20%20%20 -
l 21
            return r
        end
        local t = T.undrag
        if t and T.down_xy and x and y and self.hovering and self.hovering.target == t then
            x, y = T.down_xy.x, T.down_xy.y
        end
        local r = release(self, x, y, ...)
        T.restore_drag()
        T.down_xy = nil
        return r
    end

    local K = kp()
    if K and K.enabled and not K._controls_wrapped then
        K._controls_wrapped = true
        local en = K.enabled
        K.enabled = function() return C.keys_on() and en() end
    end
end

return T
end
