        return true
    end
    return false
end

function T.two_tap()
    if not T.can() then return false end
    local act = T.bind("two_tap")
    if act == "off" then return false end
    if T.minigame() and G.FUNCS.mg_close then
        G.FUNCS.mg_close()
        return true
    end
    if G.hand and G.hand.highlighted and G.hand.highlighted[1] and not G.SETTINGS.paused then return false end
