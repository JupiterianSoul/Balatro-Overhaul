local C = Controls
local T = {}

T.DEFAULTS = {scroll = "focus", swipe = "move", two_tap = "back", drag = "off"}
T.CHOICES = {
    scroll = {"focus", "off"},
    swipe = {"move", "focus", "off"},
    two_tap = {"back", "run_info", "speed", "off"},
    drag = {"off", "on"},
}
T.GAP = 0.09
T.IDLE = 0.25
T.MOVE_PX = 10
T.acc = {x = 0, y = 0}
T.last_t = 0
T.last_step = 0
T.moved = 0
T.steps = 0

function T.bind(g)
    local b = G.SETTINGS and G.SETTINGS.trackpad_binds
    local v = type(b) == "table" and b[g] or nil
    for _, c in ipairs(T.CHOICES[g] or {}) do if c == v then return v end end
    return T.DEFAULTS[g]
end

function T.set_bind(g, v)
    if not T.CHOICES[g] then return end
    local b = type(G.SETTINGS.trackpad_binds) == "table" and G.SETTINGS.trackpad_binds or {}
    G.SETTINGS.trackpad_binds = b
    b[g] = v
end

function T.reset_binds()
    G.SETTINGS.trackpad_binds = nil
end

local function kp()
    return Extras and Extras.modules and Extras.modules.keyboard_play
end

local function playback()
    local pb = rawget(_G, "bom_playback")
    return pb and pb.active and pb.active()
end

function T.minigame()
    local mg = rawget(_G, "Minigames")
    local h = mg and mg.host
    return h and h.win and not h.closing and true or false
end

function T.can()
    local c = G.CONTROLLER
    if not (c and C.trackpad_on()) then return false end
    if c.text_input_hook or c.screen_keyboard then return false end
    if c.locks and c.locks.frame then return false end
    if playback() then return false end
    return true
end

function T.focus_shown()
    local c = G.CONTROLLER
    return c and c.HID.controller and c.HID.keyboard and c.focused and c.focused.target ~= nil or false
end

local function pad(button, half)
    local c = G.CONTROLLER
    local K = kp()
    if K then K.from_kb = true end
    if half ~= "up" then
        local ok, err = pcall(love.gamepadpressed, c.keyboard_controller, button)
        if not ok then print("[Trackpad] " .. tostring(err)) end
    end
    if half ~= "down" then pcall(love.gamepadreleased, c.keyboard_controller, button) end
    if K then K.from_kb = nil end
    T.moved = 0
end
T.pad = pad

local function is_card(n)
    return type(n) == "table" and n.is and Card and n:is(Card) and not n.REMOVED
end

local function in_row(n)
    return is_card(n) and n.area and (n.area == G.jokers or n.area == G.consumeables)
end

function T.single_hand_card()
    if G.STATE ~= G.STATES.SELECTING_HAND or not G.hand then return nil end
    local h = G.hand.highlighted
    if h and #h == 1 and is_card(h[1]) and h[1].area == G.hand then return h[1] end
end

function T.selected_card()
    local c = G.CONTROLLER
    local f = c.focused and c.focused.target
    if in_row(f) and f.highlighted then return f end
    local h = c.hovering and c.hovering.target
    if in_row(h) and h.highlighted then return h end
    for _, a in ipairs({G.jokers, G.consumeables}) do
        local x = a and a.highlighted and a.highlighted[1]
        if in_row(x) then return x end
    end
end

local function scroll_list_open()
    local function walk(node, depth)
        if type(node) ~= "table" or depth > 30 then return false end
        if node.config and node.config.scroll_mult then return true end
        for _, ch in pairs(node.children or {}) do
            if walk(ch, depth + 1) then return true end
        end
        return false
    end
    return G.OVERLAY_MENU and walk(G.OVERLAY_MENU.UIRoot, 0) or false
end

local function focusable(n)
    local c = G.CONTROLLER
    local d = 0
    while type(n) == "table" and d < 12 do
        if n.states and c:is_node_focusable(n) then return n end
        n = n.parent
        d = d + 1
    end
end

function T.show_focus()
    if T.focus_shown() then return false end
    local c = G.CONTROLLER
    local n = focusable(c.hovering and c.hovering.target)
    if not n then return false end
    local K = kp()
    c:set_gamepad(c.keyboard_controller)
    if K then K.from_kb = true end
    c:set_HID_flags("button", "dpup")
    if K then K.from_kb = nil end
    local cc = c.cursor_context
    if cc and cc.stack and cc.layer then cc.stack[cc.layer] = nil end
    c.interrupt.stack = false
    c.interrupt.focus = false
    c:snap_to{node = n}
    T.moved = 0
    return true
end

local function step_row(f, dir)
    local cards = f.area.cards
    local i
    for k, v in ipairs(cards) do if v == f then i = k break end end
    local n = i and cards[i + dir]
    if n then G.CONTROLLER:snap_to{node = n} end
    T.moved = 0
    return true
end

function T.scroll(dir)
    if T.bind("scroll") == "off" then return false end
    if T.show_focus() then return true end
    local f = G.CONTROLLER.focused.target
    if is_card(f) and f.area and f.area.cards and not G.OVERLAY_MENU then return step_row(f, dir) end
    pad(dir < 0 and "dpup" or "dpdown")
    return true
end

function T.next_tab(dir)
    local e = G.OVERLAY_MENU and G.OVERLAY_MENU:get_UIE_by_ID("tab_shoulders")
    local first = e and e.children[1] and e.children[1].children[1]
    if not (first and e.UIBox) then return false end
    local choices = {}
    for _, v in ipairs(e.UIBox:get_group(nil, first.config.group) or {}) do
        if v.config.choice and v.config.button then choices[#choices + 1] = v end
    end
