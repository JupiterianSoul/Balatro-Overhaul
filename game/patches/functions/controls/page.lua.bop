local C = Controls
local P = {}
local L = function(s) return mod_loc(s) end

P.MODE_LABELS = {mouse = "Mouse", keyboard = "Keyboard", trackpad = "Trackpad", trackpad_keys = "Trackpad + keys", controller = "Controller"}
P.TITLES = {keyboard = "KEYBOARD KEYS", trackpad = "TRACKPAD GESTURES", trackpad_keys = "TRACKPAD AND KEYS"}
P.GESTURES = {
    {id = "scroll", label = "Two-finger scroll"},
    {id = "swipe", label = "Two-finger swipe"},
    {id = "two_tap", label = "Two-finger tap"},
    {id = "drag", label = "Drag cards"},
}
P.CHOICE_LABELS = {
    scroll = {focus = "Move the focus", off = "Off"},
    swipe = {move = "Move card or tab", focus = "Move the focus", off = "Off"},
    two_tap = {back = "Back", run_info = "Run Info", speed = "Speed up", off = "Off"},
    drag = {off = "Off", on = "On"},
}
P.HELP_TABS = {"keyboard", "trackpad", "trackpad_keys", "controller"}

local function kp()
    return Extras and Extras.modules and Extras.modules.keyboard_play
end

local function tp()
    return C.modules and C.modules.trackpad
end

local function pad()
    return C.modules and C.modules.pad
end

function P.pad_in_use()
    local c = G.CONTROLLER
    local o = c and c.GAMEPAD and c.GAMEPAD.object
    return c and c.HID.controller and not c.HID.keyboard and o ~= nil and o ~= c.keyboard_controller or false
end

local function save()
    if G and G.save_settings then pcall(function() G:save_settings() end) end
end

P.MODE_W = 6.4

local function mode_labels()
    local out = {}
    for i, m in ipairs(C.MODES) do out[i] = L(P.MODE_LABELS[m]) end
    return out
end

local function widest(labels, scale, min)
    local w = min
    for _, s in ipairs(labels) do w = math.max(w, UIK.text_w(s, scale) + 0.5) end
    return w
end

local function touch_mod()
    return C.modules and C.modules.touch
end

local function touch_row(bw)
    local T = touch_mod()
    if not T then return nil end
    return UIK.action{id = "set_touch_controls", label = L("Touch controls"), info = L("Auto: on from the first touch of the screen"), button_label = L(T.LABELS[T.mode()]),
        button = "ctl_touch_mode", button_id = "ctl_touch_mode_btn", colour = UIK.C.accent, bw = bw}
end

local function cursor_row(bw)
    local CS = C.modules and C.modules.cursor
    if not CS then return nil end
    local labels, cur, now = {}, 3, CS.get()
    for i, v in ipairs(CS.STEPS) do
        labels[i] = v .. "%"
        if v == now then cur = i end
    end
    return UIK.cycle{id = "set_cursor_speed", label = L("Cursor speed"), info = L("How fast the mouse and the stick cursor move"), options = labels, current = cur, cw = bw and math.max(1.6, bw - 2.75) or nil,
        callback = function(i)
            CS.set(CS.STEPS[i])
            save()
        end}
end

local function pad_row(bw)
    return UIK.action{id = "set_pad_binds", label = L("Controller"), info = L("See and change every button"), button_label = L("Open"),
        button = "open_pad_binds", colour = UIK.C.accent, bw = bw}
end

function P.settings_rows()
    if C.touch() then
        local D = pad()
        if not (D and D.connected()) then return {} end
        return {UIK.header(L("Controls")), pad_row(widest({L("Open")}, 0.47, 2.85))}
    end
    local m = C.mode()
    local labels = mode_labels()
    labels[#labels + 1] = L("Open")
    labels[#labels + 1] = L("Show")
    local T = touch_mod()
    for _, m in ipairs(T and T.MODES or {}) do labels[#labels + 1] = L(T.LABELS[m]) end
    local bw = widest(labels, 0.47, 2.85)
    return {
        UIK.header(L("Controls")),
        UIK.action{id = "set_input_mode", label = L("Input mode"), info = L("How you play on this computer"), button_label = L(P.MODE_LABELS[m]),
            button = "ctl_input_mode", button_id = "ctl_input_mode_btn", colour = UIK.C.accent, bw = bw},
        UIK.action{id = "set_keyboard_binds", label = L("Keys and gestures"), info = L("See and change every key and gesture"), button_label = L("Open"),
            button = "open_keyboard_binds", colour = UIK.C.accent, disabled = m == "mouse", bw = bw},
        UIK.action{id = "set_controls_help", label = L("Help"), info = L("Every action and its key, for each mode"), button_label = L("Show"),
            button = "ctl_help_from_settings", colour = UIK.C.accent, bw = bw},
        touch_row(bw),
        cursor_row(bw),
        pad_row(bw),
    }
end

function P.mode_body()
    local cur = C.mode()
    local w = P.MODE_W - 0.4
    local bw = widest(mode_labels(), 0.47, 3.6)
    local rows = {}
    for _, m in ipairs(C.MODES) do
        local b = UIK.button{id = "ctl_mode_" .. m, label = L(P.MODE_LABELS[m]), button = "ctl_pick_mode", ref_table = {mode = m}, colour = UIK.C.accent, w = bw,
            focus_args = m == cur and {snap_to = true} or nil}
        if m == cur then b.nodes[1].config.chosen = "vert" end
        local row = {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.08}, nodes = {b}}
        row.uik_h = 0.94
        rows[#rows + 1] = row
    end
    return UIK.stack(rows, {w = w})
end

function P.mode_window()
    return UIK.window{
        id = "ctl_mode",
        title = L("INPUT MODE"),
        compact = true,
        w = P.MODE_W,
        tabs = {{key = "mode", label = L("Input mode"), build = P.mode_body}},
        back_func = "ctl_mode_back",
    }
end

local function focus_settings_button()
    if not (G.OVERLAY_MENU and G.CONTROLLER and G.CONTROLLER.HID.controller) then return end
    local b = G.OVERLAY_MENU:get_UIE_by_ID("ctl_input_mode_btn")
    if b then G.CONTROLLER:snap_to{node = b} end
end

function P.pause_row(settings)
    if C.touch() then return settings end
    return {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = {
        UIBox_button({button = "settings", label = {localize("b_settings")}, minw = 2.45, col = true, focus_args = {snap_to = true}}),
        {n = G.UIT.C, config = {align = "cm", minw = 0.1, padding = 0}, nodes = {}},
        UIBox_button({id = "ctl_pause_controls", button = "ctl_help_from_pause", label = {L("Controls")}, minw = 2.45, col = true}),
    }}
end

local function gesture_rows(w)
    local T = tp()
    local rows = {}
    for _, g in ipairs(P.GESTURES) do
        local choices = T.CHOICES[g.id]
        local labels = {}
        for i, v in ipairs(choices) do labels[i] = L(P.CHOICE_LABELS[g.id][v]) end
        local cur = 1
        for i, v in ipairs(choices) do if v == T.bind(g.id) then cur = i end end
        rows[#rows + 1] = UIK.cycle{id = "ctl_gesture_" .. g.id, label = L(g.label), options = labels, current = cur, w = w,
            callback = function(i)
                T.set_bind(g.id, choices[i])
                save()
            end}
    end
    return rows
end

function P.trackpad_body()
    local K = kp()
    local inner = UIK.col_w(2) - 2 * UIK.PAD
    local rows = gesture_rows(inner)
    local note_h = 0.5
    local notice = K and K.ui and K.ui.notice
    return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, padding = 0}, nodes = {
        {n = G.UIT.C, config = {align = "tm", padding = 0}, nodes = {
            UIK.columns({{rows[1], rows[2]}, {rows[3], rows[4]}}, {h = UIK.H - UIK.TOP - note_h, cards = true}),
            {n = G.UIT.R, config = {align = "cm", minw = UIK.W, minh = note_h, padding = 0}, nodes = {
                {n = G.UIT.T, config = {text = notice or L("Tap presses, as with a mouse. Gestures never play, buy or sell."), scale = 0.32, colour = notice and UIK.C.title or UIK.C.muted}},
            }},
        }},
    }}
end

function P.binds_mode()
    return C.edit_mode or C.mode()
end

local function edit_trackpad()
    local m = P.binds_mode()
    return (m == "trackpad" or m == "trackpad_keys") and not C.touch()
end

local function edit_keys()
    local m = P.binds_mode()
    return m == "keyboard" or m == "trackpad_keys"
end

function P.binds_window()
    local K = kp()
    local m = P.binds_mode()
    local tabs = {}
    if edit_trackpad() and tp() then tabs[#tabs + 1] = {key = "trackpad", label = L("Trackpad"), build = P.trackpad_body} end
    if edit_keys() and K and K.group_body then
        for _, t in ipairs(K.TABS) do
            tabs[#tabs + 1] = {key = t.key, label = L(t.label), build = function() return K.group_body(t.key) end}
        end
    end
    return UIK.window{
        id = "kb_binds",
        title = L(P.TITLES[m] or "KEYBOARD KEYS"),
        tabs = tabs,
        footer = {{label = L("Reset to defaults"), button = edit_trackpad() and "ctl_binds_reset" or "kb_binds_reset", colour = UIK.C.danger}},
        back_func = "kb_binds_back",
    }
end

local function set_binds(set)
    local K = kp()
    local saved_key, keys = "keyboard_binds", nil
    local s = K and K.SETS and K.SETS[set]
    if s then saved_key, keys = s.saved, s.keys end
    local saved = G.SETTINGS[saved_key]
    local out = {}
    for _, a in ipairs(K and K.ACTIONS or {}) do
        local v = type(saved) == "table" and saved[a.id] or nil
        if v == false then out[a.id] = nil
        elseif type(v) == "string" then out[a.id] = v
        elseif keys and keys[a.id] ~= nil then out[a.id] = keys[a.id] or nil
        else out[a.id] = a.key end
    end
    return out
end

local function key_text(b, id)
    local K = kp()
    local k = b[id]
    return k and K.key_name(k) or L("Unbound")
end

P.VAL_W = 2.6
P.ROW_H = 0.5

local function help_row(label, value, w, ls, vs)
    local h = P.ROW_H
    local vw = math.min(P.VAL_W, w * 0.4)
    local lw = w - vw - 0.4
    local node = {n = G.UIT.R, config = {align = "cm", minw = w, minh = h + 0.1, padding = 0}, nodes = {
        {n = G.UIT.C, config = {align = "cr", minw = lw, minh = h, padding = 0}, nodes = {
            {n = G.UIT.T, config = {text = label, scale = ls, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
        }},
        {n = G.UIT.C, config = {align = "cm", minw = 0.2, minh = h, padding = 0}, nodes = {}},
        {n = G.UIT.C, config = {align = "cm", minw = vw, minh = h, r = 0.1, colour = G.C.BLACK, emboss = 0.05, padding = 0}, nodes = {
            {n = G.UIT.T, config = {text = value, scale = vs, colour = UIK.C.title, shadow = true}},
        }},
    }}
    node.uik_h = h + 0.1
    return node
end

local function section(col, title, rows)
    col[#col + 1] = {title = title}
    for _, r in ipairs(rows) do col[#col + 1] = r end
end

local function build(cols, w)
    local vw = math.min(P.VAL_W, w * 0.4)
    local lw = w - vw - 0.4
    local base = 0.36
    local ls, vs = base, base
    for _, col in ipairs(cols) do
        for _, r in ipairs(col) do
            if not r.title then
                ls = math.min(ls, base * lw / math.max(UIK.text_w(r[1], base), 0.01))
                vs = math.min(vs, base * (vw - 0.2) / math.max(UIK.text_w(r[2], base), 0.01))
            end
        end
    end
    local out = {}
    for c, col in ipairs(cols) do
        out[c] = {}
        for _, r in ipairs(col) do
            out[c][#out[c] + 1] = r.title and UIK.header(r.title, {w = w}) or help_row(r[1], r[2], w, ls, vs)
        end
    end
    return UIK.columns(out, {cards = true})
end

local function key_sections(set, with_nav)
    local K = kp()
    local b = set_binds(set)
    local by = {}
    for _, a in ipairs(K.ACTIONS) do by[a.id] = a end
    local function r(id) return {K.action_label(by[id]), key_text(b, id)} end
    local nav = {}
    if with_nav then
        local arrows = b.nav_up == "up" and b.nav_down == "down" and b.nav_left == "left" and b.nav_right == "right"
        nav[#nav + 1] = {L("Move the focus"), arrows and L("Arrows") or table.concat({key_text(b, "nav_up"), key_text(b, "nav_left"), key_text(b, "nav_down"), key_text(b, "nav_right")}, " ")}
        if b.confirm then nav[#nav + 1] = r("confirm") end
        nav[#nav + 1] = r("back")
    end
    nav[#nav + 1] = r("tab_prev")
    nav[#nav + 1] = r("tab_next")
    nav[#nav + 1] = r("run_info")
    nav[#nav + 1] = {L("Options"), L("Esc")}
    local plain = true
    for i = 1, 10 do if b["card" .. i] ~= tostring(i % 10) then plain = false end end
    local hand = {r("play"), r("discard"), r("sort_rank"), r("sort_suit"),
        {L("Pick card 1 to 10"), plain and L("1 to 0") or (key_text(b, "card1") .. " ... " .. key_text(b, "card10"))}}
    local cards = {r("use"), r("sell"), r("move_left"), r("move_right")}
    local shop = {r("buy"), r("buy_use"), r("reroll")}
    local replay = {{L("Pause or play"), key_text(b, b.confirm and "confirm" or "play")}, {L("Next hand"), key_text(b, "discard")},
        {L("Previous / next action"), key_text(b, "nav_left") .. " / " .. key_text(b, "nav_right")}}
    return nav, hand, cards, shop, replay
end

local function gesture_rows_help(full)
    local T = tp()
    local b = {}
    for _, g in ipairs(P.GESTURES) do b[g.id] = T.bind(g.id) end
    local rows = {{L("Press or pick"), L("Tap")}}
    if b.scroll ~= "off" then rows[#rows + 1] = {L("Move the focus"), L("Scroll")} end
    if b.swipe == "move" then rows[#rows + 1] = {L("Move a card"), L("Swipe")} end
    if b.swipe ~= "off" then rows[#rows + 1] = {L("Switch tabs"), L("Swipe")} end
    if b.two_tap ~= "off" then
        rows[#rows + 1] = {L("Unselect cards"), L("2-finger tap")}
        if b.two_tap == "run_info" then rows[#rows + 1] = {L("Run Info"), L("2-finger tap")} end
        if b.two_tap == "speed" then rows[#rows + 1] = {L("Speed up"), L("2-finger tap")} end
        if b.two_tap ~= "speed" then rows[#rows + 1] = {L("Back"), L("2-finger tap")} end
    end
    rows[#rows + 1] = {L("Drag cards"), L(b.drag == "on" and "On" or "Off")}
    if b.drag ~= "on" then rows[#rows + 1] = {L("Select several cards"), L("Press and slide")} end
    local other = full and {
        {L("Play, discard, buy, sell"), L("Tap the button")},
        {L("Text fields"), L("On-screen keyboard")},
        {L("Options"), L("Tap Options")},
    } or nil
    return rows, other
end

function P.help_body(m)
    local cols = {{}, {}, {}}
    local w = UIK.col_w(3) - 2 * UIK.PAD
    if m == "controller" then
        local D = pad()
        local nav, hand, shop, quick, replay, mg = D.help_sections()
        section(cols[1], L("Navigation"), nav)
        section(cols[2], L("Hand"), hand)
        section(cols[2], L("Shop and cards"), shop)
        section(cols[3], L("Quick actions"), quick)
        section(cols[3], L("Replays"), replay)
        section(cols[3], L("Minigames"), mg)
    elseif m == "keyboard" then
        local nav, hand, cards, shop, replay = key_sections("keyboard", true)
        section(cols[1], L("Navigation"), nav)
        section(cols[2], L("Hand"), hand)
        section(cols[2], L("Replays"), replay)
        section(cols[3], L("Jokers and consumables"), cards)
        section(cols[3], L("Shop and packs"), shop)
    elseif m == "trackpad" then
        local rows, other = gesture_rows_help(true)
        w = UIK.col_w(2) - 2 * UIK.PAD
        cols = {{}, {}}
        section(cols[1], L("Trackpad"), rows)
        section(cols[2], L("Everything else"), other)
    else
        local rows = gesture_rows_help(false)
        local nav, hand, cards, shop = key_sections("trackpad_keys", false)
        section(cols[1], L("Trackpad"), rows)
        section(cols[2], L("Navigation"), nav)
        section(cols[2], L("Jokers and consumables"), cards)
        section(cols[3], L("Hand"), hand)
        section(cols[3], L("Shop and packs"), shop)
    end
    return build(cols, w)
end

function P.help_window()
    local m = C.mode()
    local tabs = {}
    for _, t in ipairs(P.HELP_TABS) do
        if t ~= "controller" or pad() then
            tabs[#tabs + 1] = {key = t, label = L(P.MODE_LABELS[t]), build = function() return P.help_body(t) end}
        end
    end
    local tab = m ~= "mouse" and m or nil
    if P.pad_in_use() and pad() then tab = "controller" end
    if P.help_tab then tab, P.help_tab = P.help_tab, nil end
    return UIK.window{
        id = "ctl_help",
        title = L("CONTROLS"),
        tabs = tabs,
        tab = tab,
        footer = {{label = L("Remap"), button = "ctl_help_remap", colour = UIK.C.accent, id = "ctl_help_remap"}},
        back_func = "ctl_help_back",
    }
end

local function open_help(from)
    P.from = from
