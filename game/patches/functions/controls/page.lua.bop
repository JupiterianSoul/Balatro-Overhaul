function C.back_to(from, e)
    if type(from) == "table" and from.help then
        P.help_tab = from.tab
        open_help(from.help)
        return true
    end
    if from == "pause" and G.FUNCS.options then G.FUNCS.options(e) return true end
    if from == "settings" and G.FUNCS.settings then G.FUNCS.settings(e) return true end
    return false
end

