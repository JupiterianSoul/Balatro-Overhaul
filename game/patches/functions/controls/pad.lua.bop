local C = Controls
local P = {}
local L = function(s) return mod_loc(s) end

P.SAVED = "pad_binds"
P.BUTTONS = {"a", "b", "x", "y", "leftshoulder", "rightshoulder", "triggerleft", "triggerright", "start", "back", "leftstick", "rightstick"}
P.REMAP = {}
for _, b in ipairs(P.BUTTONS) do P.REMAP[b] = true end

P.ACTIONS = {
    {id = "press", out = "a", def = "a", label = "Press or pick"},
    {id = "back", out = "b", def = "b", label = "Back"},
    {id = "tab_prev", out = "leftshoulder", def = "leftshoulder", label = "Previous tab, sell"},
    {id = "tab_next", out = "rightshoulder", def = "rightshoulder", label = "Next tab, use or buy"},
    {id = "options", out = "start", def = "start", label = "Options"},
    {id = "run_info", out = "back", def = "back", label = "Run Info"},
    {id = "play", out = "x", def = "x", label = "Play hand, reroll"},
    {id = "discard", out = "y", def = "y", label = "Discard, skip, next round"},
    {id = "peek_deck", out = "triggerleft", def = "triggerleft", label = "Peek at the deck"},
    {id = "view_deck", out = "triggerright", def = "triggerright", label = "View the deck"},
    {id = "speed_up", def = "rightstick", label = "Speed up"},
    {id = "speed_down", def = "leftstick", label = "Slow down"},
    {id = "sort_rank", label = "Sort by rank"},
    {id = "sort_suit", label = "Sort by suit"},
    {id = "mute", label = "Mute all"},
    {id = "music", label = "Mute music"},
}
P.by_id = {}
for _, a in ipairs(P.ACTIONS) do P.by_id[a.id] = a end

P.SPRITE = {a = 0, b = 1, x = 2, y = 3, leftshoulder = 4, rightshoulder = 5, triggerleft = 6, triggerright = 7, start = 8, back = 9,
    leftstick = 16, rightstick = 17, dpup = 10, dpright = 11, dpdown = 12, dpleft = 13}
P.NAMES = {
    xbox = {a = "A", b = "B", x = "X", y = "Y", leftshoulder = "LB", rightshoulder = "RB", triggerleft = "LT", triggerright = "RT", start = "Menu", back = "View", leftstick = "L3", rightstick = "R3"},
    Playstation = {a = "Cross", b = "Circle", x = "Square", y = "Triangle", leftshoulder = "L1", rightshoulder = "R1", triggerleft = "L2", triggerright = "R2", start = "Options", back = "Share", leftstick = "L3", rightstick = "R3"},
    Nintendo = {a = "B", b = "A", x = "Y", y = "X", leftshoulder = "L", rightshoulder = "R", triggerleft = "ZL", triggerright = "ZR", start = "+", back = "-", leftstick = "L3", rightstick = "R3"},
}
P.MG_KEYS = {dpup = "up", dpdown = "down", dpleft = "left", dpright = "right", b = "escape", x = "return", y = "d", leftshoulder = "left", rightshoulder = "right"}
P.REPLAY = {x = "pb_pause", y = "pb_step_hand", leftshoulder = "pb_prev_action", rightshoulder = "pb_next_action", triggerleft = "pb_speed", triggerright = "pb_ff"}
P.held = {}
P.ui = {}

local function kp()
    return Extras and Extras.modules and Extras.modules.keyboard_play
end

local function hotkeys()
    return QOL and QOL.modules and QOL.modules.hotkeys
end

local function save()
    if G and G.save_settings then pcall(function() G:save_settings() end) end
end

function P.is_button(b)
    return type(b) == "string" and P.REMAP[b] == true
end

function P.binds()
    local saved = G.SETTINGS and G.SETTINGS[P.SAVED]
    local out = {}
    for _, a in ipairs(P.ACTIONS) do
        local v = type(saved) == "table" and saved[a.id] or nil
        if v == false then out[a.id] = nil
        elseif P.is_button(v) then out[a.id] = v
        else out[a.id] = a.def end
    end
    return out
end

function P.refresh()
    P.bound = P.binds()
    P.by_button = {}
    P.by_out = {}
    for _, a in ipairs(P.ACTIONS) do
        local b = P.bound[a.id]
        if b and not P.by_button[b] then P.by_button[b] = a end
    end
    for _, a in ipairs(P.ACTIONS) do
        if a.out and P.by_button[P.bound[a.id] or ""] == a then P.by_out[a.out] = P.bound[a.id] end
    end
end

function P.set_bind(id, button)
    local a = P.by_id[id]
    if not (a and P.is_button(button)) then return nil end
    P.refresh()
    local saved = type(G.SETTINGS[P.SAVED]) == "table" and G.SETTINGS[P.SAVED] or {}
    G.SETTINGS[P.SAVED] = saved
    local old = P.bound[id]
    local other = P.by_button[button]
    if other == a then return nil end
    if other then saved[other.id] = old or false end
    saved[id] = button
    P.refresh()
    save()
    return other
end

function P.reset_binds()
    G.SETTINGS[P.SAVED] = nil
    P.capture = nil
    P.refresh()
    save()
end

function P.console()
    local c = G.CONTROLLER and G.CONTROLLER.GAMEPAD_CONSOLE
    if c == "Playstation" or c == "Nintendo" then return c end
    return "xbox"
end

function P.name(button)
    if not button then return L("Unbound") end
    local n = P.NAMES[P.console()][button] or button
    return L(n)
end

function P.action_button(id)
    if not P.bound then P.refresh() end
    return P.bound[id]
end

function P.action_name(id)
    return P.name(P.action_button(id))
end

function P.glyph(button, scale)
    local atlas = G.ASSET_ATLAS and G.ASSET_ATLAS["gamepad_ui"]
    local x = button and P.SPRITE[button]
    if not (atlas and x) then return nil end
    local c = P.console()
    local y = c == "Nintendo" and 2 or c == "Playstation" and (G.F_PS4_PLAYSTATION_GLYPHS and 3 or 1) or 0
    local s = scale or 0.45
    local sp = Sprite(0, 0, s, s, atlas, {x = x, y = y})
    return {n = G.UIT.O, config = {object = sp}}
end

function P.connected()
    if not (love.joystick and love.joystick.getJoysticks) then return false end
    local ok, list = pcall(love.joystick.getJoysticks)
    if not ok then return false end
    for _, j in ipairs(list or {}) do
        local ok2, gp = pcall(j.isGamepad, j)
        if ok2 and gp then return true end
    end
    return false
end

local function real(ctrl)
    local K = kp()
    if K and K.from_kb then return false end
    local o = ctrl.GAMEPAD and ctrl.GAMEPAD.object
    return o ~= nil and o ~= ctrl.keyboard_controller
end

local function minigame()
    local mg = rawget(_G, "Minigames")
    local h = mg and mg.host
    if h and h.win and not h.closing then return h end
end

local function replay_bar()
    local pb = rawget(_G, "bom_playback")
    if not (pb and pb.active and pb.active()) then return nil end
    local bar = G.PB_BAR
    if G.OVERLAY_MENU or not (bar and not bar.REMOVED) then return nil end
    return bar
end

local function on_board(h)
    local b = h.board
    local c = G.CURSOR and G.CURSOR.T
    local v = b and b.VT
    if not (c and v and v.w and v.h) then return false end
    local r = G.ROOM and G.ROOM.T or {x = 0, y = 0}
    local x, y = c.x - r.x, c.y - r.y
    return x >= v.x and y >= v.y and x <= v.x + v.w and y <= v.y + v.h
end

function P.minigame_press(h, logical)
    local g = h.phase == "play" and h.game
    if g and g.pad_btn then
        local ok, used = pcall(g.pad_btn, g, logical)
        if ok and used then return true end
    end
    if logical == "a" then
        if h.phase == "play" and h.game and h.game.pad_hit then
            h.game:pad_hit()
        elseif h.phase == "play" and on_board(h) and h.board.click then
            h.board:click()
        else
            h.key("space")
        end
        return true
    end
    local key = P.MG_KEYS[logical]
    if not key then return false end
    h.key(key)
    return true
end

function P.replay_press(bar, logical)
    local fn = P.REPLAY[logical]
    local pb = rawget(_G, "bom_playback")
    local st = logical == "b" and pb and pb.state and pb.state()
    if not fn and st and st.done then fn = "pb_leave" end
    if not fn then return false end
    local K = kp()
    local e = K and K.find_in and K.find_in({bar}, {[fn] = true})
    if e then e:click() else pcall(play_sound, "cancel") end
    return true
end

function P.quick(id, ctrl)
    if ctrl.text_input_hook or (ctrl.locks and ctrl.locks.frame) then return end
    if G.STATE == G.STATES.SPLASH then return end
    if id == "sort_rank" or id == "sort_suit" then
        local K = kp()
        local fn = K and K.RUN and K.RUN[id]
        if not (fn and fn()) then pcall(play_sound, "cancel") end
        return
    end
    local H = hotkeys()
    if not H then return end
    if id == "speed_up" or id == "speed_down" then
        if not QOL.on("qol_speed_key") then
            pcall(play_sound, "cancel")
            return
        end
        if C.refuse("speed_key") then return end
        if not H.speed_allowed() then
            pcall(play_sound, "cancel")
            return
        end
        H.cycle_speed(id == "speed_down")
        return
    end
    if not QOL.on("qol_mute_keys") then return end
    if id == "mute" then H.toggle_volume("volume", "qol_volume_before_mute", "Sound on", "Sound off")
    else H.toggle_volume("music_volume", "qol_music_before_mute", "Music on", "Music off") end
end

local function page_open()
    return G.OVERLAY_MENU and UIK and UIK._win and UIK._win.id == "pad_binds" and G.OVERLAY_MENU:get_UIE_by_ID("uik_body") ~= nil
end

local function redraw(focus_id)
    if not page_open() then return end
    UIK.refresh()
    local b = focus_id and G.OVERLAY_MENU:get_UIE_by_ID("pad_bind_" .. focus_id)
    if b and G.CONTROLLER.HID.controller then G.CONTROLLER:snap_to{node = b} end
end

function P.capture_press(button)
    local id = P.capture
    if not page_open() then P.capture = nil return false end
    if button:sub(1, 2) == "dp" then return true end
    if not P.is_button(button) then return false end
    P.capture = nil
    local moved = P.set_bind(id, button)
    P.ui.notice = moved and string.format(L("%s now on %s"), P.action_label(moved), P.name(P.bound[moved.id])) or nil
    play_sound("button", 1, 0.4)
    redraw(id)
    return true
end

function P.on_press(ctrl, button)
    if not P.bound then P.refresh() end
    if P.capture and P.capture_press(button) then
        P.held[button] = false
        return nil
    end
    local a = P.REMAP[button] and P.by_button[button] or nil
    local logical = button
    if P.REMAP[button] then logical = a and a.out or nil end
    local h = minigame()
    if h and logical and P.minigame_press(h, logical) then
        P.held[button] = false
        return nil
    end
    local bar = logical and replay_bar()
    if bar and P.replay_press(bar, logical) then
        P.held[button] = false
        return nil
    end
    if not P.REMAP[button] then return button end
    if not a then
        P.held[button] = false
        return nil
    end
    if a.out then
        P.held[button] = a.out
        return a.out
    end
    P.held[button] = false
    P.quick(a.id, ctrl)
    return nil
end

function P.on_release(ctrl, button)
    local h = P.held[button]
    if h == nil then return button end
    P.held[button] = nil
    return h or nil
end

function P.action_label(a)
    return L(a.label)
end

P.KEY_W = 2.3
P.ROW_H = 0.56

local function bind_row(a, w, lw)
    local b = P.bound and P.bound[a.id]
    local cap = P.capture == a.id
    local text = cap and L("Press a button") or P.name(b)
    local colour = cap and UIK.C.warn or (b and UIK.C.accent or UIK.C.inactive)
    local h = P.ROW_H
    local g = not cap and P.glyph(b, 0.5) or nil
    local node = {n = G.UIT.R, config = {align = "cm", minw = w, minh = h + 0.1, padding = 0}, nodes = {
        {n = G.UIT.C, config = {align = "cr", minw = lw, maxw = lw, minh = h, padding = 0}, nodes = {
            {n = G.UIT.T, config = {text = P.action_label(a), scale = 0.4, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
        }},
        {n = G.UIT.C, config = {align = "cm", minw = 0.75, minh = h, padding = 0}, nodes = {g}},
        UIK.button{label = text, button = "pad_bind_pick", ref_table = a, colour = colour, w = P.KEY_W, h = h, scale = 0.4, col = true, id = "pad_bind_" .. a.id},
    }}
    node.uik_h = h + 0.1
    return node
end

function P.binds_body()
    P.refresh()
    local inner = UIK.col_w(2) - 2 * UIK.PAD
    local lw = 0
    for _, a in ipairs(P.ACTIONS) do lw = math.max(lw, UIK.text_w(P.action_label(a), 0.4)) end
    lw = math.min(lw + 0.1, inner - P.KEY_W - 0.95)
    local per = math.ceil(#P.ACTIONS / 2)
    local cols = {{}, {}}
    for i, a in ipairs(P.ACTIONS) do table.insert(cols[i <= per and 1 or 2], bind_row(a, inner, lw)) end
    local note_h = 0.5
    local line = P.ui.notice or L("Pick an action, then press its new button. The two swap.")
    return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, padding = 0}, nodes = {
        {n = G.UIT.C, config = {align = "tm", padding = 0}, nodes = {
            UIK.columns(cols, {h = UIK.H - UIK.TOP - note_h, cards = true}),
            {n = G.UIT.R, config = {align = "cm", minw = UIK.W, minh = note_h, padding = 0}, nodes = {
                {n = G.UIT.T, config = {text = line, scale = 0.32, colour = P.ui.notice and UIK.C.title or UIK.C.muted}},
            }},
        }},
    }}
end

function P.binds_window()
    return UIK.window{
        id = "pad_binds",
        title = L("CONTROLLER BUTTONS"),
        tabs = {{key = "buttons", label = L("Buttons"), build = P.binds_body}},
        footer = {{label = L("Reset to defaults"), button = "pad_binds_reset", colour = UIK.C.danger}},
        back_func = "pad_binds_back",
    }
end

function P.help_sections()
    local function n(id) return P.action_name(id) end
    local function pair(a, b) return n(a) .. " / " .. n(b) end
    local nav = {
        {L("Move the focus"), L("D-pad")},
        {L("Free pointer"), L("Right stick")},
        {L("Press or pick"), n("press")},
        {L("Back"), n("back")},
        {L("Previous / next tab"), pair("tab_prev", "tab_next")},
        {L("Options"), n("options")},
        {L("Run Info"), n("run_info")},
    }
    local hand = {
        {L("Play hand"), n("play")},
        {L("Discard or skip"), n("discard")},
        {L("Peek / view the deck"), pair("peek_deck", "view_deck")},
        {L("Move a card (hold)"), n("press") .. " + " .. L("D-pad")},
    }
    local shop = {
        {L("Sell"), n("tab_prev")},
        {L("Use, buy, open"), n("tab_next")},
        {L("Reroll / next round"), pair("play", "discard")},
    }
    local quick = {
        {L("Speed up / slow down"), pair("speed_up", "speed_down")},
    }
    if P.action_button("sort_rank") or P.action_button("sort_suit") then quick[#quick + 1] = {L("Sort by rank / suit"), pair("sort_rank", "sort_suit")} end
    if P.action_button("mute") then quick[#quick + 1] = {L("Mute all"), n("mute")} end
    if P.action_button("music") then quick[#quick + 1] = {L("Mute music"), n("music")} end
    local replay = {
        {L("Pause or play"), n("play")},
        {L("Next hand"), n("discard")},
        {L("Previous / next action"), pair("tab_prev", "tab_next")},
    }
    local mg = {
        {L("Start or tap"), n("press")},
        {L("Close"), n("back")},
    }
    return nav, hand, shop, quick, replay, mg
end

function P.open_binds(from)
    P.from = from
    P.capture = nil
    P.ui.notice = nil
