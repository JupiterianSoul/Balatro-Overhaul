function P.init()
    if P._hooked then return end
    P._hooked = true
    P.refresh()
    if Controller and Controller.button_press and not P._wrapped then
        P._wrapped = true
        local press, release = Controller.button_press, Controller.button_release
        Controller.button_press = function(self, button)
            if not real(self) then return press(self, button) end
            local ok, out = pcall(P.on_press, self, button)
            if not ok then
                print("[Controls] pad: " .. tostring(out))
                return press(self, button)
            end
            if out then return press(self, out) end
        end
        Controller.button_release = function(self, button)
            if not real(self) then return release(self, button) end
            local ok, out = pcall(P.on_release, self, button)
            if not ok then return release(self, button) end
            if out then return release(self, out) end
        end
    end
    local pip = rawget(_G, "create_button_binding_pip")
    if type(pip) == "function" and not P._pip then
        P._pip = true
        create_button_binding_pip = function(args)
            local phys = args and P.by_out and P.by_out[args.button]
            if phys and phys ~= args.button then
                local copy = {}
                for k, v in pairs(args) do copy[k] = v end
                copy.button = phys
                return pip(copy)
            end
            return pip(args)
        end
    end
    local buy = G.FUNCS.buy_from_shop
    if type(buy) == "function" and not P._buy then
        P._buy = true
        G.FUNCS.buy_from_shop = function(e, ...)
            local card = e and e.config and e.config.ref_table
            local r = buy(e, ...)
            if card and G.CONTROLLER and G.CONTROLLER.HID.controller and G.E_MANAGER then
                G.E_MANAGER:add_event(Event({trigger = "after", delay = 0.3, blocking = false, blockable = false, func = function()
                    local f = card.children and card.children.focused_ui
                    if f and card.area and card.area ~= G.shop_jokers then
                        f:remove()
                        card.children.focused_ui = nil
                        if card.states.focus.is and not card.REMOVED then card.children.focused_ui = G.UIDEF.card_focus_ui(card) end
                    end
                    return true
                end}))
            end
            return r
        end
    end
    G.FUNCS.open_pad_binds = function() P.open_binds("settings") end
    G.FUNCS.pad_bind_pick = function(e)
        local a = e and e.config and e.config.ref_table
        if not (a and a.id) then return end
        P.capture = P.capture ~= a.id and a.id or nil
        P.ui.notice = nil
        redraw(a.id)
    end
    G.FUNCS.pad_binds_reset = function()
        P.reset_binds()
        P.ui.notice = L("Every button is back to its default")
        redraw()
    end
    G.FUNCS.pad_binds_back = function(e)
        P.capture = nil
        P.ui.notice = nil
        local from = P.from
        P.from = nil
        if C.back_to and C.back_to(from, e) then return end
        if G.FUNCS.settings then return G.FUNCS.settings(e) end
r 4 1375 %20%20%20%20%20%20%20%20 -
l 45
    end
    G.ESC_BACK_FUNCS = G.ESC_BACK_FUNCS or {}
    G.ESC_BACK_FUNCS.pad_binds_back = true
end

local function register_new(t)
    local out = {}
    for lang, entries in pairs(t) do
        out[lang] = {}
        local have = MOD_TRANSLATIONS and MOD_TRANSLATIONS[lang] or {}
        for k, v in pairs(entries) do if have[k] == nil then out[lang][k] = v end end
    end
    mod_loc_register(out)
end

