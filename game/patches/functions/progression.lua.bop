-- Check if run is clean (for progression/quests)
function is_clean_run()
  if not G then return true end
  if not G.GAME then return true end
  if G.GAME.multiplayer then return not G.GAME.modded_run end
  return not G.GAME.modded_run and (not G.GAME.seeded or G.GAME.daily == true)
end

function mp_progression_data()
  if not progression_init() then return nil end
  local profile = G.PROFILES[G.SETTINGS.profile]
  if not profile then return nil end
  local mp = profile.mp_progression
  if type(mp) ~= "table" then
    local old = profile.progression or {}
    mp = {xp = 0, level = 1, total_xp = 0, matches = tonumber(old.mp_total_matches) or 0, wins = tonumber(old.mp_match_wins) or 0}
    profile.mp_progression = mp
  end
  if type(mp.xp_sources) ~= "table" then mp.xp_sources = {} end
  return mp
end

function mp_award_xp(amount, source)
  if not amount or amount <= 0 then return false end
  if G.GAME and G.GAME.modded_run then return false end
  local mp = mp_progression_data()
  if not mp then return false end
  local final_xp = math.floor(amount)
  mp.total_xp = (tonumber(mp.total_xp) or 0) + final_xp
  if source then mp.xp_sources[source] = (mp.xp_sources[source] or 0) + final_xp end
  local old_level = tonumber(mp.level) or 1
  local new_level, xp_into_level = get_level_from_xp(mp.total_xp)
  mp.level, mp.xp = new_level, xp_into_level
  if new_level > old_level then progression_notify("mp_level", new_level) end
  pcall(check_milestones)
  progression_save()
  return true
end

function mp_record_match(won)
  local mp = mp_progression_data()
  if not mp then return end
  mp.matches = (tonumber(mp.matches) or 0) + 1
  if won then mp.wins = (tonumber(mp.wins) or 0) + 1 end
end

function get_mp_progression_display()
  local mp = mp_progression_data() or {}
  local level = tonumber(mp.level) or 1
  local xp = tonumber(mp.xp) or 0
  local xp_needed = get_xp_for_level(level)
  return {
    level = level,
    xp = xp,
    xp_needed = xp_needed,
    xp_percent = math.min(1, xp / math.max(1, xp_needed)),
    rank = get_rank(level),
    total_xp = tonumber(mp.total_xp) or 0,
    matches = tonumber(mp.matches) or 0,
    wins = tonumber(mp.wins) or 0,
  }
end

-- ===== UI HELPERS =====

-- Get progression display data
function get_progression_display()
  if not progression_init() then
    return {
      level = 1,
      xp = 0,
      xp_needed = get_xp_for_level(1),
      xp_percent = 0,
      rank = PROGRESSION.RANKS[1],
      total_xp = 0,
      total_wins = 0,
    }
  end

  local profile = G.PROFILES[G.SETTINGS.profile]
  if not profile or not profile.progression then
    return {
      level = 1,
      xp = 0,
      xp_needed = get_xp_for_level(1),
      xp_percent = 0,
      rank = PROGRESSION.RANKS[1],
      total_xp = 0,
      total_wins = 0,
    }
  end

  local level = profile.progression.level or 1
  local xp = profile.progression.xp or 0
  local xp_needed = get_xp_for_level(level)
  local xp_percent = math.min(1, xp / math.max(1, xp_needed))

  return {
    level = level,
    xp = xp,
    xp_needed = xp_needed,
    xp_percent = xp_percent,
    rank = get_rank(level),
    total_xp = profile.progression.total_xp or 0,
    total_wins = profile.progression.total_wins or 0,
  }
end

-- Create progression bar UI element
function create_UIBox_progression_bar()
  local data = get_progression_display()
  local bar_w = 3.5
  local bar_h = 0.25
  local rank_color = G.C[data.rank.color] or G.C.WHITE

  return {n=G.UIT.ROOT, config={align = "cm", colour = G.C.CLEAR, padding = 0.05}, nodes={
    -- Rank and Level
    {n=G.UIT.R, config={align = "cm", padding = 0.02}, nodes={
      {n=G.UIT.T, config={text = mod_loc(data.rank.name), scale = 0.35, colour = rank_color, shadow = true}},
      {n=G.UIT.T, config={text = " " .. mod_loc("Lv.") .. data.level, scale = 0.35, colour = G.C.WHITE, shadow = true}},
    }},
    -- XP Bar background
    {n=G.UIT.R, config={align = "cm", padding = 0.02}, nodes={
      {n=G.UIT.C, config={align = "cl", minw = bar_w, minh = bar_h, r = 0.1, colour = G.C.L_BLACK, emboss = 0.02}, nodes={
        -- XP Bar fill
        {n=G.UIT.C, config={align = "cl", minw = bar_w * data.xp_percent, minh = bar_h - 0.04, r = 0.08, colour = rank_color}, nodes={}},
      }},
    }},
    -- XP Text
    {n=G.UIT.R, config={align = "cm", padding = 0.01}, nodes={
      {n=G.UIT.T, config={text = number_format(data.xp) .. " / " .. number_format(data.xp_needed) .. " " .. mod_loc("XP"), scale = 0.25, colour = G.C.UI.TEXT_INACTIVE}},
    }},
  }}
end

-- ===== STAKE HELPERS (Stakes 9-13) =====

-- Stake configuration table - CREATIVE UNIQUE MODIFIERS
-- Edition mapping: Chaos=Foil, Apocalypse=Holographic, Oblivion=Negative, Transcendent=Polychrome
local STAKE_CONFIG = {
  -- stake_level = {blind_mult, win_ante, xp_mult, sticker, unique_modifiers...}
  [9]  = {  -- CHAOS: Foil sticker
    blind_mult = 2.0,
    win_ante = 10,
    xp_mult = 7,
    sticker = "foil",
    -- Unique: Booster packs offer 1 fewer choice
    booster_minus_choice = true,
  },
  [10] = {  -- APOCALYPSE: Holographic sticker
    blind_mult = 2.5,
    win_ante = 11,
    xp_mult = 9,
    sticker = "holo",
    -- Unique: Boss Blinds gain an additional random boss effect
    boss_additional_effect = true,
  },
  [11] = {  -- OBLIVION: Negative sticker
    blind_mult = 3.0,
    win_ante = 12,
    xp_mult = 12,
    sticker = "negative",
    -- Unique: One random joker slot is disabled at the start of each round
    random_joker_disable = true,
  },
  [12] = {  -- TRANSCENDENT: Polychrome sticker
    blind_mult = 4.0,
    win_ante = 13,
    xp_mult = 16,
    sticker = "polychrome",
    -- Unique: Boss Blinds are always the finisher (Showdown boss)
    boss_always_finisher = true,
  },
}

-- Get current stake level
function get_current_stake()
  if not G.GAME then return 1 end
  return G.GAME.stake or 1
end

-- Check if current run is Insanity Stake or higher
-- Check if current run is creative stake (9+)
function is_creative_stake()
  if not G.GAME then return false end
  return (G.GAME.stake or 1) >= 9
end

-- Check if current run is a specific stake or higher
function is_stake_or_higher(stake_level)
  if not G.GAME then return false end
  return (G.GAME.stake or 1) >= stake_level
end

-- Get stake config value with fallback
function get_stake_config(key)
  local stake = get_current_stake()
  if stake >= 9 and STAKE_CONFIG[stake] then
    return STAKE_CONFIG[stake][key]
  end
  return nil
end

-- FIX: Creative stakes do NOT modify blind chip requirements.
-- They only add unique effects from their descriptions.
-- Blind scores stay the same as Gold Stake (stake 8).
function get_creative_blind_multiplier()
  return 1
end

-- Get win ante for current stake (10 for Chaos, up to 13 for Transcendent)
function get_creative_win_ante()
  local stake = get_current_stake()
  if stake >= 9 and STAKE_CONFIG[stake] then
    return STAKE_CONFIG[stake].win_ante
  end
  return 8
end

-- Get XP multiplier for current stake
function get_stake_xp_multiplier()
  local stake = get_current_stake()
  if stake >= 9 and STAKE_CONFIG[stake] then
    return STAKE_CONFIG[stake].xp_mult
  elseif stake >= 8 then
    return 5  -- Gold stake
  elseif stake >= 5 then
    return 3  -- Blue-Orange stakes
  elseif stake >= 2 then
    return 2  -- Red-Black stakes
  end
  return 1  -- White stake
end

-- Get sticker type for stake
function get_stake_sticker(stake_level)
  if STAKE_CONFIG[stake_level] then
    return STAKE_CONFIG[stake_level].sticker
  end
  return nil
end

-- ===== CHAOS STAKE (9) MODIFIERS =====

-- Check if booster packs should offer 1 fewer choice
function has_booster_minus_choice()
  return is_stake_or_higher(9)
end

-- ===== APOCALYPSE STAKE (10) MODIFIERS =====

-- Check if boss blinds gain additional random effect
function has_boss_additional_effect()
  return is_stake_or_higher(10)
end

-- ===== OBLIVION STAKE (11) MODIFIERS =====

-- Check if a random joker slot is disabled at round start
function has_random_joker_disable()
  return is_stake_or_higher(11)
end

-- ===== TRANSCENDENT STAKE (12) MODIFIERS =====

-- Check if boss blinds are always finisher (showdown boss)
function has_boss_always_finisher()
  return is_stake_or_higher(12)
end

-- Get stake name by level
function get_stake_name(stake_level)
  local names = {
    [1] = "White", [2] = "Red", [3] = "Green", [4] = "Black",
    [5] = "Blue", [6] = "Purple", [7] = "Orange", [8] = "Gold",
    [9] = "Chaos", [10] = "Apocalypse", [11] = "Oblivion", [12] = "Transcendent"
  }
  return mod_loc(names[stake_level] or "Unknown")
end

