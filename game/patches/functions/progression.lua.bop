  COUNTED = {casino_purchase = true, minigame_played = true, boss_practice = true, forge_created = true, deck_saved = true, daily_started = true, replay_watched = true, cosmetic_equipped = true},

  ACH_XP = {Common = 150, Uncommon = 250, Rare = 400, Epic = 700, Legendary = 1200},
}

function progression_save()
  if QuestManager and QuestManager.queue_save then return QuestManager.queue_save() end
  if G and G.save_progress then pcall(function() G:save_progress() end) end
end

function progression_notify(kind, a, b)
  if ProgressionUI and ProgressionUI.toast then
    pcall(ProgressionUI.toast, {kind = kind, a = a, b = b})
  end
end

function progression_counts()
  if not progression_init() then return {} end
  local pr = G.PROFILES[G.SETTINGS.profile].progression
  if type(pr.counts) ~= "table" then pr.counts = {} end
  return pr.counts
end

local function forge_store_count()
  local st = package.loaded["functions/forge/forge_store"]
  if type(st) ~= "table" or type(st.all) ~= "function" then return 0 end
  local ok, list = pcall(st.all)
  return ok and type(list) == "table" and #list or 0
end

function progression_milestone_value(m)
  if not progression_init() then return 0 end
  local profile = G.PROFILES[G.SETTINGS.profile]
  local pr = profile.progression
  local t = m.type
  if t == "wins" then return tonumber(pr.total_wins) or 0 end
  if t == "level" then return tonumber(pr.level) or 1 end
  if t == "stake" then return tonumber(pr.highest_stake_beaten) or 0 end
  if t == "quests" then
    local q = QuestManager and QuestManager.data and QuestManager.data()
    return q and tonumber(q.total) or 0
  end
  if t == "journeys" then
    local q = QuestManager and QuestManager.data and QuestManager.data()
    local n = 0
    for _, st in pairs(q and q.long or {}) do n = n + (tonumber(st.s) or 0) end
    return n
  end
  if t == "achievements" then
    local AM = rawget(_G, "AchievementManager")
    if AM and AM.count_unlocked then
      local ok, n = pcall(AM.count_unlocked)
      if ok then return tonumber(n) or 0 end
    end
    return 0
  end
  if t == "mp_matches" or t == "mp_wins" then
    local mp = profile.mp_progression
    if type(mp) ~= "table" then return 0 end
    return tonumber(t == "mp_wins" and mp.wins or mp.matches) or 0
  end
  local n = tonumber(progression_counts()[t]) or 0
  if t == "forge_created" then n = math.max(n, forge_store_count()) end
  return n
end

function progression_milestones()
  local out = {}
  local done = 0
  local profile = progression_init() and G.PROFILES[G.SETTINGS.profile]
  local got = profile and profile.progression.milestones or {}
  for _, m in ipairs(PROGRESSION.MILESTONES) do
    local v = progression_milestone_value(m)
    out[#out + 1] = {def = m, value = v, done = got[m.key] and true or false}
    if got[m.key] then done = done + 1 end
  end
  return out, done
end

function progression_level_reward(level)
  level = tonumber(level) or 1
  local bc = 20 + 10 * level
  for _, r in ipairs(PROGRESSION.RANKS) do
    if r.min_level == level and level > 1 then bc = bc + 10 * level end
  end
  return bc
end

function progression_unclaimed_levels()
  if not progression_init() then return {} end
  local pr = G.PROFILES[G.SETTINGS.profile].progression
  pr.rewards_claimed = pr.rewards_claimed or {}
  if not pr.rewards_start then
    pr.rewards_start = tonumber(pr.level) or 1
  end
  local out = {}
  for lv = math.max(2, pr.rewards_start + 1), tonumber(pr.level) or 1 do
    if not pr.rewards_claimed[tostring(lv)] then out[#out + 1] = lv end
  end
  return out
end

function progression_level_state(lv)
  local pr = progression_init() and G.PROFILES[G.SETTINGS.profile].progression or {}
  local cur = tonumber(pr.level) or 1
  if lv > cur then return "locked" end
  if lv <= (pr.rewards_start or cur) then return "before" end
  if (pr.rewards_claimed or {})[tostring(lv)] then return "claimed" end
  return "ready"
end

function progression_claim_level(lv)
  if progression_level_state(lv) ~= "ready" then return false end
  local pr = G.PROFILES[G.SETTINGS.profile].progression
  local bc = progression_level_reward(lv)
  pr.rewards_claimed[tostring(lv)] = true
  pr.balacoin = (tonumber(pr.balacoin) or 0) + bc
  pr.total_balacoin_earned = (tonumber(pr.total_balacoin_earned) or 0) + bc
  progression_save()
  return true, bc
end

function progression_add_xp(amount, source)
  if not amount or amount <= 0 or not progression_init() then return end
  local pr = G.PROFILES[G.SETTINGS.profile].progression
  pr.total_xp = (tonumber(pr.total_xp) or 0) + amount
  pr.xp_sources = pr.xp_sources or {}
  if source then pr.xp_sources[source] = (pr.xp_sources[source] or 0) + amount end
  check_level_up()
  check_milestones()
  progression_save()
end

if ProgressEvents and not PROGRESSION.listening then
  PROGRESSION.listening = true
  ProgressEvents.on("*", function(data, name)
    if PROGRESSION.COUNTED[name] then
      local c = progression_counts()
      c[name] = (tonumber(c[name]) or 0) + 1
      pcall(check_milestones)
      progression_save()
    end
  end)
  ProgressEvents.on("achievement_unlocked", function(data)
    local AM = rawget(_G, "AchievementManager")
    local a = AM and AM.get_achievement and AM.get_achievement(data.key)
    local xp = PROGRESSION.ACH_XP[a and a.rarity or ""] or 250
    progression_add_xp(xp, "achievements")
  end)
  ProgressEvents.on("mp_match", function() pcall(check_milestones) end)
end

-- ===== INITIALIZATION =====

-- Ensure progression data exists in profile
function progression_init()
  if not G then return false end
  if not G.PROFILES then return false end
  if not G.SETTINGS then return false end
  if not G.SETTINGS.profile then return false end

  local profile = G.PROFILES[G.SETTINGS.profile]
  if not profile then return false end

  -- Initialize progression table if missing
  if not profile.progression then
    profile.progression = {
      xp = 0,
      level = 1,
      total_xp = 0,

      -- Balacoin currency (V10.5)
      balacoin = 0,
      total_balacoin_earned = 0,

      -- XP source tracking
      xp_sources = {
        hands_played = 0,
        ante_cleared = 0,
        boss_defeated = 0,
        run_wins = 0,
      },

      -- Milestones achieved (by key)
      milestones = {},

      -- Rewards claimed (by level)
      rewards_claimed = {},

      -- Stats
      total_wins = 0,
      highest_stake_beaten = 0,
      total_runs = 0,
      total_hands_played = 0,
      highest_score = 0,

      -- Quest tracking (V10.5)
      total_quests_completed = 0,
      daily_quests_completed = 0,
      weekly_quests_completed = 0,

      -- Cosmetics (V10.5)
      unlocked_titles = {},
      unlocked_banners = {"default"},
      unlocked_badges = {"default"},
      unlocked_borders = {"default"},
      equipped_title = nil,
      equipped_banner = "default",
      equipped_badge = "default",
      equipped_border = "default",

      -- Shop purchases (V10.5)
      purchases = {},
    }
  else
    -- Ensure V10.5 fields exist for existing profiles
    if profile.progression.balacoin == nil then
      profile.progression.balacoin = 0
    end
    if profile.progression.total_balacoin_earned == nil then
      profile.progression.total_balacoin_earned = 0
    end
    if profile.progression.total_runs == nil then
      profile.progression.total_runs = 0
    end
    if profile.progression.total_hands_played == nil then
      profile.progression.total_hands_played = 0
    end
    if profile.progression.highest_score == nil then
      profile.progression.highest_score = 0
    end
    if profile.progression.total_quests_completed == nil then
      profile.progression.total_quests_completed = 0
    end
    if profile.progression.daily_quests_completed == nil then
      profile.progression.daily_quests_completed = 0
    end
    if profile.progression.weekly_quests_completed == nil then
      profile.progression.weekly_quests_completed = 0
    end
    if profile.progression.unlocked_titles == nil then
      profile.progression.unlocked_titles = {}
    end
    if profile.progression.unlocked_banners == nil then
      profile.progression.unlocked_banners = {"default"}
    end
    if profile.progression.unlocked_badges == nil then
      profile.progression.unlocked_badges = {"default"}
    end
    if profile.progression.unlocked_borders == nil then
      profile.progression.unlocked_borders = {"default"}
    end
    if profile.progression.equipped_title == nil then
      profile.progression.equipped_title = nil
    end
    if profile.progression.equipped_banner == nil then
      profile.progression.equipped_banner = "default"
    end
    if profile.progression.equipped_badge == nil then
      profile.progression.equipped_badge = "default"
    end
    if profile.progression.equipped_border == nil then
      profile.progression.equipped_border = "default"
    end
    if profile.progression.purchases == nil then
      profile.progression.purchases = {}
    end
  end
  if type(profile.progression.milestones) ~= "table" then profile.progression.milestones = {} end
  if type(profile.progression.rewards_claimed) ~= "table" then profile.progression.rewards_claimed = {} end
  if profile.progression.rewards_start == nil then
    profile.progression.rewards_start = tonumber(profile.progression.level) or 1
  end

  return true
end

-- ===== XP CALCULATIONS =====

-- Calculate XP needed for a specific level
function get_xp_for_level(level)
  if not level or level < 1 then level = 1 end
  return math.floor(PROGRESSION.LEVEL_BASE * (level ^ PROGRESSION.LEVEL_EXPONENT))
end

-- Calculate total XP needed to reach a level from level 1 (memoized)
local _total_xp_cache = {}
function get_total_xp_for_level(level)
  if not level or level < 1 then return 0 end
  if _total_xp_cache[level] then return _total_xp_cache[level] end
  local total = 0
  for i = 1, level - 1 do
    total = total + get_xp_for_level(i)
  end
  _total_xp_cache[level] = total
  return total
end

-- Get current level from total XP
function get_level_from_xp(total_xp)
  if not total_xp or total_xp < 0 then return 1 end
  local level = 1
  local xp_remaining = total_xp

  while true do
    local xp_needed = get_xp_for_level(level)
    if xp_remaining < xp_needed then
      break
    end
    xp_remaining = xp_remaining - xp_needed
    level = level + 1
  end

  return level, xp_remaining
end

-- Get current rank based on level
function get_rank(level)
  if not level or level < 1 then level = 1 end

  local current_rank = PROGRESSION.RANKS[1]
  for _, rank in ipairs(PROGRESSION.RANKS) do
    if level >= rank.min_level then
      current_rank = rank
    end
  end

  return current_rank
end

-- Get XP multiplier (bonus for high stakes + boosters)
function get_xp_multiplier()
  if not G.GAME then return 1 end
  local stake = G.GAME.stake or 1

  local mult = 1
  if stake >= PROGRESSION.HIGH_STAKE_THRESHOLD then
    mult = PROGRESSION.HIGH_STAKE_BONUS
  end

  -- Apply booster XP multiplier
  if BoosterManager and BoosterManager.get_xp_multiplier then
    local booster_mult = BoosterManager.get_xp_multiplier()
    if booster_mult and booster_mult > 1 then
      mult = mult * booster_mult
    end
  end

  return mult
end

-- ===== XP AWARDING =====

-- Award XP (with anti-cheat check)
function award_xp(amount, source)
  -- Safety checks
  if not amount or amount <= 0 then return false end
  if G and G.GAME and G.GAME.multiplayer then return mp_award_xp(amount, source) end
  if not progression_init() then return false end

  -- Anti-cheat: No XP for modded runs
  if G.GAME and G.GAME.modded_run then
    return false
  end

  -- No XP for seeded runs (except daily challenges)
  if G.GAME and G.GAME.seeded and not G.GAME.daily then
    return false
  end

  -- No XP for challenges (optional - can enable if desired)
  -- if G.GAME and G.GAME.challenge then
  --   return false
  -- end

  local profile = G.PROFILES[G.SETTINGS.profile]
  if not profile or not profile.progression then return false end

  -- Apply high-stake multiplier
  local multiplier = get_xp_multiplier()
  local final_xp = math.floor(amount * multiplier)

  -- Add XP
  profile.progression.xp = (profile.progression.xp or 0) + final_xp
  profile.progression.total_xp = (profile.progression.total_xp or 0) + final_xp

  -- Track source
  if source and profile.progression.xp_sources then
    profile.progression.xp_sources[source] = (profile.progression.xp_sources[source] or 0) + final_xp
  end

  -- Check for level up
  check_level_up()

  -- Check milestones
  check_milestones()

  progression_save()

  return true, final_xp
end

-- Check and process level ups
function check_level_up()
  if not progression_init() then return end

  local profile = G.PROFILES[G.SETTINGS.profile]
  if not profile or not profile.progression then return end

  local old_level = profile.progression.level or 1
  local new_level, xp_into_level = get_level_from_xp(profile.progression.total_xp or 0)

  if new_level > old_level then
    profile.progression.level = new_level
    profile.progression.xp = xp_into_level

    progression_notify("level", new_level)
    if ProgressEvents then ProgressEvents.emit("level_up", {level = new_level, old = old_level}) end
  else
    profile.progression.xp = xp_into_level
  end
end

-- ===== MILESTONE SYSTEM =====

-- Check all milestones
function check_milestones()
  if not progression_init() then return end

  local profile = G.PROFILES[G.SETTINGS.profile]
  if not profile or not profile.progression then return end

  for _, milestone in ipairs(PROGRESSION.MILESTONES) do
    if not profile.progression.milestones[milestone.key] then
      local achieved = false

      achieved = progression_milestone_value(milestone) >= milestone.threshold

      if achieved then
        profile.progression.milestones[milestone.key] = true

        -- Award milestone XP (doesn't trigger anti-cheat)
        profile.progression.total_xp = (profile.progression.total_xp or 0) + milestone.xp_reward

        -- FIX: Check for level-up after awarding milestone XP
        pcall(check_level_up)

        progression_notify("milestone", milestone.name, milestone.xp_reward)
      end
    end
  end
end

-- ===== XP EVENT HOOKS =====

-- Called when a hand is played
function progression_on_hand_played()
  if not G.GAME then return end
  if not is_clean_run() then return end
  local ante = G.GAME.round_resets and G.GAME.round_resets.ante or 1
  local xp = PROGRESSION.XP_PER_HAND * ante
  award_xp(xp, "hands_played")
end

-- Called when an ante is cleared
function progression_on_ante_cleared()
  if not G.GAME then return end
  if not is_clean_run() then return end
  local ante = G.GAME.round_resets and G.GAME.round_resets.ante or 1
  local xp = PROGRESSION.XP_PER_ANTE * ante
  award_xp(xp, "ante_cleared")
end

-- Called when a boss is defeated
function progression_on_boss_defeated()
  if not G.GAME then return end
  if not is_clean_run() then return end
  local ante = G.GAME.round_resets and G.GAME.round_resets.ante or 1
  local xp = PROGRESSION.XP_PER_BOSS * ante
  award_xp(xp, "boss_defeated")
end

-- Called when a run is won
function progression_on_run_win()
  if not G.GAME then return end
  if not progression_init() then return end

  local profile = G.PROFILES[G.SETTINGS.profile]
  if not profile or not profile.progression then return end

  -- Only count non-modded, non-seeded wins (daily challenges count)
  if G.GAME.modded_run or (G.GAME.seeded and not G.GAME.daily) then return end

  -- Increment win counter
  profile.progression.total_wins = (profile.progression.total_wins or 0) + 1

  -- Track highest stake beaten
  local stake = G.GAME.stake or 1
  if stake > (profile.progression.highest_stake_beaten or 0) then
    profile.progression.highest_stake_beaten = stake
  end

  -- Award XP based on stake
  local xp = PROGRESSION.XP_PER_WIN * stake
  award_xp(xp, "run_wins")
end

-- ===== ANTI-CHEAT SYSTEM =====

-- Mark current run as modded (disables ALL progression)
function mark_run_as_modded(reason)
  if not G then return end
  if not G.GAME then return end
  if G.GAME.multiplayer or (bom_match and bom_match.is_in_match and bom_match.is_in_match()) then return end

  if not G.GAME.modded_run then
    G.GAME.modded_run = true
    G.GAME.modded_reason = reason or "Mod menu used"

    -- Show prominent popup notification
    pcall(function()
      if G.E_MANAGER and Event then
