-- ============================================
-- PROGRESSION SYSTEM for Balatro v10.5
-- Account XP, Levels, Ranks, Milestones
-- Balacoin Currency, Anti-Cheat Integration
-- ============================================

-- ===== CONSTANTS =====
local PROGRESSION = {
  -- XP multipliers per action
  XP_PER_HAND = 10,         -- × Ante
  XP_PER_ANTE = 100,        -- × Ante
  XP_PER_BOSS = 250,        -- × Ante
  XP_PER_WIN = 1000,        -- × Stake

  -- Gold stake+ bonus multiplier
  HIGH_STAKE_BONUS = 1.5,
  HIGH_STAKE_THRESHOLD = 8, -- Gold stake and above

  -- Level curve: XP = BASE × level^EXPONENT
  LEVEL_BASE = 1000,
  LEVEL_EXPONENT = 1.8,

  -- Rank definitions
  RANKS = {
    {min_level = 1,   name = "Novice",      color = "WHITE"},
    {min_level = 6,   name = "Apprentice",  color = "GREEN"},
    {min_level = 16,  name = "Journeyman",  color = "BLUE"},
    {min_level = 31,  name = "Expert",      color = "PURPLE"},
    {min_level = 51,  name = "Master",      color = "ORANGE"},
    {min_level = 76,  name = "Grandmaster", color = "RED"},
    {min_level = 100, name = "Legend",      color = "GOLD"},
  },

  -- Milestone definitions
  MILESTONES = {
    {key = "first_win",     type = "wins",  threshold = 1,   xp_reward = 500,   name = "First Victory", desc = "Win your first run"},
    {key = "wins_10",       type = "wins",  threshold = 10,  xp_reward = 2000,  name = "Seasoned Player", desc = "Win 10 runs"},
    {key = "wins_50",       type = "wins",  threshold = 50,  xp_reward = 10000, name = "Veteran", desc = "Win 50 runs"},
    {key = "wins_100",      type = "wins",  threshold = 100, xp_reward = 25000, name = "Champion", desc = "Win 100 runs"},
    {key = "level_10",      type = "level", threshold = 10,  xp_reward = 1000,  name = "Rising Star", desc = "Reach level 10"},
    {key = "level_25",      type = "level", threshold = 25,  xp_reward = 5000,  name = "Dedicated", desc = "Reach level 25"},
    {key = "level_50",      type = "level", threshold = 50,  xp_reward = 15000, name = "Committed", desc = "Reach level 50"},
    {key = "level_75",      type = "level", threshold = 75,  xp_reward = 30000, name = "Elite", desc = "Reach level 75"},
    {key = "level_100",     type = "level", threshold = 100, xp_reward = 50000, name = "Legendary", desc = "Reach level 100"},
    {key = "beat_gold",     type = "stake", threshold = 8,   xp_reward = 5000,  name = "Gold Conqueror", desc = "Win on Gold Stake"},
    {key = "beat_insanity", type = "stake", threshold = 9,   xp_reward = 20000, name = "Chaos Tamer", desc = "Win on Chaos Stake"},
    {key = "quests_25",     type = "quests", threshold = 25, xp_reward = 2500,  name = "Quest Taker", desc = "Claim 25 quests"},
    {key = "quests_100",    type = "quests", threshold = 100, xp_reward = 10000, name = "Quest Hero", desc = "Claim 100 quests"},
    {key = "journey_10",    type = "journeys", threshold = 10, xp_reward = 5000, name = "Long Haul", desc = "Finish 10 journey stages"},
    {key = "ach_10",        type = "achievements", threshold = 10, xp_reward = 2000, name = "Trophy Case", desc = "Unlock 10 achievements"},
    {key = "ach_50",        type = "achievements", threshold = 50, xp_reward = 8000, name = "Trophy Hall", desc = "Unlock 50 achievements"},
    {key = "ach_100",       type = "achievements", threshold = 100, xp_reward = 20000, name = "Trophy Museum", desc = "Unlock 100 achievements"},
    {key = "casino_5",      type = "casino_purchase", threshold = 5, xp_reward = 1500, name = "Casino Regular", desc = "Buy 5 items in The Casino"},
    {key = "casino_25",     type = "casino_purchase", threshold = 25, xp_reward = 6000, name = "Casino VIP", desc = "Buy 25 items in The Casino"},
    {key = "arcade_10",     type = "minigame_played", threshold = 10, xp_reward = 1500, name = "Arcade Fan", desc = "Play 10 Arcade games"},
    {key = "practice_5",    type = "boss_practice", threshold = 5, xp_reward = 1500, name = "Sparring", desc = "Fight 5 bosses in the Training Grounds"},
    {key = "forge_1",       type = "forge_created", threshold = 1, xp_reward = 1000, name = "First Forge", desc = "Make a card in The Forge"},
    {key = "forge_10",      type = "forge_created", threshold = 10, xp_reward = 5000, name = "Forge Master", desc = "Make 10 cards in The Forge"},
    {key = "deck_1",        type = "deck_saved", threshold = 1, xp_reward = 1000, name = "Deck Designer", desc = "Save a deck in the Deck Creator"},
    {key = "mp_1",          type = "mp_matches", threshold = 1, xp_reward = 1000, name = "Pull Up a Chair", desc = "Play a Multiplayer match"},
    {key = "mp_wins_10",    type = "mp_wins", threshold = 10, xp_reward = 8000, name = "Table Champion", desc = "Win 10 Multiplayer matches"},
