local function rename_tab_ids(node)
  if type(node) ~= "table" then return end
  local id = node.config and node.config.id
  if type(id) == "string" then
    local n = tonumber(id:match("^tab_but_(%d)$"))
    if n and KEYS[n] then node.config.id = "tab_but_" .. KEYS[n] end
  end
  if node.nodes then
    for _, child in pairs(node.nodes) do rename_tab_ids(child) end
  end
end

local function modded_profile_select_ui()
  G.focused_profile = modded_key(G.focused_profile or G.SETTINGS.profile)
  local tabs = {}
  for i, k in ipairs(KEYS) do
    tabs[i] = {label = i, chosen = G.focused_profile == k, tab_definition_function = G.UIDEF.profile_option, tab_definition_function_args = k}
  end
  local t = create_UIBox_generic_options({padding = 0, contents = {
