local load_profile_func = G.FUNCS.load_profile
G.FUNCS.load_profile = function(...)
  if not modded() then return load_profile_func(...) end
  local cur = Game.init_item_prototypes
  Game.init_item_prototypes = function(self, ...)
    Game.init_item_prototypes = cur
    local ok, err = pcall(cur, self, ...)
    if ok then return end
    print("profile switch: item reload failed, trying again: " .. tostring(err))
    self.RESET_PROTOTYPES = true
    ok, err = pcall(cur, self, ...)
    if not ok then restart_after_switch(err) end
  end
  return load_profile_func(...)
end
