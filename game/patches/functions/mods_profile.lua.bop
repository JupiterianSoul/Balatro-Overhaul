  end
  settings.profile_counters = counters
  G.FILES['settings.jkr'] = settings
  G.PROFILES = {}
  for _, k in ipairs(KEYS) do G.PROFILES[k] = {} end
end

local function default_name(key)
  return "M" .. INDEX[key]
end

