    settings._vanilla_profile = nil
    G.FILES[MODDED_SETTINGS_FILE] = settings
  end
  settings.profile = modded_key(settings.profile)
  local counters = {}
  for _, k in ipairs(KEYS) do
    counters[k] = type(settings.profile_counters) == "table" and tonumber(settings.profile_counters[k]) or 0
  end
  settings.profile_counters = counters
  G.FILES['settings.jkr'] = settings
  G.PROFILES = {}
  for _, k in ipairs(KEYS) do G.PROFILES[k] = {} end
end

local function default_name(key)
  return "M" .. INDEX[key]
end

