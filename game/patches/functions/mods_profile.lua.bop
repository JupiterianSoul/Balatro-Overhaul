MODDED_PROFILE = "modded"
MODDED_PROFILES = {"modded", "modded2", "modded3"}
MODDED_SETTINGS_FILE = "modded_settings.jkr"

local KEYS = MODDED_PROFILES
local INDEX = {}
for i, k in ipairs(KEYS) do INDEX[k] = i end
local PROFILE_FILES = {"profile.jkr", "save.jkr", "meta.jkr", "unlock_notify.jkr"}
local LOCAL_PROFILE_FILES = {["save.jkr"] = true, ["unlock_notify.jkr"] = true}

local function modded()
  local L = rawget(_G, "MODLOADER")
  return L and L.modded or false
end

function modded_profile_index(p)
  return INDEX[p]
end

local function modded_key(p)
  if INDEX[p] then return p end
  if type(p) == "number" and KEYS[p] then return KEYS[p] end
  return KEYS[1]
end

local function file_lists()
  local local_files = {[MODDED_SETTINGS_FILE] = true}
  local names = {MODDED_SETTINGS_FILE}
  for _, k in ipairs(KEYS) do
    for _, name in ipairs(PROFILE_FILES) do
      local file = k .. "/" .. name
      names[#names + 1] = file
      if LOCAL_PROFILE_FILES[name] then local_files[file] = true end
    end
  end
  return local_files, names
end

local function merge_progress(dst, src, depth)
  for k, v in pairs(src) do
    local d = dst[k]
    if d == nil then
      dst[k] = v
    elseif type(d) == "table" and type(v) == "table" and getmetatable(d) == nil and not d.__talisman and depth < 8 then
      merge_progress(d, v, depth + 1)
    elseif type(d) == "number" and type(v) == "number" and v > d then
      dst[k] = v
    elseif d == false and v == true then
      dst[k] = true
    end
  end
end

local function seed_first_modded_profile()
  local fs = love.filesystem
  local dest = KEYS[1]
  local ok, base = pcall(load_local_file, 'settings.jkr')
  local from = tostring(ok and type(base) == "table" and tonumber(base.profile) or 1)
  if not fs.getInfo(from .. "/profile.jkr") then return end
  if not fs.getInfo(dest .. "/profile.jkr") then
    fs.createDirectory(dest)
    for _, name in ipairs({"profile.jkr", "meta.jkr"}) do
      local data = fs.read(from .. "/" .. name)
      if data then fs.write(dest .. "/" .. name, data) end
    end
    return
  end
  local mod_profile = load_local_file(dest .. "/profile.jkr")
  if type(mod_profile) ~= "table" or mod_profile.deleted or mod_profile.overhaul_merged then return end
  local normal_profile = load_local_file(from .. "/profile.jkr")
  if type(normal_profile) ~= "table" or normal_profile.deleted then return end
  local normal_meta = fs.getInfo(from .. "/meta.jkr") and load_local_file(from .. "/meta.jkr")
  local mod_meta = fs.getInfo(dest .. "/meta.jkr") and load_local_file(dest .. "/meta.jkr")
  if type(normal_meta) == "table" then
    if type(mod_meta) ~= "table" then mod_meta = {} end
    merge_progress(mod_meta, normal_meta, 0)
    compress_and_save(dest .. "/meta.jkr", mod_meta)
  end
  local name = mod_profile.name
  merge_progress(mod_profile, normal_profile, 0)
  mod_profile.name = name
  mod_profile.overhaul_merged = true
  compress_and_save(dest .. "/profile.jkr", mod_profile)
  print("[SAVE] modded profile: progress from normal profile " .. from .. " added once")
end

local load_all_files = Game.load_all_files
Game.load_all_files = function(self, retry)
  if not modded() then return load_all_files(self, retry) end
  if not retry then pcall(seed_first_modded_profile) end
