  fr = {
    ["Page %d of %d"] = "Page %d sur %d",
    ["This tab could not be shown."] = "Cet onglet n'a pas pu s'afficher.",
  },
  es = {
    ["Page %d of %d"] = "Página %d de %d",
    ["This tab could not be shown."] = "No se pudo mostrar esta pestaña.",
  },
})
end
