function create_shop_colors_tab()
  local page = ShopUI.color_rarity_page or 1
  if page < 1 then page = 1 end
  if page > #COLOR_PAGES then page = #COLOR_PAGES end
  local page_info = COLOR_PAGES[page]
  local balance = ShopManager.get_balance()
  local all_owned = false
  pcall(function() all_owned = AshCardManager.owns_all_color_sets() end)
  local item_nodes = {}
  for _, set in ipairs(SHOP_COLOR_SETS) do
    if set.rarity and ((page_info.group and set.group == page_info.group) or (not page_info.group and not set.group and set.rarity.id == page_info.rarity_id)) then
      local owned = AshCardManager.owns_color_set(set.id)
      local can_afford = balance >= set.price
      local swatch_nodes = {}
      local preview = {set.blue, set.red, set.green, set.yellow}
      for _, clr in ipairs(preview) do
        table.insert(swatch_nodes, {n=G.UIT.C, config={align="cm", minw=0.28, minh=0.28, r=0.05,
          colour={clr[1]/255, clr[2]/255, clr[3]/255, 1}, padding=0.01}, nodes={}})
      end
      local status_text, status_color
      if owned then
        status_text = mod_loc("OWNED"); status_color = G.C.GREEN
      elseif not can_afford then
        status_text = SHOP_CONFIG.currency_icon .. " " .. set.price; status_color = G.C.UI.TEXT_INACTIVE
      else
        status_text = mod_loc("BUY"); status_color = G.C.BLUE
      end
      local price_text = SHOP_CONFIG.currency_icon .. " " .. set.price
      local row_cfg = {align="cm", padding=0.03, r=0.08, colour=G.C.L_BLACK, minw=7.2, minh=0.55, emboss=0.03}
      if not owned and can_afford then
        row_cfg.hover = true; row_cfg.button = "shop_buy_color_set"
        row_cfg.ref_table = {id=set.id, price=set.price, name=set.name}
      end
      table.insert(item_nodes, {n=G.UIT.R, config=row_cfg, nodes={
        {n=G.UIT.C, config={align="cl", minw=1.8}, nodes={
          {n=G.UIT.T, config={text=mod_loc(set.name), scale=0.38, colour=rarity_colour(set.rarity)}}
        }},
        {n=G.UIT.C, config={align="cm", minw=1.6}, nodes=swatch_nodes},
        {n=G.UIT.C, config={align="cm", minw=1.3}, nodes={
          {n=G.UIT.T, config={text=price_text, scale=0.32, colour=G.C.MONEY}}
        }},
        {n=G.UIT.C, config={align="cr", minw=1.5}, nodes={
          {n=G.UIT.T, config={text=status_text, scale=0.32, colour=status_color}}
        }},
      }})
    end
  end
  if page == 5 then
    local poly = SHOP_POLYCHROMATIC
    local poly_owned = AshCardManager.owns_color_set("polychromatic")
    local poly_status, poly_color
    if poly_owned then
      poly_status = mod_loc("OWNED"); poly_color = G.C.GREEN
    elseif not all_owned then
      poly_status = mod_loc("Buy all sets first"); poly_color = G.C.GREY
    else
      poly_status = mod_loc("BUY"); poly_color = G.C.BLUE
    end
    local poly_cfg = {align="cm", padding=0.03, r=0.08, colour=G.C.L_BLACK, minw=7.2, minh=0.55, emboss=0.05}
    if not poly_owned and all_owned then
      poly_cfg.hover = true; poly_cfg.button = "shop_buy_color_set"
      poly_cfg.ref_table = {id="polychromatic", price=poly.price, name=poly.name}
    end
    table.insert(item_nodes, {n=G.UIT.R, config=poly_cfg, nodes={
      {n=G.UIT.C, config={align="cl", minw=3.4}, nodes={
        {n=G.UIT.T, config={text=mod_loc("Polychromatic"), scale=0.38, colour=G.C.GOLD, shadow=true}}
      }},
      {n=G.UIT.C, config={align="cm", minw=1.3}, nodes={
        {n=G.UIT.T, config={text=SHOP_CONFIG.currency_icon .. " " .. poly.price, scale=0.32, colour=G.C.MONEY}}
      }},
      {n=G.UIT.C, config={align="cr", minw=1.5}, nodes={
        {n=G.UIT.T, config={text=poly_status, scale=0.32, colour=poly_color}}
      }},
    }})
  end
  local page_title_colour = G.C.WHITE
  if page_info.rarity_id == 1 then page_title_colour = G.C.WHITE
  elseif page_info.rarity_id == 2 then page_title_colour = G.C.GREEN
  elseif page_info.rarity_id == 3 then page_title_colour = G.C.BLUE
  elseif page_info.rarity_id == 4 then page_title_colour = HEX("8a2be2")
  elseif page_info.rarity_id == 5 then page_title_colour = G.C.GOLD
  elseif page_info.group then page_title_colour = G.C.ORANGE
  end
  return {n=G.UIT.ROOT, config={align="cm", padding=0.03, colour=G.C.CLEAR, minw=7.5, minh=5.5}, nodes={
    {n=G.UIT.R, config={align="cm", padding=0.03}, nodes={
      {n=G.UIT.T, config={text=mod_loc(page_info.name), scale=0.5, colour=page_title_colour, shadow=true}}
    }},
    {n=G.UIT.R, config={align="tm", padding=0.02}, nodes={
      {n=G.UIT.C, config={align="tm", padding=0.02}, nodes=item_nodes}
    }},
    {n=G.UIT.R, config={align="cm", padding=0.04}, nodes={
      {n=G.UIT.C, config={align="cm", padding=0.04, r=0.1, minw=1.1, minh=0.55,
        colour = page > 1 and G.C.BLUE or G.C.L_BLACK,
        hover = page > 1, button = page > 1 and "shop_color_prev" or nil}, nodes={
        {n=G.UIT.T, config={text="<", scale=0.5, colour = page > 1 and G.C.WHITE or G.C.UI.TEXT_INACTIVE}}
      }},
      {n=G.UIT.C, config={align="cm", minw=2}, nodes={
        {n=G.UIT.T, config={text=page .. " / " .. #COLOR_PAGES, scale=0.4, colour=G.C.WHITE}}
      }},
      {n=G.UIT.C, config={align="cm", padding=0.04, r=0.1, minw=1.1, minh=0.55,
        colour = page < #COLOR_PAGES and G.C.BLUE or G.C.L_BLACK,
        hover = page < #COLOR_PAGES, button = page < #COLOR_PAGES and "shop_color_next" or nil}, nodes={
        {n=G.UIT.T, config={text=">", scale=0.5, colour = page < #COLOR_PAGES and G.C.WHITE or G.C.UI.TEXT_INACTIVE}}
      }},
    }},
  }}
end


function create_shop_icon_effects_tab()
  local balance = ShopManager.get_balance()

  G.shop_icon_area = CardArea(
    G.ROOM.T.x + 0.2*G.ROOM.T.w/2, G.ROOM.T.h,
