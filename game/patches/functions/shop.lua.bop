    G.shop_icon_area:emplace(card)
  end

  return {n=G.UIT.ROOT, config={align="cm", padding=0.05, colour=G.C.CLEAR, minw=7.5, minh=5.5}, nodes={
    {n=G.UIT.R, config={align="cm", padding=0.04}, nodes={
      {n=G.UIT.T, config={text=mod_loc("ICON EFFECTS"), scale=0.45, colour=G.C.WHITE, shadow=true}}
    }},
    {n=G.UIT.R, config={align="cm", padding=0.02}, nodes={
      {n=G.UIT.T, config={text=mod_loc("Visual effect on your Profile Icon"), scale=0.28, colour=G.C.GREY}}
    }},
    {n=G.UIT.R, config={align="cm", padding=0.02}, nodes={
      {n=G.UIT.T, config={text=mod_loc("Tap a card to purchase"), scale=0.24, colour=G.C.UI.TEXT_INACTIVE}}
    }},
    {n=G.UIT.R, config={align="cm", minw=2.5, padding=0.1, r=0.1, colour=G.C.BLACK, emboss=0.05}, nodes={
      {n=G.UIT.R, config={align="cm", padding=0, no_fill=true}, nodes={
        {n=G.UIT.O, config={object = G.shop_icon_area}}
      }},
    }},
  }}
end


