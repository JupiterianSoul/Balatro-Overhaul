    {id="negative",    key="negative",    shader="negative"},
  }

  for i, em in ipairs(edition_map) do
    local card = Card(
      G.shop_icon_area.T.x + G.shop_icon_area.T.w/2,
      G.shop_icon_area.T.y,
      G.CARD_W, G.CARD_H,
      G.P_CARDS.empty,
      G.P_CENTERS['e_'..em.key])
    card:set_edition({[em.key] = true}, true, true)
    card:start_materialize(nil, i > 1)

    local eff_data = nil
    for _, eff in ipairs(SHOP_ICON_EFFECTS) do
      if eff.id == em.id then eff_data = eff; break end
    end

    local owned = eff_data and AshCardManager.owns_icon_effect(eff_data.id) or false
    local can_afford = eff_data and balance >= eff_data.price or false
    local _eff_id = eff_data and eff_data.id
    local _eff_price = eff_data and eff_data.price or 0
    local _eff_name = eff_data and eff_data.name or em.id

    card.states.click.can = true
    local function _buy_action()
      if owned then return end
      if not _eff_id then return end
      show_purchase_confirm(_eff_name, _eff_price, function()
        local ok, msg = AshCardManager.buy_icon_effect(_eff_id)
        if ok then pcall(function() play_sound('sell', 1.0, 0.5) end) end
        refresh_shop()
      end)
    end
    card.click = _buy_action
    card.single_tap = _buy_action

    local popup_status = owned and mod_loc("OWNED") or
