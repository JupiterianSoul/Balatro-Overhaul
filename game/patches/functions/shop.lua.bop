    local ok = BoosterManager.buy_booster(ref.id, ref.price)
    if ok then pcall(function() play_sound('sell', 1.0, 0.5) end) end
    refresh_shop()
  end)
end

function create_UIBox_booster_selection(run_args)
  BoosterManager.init()
  local inv = BoosterManager.get_inventory()
  G._pending_run_args = run_args
  G._booster_selection = {}
  local booster_nodes = {}
  for _, b in ipairs(SHOP_BOOSTERS) do
    local count = inv[b.id] or 0
    if count > 0 then
      table.insert(booster_nodes, {n=G.UIT.R, config={align="cm", padding=0.03, r=0.08, colour=G.C.L_BLACK, minw=6, minh=0.5, emboss=0.03,
        hover=true, button="toggle_booster_select", ref_table={id=b.id, name=b.name, count=count}}, nodes={
        {n=G.UIT.C, config={align="cl", minw=2.5}, nodes={
          {n=G.UIT.T, config={text=b.name, scale=0.28, colour=G.C.WHITE}}}},
        {n=G.UIT.C, config={align="cm", minw=2}, nodes={
          {n=G.UIT.T, config={text=b.description, scale=0.18, colour=G.C.UI.TEXT_LIGHT}}}},
        {n=G.UIT.C, config={align="cr", minw=0.8}, nodes={
          {n=G.UIT.T, config={text="x" .. tostring(count), scale=0.22, colour=G.C.GREEN}}}},
      }})
    end
  end
  if #booster_nodes == 0 then
    booster_nodes = {{n=G.UIT.R, config={align="cm", padding=0.2}, nodes={
      {n=G.UIT.T, config={text=mod_loc("No boosters owned"), scale=0.35, colour=G.C.UI.TEXT_INACTIVE}}}}}
  end
  return create_UIBox_generic_options({
    back_func = 'booster_skip_and_start',
    contents = {
      {n=G.UIT.R, config={align="cm", padding=0.08}, nodes={
        {n=G.UIT.T, config={text=mod_loc("SELECT BOOSTERS"), scale=0.5, colour=G.C.GOLD, shadow=true}}}},
      {n=G.UIT.R, config={align="cm", padding=0.03}, nodes={
        {n=G.UIT.T, config={text=mod_loc("Choose up to ") .. BOOSTER_MAX_ACTIVE .. mod_loc(" boosters for this run"), scale=0.28, colour=G.C.UI.TEXT_LIGHT}}}},
      {n=G.UIT.R, config={align="cm", padding=0.03}, nodes={
        {n=G.UIT.C, config={align="cm", padding=0.03, minw=7, minh=3}, nodes=booster_nodes}}},
      {n=G.UIT.R, config={align="cm", padding=0.05}, nodes={
        {n=G.UIT.T, config={text=mod_loc("Selected: 0/") .. BOOSTER_MAX_ACTIVE, scale=0.3, colour=G.C.WHITE}}}},
      {n=G.UIT.R, config={align="cm", padding=0.08}, nodes={
        {n=G.UIT.C, config={align="cm", padding=0.05, r=0.1, colour=G.C.BLUE, hover=true, button="booster_confirm_and_start", minw=2, minh=0.5}, nodes={
          {n=G.UIT.T, config={text=mod_loc("START RUN"), scale=0.35, colour=G.C.WHITE}}}},
        {n=G.UIT.C, config={align="cm", minw=0.5}, nodes={}},
        {n=G.UIT.C, config={align="cm", padding=0.05, r=0.1, colour=G.C.RED, hover=true, button="booster_skip_and_start", minw=2, minh=0.5}, nodes={
          {n=G.UIT.T, config={text=mod_loc("SKIP"), scale=0.35, colour=G.C.WHITE}}}},
      }},
    }
  })
end

G.FUNCS.toggle_booster_select = function(e)
  if not e or not e.config or not e.config.ref_table then return end
  local bid = e.config.ref_table.id
  G._booster_selection = G._booster_selection or {}
  local found = false
  for i, sel in ipairs(G._booster_selection) do
    if sel == bid then table.remove(G._booster_selection, i); found = true; break end
  end
  if not found then
    if #G._booster_selection >= BOOSTER_MAX_ACTIVE then pcall(function() play_sound('cancel', 1.0, 0.5) end); return end
    table.insert(G._booster_selection, bid)
  end
  pcall(function() play_sound('card1', 1.0, 0.5) end)
end

