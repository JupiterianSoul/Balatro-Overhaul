function award_balacoin_reward(amount, source)
  if ShopManager.add_balacoin(amount) then
    print("[SHOP] Awarded " .. amount .. " Balacoin from: " .. (source or "unknown"))
    return true
  end
  return false
end

function get_balacoin_display()
  local balance = ShopManager.get_balance()
  return SHOP_CONFIG.currency_icon .. " " .. balance
end


local SHOP_BOOSTERS = {
  {id = "xp_boost_1", name = "XP Boost I", description = "+50% XP earned this run", price = 200, category = "booster", effects = {xp_mult = 1.5}},
  {id = "xp_boost_2", name = "XP Boost II", description = "+100% XP earned this run", price = 500, category = "booster", effects = {xp_mult = 2.0}},
  {id = "xp_boost_3", name = "XP Boost III", description = "+200% XP earned this run", price = 1200, category = "booster", effects = {xp_mult = 3.0}},
  {id = "bc_bonus_1", name = "Coin Bonus", description = "+50 Balacoins at run end", price = 200, category = "booster", effects = {bc_bonus = 50}},
  {id = "bc_bonus_2", name = "Coin Jackpot", description = "+150 Balacoins at run end", price = 500, category = "booster", effects = {bc_bonus = 150}},
  {id = "quest_rush", name = "Quest Rush", description = "Quest progress x1.5 this run", price = 400, category = "booster", effects = {quest_mult = 1.5}},
  {id = "combo_pack", name = "Combo Pack", description = "+50% XP & +30 BC at run end", price = 350, category = "booster", effects = {xp_mult = 1.5, bc_bonus = 30}},
  {id = "mega_pack", name = "Mega Pack", description = "x2 XP, quest x1.5, +50 BC", price = 900, category = "booster", effects = {xp_mult = 2.0, quest_mult = 1.5, bc_bonus = 50}},
}

local BOOSTER_MAX_ACTIVE = 3

BoosterManager = {initialized_profile = nil}

function BoosterManager.init()
  if not G or not G.PROFILES or not G.SETTINGS or not G.SETTINGS.profile then return false end
  local prof_id = G.SETTINGS.profile
  if BoosterManager.initialized_profile == prof_id then return true end
  local profile = G.PROFILES[prof_id]
  if not profile then return false end
  if not profile.progression then profile.progression = {} end
  if not profile.progression.booster_inventory then profile.progression.booster_inventory = {} end
  if not profile.progression.active_boosters then profile.progression.active_boosters = {} end
  BoosterManager.initialized_profile = prof_id
  return true
end

function BoosterManager.get_inventory()
  if not BoosterManager.init() then return {} end
  return G.PROFILES[G.SETTINGS.profile].progression.booster_inventory or {}
end

function BoosterManager.get_booster_count(booster_id)
  local inv = BoosterManager.get_inventory()
  return inv[booster_id] or 0
end

function BoosterManager.buy_booster(booster_id, price)
  if not BoosterManager.init() then return false end
  if ShopManager.get_balance() < price then return false end
  if not ShopManager.spend_balacoin(price) then return false end
  local inv = G.PROFILES[G.SETTINGS.profile].progression.booster_inventory
  inv[booster_id] = (inv[booster_id] or 0) + 1
  pcall(function() if G and G.save_progress then G:save_progress() end end)
  return true
end

function BoosterManager.get_active_boosters()
  if not BoosterManager.init() then return {} end
  return G.PROFILES[G.SETTINGS.profile].progression.active_boosters or {}
end

function BoosterManager.activate_boosters(booster_ids)
  if not BoosterManager.init() then return false end
  if not booster_ids or #booster_ids == 0 then return true end
  if #booster_ids > BOOSTER_MAX_ACTIVE then return false end
  local profile = G.PROFILES[G.SETTINGS.profile]
  local inv = profile.progression.booster_inventory
  for _, bid in ipairs(booster_ids) do if (inv[bid] or 0) < 1 then return false end end
  for _, bid in ipairs(booster_ids) do
    inv[bid] = inv[bid] - 1
    if inv[bid] <= 0 then inv[bid] = nil end
  end
  profile.progression.active_boosters = {}
  for _, bid in ipairs(booster_ids) do table.insert(profile.progression.active_boosters, bid) end
  pcall(function() if G and G.save_progress then G:save_progress() end end)
  return true
end

function BoosterManager.clear_active()
  if not BoosterManager.init() then return end
  G.PROFILES[G.SETTINGS.profile].progression.active_boosters = {}
  pcall(function() if G and G.save_progress then G:save_progress() end end)
end

function BoosterManager.get_xp_multiplier()
  local active = BoosterManager.get_active_boosters()
  if #active == 0 then return 1 end
  local best = 1
  for _, bid in ipairs(active) do
    for _, b in ipairs(SHOP_BOOSTERS) do
      if b.id == bid and b.effects and b.effects.xp_mult and b.effects.xp_mult > best then best = b.effects.xp_mult end
    end
  end
  return best
end

function BoosterManager.get_quest_multiplier()
  local active = BoosterManager.get_active_boosters()
  if #active == 0 then return 1 end
  local best = 1
  for _, bid in ipairs(active) do
    for _, b in ipairs(SHOP_BOOSTERS) do
      if b.id == bid and b.effects and b.effects.quest_mult and b.effects.quest_mult > best then best = b.effects.quest_mult end
    end
  end
  return best
end

function BoosterManager.get_bc_bonus()
  local active = BoosterManager.get_active_boosters()
  if #active == 0 then return 0 end
  local total = 0
  for _, bid in ipairs(active) do
    for _, b in ipairs(SHOP_BOOSTERS) do
      if b.id == bid and b.effects and b.effects.bc_bonus then total = total + b.effects.bc_bonus end
    end
  end
  return total
end

function BoosterManager.on_run_end()
  local bonus = BoosterManager.get_bc_bonus()
  if bonus > 0 then ShopManager.add_balacoin(bonus) end
  BoosterManager.clear_active()
end

function BoosterManager.get_booster_info(booster_id)
  for _, b in ipairs(SHOP_BOOSTERS) do if b.id == booster_id then return b end end
  return nil
end


G.FUNCS.shop_buy_booster = function(e)
