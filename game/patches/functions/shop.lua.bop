local SHOP_CONFIG = {
  currency_name = "Balacoin",
  currency_icon = "BC",
  items_per_page = 6,
}


ShopManager = {
  initialized_profile = nil,
  current_tab = "titles",
  current_page = 1,
}

function ShopManager.init()
  if not G then return false end
  if not G.PROFILES then return false end
  if not G.SETTINGS then return false end
  if not G.SETTINGS.profile then return false end
  local prof_id = G.SETTINGS.profile
  if ShopManager.initialized_profile == prof_id then return true end
  local profile = G.PROFILES[prof_id]
  if not profile then return false end
  if not profile.progression then profile.progression = {} end
  if not profile.progression.balacoin then profile.progression.balacoin = 0 end
  if not profile.progression.purchases then profile.progression.purchases = {} end
  ShopManager.initialized_profile = prof_id
  return true
end

function ShopManager.get_balance()
  if not ShopManager.init() then return 0 end
  local profile = G.PROFILES[G.SETTINGS.profile]
  if not profile or not profile.progression then return 0 end
  return profile.progression.balacoin or 0
end

function ShopManager.add_balacoin(amount)
  if G and G.GAME and G.GAME.modded_run then return false end
  if not ShopManager.init() then return false end
  if not amount or amount <= 0 then return false end
  local profile = G.PROFILES[G.SETTINGS.profile]
  if not profile or not profile.progression then return false end
  profile.progression.balacoin = (profile.progression.balacoin or 0) + amount
  pcall(function() if G and G.save_progress then G:save_progress() end end)
  return true
end

function ShopManager.spend_balacoin(amount)
  if not ShopManager.init() then return false end
  if not amount or amount <= 0 then return false end
  local profile = G.PROFILES[G.SETTINGS.profile]
  if not profile or not profile.progression then return false end
  local current = profile.progression.balacoin or 0
  if current < amount then return false end
  profile.progression.balacoin = current - amount
  pcall(function() if G and G.save_progress then G:save_progress() end end)
  return true
end

function ShopManager.is_owned(item_id, category)
  if not AshCardManager then return false end
  if category == "color_set" then return AshCardManager.owns_color_set(item_id)
  elseif category == "icon_effect" then return AshCardManager.owns_icon_effect(item_id)
  end
  return false
end

function ShopManager.purchase(item_id, category, price)
  if not ShopManager.init() then return false, "Shop not initialized" end
  if not AshCardManager then return false, "Not initialized" end
  local success, msg
  if category == "color_set" then success, msg = AshCardManager.buy_color_set(item_id)
  elseif category == "icon_effect" then success, msg = AshCardManager.buy_icon_effect(item_id)
  else return false, "Unknown category" end
  if success then
    local profile = G.PROFILES[G.SETTINGS.profile]
    if profile and profile.progression and profile.progression.purchases then
      table.insert(profile.progression.purchases, {id = item_id, category = category, price = price, timestamp = os.time()})
    end
    pcall(function() if G and G.save_progress then G:save_progress() end end)
  end
  return success, msg
end


local ShopUI = {
  color_rarity_page = 1,
  active_tab = 1,
  jimbo_skin_page = 1,
}

local JIMBO_SKIN_PRICES = { [1]=5, [2]=15, [3]=30, [4]=60 }

local function jimbo_skin_price(center)
  if not center then return 10 end
  return JIMBO_SKIN_PRICES[center.rarity] or 10
end

function JimboSkinManager_init()
  if not G or not G.PROFILES or not G.SETTINGS then return false end
  local profile = G.PROFILES[G.SETTINGS.profile]
  if not profile then return false end
  if not profile.progression then profile.progression = {} end
  if not profile.progression.owned_jimbo_skins then profile.progression.owned_jimbo_skins = {} end
  if not profile.progression.equipped_jimbo_skin then profile.progression.equipped_jimbo_skin = 'j_joker' end
  return true
end

function JimboSkinManager_is_owned(key)
  if not JimboSkinManager_init() then return false end
  local profile = G.PROFILES[G.SETTINGS.profile]
  local owned = profile.progression.owned_jimbo_skins
  if not owned._set then
    owned._set = {}
    for _, v in ipairs(owned) do owned._set[v] = true end
  end
  if key == 'j_joker' then return true end
  return owned._set[key] == true
end

function JimboSkinManager_buy(key, price)
  if not JimboSkinManager_init() then return false end
  if JimboSkinManager_is_owned(key) then return false end
  if not ShopManager.spend_balacoin(price) then return false end
  local profile = G.PROFILES[G.SETTINGS.profile]
  table.insert(profile.progression.owned_jimbo_skins, key)
  profile.progression.owned_jimbo_skins._set = nil
  pcall(function() if G and G.save_progress then G:save_progress() end end)
  return true
end

function JimboSkinManager_equip(key)
  if not JimboSkinManager_init() then return false end
  if not JimboSkinManager_is_owned(key) then return false end
  local profile = G.PROFILES[G.SETTINGS.profile]
  profile.progression.equipped_jimbo_skin = key
  pcall(function() if G and G.save_progress then G:save_progress() end end)
  return true
end

function JimboSkinManager_get_equipped()
  if not JimboSkinManager_init() then return 'j_joker' end
  local profile = G.PROFILES[G.SETTINGS.profile]
  return profile.progression.equipped_jimbo_skin or 'j_joker'
end

function JimboSkinManager_unlock_all()
  if not JimboSkinManager_init() then return end
  local profile = G.PROFILES[G.SETTINGS.profile]
  local owned = profile.progression.owned_jimbo_skins
  local existing = {}
  for _, v in ipairs(owned) do existing[v] = true end
  local pool = G.P_CENTER_POOLS and G.P_CENTER_POOLS['Joker']
  if pool then
    for _, center in ipairs(pool) do
      if center.key and not existing[center.key] then
        table.insert(owned, center.key)
      end
    end
  end
  owned._set = nil
  pcall(function() if G and G.save_progress then G:save_progress() end end)
end

function JimboSkinManager_owned_count()
  if not JimboSkinManager_init() then return 0 end
  local profile = G.PROFILES[G.SETTINGS.profile]
  return #(profile.progression.owned_jimbo_skins) + 1
end

local COLOR_PAGES = {
  {name = "Common",    rarity_id = 1},
  {name = "Uncommon",  rarity_id = 2},
  {name = "Rare",      rarity_id = 3},
  {name = "Epic",      rarity_id = 4},
  {name = "Legendary", rarity_id = 5},
}
for _, g in ipairs(SHOP_COLOR_GROUPS or {}) do COLOR_PAGES[#COLOR_PAGES + 1] = {name = g, group = g} end

local function rarity_colour(rarity)
  if not rarity or not G or not G.C then return G and G.C and G.C.WHITE or {1,1,1,1} end
  local c = rarity.color or "WHITE"
  if c == "PURPLE" and G.C.PURPLE then return G.C.PURPLE end
  if c == "PURPLE" then return HEX("8a2be2") end
  return G.C[c] or G.C.WHITE
end


