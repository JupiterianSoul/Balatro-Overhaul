    B.win_seen = nil
    local back = a.deck and G.P_CENTERS[a.deck] or (G.GAME.selected_back and G.GAME.selected_back.effect and G.GAME.selected_back.effect.center)
    local stake = tonumber(a.stake) or G.GAME.stake or 1
r 13 1825 %20%20%20%20 -
