end

APPLY.menu = function()
    B.win_seen = nil
    B.leaving_game = G.GAME
    G.FUNCS.go_to_menu()
    return true
end

function B.act(a)
    local phase = B.phase()
    local ok, why = B.validate(a, phase)
    if not ok then
        B.last_refusal = {action = a, reason = why}
        return false, why
    end
    local f = APPLY[a.type]
    if not f then
        B.last_refusal = {action = a, reason = "unknown action"}
        return false, "unknown action"
    end
    B.acting = true
    local pok, res, res_why = pcall(f, a, phase)
    B.acting = false
    if not pok then
        B.last_refusal = {action = a, reason = "error: " .. tostring(res)}
        return false, "error: " .. tostring(res)
    end
    if not res then
        B.last_refusal = {action = a, reason = res_why}
        return false, res_why
    end
    B.last_refusal = nil
    B.last_action = a
    B.actions = (B.actions or 0) + 1
    return true
end

B.card_anywhere = card_anywhere
