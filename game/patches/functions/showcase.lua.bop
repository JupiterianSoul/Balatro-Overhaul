G.FUNCS.replay_overhaul_tutorial = function(e)
    G.FUNCS.start_overhaul_showcase(e)
end

local function skip_overhaul()
    close_tutorial_overlay()
    G.SETTINGS.showcase_seen = true
    G.SETTINGS.overhaul_tips_off = true
    save_tutorial_state()
end

G.FUNCS.skip_showcase = function(e)
    local tip = G.OVERLAY_TUTORIAL and G.OVERLAY_TUTORIAL.overhaul == 'tip'
    if tip then
        close_tutorial_overlay()
        return
    end
    skip_overhaul()
    refresh_tutorial_ui()
end

G.FUNCS.skip_overhaul_tutorial = function(e)
    skip_overhaul()
    refresh_tutorial_ui()
end

G.FUNCS.skip_tutorial = function(e)
    local vanilla_left = not G.SETTINGS.tutorial_complete or (G.OVERLAY_TUTORIAL and not G.OVERLAY_TUTORIAL.overhaul)
    skip_overhaul()
    if vanilla_left and G.FUNCS.skip_vanilla_tutorial then
        G.FUNCS.skip_vanilla_tutorial(e)
    else
        refresh_tutorial_ui()
    end
end

