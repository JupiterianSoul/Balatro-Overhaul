end

local function run_sub_showcase(id, steps)
    if not G then return end
    if sub_showcase_seen(id) then return end
    if G.SETTINGS and G.SETTINGS.overhaul_tips_off then return end

    -- Don't run if another tutorial/showcase is active
    if G.OVERLAY_TUTORIAL then return end
    load_overhaul_text()

    mark_sub_showcase_seen(id)
    sub_showcase_in_menu = G.OVERLAY_MENU ~= nil

