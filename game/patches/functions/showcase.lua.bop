-- ============================================================================
-- FEATURE: Overhaul Showcase — Guided Tour of All New Features
-- Uses the vanilla tutorial overlay system (G.OVERLAY_TUTORIAL) to walk
-- the player through every Overhaul feature with Jimbo explaining each one,
-- gray overlay dimming, and highlighted UI elements.
--
-- Triggered from Settings → "What's New" button, or auto on first launch.
-- Also provides sub-showcases that trigger when entering a feature for
-- the first time.
-- ============================================================================

local OVT = require "functions/showcase_text"
mod_loc_register(OVT.STRINGS)

local function load_overhaul_text()
    local tut = G.localization and G.localization.misc and G.localization.misc.tutorial
    if not tut then return end
    local lang = tostring(G.SETTINGS.language or "en-us")
    local key = (lang == "fr" and "fr") or ((lang == "es_ES" or lang == "es_419") and "es") or "en"
    local parsed = G.localization.tutorial_parsed
    local parse = rawget(_G, "loc_parse_string")
    for k, by_lang in pairs(OVT.TOUR) do
        local lines = by_lang[key] or by_lang.en
        tut[k] = lines
        if parsed and parse then
            local t = {multi_line = true}
            for i, v in ipairs(lines) do t[i] = parse(v) end
            parsed[k] = t
        end
    end
end

local function overhaul_mascot()
    return G.P_CENTERS.j_hologram or G.P_CENTERS.j_joker
end

