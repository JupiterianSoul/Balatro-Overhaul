G.FUNCS.showcase_run_steps = function()
    local step = 1
    for _, s in ipairs(TOUR) do
        step = showcase_info({
            text_key = s.key,
            highlight = s.mark,
            attach = {major = G.ROOM_ATTACH, type = 'cm', offset = {x = 0, y = -1}},
            step = step,
        })
    end

