local function refresh_tutorial_ui()
    if G.STAGE == G.STAGES.MAIN_MENU and G.MAIN_MENU_UI then
        G.MAIN_MENU_UI:remove()
        G.MAIN_MENU_UI = nil
        set_main_menu_UI()
    end
    if G.OVERLAY_MENU and UIK and UIK.refresh then UIK.refresh() end
end

local function save_tutorial_state()
    pcall(function() G:save_settings() end)
end

G.FUNCS.overhaul_tutorial_done = function()
    return G.SETTINGS.showcase_seen and G.SETTINGS.overhaul_tips_off and not G.OVERLAY_TUTORIAL and true or false
end

G.FUNCS.start_overhaul_showcase = function(e)
    if not G or not G.SETTINGS then return end
    if G.STAGE ~= G.STAGES.MAIN_MENU then return end

    G.SETTINGS.sub_showcases_seen = {}
    G.SETTINGS.showcase_seen = false
    G.SETTINGS.overhaul_tips_off = nil

