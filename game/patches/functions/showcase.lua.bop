                if G.SETTINGS then
                    G.SETTINGS.showcase_seen = true
                    save_tutorial_state()
                end
                refresh_tutorial_ui()
                return true
            end
            return not G.OVERLAY_TUTORIAL or G.OVERLAY_TUTORIAL.skip_steps
        end
    }), 'tutorial')
end

-- ============================================================================
-- SECTION 7 — Sub-Showcase System (contextual Jimbo tips on first visit)
-- ============================================================================

--- Initialize the sub-showcase tracking table in settings
local function ensure_sub_showcases_table()
    if not G or not G.SETTINGS then return end
    if not G.SETTINGS.sub_showcases_seen then
        G.SETTINGS.sub_showcases_seen = {}
    end
end

--- Check if a sub-showcase has already been shown
--- @param id string  Sub-showcase identifier (e.g. "tavern_quests")
--- @return boolean
local function sub_showcase_seen(id)
    ensure_sub_showcases_table()
    if not G or not G.SETTINGS or not G.SETTINGS.sub_showcases_seen then return true end
    return G.SETTINGS.sub_showcases_seen[id] == true
end

--- Mark a sub-showcase as seen
--- @param id string  Sub-showcase identifier
local function mark_sub_showcase_seen(id)
    ensure_sub_showcases_table()
    if not G or not G.SETTINGS then return end
    G.SETTINGS.sub_showcases_seen[id] = true
end

--- Run a sub-showcase with the given steps.
--- Each step is a table with {text_key, highlight_func (optional)}.
--- @param id string  Sub-showcase identifier for tracking
--- @param steps table  Array of {text_key=string, highlight=function|nil}
