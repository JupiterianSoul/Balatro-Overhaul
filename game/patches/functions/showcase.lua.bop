                func = function()
                    pcall(function()
                        if G.FUNCS.start_overhaul_showcase then G.FUNCS.start_overhaul_showcase() end
                    end)
                    return true
                end
            }))
        else
            G.SETTINGS.showcase_after_restart = true
            G.FUNCS.restart_after_settings_save()
        end
        return
    end

    -- Reload localization for the new language
    pcall(function()
        if G.set_language then G:set_language() end
    end)

    -- Defer rebuild + showcase to a clean event tick so the click handler
    -- finishes and the overlay removal is fully processed.
r 4 229 %20%20%20%20 -
r 1 112 %20%20%20%20 -
l 15
        trigger = 'after',
        delay = 0.1,
        no_delete = true,
        blockable = false,
        blocking = false,
        func = function()
            pcall(function()
                if G.delete_run then G:delete_run() end
                if G.init_item_prototypes then G:init_item_prototypes() end
            end)
            local built = pcall(function()
                if G.main_menu then G:main_menu() end
            end)
            if not built then return true end
            -- After the menu is rebuilt in the new language, start the showcase.
r 1 112 %20%20%20%20%20%20%20%20%20%20%20%20 -
l 28
                trigger = 'after',
                delay = 0.4,
                no_delete = true,
                blockable = false,
                blocking = false,
                func = function()
                    if G.STAGE ~= G.STAGES.MAIN_MENU then return true end
                    if not G.MAIN_MENU_UI or G.OVERLAY_MENU then return false end
                    pcall(function()
                        if G.FUNCS.start_overhaul_showcase then
                            G.FUNCS.start_overhaul_showcase()
                        end
                    end)
                    return true
                end
            }))
            return true
        end
    }))
end

--- Check if we should show the language selector on startup.
--- Called from main menu initialization.
G.FUNCS.check_first_launch = function()
    if not G or not G.SETTINGS then return end
    -- Only show on very first launch (never chose language before)
    if G.SETTINGS.language_chosen and G.SETTINGS.showcase_after_restart and not G.SETTINGS.showcase_seen then
        G.SETTINGS.showcase_after_restart = nil
r 1 112 %20%20%20%20%20%20%20%20 -
l 16
            trigger = 'after',
            delay = 0.8,
            func = function()
                pcall(function()
                    if G.FUNCS.start_overhaul_showcase then G.FUNCS.start_overhaul_showcase() end
                end)
                return true
            end
        }))
        return
    end
    if G.SETTINGS.language_chosen then return end
    if G.SETTINGS.showcase_seen then return end

    -- Mark language as chosen so this only runs once
    -- (will be set properly when they pick a language)
r 1 112 %20%20%20%20 -
l 15
        trigger = 'after',
        delay = 0.8,
        func = function()
            if not G or not G.SETTINGS then return true end
            if G.SETTINGS.language_chosen then return true end
            pcall(function()
                -- FIX: Use overlay_menu() to create a proper UIBox instead of
                -- assigning the raw UI definition table directly to G.OVERLAY_MENU.
                -- Direct assignment caused crash: translate_container is nil on raw tables.
                G.FUNCS.overlay_menu{definition = G.FUNCS.show_language_selector()}
            end)
            return true
        end
    }))
end
