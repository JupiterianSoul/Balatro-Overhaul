local function showcase_info(args)
    args.button = args.button or {button = localize('b_next'), func = 'showcase_next'}
    args.attach = args.attach or {major = G.ROOM_ATTACH, type = 'cm', offset = {x = 0, y = 0}}
    local portrait = rawget(_G, "PORTRAIT")
    local tall = portrait and portrait.on and portrait.on() or false
    args.center = overhaul_mascot()
    local touch = rawget(_G, "UIK") and UIK.touch() or false
    args.mascot_scale = (tall and 1.6) or (touch and 1.3) or nil
    args.skip_align = tall and 'tr' or 'cr'
    local step = tutorial_info(args)
    if G.OVERLAY_TUTORIAL and not G.OVERLAY_TUTORIAL.overhaul then G.OVERLAY_TUTORIAL.overhaul = args.overhaul or 'tour' end
    return step
end

local function find_menu_button(id)
    if not G or not G.MAIN_MENU_UI then return nil end
    local ok, result = pcall(function()
        return G.MAIN_MENU_UI:get_UIE_by_ID(id)
    end)
    if ok and result then return result end
    return nil
end

local function find_menu_func(func)
    if not G or not G.MAIN_MENU_UI or not G.MAIN_MENU_UI.UIRoot then return nil end
    local function walk(node)
        if node.config and (node.config.button == func or node.tutorial_disabled == func) then return node end
        for _, child in ipairs(node.children or {}) do
            local found = walk(child)
            if found then return found end
        end
    end
    local ok, result = pcall(walk, G.MAIN_MENU_UI.UIRoot)
    if ok then return result end
    return nil
end

local function menu_marks(...)
    local ids = {...}
    return function()
        for _, id in ipairs(ids) do
            local el = find_menu_button(id) or find_menu_func(id)
            if el then return {el} end
        end
        return {}
    end
end

local function find_overlay_element(id)
    if not G or not G.OVERLAY_MENU then return nil end
    local ok, result = pcall(function()
        return G.OVERLAY_MENU:get_UIE_by_ID(id)
    end)
    if ok and result then return result end
    return nil
end

local function find_overlay_prefix(prefix)
    local out = {}
    if not (G and G.OVERLAY_MENU and G.OVERLAY_MENU.UIRoot) then return out end
    local function walk(node)
        local id = node.config and node.config.id
        if type(id) == 'string' and id:sub(1, #prefix) == prefix then out[#out + 1] = node end
        for _, child in ipairs(node.children or {}) do walk(child) end
    end
    pcall(walk, G.OVERLAY_MENU.UIRoot)
    return out
end

local function hl_step(text_key, element_id, jimbo_x, disabled_btns)
    local attach = {major = G.ROOM_ATTACH, type = 'cm', offset = {x = jimbo_x or -5, y = 0}}
    local function place(els)
        local portrait = rawget(_G, "PORTRAIT")
        if portrait and portrait.on and portrait.on() then
            local el = els[1]
            local room_h = G.ROOM and G.ROOM.T.h or 0
            local upper = not el or (el.T.y + el.T.h / 2) < room_h / 2
            attach.offset.x, attach.offset.y = 0, upper and room_h * 0.23 or -room_h * 0.21
        end
        return els
    end
    return {
        text_key = text_key,
        highlight = function()
            if element_id:sub(-1) == '*' then return place(find_overlay_prefix(element_id:sub(1, -2))) end
            local el = find_overlay_element(element_id)
            return place(el and {el} or {})
        end,
        attach = attach,
        disabled_buttons = disabled_btns,
    }
end

local SETTINGS_BTNS = {
    'open_performance_settings',
    'profile_select', 'language_selection', 'start_tutorial', 'start_overhaul_showcase',
    'replay_overhaul_tutorial', 'skip_overhaul_tutorial', 'skip_vanilla_tutorial',
    'toggle_button', 'option_cycle', 'set_cat', 'uik_page',
}

local OPT_BTNS = {
    'toggle_button', 'option_cycle',
}

local JIMBO_BTNS = { 'toggle_button' }

local TOUR = {
    {key = 'ovt_welcome'},
    {key = 'ovt_play', mark = menu_marks('main_menu_play')},
    {key = 'ovt_cheats', mark = menu_marks('main_menu_play')},
