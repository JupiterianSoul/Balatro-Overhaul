--- Show a language selection screen on first launch.
--- After selection, starts the showcase automatically.
G.FUNCS.show_language_selector = function()
    if not G then return end

    local lang_options = {
        {code = "en-us", label = "English"},
        {code = "fr", label = "Français"},
        {code = "es_ES", label = "Español"},
    }

    local title_text = mod_loc("Choose your language:")
    pcall(function()
        local loc = G.localization and G.localization.misc and G.localization.misc.tutorial
        if loc and loc.sc_choose_language then
            title_text = loc.sc_choose_language[1] or title_text
        end
    end)
    title_text = tostring(title_text):gsub("%s*:%s*$", "")

    local w = UIK.touch() and 6.4 or 5.6
    local rows = {}
    for _, lang in ipairs(lang_options) do
        rows[#rows + 1] = {n=G.UIT.R, config={align = "cm", padding = 0.06}, nodes={
            UIK.button{label = lang.label, button = 'select_first_language', ref_table = {lang_code = lang.code}, colour = UIK.C.accent, w = w - 0.8},
        }}
    end

    G.ESC_BACK_FUNCS = G.ESC_BACK_FUNCS or {}
    G.ESC_BACK_FUNCS.first_language_keep = true
    return UIK.window{
        id = 'first_language', compact = true, w = w,
        title = title_text,
        tabs = {{key = 'a', label = '', build = function() return UIK.stack(rows, {w = w - 0.4}) end}},
        back_func = 'first_language_keep',
    }
end

G.FUNCS.first_language_keep = function()
    G.FUNCS.select_first_language({config = {ref_table = {lang_code = G.SETTINGS and G.SETTINGS.language or "en-us"}}})
end

--- Handle language selection from first-launch screen
G.FUNCS.select_first_language = function(e)
    if not e or not e.config or not e.config.ref_table then return end
    local lang_code = e.config.ref_table.lang_code
    if not lang_code then return end
    local modded = rawget(_G, 'SMODS') ~= nil
