function H.play_again(e)
  if not H.can_replay_seed(e) then return end
  if G.FUNCS.exit_overlay_menu then G.FUNCS.exit_overlay_menu() end
  local back = G.P_CENTERS[e.deck] or G.P_CENTERS.b_red
  if e.mode == "challenge" then
    G.FUNCS.start_run(nil, {stake = 1, seed = e.seed, challenge = H.find_challenge(e.challenge)})
    return
  end
  if e.mode == "custom" and RunRules and RunRules.start then
    if G.CUSTOM_RUN then G.CUSTOM_RUN.enabled = true end
    RunRules.start(e.rules or {}, {rules_source = "custom", seed = e.seed, stake = e.stake, back = back})
    return
  end
  if G.CUSTOM_RUN then G.CUSTOM_RUN.enabled = false end
  if G.GAME.viewed_back then G.GAME.viewed_back:change_to(back) else G.GAME.viewed_back = Back(back) end
  G.FUNCS.start_run(nil, {stake = e.stake or 1, seed = e.seed, back = back})
end

