BO_HISTORY = BO_HISTORY or {}
local H = BO_HISTORY
local function L(s) return mod_loc and mod_loc(s) or s end
local function touch() return UIK and UIK.touch and UIK.touch() or false end

H.FILE = "run_history.lua"
H.MAX = 200
H.page = H.page or 1

local function ser(v)
  local t = type(v)
  if t == "number" then
    if v ~= v then return "0" end
    if v == math.huge then return "1e999" end
    if v == -math.huge then return "-1e999" end
    return string.format("%.17g", v)
  elseif t == "string" then
    return string.format("%q", v)
  elseif t == "boolean" then
    return v and "true" or "false"
  elseif t == "table" then
    local parts = {}
    for i = 1, #v do parts[#parts + 1] = ser(v[i]) end
    local keys = {}
    for k in pairs(v) do if type(k) == "string" then keys[#keys + 1] = k end end
    table.sort(keys)
    for _, k in ipairs(keys) do parts[#parts + 1] = "[" .. string.format("%q", k) .. "]=" .. ser(v[k]) end
    return "{" .. table.concat(parts, ",") .. "}"
  end
  return "nil"
end
H.ser = ser

function H.parse(data)
  if type(data) ~= "string" or data == "" then return {} end
  local fn = loadstring(data)
  if not fn then return {} end
  setfenv(fn, {})
  local ok, t = pcall(fn)
  if not (ok and type(t) == "table") then return {} end
  local out = {}
  for _, e in ipairs(t) do
    if type(e) == "table" and type(e.id) == "string" then out[#out + 1] = e end
  end
  return out
end

function H.load()
  if H.list then return H.list end
  local ok, data = pcall(love.filesystem.read, H.FILE)
  H.list = H.parse(ok and data or nil)
  return H.list
end

function H.encode(list)
  local out = {}
  for _, e in ipairs(list) do out[#out + 1] = ser(e) end
  return "return {\n" .. table.concat(out, ",\n") .. "\n}\n"
end

function H.save()
  local list = H.load()
  while #list > H.MAX do table.remove(list) end
  local data = H.encode(list)
  pcall(function() require("functions/fast_fs").write(H.FILE, data) end)
end

function H.upsert(list, e)
  for i, old in ipairs(list) do
    if old.id == e.id then
      table.remove(list, i)
      break
    end
  end
  table.insert(list, 1, e)
  while #list > H.MAX do table.remove(list) end
  return list
end

local function num(v)
  if type(v) == "number" then return v end
  if type(v) == "table" then
    local ok, s = pcall(tostring, v)
    return ok and tonumber(s) or 0
  end
  return tonumber(v) or 0
end

local function new_id()
  H._n = (H._n or 0) + 1
  return tostring(os.time()) .. "-" .. tostring(H._n) .. "-" .. tostring(math.floor((love and love.timer and love.timer.getTime() or os.clock()) * 1000) % 100000)
end

function H.mode_of(g)
  if g.multiplayer then return "mp" end
  if g.daily then return "daily" end
  if g.challenge then return "challenge" end
  if g.run_rules_source == "custom" then return "custom" end
  if g.seeded then return "seeded" end
  return "solo"
end

local function most_played(g)
  local best, n = nil, 0
  for _, v in pairs(g.hand_usage or {}) do
    if type(v) == "table" and (tonumber(v.count) or 0) > n then best, n = v.order, tonumber(v.count) end
  end
  return best, n
end

local function skip_run(g)
  if not (g and g.round_resets) then return true end
  if g.bo_practice then return true end
  local pb = rawget(_G, "bom_playback")
  if pb and pb.active and pb.active() then return true end
  return false
end

function H.snapshot(won, result)
  local g = G and G.GAME
  if skip_run(g) then return nil end
  g.bo_hist_id = g.bo_hist_id or new_id()
  local mode = H.mode_of(g)
  local back = g.selected_back and g.selected_back.effect and g.selected_back.effect.center
  local jokers = {}
  for _, c in ipairs(G.jokers and G.jokers.cards or {}) do
    local key = c.config and c.config.center and c.config.center.key
    if key then jokers[#jokers + 1] = {k = key, e = c.edition and c.edition.type or nil} end
  end
  local hand, count = most_played(g)
  local e = {
    id = g.bo_hist_id, t = os.time(), mode = mode,
    deck = back and back.key or "b_red", stake = tonumber(g.stake) or 1,
    ante = tonumber(g.round_resets.ante) or 1, round = tonumber(g.round) or 0,
    best = num(g.round_scores and g.round_scores.hand and g.round_scores.hand.amt),
    hand = hand, hand_n = count > 0 and count or nil,
    jokers = jokers, won = won and true or nil, result = result,
    profile = G.SETTINGS and tostring(G.SETTINGS.profile) or nil,
  }
  if mode ~= "mp" then e.seed = g.pseudorandom and g.pseudorandom.seed or nil end
  if mode == "challenge" then e.challenge = tostring(g.challenge) end
  if mode == "custom" and type(g.run_rules) == "table" then e.rules = g.run_rules end
  if mode == "daily" and type(g.daily_rules) == "table" then e.daily = g.daily_rules.date end
  return e
end

function H.record(won, result)
  local e = H.snapshot(won, result)
r 13 1300 %20%20 -
l 26
  local list = H.load()
  for _, old in ipairs(list) do
    if old.id == e.id then
      if old.won then e.won = true end
      if old.result and not result then e.result = old.result end
      if old.replay and not e.replay then e.replay = old.replay end
      if old.sprp and not e.sprp then e.sprp = old.sprp end
      if old.opp and not e.opp then e.opp = old.opp end
      if old.mp_mode and not e.mp_mode then e.mp_mode = old.mp_mode end
    end
  end
  if not e.result then e.result = e.won and "win" or "lose" end
  local SR = rawget(_G, "BO_SPREPLAY")
  if SR and SR.on_record then pcall(SR.on_record, e, e.result) end
  H.upsert(list, e)
  H.save()
  return e
end

