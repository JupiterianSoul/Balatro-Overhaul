  end
  if e and H.can_watch(e) then
    local s, sc = button_label(L("WATCH REPLAY"), bw, bs)
    footer[#footer + 1] = UIK.button{label = s, button = "bo_hist_watch", ref_table = {id = id}, colour = UIK.C.accent, w = bw, scale = sc, id = "bo_hist_watch"}
  end
