if type(win_game) == "function" then
  local _hist_win_game = win_game
  win_game = function(...)
    local r = {_hist_win_game(...)}
    if G and G.GAME and not G.GAME.multiplayer then pcall(H.record, true, "win") end
    return unpack(r)
  end
end

local _hist_update_game_over = Game.update_game_over
Game.update_game_over = function(self, dt)
  if not G.STATE_COMPLETE and G.GAME and not G.GAME.multiplayer then
    pcall(H.record, G.GAME.won and true or false, G.GAME.won and "win" or "lose")
  end
  return _hist_update_game_over(self, dt)
end

do
  local bm = rawget(_G, "bom_match")
  if bm and type(bm.end_match) == "function" and not H._mp_hooked then
    H._mp_hooked = true
    local orig = bm.end_match
    bm.end_match = function(...)
