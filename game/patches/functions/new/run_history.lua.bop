local function deck_name(key)
  local ok, name = pcall(localize, {type = "name_text", set = "Back", key = key})
  if ok and type(name) == "string" and name ~= "ERROR" then return name end
  local c = G.P_CENTERS[key]
  return c and c.name or tostring(key)
end

local function stake_name(stake)
  local s = G.P_CENTER_POOLS and G.P_CENTER_POOLS.Stake and G.P_CENTER_POOLS.Stake[stake]
  if s then
    local ok, name = pcall(localize, {type = "name_text", set = "Stake", key = s.key})
    if ok and type(name) == "string" and name ~= "ERROR" then return name end
  end
  return L("Stake") .. " " .. tostring(stake)
end

local function stake_colour(stake)
  local s = G.P_CENTER_POOLS and G.P_CENTER_POOLS.Stake and G.P_CENTER_POOLS.Stake[stake]
  local c = s and G.C.STAKES and G.C.STAKES[stake]
  return c or G.C.WHITE
end

local MODE_LABEL = {solo = "Solo", seeded = "Seeded", challenge = "Challenge", daily = "Daily", custom = "Custom", mp = "Multiplayer"}

local function mode_label(e)
  return L(MODE_LABEL[e.mode] or "Solo")
end

local function challenge_name(id)
  local ok, name = pcall(localize, id, "challenge_names")
  if ok and type(name) == "string" and name ~= "ERROR" then return name end
  return tostring(id)
end

local function hand_name(h)
  if not h then return "-" end
  local ok, name = pcall(localize, h, "poker_hands")
  if ok and type(name) == "string" and name ~= "ERROR" then return name end
  return tostring(h)
end

local function score(v)
  local ok, s = pcall(number_format, v or 0)
  return ok and tostring(s) or tostring(v or 0)
end

local function day(t) return os.date("%Y-%m-%d", tonumber(t) or 0) end

local function result_text(e)
  if e.result == "draw" then return L("DRAW") end
  return (e.won or e.result == "win") and L("WIN") or L("LOSS")
end

local function result_colour(e)
  if e.result == "draw" then return G.C.UI.BACKGROUND_INACTIVE end
  return (e.won or e.result == "win") and G.C.GREEN or G.C.RED
end

function H.can_replay_seed(e)
  if not (e and e.seed) then return false end
  if e.mode == "mp" or e.mode == "daily" then return false end
  if e.mode == "challenge" then return H.find_challenge(e.challenge) ~= nil end
  return G.P_CENTERS[e.deck] ~= nil
end

function H.find_challenge(id)
  for _, ch in ipairs(G.CHALLENGES or {}) do
    if ch.id == id then return ch end
  end
end

function H.can_watch(e)
  if not e then return false end
  local SR = rawget(_G, "BO_SPREPLAY")
  if e.sprp and e.mode ~= "mp" then return SR and SR.exists and SR.exists(e.sprp) or false end
  local RP = rawget(_G, "bom_replay")
  return e.replay and RP and type(RP.watch) == "function" and true or false
end

local function dims()
  if touch() then
    if UIK.portrait() then
      return {row_h = 0.7, scale = 0.44, small = 0.4, head = 0.39, per = 7, gap = 0.1, card = 0.8, box_h = 1.1, val = 0.48, lab = 0.39, port = true}
    end
    return {row_h = 0.84, scale = 0.42, small = 0.39, head = 0.39, per = 5, gap = 0.1, card = 0.8, box_h = 1.1, val = 0.46, lab = 0.39}
  end
  return {row_h = 0.52, scale = 0.33, small = 0.29, head = 0.27, per = 7, gap = 0.1, card = 0.92, box_h = 0.86, val = 0.4, lab = 0.27}
end

local COLS = {
  {key = "date", w = 1.9, label = "Date"},
  {key = "mode", w = 2.0, label = "Mode"},
  {key = "deck", w = 2.5, label = "Deck"},
  {key = "stake", w = 2.0, label = "Stake"},
  {key = "ante", w = 1.1, label = "Ante"},
  {key = "best", w = 1.9, label = "Best hand"},
  {key = "result", w = 1.3, label = "Result"},
  {key = "view", w = 1.5, label = ""},
}

local function kit() return rawget(_G, "bom_kit") end

local function fit(str, w, scale)
  local K = kit()
  if K and K.fit then return K.fit(str, w, scale) end
  return str, scale
end

local function cell(nodes, w, h, o)
  o = o or {}
  return {n = G.UIT.C, config = {align = o.align or "cm", minw = w, maxw = w, minh = h, padding = 0, r = o.r, colour = o.colour or G.C.CLEAR, emboss = o.emboss}, nodes = nodes}
end

local function text(str, scale, colour, shadow)
  return {n = G.UIT.T, config = {text = tostring(str or ""), scale = scale, colour = colour or G.C.UI.TEXT_LIGHT, shadow = shadow ~= false}}
end

local function fit_text(str, w, scale, colour)
  local s, sc = fit(str, w - 0.12, scale)
  return text(s, sc, colour)
end

local function row_of(cells, w, h, colour, id)
  local d = dims()
  local nodes = {}
  for i, c in ipairs(cells) do
    if i > 1 then nodes[#nodes + 1] = {n = G.UIT.C, config = {minw = d.gap, minh = h}, nodes = {}} end
    nodes[#nodes + 1] = c
  end
  return {n = G.UIT.R, config = {align = "cm", minw = w, minh = h, padding = 0.04, r = 0.1, colour = colour or G.C.CLEAR, id = id}, nodes = nodes}
end

local function table_w()
  local d = dims()
  local w = 0
  for _, c in ipairs(COLS) do w = w + c.w end
  return w + (#COLS - 1) * d.gap
end

local function header_row()
  local d = dims()
  local cells = {}
  for _, c in ipairs(COLS) do cells[#cells + 1] = cell({fit_text(c.label ~= "" and L(c.label) or " ", c.w, d.head, UIK.C.muted)}, c.w, d.head + 0.12) end
  return row_of(cells, table_w(), d.head + 0.12)
end

local function list_row(i, e)
  local d = dims()
  local h = d.row_h
  local mode = mode_label(e)
  if e.mode == "challenge" and e.challenge then mode = challenge_name(e.challenge) end
  local vals = {
    date = cell({fit_text(day(e.t), COLS[1].w, d.small, UIK.C.muted)}, COLS[1].w, h),
    mode = cell({fit_text(mode, COLS[2].w, d.small)}, COLS[2].w, h),
    deck = cell({fit_text(deck_name(e.deck), COLS[3].w, d.small)}, COLS[3].w, h),
    stake = cell({fit_text(stake_name(e.stake), COLS[4].w, d.small, stake_colour(e.stake))}, COLS[4].w, h),
    ante = cell({fit_text(tostring(e.ante or 1), COLS[5].w, d.scale)}, COLS[5].w, h),
    best = cell({fit_text(score(e.best), COLS[6].w, d.scale)}, COLS[6].w, h, {r = 0.08, colour = {0, 0, 0, 0.18}}),
    result = cell({fit_text(result_text(e), COLS[7].w, d.small)}, COLS[7].w, h, {r = 0.08, colour = result_colour(e), emboss = 0.03}),
    view = cell({UIK.button{label = L("VIEW"), button = "bo_hist_view", ref_table = {id = e.id}, colour = G.C.BLUE, w = COLS[8].w, h = h, scale = d.small, col = true, id = "bo_hist_view_" .. i}}, COLS[8].w, h),
  }
  local cells = {}
  for _, c in ipairs(COLS) do cells[#cells + 1] = vals[c.key] end
  return row_of(cells, table_w(), h, {0, 0, 0, 0.22}, "bo_hist_row_" .. i)
end

local function port_row(i, e)
  local d = dims()
  local h = d.row_h
  local w = UIK.W - 0.3
  local mode = mode_label(e)
  if e.mode == "challenge" and e.challenge then mode = challenge_name(e.challenge) end
  local gap = d.gap
  local rw, vw, dw = 1.7, 1.6, 2.0
  local mw = w - dw - rw - vw - 3 * gap - 0.1
  local top = {
    cell({fit_text(day(e.t), dw, d.small, UIK.C.muted)}, dw, h),
    cell({fit_text(mode, mw, d.small)}, mw, h),
    cell({fit_text(result_text(e), rw, d.small)}, rw, h, {r = 0.08, colour = result_colour(e), emboss = 0.03}),
    cell({UIK.button{label = L("VIEW"), button = "bo_hist_view", ref_table = {id = e.id}, colour = G.C.BLUE, w = vw, h = h, scale = d.small, col = true, id = "bo_hist_view_" .. i}}, vw, h),
  }
  local aw, bw = 1.6, 2.0
  local kw = (w - aw - bw - 3 * gap - 0.1) / 2
  local bottom = {
    cell({fit_text(deck_name(e.deck), kw, d.small)}, kw, h),
    cell({fit_text(stake_name(e.stake), kw, d.small, stake_colour(e.stake))}, kw, h),
    cell({fit_text(L("Ante") .. " " .. tostring(e.ante or 1), aw, d.small)}, aw, h),
    cell({fit_text(score(e.best), bw, d.scale)}, bw, h, {r = 0.08, colour = {0, 0, 0, 0.18}}),
  }
  return {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.06, r = 0.1, colour = {0, 0, 0, 0.22}, id = "bo_hist_row_" .. i}, nodes = {
    row_of(top, w - 0.12, h),
    row_of(bottom, w - 0.12, h),
  }}
end

local function body_h()
  return UIK.H - UIK.TOP
end

local function build_list()
  local d = dims()
  local list = H.load()
  local pages = math.max(1, math.ceil(#list / d.per))
  H.page = math.max(1, math.min(pages, H.page or 1))
  local pager_h = touch() and 0.94 or 0.78
  local nodes = {}
  if #list == 0 then
    local ew = d.port and UIK.dlg_w(UIK.W) or UIK.W
    local function wrap(str, sc)
      local cur, lines = "", {}
      for word in str:gmatch("%S+") do
        local try = cur == "" and word or (cur .. " " .. word)
        if d.port and cur ~= "" and UIK.text_w(try, sc) > ew - 0.6 then
          lines[#lines + 1] = cur
          cur = word
        else
          cur = try
        end
      end
      lines[#lines + 1] = cur
      return lines
    end
    local col = {}
    local function add(l, sc, colour, pad)
      col[#col + 1] = {n = G.UIT.R, config = {align = "cm", padding = pad}, nodes = {{n = G.UIT.C, config = {align = "cm", maxw = ew - 0.4}, nodes = {text(l, sc, colour)}}}}
    end
    local ts = touch() and 0.6 or 0.42
    for _, l in ipairs(wrap(L("No finished runs yet."), ts)) do add(l, ts, G.C.UI.TEXT_LIGHT, 0.06) end
    local hs = touch() and (d.port and 0.5 or 0.42) or 0.32
    for _, l in ipairs(wrap(L("Win or lose a run and it shows up here."), hs)) do add(l, hs, UIK.C.muted, 0.04) end
    nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", minh = 2.6, padding = 0.2}, nodes = {
      {n = G.UIT.C, config = {align = "cm"}, nodes = col},
    }}
    return {n = G.UIT.R, config = {align = "tm", minw = ew, padding = 0}, nodes = nodes}
  end
  local rows = {d.port and {n = G.UIT.R, config = {minh = 0.05}, nodes = {}} or header_row()}
  local first = (H.page - 1) * d.per
  for i = first + 1, math.min(#list, first + d.per) do
    rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = d.port and 0.07 or 0.03}, nodes = {d.port and port_row(i, list[i]) or list_row(i, list[i])}}
  end
  nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "tm", minw = UIK.W, minh = body_h() - pager_h - 0.1, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = "tm", padding = 0}, nodes = rows},
  }}
  if pages > 1 then
    nodes[#nodes + 1] = UIK.pager{prev = "bo_hist_prev", next = "bo_hist_next", text = tostring(H.page) .. " / " .. tostring(pages),
      prev_disabled = H.page <= 1, next_disabled = H.page >= pages, w = UIK.W}
  end
  return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, padding = 0}, nodes = nodes}
end

local function stat_box(label, value, w, colour, value_colour)
  local d = dims()
  return {n = G.UIT.C, config = {align = "cm", minw = w, maxw = w, minh = d.box_h, r = 0.1, colour = colour or {0, 0, 0, 0.18}, padding = 0.04}, nodes = {
    {n = G.UIT.R, config = {align = "cm", minw = w - 0.1}, nodes = {fit_text(value, w, d.val, value_colour or G.C.WHITE)}},
    {n = G.UIT.R, config = {align = "cm", minw = w - 0.1}, nodes = {fit_text(label, w, d.lab, UIK.C.muted)}},
  }}
end

local function box_row(boxes, w)
  local gap = 0.16
  local bw = (w - gap * (#boxes - 1)) / #boxes
  local nodes = {}
  for i, b in ipairs(boxes) do
    if i > 1 then nodes[#nodes + 1] = {n = G.UIT.C, config = {minw = gap}, nodes = {}} end
    nodes[#nodes + 1] = stat_box(b[1], b[2], bw, b[3], b[4])
  end
  return {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0}, nodes = nodes}
end

local function joker_area(e, w)
  local d = dims()
  local keys = {}
  for _, j in ipairs(e.jokers or {}) do
    if type(j) == "table" and G.P_CENTERS[j.k] then keys[#keys + 1] = j end
  end
  local cw, ch = G.CARD_W * d.card, G.CARD_H * d.card
  local n = math.max(1, #keys)
  local aw = math.min(w, n * cw * 1.08)
  local area = CardArea(0, 0, aw, ch, {card_limit = n, card_w = cw, type = "title_2", highlight_limit = 0})
  for _, j in ipairs(keys) do
    local card = Card(0, 0, cw, ch, nil, G.P_CENTERS[j.k], {bypass_discovery_center = true, bypass_discovery_ui = true, bypass_lock = true})
    if j.e and G.P_CENTERS["e_" .. j.e] then pcall(card.set_edition, card, {[j.e] = true}, true, true) end
    area:emplace(card)
  end
  return area, #keys
end

function H.find(id)
  for _, e in ipairs(H.load()) do
    if e.id == id then return e end
  end
end

local function stat_rows(groups, w)
  local out = {}
  for i, g in ipairs(groups) do
    if i > 1 then out[#out + 1] = {n = G.UIT.R, config = {minh = 0.16}, nodes = {}} end
    out[#out + 1] = box_row(g, w)
  end
  out[#out + 1] = {n = G.UIT.R, config = {minh = 0.2}, nodes = {}}
  return out
end

local function build_detail()
  local e = H.find(H.detail_id)
  if not e then return {n = G.UIT.R, config = {align = "cm", minh = body_h()}, nodes = {text(L("This run is no longer in the history."), 0.4)}} end
  local d = dims()
  local w = UIK.W - 0.6
  local best_hand = hand_name(e.hand)
  if e.hand_n then best_hand = best_hand .. " (" .. tostring(e.hand_n) .. ")" end
  local row1 = {
    {L("Result"), result_text(e), result_colour(e)},
    {L("Ante"), tostring(e.ante or 1)},
    {L("Round"), tostring(e.round or 0)},
    {L("Best hand"), score(e.best)},
    {L("Most played hand"), best_hand},
  }
  local mode_lab, mode_val = L("Mode"), mode_label(e)
  if e.mode == "challenge" and e.challenge then mode_lab, mode_val = L("Challenge"), challenge_name(e.challenge) end
  if e.mode == "mp" and e.mp_mode then
    local B = rawget(_G, "bom_browse")
    local ok, name = pcall(function() return B and B.mode_name and B.mode_name(e.mp_mode) end)
    if ok and type(name) == "string" and name ~= "" then mode_val = L(name) end
  end
  local fifth = e.mode == "mp" and {L("Opponent"), e.opp or "-"} or {L("Seed"), e.seed or "-", nil, G.C.GOLD}
  local row2 = {
    {mode_lab, mode_val},
    {L("Deck"), deck_name(e.deck)},
    {L("Stake"), stake_name(e.stake), nil, stake_colour(e.stake)},
    {L("Date"), os.date("%Y-%m-%d %H:%M", tonumber(e.t) or 0)},
    fifth,
  }
  local area, count = joker_area(e, w - 0.4)
  local jokers = {n = G.UIT.R, config = {align = "cm", minw = w, r = 0.12, colour = UIK.C.section, padding = 0.1}, nodes = {
    {n = G.UIT.R, config = {align = "cm", minw = w - 0.2}, nodes = {text(L("Final jokers"), touch() and 0.44 or 0.4, UIK.C.title)}},
    {n = G.UIT.R, config = {align = "cm", minw = w - 0.2, minh = G.CARD_H * d.card + 0.1}, nodes = {
      count > 0 and {n = G.UIT.O, config = {object = area}} or text(L("No jokers"), touch() and 0.4 or 0.36, UIK.C.muted),
    }},
  }}
  if count == 0 then area:remove() end
  local body = stat_rows(d.port and {{row1[1], row1[2], row1[3]}, {row1[4], row1[5]}, {row2[1], row2[2]}, {row2[3], row2[4]}, {row2[5]}} or {row1, row2}, w)
  body[#body + 1] = jokers
  return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = "tm", padding = 0}, nodes = body},
  }}
end

local function button_label(str, w, scale)
  local s, sc = fit(str, w - 0.3, scale)
  return s, sc
end

