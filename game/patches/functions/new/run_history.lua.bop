G.FUNCS.bo_hist_watch = function(e)
  local id = e and e.config and e.config.ref_table and e.config.ref_table.id
  local entry = id and H.find(id)
  local SR = rawget(_G, "BO_SPREPLAY")
  if entry and entry.sprp and entry.mode ~= "mp" and SR and SR.watch then
    SR.watch(entry.sprp, entry.id, H.from)
    return
