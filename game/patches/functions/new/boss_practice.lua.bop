G.FUNCS.open_boss_practice = function(e)
  local from = e and e.config and e.config.ref_table and e.config.ref_table.from or nil
  BP.open(from or false)
end
G.FUNCS.bo_bp_pick = function(e)
  local k = e and e.config and e.config.ref_table and e.config.ref_table.key
  if is_boss(k) then BP.sel.boss = k; UIK.refresh() end
end
G.FUNCS.bo_bp_prev = function() BP.sel.page = (BP.sel.page or 1) - 1; UIK.refresh() end
G.FUNCS.bo_bp_next = function() BP.sel.page = (BP.sel.page or 1) + 1; UIK.refresh() end
function BP.restart(p)
  if type(p) ~= "table" or not p.boss then return false end
  BP.start(p.boss, p.deck, p.ante, p.lo, p.kind)
  return true
end

G.FUNCS.bo_bp_play = function()
  local boss, deck = BP.choice()
  if not (boss and deck) then return end
  local ante = math.max(1, math.min(8, tonumber(BP.sel.ante) or 1))
  local lo = BP.LO and BP.LO.resolve(BP.sel.kind, ante) or nil
  BP.start(boss, deck, ante, lo, BP.sel.kind)
end
G.FUNCS.bo_bp_back = function()
  if BP.active() then return BP.result_overlay() end
  local from = BP.from
  if from and G.FUNCS[from] then return G.FUNCS[from]() end
