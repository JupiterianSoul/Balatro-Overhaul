local function hidden_inventory(fn)
  local BM = rawget(_G, "BoosterManager")
  local inv = BM and BM.get_inventory
  if inv then BM.get_inventory = function() return {} end end
  local ok, err = pcall(fn)
  if inv then BM.get_inventory = inv end
  if not ok then error(err, 0) end
end

function BP.start(boss, deck, ante, lo, kind)
  if not is_boss(boss) or not G.P_CENTERS[deck] then return end
  local l = last()
  l.boss, l.deck = boss, deck
  pcall(function() G:save_progress() end)
  BP.launch = {boss = boss, deck = deck, ante = math.max(1, math.min(8, tonumber(ante) or 1)), lo = lo, kind = kind}
  if G.FUNCS.exit_overlay_menu and G.OVERLAY_MENU then G.FUNCS.exit_overlay_menu() end
  if G.CUSTOM_RUN then G.CUSTOM_RUN.enabled = false end
  local back = G.P_CENTERS[deck]
  if G.GAME.viewed_back then G.GAME.viewed_back:change_to(back) else G.GAME.viewed_back = Back(back) end
  local seed = type(generate_starting_seed) == "function" and generate_starting_seed() or nil
  hidden_inventory(function() G.FUNCS.start_run(nil, {stake = 1, seed = seed, back = back}) end)
end

local function finish_menu()
  BP.launch = nil
end

