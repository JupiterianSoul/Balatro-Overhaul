BO_PRACTICE = BO_PRACTICE or {}
local BP = BO_PRACTICE

BP.sel = BP.sel or {page = 1}
pcall(require, "functions/new/practice_loadout")

local function L(s) return mod_loc and mod_loc(s) or s end
local function touch() return UIK and UIK.touch and UIK.touch() or false end

local function profile()
  return G.PROFILES and G.SETTINGS and G.PROFILES[G.SETTINGS.profile] or nil
end

function BP.active()
  return G and G.GAME and G.GAME.bo_practice ~= nil
end

local function is_boss(k)
  local v = type(k) == "string" and G.P_BLINDS and G.P_BLINDS[k] or nil
  return type(v) == "table" and type(v.boss) == "table" and not v.no_collection and not k:find("^bl_mp") and not v.rr_plain
end

function BP.bosses()
  local out = {}
  for k, v in pairs(G.P_BLINDS or {}) do
    if is_boss(k) and v.discovered then out[#out + 1] = k end
  end
  table.sort(out, function(a, b)
    local A, B = G.P_BLINDS[a], G.P_BLINDS[b]
    local sa, sb = A.boss.showdown and 1 or 0, B.boss.showdown and 1 or 0
    if sa ~= sb then return sa < sb end
    local oa, ob = tonumber(A.order) or 0, tonumber(B.order) or 0
    if oa ~= ob then return oa < ob end
    return a < b
  end)
  return out
end

function BP.decks()
  local out = {}
  for _, v in ipairs(G.P_CENTER_POOLS and G.P_CENTER_POOLS.Back or {}) do
    if type(v) == "table" and v.key and v.unlocked ~= false and not v.omit and not v.no_collection and G.P_CENTERS[v.key] == v then out[#out + 1] = v.key end
  end
  return out
end

local function last()
  local p = profile()
  if not p then return {} end
  if type(p.bo_practice_last) ~= "table" then p.bo_practice_last = {} end
  return p.bo_practice_last
end

function BP.choice()
  local bosses, decks = BP.bosses(), BP.decks()
  local l = last()
  local boss = BP.sel.boss or l.boss
  local found = false
  for _, k in ipairs(bosses) do if k == boss then found = true end end
  if not found then boss = bosses[1] end
  local deck = BP.sel.deck or l.deck
  found = false
  for _, k in ipairs(decks) do if k == deck then found = true end end
  if not found then deck = decks[1] end
  BP.sel.boss, BP.sel.deck = boss, deck
  return boss, deck, bosses, decks
end

local function blind_name(k)
  local ok, s = pcall(localize, {type = "name_text", key = k, set = "Blind"})
  if ok and type(s) == "string" and s ~= "" and s ~= "ERROR" then return s end
  local v = G.P_BLINDS[k]
  return v and (v.loc_name or v.name) or k
end

local function blind_lines(k)
  local v = G.P_BLINDS[k]
  local ok, lines = pcall(localize, {type = "raw_descriptions", key = k, set = "Blind", vars = v and v.vars or {}})
  if not ok or type(lines) ~= "table" then return {} end
  local out = {}
  for i, s in ipairs(lines) do
    if type(s) == "string" then out[#out + 1] = (i == 1 and v and v.name == "The Wheel" and "1" or "") .. s end
  end
  return out
end

local function deck_name(k)
  local ok, s = pcall(localize, {type = "name_text", key = k, set = "Back"})
  if ok and type(s) == "string" and s ~= "" and s ~= "ERROR" then return s end
  local c = G.P_CENTERS[k]
  return c and c.name or k
end

function BP.target(boss, deck, ante)
  local v = G.P_BLINDS[boss]
  local c = G.P_CENTERS[deck]
  local base = type(get_blind_amount) == "function" and get_blind_amount(math.max(1, math.min(8, tonumber(ante) or 1))) or 300
  local scaling = c and c.config and tonumber(c.config.ante_scaling) or 1
  return math.floor(base * (tonumber(v and v.mult) or 2) * scaling)
end

local function fmt(n)
  if type(number_format) == "function" then
    local ok, s = pcall(number_format, n)
    if ok and s then return tostring(s) end
  end
  return tostring(n)
end

local function text(str, scale, colour)
  return {n = G.UIT.T, config = {text = tostring(str or ""), scale = scale, colour = colour or G.C.WHITE, shadow = true}}
end

local function fit_text(str, w, scale, colour)
  local K = rawget(_G, "bom_kit")
  local s, sc = tostring(str or ""), scale
  if K and K.fit then s, sc = K.fit(s, w, scale, scale * 0.6) end
  return text(s, sc, colour)
end

local function chip(k, size)
  local v = G.P_BLINDS[k]
  local atlas = (v.atlas and G.ANIMATION_ATLAS[v.atlas]) or G.ANIMATION_ATLAS.blind_chips
  local s = AnimatedSprite(0, 0, size, size, atlas, v.pos or {x = 0, y = 0})
  s:define_draw_steps({{shader = "dissolve", shadow_height = 0.05}, {shader = "dissolve"}})
  return s
end

local function dims()
  if touch() then return {chip = 1.0, per = 5, rows = 3, big = 1.3, line = 0.34, name = 0.5} end
  return {chip = 0.9, per = 6, rows = 3, big = 1.2, line = 0.32, name = 0.46} end

local function build_tab()
  local d = dims()
  local boss, deck, bosses, decks = BP.choice()
  local h = UIK.H - UIK.TOP
  if not boss or not deck then
    return {n = G.UIT.R, config = {align = "cm", minw = UIK.W, minh = h}, nodes = {
      {n = G.UIT.C, config = {align = "cm"}, nodes = {
        {n = G.UIT.R, config = {align = "cm", padding = 0.05}, nodes = {text(L("No boss blinds seen yet."), 0.42)}},
        {n = G.UIT.R, config = {align = "cm", padding = 0.05}, nodes = {text(L("Meet a boss in a run to practice against it here."), 0.34, G.C.UI.TEXT_LIGHT)}},
      }},
    }}
  end
  local per_page = d.per * d.rows
  local pages = math.max(1, math.ceil(#bosses / per_page))
  if not BP.sel.page_set then
    for i, k in ipairs(bosses) do if k == boss then BP.sel.page = math.ceil(i / per_page) end end
    BP.sel.page_set = true
  end
  BP.sel.page = math.max(1, math.min(BP.sel.page or 1, pages))
  local cw = UIK.col_w(2) - 0.3
  local cell = d.chip + 0.22
  local grid = {}
  local first = (BP.sel.page - 1) * per_page
  for r = 1, d.rows do
    local cells = {}
    for c = 1, d.per do
      local k = bosses[first + (r - 1) * d.per + c]
      if k then
        local on = k == boss
        cells[#cells + 1] = {n = G.UIT.C, config = {align = "cm", minw = cell, minh = cell, padding = 0.06, r = 0.12, hover = true, shadow = true,
          colour = on and G.C.GOLD or {0, 0, 0, 0.25}, button = "bo_bp_pick", ref_table = {key = k}, id = "bo_bp_boss_" .. k}, nodes = {
          {n = G.UIT.O, config = {object = chip(k, d.chip)}},
        }}
      else
        cells[#cells + 1] = {n = G.UIT.C, config = {minw = cell, minh = cell}, nodes = {}}
      end
      if c < d.per then cells[#cells + 1] = {n = G.UIT.C, config = {minw = 0.08}, nodes = {}} end
    end
    grid[#grid + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.04}, nodes = cells}
  end
  local left_rows = {{n = G.UIT.R, config = {align = "cm", minw = cw - 0.4}, nodes = {{n = G.UIT.C, config = {align = "cm"}, nodes = grid}}}}
  if pages > 1 then
    left_rows[#left_rows + 1] = UIK.pager{prev = "bo_bp_prev", next = "bo_bp_next", text = tostring(BP.sel.page) .. " / " .. tostring(pages),
      prev_disabled = BP.sel.page <= 1, next_disabled = BP.sel.page >= pages}
  end
  local left = UIK.section(L("Bosses you have seen"), left_rows, {w = cw, h = h - 0.2})
  local inner = cw - 0.6
  local v = G.P_BLINDS[boss]
  local info = {
    {n = G.UIT.R, config = {align = "cm", minw = inner}, nodes = {
      {n = G.UIT.C, config = {align = "cm", padding = 0.04}, nodes = {{n = G.UIT.O, config = {object = chip(boss, d.big)}}}},
      {n = G.UIT.C, config = {minw = 0.15}, nodes = {}},
      {n = G.UIT.C, config = {align = "cl"}, nodes = {
        {n = G.UIT.R, config = {align = "cl"}, nodes = {fit_text(blind_name(boss), inner - d.big - 0.4, d.name, v.boss_colour and mix_colours and mix_colours(v.boss_colour, G.C.WHITE, 0.6) or G.C.WHITE)}},
        {n = G.UIT.R, config = {align = "cl"}, nodes = {text(L("Score at least") .. " " .. fmt(BP.target(boss, deck, BP.sel.ante)), d.line, G.C.UI.TEXT_LIGHT)}},
      }},
    }},
  }
  local desc = {}
  for _, s in ipairs(blind_lines(boss)) do
    desc[#desc + 1] = {n = G.UIT.R, config = {align = "cm"}, nodes = {fit_text(s, inner - 0.2, d.line, G.C.WHITE)}}
  end
  info[#info + 1] = {n = G.UIT.R, config = {align = "cm", minw = inner, minh = touch() and 0.6 or 0.9, r = 0.1, padding = touch() and 0.05 or 0.08, colour = {0, 0, 0, 0.2}}, nodes = {
    {n = G.UIT.C, config = {align = "cm"}, nodes = desc},
  }}
  local opts, cur = {}, 1
  for i, k in ipairs(decks) do
    opts[i] = deck_name(k)
    if k == deck then cur = i end
  end
  local half = (inner - 0.2) / 2
  BP.sel.ante = math.max(1, math.min(8, tonumber(BP.sel.ante) or 1))
  local pair = function(a, b) return {n = G.UIT.R, config = {align = "cm", minw = inner}, nodes = {
    {n = G.UIT.C, config = {align = "cm", minw = half}, nodes = {a}}, {n = G.UIT.C, config = {minw = 0.2}, nodes = {}},
    {n = G.UIT.C, config = {align = "cm", minw = half}, nodes = {b}}}} end
  info[#info + 1] = pair(
    UIK.stepper{label = localize("k_ante"), ref_table = BP.sel, ref_value = "ante", min = 1, max = 8, w = half, cw = 1.6, id = "bo_bp_ante", callback = function() UIK.refresh() end},
    UIK.cycle{label = L("Deck"), options = opts, current = cur, w = half, cw = 2.2, no_pips = true, id = "bo_bp_deck", callback = function(idx)
      BP.sel.deck = decks[idx]
      UIK.refresh()
    end})
  local LO = BP.LO
  if LO then
    local kinds, kc = {}, 1
    for i, k in ipairs(LO.KINDS) do
      kinds[i] = L(k.label)
      if k.key == BP.sel.kind then kc = i end
    end
    BP.sel.kind = LO.KINDS[kc].key
    info[#info + 1] = UIK.cycle{label = L("Loadout"), options = kinds, current = kc, w = inner, cw = 3.2, no_pips = true, id = "bo_bp_kind", callback = function(idx)
      BP.sel.kind = LO.KINDS[idx].key
      UIK.refresh()
    end}
  end
  if not touch() then info[#info + 1] = UIK.note({L("No rewards, nothing saved to your stats.")}, {w = inner}) end
  local right = UIK.section(L("Practice"), info, {w = cw, h = h - 0.2})
  return {n = G.UIT.R, config = {align = "cm", minw = UIK.W, minh = h, padding = 0}, nodes = {UIK.columns({{left}, {right}}, {h = h})}}
end

function BP.open(from)
  if from ~= nil then BP.from = from end
  BP.sel.page_set = nil
