if Game and Game.init_game_object and not BP._init_wrapped then
  BP._init_wrapped = true
  local orig = Game.init_game_object
  Game.init_game_object = function(self, ...)
    local g = orig(self, ...)
    if BP.launch and type(g) == "table" then
      g.bo_practice = {boss = BP.launch.boss, deck = BP.launch.deck, ante = BP.launch.ante or 1, lo = BP.launch.lo, kind = BP.launch.kind}
      g.modded_run = true
      BP.launch = nil
    end
    return g
  end
end

if Game and Game.start_run and not BP._run_wrapped then
  BP._run_wrapped = true
  local orig = Game.start_run
  Game.start_run = function(self, args)
    local r = {orig(self, args)}
    local P = G.GAME and G.GAME.bo_practice
    if P and not P.set then
      P.set = true
      local rr = G.GAME.round_resets
      local ante = math.max(1, math.min(8, tonumber(P.ante) or 1))
      if ante > 1 then
        rr.ante, rr.blind_ante = ante, ante
      end
      if P.lo and BP.LO and BP.LO.apply then
        local ok, err = pcall(BP.LO.apply, P.lo)
        if not ok then print("[BossPractice] loadout: " .. tostring(err)) end
      end
      rr.blind_choices.Boss = P.boss
      rr.blind_states.Small = "Skipped"
      rr.blind_states.Big = "Skipped"
      rr.blind_states.Boss = "Select"
      G.GAME.blind_on_deck = "Boss"
      G.E_MANAGER:add_event(Event({blocking = false, blockable = false, func = function()
        if not (G.GAME and G.GAME.bo_practice == P) then return true end
        if G.STATE ~= G.STATES.BLIND_SELECT or not (G.blind_select_opts and G.blind_select_opts.boss) then return false end
        local b = G.blind_select_opts.boss:get_UIE_by_ID("select_blind_button")
        if not b then return false end
        G.FUNCS.select_blind(b)
        return true
      end}))
    end
    return unpack(r)
  end
end

if type(end_round) == "function" and not BP._end_wrapped then
  BP._end_wrapped = true
  local orig = end_round
  end_round = function(...)
    local P = G.GAME and G.GAME.bo_practice
    if not P then return orig(...) end
    if P.done then return end
    P.done = true
    local chips, need = G.GAME.chips or 0, G.GAME.blind and G.GAME.blind.chips or 0
    P.won = chips >= need
    P.score, P.target = chips, need
    P.hands = G.GAME.current_round and G.GAME.current_round.hands_played or 0
    G.E_MANAGER:add_event(Event({trigger = "after", delay = 0.8, func = function()
      if G.GAME and G.GAME.bo_practice == P then BP.result_overlay() end
      return true
    end}))
  end
end

if G.FUNCS.tutorial_controller and not BP._tut_wrapped then
  BP._tut_wrapped = true
  local orig = G.FUNCS.tutorial_controller
  G.FUNCS.tutorial_controller = function(...)
    if BP.active() then return end
    return orig(...)
  end
end

for _, name in ipairs({"save_run", "set_hand_usage", "set_consumeable_usage", "set_voucher_usage", "check_and_set_high_score", "create_modded_indicator", "apply_mod_settings_to_run"}) do
  local orig = rawget(_G, name)
  if type(orig) == "function" and not BP["_g_" .. name] then
    BP["_g_" .. name] = true
    _G[name] = function(...)
      if BP.active() then return end
      return orig(...)
    end
  end
end

if G.FUNCS.go_to_menu and not BP._menu_wrapped then
  BP._menu_wrapped = true
  local orig = G.FUNCS.go_to_menu
  G.FUNCS.go_to_menu = function(...)
    local was = BP.active()
    local r = {orig(...)}
    if was then finish_menu() end
    return unpack(r)
  end
end

local function find_parent(node, button)
  if type(node) ~= "table" or type(node.nodes) ~= "table" then return nil end
  for i, child in ipairs(node.nodes) do
    if type(child) == "table" and child.nodes then
      for _, gc in ipairs(child.nodes) do
        if type(gc) == "table" and gc.config and gc.config.button == button then return node, i end
        if type(gc) == "table" and gc.nodes then
          for _, ggc in ipairs(gc.nodes) do
            if type(ggc) == "table" and ggc.config and ggc.config.button == button then return node, i end
          end
        end
      end
    end
    local p, idx = find_parent(child, button)
    if p then return p, idx end
  end
end

function BP.fit_hub(parent)
  local buttons = {}
  local function walk(n)
    if type(n) ~= "table" then return end
    local m = n.config and tonumber(n.config.minh)
    if n.config and n.config.button and m and m >= 0.6 and m <= 1 then buttons[#buttons + 1] = n end
    for _, c in ipairs(n.nodes or {}) do walk(c) end
  end
  walk(parent)
  if #buttons < 6 then return end
  local h = math.max(0.7, 4.8 / #buttons)
  for _, b in ipairs(buttons) do b.config.minh = h end
  for _, r in ipairs(parent.nodes) do
    if r.config and r.config.padding == 0.08 then r.config.padding = 0.06 end
  end
end

if type(create_UIBox_tavern_hub) == "function" and not BP._hub_wrapped then
  BP._hub_wrapped = true
  local orig = create_UIBox_tavern_hub
  function create_UIBox_tavern_hub(...)
    local def = orig(...)
    pcall(function()
      local parent, idx = find_parent(def, "open_run_history")
      if not parent then parent, idx = find_parent(def, "open_seed_library") end
      if parent then
        table.insert(parent.nodes, idx + 1, {n = G.UIT.R, config = {align = "cm", padding = 0.08}, nodes = {
          UIBox_button({label = {L("BOSS PRACTICE")}, button = "open_boss_practice", ref_table = {from = "open_tavern_hub"}, minw = 5, minh = 1, colour = G.C.RED}),
        }})
        BP.fit_hub(parent)
      end
    end)
    return def
  end
end

