if DY and DY.record then
  local _db_record = DY.record
  DY.record = function(won)
    local g = G.GAME
    if not (g and g.daily and type(g.daily_rules) == "table") then return end
    if g.daily_scored == false then
      if g.daily_recorded then return end
      g.daily_recorded = true
      DB.on_practice()
      return
    end
    local was = g.daily_recorded
    _db_record(won)
    if not was and g.daily_recorded then pcall(DB.on_scored, won) end
  end
end

local function find_by_id(n, id, parent)
  if type(n) ~= "table" then return nil end
  if n.config and n.config.id == id then return n, parent end
  for _, c in ipairs(n.nodes or {}) do
    local f, p = find_by_id(c, id, n)
    if f then return f, p end
  end
end

local function find_text(n, list)
  if type(n) ~= "table" then return nil end
  if n.n == G.UIT.T and n.config then
    for _, s in ipairs(list) do if n.config.text == s then return n end end
  end
  for _, c in ipairs(n.nodes or {}) do
    local f = find_text(c, list)
    if f then return f end
  end
end

function DB.patch_tab(def)
  local play, parent = find_by_id(def, "daily_play")
  if not (play and parent) then return end
  local used = DB.used(DY.today())
  play.n = G.UIT.C
  play.config.minw = 5.6
  play.config.colour = G.C.BLUE
  local label = play.nodes and play.nodes[1]
  if label and label.config then label.config.text = used and L("PRACTICE") or localize("b_play_cap") end
  parent.nodes = {
    play,
    {n = G.UIT.C, config = {minw = 0.2}, nodes = {}},
    {n = G.UIT.C, config = {id = "daily_board", align = "cm", padding = 0.1, minh = 0.75, minw = 3.2, r = 0.1, hover = true, colour = G.C.MONEY,
      button = "bo_daily_board_open", ref_table = {from = "daily_tab"}, shadow = true}, nodes = {
      {n = G.UIT.T, config = {text = L("BOARD"), scale = 0.5, colour = G.C.UI.TEXT_LIGHT}},
    }},
  }
  if used then
    local note = find_text(def, {L("Same rules for everyone today"), L("Today's pools include your mods' content")})
    if note then
      note.config.text = L("Your scored try is used. More tries today are practice.")
      note.config.colour = G.C.ORANGE
    end
  end
  if DB.connected() then pcall(DB.flush) end
end

if G.UIDEF and G.UIDEF.daily_challenge_tab then
  local _db_tab = G.UIDEF.daily_challenge_tab
  G.UIDEF.daily_challenge_tab = function(...)
    local def = _db_tab(...)
    pcall(DB.patch_tab, def)
    return def
  end
end

if G.UIDEF and G.UIDEF.daily_run_info then
  local _db_run_info = G.UIDEF.daily_run_info
  G.UIDEF.daily_run_info = function(...)
    local def = _db_run_info(...)
    pcall(function()
      local g = G.GAME
      if not (g and g.daily and def.nodes) then return end
      local practice = g.daily_scored == false
      table.insert(def.nodes, 2, {n = G.UIT.R, config = {align = "cm", padding = 0.04}, nodes = {
        {n = G.UIT.C, config = {align = "cm", padding = 0.08, r = 0.1, colour = practice and G.C.ORANGE or G.C.GREEN}, nodes = {
          {n = G.UIT.T, config = {text = practice and L("PRACTICE: this try is not scored") or L("SCORED TRY: this result goes on the daily board"), scale = 0.34, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
        }},
      }})
    end)
    return def
  end
end

if bom_events and bom_events.register then
  bom_events.register("daily_submitted", DB.on_submitted)
  bom_events.register("daily_board", DB.on_board)
end

