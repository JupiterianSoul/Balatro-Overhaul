G.FUNCS.bo_daily_board_next = function() DB.state.page = (DB.state.page or 1) + 1; UIK.refresh() end

local _db_start_run = Game.start_run
Game.start_run = function(self, args, ...)
  local R = type(args) == "table" and args.bo_daily or nil
  local fresh = type(R) == "table" and not args.savetext
  local scored = fresh and DB.can_score(R) or false
  local res = _db_start_run(self, args, ...)
  if G.GAME and G.GAME.daily and not G.GAME.multiplayer then
    G.GAME.banned_keys = G.GAME.banned_keys or {}
