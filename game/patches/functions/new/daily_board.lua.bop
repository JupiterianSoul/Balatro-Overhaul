local function find_daily_tab(n)
  if type(n) ~= "table" then return nil end
  if n.config and n.config.button == "change_tab" and n.config.ref_table and n.config.ref_table.label == L("Daily") then return n end
  for _, c in ipairs(n.children or {}) do
    local f = find_daily_tab(c)
    if f then return f end
  end
end

