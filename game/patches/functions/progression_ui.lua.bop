PUI.badge = PUI.badge or {text = "0", n = 0, next_t = 0}

function PUI.ready_total()
  local ok, n = pcall(function()
    local QM = QuestManager
    if QM and QM.refresh then QM.refresh() end
    return (QM and QM.ready_count() or 0) + #progression_unclaimed_levels()
  end)
  return ok and tonumber(n) or 0
end

local function badge_def(h)
  local b = PUI.badge
  return {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR}, nodes = {
    {n = G.UIT.C, config = {align = "cm", minw = h * 1.35, minh = h, r = h * 0.24, colour = G.C.RED, shadow = true}, nodes = {
      {n = G.UIT.T, config = {ref_table = b, ref_value = "text", scale = h * 0.82, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
    }},
  }}
end

local function badge_drop()
  if G.progression_badge then
    if not G.progression_badge.REMOVED then G.progression_badge:remove() end
    G.progression_badge = nil
  end
  PUI.badge.major = nil
end

function PUI.badge_tick(force)
  local b = PUI.badge
  if G.progression_badge and (G.STAGE ~= G.STAGES.MAIN_MENU or not G.MAIN_MENU_UI or G.MAIN_MENU_UI.REMOVED or (b.major and b.major.REMOVED)) then badge_drop() end
  local now = love.timer.getTime()
  if not force and now < b.next_t then return end
  b.next_t = now + 0.5
  local menu = G.STAGE == G.STAGES.MAIN_MENU and G.MAIN_MENU_UI and not G.MAIN_MENU_UI.REMOVED
  local btn = menu and G.MAIN_MENU_UI:get_UIE_by_ID("progression_button") or nil
  local n = btn and PUI.ready_total() or 0
  if n <= 0 then badge_drop() return end
  b.n = n
  b.text = n > 9 and "9+" or tostring(n)
  local box = G.progression_badge
  if box and not box.REMOVED and b.major == btn then return end
  if G.OVERLAY_MENU then return end
  badge_drop()
  local big = btn.T.h >= 1
  local h = big and btn.T.h * 0.5 or 0.34
  G.progression_badge = UIBox{definition = badge_def(h), config = {align = "cri", offset = {x = big and -0.12 or 0.16, y = 0}, major = btn}}
  G.progression_badge.states.collide.can = false
  b.major = btn
end

if Game and Game.update and not PUI.badge_wrapped then
  PUI.badge_wrapped = true
