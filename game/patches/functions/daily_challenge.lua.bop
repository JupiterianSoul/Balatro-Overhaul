local function today_status(e)
  if not e then return mod_loc("Not played"), G.C.UI.TEXT_LIGHT end
  if e.won then return mod_loc("Won"), G.C.GREEN end
  return mod_loc("Best: Ante") .. " " .. tostring(e.best_ante or 0), G.C.ORANGE
end

