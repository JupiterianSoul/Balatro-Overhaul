function G.UIDEF.daily_run_info()
  local R = G.GAME and G.GAME.daily_rules
  if type(R) ~= "table" then
    return {n=G.UIT.ROOT, config={align = "cm", colour = G.C.CLEAR}, nodes={}}
  end
  return {n=G.UIT.ROOT, config={align = "cm", colour = G.C.CLEAR, padding = 0.1}, nodes={
r 15 71 %20%20%20%20 -
l 2
      {n=G.UIT.T, config={text = mod_loc("DAILY RUN") .. "  " .. tostring(R.date), scale = 0.5, colour = G.C.GOLD, shadow = true}}
    }},
r 15 71 %20%20%20%20 -
l 1
      rule_panel(mod_loc("Twists"), G.C.RED, rule_rows(R.twists, DY.twist, G.C.RED), 3.6),
r 15 1934 %20%20%20%20%20%20 -
l 35
      rule_panel(mod_loc("Boon"), G.C.GREEN, rule_rows(R.boons, DY.boon, G.C.GREEN), 3.2),
    }},
  }}
end

if G.UIDEF and G.UIDEF.run_info then
  local _daily_run_info = G.UIDEF.run_info
  G.UIDEF.run_info = function(...)
    if not (G.GAME and G.GAME.daily and type(G.GAME.daily_rules) == "table") then
      return _daily_run_info(...)
    end
    local orig_create_tabs = create_tabs
    create_tabs = function(args)
      create_tabs = orig_create_tabs
      if args and type(args.tabs) == "table" then
        args.tabs[#args.tabs + 1] = {label = mod_loc("Daily"), tab_definition_function = G.UIDEF.daily_run_info}
      end
      return orig_create_tabs(args)
    end
    local ok, res = pcall(_daily_run_info, ...)
    create_tabs = orig_create_tabs
    if not ok then error(res, 0) end
    return res
  end
end

G.FUNCS = G.FUNCS or {}

G.FUNCS.daily_start_challenge = function(e)
  play_sound('button')
  DY.start(DY.today())
end

G.UIDEF = G.UIDEF or {}
G.UIDEF.daily_challenge_tab = create_daily_ui
end
