local function by_id(list, id)
  for _, v in ipairs(list) do if v.id == id then return v end end
end
DY.twist = function(id) return by_id(DY.TWISTS, id) end
DY.boon = function(id) return by_id(DY.BOONS, id) end

local function is_modded(c)
  return type(c) == "table" and (c.mod ~= nil or c.original_mod ~= nil)
end

local function sort_centers(t)
  table.sort(t, function(a, b)
    local ma, mb = is_modded(a) and 1 or 0, is_modded(b) and 1 or 0
    if ma ~= mb then return ma < mb end
    local oa, ob = tonumber(a.order) or 0, tonumber(b.order) or 0
    if oa ~= ob then return oa < ob end
    return tostring(a.key) < tostring(b.key)
  end)
  return t
end

function DY.deck_pool()
  local t, seen = {}, {}
  for _, k in ipairs(VANILLA_DECKS) do
    local c = G.P_CENTERS and G.P_CENTERS[k]
    if c then t[#t + 1] = c seen[k] = true end
  end
  local mods = {}
  for _, c in ipairs((G.P_CENTER_POOLS and G.P_CENTER_POOLS.Back) or {}) do
    if is_modded(c) and c.key and not seen[c.key] and not c.omit and c.key ~= "b_challenge" then
      mods[#mods + 1] = c
    end
  end
  sort_centers(mods)
  for _, c in ipairs(mods) do t[#t + 1] = c end
  return t
end

function DY.joker_pool(rarity)
  local t = {}
  for _, c in ipairs((G.P_CENTER_POOLS and G.P_CENTER_POOLS.Joker) or {}) do
    local key = c.key or ""
    if c.rarity == rarity and not c.in_pool and not c.no_collection and not c.omit
      and not key:find("^j_mp_") then
      t[#t + 1] = c
    end
  end
  return sort_centers(t)
end

function DY.voucher_pool()
  local t = {}
  for _, c in ipairs((G.P_CENTER_POOLS and G.P_CENTER_POOLS.Voucher) or {}) do
    local req = c.requires
    if (not req or (type(req) == "table" and #req == 0)) and not BANNED_VOUCHERS[c.key] and not c.in_pool and not c.omit then
      t[#t + 1] = c
    end
  end
  return sort_centers(t)
end

function DY.modded_content()
  local n = 0
  for _, set in ipairs({"Back", "Joker", "Voucher"}) do
    for _, c in ipairs((G.P_CENTER_POOLS and G.P_CENTER_POOLS[set]) or {}) do
      if is_modded(c) then n = n + 1 end
    end
  end
  return n
end

local function pick_rules(list, rnd, n, blocked_groups, sp, rules_out)
  local avail = {}
  for _, r in ipairs(list) do avail[#avail + 1] = r end
  for i = #avail, 2, -1 do
    local j = rnd(1, i)
    avail[i], avail[j] = avail[j], avail[i]
  end
  for _, r in ipairs(avail) do
    if #rules_out >= n then break end
    if not blocked_groups[r.group] and (not r.ok or r.ok(sp)) then
      rules_out[#rules_out + 1] = r.id
      blocked_groups[r.group] = true
    end
  end
  return rules_out
end

local SEED_CHARS = "ABCDEFGHIJKLMNPQRSTUVWXYZ123456789"

function DY.build(date, force)
  date = date or DY.today()
  force = force or {}
  local seed_num = hash_string("bo_daily_" .. date)
  local rnd = make_rng(seed_num)
  local decks = DY.deck_pool()
  local deck = force.deck or (decks[rnd(1, math.max(1, #decks))] or {key = "b_red"}).key
  local stake = force.stake or (rnd() < 0.6 and 1 or 2)
  local sp = base_params(deck)
  local groups = {}
  if stake >= 2 then groups.reward = true end
  local twists = {}
  if force.twist then
    twists[1] = force.twist
    local tw = DY.twist(force.twist)
    if tw then groups[tw.group] = true end
  end
  pick_rules(DY.TWISTS, rnd, force.twist_count or 2, groups, sp, twists)
  local boons = {}
  pick_rules(DY.BOONS, rnd, 1, groups, sp, boons)
  local jokers = {}
  local commons = DY.joker_pool(1)
  if #commons > 0 then jokers[#jokers + 1] = commons[rnd(1, #commons)].key end
  local vouchers = {}
  local rv = rnd()
  for _, b in ipairs(boons) do
    if b == "second_joker" then
      local unc = DY.joker_pool(2)
      if #unc > 0 then jokers[#jokers + 1] = unc[1 + math.floor(rv * #unc)].key end
    elseif b == "voucher" then
      local vp = DY.voucher_pool()
      if #vp > 0 then vouchers[#vouchers + 1] = vp[1 + math.floor(rv * #vp)].key end
    end
  end
  local seed_chars = {}
  for i = 1, 8 do
    local k = rnd(1, #SEED_CHARS)
    seed_chars[i] = SEED_CHARS:sub(k, k)
  end
  return {
    date = date,
    seed = table.concat(seed_chars),
    deck = deck,
    stake = stake,
    twists = twists,
    boons = boons,
    jokers = jokers,
    vouchers = vouchers,
  }
end

function DY.apply_rules(R, g)
  g = g or G.GAME
  g.modifiers = g.modifiers or {}
  for _, id in ipairs(R.twists or {}) do
    local r = DY.twist(id)
    if r and r.apply then pcall(r.apply, g) end
  end
  for _, id in ipairs(R.boons or {}) do
    local r = DY.boon(id)
    if r and r.apply then pcall(r.apply, g) end
  end
end

local function profile_data()
  local p = G.PROFILES and G.SETTINGS and G.PROFILES[G.SETTINGS.profile]
  if not p then return nil end
  if type(p.bo_daily) ~= "table" then p.bo_daily = {} end
  if type(p.bo_daily.history) ~= "table" then p.bo_daily.history = {} end
  p.bo_daily.best_streak = tonumber(p.bo_daily.best_streak) or 0
  return p.bo_daily
end
DY.profile_data = profile_data

function DY.streak(today)
  local pd = profile_data()
  if not pd then return 0 end
  today = today or DY.today()
  local d = today
  local h = pd.history
  if not (h[d] and h[d].won) then d = shift_date(today, -1) end
  local n = 0
  while h[d] and h[d].won and n < 4000 do
    n = n + 1
    d = shift_date(d, -1)
  end
  return n
end

function DY.record(won)
  if not (G.GAME and G.GAME.daily and type(G.GAME.daily_rules) == "table") then return end
  if G.GAME.daily_recorded then return end
  G.GAME.daily_recorded = true
  local pd = profile_data()
  if not pd then return end
  local date = G.GAME.daily_rules.date or DY.today()
  local e = pd.history[date] or {tries = 0, best_ante = 0}
  e.tries = (tonumber(e.tries) or 0) + 1
  local ante = (G.GAME.round_resets and tonumber(G.GAME.round_resets.ante)) or 0
  if ante > (tonumber(e.best_ante) or 0) then e.best_ante = ante end
  if won then e.won = true end
  pd.history[date] = e
  local s = DY.streak(date)
  if s > pd.best_streak then pd.best_streak = s end
  pcall(function() G:save_progress() end)
end

function DY.start(date, force)
  local R = DY.build(date, force)
  if G.CUSTOM_RUN then G.CUSTOM_RUN.enabled = false end
  G.FUNCS.start_run(nil, {stake = R.stake, seed = R.seed, back = G.P_CENTERS[R.deck] or G.P_CENTERS.b_red, bo_daily = R})
end

