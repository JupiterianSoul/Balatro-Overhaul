local function card_strip(keys, size, limit)
  local area = CardArea(0, 0, math.max(1, limit) * G.CARD_W * size * 1.05, G.CARD_H * size,
    {card_limit = math.max(1, limit), card_w = G.CARD_W * size, type = 'title_2', highlight_limit = 0})
  for _, k in ipairs(keys or {}) do
    if G.P_CENTERS[k] then
      local card = Card(0, 0, G.CARD_W * size, G.CARD_H * size, nil, G.P_CENTERS[k],
        {bypass_discovery_center = true, bypass_discovery_ui = true, bypass_lock = true})
      area:emplace(card)
    end
  end
  return area
end

local function stake_name(stake)
  local s = G.P_CENTER_POOLS and G.P_CENTER_POOLS.Stake and G.P_CENTER_POOLS.Stake[stake]
  if s then
    local ok, name = pcall(localize, {type = 'name_text', set = 'Stake', key = s.key})
    if ok and type(name) == "string" and name ~= "ERROR" then return name end
  end
  return mod_loc(stake == 2 and "Red Stake" or "White Stake")
end

local function deck_name(key)
  local ok, name = pcall(localize, {type = 'name_text', set = 'Back', key = key})
  if ok and type(name) == "string" and name ~= "ERROR" then return name end
  local c = G.P_CENTERS[key]
  return c and c.name or key
end

