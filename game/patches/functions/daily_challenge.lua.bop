BO_DAILY = BO_DAILY or {}
local DY = BO_DAILY

local VANILLA_DECKS = {
  "b_red", "b_blue", "b_yellow", "b_green", "b_black", "b_magic", "b_nebula", "b_ghost",
  "b_abandoned", "b_checkered", "b_zodiac", "b_painted", "b_anaglyph", "b_plasma", "b_erratic",
}

local BANNED_VOUCHERS = {v_hieroglyph = true, v_petroglyph = true}

local function clamp(v, lo, hi)
  if v < lo then return lo end
  if hi and v > hi then return hi end
  return v
end

local function make_rng(seed)
  local s = math.floor(seed) % 2147483647
  if s <= 0 then s = s + 2147483646 end
  for _ = 1, 8 do s = (s * 48271) % 2147483647 end
  return function(a, b)
    s = (s * 16807) % 2147483647
    local r = (s - 1) / 2147483646
    if a then return a + math.floor(r * (b - a + 1)) end
    return r
  end
end

local function hash_string(str)
  local h = 2166136261
  for i = 1, #str do
    h = bit.bxor(h, string.byte(str, i))
    h = bit.tobit(h * 16777619 % 4294967296)
  end
  h = bit.bxor(h, bit.rshift(h, 16))
  h = bit.tobit((h % 4294967296) * 73244475 % 4294967296)
  h = bit.bxor(h, bit.rshift(h, 16))
  return (h % 2147483646) + 1
end

function DY.today()
  local ok, d = pcall(os.date, "!%Y-%m-%d")
  if ok and type(d) == "string" then return d end
  return "2026-01-01"
end

local function date_to_time(date)
  local y, m, d = tostring(date):match("^(%d+)-(%d+)-(%d+)$")
  if not y then return nil end
  return os.time({year = tonumber(y), month = tonumber(m), day = tonumber(d), hour = 12})
end

local function shift_date(date, days)
  local t = date_to_time(date)
  if not t then return date end
  return os.date("%Y-%m-%d", t + days * 86400)
end
DY.shift_date = shift_date

function DY.countdown()
  local ok, now = pcall(os.date, "!*t")
  if not ok or type(now) ~= "table" then return "--:--:--" end
  local secs = (23 - now.hour) * 3600 + (59 - now.min) * 60 + (60 - now.sec)
  return string.format("%02d:%02d:%02d", math.floor(secs / 3600), math.floor((secs % 3600) / 60), secs % 60)
end

local function deck_cfg(key)
  local c = G.P_CENTERS and G.P_CENTERS[key]
  return (c and type(c.config) == "table") and c.config or {}
end

local function base_params(deck_key)
  local sp = get_starting_params()
  local c = deck_cfg(deck_key)
  sp.hands = sp.hands + (tonumber(c.hands) or 0)
  sp.discards = sp.discards + (tonumber(c.discards) or 0)
  sp.hand_size = sp.hand_size + (tonumber(c.hand_size) or 0)
  sp.joker_slots = sp.joker_slots + (tonumber(c.joker_slot) or 0)
  sp.dollars = sp.dollars + (tonumber(c.dollars) or 0)
  sp.ante_scaling = tonumber(c.ante_scaling) or sp.ante_scaling
  sp.no_interest = c.no_interest and true or false
  return sp
end

