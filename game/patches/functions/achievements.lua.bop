-- ============================================
-- ACHIEVEMENTS SYSTEM for Balatro v10.0
-- Production-ready achievement tracking with rewards
-- PROTOCOL: Full null-safety, error handling, performance
-- ============================================

-- ============================================
-- CONSTANTS
-- ============================================

local MAX_ITERATIONS = 1000
local SAVE_INTERVAL = 60
local POPUP_DURATION = 4
local MAX_TRACKED = 3
local ITEMS_PER_PAGE = 6
local CHECK_INTERVAL = 1.0

-- ============================================
-- MODULE STATE
-- ============================================

local SAVE_TIMER = 0
local CHECK_TIMER = 0
local UNLOCK_QUEUE = {}

local RARITY_COLORS = {
    Common = {0.6, 0.6, 0.6, 1},
    Rare = {0.3, 0.5, 0.9, 1},
    Epic = {0.6, 0.3, 0.8, 1},
    Legendary = {1, 0.8, 0.2, 1},
    Secret = {0.2, 0.2, 0.2, 1}
}

local RARITY_ORDER = {
    Common = 1,
    Rare = 2,
    Epic = 3,
    Legendary = 4,
    Secret = 5
}

local ACHIEVEMENT_CATEGORIES = {
    "All",
    "Progression",
    "Scoring",
    "Joker Expertise",
    "Deck Mastery",
    "Challenge Master",
    "Collection",
    "Daily Champion",
    "Secret"
}

-- ============================================
-- ACHIEVEMENT MANAGER CLASS
-- ============================================

AchievementManager = AchievementManager or {}
AchievementManager.achievements = {}
AchievementManager.player_data = {}
AchievementManager.filters = {
    category = "All",
    status = "All",
    rarity = "All",
    search = ""
}
AchievementManager.sort_by = "category"
AchievementManager.current_page = 1
AchievementManager.items_per_page = ITEMS_PER_PAGE
AchievementManager.show_popup = false
AchievementManager.popup_achievement = nil
AchievementManager.popup_timer = 0
AchievementManager.popup_duration = POPUP_DURATION
AchievementManager.initialized = false

-- ============================================
-- SAFE ACCESS HELPERS
-- ============================================

local function safe_get_player_ach(achievement_id)
    if not achievement_id then return nil end
    if not AchievementManager.player_data then return nil end
    if not AchievementManager.player_data.achievements then return nil end

    local player_ach = AchievementManager.player_data.achievements[achievement_id]
    if not player_ach then
        player_ach = {
            unlocked = false,
            unlock_date = nil,
            progress = 0,
            notified = false
        }
        AchievementManager.player_data.achievements[achievement_id] = player_ach
    end
    return player_ach
end

local function safe_get_game_value(path, default)
    if not G then return default end
    if not G.GAME then return default end

    local current = G.GAME
    for part in string.gmatch(path, "[^.]+") do
        if type(current) ~= "table" then return default end
        current = current[part]
        if current == nil then return default end
    end
    return current
end

-- ============================================
-- INITIALIZATION
-- ============================================

function AchievementManager.init()
    if AchievementManager.initialized then return true end
    if not G then return false end

    local success, err = pcall(function()
        AchievementManager.player_data = {
            version = "2.0",
            last_updated = os.time() or 0,
            achievements = {},
            stats = {
                total_achievements = 0,
                unlocked_count = 0,
                completion_percentage = 0,
                last_unlock = nil,
                first_achievement_date = nil,
                total_play_time = 0,
                total_hands_played = 0,
                total_discards = 0,
                total_jokers_obtained = 0,
                total_jokers_sold = 0,
                total_consumables_used = 0,
                total_shops_visited = 0,
                total_vouchers_used = 0,
                total_blinds_beaten = 0,
                total_runs_started = 0,
                total_wins = 0,
                highest_ante = 0,
                highest_score = 0,
                highest_money = 0,
                fastest_win = nil
            },
            tracked_ids = {},
            equipped_title = nil,
            equipped_badges = {}
        }

        AchievementManager.load_data()
        AchievementManager.load_definitions()
        AchievementManager.update_stats()
        AchievementManager.initialized = true
    end)

    if not success then
        print("[ACHIEVEMENTS] ERROR init: " .. tostring(err))
        return false
    end

    print("[ACHIEVEMENTS] Initialized with " .. tostring(AchievementManager.count_achievements()) .. " achievements")
    return true
end

function AchievementManager.reload_for_profile()
    -- Do NOT save old profile data here — the profile may have been deleted/reset
    -- and saving would re-create the file with stale unlocked achievements.
    -- The old profile's data was already saved during normal gameplay.
    -- Reset and reload for the new profile
    pcall(function()
        AchievementManager.initialized = false
        AchievementManager.player_data = nil
        AchievementManager.init()
    end)
    print("[ACHIEVEMENTS] Reloaded for profile " .. tostring(G and G.SETTINGS and G.SETTINGS.profile or "?"))
end

function AchievementManager.delete_profile_data(profile_number)
    if not profile_number then return end
    local path = "achievement_data_" .. tostring(profile_number) .. ".jkr"
    pcall(function()
        love.filesystem.remove(path)
    end)
    print("[ACHIEVEMENTS] Deleted data for profile " .. tostring(profile_number))
end

-- ============================================
-- DEFINITIONS LOADER
-- ============================================

function AchievementManager.load_definitions()
    if AchievementManager.achievements then
        for k in pairs(AchievementManager.achievements) do
            AchievementManager.achievements[k] = nil
        end
    end
    AchievementManager.achievements = {}

    if not ACHIEVEMENT_DEFINITIONS then return end
    if type(ACHIEVEMENT_DEFINITIONS) ~= "table" then return end

    local count = #ACHIEVEMENT_DEFINITIONS
    for i = 1, math.min(count, MAX_ITERATIONS) do
        local achievement = ACHIEVEMENT_DEFINITIONS[i]
        if achievement and type(achievement) == "table" and achievement.id then
            AchievementManager.achievements[achievement.id] = achievement
            if not AchievementManager.player_data.achievements[achievement.id] then
                AchievementManager.player_data.achievements[achievement.id] = {
                    unlocked = false,
                    unlock_date = nil,
                    progress = 0,
                    notified = false
                }
            end
        end
    end

    if AchievementManager.player_data and AchievementManager.player_data.stats then
        AchievementManager.player_data.stats.total_achievements = AchievementManager.count_achievements()
    end

    -- Merge mod achievements into the global vanilla achievements table so they appear as normal achievements
    pcall(function()
        if G and type(G.ACHIEVEMENTS) == 'table' and ACHIEVEMENT_DEFINITIONS and type(ACHIEVEMENT_DEFINITIONS) == 'table' then
            for i = 1, #ACHIEVEMENT_DEFINITIONS do
                local a = ACHIEVEMENT_DEFINITIONS[i]
                if a and a.id and not G.ACHIEVEMENTS[a.id] then
                    local tier = 3
                    if a.rarity == 'Legendary' then tier = 1 elseif a.rarity == 'Rare' then tier = 2 end
                    G.ACHIEVEMENTS[a.id] = {order = a.order or (#G.ACHIEVEMENTS + 1), tier = tier, earned = false}
                end
            end
        end
    end)
end

-- ============================================
-- SAVE/LOAD SYSTEM
-- ============================================

function AchievementManager.get_save_path()
    local profile = (G and G.SETTINGS and G.SETTINGS.profile) or 1
    return "achievement_data_" .. tostring(profile) .. ".jkr"
end

function AchievementManager.save_data()
    if not G then return false end
    if not love then return false end
    if not love.filesystem then return false end

    local success, err = pcall(function()
        if AchievementManager.player_data then
            AchievementManager.player_data.last_updated = os.time() or 0
        end
        AchievementManager.update_stats()
        local save_string = "return " .. AchievementManager.serialize(AchievementManager.player_data)
        require("functions/fast_fs").write(AchievementManager.get_save_path(), save_string)
    end)

    if not success then
        print("[ACHIEVEMENTS] Save failed: " .. tostring(err))
        return false
    end
    return true
end

function AchievementManager.load_data()
    if not G then return false end
    if not love then return false end
    if not love.filesystem then return false end

    local success, err = pcall(function()
        local save_path = AchievementManager.get_save_path()
        local info = love.filesystem.getInfo(save_path)

        if info then
            local contents = love.filesystem.read(save_path)
            if contents and type(contents) == "string" and #contents > 0 then
                -- FIX: Use sandboxed load instead of raw loadstring (prevents code injection from tampered saves)
                local func = loadstring(contents)
                if func then
                    setfenv(func, {})
                    local ok_inner, data = pcall(func)
                    if ok_inner and data and type(data) == "table" then
                        for k, v in pairs(data) do
                            if AchievementManager.player_data then
                                AchievementManager.player_data[k] = v
                            end
                        end
                    end
                end
            end
        end
    end)

    if not success then
        print("[ACHIEVEMENTS] Load failed: " .. tostring(err))
        return false
    end
    return true
end

function AchievementManager.serialize(tbl, indent, depth)
    indent = indent or ""
    depth = depth or 0

    if depth > 20 then return '""' end

    if type(tbl) ~= "table" then
        if type(tbl) == "string" then
            return '"' .. tostring(tbl):gsub('"', '\\"'):gsub('\n', '\\n') .. '"'
        elseif type(tbl) == "boolean" then
            return tbl and "true" or "false"
        elseif type(tbl) == "number" then
            return tostring(tbl)
        else
            return "nil"
        end
    end

    local parts = {}
    local next_indent = indent .. "  "
    local iterations = 0

    parts[#parts+1] = "{\n"

r 12 326 %20%20%20%20 -
l 131
        iterations = iterations + 1
        if iterations > MAX_ITERATIONS then break end

        local key_str
        if type(k) == "string" then
            key_str = '["' .. k .. '"]'
        elseif type(k) == "number" then
            key_str = "[" .. tostring(k) .. "]"
        else
            key_str = '["' .. tostring(k) .. '"]'
        end

        local val_str
        if type(v) == "table" then
            val_str = AchievementManager.serialize(v, next_indent, depth + 1)
        elseif type(v) == "string" then
            val_str = '"' .. tostring(v):gsub('"', '\\"'):gsub('\n', '\\n') .. '"'
        elseif type(v) == "boolean" then
            val_str = v and "true" or "false"
        elseif type(v) == "function" then
            val_str = "nil"
        elseif type(v) == "number" then
            val_str = tostring(v)
        else
            val_str = "nil"
        end

        parts[#parts+1] = next_indent
        parts[#parts+1] = key_str
        parts[#parts+1] = " = "
        parts[#parts+1] = val_str
        parts[#parts+1] = ",\n"
    end

    parts[#parts+1] = indent
    parts[#parts+1] = "}"
    return table.concat(parts)
end

-- ============================================
-- ACHIEVEMENT CHECKING & UNLOCKING
-- ============================================

function AchievementManager.check_all_achievements()
    if not AchievementManager.initialized then return end
    if not AchievementManager.achievements then return end

    local iterations = 0
    for id, _ in pairs(AchievementManager.achievements) do
        iterations = iterations + 1
        if iterations > MAX_ITERATIONS then break end
        AchievementManager.check_achievement(id)
    end
end

function AchievementManager.check_achievement(achievement_id)
    if not achievement_id then return false end
    if not AchievementManager.achievements then return false end

    -- Block achievement progress during modded runs
    if G and G.GAME and G.GAME.modded_run then return false end

    local achievement = AchievementManager.achievements[achievement_id]
    if not achievement then return false end

    local player_ach = safe_get_player_ach(achievement_id)
    if not player_ach then return false end
    if player_ach.unlocked then return true end

    -- Check unlock condition function if present
    if achievement.unlock_condition and type(achievement.unlock_condition) == "function" then
        local success, result = pcall(achievement.unlock_condition)
        if success and result then
            AchievementManager.unlock_achievement(achievement_id)
            return true
        end
    end

    -- Check progress-based unlock
    local progress_required = achievement.progress_required or 1
    local current_progress = player_ach.progress or 0
    if progress_required > 0 and current_progress >= progress_required then
        AchievementManager.unlock_achievement(achievement_id)
        return true
    end

    return false
end

function AchievementManager.unlock_achievement(achievement_id)
    if not achievement_id then return false end
    if not AchievementManager.achievements then return false end

    -- Block achievement unlocks during modded runs
    if G and G.GAME and G.GAME.modded_run then return false end

    local achievement = AchievementManager.achievements[achievement_id]
    if not achievement then return false end

    local player_ach = safe_get_player_ach(achievement_id)
    if not player_ach then return false end
    if player_ach.unlocked then return false end

    -- Mark as unlocked
    player_ach.unlocked = true
    player_ach.unlock_date = os.time() or 0
    player_ach.progress = achievement.progress_required or 1

    -- Update stats
    if AchievementManager.player_data and AchievementManager.player_data.stats then
        AchievementManager.player_data.stats.last_unlock = achievement_id
        if not AchievementManager.player_data.stats.first_achievement_date then
            AchievementManager.player_data.stats.first_achievement_date = os.time() or 0
        end
    end

    -- Queue popup
    if UNLOCK_QUEUE and type(UNLOCK_QUEUE) == "table" then
        table.insert(UNLOCK_QUEUE, achievement_id)
    end

    -- Grant reward
    pcall(function() AchievementManager.grant_reward(achievement) end)

    -- Save immediately
    AchievementManager.save_data()

    -- Mirror into vanilla achievements table for seamless UI/platform integration
    pcall(function()
        if G then
            G.SETTINGS = G.SETTINGS or {}
r 13 1682 %20%20%20%20%20%20%20%20%20%20%20%20 -
l 264
            G.SETTINGS.ACHIEVEMENTS_EARNED[achievement_id] = true
