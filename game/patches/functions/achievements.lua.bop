function AchievementManager.on_edition_obtained()
    if not AchievementManager.initialized then return end
    if not (G and G.STAGES and G.STAGE == G.STAGES.RUN) then return end
    pcall(function()
        AchievementManager.update_progress("editions_10", 1, true)
        AchievementManager.update_progress("editions_50", 1, true)
    end)
end

function AchievementManager.check_periodic()
    if not AchievementManager.initialized then return end
    pcall(AchievementManager.sync_profile_progress)
    pcall(function()
        if not G then return end

        -- Hours played tracking
        if AchievementManager.player_data and AchievementManager.player_data.stats then
            local od = Overhaul and Overhaul.stats and Overhaul.stats.data()
            local play_time = math.max(AchievementManager.player_data.stats.total_play_time or 0, od and od.time or 0)
            AchievementManager.update_progress("hours_played_10", play_time)
            AchievementManager.update_progress("hours_played_50", play_time)
            AchievementManager.update_progress("hours_played_100", play_time)
        end

        -- Secret: Full consumable slots
        if G.consumeables and G.consumeables.cards and G.consumeables.config then
            local max_slots = G.consumeables.config.card_limit or 2
            if #G.consumeables.cards >= max_slots and max_slots >= 2 then
                AchievementManager.update_progress("secret_full_consumables", 1)
            end
        end

        -- Secret: Max hand size (>= 12)
        if G.hand and G.hand.config and G.hand.config.card_limit then
            if G.hand.config.card_limit >= 12 then
                AchievementManager.update_progress("secret_max_hand_size", 1)
            end
        end

        -- Enhancement variety: check for 7 different enhancement types at once
r 3 4751 %20%20%20%20%20%20%20%20 -
l 283
            local enhancements = {}
            local gold_count, steel_count, glass_count = 0, 0, 0
            for _, c in ipairs(G.playing_cards) do
                if c.ability and c.ability.name then
                    local name = c.ability.name
                    if name == "Bonus Card" or name == "Mult Card" or name == "Wild Card" or
                       name == "Glass Card" or name == "Steel Card" or name == "Stone Card" or
                       name == "Gold Card" or name == "Lucky Card" then
                        enhancements[name] = true
                    end
                    if name == "Gold Card" then gold_count = gold_count + 1 end
                    if name == "Steel Card" then steel_count = steel_count + 1 end
                    if name == "Glass Card" then glass_count = glass_count + 1 end
                end
            end
            local enh_count = 0
            for _ in pairs(enhancements) do enh_count = enh_count + 1 end
            if enh_count >= 7 then
                AchievementManager.update_progress("all_enhancements", 1)
            end
            if gold_count >= 5 then AchievementManager.update_progress("gold_card_5", gold_count) end
            if steel_count >= 5 then AchievementManager.update_progress("steel_card_5", steel_count) end
            if glass_count >= 5 then AchievementManager.update_progress("glass_card_5", glass_count) end
        end

        -- Daily quest sweep: check if all daily quests are completed
        if QuestManager and QuestManager.quest_data and QuestManager.quest_data.daily then
            local all_done = true
            local daily_count = 0
            for _, q in ipairs(QuestManager.quest_data.daily) do
                daily_count = daily_count + 1
                if q.status ~= "claimed" and q.status ~= "completed" then
                    all_done = false
                end
            end
            if all_done and daily_count > 0 then
                AchievementManager.update_progress("all_daily_quests", 1)
            end
        end

        -- Quest streak tracking
        if QuestManager and QuestManager.quest_data then
            local streak = QuestManager.quest_data.daily_streak or 0
            if streak > 0 then
                AchievementManager.update_progress("quest_streak_14", streak)
            end
        end
    end)
end

-- ============================================
-- HELPER FUNCTIONS
-- ============================================

function AchievementManager.get_rarity_color(rarity)
    if not rarity then return RARITY_COLORS.Common end
    return RARITY_COLORS[rarity] or RARITY_COLORS.Common
end

function AchievementManager.get_categories()
    return ACHIEVEMENT_CATEGORIES
end

function AchievementManager.get_display_name(achievement)
    if not achievement then return mod_loc("???") end
    if achievement.is_secret and not AchievementManager.is_unlocked(achievement.id) then return mod_loc("???") end
    return mod_loc(achievement.name or "Unknown")
end

function AchievementManager.get_display_description(achievement)
    if not achievement then return "" end
    if achievement.is_secret and not AchievementManager.is_unlocked(achievement.id) then
        return mod_loc(achievement.secret_hint or "This achievement is a secret...")
    end
    return mod_loc(achievement.description or "")
end

function AchievementManager.get_display_reward(achievement)
    if not achievement then return nil end
    if achievement.is_secret and not AchievementManager.is_unlocked(achievement.id) then return mod_loc("???") end
    if achievement.reward_data and achievement.reward_data.name then return mod_loc(achievement.reward_data.name) end
    return nil
end

function AchievementManager.reset_all()
    if not AchievementManager.player_data then return end
    if not AchievementManager.player_data.achievements then return end

    for id, _ in pairs(AchievementManager.player_data.achievements) do
        AchievementManager.player_data.achievements[id] = {
            unlocked = false, unlock_date = nil, progress = 0, notified = false
        }
    end

    if AchievementManager.player_data.stats then
        AchievementManager.player_data.stats.unlocked_count = 0
        AchievementManager.player_data.stats.completion_percentage = 0
        AchievementManager.player_data.stats.last_unlock = nil
    end

    AchievementManager.save_data()
    print("[ACHIEVEMENTS] Reset complete")
end

AchievementManager.SCORE_IDS = {"score_10k", "score_100k", "score_1m", "score_10m", "score_100m", "score_1b"}

function AchievementManager.sync_profile_progress()
    if not AchievementManager.initialized then return end
    local p = G and G.PROFILES and G.SETTINGS and G.PROFILES[G.SETTINGS.profile]
    if not p then return end
    local prog = type(p.progression) == "table" and p.progression or {}
    AchievementManager.update_progress("bom_daily_streak", tonumber(prog.bom_daily_streak) or 0)
    local icons = type(prog.unlocked_icons) == "table" and #prog.unlocked_icons or 0
    for _, n in ipairs({1, 5, 15, 30, 50, 100, 150}) do AchievementManager.update_progress("icon_collector_" .. n, icons) end
    local S = Overhaul and Overhaul.stats
    if S and S.mp_totals then
        AchievementManager.update_progress("mp_nemesis", S.mp_totals().wins)
        pcall(AchievementManager.sync_mp)
    end
    for event in pairs(AchievementManager.COUNTERS) do AchievementManager.sync_counter(event) end
end

AchievementManager.COUNTERS = {
    casino_visit = {"casino_first", "casino_visits_50"},
    forge_created = {"forge_first", "forge_10"},
    tailor_change = {"tailor_first", "tailor_10"},
    replay_watched = {"replay_first", "replay_10"},
    boss_practice = {"training_first"},
    arcade_play = {"arcade_first"},
    seed_saved = {"library_first"},
    history_opened = {"history_first"},
    cheats_opened = {"secret_mod_user"},
    guide_opened = {"secret_guide_reader"},
    jukebox_opened = {"secret_jukebox"},
}

AchievementManager.MP_MODES = {"nemesis", "faceoff", "ranked", "ascension", "race", "br", "teams", "raid", "swap"}

function AchievementManager.sync_counter(event)
    local S = Overhaul and Overhaul.stats
    local ids = AchievementManager.COUNTERS[event]
    if not (S and S.get and ids) then return end
    local n = tonumber(S.get(event)) or 0
    if n <= 0 then return end
    for _, id in ipairs(ids) do AchievementManager.update_progress(id, n) end
end

function AchievementManager.sync_places()
    local st = AchievementManager.player_data and AchievementManager.player_data.stats
    if not st then return end
    st.casino_places = type(st.casino_places) == "table" and st.casino_places or {}
    local n = 0
    for _ in pairs(st.casino_places) do n = n + 1 end
    AchievementManager.update_progress("casino_all_places", n)
end

function AchievementManager.sync_mp()
    local S = Overhaul and Overhaul.stats
    local d = S and S.data and S.data()
    if not (d and d.mp) then return end
    local t = S.mp_totals(d)
    for _, id in ipairs({"mp_play_1", "mp_play_50", "mp_play_200"}) do AchievementManager.update_progress(id, tonumber(t.played) or 0) end
    for _, id in ipairs({"mp_wins_50", "mp_wins_200"}) do AchievementManager.update_progress(id, tonumber(t.wins) or 0) end
    for _, id in ipairs({"mp_streak_3", "mp_streak_10"}) do AchievementManager.update_progress(id, tonumber(d.mp.best) or 0) end
    for _, id in ipairs({"mp_pvp_25", "mp_pvp_100"}) do AchievementManager.update_progress(id, tonumber(d.mp.pvp_w) or 0) end
    local won_modes = 0
    for _, key in ipairs(AchievementManager.MP_MODES) do
        local m = d.mp.modes[key]
        local w = type(m) == "table" and tonumber(m.wins) or 0
        if w > 0 then
            won_modes = won_modes + 1
            AchievementManager.update_progress("mp_win_" .. key, 1)
        end
        if key == "ranked" then AchievementManager.update_progress("mp_ranked_10", w) end
    end
    AchievementManager.update_progress("mp_all_modes", won_modes)
end

function AchievementManager.on_daily_finished()
    local st = AchievementManager.player_data and AchievementManager.player_data.stats
    if not st then return end
    local today = os.date("%Y-%m-%d", os.time())
    if st.daily_last == today then return end
    local yesterday = os.date("%Y-%m-%d", os.time() - 86400)
    st.daily_streak = (st.daily_last == yesterday) and ((tonumber(st.daily_streak) or 0) + 1) or 1
    st.daily_last = today
    AchievementManager.on_daily_complete(nil, st.daily_streak)
end

function AchievementManager.check_all()
    pcall(AchievementManager.sync_profile_progress)
    AchievementManager.check_all_achievements()
end

function AchievementManager.bridge()
    local S = Overhaul and Overhaul.stats
    if not (S and S.listen) or AchievementManager._bridged then return end
    AchievementManager._bridged = true
    local function live()
        local AM = rawget(_G, "AchievementManager")
        return AM and AM.initialized
    end
    S.listen("hand_scored", function(d)
        if not live() then return end
        local score = tonumber(d.score) or 0
        for _, id in ipairs(AchievementManager.SCORE_IDS) do AchievementManager.update_progress(id, score) end
    end)
    S.listen("*", function(d, event)
        if not live() then return end
        if AchievementManager.COUNTERS[event] then AchievementManager.sync_counter(event) end
        if event == "casino_place" and type(d) == "table" and d.key then
            local st = AchievementManager.player_data and AchievementManager.player_data.stats
            if st then
                st.casino_places = type(st.casino_places) == "table" and st.casino_places or {}
                st.casino_places[tostring(d.key)] = true
                AchievementManager.sync_places()
            end
        end
    end)
    S.listen("run_end", function(d)
        if not live() then return end
        if d.kind == "daily" then AchievementManager.on_daily_finished() end
        if d.kind == "seeded" and d.won then AchievementManager.update_progress("seeded_win", 1) end
    end)
    S.listen("mp_match_end", function(d)
        if d.duplicate or not live() then return end
        if (tonumber(d.pvp_wins) or 0) > 0 then AchievementManager.update_progress("mp_first_blood", 1) end
        pcall(AchievementManager.sync_mp)
        if d.result == "win" and tostring(d.deck or ""):lower():find("random", 1, true) then
            AchievementManager.update_progress("mp_random_deck", 1)
        end
        if d.result == "win" then
            AchievementManager.update_progress("mp_nemesis", S.mp_totals().wins)
            local lives = tonumber(d.lives)
            if lives == 1 then AchievementManager.update_progress("mp_comeback_kid", 1) end
            local st = bom_match and bom_match.get_state and bom_match.get_state()
            local start = st and st.settings and tonumber(st.settings.starting_lives)
            if lives and start and lives >= start then AchievementManager.update_progress("mp_untouchable", 1) end
        end
    end)
end

Overhaul = Overhaul or {}
Overhaul.achievements = Overhaul.achievements or {}
local OA = Overhaul.achievements

function OA.unlocked(key)
    return AchievementManager.is_unlocked(key) and true or false
end

function OA.progress(key)
    return AchievementManager.get_progress(key)
end

function OA.unlock(key)
    if not AchievementManager.initialized then pcall(AchievementManager.init) end
    return AchievementManager.unlock_achievement(key)
end

function OA.add(key, n)
    AchievementManager.update_progress(key, tonumber(n) or 1, true)
end

function OA.list()
    local out = {}
    for i, a in ipairs(ACHIEVEMENT_DEFINITIONS or {}) do
        out[#out + 1] = {key = a.id, name = AchievementManager.get_display_name(a), category = a.category, rarity = a.rarity,
            unlocked = AchievementManager.is_unlocked(a.id), goal = a.progress_required or 1}
    end
    return out
end

function OA.count()
    return AchievementManager.count_unlocked(), AchievementManager.count_achievements()
end

OA._unlock_listeners = OA._unlock_listeners or {}
function OA.on_unlock(fn)
    if type(fn) == "function" then table.insert(OA._unlock_listeners, fn) end
end

print("[ACHIEVEMENTS] Core module loaded (production-ready)")
return AchievementManager
end
