    print("[ACHIEVEMENTS] Unlocked: " .. tostring(achievement.name or achievement_id))
    return true
end

function AchievementManager.grant_reward(achievement)
    if not achievement then return end
    if not achievement.reward_type then return end
    if not achievement.reward_data then return end

    local reward = achievement.reward_data
    if type(reward) ~= "table" then return end

    pcall(function()
        if achievement.reward_type == "cosmetic" then
            G.ACHIEVEMENTS_COSMETICS = G.ACHIEVEMENTS_COSMETICS or {}
            if reward.id then G.ACHIEVEMENTS_COSMETICS[reward.id] = true end
        elseif achievement.reward_type == "title" then
            G.ACHIEVEMENTS_TITLES = G.ACHIEVEMENTS_TITLES or {}
            if reward.id then
                G.ACHIEVEMENTS_TITLES[reward.id] = {
                    name = reward.name or achievement.name or "Unknown",
                    unlocked = true
                }
            end
        elseif achievement.reward_type == "badge" then
            G.ACHIEVEMENTS_BADGES = G.ACHIEVEMENTS_BADGES or {}
            if reward.id then
                G.ACHIEVEMENTS_BADGES[reward.id] = {
                    name = reward.name or "Badge",
                    icon = reward.icon,
                    unlocked = true
                }
            end
        elseif achievement.reward_type == "currency" then
            if G.GAME and reward.amount and type(reward.amount) == "number" then
                G.GAME.dollars = (G.GAME.dollars or 0) + reward.amount
            end
        end
    end)
end

-- ============================================
-- PROGRESS TRACKING
-- ============================================

function AchievementManager.update_progress(achievement_id, value, increment)
    if not achievement_id then return end
    if not value or type(value) ~= "number" then return end
    if not AchievementManager.initialized then return end
    if not AchievementManager.achievements then return end
    -- FIX: Block progress accumulation during modded runs (prevents carryover into next clean run)
    if G and G.GAME and G.GAME.modded_run then return end

    local achievement = AchievementManager.achievements[achievement_id]
    if not achievement then return end

    local player_ach = safe_get_player_ach(achievement_id)
    if not player_ach then return end
    if player_ach.unlocked then return end

    local current = player_ach.progress or 0
    if increment then
        player_ach.progress = current + value
    else
        player_ach.progress = math.max(current, value)
    end

    -- Check for unlock
    local progress_required = achievement.progress_required or 1
    if progress_required > 0 and player_ach.progress >= progress_required then
        AchievementManager.unlock_achievement(achievement_id)
    end
end

function AchievementManager.get_progress(achievement_id)
    if not achievement_id then return 0, 1 end
    if not AchievementManager.achievements then return 0, 1 end

    local achievement = AchievementManager.achievements[achievement_id]
    if not achievement then return 0, 1 end

    local player_ach = safe_get_player_ach(achievement_id)
    local current = (player_ach and player_ach.progress) or 0
    local required = achievement.progress_required or 1

    return current, math.max(1, required)
end

function AchievementManager.get_progress_percent(achievement_id)
    local current, required = AchievementManager.get_progress(achievement_id)
    if required <= 0 then return 0 end
    return math.min(100, (current / required) * 100)
end

-- ============================================
-- QUERY FUNCTIONS
-- ============================================

function AchievementManager.get_achievement(achievement_id)
    if not achievement_id then return nil end
    if not AchievementManager.achievements then return nil end
    return AchievementManager.achievements[achievement_id]
end

function AchievementManager.is_unlocked(achievement_id)
    if not achievement_id then return false end
    local player_ach = safe_get_player_ach(achievement_id)
    return player_ach and player_ach.unlocked or false
end

function AchievementManager.get_unlock_date(achievement_id)
    if not achievement_id then return nil end
    local player_ach = safe_get_player_ach(achievement_id)
    if player_ach and player_ach.unlock_date then
        local success, result = pcall(function()
            return os.date("%b %d, %Y", player_ach.unlock_date)
        end)
        if success then return result end
    end
    return nil
end

function AchievementManager.count_achievements()
    if not AchievementManager.achievements then return 0 end
    local count = 0
    for _ in pairs(AchievementManager.achievements) do
        count = count + 1
        if count > MAX_ITERATIONS then break end
    end
    return count
end

function AchievementManager.count_unlocked()
    if not AchievementManager.achievements then return 0 end
    local count = 0
    for id, _ in pairs(AchievementManager.achievements) do
        if AchievementManager.is_unlocked(id) then count = count + 1 end
        if count > MAX_ITERATIONS then break end
    end
    return count
end

-- ============================================
-- STATISTICS
-- ============================================

function AchievementManager.update_stats()
    if not AchievementManager.player_data then return end
    if not AchievementManager.player_data.stats then
        AchievementManager.player_data.stats = {}
    end

    local stats = AchievementManager.player_data.stats
    stats.total_achievements = AchievementManager.count_achievements()
    stats.unlocked_count = AchievementManager.count_unlocked()

    if stats.total_achievements > 0 then
        stats.completion_percentage = (stats.unlocked_count / stats.total_achievements) * 100
    else
        stats.completion_percentage = 0
    end
end

function AchievementManager.get_stats()
    AchievementManager.update_stats()
    if AchievementManager.player_data and AchievementManager.player_data.stats then
        return AchievementManager.player_data.stats
    end
    return {total_achievements = 0, unlocked_count = 0, completion_percentage = 0}
end

function AchievementManager.get_category_stats()
    local stats = {}
    for i = 1, #ACHIEVEMENT_CATEGORIES do
        stats[ACHIEVEMENT_CATEGORIES[i]] = {total = 0, unlocked = 0}
    end

    if not AchievementManager.achievements then return stats end

    for id, ach in pairs(AchievementManager.achievements) do
        local category = ach.category or "Progression"
        if not stats[category] then stats[category] = {total = 0, unlocked = 0} end
        stats[category].total = stats[category].total + 1
        if AchievementManager.is_unlocked(id) then
            stats[category].unlocked = stats[category].unlocked + 1
        end
    end
    return stats
end

-- ============================================
-- POPUP SYSTEM (VANILLA STYLE)
-- ============================================

function AchievementManager.update_popup(dt)
    if not dt or type(dt) ~= "number" then return end

    -- Update current popup timer
    if AchievementManager.show_popup then
        AchievementManager.popup_timer = (AchievementManager.popup_timer or 0) - dt
        if AchievementManager.popup_timer <= 0 then
            AchievementManager.dismiss_popup()
        end
    end

    -- Show next queued popup
    if not AchievementManager.show_popup and UNLOCK_QUEUE and #UNLOCK_QUEUE > 0 then
        local achievement_id = table.remove(UNLOCK_QUEUE, 1)
        if achievement_id then
            AchievementManager.show_unlock_popup(achievement_id)
        end
    end
end

function AchievementManager.show_unlock_popup(achievement_id)
    if not achievement_id then return end
    if not AchievementManager.achievements then return end

    local achievement = AchievementManager.achievements[achievement_id]
    if not achievement then return end

    AchievementManager.popup_achievement = achievement
    AchievementManager.show_popup = true
    AchievementManager.popup_timer = POPUP_DURATION

    -- Use vanilla notify_alert popup system
    pcall(function()
        if not G then return end
        if not notify_alert then return end

        -- Register the achievement name in localization temporarily
        if G.localization and G.localization.misc then
            G.localization.misc.achievement_names = G.localization.misc.achievement_names or {}
            G.localization.misc.achievement_names[achievement_id] = AchievementManager.get_display_name(achievement)
        end

        -- Play sound
        if play_sound then
            play_sound('highlight1', 1.2, 0.6)
        end

        -- Call vanilla notify_alert
        notify_alert(achievement_id, 'achievement')
    end)

    -- Auto-dismiss after duration
    pcall(function()
        if G and G.E_MANAGER and Event then
r 1 112 %20%20%20%20%20%20%20%20%20%20%20%20 -
l 792
                trigger = 'after',
                delay = POPUP_DURATION,
                func = function()
                    AchievementManager.dismiss_popup()
                    return true
                end
            }))
        end
    end)
end

function AchievementManager.dismiss_popup()
    AchievementManager.show_popup = false
    AchievementManager.popup_achievement = nil
    AchievementManager.popup_timer = 0
end

-- ============================================
-- UPDATE LOOP
-- ============================================

function AchievementManager.update(dt)
    if not AchievementManager.initialized then
        pcall(function() AchievementManager.init() end)
        return
    end

    if not dt or type(dt) ~= "number" then return end

    if Overhaul and Overhaul.stats and Overhaul.stats.tick then pcall(Overhaul.stats.tick, dt) end

    -- Update popup
    pcall(function() AchievementManager.update_popup(dt) end)

    -- Periodic check (throttled)
    CHECK_TIMER = (CHECK_TIMER or 0) + dt
    if CHECK_TIMER >= CHECK_INTERVAL then
        CHECK_TIMER = 0
        pcall(function() AchievementManager.check_all_achievements() end)
    end

    -- Periodic save
    SAVE_TIMER = (SAVE_TIMER or 0) + dt
    if SAVE_TIMER >= SAVE_INTERVAL then
        SAVE_TIMER = 0
        pcall(function() AchievementManager.save_data() end)
    end
end

-- ============================================
-- EVENT HOOKS
-- ============================================

function AchievementManager.on_hand_played(hand_data)
    if not AchievementManager.initialized then return end

    pcall(function()
        local chips = 0
        local hand_name = ""

        if hand_data and type(hand_data) == "table" then
            chips = hand_data.chips or 0
            hand_name = hand_data.hand_name or ""
        end
        if G and G.GAME then
            chips = math.max(chips, G.GAME.chips or 0)
        end

        -- Update stats
        if AchievementManager.player_data and AchievementManager.player_data.stats then
            local stats = AchievementManager.player_data.stats
            stats.total_hands_played = (stats.total_hands_played or 0) + 1
            stats.highest_score = math.max(stats.highest_score or 0, chips)
        end

        -- Score achievements

        -- Hand type achievements
        if hand_name == "Flush Five" then
            AchievementManager.update_progress("play_flush_five", 1)
            -- Secret: Flush Five of all face/royal cards (id >= 11)
            if G and G.play and G.play.cards and #G.play.cards >= 5 then
                local all_royal = true
                for _, c in ipairs(G.play.cards) do
                    if not c.base or not c.base.id or c.base.id < 11 then
                        all_royal = false; break
                    end
                end
                if all_royal then
                    AchievementManager.update_progress("secret_flush_five_royal", 1)
                end
            end
        elseif hand_name == "Flush House" then
            AchievementManager.update_progress("play_flush_house", 1)
        elseif hand_name == "Five of a Kind" then
            AchievementManager.update_progress("play_five_of_kind", 1)
        elseif hand_name == "Straight Flush" then
            AchievementManager.update_progress("play_straight_flush", 1)
        elseif hand_name == "Royal Flush" then
            AchievementManager.update_progress("play_royal_flush", 1)
        elseif hand_name == "Full House" then
            AchievementManager.update_progress("play_full_house", 1)
        end

        -- Hand count achievements
        AchievementManager.update_progress("hands_played_100", 1, true)
        AchievementManager.update_progress("hands_played_500", 1, true)
        AchievementManager.update_progress("hands_played_1000", 1, true)
        AchievementManager.update_progress("hands_played_5000", 1, true)
        AchievementManager.update_progress("hands_played_10000", 1, true)

        -- New hand type tracking (cumulative)
        if hand_name == "Pair" then AchievementManager.update_progress("play_pair_100", 1, true) end
        if hand_name == "Two Pair" then AchievementManager.update_progress("play_two_pair_50", 1, true) end
        if hand_name == "Three of a Kind" then AchievementManager.update_progress("play_three_kind_50", 1, true) end
        if hand_name == "Four of a Kind" then AchievementManager.update_progress("play_four_kind_25", 1, true) end
        if hand_name == "Straight" then AchievementManager.update_progress("play_straight_25", 1, true) end
        if hand_name == "Flush" then AchievementManager.update_progress("play_flush_25", 1, true) end
        if hand_name == "Full House" then AchievementManager.update_progress("play_full_house_25", 1, true) end

        -- High Card Hero: track per-blind if only High Card played
        if not AchievementManager._blind_hand_types then AchievementManager._blind_hand_types = {} end
        table.insert(AchievementManager._blind_hand_types, hand_name)

        -- Overkill & Close Call: check blind requirement vs score
        if G and G.GAME and G.GAME.blind and G.GAME.blind.chips then
            local blind_req = G.GAME.blind.chips or 0
            if blind_req > 0 and chips >= blind_req then
                local ratio = chips / blind_req
                if ratio >= 10 then
                    AchievementManager.update_progress("overkill", 1)
                end
                if ratio < 1.05 then
                    AchievementManager.update_progress("close_call", 1)
                end
            end
        end

        -- Secret: All aces hand (check played cards)
        if G and G.play and G.play.cards and #G.play.cards >= 4 then
            local ace_count = 0
            local face_count = 0
            local suits_seen = {}
            for _, c in ipairs(G.play.cards) do
                if c.base and c.base.id then
                    if c.base.id == 14 then ace_count = ace_count + 1 end
                    if c.base.id >= 11 then face_count = face_count + 1 end
                end
                if c.base and c.base.suit then suits_seen[c.base.suit] = true end
            end
            if ace_count >= 4 then
                AchievementManager.update_progress("secret_all_aces", 1)
            end
            if #G.play.cards >= 5 and face_count == #G.play.cards then
                AchievementManager.update_progress("secret_all_face", 1)
            end
            local suit_count = 0
            for _ in pairs(suits_seen) do suit_count = suit_count + 1 end
            if suit_count >= 4 then
                AchievementManager.update_progress("secret_all_suits_hand", 1)
            end
        end

        -- Secret: Baker's Dozen (13 cards in hand)
        if G and G.hand and G.hand.cards and #G.hand.cards == 13 then
            AchievementManager.update_progress("secret_13_cards", 1)
        end
    end)
end

function AchievementManager.on_discard()
    if not AchievementManager.initialized then return end
    AchievementManager._run_discards = (AchievementManager._run_discards or 0) + 1
    pcall(function()
        if AchievementManager.player_data and AchievementManager.player_data.stats then
            AchievementManager.player_data.stats.total_discards =
                (AchievementManager.player_data.stats.total_discards or 0) + 1
        end
        AchievementManager.update_progress("discards_100", 1, true)
        AchievementManager.update_progress("discards_500", 1, true)
    end)
end

function AchievementManager.on_ante_complete(ante_number)
    if not AchievementManager.initialized then return end
    pcall(function()
        local ante = ante_number or 1
        if G and G.GAME and G.GAME.round_resets then
            ante = G.GAME.round_resets.ante or ante
        end

        -- Update stats
        if AchievementManager.player_data and AchievementManager.player_data.stats then
            AchievementManager.player_data.stats.highest_ante =
                math.max(AchievementManager.player_data.stats.highest_ante or 0, ante)
        end

        AchievementManager.on_ante_progress(ante - 1, ante)

        -- Capture starting dollars for the new ante (for bankrupt_swing detection)
        if G and G.GAME then
            AchievementManager._ante_start_dollars = G.GAME.dollars or 0
        end
    end)
end

AchievementManager.ANTE_DONE_IDS = {"ante_1", "ante_4", "ante_8", "ante_12"}
AchievementManager.ANTE_REACH_IDS = {"ante_5", "ante_10", "ante_15", "ante_20", "ante_25", "ante_30", "ante_39"}

function AchievementManager.on_ante_progress(completed, reached)
    for _, id in ipairs(AchievementManager.ANTE_DONE_IDS) do AchievementManager.update_progress(id, tonumber(completed) or 0) end
    for _, id in ipairs(AchievementManager.ANTE_REACH_IDS) do AchievementManager.update_progress(id, tonumber(reached) or 0) end
end

function AchievementManager.on_blind_complete()
    if not AchievementManager.initialized then return end
    -- FIX: Block during modded runs
    if G and G.GAME and G.GAME.modded_run then return end
    pcall(function()
        if AchievementManager.player_data and AchievementManager.player_data.stats then
            AchievementManager.player_data.stats.total_blinds_beaten =
                (AchievementManager.player_data.stats.total_blinds_beaten or 0) + 1
        end

        AchievementManager.update_progress("blinds_beaten_100", 1, true)
        AchievementManager.update_progress("blinds_beaten_500", 1, true)
        AchievementManager.update_progress("blinds_beaten_1000", 1, true)

        -- Boss blind tracking
        if G and G.GAME and G.GAME.blind and G.GAME.blind.config and G.GAME.blind.config.blind then
            local blind_key = G.GAME.blind.config.blind
            if blind_key and blind_key.boss then
                AchievementManager.update_progress("boss_defeated_50", 1, true)
                AchievementManager.update_progress("boss_defeated_100", 1, true)
            end
        end

        -- Track perfect ante: all 3 blinds in an ante beaten with exactly 1 hand each
        if G and G.GAME and G.GAME.current_round then
            local hands_this_blind = G.GAME.current_round.hands_played or 0

            -- Initialize tracking for this ante
            if not AchievementManager._perfect_ante_tracker then
                AchievementManager._perfect_ante_tracker = {ante = 0, blinds_perfect = 0}
            end

            local current_ante = 0
            if G.GAME.round_resets then
                current_ante = G.GAME.round_resets.ante or 0
            end

            -- Reset tracker if ante changed
            if current_ante ~= AchievementManager._perfect_ante_tracker.ante then
                AchievementManager._perfect_ante_tracker = {ante = current_ante, blinds_perfect = 0}
            end

            -- Count this blind if beaten with exactly 1 hand
            if hands_this_blind == 1 then
                AchievementManager._perfect_ante_tracker.blinds_perfect =
                    AchievementManager._perfect_ante_tracker.blinds_perfect + 1
            end

            -- Award only when all 3 blinds in the ante were beaten with 1 hand each
            if AchievementManager._perfect_ante_tracker.blinds_perfect >= 3 then
                AchievementManager.update_progress("perfect_ante", 1)
                AchievementManager._perfect_ante_tracker.blinds_perfect = 0
            end
        end

        if safe_get_game_value("blind.config.blind.boss", false) and safe_get_game_value("round_resets.ante", 0) == 7 and (G.GAME.dollars or 0) == 77 then
            AchievementManager.update_progress("secret_lucky_7", 1)
        end

        -- Secret: Broke achievement (win blind with $0)
        if G and G.GAME and (G.GAME.dollars or 0) == 0 then
            AchievementManager.update_progress("secret_zero_dollars", 1)
        end

        -- High Card Hero: check if all hands this blind were High Card
        if AchievementManager._blind_hand_types and #AchievementManager._blind_hand_types > 0 then
            local all_high = true
            for _, hn in ipairs(AchievementManager._blind_hand_types) do
                if hn ~= "High Card" then all_high = false; break end
            end
            if all_high then
                AchievementManager.update_progress("high_card_blind", 1)
            end
        end
        AchievementManager._blind_hand_types = {}

        -- Secret: Last Card Standing (win blind with only 1 card total in deck areas)
        if G then
            local total = 0
            if G.deck and G.deck.cards then total = total + #G.deck.cards end
            if G.hand and G.hand.cards then total = total + #G.hand.cards end
            if G.play and G.play.cards then total = total + #G.play.cards end
            if G.discard and G.discard.cards then total = total + #G.discard.cards end
            if G.playing_cards and #G.playing_cards > 0 then total = #G.playing_cards end
            if total <= 1 then
                AchievementManager.update_progress("secret_one_card_deck", 1)
            end
        end
    end)
end

function AchievementManager.on_run_start()
    if not AchievementManager.initialized then return end
    AchievementManager._run_discards = 0
    AchievementManager._perfect_ante_tracker = nil
    AchievementManager._blind_hand_types = {}
    AchievementManager._run_planets_used = {}
    AchievementManager._run_tarots_used = {}
    AchievementManager._ante_start_dollars = nil
    AchievementManager._win_streak = AchievementManager._win_streak or 0
    pcall(function()
        if AchievementManager.player_data and AchievementManager.player_data.stats then
            AchievementManager.player_data.stats.total_runs_started =
                (AchievementManager.player_data.stats.total_runs_started or 0) + 1
        end
        AchievementManager.update_progress("runs_started", 1, true)
        AchievementManager.update_progress("runs_500", 1, true)
    end)
end

function AchievementManager.on_run_end(won, final_score, run_time, deck_key)
    if not AchievementManager.initialized then return end
    -- FIX: Block during modded runs (checked from captured was_modded in hook, but guard here too)
    if G and G.GAME and G.GAME.modded_run then return end
    pcall(function()
        if won then
            -- Update win stats
            if AchievementManager.player_data and AchievementManager.player_data.stats then
                local stats = AchievementManager.player_data.stats
                stats.total_wins = (stats.total_wins or 0) + 1
                if run_time and (not stats.fastest_win or run_time < stats.fastest_win) then
                    stats.fastest_win = run_time
                end
            end

            -- Win achievements
            AchievementManager.update_progress("first_win", 1)
            AchievementManager.update_progress("wins_10", 1, true)
            AchievementManager.update_progress("wins_50", 1, true)
            AchievementManager.update_progress("wins_100", 1, true)
            if G and G.GAME then
                AchievementManager.on_ante_progress(G.GAME.win_ante or 8, safe_get_game_value("round_resets.ante", 0))
            end

            -- Speed run achievements
            if run_time and type(run_time) == "number" and run_time > 0 and not G.GAME.seeded then
                if run_time < 900 then -- Under 15 minutes
                    AchievementManager.update_progress("speed_runner", 1)
                end
                if run_time < 1200 then
                    AchievementManager.update_progress("speed_20", 1)
                end
                if run_time < 600 then -- Under 10 minutes
                    AchievementManager.update_progress("speed_demon", 1)
                end
            end

            -- Deck mastery achievements
            if deck_key and type(deck_key) == "string" then
                AchievementManager.update_progress("deck_win_" .. deck_key, 1)
            end

            -- Stake achievements
            local stake = 1
            if G and G.GAME then stake = G.GAME.stake or 1 end
            if stake >= 1 then AchievementManager.update_progress("stake_white", 1) end
            if stake >= 2 then AchievementManager.update_progress("stake_red", 1) end
            if stake >= 3 then AchievementManager.update_progress("stake_green", 1) end
            if stake >= 4 then AchievementManager.update_progress("stake_black", 1) end
            if stake >= 5 then AchievementManager.update_progress("stake_blue", 1) end
            if stake >= 6 then AchievementManager.update_progress("stake_purple", 1) end
            if stake >= 7 then AchievementManager.update_progress("stake_orange", 1) end
            if stake >= 8 then AchievementManager.update_progress("stake_gold", 1) end
            if stake >= 9 then AchievementManager.update_progress("stake_chaos", 1); AchievementManager.update_progress("creative_first", 1) end
            if stake >= 10 then AchievementManager.update_progress("stake_apocalypse", 1) end
            if stake >= 11 then AchievementManager.update_progress("stake_oblivion", 1) end
            if stake >= 12 then AchievementManager.update_progress("stake_transcendent", 1) end

            -- Creative stakes counter (track unique creative stakes won)
            if stake >= 9 then
                if not AchievementManager.player_data.stats then AchievementManager.player_data.stats = {} end
                if not AchievementManager.player_data.stats.creative_stakes_won then
                    AchievementManager.player_data.stats.creative_stakes_won = {}
                end
                AchievementManager.player_data.stats.creative_stakes_won[tostring(stake)] = true
                local count = 0
                for _ in pairs(AchievementManager.player_data.stats.creative_stakes_won) do count = count + 1 end
                AchievementManager.update_progress("creative_3_stakes", count)
                AchievementManager.update_progress("creative_all_stakes", count)
            end

            -- Challenge achievements
            if G.GAME.challenge and G.GAME.challenge ~= "" then
                local cid = G.GAME.challenge
                local st = AchievementManager.player_data.stats
                st.challenges_won = type(st.challenges_won) == "table" and st.challenges_won or {}
                st.challenges_won[tostring(cid)] = true
                local won_n = 0
                for _ in pairs(st.challenges_won) do won_n = won_n + 1 end
                for _, id in ipairs({"challenge_first", "challenge_5", "challenge_10", "challenge_20", "challenge_30"}) do
                    AchievementManager.update_progress(id, won_n)
                end
                if cid == "c_bankruptcy_1" then AchievementManager.update_progress("challenge_bankruptcy", 1) end
                if cid == "c_gauntlet_1" then AchievementManager.update_progress("challenge_gauntlet", 1) end
                if cid == "c_glass_cannon_1" then AchievementManager.update_progress("challenge_glass_cannon", 1) end
                if cid == "c_duality_1" then AchievementManager.update_progress("challenge_duality", 1) end
                if cid == "c_alchemist_1" then AchievementManager.update_progress("challenge_alchemist", 1) end
            end

            -- Win streak
            local hs = G.PROFILES and G.PROFILES[G.SETTINGS.profile] and G.PROFILES[G.SETTINGS.profile].high_scores
            AchievementManager._win_streak = hs and hs.current_streak and tonumber(hs.current_streak.amt) or ((AchievementManager._win_streak or 0) + 1)
            AchievementManager.update_progress("win_streak_5", AchievementManager._win_streak)

            -- Secret: Debt Victory (win while in debt)
            if G.GAME.dollars and G.GAME.dollars < 0 then
                AchievementManager.update_progress("secret_negative_win", 1)
            end

            -- All planet/tarot types in one run
            if AchievementManager._run_planets_used then
                local planet_count = 0
                for _ in pairs(AchievementManager._run_planets_used) do planet_count = planet_count + 1 end
                if planet_count >= 12 then
                    AchievementManager.update_progress("all_planet_types", 1)
                end
            end
            if AchievementManager._run_tarots_used then
                local tarot_count = 0
                for _ in pairs(AchievementManager._run_tarots_used) do tarot_count = tarot_count + 1 end
                if tarot_count >= 22 then
                    AchievementManager.update_progress("all_tarot_types", 1)
                end
            end

            -- Joker count achievements
            if G and G.jokers and G.jokers.cards then
                local count = #G.jokers.cards
                if count == 0 then
                    AchievementManager.update_progress("no_jokers_win", 1)
                elseif count == 1 then
                    AchievementManager.update_progress("minimalist", 1)
                end
                if count >= 5 then
                    AchievementManager.update_progress("win_5_jokers", 1)
                end

                -- Check common-only win
                local all_common = true
                for _, joker in ipairs(G.jokers.cards) do
                    if joker.config and joker.config.center then
                        local rarity = joker.config.center.rarity or 1
                        if rarity > 1 then
                            all_common = false
                            break
                        end
                    end
                end
                if all_common and count > 0 then
                    AchievementManager.update_progress("common_only_win", 1)
                end
            end

            -- Secret: Classic deck (exactly 52 cards total in all areas)
            if G then
                local total_cards = 0
                if G.deck and G.deck.cards then total_cards = total_cards + #G.deck.cards end
                if G.hand and G.hand.cards then total_cards = total_cards + #G.hand.cards end
                if G.play and G.play.cards then total_cards = total_cards + #G.play.cards end
                if G.discard and G.discard.cards then total_cards = total_cards + #G.discard.cards end
                if G.playing_cards and #G.playing_cards > 0 then total_cards = #G.playing_cards end
                if total_cards == 52 then
                    AchievementManager.update_progress("secret_exactly_52", 1)
                end
            end

            -- Perfectionist (no skipped blinds - won every blind faced)
            -- In Balatro, losing a blind = game over, so if you won, all blinds were beaten.
            -- Redefine: win run without ever using a discard (same as no_discards but also a "clean run")
            -- Actually: Perfectionist = win run with 0 blinds skipped (fought every blind)
            if G and G.GAME then
                local skips = 0
                if G.GAME.blind_states then
                    for _, state in pairs(G.GAME.blind_states) do
                        if state == "Skipped" then skips = skips + 1 end
                    end
                end
                -- If no skips across the whole run, that's harder to track
                -- Use round_resets.blind_states for current ante only
                -- Better: track skipped blinds cumulatively (already counted in G.GAME.skips)
                local total_skips = G.GAME.skips or 0
                if total_skips == 0 then
                    AchievementManager.update_progress("perfectionist", 1)
                end
            end

            -- No discards win (use our tracked counter)
            if (AchievementManager._run_discards or 0) == 0 then
                AchievementManager.update_progress("no_discards_win", 1)
            end
        else
            -- Run lost — reset win streak
            AchievementManager._win_streak = 0
        end

        AchievementManager.save_data()
    end)
end

function AchievementManager.on_joker_added(joker)
    if not AchievementManager.initialized then return end
    pcall(function()
        if AchievementManager.player_data and AchievementManager.player_data.stats then
            AchievementManager.player_data.stats.total_jokers_obtained =
                (AchievementManager.player_data.stats.total_jokers_obtained or 0) + 1
        end

        AchievementManager.update_progress("jokers_obtained_50", 1, true)
        AchievementManager.update_progress("jokers_obtained_100", 1, true)
        AchievementManager.update_progress("jokers_obtained_500", 1, true)

        -- Check current joker count
        if G and G.jokers and G.jokers.cards then
            local count = #G.jokers.cards
            AchievementManager.update_progress("joker_5_at_once", count)
            AchievementManager.update_progress("joker_10_at_once", count)
            AchievementManager.update_progress("joker_20_at_once", count)

            -- Count legendary jokers and edition types
            local legendary_count = 0
            local editions_seen = {}
            local rarities_seen = {}
            for _, j in ipairs(G.jokers.cards) do
                if j.config and j.config.center then
                    local rarity = j.config.center.rarity or 1
                    if rarity == 4 then legendary_count = legendary_count + 1 end
                    rarities_seen[rarity] = true
                end
                if j.edition then
                    if j.edition.negative then editions_seen["negative"] = true end
                    if j.edition.polychrome then editions_seen["polychrome"] = true end
                    if j.edition.holo then editions_seen["holo"] = true end
                    if j.edition.foil then editions_seen["foil"] = true end
                end
            end
            AchievementManager.update_progress("all_legendary", legendary_count)
            AchievementManager.update_progress("full_legendary_5", legendary_count)

            -- Edition achievements
            local edition_count = 0
            for _ in pairs(editions_seen) do edition_count = edition_count + 1 end
            AchievementManager.update_progress("edition_variety", edition_count)

            if editions_seen["negative"] then AchievementManager.update_progress("negative_joker", 1) end
            if editions_seen["polychrome"] then AchievementManager.update_progress("polychrome_joker", 1) end
            if editions_seen["holo"] then AchievementManager.update_progress("holographic_joker", 1) end
            if editions_seen["foil"] then AchievementManager.update_progress("foil_joker", 1) end

            -- Rainbow: all 4 rarities at once (1=Common, 2=Uncommon, 3=Rare, 4=Legendary)
            if rarities_seen[1] and rarities_seen[2] and rarities_seen[3] and rarities_seen[4] then
                AchievementManager.update_progress("secret_rainbow", 1)
            end
        end

        -- Check if legendary joker
        if joker and type(joker) == "table" and joker.config and joker.config.center then
            if joker.config.center.rarity == 4 then
                AchievementManager.update_progress("legendary_obtained", 1, true)
            end
        end
    end)
end

function AchievementManager.on_joker_sold()
    if not AchievementManager.initialized then return end
    pcall(function()
        if AchievementManager.player_data and AchievementManager.player_data.stats then
            AchievementManager.player_data.stats.total_jokers_sold =
                (AchievementManager.player_data.stats.total_jokers_sold or 0) + 1
        end
        AchievementManager.update_progress("sell_jokers_50", 1, true)
        AchievementManager.update_progress("jokers_sold_200", 1, true)
    end)
end

function AchievementManager.on_shop_visit()
    if not AchievementManager.initialized then return end
    pcall(function()
        if AchievementManager.player_data and AchievementManager.player_data.stats then
            AchievementManager.player_data.stats.total_shops_visited =
                (AchievementManager.player_data.stats.total_shops_visited or 0) + 1
        end
        AchievementManager.update_progress("shops_visited", 1, true)
    end)
end

function AchievementManager.on_money_change(amount)
    if not AchievementManager.initialized then return end
    pcall(function()
        if G and G.GAME then
            local total = G.GAME.dollars or 0

            -- Update highest money stat
            if AchievementManager.player_data and AchievementManager.player_data.stats then
                AchievementManager.player_data.stats.highest_money =
                    math.max(AchievementManager.player_data.stats.highest_money or 0, total)
            end

            -- Money achievements
            AchievementManager.update_progress("money_100", total)
            AchievementManager.update_progress("money_500", total)
            AchievementManager.update_progress("money_1000", total)
            AchievementManager.update_progress("money_2000", total)
            AchievementManager.update_progress("money_5000", total)

            -- Secret: $999
            if total >= 999 then
                AchievementManager.update_progress("secret_999_dollars", 1)
            end

            -- Secret: In the Red (debt)
            if total < 0 then
                AchievementManager.update_progress("secret_debt", 1)
            end

            -- Bankrupt swing: track if we went from 100+ to 0 within this ante
            if AchievementManager._ante_start_dollars and AchievementManager._ante_start_dollars >= 100 and total <= 0 then
                AchievementManager.update_progress("bankrupt_swing", 1)
            end
            -- Track spending for big_spender
            if amount and type(amount) == "number" and amount < 0 then
                AchievementManager.update_progress("big_spender", math.abs(amount), true)
            end
        end
    end)
end

function AchievementManager.on_voucher_used(voucher_key)
    if not AchievementManager.initialized then return end
    pcall(function()
        if AchievementManager.player_data and AchievementManager.player_data.stats then
            AchievementManager.player_data.stats.total_vouchers_used =
                (AchievementManager.player_data.stats.total_vouchers_used or 0) + 1
        end
        AchievementManager.update_progress("vouchers_used", 1, true)

        -- Check voucher count for secret_10_vouchers
        if G and G.GAME and G.GAME.used_vouchers then
            local voucher_count = 0
            for _ in pairs(G.GAME.used_vouchers) do voucher_count = voucher_count + 1 end
            if voucher_count >= 10 then
                AchievementManager.update_progress("secret_10_vouchers", 1)
            end
        end
    end)
end

function AchievementManager.on_consumable_used(consumable_type, consumable_key)
    if not AchievementManager.initialized then return end
    pcall(function()
        if AchievementManager.player_data and AchievementManager.player_data.stats then
            AchievementManager.player_data.stats.total_consumables_used =
                (AchievementManager.player_data.stats.total_consumables_used or 0) + 1
        end
        AchievementManager.update_progress("consumables_used_100", 1, true)
        AchievementManager.update_progress("consumables_500", 1, true)
        AchievementManager.update_progress("consumables_1000", 1, true)

        -- Track by consumable type
        if consumable_type == "Tarot" then
            AchievementManager.update_progress("tarots_50", 1, true)
            AchievementManager.update_progress("tarots_200", 1, true)
            -- Track unique tarot types used this run
            if consumable_key and AchievementManager._run_tarots_used then
                AchievementManager._run_tarots_used[consumable_key] = true
            end
        elseif consumable_type == "Planet" then
            AchievementManager.update_progress("planets_50", 1, true)
            AchievementManager.update_progress("planets_200", 1, true)
            -- Track unique planet types used this run
            if consumable_key and AchievementManager._run_planets_used then
                AchievementManager._run_planets_used[consumable_key] = true
            end
        elseif consumable_type == "Spectral" then
            AchievementManager.update_progress("spectrals_25", 1, true)
            AchievementManager.update_progress("spectrals_100", 1, true)
        end
    end)
end

function AchievementManager.on_daily_complete(score, streak)
    if not AchievementManager.initialized then return end
    pcall(function()
        AchievementManager.update_progress("daily_complete_1", 1)
        AchievementManager.update_progress("daily_complete_7", 1, true)
        AchievementManager.update_progress("daily_complete_30", 1, true)

        if streak and type(streak) == "number" then
            AchievementManager.update_progress("daily_streak_7", streak)
            AchievementManager.update_progress("daily_streak_30", streak)
        end

        AchievementManager.save_data()
    end)
end

function AchievementManager.on_blind_skipped()
    if not AchievementManager.initialized then return end
    pcall(function()
        AchievementManager.update_progress("first_skip", 1)
        AchievementManager.update_progress("skip_50", 1, true)
    end)
end

function AchievementManager.on_shop_reroll()
    if not AchievementManager.initialized then return end
