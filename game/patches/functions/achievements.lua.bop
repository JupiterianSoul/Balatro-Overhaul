            if G.ACHIEVEMENTS then
                -- Map rarity to vanilla tier (1=Legendary,2=Rare,3=Common)
                local tier = (achievement.rarity == 'Legendary') and 1 or (achievement.rarity == 'Rare') and 2 or 3
                G.ACHIEVEMENTS[achievement_id] = G.ACHIEVEMENTS[achievement_id] or {order = achievement.order or 999, tier = tier, earned = true}
                G.ACHIEVEMENTS[achievement_id].earned = true
