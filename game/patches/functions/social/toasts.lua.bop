l 5
        if bom_ui and bom_ui.show_connecting_screen then pcall(bom_ui.show_connecting_screen) end
        if bom_room and bom_room.join then bom_room.join(e.room, {}) end
    end
    G.FUNCS.social_toast_later = function()
        local e = ST.cur
r 4 1300 %20%20%20%20%20%20%20%20 -
l 55
        if e.kind == "invite" and not e.with_join then
            e.shown_until, e.dormant = nil, true
            ST.hide()
            return
        end
        drop(e)
    end
    G.FUNCS.social_toast_ask_yes = function()
        local e = ST.cur
        if not (e and e.kind == "ask") then return end
        drop(e)
        local T = state()
        if T then T.send({type = "social_ask_reply", code = e.code, ok = true}) end
    end
    G.FUNCS.social_toast_ask_no = function()
        local e = ST.cur
        if not (e and e.kind == "ask") then return end
        drop(e)
        local T = state()
        if T then T.send({type = "social_ask_reply", code = e.code, ok = false}) end
    end
    G.FUNCS.social_play_with = function(e)
        local r = ref(e)
        ST.play_with(r.code, r.name)
    end
end

