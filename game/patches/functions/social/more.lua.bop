local function back_to_card(code)
    local SC = rawget(_G, "social_card")
    if code and SC and SC.open then SC.open(code) else friends().open("friends") end
end
SX.back_to_card = back_to_card

function SX.privacy_rows(w)
    SX.view.hidden = SX.hidden()
    return {
        UIK.toggle{label = L("Appear offline"), info = L("Friends see you as offline. You still see them."), w = w,
            ref_table = SX.view, ref_value = "hidden", id = "social_opt_hidden", callback = function(v) SX.set_hidden(v) end},
        UIK.action{label = L("Blocked players"), button_label = L("Open"), button = "social_blocked_open", w = w, id = "social_opt_blocked"},
    }
end

local function ref(e) return e and e.config and e.config.ref_table or {} end

local function register_funcs()
    G.FUNCS.social_blocked_open = function() SX.open_blocked() end
    G.FUNCS.social_blocked_back = function() friends().open("options") end
    G.FUNCS.social_blocked_page = function(e)
        SX.page = SX.page + (ref(e).d or 0)
        UIK.refresh()
    end
    G.FUNCS.social_unblock = function(e)
        local code = ref(e).code
        if code then state().send({type = "social_unblock", code = code}) end
    end
    G.FUNCS.social_nick_back = function() back_to_card(SX.nick_code) end
    G.FUNCS.social_nick_save = function()
        local code = SX.nick_code
        if not code then return end
        SX.set_nick(code, SX.view.nick)
        if G.CONTROLLER then G.CONTROLLER.text_input_hook = nil end
        back_to_card(code)
    end
    G.FUNCS.social_nick_clear = function()
        local code = SX.nick_code
        if not code then return end
        SX.set_nick(code, "")
        if G.CONTROLLER then G.CONTROLLER.text_input_hook = nil end
        back_to_card(code)
    end
    G.FUNCS.social_ask_join = function(e)
        local code = ref(e).code
        if code then SX.ask_join(code) end
    end
end

function SX.init()
    register_funcs()
    if bom_events and bom_events.register then
        bom_events.register("social_typing", function(d) SX.on_typing(d) return true end)
        bom_events.register("social_ask", function(d) SX.on_ask(d) return true end)
        bom_events.register("social_ask_no", function(d) SX.on_ask_no(d) return true end)
        bom_events.register("social_blocks", function(d) SX.on_blocks(d) return true end)
        bom_events.register("social_result", function(d) pcall(SX.on_result, d) return false end)
        bom_events.register("social_me", function()
            SX.blocks_asked = nil
            return false
        end)
    end
    if not mod_loc_register then return end
    mod_loc_register{
        fr = {
