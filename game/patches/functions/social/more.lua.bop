        title = L("BLOCKED"),
        tabs = {{key = "main", label = L("Blocked players"), build = blocked_body}},
        back_func = "social_blocked_back",
    }}
end

local function nick_body()
    local w = win_w()
    local inner = w - 0.4
    local t = touch()
    local T = state()
    local f = SX.nick_code and T.friend(SX.nick_code)
    if not f then return UIK.stack({UIK.note(L("Not on your friends list."), {w = inner})}, {w = w}) end
    local bh = t and 0.78 or 0.62
    local bw = (inner - 0.2) / 2
    return UIK.stack({
        {n = G.UIT.R, config = {align = "cm", padding = 0.04}, nodes = {
            UIK.text(T.fill("Name: {name}", {name = SX.real_name(f)}), {scale = bom_kit.dims().small, colour = UIK.C.muted}),
        }},
        {n = G.UIT.R, config = {align = "cm", minw = inner, minh = t and 0.9 or 0.76, padding = 0.04}, nodes = {
            create_text_input({w = inner - 0.1, h = t and 0.7 or 0.58, max_length = SX.NICK_MAX, text_scale = t and 0.36 or 0.32,
                prompt_text = L("Nickname"), ref_table = SX.view, ref_value = "nick", extended_corpus = true, keyboard_offset = 1,
                callback = function() G.FUNCS.social_nick_save() end}),
        }},
        UIK.note(L("Only you see it."), {w = inner}),
        UIK.spacer(0.1),
        {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = {
            UIK.button{label = L("Save"), button = "social_nick_save", colour = G.C.GREEN, w = bw, h = bh, col = true, id = "social_nick_save"},
            {n = G.UIT.C, config = {minw = 0.2}, nodes = {}},
            UIK.button{label = L("Clear"), button = "social_nick_clear", colour = G.C.RED, w = bw, h = bh, col = true, disabled = SX.nick(f.code) == nil, id = "social_nick_clear"},
        }},
    }, {w = w})
end

function SX.open_nick(code)
    SX.nick_code = code
    SX.view.nick = SX.nick(code) or ""
    if G.CONTROLLER then G.CONTROLLER.text_input_hook = nil end
