            ["{name} played the daily seed: ante {ante}, rank {rank}."] = "{name} a joué la seed du jour : mise initiale {ante}, rang {rank}.",
            ["{name} has news."] = "{name} a du nouveau.",
            ["Connect to see your blocked players."] = "Connectez-vous pour voir les joueurs bloqués.",
            ["Nobody is blocked."] = "Personne n'est bloqué.",
            ["They cannot send you requests, invites, messages or emotes."] = "Ils ne peuvent plus vous envoyer de demandes, d'invitations, de messages ni d'émotes.",
            ["Unblock"] = "Débloquer", ["BLOCKED"] = "BLOQUÉS", ["Blocked players"] = "Joueurs bloqués",
            ["NICKNAME"] = "SURNOM", ["Nickname"] = "Surnom", ["Name: {name}"] = "Nom : {name}", ["Only you see it."] = "Vous seul le voyez.",
            ["Save"] = "Enregistrer", ["Clear"] = "Effacer",
            ["Appear offline"] = "Apparaître hors ligne", ["Friends see you as offline. You still see them."] = "Vos amis vous voient hors ligne. Vous les voyez toujours.",
            ["Open"] = "Ouvrir", ["Privacy"] = "Confidentialité",
