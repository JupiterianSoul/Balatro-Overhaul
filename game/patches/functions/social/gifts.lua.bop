    G.FUNCS.overlay_menu{definition = UIK.window{
        id = "social_gift", compact = true, w = win_w() + 0.2,
        title = L("GIFT"),
        tabs = {{key = "main", label = L("Spare cosmetics"), build = body}},
        back_func = "social_gift_back",
    }}
end

local function ref(e) return e and e.config and e.config.ref_table or {} end

function SG.init()
    SG.install()
    G.FUNCS.social_gift_open = function(e) if ref(e).code then SG.open(ref(e).code) end end
    G.FUNCS.social_gift_send = function(e) SG.send(ref(e).i) end
    G.FUNCS.social_gift_page = function(e)
        SG.page = SG.page + (ref(e).d or 0)
        UIK.refresh()
    end
    G.FUNCS.social_gift_back = function()
        local sx = rawget(_G, "social_more")
        if sx and sx.back_to_card then sx.back_to_card(SG.code) else friends().open("friends") end
    end
    if bom_events and bom_events.register then
        bom_events.register("social_result", function(d) pcall(SG.on_result, d) return false end)
        bom_events.register("notify_new", function(d) pcall(SG.on_new, d) return false end)
    end
    if not mod_loc_register then return end
    mod_loc_register{
        fr = {
            ["Not enough Balacoin."] = "Pas assez de Balacoin.", ["You sent 10 gifts today. Try again tomorrow."] = "Vous avez envoyé 10 cadeaux aujourd'hui. Réessayez demain.",
            ["This item cannot be sent."] = "Cet objet ne peut pas être envoyé.", ["Gift sent: {item}."] = "Cadeau envoyé : {item}.",
            ["sent you a gift. Open it in the Inbox."] = "vous a envoyé un cadeau. Ouvrez-le dans la Boîte.",
            ["{name} sent you a gift: {item}."] = "{name} vous a envoyé un cadeau : {item}.",
            ["This gift is not in your game version yet."] = "Ce cadeau n'existe pas encore dans votre version du jeu.",
            ["You already had it: +{n} Balacoin."] = "Vous l'aviez déjà : +{n} Balacoin.", ["is yours. Equip it in The Casino > Tailor."] = "est à vous. Équipez-le dans Le Casino > Tailleur.",
            ["Balacoin: {n}"] = "Balacoin : {n}", ["No spare cosmetics yet."] = "Pas encore de cosmétique en double.",
            ["Duplicates from Market packs land here."] = "Les doublons des paquets du Marché arrivent ici.",
            ["Costs {n} Balacoin (its refund)"] = "Coûte {n} Balacoin (son remboursement)", ["GIFT"] = "CADEAU", ["Spare cosmetics"] = "Cosmétiques en double", ["Gift"] = "Offrir",
        },
        es = {
            ["Not enough Balacoin."] = "No tienes suficientes Balacoin.", ["You sent 10 gifts today. Try again tomorrow."] = "Has enviado 10 regalos hoy. Vuelve a intentarlo mañana.",
            ["This item cannot be sent."] = "Este objeto no se puede enviar.", ["Gift sent: {item}."] = "Regalo enviado: {item}.",
            ["sent you a gift. Open it in the Inbox."] = "te ha enviado un regalo. Ábrelo en la Bandeja.",
            ["{name} sent you a gift: {item}."] = "{name} te ha enviado un regalo: {item}.",
