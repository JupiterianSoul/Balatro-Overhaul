rule{key = 'remove_suit', category = 'deck', kind = 'cycle', label = "Remove a suit", default = 'none', order = 1,
  options = {{value = 'none', label = "None"}, {value = 'Spades', label = "Spades"}, {value = 'Hearts', label = "Hearts"}, {value = 'Clubs', label = "Clubs"}, {value = 'Diamonds', label = "Diamonds"}},
  late = function(v)
    if v == 'none' then return end
    for i = #(G.playing_cards or {}), 1, -1 do
      local c = G.playing_cards[i]
      if c and c.base and c.base.suit == v then c:remove() end
    end
  end}
rule{key = 'deck_size', category = 'deck', label = "Deck size", info = "Cards are copied or removed to fit", default = 52, min = 1, max = 208, big_step = 13, order = 2,
  late = function(v)
    local cur = #(G.playing_cards or {})
    if v > cur and cur > 0 then
      local fronts = {}
      for _, c in ipairs(G.playing_cards) do fronts[#fronts + 1] = c.config.card end
      for i = 1, v - cur do
        create_playing_card({front = fronts[(i - 1) % #fronts + 1]}, G.deck, true, true)
      end
    elseif v < cur then
      for _ = 1, cur - v do
        local c = G.deck and G.deck.cards[#G.deck.cards]
        if not c then break end
        c:remove()
      end
    end
  end}
rule{key = 'enhancement', category = 'deck', kind = 'cycle', label = "Enhancement", default = 'none', order = 3,
  options = {{value = 'none', label = "None"}, {value = 'random', label = "Random"}, {value = 'm_bonus', label = "Bonus"}, {value = 'm_mult', label = "Mult"},
    {value = 'm_wild', label = "Wild"}, {value = 'm_glass', label = "Glass"}, {value = 'm_steel', label = "Steel"}, {value = 'm_stone', label = "Stone"},
    {value = 'm_gold', label = "Gold"}, {value = 'm_lucky', label = "Lucky"}},
  late = function(v)
    if v == 'none' then return end
    each_card(function(c)
      local k = v == 'random' and pick(ENH, 'rr_enh') or v
      if G.P_CENTERS[k] then c:set_ability(G.P_CENTERS[k]) end
    end)
  end}
rule{key = 'edition', category = 'deck', kind = 'cycle', label = "Edition", default = 'none', order = 4,
  options = {{value = 'none', label = "None"}, {value = 'random', label = "Random"}, {value = 'foil', label = "Foil"}, {value = 'holo', label = "Holographic"}, {value = 'polychrome', label = "Polychrome"}},
  late = function(v)
    if v == 'none' then return end
    each_card(function(c)
      local k = v
      if v == 'random' then k = pick({'none', 'foil', 'holo', 'polychrome'}, 'rr_ed') end
      if k ~= 'none' then c:set_edition({[k] = true}, true, true) end
    end)
  end}
rule{key = 'seal', category = 'deck', kind = 'cycle', label = "Seal", default = 'none', order = 5,
  options = {{value = 'none', label = "None"}, {value = 'random', label = "Random"}, {value = 'Red', label = "Red"}, {value = 'Blue', label = "Blue"}, {value = 'Gold', label = "Gold"}, {value = 'Purple', label = "Purple"}},
  late = function(v)
    if v == 'none' then return end
    each_card(function(c) c:set_seal(v == 'random' and pick(SEALS, 'rr_seal') or v, true, true) end)
  end}

