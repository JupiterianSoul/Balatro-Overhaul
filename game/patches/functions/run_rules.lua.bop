function R.rows(values, category, opts)
  opts = opts or {}
  local rows = {}
  local function changed(key, v)
    if opts.on_change then opts.on_change(key, v) end
  end
  for _, d in ipairs(R.list(category)) do
    if d.kind ~= 'list' and not (opts.skip and opts.skip[d.key]) then
      local base = {label = L(d.label), info = d.info and L(d.info) or nil, disabled = opts.disabled, id = 'rr_' .. d.key, w = opts.w}
      if d.kind == 'toggle' then
        base.ref_table = values
        base.ref_value = d.key
        base.callback = function(v) changed(d.key, v) end
        rows[#rows + 1] = UIK.toggle(base)
      elseif d.kind == 'stepper' then
        base.ref_table = values
        base.ref_value = d.key
        base.min, base.max, base.step, base.big_step, base.format = d.min, d.max, d.step or 1, d.big_step, d.format
        base.callback = function(v) changed(d.key, v) end
        rows[#rows + 1] = UIK.stepper(base)
      elseif d.kind == 'slider' then
        base.ref_table = values
        base.ref_value = d.key
        base.min, base.max = d.min, d.max
        base.callback = function(v)
          R._slider_token = (R._slider_token or 0) + 1
          local tok = R._slider_token
          G.E_MANAGER:add_event(Event({trigger = 'after', delay = 0.4, timer = 'REAL', blockable = false, blocking = false, func = function()
            if tok == R._slider_token then changed(d.key, values[d.key]) end
            return true
          end}))
        end
        rows[#rows + 1] = UIK.slider(base)
      elseif d.kind == 'cycle' then
        local o = opts_of(d)
        local labels, cur = {}, 1
        for i, x in ipairs(o) do
          labels[i] = x.raw and x.label or L(x.label)
          if x.value == values[d.key] then cur = i end
        end
        base.options = labels
        base.current = cur
        base.callback = function(i)
          if o[i] then
            values[d.key] = o[i].value
            changed(d.key, o[i].value)
          end
        end
        rows[#rows + 1] = UIK.cycle(base)
      end
    end
  end
  return rows
end

