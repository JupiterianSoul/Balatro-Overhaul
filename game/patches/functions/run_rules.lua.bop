RunRules = RunRules or {}
local R = RunRules

R.CATEGORIES = {
  {key = 'basics',  label = "Basics"},
  {key = 'economy', label = "Economy"},
  {key = 'blinds',  label = "Blinds"},
  {key = 'shop',    label = "Shop"},
  {key = 'deck',    label = "Deck"},
  {key = 'items',   label = "Items"},
  {key = 'bans',    label = "Bans"},
  {key = 'fun',     label = "Fun"},
}

R.registry = {}
R.by_key = {}

local function rule(def)
  def.kind = def.kind or 'stepper'
  R.registry[#R.registry + 1] = def
  R.by_key[def.key] = def
  return def
end

local function L(s) return mod_loc and mod_loc(s) or s end
local function fmt_money(v) return "$" .. tostring(v) end
local function fmt_pct(v) return tostring(v) .. "%" end
local function fmt_x(v) return "x" .. tostring(v) end

local function sp_shift(key, v, def, lo)
  local sp = G.GAME.starting_params
  sp[key] = math.max(lo or 0, (sp[key] or def) + (v - def))
end

local function bans_for(list, extra)
  G.GAME.banned_keys = G.GAME.banned_keys or {}
  for _, k in ipairs(list or {}) do
    if type(k) == 'string' then G.GAME.banned_keys[k] = true end
  end
  if extra then extra() end
end

local function ban_pack_kind(kind)
  if not (G.P_CENTER_POOLS and G.P_CENTER_POOLS.Booster) then return end
  G.GAME.banned_keys = G.GAME.banned_keys or {}
  for _, v in ipairs(G.P_CENTER_POOLS.Booster) do
    if v.kind == kind then G.GAME.banned_keys[v.key] = true end
  end
end

local function emplace_new(set, area, key, seed)
  if not area or #area.cards >= area.config.card_limit then return nil end
  local was = key and G.GAME.banned_keys[key]
  if key then G.GAME.banned_keys[key] = nil end
  local card = create_card(set, area, nil, nil, nil, nil, key, seed)
  if was then G.GAME.banned_keys[key] = true end
  if card then
    card:add_to_deck()
    area:emplace(card)
  end
  return card
end

local function each_card(fn)
  for _, c in ipairs(G.playing_cards or {}) do fn(c) end
end

local function pick(list, seed)
  return pseudorandom_element(list, pseudoseed(seed))
end

local ENH = {'m_bonus', 'm_mult', 'm_wild', 'm_glass', 'm_steel', 'm_stone', 'm_gold', 'm_lucky'}
local SEALS = {'Red', 'Blue', 'Gold', 'Purple'}

local function back_options()
  local out = {}
  for _, v in ipairs((G.P_CENTER_POOLS and G.P_CENTER_POOLS.Back) or {}) do
    if not v.omit then
      out[#out + 1] = {value = v.key, label = v.name or v.key, raw = true}
    end
  end
  if #out == 0 then out[1] = {value = 'b_red', label = "Red Deck", raw = true} end
  return out
end

local function stake_options()
  local out = {}
  for i, v in ipairs((G.P_CENTER_POOLS and G.P_CENTER_POOLS.Stake) or {}) do
    if i > 8 then break end
    out[#out + 1] = {value = i, label = v.name or ("Stake " .. i), raw = true}
  end
  if #out == 0 then out[1] = {value = 1, label = "White Stake", raw = true} end
  return out
end

