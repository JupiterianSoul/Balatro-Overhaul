local function copy(v)
  if type(v) ~= 'table' then return v end
  local t = {}
  for i, x in ipairs(v) do t[i] = x end
  return t
end

local function opts_of(def)
  local o = def.options
  if type(o) == 'function' then o = o() end
  return o or {}
end

local function valid(def, v)
  if def.kind == 'toggle' then return type(v) == 'boolean' end
  if def.kind == 'list' then return type(v) == 'table' end
  if def.kind == 'stepper' or def.kind == 'slider' then return type(v) == 'number' end
  if def.kind == 'cycle' then
    if type(def.options) == 'function' then return v ~= nil end
    for _, o in ipairs(def.options) do if o.value == v then return true end end
    return false
  end
  return false
end

local function clamp(def, v)
  if def.kind == 'stepper' or def.kind == 'slider' then
    v = math.floor(v + 0.5)
    if def.min then v = math.max(def.min, v) end
    if def.max then v = math.min(def.max, v) end
  end
  return v
end

function R.list(category)
  if not category then return R.registry end
  local out = {}
  for _, d in ipairs(R.registry) do if d.category == category then out[#out + 1] = d end end
  return out
end

function R.defaults()
  local t = {}
  for _, d in ipairs(R.registry) do t[d.key] = copy(d.default) end
  return t
end

function R.normalize(values)
  local t = R.defaults()
  for k, v in pairs(values or {}) do
    local d = R.by_key[k]
    if d and valid(d, v) then t[k] = clamp(d, copy(v)) end
  end
  return t
end

local function same(d, v)
  if d.kind == 'list' then return #v == 0 end
  return v == d.default
end

function R.diff(values)
  local t = {}
  for _, d in ipairs(R.registry) do
    local v = values and values[d.key]
    if v ~= nil and valid(d, v) and not same(d, v) then t[d.key] = copy(v) end
  end
  return t
end

function R.value_label(key, v)
  local d = R.by_key[key]
  if not d then return tostring(v) end
  if d.kind == 'toggle' then return v and L("On") or L("Off") end
  if d.kind == 'list' then return tostring(#v) end
  if d.kind == 'cycle' then
    for _, o in ipairs(opts_of(d)) do
      if o.value == v then return o.raw and o.label or L(o.label) end
    end
    return tostring(v)
  end
  return d.format and d.format(v) or tostring(v)
end

function R.describe(values)
  local lines = {}
  local diff = R.diff(values)
  for _, d in ipairs(R.registry) do
    local v = diff[d.key]
    if v ~= nil then lines[#lines + 1] = L(d.label) .. ": " .. R.value_label(d.key, v) end
  end
  return lines
end

function R.active(key)
  local t = G.GAME and G.GAME.run_rules
  return t and t[key]
end

function R.apply(values)
  if not (G.GAME and G.GAME.starting_params) then return end
  local v = R.normalize(values)
  local diff = R.diff(v)
  G.GAME.run_rules = diff
  G.GAME.modifiers = G.GAME.modifiers or {}
  G.GAME.banned_keys = G.GAME.banned_keys or {}
  if next(diff) and mark_run_as_modded then pcall(mark_run_as_modded, "Custom run") end
  for _, d in ipairs(R.registry) do
    if d.apply and diff[d.key] ~= nil then
      local ok, err = pcall(d.apply, v[d.key])
      if not ok then print("[RUN RULES] apply " .. d.key .. ": " .. tostring(err)) end
    end
  end
  local late = {}
  for _, d in ipairs(R.registry) do
    if d.late and diff[d.key] ~= nil then late[#late + 1] = d end
  end
  table.sort(late, function(a, b) return (a.order or 0) < (b.order or 0) end)
  if #late > 0 then
r 3 617 %20%20%20%20 -
l 101
      for _, d in ipairs(late) do
        local ok, err = pcall(d.late, v[d.key])
        if not ok then print("[RUN RULES] late " .. d.key .. ": " .. tostring(err)) end
      end
      G.GAME.starting_deck_size = #(G.playing_cards or {})
      if G.deck then G.deck:shuffle('rr_shuffle') end
      R.applied_at = G.TIMERS and G.TIMERS.REAL
      return true
    end}))
  else
    R.applied_at = G.TIMERS and G.TIMERS.REAL
  end
  print("[RUN RULES] applied " .. #R.describe(v) .. " rules")
end

function R.arm(values, source)
  R._pending = R.normalize(values)
  R._pending_source = source
end

function R.disarm()
  R._pending = nil
  R._pending_source = nil
end

function R.start(values, args)
  local v = R.normalize(values)
  args = args or {}
  args.stake = args.stake or v.stake
  if not args.back and G.P_CENTERS[v.back] then args.back = G.P_CENTERS[v.back] end
  if args.back then
    if G.GAME.viewed_back then G.GAME.viewed_back:change_to(args.back) else G.GAME.viewed_back = Back(args.back) end
  end
  R.arm(v, args.rules_source)
  G.FUNCS.start_run(nil, args)
end

local _rr_back_apply = Back.apply_to_run
function Back:apply_to_run(...)
  local r = _rr_back_apply(self, ...)
  local p, src = R._pending, R._pending_source
  R.disarm()
  if p and G.GAME and G.GAME.starting_params then
    R.apply(p)
    G.GAME.run_rules_source = src
  end
  return r
end

function R.ensure_plain_blind()
  if not G.P_BLINDS or G.P_BLINDS.bl_rr_plain then return end
  local base = G.P_BLINDS.bl_big or {}
  G.P_BLINDS.bl_rr_plain = {key = 'bl_rr_plain', name = 'Ante Blind', rr_plain = true, dollars = 5, mult = 2, debuff = {}, vars = {},
    atlas = base.atlas, pos = base.pos or {x = 0, y = 1}, discovered = true, order = 1001, boss_colour = G.C and G.C.BLUE}
  pcall(function()
    local entry = {name = L("Ante Blind"), text = {L("No boss effect")}}
    if loc_parse_string then
      entry.text_parsed = {loc_parse_string(entry.text[1])}
      entry.name_parsed = {loc_parse_string(entry.name)}
    end
    G.localization.descriptions.Blind.bl_rr_plain = entry
  end)
end

local _rr_new_boss = get_new_boss
function get_new_boss(...)
  if R.active('no_bosses') then
    R.ensure_plain_blind()
    G.GAME.bosses_used = G.GAME.bosses_used or {}
    G.GAME.bosses_used.bl_rr_plain = (G.GAME.bosses_used.bl_rr_plain or 0) + 1
    return 'bl_rr_plain'
  end
  return _rr_new_boss(...)
end

local _rr_start_run = Game.start_run
function Game:start_run(args, ...)
  local st = args and args.savetext
  local rr = type(st) == 'table' and st.GAME and st.GAME.run_rules
  if rr and rr.no_bosses then R.ensure_plain_blind() end
  return _rr_start_run(self, args, ...)
end

function R.rarity_of(roll)
  local c, u, r = R.active('rarity_common'), R.active('rarity_uncommon'), R.active('rarity_rare')
  if c == nil and u == nil and r == nil then return nil end
  c, u, r = c or 70, u or 25, r or 5
  local total = c + u + r
  if total <= 0 then return nil end
  local x = roll * total
  if x < c then return 1 end
  if x < c + u then return 2 end
  return 3
end

