local BAN_LISTS = {
  {key = 'ban_jokers', label = "Banned jokers", pool = 'Joker'},
  {key = 'ban_tarots', label = "Banned tarots", pool = 'Tarot'},
  {key = 'ban_planets', label = "Banned planets", pool = 'Planet'},
  {key = 'ban_spectrals', label = "Banned spectrals", pool = 'Spectral'},
  {key = 'ban_vouchers', label = "Banned vouchers", pool = 'Voucher'},
  {key = 'ban_boosters', label = "Banned packs", pool = 'Booster'},
  {key = 'ban_tags', label = "Banned tags", pool = 'Tag'},
  {key = 'ban_blinds', label = "Banned bosses", pool = 'Blind'},
}
R.BAN_LISTS = BAN_LISTS
for _, b in ipairs(BAN_LISTS) do
  rule{key = b.key, category = 'bans', kind = 'list', label = b.label, default = {}, pool = b.pool, ban = true,
    apply = function(v)
      local list = v
      if b.pool == 'Booster' and G.P_CENTER_POOLS.Booster and #v >= #G.P_CENTER_POOLS.Booster then
        list = {}
        for i = 1, #v - 1 do list[i] = v[i] end
      end
      bans_for(list)
    end}
end

