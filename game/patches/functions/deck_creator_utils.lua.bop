function DeckCreatorUtils.fullDeckConversionFunctions(arg)
    if not G then return end
    if not G.playing_cards then return end
    if not G.E_MANAGER then return end

    local conversionMap = {
        all_polychrome = function(card)
            card:set_edition({polychrome = true}, true, true)
        end,
        all_holo = function(card)
            card:set_edition({holo = true}, true, true)
        end,
        all_foil = function(card)
            card:set_edition({foil = true}, true, true)
        end,
        all_bonus = function(card)
            card:set_ability(G.P_CENTERS.m_bonus)
        end,
        all_mult = function(card)
            card:set_ability(G.P_CENTERS.m_mult)
        end,
        all_wild = function(card)
            card:set_ability(G.P_CENTERS.m_wild)
        end,
        all_glass = function(card)
            card:set_ability(G.P_CENTERS.m_glass)
        end,
        all_steel = function(card)
            card:set_ability(G.P_CENTERS.m_steel)
        end,
        all_stone = function(card)
            card:set_ability(G.P_CENTERS.m_stone)
        end,
        all_gold = function(card)
            card:set_ability(G.P_CENTERS.m_gold)
        end,
        all_lucky = function(card)
            card:set_ability(G.P_CENTERS.m_lucky)
        end,
    }

    local convFunc = conversionMap[arg]
    if not convFunc then return end

r 1 112 %20%20%20%20 -
l 45
        func = function()
            for _, card in ipairs(G.playing_cards) do
                pcall(function()
                    convFunc(card)
                end)
            end
            return true
        end
    }))
end

function DeckCreatorUtils.configureEmptyBlind()
    if not G then return end
    if not G.P_BLINDS then return end

    if not G.P_BLINDS.bl_empty then
        G.P_BLINDS.bl_empty = {
            name = "Empty",
            defeated = false,
            order = 0,
            dollars = 0,
            mult = 0,
            vars = {},
            debuff = {},
            pos = {x=0,y=0},
            boss = {min = 99, max = 99},
            boss_colour = HEX("888888"),
            set = "Blind"
        }
        if G.localization and G.localization.descriptions and G.localization.descriptions.Blind then
            G.localization.descriptions.Blind.bl_empty = {
                name = "Empty",
                text = {"No effect"}
            }
        end
    end
end

