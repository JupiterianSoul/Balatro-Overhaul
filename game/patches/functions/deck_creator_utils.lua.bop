function DeckCreatorUtils.log(msg)
    print("[DeckCreator] " .. tostring(msg))
end

function DeckCreatorUtils.addDeckToList(deck)
    if deck == nil then return end
    DeckCreatorUtils.customDeckList[#DeckCreatorUtils.customDeckList + 1] = deck
end

function DeckCreatorUtils.getCurrentEditingDeck()
    return DeckCreatorUtils.EditDeckConfig
end

