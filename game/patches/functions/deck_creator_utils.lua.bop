function DeckCreatorUtils.vouchers(includeLevelTwo)
    local list = {
        { id = "v_overstock_norm", name = "Overstock", pos = {x=0,y=0} },
        { id = "v_clearance_sale", name = "Clearance Sale", pos = {x=1,y=0} },
        { id = "v_hone", name = "Hone", pos = {x=2,y=0} },
        { id = "v_reroll_surplus", name = "Reroll Surplus", pos = {x=3,y=0} },
        { id = "v_crystal_ball", name = "Crystal Ball", pos = {x=4,y=0} },
        { id = "v_telescope", name = "Telescope", pos = {x=5,y=0} },
        { id = "v_grabber", name = "Grabber", pos = {x=6,y=0} },
        { id = "v_wasteful", name = "Wasteful", pos = {x=7,y=0} },
        { id = "v_seed_money", name = "Seed Money", pos = {x=8,y=0} },
        { id = "v_blank", name = "Blank", pos = {x=9,y=0} },
        { id = "v_magic_trick", name = "Magic Trick", pos = {x=0,y=1} },
        { id = "v_hieroglyph", name = "Hieroglyph", pos = {x=1,y=1} },
        { id = "v_directors_cut", name = "Director's Cut", pos = {x=2,y=1} },
        { id = "v_paint_brush", name = "Paint Brush", pos = {x=3,y=1} },
        { id = "v_tarot_merchant", name = "Tarot Merchant", pos = {x=4,y=1} },
        { id = "v_planet_merchant", name = "Planet Merchant", pos = {x=5,y=1} },
    }
    if includeLevelTwo then
        local level2 = {
            { id = "v_overstock_plus", name = "Overstock Plus", pos = {x=0,y=2} },
            { id = "v_liquidation", name = "Liquidation", pos = {x=1,y=2} },
            { id = "v_glow_up", name = "Glow Up", pos = {x=2,y=2} },
            { id = "v_reroll_glut", name = "Reroll Glut", pos = {x=3,y=2} },
            { id = "v_omen_globe", name = "Omen Globe", pos = {x=4,y=2} },
            { id = "v_observatory", name = "Observatory", pos = {x=5,y=2} },
            { id = "v_nacho_tong", name = "Nacho Tong", pos = {x=6,y=2} },
            { id = "v_recyclomancy", name = "Recyclomancy", pos = {x=7,y=2} },
            { id = "v_money_tree", name = "Money Tree", pos = {x=8,y=2} },
            { id = "v_antimatter", name = "Antimatter", pos = {x=9,y=2} },
            { id = "v_illusion", name = "Illusion", pos = {x=0,y=3} },
            { id = "v_petroglyph", name = "Petroglyph", pos = {x=1,y=3} },
            { id = "v_retcon", name = "Retcon", pos = {x=2,y=3} },
            { id = "v_palette", name = "Palette", pos = {x=3,y=3} },
            { id = "v_tarot_tycoon", name = "Tarot Tycoon", pos = {x=4,y=3} },
            { id = "v_planet_tycoon", name = "Planet Tycoon", pos = {x=5,y=3} },
        }
        for _, v in ipairs(level2) do
            list[#list + 1] = v
        end
    end
    return list
end

function DeckCreatorUtils.uuid()
    local random = math.random
    local template ='xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'
    return string.gsub(template, '[xy]', function (c)
        local v = (c == 'x') and random(0, 0xf) or random(8, 0xb)
        return string.format('%x', v)
    end)
end

