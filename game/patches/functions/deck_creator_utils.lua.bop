function DeckCreatorUtils.allDeckNames()
    if not G or not G.P_CENTER_POOLS or not G.P_CENTER_POOLS.Back then
        return {}
    end
    local names = {}
    for _, v in ipairs(G.P_CENTER_POOLS.Back) do
        names[#names + 1] = v.name
    end
    return names
end
