        elseif type(v) == "table" then
            toprint = toprint .. DeckCreatorUtils.tableToString(v, indent) .. ",\n"
        elseif type(v) == "boolean" then
            toprint = toprint .. tostring(v) .. ",\n"
        else
            toprint = toprint .. "\"" .. tostring(v) .. "\",\n"
        end
    end
    toprint = toprint .. string.rep(" ", indent - 2) .. "}"
    return toprint
end

