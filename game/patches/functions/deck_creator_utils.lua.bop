function DeckCreatorUtils.generateIntegerList()
    local list = {}
    for i = 0, 100 do
        list[#list + 1] = tostring(i)
    end
    return list
end

function DeckCreatorUtils.generateBigIntegerList()
    local list = {}
    for i = 0, 500 do
        list[#list + 1] = tostring(i)
    end
    return list
end

function DeckCreatorUtils.generateBoundedIntegerList(min, max)
    local list = {}
    for i = min, max do
        list[#list + 1] = tostring(i)
    end
    return list
end

function DeckCreatorUtils.generateBoundedFloatList(min, max, step)
    local list = {}
    local i = min
    while i <= max + 0.001 do
        list[#list + 1] = string.format("%.1f", i)
        i = i + step
    end
    return list
end

function DeckCreatorUtils.generateBoundedIntegerListWithNoneOption(min, max)
    local list = {"--"}
    for i = min, max do
        list[#list + 1] = tostring(i)
    end
    return list
end

