MY_HIGHP_OR_MEDIUMP float ts_hash(vec2 p)
{
    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

MY_HIGHP_OR_MEDIUMP float ts_lum(vec3 c)
{
    return dot(c, vec3(0.299, 0.587, 0.114));
}

vec3 ts_gold(MY_HIGHP_OR_MEDIUMP float l)
{
    vec3 c = mix(vec3(0.30, 0.16, 0.04), vec3(0.96, 0.70, 0.18), smoothstep(0.0, 0.65, l));
    return mix(c, vec3(1.0, 0.96, 0.78), smoothstep(0.65, 1.0, l));
}

vec4 ts_cell(Image texture, vec2 texture_coords, vec2 d)
{
    vec2 lo = texture_details.xy * texture_details.ba / image_details;
    vec2 hi = lo + texture_details.ba / image_details;
    vec2 px = 1.0 / image_details;
    vec2 tc = clamp(texture_coords + d * texture_details.ba / image_details, lo + px, hi - px);
    return Texel(texture, tc);
}

