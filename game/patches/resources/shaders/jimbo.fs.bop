#define HP MY_HIGHP_OR_MEDIUMP

HP float field_of(HP vec2 uv, HP float scale, HP float t)
{
    HP vec2 floored_uv = (floor((uv*texture_details.ba)))/texture_details.ba;
    HP vec2 c = (floored_uv - 0.5) * scale;
    HP vec2 f1 = c + 50.*vec2(sin(-t / 143.6340), cos(-t / 99.4324));
    HP vec2 f2 = c + 50.*vec2(cos( t / 53.1532),  cos( t / 61.4532));
    HP vec2 f3 = c + 50.*vec2(sin(-t / 87.53218), sin(-t / 49.0000));
    return (1.+ (cos(length(f1) / 19.483) + sin(length(f2) / 33.155) * cos(f2.y / 15.73) +
        cos(length(f3) / 27.193) * sin(f3.x / 21.92) ))/2.;
}

HP vec3 foil_fx(HP vec4 tex, HP vec2 uv)
{
    HP vec2 auv = uv - vec2(0.5, 0.5);
    auv.x = auv.x*texture_details.b/texture_details.a;
    HP float low = min(tex.r, min(tex.g, tex.b));
    HP float high = max(tex.r, max(tex.g, tex.b));
    HP float delta = min(high, max(0.5, 1. - low));
    HP float fac = max(min(2.*sin((length(90.*auv) + jimbo.r*2.) + 3.*(1.+0.8*cos(length(113.1121*auv) - jimbo.r*3.121))) - 1. - max(5.-length(90.*auv), 0.), 1.), 0.);
    HP vec2 rotater = vec2(cos(jimbo.r*0.1221), sin(jimbo.r*0.3512));
    HP float angle = dot(rotater, auv)/(length(rotater)*max(length(auv), 0.0001));
    HP float fac2 = max(min(5.*cos(jimbo.g*0.3 + angle*3.14*(2.2+0.9*sin(jimbo.r*1.65 + 0.2*jimbo.g))) - 4. - max(2.-length(20.*auv), 0.), 1.), 0.);
    HP float fac3 = 0.3*max(min(2.*sin(jimbo.r*5. + uv.x*3. + 3.*(1.+0.5*cos(jimbo.r*7.))) - 1., 1.), -1.);
    HP float fac4 = 0.3*max(min(2.*sin(jimbo.r*6.66 + uv.y*3.8 + 3.*(1.+0.5*cos(jimbo.r*3.414))) - 1., 1.), -1.);
    HP float maxfac = max(max(fac, max(fac2, max(fac3, max(fac4, 0.0)))) + 2.2*(fac+fac2+fac3+fac4), 0.);
    HP vec3 o = vec3(tex.r-delta + delta*maxfac*0.3, tex.g-delta + delta*maxfac*0.3, tex.b + delta*maxfac*1.9);
    HP float a = min(tex.a, 0.3*tex.a + 0.9*min(0.5, maxfac*0.1));
    return mix(tex.rgb, clamp(o, 0., 1.), clamp(a/max(tex.a, 0.001), 0., 1.));
}

HP vec3 holo_fx(HP vec4 tex, HP vec2 uv)
{
    HP vec4 hsl = HSL(0.5*tex + 0.5*vec4(0.,0.,1.,tex.a));
    HP float field = field_of(uv, 250., jimbo.g*7.221 + time);
    HP float res = (.5 + .5* cos( (jimbo.r) * 2.612 + ( field + -.5 ) *3.14));
    HP float low = min(tex.r, min(tex.g, tex.b));
    HP float high = max(tex.r, max(tex.g, tex.b));
    HP float delta = 0.2+0.3*(high- low) + 0.1*high;
    HP float gridsize = 0.79;
    HP float fac = 0.5*max(max(max(0., 7.*abs(cos(uv.x*gridsize*20.))-6.),max(0., 7.*cos(uv.y*gridsize*45. + uv.x*gridsize*20.)-6.)), max(0., 7.*cos(uv.y*gridsize*45. - uv.x*gridsize*20.)-6.));
r 67 124 %20%20%20%20 -
l 1
    hsl.y = hsl.y*1.3;
r 67 126 %20%20%20%20 -
l 49
    return ((1.-delta)*tex + delta*RGB(hsl)*vec4(0.9,0.8,1.2,tex.a)).rgb;
}

HP vec3 poly_fx(HP vec4 tex, HP vec2 uv)
{
    HP float low = min(tex.r, min(tex.g, tex.b));
    HP float high = max(tex.r, max(tex.g, tex.b));
    HP float sat = 1. - max(0., 0.05*(1.1-(high - low)));
    HP vec4 hsl = HSL(vec4(tex.r*sat, tex.g*sat, tex.b, tex.a));
    HP float field = field_of(uv, 50., jimbo.g*2.221 + time);
    HP float res = (.5 + .5* cos( (jimbo.r) * 2.612 + ( field + -.5 ) *3.14));
    hsl.x = hsl.x + res + jimbo.g*0.04;
    hsl.y = min(0.6, hsl.y+0.5);
    return RGB(hsl).rgb;
}

HP vec3 neg_fx(HP vec4 tex, HP vec2 uv)
{
    HP vec4 s = HSL(tex);
    s.b = 1. - s.b;
    s.r = -s.r + 0.2;
    HP vec3 base = (RGB(s) + 0.8*vec4(79./255., 99./255., 103./255., 0.)).rgb;
    HP float low = min(tex.r, min(tex.g, tex.b));
    HP float high = max(tex.r, max(tex.g, tex.b));
    HP float delta = high-low -0.1;
    HP float t = jimbo.r;
    HP float fac = 0.8 + 0.9*sin(11.*uv.x+4.32*uv.y + t*12. + cos(t*5.3 + uv.y*4.2 - uv.x*4.));
    HP float fac2 = 0.5 + 0.5*sin(8.*uv.x+2.32*uv.y + t*5. - cos(t*2.3 + uv.x*8.2));
    HP float fac3 = 0.5 + 0.5*sin(10.*uv.x+5.32*uv.y + t*6.111 + sin(t*5.3 + uv.y*3.2));
    HP float fac4 = 0.5 + 0.5*sin(3.*uv.x+2.32*uv.y + t*8.111 + sin(t*1.3 + uv.y*11.2));
    HP float fac5 = sin(0.9*16.*uv.x+5.32*uv.y + t*12. + cos(t*5.3 + uv.y*4.2 - uv.x*4.));
    HP float maxfac = 0.7*max(max(fac, max(fac2, max(fac3,0.0))) + (fac+fac2+fac3*fac4), 0.);
    HP vec3 sh = tex.rgb*0.5 + vec3(0.4, 0.4, 0.8);
    sh.r = sh.r-delta + delta*maxfac*(0.7 + fac5*0.27) - 0.1;
    sh.g = sh.g-delta + delta*maxfac*(0.7 - fac5*0.27) - 0.1;
    sh.b = sh.b-delta + delta*maxfac*0.7 - 0.1;
    HP float a = 0.5*max(min(1., max(0.,0.3*max(low*0.2, delta)+ min(max(maxfac*0.1,0.), 0.4)) ), 0.) + 0.15*maxfac*(0.1+delta);
    return mix(clamp(base, 0., 1.), clamp(sh, 0., 1.), clamp(a, 0., 1.));
}

HP vec3 edition(HP float k, HP vec4 tex, HP vec2 uv)
{
    if (k < 0.5) return tex.rgb;
    if (k < 1.5) return foil_fx(tex, uv);
    if (k < 2.5) return holo_fx(tex, uv);
    if (k < 3.5) return poly_fx(tex, uv);
    return neg_fx(tex, uv);
}

