{
    HP vec4 tex = Texel(texture, texture_coords);
    HP vec2 uv = (((texture_coords)*(image_details)) - texture_details.xy*texture_details.ba)/texture_details.ba;
    HP float s = jimbo.g / 2.;
    HP float cur = mod(floor(s), 5.);
    HP float nxt = mod(cur + 1., 5.);
    HP float f = smoothstep(0., 1., fract(s));
    HP vec3 c = mix(edition(cur, tex, uv), edition(nxt, tex, uv), f);
    return dissolve_mask(vec4(c, tex.a)*colour, texture_coords, uv);
}

