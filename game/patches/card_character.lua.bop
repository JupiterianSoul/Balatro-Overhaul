local function scale_def(node, s)
    local c = node.config
    if c then
        for _, k in ipairs({'scale', 'minw', 'minh', 'maxw', 'padding'}) do
            if c[k] then c[k] = c[k]*s end
        end
    end
    for _, n in ipairs(node.nodes or {}) do scale_def(n, s) end
    return node
end

