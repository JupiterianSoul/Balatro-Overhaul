local function money_cap()
    local cap = mods().mp_money_cap
    if not cap or not G.GAME then return end
    local max = cap + (G.GAME.interest_cap or 25)
    if (G.GAME.dollars or 0) > max then
        G.GAME.dollars = max
        if not D.cap_flash then
            D.cap_flash = true
            pcall(function()
                attention_text({
                    text = L('MAX'), scale = 0.8, hold = 0.7, cover = G.HUD and G.HUD:get_UIE_by_ID('dollar_text_UI') and G.HUD:get_UIE_by_ID('dollar_text_UI').parent,
                    cover_colour = G.C.RED, align = 'cm',
                })
                play_sound('timpani', 0.9, 0.7)
            end)
        end
    else
        D.cap_flash = nil
    end
end

local function install_hooks()
    if D.hooked then return end
    D.hooked = true

    if Game and Game.set_render_settings then
        local orig_render = Game.set_render_settings
        Game.set_render_settings = function(self, ...)
            local r = orig_render(self, ...)
            pcall(D.register_art)
            return r
        end
    end

    local orig_apply = Back.apply_to_run
    Back.apply_to_run = function(self, ...)
        local r = orig_apply(self, ...)
        local center = self and self.effect and self.effect.center
        local d = center and center.mp_deck and DEFS[center.key]
        if d and G.GAME then
            G.GAME.modifiers = G.GAME.modifiers or {}
            for k, v in pairs(d.mods or {}) do G.GAME.modifiers[k] = v end
            G.GAME.mp_deck = center.key
        end
        return r
    end

    local orig_set_cost = Card.set_cost
    ---@diagnostic disable-next-line: duplicate-set-field
    Card.set_cost = function(self)
        local r = orig_set_cost(self)
        if self and self.ability and G.GAME and G.GAME.modifiers then
            if G.GAME.modifiers.mp_lilac then pcall(lilac_discount, self) end
            if G.GAME.modifiers.mp_cobalt and self.ability.set == 'Booster' and (self.cost or 0) > 0 then
                self.cost = self.cost + 2
            end
        end
        return r
    end

    local orig_open = Card.open
    ---@diagnostic disable-next-line: duplicate-set-field
    Card.open = function(self, ...)
        local r = orig_open(self, ...)
        if mods().mp_cobalt and self and self.ability and self.ability.set == 'Booster' and G.GAME.pack_choices then
            G.GAME.pack_choices = G.GAME.pack_choices + 1
        end
        return r
    end

    if G and G.FUNCS and G.FUNCS.toggle_shop then
        local orig_toggle = G.FUNCS.toggle_shop
