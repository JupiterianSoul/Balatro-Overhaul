local function hls(r, g, b)
    local mx, mn = math.max(r, g, b), math.min(r, g, b)
    local l = (mx + mn) / 2
    if mx == mn then return 0, l, 0 end
    local d = mx - mn
    local s = l > 0.5 and d / (2 - mx - mn) or d / (mx + mn)
    local h
    if mx == r then h = (g - b) / d + (g < b and 6 or 0)
    elseif mx == g then h = (b - r) / d + 2
    else h = (r - g) / d + 4 end
    return h / 6, l, s
end

local function hue2(p, q, t)
    if t < 0 then t = t + 1 end
    if t > 1 then t = t - 1 end
    if t < 1 / 6 then return p + (q - p) * 6 * t end
    if t < 1 / 2 then return q end
    if t < 2 / 3 then return p + (q - p) * (2 / 3 - t) * 6 end
    return p
end

local function rgb(h, l, s)
    if s == 0 then return l, l, l end
    local q = l < 0.5 and l * (1 + s) or l + s - l * s
    local p = 2 * l - q
    return hue2(p, q, h + 1 / 3), hue2(p, q, h), hue2(p, q, h - 1 / 3)
end

D.hls, D.rgb = hls, rgb

local function is_gold(h, s)
    return s > 0.35 and h > 25 / 360 and h < 65 / 360
end

D.ART = {
    gemini = { src = { 3, 4 }, left = 196 / 360, right = 338 / 360, sat = 0.55 },
    random = { src = { 2, 3 }, mark = { 6, 3 }, hues = { 0, 0.22, 0.5, 0.75 }, mark_hue = 42 / 360, plate = { 0.16, 0.13, 0.2 } },
    lilac = { src = { 0, 0 }, stops = { { 0.36, 0.24, 0.56 }, { 0.7, 0.56, 0.94 }, { 1, 0.86, 0.5 } } },
    seer = { src = { 3, 0 }, stops = { { 0.09, 0.05, 0.2 }, { 0.42, 0.2, 0.62 }, { 0.98, 0.72, 0.95 } }, keep_gold = true },
    tangerine = { src = { 1, 3 }, stops = { { 0.1, 0.22, 0.26 }, { 1, 0.55, 0.16 }, { 1, 0.93, 0.78 } } },
    cobalt = { src = { 0, 4 }, stops = { { 0.04, 0.1, 0.32 }, { 0.12, 0.36, 0.82 }, { 0.62, 0.88, 1 } } },
}
D.ART_ORDER = { 'gemini', 'random', 'lilac', 'seer', 'tangerine', 'cobalt' }

local function build_gemini(out, src, ox, cw, ch, s)
    local a = D.ART.gemini
    local sx, sy = a.src[1] * cw, a.src[2] * ch
    for y = 0, ch - 1 do
        for x = 0, cw - 1 do
            local r, g, b, al = src:getPixel(sx + x, sy + y)
            if al > 0 then
                local h, l, sat = hls(r, g, b)
                if not is_gold(h, sat) then
                    local th = (x < cw / 2) and a.left or a.right
                    r, g, b = rgb(th, l, math.max(sat, a.sat * math.min(1, l * 3)))
                end
            end
            out:setPixel(ox + x, y, r, g, b, al)
        end
    end
end

local function build_random(out, src, ox, cw, ch, s)
    local a = D.ART.random
    local sx, sy = a.src[1] * cw, a.src[2] * ch
    for y = 0, ch - 1 do
        for x = 0, cw - 1 do
            local r, g, b, al = src:getPixel(sx + x, sy + y)
            if al > 0 then
                local h, l, sat = hls(r, g, b)
                if sat > 0.2 then
                    local q = (x < cw / 2 and 1 or 2) + (y < ch / 2 and 0 or 2)
                    r, g, b = rgb((h + a.hues[q]) % 1, l, sat)
                end
            end
            out:setPixel(ox + x, y, r, g, b, al)
        end
    end
    local mx, my = a.mark[1] * cw, a.mark[2] * ch
    local function alpha(x, y)
        if x < 0 or y < 0 or x >= cw or y >= ch then return 0 end
        local _, _, _, al = src:getPixel(mx + x, my + y)
        return al
    end
    local gr, gg, gb = rgb(a.mark_hue, 0.58, 0.95)
    for y = 0, ch - 1 do
        local x0, x1
        for x = 0, cw - 1 do
            if alpha(x, y) > 0.2 then
                x0 = x0 or x
                x1 = x
            end
        end
        if x0 then
            for x = x0, x1 do
                local r, g, b = src:getPixel(mx + x, my + y)
                local glyph = r > 0.99 and g > 0.99 and b > 0.99
                if glyph or x == x0 or x == x1 or alpha(x, y - 1) <= 0.2 or alpha(x, y + 1) <= 0.2 then
                    out:setPixel(ox + x, y, gr, gg, gb, 1)
                else
                    out:setPixel(ox + x, y, a.plate[1], a.plate[2], a.plate[3], 1)
                end
            end
        end
    end
end

local function ramp(stops, t)
    local n = #stops - 1
    local f = math.max(0, math.min(1, t)) * n
    local i = math.min(n, math.floor(f) + 1)
    local a, b, u = stops[i], stops[i + 1], f - (i - 1)
    return a[1] + (b[1] - a[1]) * u, a[2] + (b[2] - a[2]) * u, a[3] + (b[3] - a[3]) * u
end

local function build_duo(a)
    return function(out, src, ox, cw, ch, s)
        local sx, sy = a.src[1] * cw, a.src[2] * ch
        local lo, hi = 1, 0
        for y = 0, ch - 1 do
            for x = 0, cw - 1 do
                local r, g, b, al = src:getPixel(sx + x, sy + y)
                if al > 0.5 then
                    local _, l = hls(r, g, b)
                    lo, hi = math.min(lo, l), math.max(hi, l)
                end
            end
        end
        local span = math.max(0.01, hi - lo)
        for y = 0, ch - 1 do
            for x = 0, cw - 1 do
                local r, g, b, al = src:getPixel(sx + x, sy + y)
                if al > 0 then
                    local h, l, sat = hls(r, g, b)
                    if not (a.keep_gold and is_gold(h, sat)) then
                        r, g, b = ramp(a.stops, (l - lo) / span)
                    end
                end
                out:setPixel(ox + x, y, r, g, b, al)
            end
        end
    end
end

local BUILDERS = {
    gemini = build_gemini, random = build_random,
    lilac = build_duo(D.ART.lilac), seer = build_duo(D.ART.seer),
    tangerine = build_duo(D.ART.tangerine), cobalt = build_duo(D.ART.cobalt),
}

function D.build_art(scale)
    local s = scale or 1
    local ok, src = pcall(love.image.newImageData, "resources/textures/" .. s .. "x/Enhancers.png")
    if not ok or not src then return nil end
    local cw, ch = 71 * s, 95 * s
    local out = love.image.newImageData(cw * #D.ART_ORDER, ch)
    for i, k in ipairs(D.ART_ORDER) do BUILDERS[k](out, src, (i - 1) * cw, cw, ch, s) end
    src:release()
    return out
end

function D.register_art()
    if not (G and G.ASSET_ATLAS and G.SETTINGS and love and love.graphics) then return end
    local s = (G.SETTINGS.GRAPHICS and G.SETTINGS.GRAPHICS.texture_scaling) or 2
    local ok, data = pcall(D.build_art, s)
    if not ok or not data then
        if mp_log then mp_log.warn('BOM_DECKS', 'deck art failed: %s', tostring(data)) end
        return
    end
    G.ASSET_ATLAS[D.ART_ATLAS] = {
        name = D.ART_ATLAS, image = love.graphics.newImage(data, { mipmaps = true, dpiscale = s }),
        type = 'asset_atli', px = 71, py = 95,
    }
end

local function O() return bom_custom_objects end

local function L(t)
    if mod_loc then
        local ok, r = pcall(mod_loc, t)
        if ok and r then return r end
    end
    return t
end

local function mods()
    return G and G.GAME and G.GAME.modifiers or {}
end

function D.list()
    local out = {}
    if not G or not G.P_CENTERS then return out end
    for _, k in ipairs(D.KEYS) do if G.P_CENTERS[k] then out[#out + 1] = G.P_CENTERS[k] end end
    return out
end

function D.options()
    local out = {}
    for _, c in ipairs(D.list()) do
        if ReleaseFlags and ReleaseFlags.ai_hidden(c) then goto continue end
        local label = c.name
        pcall(function()
            local n = localize { type = 'name_text', set = 'Back', key = c.key }
            if n and n ~= 'ERROR' then label = n end
        end)
        out[#out + 1] = { value = c.name, label = label, raw = true }
        ::continue::
    end
    return out
end

function D.is_mp_deck(name_or_key)
    for _, k in ipairs(D.KEYS) do
        if k == name_or_key or DEFS[k].name == name_or_key then return true end
    end
    return false
end

local function register_centers()
    if not G or not G.P_CENTERS then return end
    for _, k in ipairs(D.KEYS) do
        if not G.P_CENTERS[k] then
            local d = DEFS[k]
            G.P_CENTERS[k] = {
                key = k, name = d.name, stake = 1, unlocked = true, discovered = true, omit = true,
                order = d.order, pos = { x = d.pos.x, y = d.pos.y }, atlas = (G.ASSET_ATLAS and G.ASSET_ATLAS[d.atlas]) and d.atlas or 'mp_decks', set = 'Back',
                config = O() and O().clone_table(d.config) or d.config, mp_deck = true,
            }
        elseif G.P_CENTERS[k].atlas ~= DEFS[k].atlas and G.ASSET_ATLAS and G.ASSET_ATLAS[DEFS[k].atlas] then
            G.P_CENTERS[k].atlas = DEFS[k].atlas
        end
    end
end

local function lilac_discount(card)
    if not mods().mp_lilac or not card.ability or card.ability.set ~= 'Voucher' then return end
    local ante = G.GAME.round_resets and G.GAME.round_resets.ante or 1
    local pct = LILAC_DISCOUNT[ante]
    if pct and (card.cost or 0) > 0 then
        card.cost = math.max(1, math.floor(card.cost * (1 - pct) + 0.5))
    end
end

