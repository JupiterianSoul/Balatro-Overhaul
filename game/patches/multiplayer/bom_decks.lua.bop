        local set = c.ability and c.ability.set
        if set == 'Tarot' or set == 'Planet' then pool[#pool + 1] = c end
    end
    if #pool == 0 then return end
    local src = pseudorandom_element(pool, pseudoseed('mp_gemini'))
    if not src then return end
