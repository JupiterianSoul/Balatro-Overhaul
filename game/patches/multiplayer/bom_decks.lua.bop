end

local function register_loc()
    if mod_loc_register then pcall(mod_loc_register, { fr = { MAX = 'MAX' }, es = { MAX = 'MÁX' } }) end
    if not O() or not O().register_loc then return end
    for _, k in ipairs(D.KEYS) do O().register_loc('Back', k, DEFS[k].loc) end
end

function D.update()
    pcall(money_cap)
end

function D.ensure_registered()
    if G and G.ASSET_ATLAS and not G.ASSET_ATLAS[D.ART_ATLAS] then pcall(D.register_art) end
    register_centers()
end

function D.init()
    if D.initialized then return end
    pcall(D.register_art)
    register_centers()
    register_loc()
    if O() and O().inject_loc then O().inject_loc() end
    local ok, err = pcall(install_hooks)
    if not ok and mp_log then mp_log.warn('BOM_DECKS', 'hook install failed: %s', tostring(err)) end
    D.initialized = true
end

return D
end
