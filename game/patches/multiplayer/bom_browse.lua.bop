local B = {}

local PAGE_SIZE = 5
local ROW_W = 13.8
local PENDING_FILE = "mp_pending_join.txt"
local PENDING_MAX_AGE = 900
local LIST_TIMEOUT = 20

B.state = { status = "idle", rooms = {}, page = 1, rtt = nil, req = 0 }

local function loader()
    return rawget(_G, "MODLOADER")
end

local function text(t, scale, colour, extra)
    local cfg = { text = tostring(t), scale = scale, colour = colour or G.C.UI.TEXT_LIGHT, shadow = true }
    for k, v in pairs(extra or {}) do cfg[k] = v end
    return { n = G.UIT.T, config = cfg }
end

local function clip(s, scale, maxw)
    local W = rawget(_G, "ModWorkshop")
    if W and W.clip then return W.clip(s, scale, maxw) end
    return tostring(s or "")
end

local function port() return UIK.portrait and UIK.portrait() end
B.LAND_K = 1.3
B.PORT_K = 1.15
local function kk() return port() and B.PORT_K or B.LAND_K end

local function ktext(t, scale, colour, extra)
    local e = {}
    for k, v in pairs(extra or {}) do e[k] = v end
    if e.maxw then e.maxw = e.maxw * kk() end
    return text(t, scale * kk(), colour, e)
end

local function row_of(nodes, cfg)
    cfg = cfg or {}
    cfg.align = cfg.align or "cm"
    return { n = G.UIT.R, config = cfg, nodes = nodes }
end

function B.room_title(name)
    local n = type(name) == "string" and name ~= "" and name or "Player"
    local fmt = mod_loc("{name}'s room")
    local s = fmt:gsub("{name}", function() return n end)
    return s
end

function B.mode_name(mode)
    if type(mode) == "string" and mode:sub(1, 6) == "party_" and bom_party then
        return bom_party.kind_name(mode:sub(7))
    end
    if mode == nil or mode == "" or mode == "attrition" then mode = "nemesis" end
    local name = type(mode) == "string" and mode ~= "" and (mode:sub(1, 1):upper() .. mode:sub(2)) or "Rivals"
    pcall(function()
        local GM = package.loaded["multiplayer.bom_gamemodes"]
        local gm = GM and GM.get and GM.get(mode or "nemesis")
        if gm and gm.display_name then name = gm.display_name end
    end)
    return name
end

function B.is_open()
    local o = G.OVERLAY_MENU
    if B.overlay == nil or type(o) ~= "table" then return false end
    if o == B.overlay then return true end
    local c = o.definition and o.definition.config
    if c and c.uik_id == "mp_browse" then
        B.overlay = o
        return true
    end
    return false
end

function B.close_state()
    B.overlay = nil
end

local function show_overlay(definition)
