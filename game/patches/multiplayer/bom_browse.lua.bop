end

local function mod_source(entry)
    local s = tostring(entry.repo or entry.url or "")
    s = s:gsub("^https?://", ""):gsub("^www%.", ""):gsub("%.git$", ""):gsub("/+$", "")
    return s
end

function B.review_mods(info)
    local W = rawget(_G, "ModWorkshop")
    local rows, blocked = {}, false
    local miss = {}
    for _, m in ipairs(B.missing(required_list(info))) do miss[m.id] = true end
    for _, m in ipairs(required_list(info)) do
        local entry
        if W and W.find_by_id and (not W.safe_version or W.safe_version(m.version)) then
            local ok, e = pcall(W.find_by_id, m.id, m.name)
            entry = ok and e or nil
        end
        local row = { id = m.id, name = m.name, version = m.version, entry = entry, missing = miss[m.id] or false }
        if entry then
            row.source = mod_source(entry)
        else
            blocked = true
        end
        rows[#rows + 1] = row
    end
    local F = rawget(_G, "bom_forge")
    local forge_blocked = false
    for _, e in ipairs(forge_list(info)) do
        local st = F and F.state(e) or "missing"
        if st == "too_big" then forge_blocked = true end
        local kb = math.max(1, math.floor((e.size or 0) / 1024 + 0.5))
        local by = mod_loc("Forge mod") .. (e.author ~= "" and ("  " .. string.format(mod_loc("by %s"), e.author)) or "")
        rows[#rows + 1] = { id = e.id, name = e.name, version = "", forge = true, state = st, missing = st ~= "installed",
            entry = st ~= "too_big" and e or nil, source = by .. "  " .. kb .. " KB" }
    end
    info.forge_blocked = forge_blocked
    return rows, blocked or forge_blocked
end

function B.show_mods_required(info)
    B.close_state()
    mods_strings()
    B.info = info
    local to_normal = not host_workshop(info) and bom_core.is_modded() and #forge_list(info) == 0
    G.FUNCS.mp_mods_yes = function()
        if B.info and B.info.blocked then return end
        B.accept(B.info)
    end
    G.FUNCS.mp_mods_no = function() B.decline(B.info) end
    G.FUNCS.mp_mods_page = function(args)
        if not (args and args.cycle_config and B.info) then return end
        B.info.page = args.cycle_config.current_option
        B.show_mods_required(B.info)
    end
    local contents = {}
r 25 176 %20%20%20%20 -
l 267
    if to_normal then
        contents[#contents + 1] = row_of({ text(mod_loc("NORMAL GAME ROOM"), 0.6, G.C.GOLD) }, { padding = 0.1 })
        contents[#contents + 1] = row_of({ text(mod_loc("This room plays the normal game without mods."), 0.4) }, { padding = 0.05 })
        contents[#contents + 1] = row_of({ text(mod_loc("Switch to the normal game and join?"), 0.4) }, { padding = 0.1 })
    else
        local mods
        mods, blocked = B.review_mods(info)
        info.blocked = blocked
        local pages = math.max(1, math.ceil(#mods / MODS_PER_PAGE))
        info.page = math.min(math.max(1, info.page or 1), pages)
        local rows = {}
        local first = (info.page - 1) * MODS_PER_PAGE
        for i = first + 1, math.min(first + MODS_PER_PAGE, #mods) do
            local m = mods[i]
            local state = (not m.entry and mod_loc("Not in the Workshop")) or (m.missing and mod_loc("To download")) or mod_loc("Installed")
            local colour = (not m.entry and G.C.RED) or (m.missing and G.C.ORANGE) or G.C.GREEN
            if m.forge then
                state = (m.state == "too_big" and mod_loc("Too big")) or (m.state == "update" and mod_loc("To update")) or (m.missing and mod_loc("To download")) or mod_loc("Installed")
                colour = (m.state == "too_big" and G.C.RED) or (m.missing and G.C.ORANGE) or G.C.GREEN
            end
            rows[#rows + 1] = row_of({
                { n = G.UIT.C, config = { align = "cl", minw = 4.7, maxw = 4.7 }, nodes = {
                    row_of({ text(clip(m.name, 0.4, 4.6), 0.4, G.C.WHITE) }, { align = "cl", padding = 0.01 }),
                    row_of({
                        (m.version ~= "") and text(clip("v" .. tostring(m.version):gsub("^[vV]", ""), 0.28, 1.5) .. "  ", 0.28, G.C.GOLD) or nil,
                        text(clip(m.source or m.id, 0.28, (m.version ~= "") and 3.0 or 4.6), 0.28, G.C.UI.TEXT_INACTIVE),
                    }, { align = "cl", padding = 0.01 }),
                } },
                { n = G.UIT.C, config = { align = "cr", minw = 2.1, maxw = 2.1 }, nodes = { text(state, 0.32, colour, { maxw = 2.1 }) } },
            }, { padding = 0.04 })
        end
        contents[#contents + 1] = row_of({ text(mod_loc("MODS REQUIRED"), 0.6, G.C.GOLD) }, { padding = 0.1 })
        contents[#contents + 1] = row_of({ text(mod_loc(#mods == 0 and "This room plays without your Forge mods." or "This room plays with these mods:"), 0.4) }, { padding = 0.05 })
        contents[#contents + 1] = row_of({
            { n = G.UIT.C, config = { align = "tm", r = 0.1, colour = G.C.BLACK, emboss = 0.05, padding = 0.15, minw = 7.2, minh = MODS_PER_PAGE * 0.78 }, nodes = rows },
        }, { padding = 0.08 })
        if pages > 1 then
            local opts = {}
            for i = 1, pages do opts[i] = localize('k_page') .. ' ' .. i .. '/' .. pages end
            contents[#contents + 1] = row_of({ create_option_cycle({ options = opts, w = 3.5, h = 0.35, scale = 0.8, cycle_shoulders = true,
                opt_callback = 'mp_mods_page', current_option = info.page, colour = G.C.RED, no_pips = true }) }, { padding = 0.03 })
        end
        if blocked then
            local why = info.forge_blocked and "A Forge mod is too big to share." or "Only Workshop mods can be used online."
            contents[#contents + 1] = row_of({ text(mod_loc(why), 0.36, G.C.RED, { maxw = 7.2 }) }, { padding = 0.04 })
            contents[#contents + 1] = row_of({ text(mod_loc("You can't join this room."), 0.4) }, { padding = 0.08 })
        else
            if info.missing and #info.missing > 0 then
                contents[#contents + 1] = row_of({ text(mod_loc("Install them from the Mods menu first."), 0.36, G.C.RED, { maxw = 7.2 }) }, { padding = 0.04 })
            end
            if #required_list(info) > 0 then
                contents[#contents + 1] = row_of({ text(mod_loc("Missing mods are downloaded from the Mods Workshop."), 0.32, G.C.UI.TEXT_LIGHT, { maxw = 7.2 }) }, { padding = 0.02 })
            end
            if #forge_list(info) > 0 then
                contents[#contents + 1] = row_of({ text(mod_loc("Forge mods are sent by the host."), 0.32, G.C.UI.TEXT_LIGHT, { maxw = 7.2 }) }, { padding = 0.02 })
            end
            if #mods > 0 then
                contents[#contents + 1] = row_of({ text(mod_loc("Your other mods are turned off for this room."), 0.32, G.C.UI.TEXT_LIGHT, { maxw = 7.2 }) }, { padding = 0.02 })
            end
            contents[#contents + 1] = row_of({ text(mod_loc(#mods == 0 and "Turn them off and join?" or "Install them and join?"), 0.4) }, { padding = 0.08 })
        end
    end
    if blocked then
        contents[#contents + 1] = row_of({
            UIBox_button({ button = "mp_mods_no", label = { mod_loc("BACK") }, colour = G.C.RED, minw = 2.6, minh = 0.75, scale = 0.45, col = true, focus_args = { snap_to = true } }),
        }, { padding = 0.1 })
    else
        contents[#contents + 1] = row_of({
            UIBox_button({ button = "mp_mods_no", label = { mod_loc("NO") }, colour = G.C.RED, minw = 2.6, minh = 0.75, scale = 0.45, col = true, focus_args = { snap_to = true } }),
            gap(0.3),
            UIBox_button({ button = "mp_mods_yes", label = { mod_loc("YES") }, colour = G.C.GREEN, minw = 2.6, minh = 0.75, scale = 0.45, col = true }),
        }, { padding = 0.1 })
    end
    show_overlay(create_UIBox_generic_options({ back_func = "mp_mods_no", no_back = true, contents = contents }))
    B.mods_overlay = G.OVERLAY_MENU
end

function B.decline(info)
    B.mods_overlay = nil
    if info and info.from_browse then return B.show() end
    if bom_match and bom_match.get_phase() == bom_match.PHASE.NONE then pcall(function() bom_core.disconnect() end) end
    G.FUNCS.open_multiplayer_menu()
end

function B.enable_exact(need)
    local L = loader()
    if not (L and L.status and L.set_enabled) then return end
    local want = {}
    for _, m in ipairs(need) do want[m.id] = true end
    local st = L.status()
    for _, e in ipairs(st and st.mods or {}) do
        local on = (e.id and want[e.id]) or (e.folder and want[e.folder]) or false
        if (e.enabled and true or false) ~= on then pcall(L.set_enabled, e.folder, on) end
    end
end

function B.missing(need)
    local L = loader()
    local have = {}
    local st = L and L.status and L.status()
    local W = rawget(_G, "ModWorkshop")
    for _, e in ipairs(st and st.mods or {}) do
        if not e.refused and W and W.from_workshop and W.from_workshop(e.folder) then
            if e.id then have[e.id] = tostring(e.version or "") end
            if e.folder and not have[e.folder] then have[e.folder] = tostring(e.version or "") end
        end
    end
    local miss = {}
    for _, m in ipairs(need) do
        local v = have[m.id]
        if v == nil or (m.version ~= "" and v ~= m.version) then miss[#miss + 1] = m end
    end
    return miss
end

function B.write_pending(info)
    pcall(function()
        love.filesystem.write(PENDING_FILE, bom_core.json.encode({
            id = info.id, code = info.code, private = info.private and true or false, at = os.time(),
        }))
    end)
end

local function show_installing()
    show_overlay(create_UIBox_generic_options({ no_back = true, contents = {
        row_of({ text(mod_loc("INSTALLING MODS"), 0.6, G.C.GOLD) }, { padding = 0.1 }),
        row_of({ text(mod_loc("Please wait..."), 0.4) }, { padding = 0.1 }),
    } }))
end

local function switch_game(modded)
    local L = loader()
    if not modded and L and L.modded and G.FUNCS.mods_normal_game then
        return G.FUNCS.mods_normal_game({ config = {} })
    end
    if L and L.switch then return L.switch(modded) end
    bom_ui.show_error(mod_loc("Could not install the mods."))
end

function B.join_after_mods(info)
    B.mods_overlay = nil
    if info.code or not info.private then
        B.close_state()
        if bom_ui and bom_ui.show_connecting_screen then pcall(bom_ui.show_connecting_screen) end
        return bom_room.join(info.code, { id = info.id, from_browse = info.from_browse })
    end
    return B.ask_code({ id = info.id, name = info.name, private = true, joinable = true })
end

function B.accept(info)
    if not info then return end
    local F = rawget(_G, "bom_forge")
    local forge = forge_list(info)
    if F then
        if F.blocked(forge) then return B.show_mods_required(info) end
        local miss = F.missing(forge)
        if #miss > 0 then
            show_installing()
            return F.fetch(info, miss, function(ok, err)
                if ok then
                    F.enable_exact(forge)
                    return B.accept_plain(info)
                end
                B.show_mods_required(info)
                bom_ui.show_error(string.format(mod_loc("Could not get the Forge mod: %s"), tostring(err or "?")))
            end)
        end
        F.enable_exact(forge)
    end
    return B.accept_plain(info)
end

function B.accept_plain(info)
    if bom_core.same_mods(bom_core.mod_list(), host_plain_mods(info)) then return B.join_after_mods(info) end
    if not host_workshop(info) then
        B.write_pending(info)
        return switch_game(false)
    end
    local need = required_list(info)
    local _, blocked = B.review_mods(info)
    if blocked then return B.show_mods_required(info) end
    local function go()
        B.enable_exact(need)
        B.write_pending(info)
        switch_game(true)
    end
    local miss = B.missing(need)
    if #miss == 0 then return go() end
    local W = rawget(_G, "ModWorkshop")
    if not (W and W.install_required) then
        info.missing = miss
        return B.show_mods_required(info)
    end
    info.missing = nil
    show_installing()
    local ok_call, err = pcall(W.install_required, miss, function(ok, ierr)
        if ok then
            go()
        else
            B.show_mods_required(info)
            bom_ui.show_error(ierr and tostring(ierr) or mod_loc("Could not install the mods."))
        end
    end)
    if not ok_call then
        if mp_log then mp_log.error("BOM_BROWSE", "install_required failed: %s", tostring(err)) end
        B.show_mods_required(info)
        bom_ui.show_error(mod_loc("Could not install the mods."))
    end
end

function B.read_pending()
    local raw = love.filesystem.read(PENDING_FILE)
    if not raw then return nil end
    love.filesystem.remove(PENDING_FILE)
    local ok, p = pcall(function() return bom_core.json.decode(raw) end)
    if not ok or type(p) ~= "table" then return nil end
    if type(p.at) ~= "number" or os.time() - p.at > PENDING_MAX_AGE or os.time() < p.at - 60 then return nil end
    if not p.id and not p.code then return nil end
    return p
end

function B.resume_busy()
    if B.resume_wait then return true end
    return B.resume_at ~= nil and love.timer.getTime() - B.resume_at < 5
end

function B.resume_pending(p)
    B.resume_wait = nil
    if not p then return end
    B.resume_at = love.timer.getTime()
    if mp_log then mp_log.info("BOM_BROWSE", "resuming join id=%s code=%s", tostring(p.id), tostring(p.code)) end
    G.FUNCS.open_multiplayer_menu()
    if bom_ui and bom_ui.show_connecting_screen then bom_ui.show_connecting_screen() end
    bom_room.join(p.code, { id = p.id, from_browse = p.id ~= nil and not p.code })
end

function B.init()
    if mod_loc_register and not B._strings then
        B._strings = true
        mod_loc_register{
            fr = { ["Rooms"] = "Salons", ["Watch live"] = "Regarder en direct", ["BROWSE ROOMS"] = "PARCOURIR LES SALLES", ["REFRESH"] = "ACTUALISER" },
            es = { ["Rooms"] = "Salas", ["Watch live"] = "Ver en directo", ["BROWSE ROOMS"] = "BUSCAR SALAS", ["REFRESH"] = "ACTUALIZAR" },
        }
    end
    if B._hooked or not (Game and Game.main_menu) then return end
    B._hooked = true
    local main_menu_ref = Game.main_menu
    Game.main_menu = function(self, ...)
        local r = main_menu_ref(self, ...)
        local ok, p = pcall(B.read_pending)
        if ok and p then
            B.resume_wait = p
            local tries = 0
            G.E_MANAGER:add_event(Event({ trigger = "after", delay = 1.0, timer = "REAL", blocking = false, blockable = false,
                func = function()
                    if G.STAGE ~= G.STAGES.MAIN_MENU then B.resume_wait = nil return true end
                    tries = tries + 1
                    if G.OVERLAY_MENU and tries < 600 then return false end
                    pcall(B.resume_pending, p)
                    return true
                end }))
        end
        return r
    end
end

return B
end
