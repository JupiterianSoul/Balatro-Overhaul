    if mods_loc or not mod_loc_register then return end
    mods_loc = true
    mod_loc_register{
        fr = {
            ["Not in the Workshop"] = "Absent du Workshop", ["Installed"] = "Installé", ["To download"] = "À télécharger",
            ["Missing mods are downloaded from the Mods Workshop."] = "Les mods manquants sont téléchargés depuis le Workshop.",
