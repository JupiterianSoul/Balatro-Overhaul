            ["Missing mods are downloaded from the Mods Workshop."] = "Los mods que faltan se descargan del Workshop.",
            ["Your other mods are turned off for this room."] = "Tus otros mods se desactivan para esta sala.",
            ["Only Workshop mods can be used online."] = "Solo los mods del Workshop se pueden usar en línea.",
            ["You can't join this room."] = "No puedes unirte a esta sala.",
            ["BACK"] = "VOLVER",
            ["Forge mod"] = "Mod de la Forja", ["by %s"] = "de %s", ["To update"] = "Por actualizar", ["Too big"] = "Muy grande",
            ["Forge mods are sent by the host."] = "El anfitrión envía los mods de la Forja.",
            ["A Forge mod is too big to share."] = "Un mod de la Forja es demasiado grande para compartir.",
            ["This room plays without your Forge mods."] = "Esta sala se juega sin tus mods de la Forja.",
