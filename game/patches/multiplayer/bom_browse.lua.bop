local B = {}

local PAGE_SIZE = 5
local ROW_W = 13.8
local PENDING_FILE = "mp_pending_join.txt"
local PENDING_MAX_AGE = 900
local LIST_TIMEOUT = 20

B.state = { status = "idle", rooms = {}, page = 1, rtt = nil, req = 0 }

local function loader()
    return rawget(_G, "MODLOADER")
end

local function text(t, scale, colour, extra)
    local cfg = { text = tostring(t), scale = scale, colour = colour or G.C.UI.TEXT_LIGHT, shadow = true }
    for k, v in pairs(extra or {}) do cfg[k] = v end
    return { n = G.UIT.T, config = cfg }
end

local function row_of(nodes, cfg)
    cfg = cfg or {}
    cfg.align = cfg.align or "cm"
    return { n = G.UIT.R, config = cfg, nodes = nodes }
end

function B.room_title(name)
    local n = type(name) == "string" and name ~= "" and name or "Player"
    local fmt = mod_loc("{name}'s room")
    local s = fmt:gsub("{name}", function() return n end)
    return s
end

function B.mode_name(mode)
    if type(mode) == "string" and mode:sub(1, 6) == "party_" and bom_party then
        return bom_party.kind_name(mode:sub(7))
    end
    if mode == nil or mode == "" or mode == "attrition" then mode = "nemesis" end
    local name = type(mode) == "string" and mode ~= "" and (mode:sub(1, 1):upper() .. mode:sub(2)) or "Rivals"
    pcall(function()
        local GM = package.loaded["multiplayer.bom_gamemodes"]
        local gm = GM and GM.get and GM.get(mode or "nemesis")
        if gm and gm.display_name then name = gm.display_name end
    end)
    return name
end

function B.is_open()
    return B.overlay ~= nil and G.OVERLAY_MENU ~= nil and G.OVERLAY_MENU == B.overlay
end

function B.close_state()
    B.overlay = nil
end

local function show_overlay(definition)
r 4 1381 %20%20%20%20 -
l 43
    bom_ui.overlay({ definition = definition })
end

B.create_choice = B.create_choice or { visibility = 1, mode = 1 }

function B.create_modes()
    local out = {}
    local list = bom_gamemodes and bom_gamemodes.get_display_list and bom_gamemodes.get_display_list() or {}
    for _, m in ipairs(list) do out[#out + 1] = { value = m.key, label = mod_loc(m.name), max = 2 } end
    if #out == 0 then out[1] = { value = "nemesis", label = mod_loc("Rivals"), max = 2 } end
    if bom_party then
        for _, k in ipairs(bom_party.KINDS) do out[#out + 1] = { value = k, label = bom_party.kind_name(k), max = bom_party.MAX, party = true } end
    end
    return out
end

local function create_body()
    local c = B.create_choice
    local modes = B.create_modes()
    c.mode = math.min(math.max(1, c.mode or 1), #modes)
    local m = modes[c.mode]
    local labels = {}
    for i, x in ipairs(modes) do labels[i] = x.label end
    local inner = B.CREATE_W - 2 * UIK.PAD
    local info = m.party and mod_loc(bom_party.KIND_INFO[m.value]) or mod_loc("One against one")
    return UIK.stack({
        UIK.cycle{ w = inner, label = mod_loc("Visibility"), options = { mod_loc("Public"), mod_loc("Private") }, current = c.visibility, id = "mp_create_vis",
            info = c.visibility == 1 and mod_loc("Anyone can join from Browse Rooms") or mod_loc("Only players with the code can join"),
            callback = function(i) c.visibility = i; UIK.refresh() end },
        UIK.cycle{ w = inner, label = mod_loc("Mode"), options = labels, current = c.mode, id = "mp_create_mode", info = info,
            callback = function(i) c.mode = i; UIK.refresh() end },
        UIK.value{ w = inner, vw = 3.2, label = mod_loc("Players"), value = m.max == 2 and "2" or ("2-" .. m.max) },
    }, { w = inner })
end

B.CREATE_W = 6.4

function B.show_create()
    G.FUNCS.mp_create_go = function()
        local c = B.create_choice
        local m = B.create_modes()[c.mode] or {}
        B.create(c.visibility == 1 and "public" or "private", m)
    end
