            ["You can't join this room."] = "Vous ne pouvez pas rejoindre cette salle.",
            ["BACK"] = "RETOUR",
            ["Forge mod"] = "Mod de la Forge", ["by %s"] = "par %s", ["To update"] = "À mettre à jour", ["Too big"] = "Trop gros",
            ["Forge mods are sent by the host."] = "Les mods de la Forge sont envoyés par l'hôte.",
            ["A Forge mod is too big to share."] = "Un mod de la Forge est trop gros pour être partagé.",
