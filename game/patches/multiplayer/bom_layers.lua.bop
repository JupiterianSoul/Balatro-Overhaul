M.register{id = "econ_discard_tax", cat = "economy", name = "Discard tax", desc = "Every discard costs $1", rules = {discard_cost = 1}}
M.register{id = "econ_frugal", cat = "economy", name = "Frugal", desc = "Earn $1 per unused discard", rules = {money_per_discard = 1}}
M.register{id = "econ_spartan", cat = "economy", name = "Spartan", desc = "Only boss blinds pay a reward", rules = {blind_reward = "boss_only"}}
M.register{id = "shop_bigger", cat = "shop", group = "shop_size", name = "Bigger shop", desc = "One more card slot in the shop", rules = {shop_slots = 3}}
M.register{id = "shop_tight", cat = "shop", group = "shop_size", name = "Tight shop", desc = "One card slot, rerolls start at $3", rules = {shop_slots = 1, reroll_cost = 3}}
M.register{id = "shop_mystery", cat = "shop", name = "Mystery prices", desc = "Every price is 50% to 200%", rules = {random_prices = true}}
M.register{id = "shared_pockets", cat = "twist", name = "Shared pockets", desc = "Joker and consumable slots are one shared pool",
    start = function() G.GAME.bom_pockets = nil end}
M.register{id = "score_wobble", cat = "twist", name = "Unstable score", desc = "Each hand's score is multiplied by x0.7 to x1.4"}
M.register{id = "no_red_seals", cat = "twist", name = "No red seals", desc = "Red Seals never appear, Deja Vu is banned",
    bans = {consumables = {"c_deja_vu"}}}
M.register{id = "no_gambling", cat = "twist", name = "No gambling", desc = "No Lucky or Gold cards, Magician and Devil banned",
    bans = {consumables = {"c_magician", "c_devil"}, enhancements = {"m_lucky", "m_gold"}}}
M.register{id = "small_world", cat = "twist", name = "Scarcity", desc = "Only one in four jokers, consumables, vouchers and tags can appear",
    start = function(ctx) M.apply_small_world(ctx and ctx.pool_seed) end}
M.register{id = "face_down", cat = "twist", name = "Face down", desc = "1 in 4 drawn cards come face down", rules = {flipped_cards = 4}}
M.register{id = "all_eternal", cat = "twist", name = "Eternal jokers", desc = "Every joker is Eternal", rules = {all_eternal = true}}

M.CAT_ORDER = {
    {key = "timer", label = "Clocks"}, {key = "glass", label = "Glass"}, {key = "economy", label = "Economy"},
    {key = "shop", label = "Shop"}, {key = "twist", label = "Twists"},
}

function M.get(id) return M.BY_ID[id] end

function M.by_cat(cat)
    local out = {}
    for _, d in ipairs(M.LIST) do if (d.cat or "twist") == cat then out[#out + 1] = d end end
    return out
end

function M.ids()
    local out = {}
    for i, d in ipairs(M.LIST) do out[i] = d.id end
    return out
end

function M.name(id)
    local d = M.BY_ID[id]
    return d and L(d.name) or nil
end

function M.desc(id)
    local d = M.BY_ID[id]
    return d and L(d.desc) or nil
end

function M.valid(ids)
    local out, seen, groups = {}, {}, {}
    if type(ids) ~= "table" then return out end
    for _, id in ipairs(ids) do
        local d = M.BY_ID[id]
        if d and not seen[id] and not groups[d.group] then
            seen[id], groups[d.group] = true, true
            out[#out + 1] = id
        end
    end
    return out
end

function M.has(ids, id)
    if type(ids) ~= "table" then return false end
    for _, x in ipairs(ids) do if x == id then return true end end
    return false
end

function M.toggle(ids, id, on)
    local d = M.BY_ID[id]
    local out = {}
    for _, x in ipairs(M.valid(ids)) do
        local xd = M.BY_ID[x]
        if x ~= id and not (on and d and xd.group == d.group) then out[#out + 1] = x end
    end
    if on and d then out[#out + 1] = id end
    local order = {}
    for i, l in ipairs(M.LIST) do order[l.id] = i end
    table.sort(out, function(a, b) return (order[a] or 999) < (order[b] or 999) end)
    return out
end

function M.names(ids)
    local out = {}
    for _, id in ipairs(M.valid(ids)) do out[#out + 1] = M.name(id) end
    return out
end

function M.settings_for(ids)
    local out = {}
    for _, id in ipairs(M.valid(ids)) do
        for k, v in pairs(M.BY_ID[id].settings or {}) do out[k] = v end
    end
    return out
end

function M.rules_for(ids, base)
    local out = {}
    for k, v in pairs(base or {}) do out[k] = v end
    for _, id in ipairs(M.valid(ids)) do
        for k, v in pairs(M.BY_ID[id].rules or {}) do out[k] = v end
    end
    return out
end

function M.bans_for(ids)
    local out = {}
    for _, c in ipairs(CATS) do out[c] = {} end
    out.enhancements = {}
    for _, id in ipairs(M.valid(ids)) do
        for cat, list in pairs(M.BY_ID[id].bans or {}) do
            out[cat] = out[cat] or {}
            for _, k in ipairs(list) do out[cat][#out[cat] + 1] = k end
        end
    end
    return out
end

function M.active(id)
    local set = G and G.GAME and G.GAME.bom_layers
    return type(set) == "table" and set[id] == true
end

local saved_centers = nil

function M.restore_centers()
    if not saved_centers then return end
    for key, cfg in pairs(saved_centers) do
        local c = G and G.P_CENTERS and G.P_CENTERS[key]
        if c and type(c.config) == "table" then
            for k, v in pairs(cfg) do
                if v == "__nil" then c.config[k] = nil else c.config[k] = v end
            end
        end
    end
    saved_centers = nil
end

function M.apply_centers(ids)
    M.restore_centers()
    if not (G and G.P_CENTERS) then return end
    for _, id in ipairs(M.valid(ids)) do
        for key, cfg in pairs(M.BY_ID[id].centers or {}) do
            local c = G.P_CENTERS[key]
            if c and type(c.config) == "table" then
                saved_centers = saved_centers or {}
                saved_centers[key] = saved_centers[key] or {}
                for k, v in pairs(cfg) do
                    if saved_centers[key][k] == nil then
                        local old = c.config[k]
                        saved_centers[key][k] = old == nil and "__nil" or old
                    end
                    c.config[k] = v
                end
            end
        end
    end
end

local function hash(s)
    local h = 5381
    s = tostring(s or "")
    for i = 1, #s do h = (h * 33 + s:byte(i)) % 2147483647 end
    if h == 0 then h = 1 end
    return h
end
M.hash = hash

local function rng(seed)
    local state = hash(seed)
    return function()
        state = (state * 16807) % 2147483647
        return state / 2147483647
    end
end
M.rng = rng

local SW_SETS = {Joker = true, Tarot = true, Planet = true, Spectral = true, Voucher = true}

function M.small_world_bans(seed, centers, tags, banned)
    banned = banned or {}
    local groups = {}
    local function add(g, key)
        groups[g] = groups[g] or {}
        local list = groups[g]
        list[#list + 1] = key
    end
    for key, c in pairs(centers or {}) do
        if type(c) == "table" and SW_SETS[c.set] and not banned[key] and not c.hidden and not c.requires and not c.omit
            and key ~= "j_cavendish" and c.name ~= "The Soul" and c.name ~= "Black Hole" then
            add(c.set == "Joker" and ("Joker" .. tostring(c.rarity or 1)) or c.set, key)
        end
    end
    for key, t in pairs(tags or {}) do
        if type(t) == "table" and not banned[key] then add("Tag", key) end
    end
    local names = {}
    for g in pairs(groups) do names[#names + 1] = g end
    table.sort(names)
    local out = {}
    for _, g in ipairs(names) do
        local list = groups[g]
        table.sort(list)
        local next_r = rng(tostring(seed) .. ":" .. g)
r 12 213 %20%20%20%20%20%20%20%20 -
l 2
            local j = 1 + math.floor(next_r() * i)
            if j > i then j = i end
r 12 215 %20%20%20%20%20%20%20%20%20%20%20%20 -
l 93
        end
        local n = math.min(math.floor(#list * 0.75 + 0.5), #list - 1)
        for i = 1, n do out[list[i]] = true end
    end
    for key, c in pairs(centers or {}) do
        if type(c) == "table" and c.set == "Voucher" and type(c.requires) == "table" then
            for _, req in ipairs(c.requires) do
                if out[req] or banned[req] then out[key] = true end
            end
        end
    end
    if out.j_gros_michel or banned.j_gros_michel then out.j_cavendish = true end
    return out
end

function M.apply_small_world(seed)
    if not (G and G.GAME and G.P_CENTERS) then return 0 end
    G.GAME.banned_keys = G.GAME.banned_keys or {}
    local bans = M.small_world_bans(seed or (G.GAME.pseudorandom and G.GAME.pseudorandom.seed) or "", G.P_CENTERS, G.P_TAGS, G.GAME.banned_keys)
    local n = 0
    local set = {}
    for k in pairs(bans) do
        if not G.GAME.banned_keys[k] then
            G.GAME.banned_keys[k] = true
            set[k] = true
            n = n + 1
        end
    end
    G.GAME.bom_small_world = n
    G.GAME.bom_sw_bans = set
    return n
end

function M.ban_list(ids, banned)
    local b = M.bans_for(ids)
    for _, list in pairs(b) do
        for _, k in ipairs(list) do banned[k] = true end
    end
end

function M.start_run(ids, ctx)
    if not (G and G.GAME) then return end
    ids = M.valid(ids)
    local set = {}
    for _, id in ipairs(ids) do set[id] = true end
    G.GAME.bom_layers = set
    G.GAME.banned_keys = G.GAME.banned_keys or {}
    M.ban_list(ids, G.GAME.banned_keys)
    for _, id in ipairs(ids) do
        local d = M.BY_ID[id]
        if d.start then
            local ok, err = pcall(d.start, ctx or {})
            if not ok and mp_log then mp_log.error("BOM_LAYERS", "start %s: %s", id, tostring(err)) end
        end
    end
end

function M.wobble_factor()
    local g = G and G.GAME
    if not g then return 1 end
    local rr = g.round_resets or {}
    local cr = g.current_round or {}
    local key = tostring(g.pseudorandom and g.pseudorandom.seed or "") .. ":wobble:" .. tostring(rr.ante or 1) .. ":"
        .. tostring(g.round or 0) .. ":" .. tostring(cr.hands_played or 0)
    local u = rng(key)()
    return math.floor(0.7 * 2 ^ u * 100 + 0.5) / 100
end

local function sync_pockets()
    local j, c = G.jokers, G.consumeables
    if not (j and c and j.config and c.config and j.cards and c.cards) then return end
    local st = G.GAME.bom_pockets
    if type(st) ~= "table" or not st.jb then
        st = {jb = j.config.card_limit or 5, cb = c.config.card_limit or 2}
        G.GAME.bom_pockets = st
    end
    if st.jw and j.config.card_limit ~= st.jw then st.jb = st.jb + ((j.config.card_limit or 0) - st.jw) end
    if st.cw and c.config.card_limit ~= st.cw then st.cb = st.cb + ((c.config.card_limit or 0) - st.cw) end
    local free = math.max(0, (st.jb + st.cb) - (#j.cards + #c.cards))
    local jl, cl = #j.cards + free, #c.cards + free
    if j.config.card_limit ~= jl then j.config.card_limit = jl end
    if c.config.card_limit ~= cl then c.config.card_limit = cl end
    st.jw, st.cw = jl, cl
end
M.sync_pockets = sync_pockets

local function in_preview()
    local p = rawget(_G, "PREVIEW")
    return type(p) == "table" and p._in_sandbox == true
end

local function wobble_text(f)
    if in_preview() or not (G and G.E_MANAGER and attention_text and G.play) then return end
