local M = {}

local function L(s) return mod_loc and mod_loc(s) or s end

M.LIST = {}
M.BY_ID = {}

local CATS = {"jokers", "consumables", "vouchers", "blinds", "tags"}
M.CATS = CATS

function M.register(def)
    if type(def) ~= "table" or type(def.id) ~= "string" or def.id == "" then return nil end
    def.group = def.group or def.id
    if not M.BY_ID[def.id] then M.LIST[#M.LIST + 1] = def end
    M.BY_ID[def.id] = def
    return def
end

M.register{id = "clock_blitz", cat = "timer", group = "timer", name = "Rapid clock", desc = "60 s ready timer, 1 free timeout",
    settings = {timer = true, timer_base_seconds = 60, timer_increment_seconds = 0, timer_forgiveness = 1}}
M.register{id = "clock_pressure", cat = "timer", group = "timer", name = "Pressure clock", desc = "90 s ready timer, +15 s per ante, no free timeout",
    settings = {timer = true, timer_base_seconds = 90, timer_increment_seconds = 15, timer_forgiveness = 0}}
M.register{id = "clock_relaxed", cat = "timer", group = "timer", name = "Relaxed clock", desc = "240 s ready timer, +30 s per ante",
    settings = {timer = true, timer_base_seconds = 240, timer_increment_seconds = 30, timer_forgiveness = 2}}
