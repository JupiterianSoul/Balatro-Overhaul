    centers = {m_glass = {Xmult = 1.5, extra = 8}}}
M.register{id = "glass_fragile", cat = "glass", group = "glass", name = "Fragile glass", desc = "Glass cards give X3 Mult, break 1 in 2",
    centers = {m_glass = {Xmult = 3, extra = 2}}}
M.register{id = "econ_inflation", cat = "economy", name = "Inflation", desc = "Every purchase raises all prices by $1", rules = {inflation = true}}
