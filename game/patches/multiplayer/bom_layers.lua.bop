function M.install_hooks()
    if M._hooked then return end
    M._hooked = true
    if Back and Back.trigger_effect then
        local orig_trigger = Back.trigger_effect
r 1 108 %20%20%20%20%20%20%20%20 -
l 50
            local c, m = orig_trigger(self, args)
            if args and args.context == "final_scoring_step" and M.active("score_wobble") then
                local mult = m or args.mult
                if type(mult) == "number" then
                    local f = M.wobble_factor()
                    mult = math.max(1, mult * f)
                    pcall(function() if not in_preview() then update_hand_text({delay = 0}, {mult = mult}) end end)
                    wobble_text(f)
                    return c, mult
                end
            end
            return c, m
        end
    end
    if Card and Card.set_seal then
        local orig_seal = Card.set_seal
        function Card:set_seal(seal, silent, immediate)
            if seal == "Red" and M.active("no_red_seals") then return end
            return orig_seal(self, seal, silent, immediate)
        end
    end
    if Tag and Tag.init then
        local orig_tag = Tag.init
        function Tag:init(tag, for_collection, blind_type)
            if not for_collection and type(tag) == "string" and M.active("small_world") and G.GAME.banned_keys
                and G.GAME.banned_keys[tag] and get_next_tag_key then
                for i = 1, 6 do
                    local ok, k = pcall(get_next_tag_key, "bom_sw" .. i)
                    if ok and type(k) == "string" and k ~= "tag_orbital" then tag = k break end
                end
            end
            return orig_tag(self, tag, for_collection, blind_type)
        end
    end
    if type(get_current_pool) == "function" then
        local orig_pool = get_current_pool
        get_current_pool = function(ptype, ...)
            if M.active("small_world") and G.GAME.used_jokers and (ptype == "Joker" or ptype == "Tarot" or ptype == "Planet" or ptype == "Spectral") then
                local used = G.GAME.used_jokers
                G.GAME.used_jokers = {}
                local ok, a, b = pcall(orig_pool, ptype, ...)
                G.GAME.used_jokers = used
                if not ok then error(a, 0) end
                return a, b
            end
            return orig_pool(ptype, ...)
        end
    end
    if CardArea and CardArea.update then
        local orig_update = CardArea.update
r 7 243 %20%20%20%20%20%20%20%20 -
l 63
            if self == G.jokers and G.GAME then
                if M.on_frame and G.GAME.bom_rs then pcall(M.on_frame) end
                if M.active("shared_pockets") then pcall(sync_pockets) end
            end
            return orig_update(self, dt)
        end
    end
end

