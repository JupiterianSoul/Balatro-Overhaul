    G.FUNCS.overlay_menu{definition = C.window(tab)}
end

function C.init()
    pcall(C.register_blind_art)
    if Game and Game.set_render_settings and not C.render_hooked then
        C.render_hooked = true
        local orig_render = Game.set_render_settings
        Game.set_render_settings = function(self, ...)
            local r = orig_render(self, ...)
            pcall(C.register_blind_art)
            return r
        end
    end
    G.FUNCS.mpm_coll_back = function()
        local m = rawget(_G, "mpm_menu")
        if m and m.active then return G.FUNCS.exit_overlay_menu() end
r 13 1375 %20%20%20%20%20%20%20%20 -
l 41
    end
    G.FUNCS.mpm_coll_vanilla = function(e)
        if G.FUNCS.your_collection then G.FUNCS.your_collection(e) end
    end
    G.FUNCS.mpm_coll_mode_prev = function()
        local MC = modes()
        if MC and MC.filter_step then MC.filter_step(-1); UIK.refresh() end
    end
    G.FUNCS.mpm_coll_mode_next = function()
        local MC = modes()
        if MC and MC.filter_step then MC.filter_step(1); UIK.refresh() end
    end
    G.FUNCS.mpm_coll_prev = function(e)
        local key = e and e.config and e.config.ref_table and e.config.ref_table.key
        if key then C.page[key] = (C.page[key] or 1) - 1; UIK.refresh() end
    end
    G.FUNCS.mpm_coll_next = function(e)
        local key = e and e.config and e.config.ref_table and e.config.ref_table.key
        if key then C.page[key] = (C.page[key] or 1) + 1; UIK.refresh() end
    end
    if mod_loc_register then
        mod_loc_register{
            fr = {["COLLECTION"] = "COLLECTION", ["All cards"] = "Toutes", ["Jokers"] = "Jokers", ["Decks"] = "Jeux", ["Stakes"] = "Mises", ["Traps"] = "Pièges",
                ["Blinds"] = "Blindes", ["Reworks"] = "Refontes", ["Your collection"] = "Votre collection",
                ["Multiplayer shares your single-player unlocks."] = "Le multijoueur reprend vos déblocages du mode solo.",
                ["The other tabs show the cards that only exist in multiplayer."] = "Les autres onglets montrent les cartes propres au multijoueur.",
                ["OPEN CARD COLLECTION"] = "OUVRIR LA COLLECTION", ["Nothing here yet. New ones arrive with updates."] = "Rien pour l'instant. Les nouveautés arrivent avec les mises à jour.",
                ["No reworked cards right now."] = "Aucune carte refondue pour l'instant.", ["Multiplayer version"] = "Version multijoueur",
                ["No cards of this kind in this mode."] = "Aucune carte de ce type dans ce mode."},
            es = {["COLLECTION"] = "COLECCIÓN", ["All cards"] = "Todas", ["Jokers"] = "Comodines", ["Decks"] = "Barajas", ["Stakes"] = "Pozos", ["Traps"] = "Trampas",
                ["Blinds"] = "Ciegas", ["Reworks"] = "Cambios", ["Your collection"] = "Tu colección",
                ["Multiplayer shares your single-player unlocks."] = "El multijugador comparte tus desbloqueos de un jugador.",
                ["The other tabs show the cards that only exist in multiplayer."] = "Las otras pestañas muestran las cartas exclusivas del multijugador.",
                ["OPEN CARD COLLECTION"] = "ABRIR LA COLECCIÓN", ["Nothing here yet. New ones arrive with updates."] = "Nada por ahora. Llegan novedades con las actualizaciones.",
                ["No reworked cards right now."] = "No hay cartas cambiadas por ahora.", ["Multiplayer version"] = "Versión multijugador",
                ["No cards of this kind in this mode."] = "No hay cartas de este tipo en este modo."},
