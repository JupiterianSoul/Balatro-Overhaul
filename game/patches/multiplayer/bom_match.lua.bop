local bom_match = {}

bom_match.PHASE = {
    NONE        = "none",
    LOBBY       = "lobby",
    STARTING    = "starting",
    PLAYING     = "playing",
    PVP_BLIND   = "pvp_blind",
    PVP_RESOLVE = "pvp_resolve",
    MATCH_END   = "match_end",
}

bom_match.MODE = {
    NEMESIS   = "nemesis",
    FACEOFF   = "faceoff",
    ASCENSION = "ascension",
    ATTRITION = "nemesis",
    SHOWDOWN  = "faceoff",
    SURVIVAL  = "ascension",
}

local TRANSITIONS = {
    [bom_match.PHASE.NONE]        = { [bom_match.PHASE.LOBBY]       = true },
    [bom_match.PHASE.LOBBY]       = { [bom_match.PHASE.STARTING]    = true, [bom_match.PHASE.PLAYING]    = true, [bom_match.PHASE.NONE]      = true },
    [bom_match.PHASE.STARTING]    = { [bom_match.PHASE.PLAYING]     = true },
    [bom_match.PHASE.PLAYING]     = { [bom_match.PHASE.PVP_BLIND]   = true, [bom_match.PHASE.MATCH_END]  = true },
    [bom_match.PHASE.PVP_BLIND]   = { [bom_match.PHASE.PVP_RESOLVE] = true, [bom_match.PHASE.PLAYING]    = true, [bom_match.PHASE.MATCH_END]  = true },
    [bom_match.PHASE.PVP_RESOLVE] = { [bom_match.PHASE.PLAYING]     = true, [bom_match.PHASE.MATCH_END]  = true },
    [bom_match.PHASE.MATCH_END]   = { [bom_match.PHASE.LOBBY]       = true, [bom_match.PHASE.PLAYING]    = true, [bom_match.PHASE.NONE] = true },
}
local phase_change_listeners = {}

