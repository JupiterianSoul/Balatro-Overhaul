-- ============================================
-- DISCONNECT
-- ============================================

function bom_match.on_opponent_disconnected()
    if match.disconnect_handled then return end
    match.disconnect_handled = true

    if match.phase == bom_match.PHASE.LOBBY or match.phase == bom_match.PHASE.STARTING then
        bom_match.reset()
        pcall(function()
            if bom_ui and bom_ui.show_error then
                bom_ui.show_error("Opponent left the lobby.")
            end
        end)
    else
        bom_match.end_match("win", "opponent_disconnected")
    end
end

-- ============================================
-- RETURN TO LOBBY — Reset match state but preserve lobby data
-- ============================================

---@diagnostic disable-next-line: duplicate-set-field
function bom_match.return_to_lobby()
    -- Save lobby data before reset
    local room_code = match.room_code
    local is_host = match.is_host
    local my_name = match.my_name
    local opp_name = match.opp_name
    local settings = match.settings
    local was_quick_match = false

    pcall(function()
        was_quick_match = G and G.GAME and G.GAME.bom_quick_match or false
    end)

    -- Full reset
    bom_match.reset()

    -- Restore lobby data
    bom_match.transition(bom_match.PHASE.LOBBY)
    match.room_code = room_code
    match.is_host = is_host
    match.my_name = my_name
    match.opp_name = opp_name
    match.settings = settings
    match.my_ready = false
    match.opp_ready = false
    mp_log.info("BOM_MATCH", "return_to_lobby: room=%s host=%s quickmatch=%s", tostring(room_code), tostring(is_host), tostring(was_quick_match))
end

-- ============================================
-- REMATCH
-- ============================================

---@diagnostic disable-next-line: duplicate-set-field
function bom_match.vote_rematch()
    match.rematch_voted = true
    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({ type = "rematch_vote" })
        end
    end)
    mp_log.info("BOM_MATCH", "vote_rematch: sent rematch_vote to server")
end

---@diagnostic disable-next-line: duplicate-set-field
function bom_match.has_voted_rematch()
    return match.rematch_voted == true
end

-- ============================================
-- BALANCE LIST
-- ============================================

bom_match.BANNED_JOKERS = {
    "j_blueprint", "j_brainstorm", "j_mr_bones", "j_luchador", "j_chicot",
}
bom_match.BANNED_CONSUMABLES = {}

function bom_match.is_card_banned(key)
    if not match.settings.balance_enabled then return false end
    if not key then return false end
    for _, banned in ipairs(bom_match.BANNED_JOKERS) do
        if banned == key then return true end
    end
    for _, banned in ipairs(bom_match.BANNED_CONSUMABLES) do
        if banned == key then return true end
    end
    return false
end

-- ============================================
-- FEATURE: Session 56 — ENEMY LOCATION TRACKING (ported from BalatroMultiplayer-0.3.3)
-- Sends our current game state to the opponent so they can display it.
-- The server relays set_location unchanged.
-- ============================================

local function blind_name_of(key)
    if type(key) ~= "string" or key == "" then return nil end
    local name = nil
    pcall(function() name = localize({ type = "name_text", key = key, set = "Blind" }) end)
    if name and name ~= "ERROR" then return name end
    if G and G.P_BLINDS and G.P_BLINDS[key] and G.P_BLINDS[key].name then return G.P_BLINDS[key].name end
    return nil
end
bom_match.blind_name_of = blind_name_of

function bom_match.split_location(raw)
    if type(raw) ~= "string" or raw == "" then return nil, nil end
    local key, value = raw:match("^([^-]+)-(.*)$")
    if not key then key, value = raw, "" end
    return key, value ~= "" and value or nil
end

local STATUS_TEXT = {
    loc_selecting = "Selecting blind",
    loc_shop = "Shopping before",
    loc_pack = "In a pack",
    loc_playing = "Playing",
    loc_ready = "Ready for PvP",
    loc_wait = "Waiting for the result",
    loc_swap = "Swapping runs",
}

function bom_match.status_of(raw)
    local key, blind = bom_match.split_location(raw)
    if not key then return { text = "..." } end
    local text = STATUS_TEXT[key]
    if not text then return { text = "..." } end
    if key == "loc_shop" and not blind then return { text = mod_loc("In the shop") } end
    if blind == "bl_mp_nemesis" then
        local pr = rawget(_G, "bom_party_run")
        local pk = pr and pr.kind and pr.kind()
        local own = pk and pr.KEY and pr.KEY[pk]
        if own and G and G.P_BLINDS and G.P_BLINDS[own] then blind = own end
    end
    local known = blind and G and G.P_BLINDS and G.P_BLINDS[blind] and blind or nil
    return { text = mod_loc(text), blind = known, blind_name = blind_name_of(known) }
end

function bom_match.format_location(raw)
    if type(raw) ~= "string" or raw == "" then return nil end
    local st = bom_match.status_of(raw)
    if st.blind_name then return st.text .. " " .. st.blind_name end
    return st.text
end

local BLIND_SLOTS = { "Small", "Big", "Boss" }

function bom_match.next_blind_key()
    local rr = G and G.GAME and G.GAME.round_resets
    if not rr or not rr.blind_choices then return nil end
    for _, slot in ipairs(BLIND_SLOTS) do
        local state = rr.blind_states and rr.blind_states[slot]
        if state == "Select" or state == "Upcoming" or state == "Current" then return rr.blind_choices[slot] end
    end
    return rr.blind_choices.Boss
end

local SHOP_LOC = {}

function bom_match.shop_location()
    local ok, key = pcall(bom_match.next_blind_key)
    if ok and type(key) == "string" and key ~= "" then
        local loc = SHOP_LOC[key]
        if not loc then
            loc = "loc_shop-" .. key
            SHOP_LOC[key] = loc
        end
        return loc
    end
    return "loc_shop"
end

local PACK_STATES = { "TAROT_PACK", "PLANET_PACK", "SPECTRAL_PACK", "STANDARD_PACK", "BUFFOON_PACK", "SMODS_BOOSTER_OPENED" }

function bom_match.location_for_state()
    if not (G and G.STATES and G.STATE) then return nil end
    for _, name in ipairs(PACK_STATES) do
        if G.STATES[name] and G.STATE == G.STATES[name] then return "loc_pack" end
    end
    if G.BOM_PVP_WAITING_OVERLAY and bom_match.is_pvp_blind() then return "loc_wait" end
    local sw = rawget(_G, "bom_swap")
    if sw and sw.pending and sw.pending() then return "loc_swap" end
    if G.STATE == G.STATES.SHOP then return bom_match.shop_location() end
    if G.STATE == G.STATES.BLIND_SELECT then
        if G.GAME and G.GAME.facing_blind then return nil end
        return (G.GAME and G.GAME.mp_blind_ready) and "loc_ready" or "loc_selecting"
    end
    return nil
end

function bom_match.update_location()
    if not bom_match.is_in_match() then return end
    local loc = bom_match.location_for_state()
    if loc then bom_match.send_location(loc) end
end

function bom_match.send_location(loc)
    if not bom_match.is_in_match() then return end
    match.my_location = loc
    if match._last_sent_location == loc then return end
    match._last_sent_location = loc
    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({ type = "set_location", location = loc })
        end
    end)
end


local function count_results(d)
    local wins, losses = 0, 0
    local list = type(d.pvpResults) == "table" and d.pvpResults or {}
    for _, r in ipairs(list) do
        if type(r) == "table" and r.winner ~= nil then
            if r.winner == d.playerId then wins = wins + 1 else losses = losses + 1 end
        end
    end
    return wins, losses, #list
end

function bom_match.release_unplayed_pvp_blind()
    if not G or not G.GAME or not G.STATES or G.STATE ~= G.STATES.BLIND_SELECT then return end
    local rr = G.GAME.round_resets
    if not rr then return end
    local slot = G.GAME.blind_on_deck or "Boss"
    local letter = (slot == "Boss" and "L") or (slot == "Big" and "B") or "S"
    local ante = rr.ante or match.current_ante
    local was_pvp = (rr.pvp_blind_choices and rr.pvp_blind_choices[slot]) or bom_match.is_blind_pvp(ante, letter)
    if not was_pvp then return end
    G.GAME.mp_pvp_skipped = G.GAME.mp_pvp_skipped or {}
    G.GAME.mp_pvp_skipped[tostring(ante) .. ":" .. letter] = true
    mp_log.info("BOM_MATCH", "PvP blind %s:%s resolved before this player entered it, it is now a normal blind", tostring(ante), letter)
    G.GAME.mp_blind_ready = false
    G.GAME.mp_blind_ready_text = mod_loc("Ready")
    pcall(function()
        bom_pvp_hud._pending_blind_context = nil
        bom_pvp_hud._ready_lock_until = nil
    end)
    if slot == "Boss" and rr.blind_choices and rr.blind_choices.Boss == "bl_mp_nemesis" and G.blind_select_opts and G.FUNCS.reroll_boss then
        local rerolled = rr.boss_rerolled
r 5 288 %20%20%20%20%20%20%20%20 -
r 5 289 %20%20%20%20%20%20%20%20 -
l 360
        rr.boss_rerolled = rerolled
    end
end

function bom_match.restore_counts(d)
    local w, l, n = count_results(d)
    match.pvp_wins = w
    match.pvp_losses = l
    match.pvp_results_seen = n
    pcall(function() if G and G.GAME then G.GAME.mp_pvp_results_seen = n end end)
end

function bom_match.restore_from_rejoin(d)
    bom_match.reset()
    bom_match.transition(bom_match.PHASE.LOBBY)
    bom_match.transition(bom_match.PHASE.PLAYING)
    match.is_host = d.host == true
    match.room_code = d.code
    match.seed = d.seed
    if type(d.settings) == "table" then
        for k, v in pairs(d.settings) do match.settings[k] = v end
    end
    bom_match.apply_rejoin_rules(d)
    match.mode = match.settings.mode or d.mode or match.mode
    if match.mode == "attrition" then match.mode = "nemesis" end
    match.settings.mode = match.mode
    pcall(function()
        local profile = G.PROFILES[G.SETTINGS.profile]
        if profile and profile.name then match.my_name = profile.name end
    end)
    match.server_player_id = d.playerId
    match.profile_sent = true
    local me, opp = d.me or {}, d.opp or {}
    if opp.name and opp.name ~= "" then match.opp_name = opp.name end
    match.my_lives = tonumber(me.lives) or match.my_lives
    match.opp_lives = tonumber(opp.lives) or match.opp_lives
    match.opp_status = opp.status or "active"
    match.current_ante = tonumber(d.currentAnte) or 1
    match.current_blind = d.currentBlind or "S"
    match.won_without_life_loss = match.my_lives >= (tonumber(d.startingLives) or match.my_lives)
    local w, l, n = count_results(d)
    match.pvp_wins, match.pvp_losses, match.pvp_results_seen = w, l, n
    bom_match.set_final_state(d.finalAnte, d.suddenDeath)
    if G and G.GAME then G.GAME.bom_room_code = d.code end
end

local function apply_opponent_panel(d)
    G.GAME.mp_opponent_panel = G.GAME.mp_opponent_panel or {
        title = "", rank = 1, score = 0, score_text = "0", hands_left = 0,
        blind_finished = false, location = (match.opp_location and bom_match.format_location(match.opp_location)) or "...",
    }
    local panel = G.GAME.mp_opponent_panel
    panel.name = match.opp_name or panel.name or "Opponent"
    panel.lives = match.opp_lives
    panel.status = match.opp_status
    local pvp = d.pvp or {}
    if pvp.oppFinished ~= nil then panel.blind_finished = pvp.oppFinished == true end
    G.GAME.mp_opponent_lives = match.opp_lives
end

function bom_match.apply_restored_game(d)
    if not G or not G.GAME then return end
    G.GAME.multiplayer = true
    G.GAME.mp_lives = match.my_lives
    G.GAME.mp_mode = match.mode
    G.GAME.mp_settings = match.settings
    G.GAME.mp_seed = match.seed
    G.GAME.mp_searching = false
    G.GAME.bom_room_code = d.code
    match.pvp_loss_pending = false
    match.pvp_pending_lives = nil
    if G.GAME.mp_pvp_results_seen == nil then
        G.GAME.mp_pvp_results_seen = match.pvp_results_seen or 0
    end
    apply_opponent_panel(d)
    pcall(function()
        G.GAME.banned_keys = G.GAME.banned_keys or {}
        G.GAME.banned_keys["bl_mp_nemesis"] = true
        G.GAME.bosses_used = G.GAME.bosses_used or {}
        G.GAME.bosses_used["bl_mp_nemesis"] = G.GAME.bosses_used["bl_mp_nemesis"] or 0
    end)
    pcall(function()
        if G.GAME.round_resets and G.GAME.round_resets.ante then
            match.current_ante = G.GAME.round_resets.ante
        end
    end)
    if not match.pre_match_features and not match.pre_match_mod_settings then
        bom_match.apply_fairness()
    end
end

function bom_match.apply_live_rejoin(d)
    local opp = d.opp or {}
    pcall(bom_match.apply_rejoin_rules, d)
    match.server_player_id = d.playerId
    if opp.name and opp.name ~= "" then match.opp_name = opp.name end
    if opp.lives ~= nil then match.opp_lives = tonumber(opp.lives) or match.opp_lives end
    match.opp_status = opp.status or match.opp_status
    pcall(function()
        if G and G.GAME and G.GAME.mp_opponent_panel then apply_opponent_panel(d) end
        local pvp = d.pvp or {}
        if G.GAME.mp_opponent_panel and pvp.oppScore ~= nil and bom_match.is_pvp_blind() then
            G.GAME.mp_opponent_panel.score = pvp.oppScore
        end
    end)
end

function bom_match.set_current_blind(ante, blind)
    match.current_ante = tonumber(ante) or match.current_ante
    match.current_blind = blind or match.current_blind
end

function bom_match.mark_pvp_submitted()
    match.pvp_submitted = true
    bom_match.transition(bom_match.PHASE.PVP_RESOLVE)
end

function bom_match.set_display_lives(n)
    n = tonumber(n)
    if not n then return end
    match.my_lives = n
    pcall(function() if G and G.GAME then G.GAME.mp_lives = n end end)
end

function bom_match.flush_pending_pvp_loss(reason)
    if not match.pvp_loss_pending then return false end
    local n = match.pvp_pending_lives
    match.pvp_loss_pending = false
    match.pvp_pending_lives = nil
    mp_log.warn("BOM_MATCH", "pending PvP loss was never shown, applied at %s (lives %s)", tostring(reason), tostring(n))
    if n then bom_match.set_display_lives(n) end
    return true
end

function bom_match.restore_pending_loss(server_lives)
    local n = tonumber(server_lives)
    if not n then return end
    match.pvp_loss_pending = true
    match.pvp_pending_lives = n
    match.won_without_life_loss = false
    bom_match.set_display_lives(n + 1)
end


local SEED_CHARS = "123456789ABCDEFGHIJKLMNPQRSTUVWXYZ"


function bom_match.different_seeds(s)
    s = s or match.settings or {}
    return s.different_seeds == true or s.same_seed == false
end

function bom_match.different_decks(s)
    s = s or match.settings or {}
    return s.different_decks == true or s.same_deck == false
end

function bom_match.clean_seed(raw)
    if type(raw) ~= "string" then return nil end
    local c = raw:upper():gsub("[^A-Z0-9]", ""):sub(1, 8)
    if c == "" or c == "RANDOM" then return nil end
    return c
end

function bom_match.custom_seed(s)
    s = s or match.settings or {}
    if bom_match.different_seeds(s) then return nil end
    return bom_match.clean_seed(s.custom_seed)
end

function bom_match.random_seed()
    local out = {}
    for i = 1, 8 do
        local n = math.random(1, #SEED_CHARS)
        out[i] = SEED_CHARS:sub(n, n)
    end
    return table.concat(out)
end

function bom_match.new_match_seed()
    return bom_match.custom_seed() or bom_match.random_seed()
end

function bom_match.timer_config(s)
    s = s or match.settings or {}
    local on = s.timer == true or s.ante_timer == true
    local base = tonumber(s.timer_base_seconds) or tonumber(s.ante_timer_base) or 120
    return {
        on = on,
        base = base,
        increment = tonumber(s.timer_increment_seconds) or 0,
        forgiveness = math.max(0, math.floor(tonumber(s.timer_forgiveness) or 0)),
    }
end

function bom_match.rules_for_me()
    local s = match.settings or {}
    local r = deep_copy(type(s.rules) == "table" and s.rules or {})
    if s.per_player_jokers and not match.is_host then
        r.starting_jokers = deep_copy(type(s.my_starting_jokers) == "table" and s.my_starting_jokers or {})
    end
    return bom_match.clean_rules(r)
end

function bom_match.pvp_win_money(s)
    s = s or match.settings or {}
    local n = math.floor(tonumber(s.pvp_win_money) or 0)
    return math.max(0, math.min(10, n))
end

function bom_match.preview_allowed(s)
    s = s or match.settings or {}
    return s.allow_score_preview == true
end

function bom_match.the_order_on()
    if not (G and G.GAME and G.GAME.multiplayer) then return false end
    local s = G.GAME.mp_settings or match.settings or {}
    return s.the_order == true
end

function bom_match.get_my_deck()
    local s = match.settings or {}
    if bom_match.different_decks(s) and not match.is_host and match.my_deck and match.my_deck ~= "" then
        return match.my_deck
    end
    return s.deck or "Red Deck"
end

function bom_match.set_my_deck(name)
    if type(name) ~= "string" or name == "" then return end
    if match.is_host then
        if bom_room and bom_room.update_setting then bom_room.update_setting("deck", name) end
    else
        match.my_deck = name
    end
    pcall(function()
        if bom_core and bom_core.send then bom_core.send({ type = "player_deck", deck = name }) end
    end)
end

function bom_match.on_opponent_deck(d)
    if d and type(d.deck) == "string" then match.opp_deck = d.deck end
end

function bom_match.on_match_seed(d)
    if not d or not d.seed then return end
    if d.seed ~= match.seed then
        mp_log.warn("BOM_MATCH", "server seed %s differs from local %s", tostring(d.seed), tostring(match.seed))
    end
end

function bom_match.on_ante_timer(d)
    if not d then return end
    local now = love and love.timer and love.timer.getTime() or os.time()
    local ms = tonumber(d.msLeft) or 0
    if d.state == "stopped" then
        match.ante_timer = nil
    else
        match.ante_timer = {
            target = d.target,
            paused = d.state == "paused" or d.paused == true,
            ends_at = now + ms / 1000,
            left = ms / 1000,
            forgiveness_left = tonumber(d.forgivenessLeft) or 0,
        }
    end
    if d.state == "expired" then
        local mine = d.target == "me"
        local text
        if d.forgiven then
            text = mine and mod_loc("Timer forgiven") or mod_loc("Opponent timer forgiven")
        else
            text = mine and mod_loc("Time up! -1 life") or mod_loc("Opponent ran out of time")
        end
        pcall(function()
            attention_text({ text = text, scale = 0.8, hold = 2, major = G.play or G.ROOM_ATTACH, backdrop_colour = mine and G.C.RED or G.C.BLUE, align = "cm", offset = { x = 0, y = -2.5 }, silent = true })
        end)
        if not d.forgiven and mine and tonumber(d.lives) then
            match.won_without_life_loss = false
        end
    end
    bom_match.refresh_ante_timer_ui()
end

local function timer_text()
    local t = match.ante_timer
    if not t then return nil end
    local left = t.paused and t.left or math.max(0, t.ends_at - (love.timer.getTime()))
    local secs = math.ceil(left)
    local clock = string.format("%d:%02d", math.floor(secs / 60), secs % 60)
    if t.target == "me" then
        return mod_loc("Ready up") .. " " .. clock .. (t.paused and (" " .. mod_loc("(paused)")) or "")
    end
    return mod_loc("Opponent timer") .. " " .. clock .. (t.paused and (" " .. mod_loc("(paused)")) or "")
end

function bom_match.refresh_ante_timer_ui()
    local text = nil
    if match.ante_timer and G and G.STAGE == G.STAGES.RUN and bom_match.is_in_match() then text = timer_text() end
    local in_hud = false
    if bom_ui and bom_ui.hud_timer_set then
        local ok, res = pcall(bom_ui.hud_timer_set, text and bom_ui.hud_timer_info(match.ante_timer, love.timer.getTime()) or nil)
        in_hud = ok and res and text ~= nil
    end
    if not text or in_hud then
        if G and G.MP_ANTE_TIMER then
            if not G.MP_ANTE_TIMER.REMOVED then G.MP_ANTE_TIMER:remove() end
            G.MP_ANTE_TIMER = nil
        end
        return
    end
    match.ante_timer_ui = match.ante_timer_ui or { text = "" }
    match.ante_timer_ui.text = text
    if G.MP_ANTE_TIMER and (G.MP_ANTE_TIMER.REMOVED or G.MP_ANTE_TIMER_TARGET ~= match.ante_timer.target) then
        if not G.MP_ANTE_TIMER.REMOVED then G.MP_ANTE_TIMER:remove() end
        G.MP_ANTE_TIMER = nil
    end
    if not G.MP_ANTE_TIMER then
        G.MP_ANTE_TIMER_TARGET = match.ante_timer.target
        G.MP_ANTE_TIMER = UIBox({
            definition = { n = G.UIT.ROOT, config = { align = "cm", colour = G.C.CLEAR }, nodes = {
                { n = G.UIT.R, config = { align = "cm", padding = 0.08, r = 0.1, colour = G.C.BLACK, emboss = 0.05 }, nodes = {
                    { n = G.UIT.T, config = { ref_table = match.ante_timer_ui, ref_value = "text", scale = 0.4, colour = match.ante_timer.target == "me" and G.C.RED or G.C.UI.TEXT_LIGHT, shadow = true } },
                } },
            } },
            config = { align = "tm", offset = { x = 0, y = 0.02 }, major = G.ROOM_ATTACH, bond = "Weak" },
        })
    end
end

function bom_match.tick_ante_timer()
    if match.ante_timer or (G and G.MP_ANTE_TIMER) or (bom_ui and bom_ui.hud_timer_active and bom_ui.hud_timer_active()) then bom_match.refresh_ante_timer_ui() end
end

function bom_match.install_the_order()
    if bom_match._the_order_installed or type(create_card) ~= "function" then return end
    bom_match._the_order_installed = true
    local orig_create_card = create_card
    create_card = function(_type, area, legendary, _rarity, skip_materialize, soulable, forced_key, key_append)
        if key_append and not forced_key and bom_match.the_order_on() then
            key_append = nil
        end
        return orig_create_card(_type, area, legendary, _rarity, skip_materialize, soulable, forced_key, key_append)
    end
end

function bom_match.apply_rejoin_rules(d)
    if type(d) ~= "table" then return end
    if type(d.myDeck) == "string" and d.myDeck ~= "" and not match.is_host then match.my_deck = d.myDeck end
    local c = d.anteClock
    if type(c) == "table" then
        bom_match.on_ante_timer({ state = c.paused and "paused" or "running", target = c.target, msLeft = c.msLeft })
    else
        match.ante_timer = nil
    end
end

mp_log.info("BOM_MATCH", "Multiplayer match state module loaded")
return bom_match
end
