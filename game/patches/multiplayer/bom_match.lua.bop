-- ============================================
-- MULTIPLAYER MATCH STATE — Server-authoritative match lifecycle.
-- Server tracks lives, resolves PvP scores, declares winners.
-- Client sends events, receives authoritative state updates.
-- ============================================

local bom_match = {}

-- ============================================
-- MATCH PHASES
-- ============================================
bom_match.PHASE = {
    NONE        = "none",
    LOBBY       = "lobby",
    STARTING    = "starting",
    PLAYING     = "playing",
    PVP_BLIND   = "pvp_blind",
    PVP_RESOLVE = "pvp_resolve",
    MATCH_END   = "match_end",
}

bom_match.MODE = {
    NEMESIS   = "nemesis",
    FACEOFF   = "faceoff",
    ASCENSION = "ascension",
    -- Legacy aliases
    ATTRITION = "nemesis",
    SHOWDOWN  = "faceoff",
    SURVIVAL  = "ascension",
}

-- ============================================
-- STAGE 2: TRANSITION TABLE — valid phase→phase moves for the state machine
-- Any direct match.phase assignment MUST go through bom_match.transition().
-- reset() is the only exception (hard reset, bypasses guards).
-- ============================================
local TRANSITIONS = {
    [bom_match.PHASE.NONE]        = { [bom_match.PHASE.LOBBY]       = true },
    [bom_match.PHASE.LOBBY]       = { [bom_match.PHASE.STARTING]    = true, [bom_match.PHASE.PLAYING]    = true, [bom_match.PHASE.NONE]      = true },
    [bom_match.PHASE.STARTING]    = { [bom_match.PHASE.PLAYING]     = true },
    [bom_match.PHASE.PLAYING]     = { [bom_match.PHASE.PVP_BLIND]   = true, [bom_match.PHASE.MATCH_END]  = true },
    [bom_match.PHASE.PVP_BLIND]   = { [bom_match.PHASE.PVP_RESOLVE] = true, [bom_match.PHASE.PLAYING]    = true, [bom_match.PHASE.MATCH_END]  = true },
    [bom_match.PHASE.PVP_RESOLVE] = { [bom_match.PHASE.PLAYING]     = true, [bom_match.PHASE.MATCH_END]  = true },
    [bom_match.PHASE.MATCH_END]   = { [bom_match.PHASE.LOBBY]       = true, [bom_match.PHASE.PLAYING]    = true, [bom_match.PHASE.NONE] = true },
}
local phase_change_listeners = {}

-- ============================================
-- DEFAULT SETTINGS
-- ============================================
-- FEATURE: Complete lobby settings matching balatromp.com spec
-- Ported from BalatroMultiplayer v0.3.3 lobby options
local DEFAULT_SETTINGS = {
    mode                    = "nemesis",
    starting_lives          = 4,
    pvp_start_round         = 2,
    showdown_starting_antes = 1,
    win_ante                = false,
    stake                   = 1,
    deck                    = "Red Deck",
    different_decks         = false,
    different_seeds         = false,
    custom_seed             = "random",
    gold_on_life_loss       = true,
    no_gold_on_round_loss   = false,
    death_on_round_loss     = true,
    pvp_win_money           = 0,
    life_steal              = false,
    timer                   = false,
    timer_base_seconds      = 120,
    timer_increment_seconds = 0,
    timer_forgiveness       = 0,
    pvp_countdown_seconds   = 3,
    the_order               = false,
    balance_enabled         = true,
    multiplayer_jokers      = true,
    normal_bosses           = false,
    allow_advisor           = false,
    allow_hand_optimizer    = false,
    allow_score_preview     = false,
    allow_fast_speed        = false,
    allow_score_speed       = false,
    allow_skip_score        = false,
    show_seed               = false,
    per_player_jokers       = false,
    my_starting_jokers      = {},
    rules                   = {},
    party_kind              = "br",
    party_blind_seconds     = 180,
    br_losers               = 1,
    br_ties                 = "all",
    br_sudden_death         = false,
    party_swap              = false,
    team_size               = 2,
    team_share              = 100,
    team_auto               = true,
    raid_per_player         = 100,
    raid_scaling            = 0,
    raid_curve              = 2,
    raid_mvp_bonus          = 3,
    raid_lives              = 3,
    raid_every_blind        = false,
    party_every_blind       = false,
    spectate                = true,
    spectate_jokers         = true,
    spectate_wait           = false,
}
bom_match.PARTY_KEYS = {
    party_kind = true, party_blind_seconds = true, br_losers = true, br_ties = true, br_sudden_death = true, party_swap = true,
    team_size = true, team_share = true, team_auto = true, raid_per_player = true, raid_scaling = true, raid_curve = true, raid_lives = true, raid_mvp_bonus = true, raid_every_blind = true, party_every_blind = true,
    spectate = true, spectate_jokers = true, spectate_wait = true,
}
bom_match.DEFAULT_SETTINGS = DEFAULT_SETTINGS

local function deep_copy(v)
    if type(v) ~= "table" then return v end
    local t = {}
    for k, x in pairs(v) do t[k] = deep_copy(x) end
    return t
end
bom_match.deep_copy = deep_copy

bom_match.MP_EXCLUDED_RULES = { stake = true, back = true, win_ante = true, endless = true, start_ante = true }

function bom_match.clean_rules(v)
    if type(v) ~= "table" or not RunRules then return {} end
    local d = RunRules.diff(RunRules.normalize(v))
    for k in pairs(bom_match.MP_EXCLUDED_RULES) do d[k] = nil end
    return d
end

function bom_match.defaults()
    return deep_copy(DEFAULT_SETTINGS)
end

function bom_match.non_default_keys(s)
    local out = {}
    for k, def in pairs(DEFAULT_SETTINGS) do
        if type(def) ~= "table" and s[k] ~= nil and s[k] ~= def then out[#out + 1] = k end
    end
    table.sort(out)
    return out
end

-- ============================================
-- MATCH STATE — Updated by server pushes + local events
-- ============================================
local match = {
    phase        = "none",
    mode         = "nemesis",
    settings     = {},
    is_host      = false,
    room_code    = nil,
    seed         = nil,

    my_name      = "Player",
    my_ready     = false,
    opp_name     = "Opponent",
    opp_ready    = false,
    opp_version  = nil,
    opp_profile  = nil,

    my_lives     = 5,
    opp_lives    = 5,

    my_score     = 0,
    opp_score    = 0,
    pvp_submitted = false,
    pvp_received  = false,
    current_ante  = 1,
    current_blind = "S",

    pvp_wins      = 0,
    pvp_losses    = 0,
    sabotages_used = 0,
    won_without_life_loss = true,

    match_over    = false,
    match_result  = nil,
    profile_sent  = false,
    disconnect_handled = false,

    -- Server-driven fields
    server_player_id = nil,        -- Our player ID on the server (0 or 1)
    opp_blind_finished = false,    -- Opponent finished their blind (from server)
    opp_status = "active",         -- From server: active | eliminated

    -- FEATURE: Nemesis blind visual system (ported from BalatroMultiplayer-0.3.3)
    opp_blind_col = 1,             -- Opponent's blind column color (1-25)
    end_pvp = false,               -- Server signaled PvP round end
}

-- ============================================
-- RESET
-- ============================================

function bom_match.reset()
    pcall(function() bom_spectate.wait_over() end)
    -- FIX: Delete the MP run save to prevent Continue after match ends.
    -- Use remove_save() only — NOT G:delete_run() — because delete_run() destroys
    -- ALL visual elements (SPLASH_BACK, main menu UI, HUD, stage objects) which
    -- causes a black screen when returning to the main menu or cancelling from lobby.
    -- G:delete_run() is called by the callers of reset() when a full state transition
    -- is needed (mp_leave_lobby, match end events). Here we only need to clear the file.
    pcall(function()
        if remove_save then
            remove_save()
        end
    end)
    match.phase        = bom_match.PHASE.NONE
    match.ante_timer   = nil
    match.opp_deck     = nil
    match.mode         = DEFAULT_SETTINGS.mode
    match.settings     = deep_copy(DEFAULT_SETTINGS)
    match.is_host      = false
    match.room_code    = nil
    match.visibility   = nil
    match.waiting_guest = nil
    match.seed         = nil
    match.my_name      = "Player"
    match.my_ready     = false
    match.opp_name     = "Opponent"
    match.opp_ready    = false
    match.opp_version  = nil
    match.opp_profile  = nil
    match.opp_bot      = nil
    match.my_lives     = DEFAULT_SETTINGS.starting_lives
    match.opp_lives    = DEFAULT_SETTINGS.starting_lives
    match.sudden_death = 0
    match.server_final_ante = nil
    if bom_match.apply_sudden_death_label then bom_match.apply_sudden_death_label() end
    match.my_score     = 0
    match.opp_score    = 0
    match.pvp_submitted = false
    match.pvp_received  = false
    match.current_ante  = 1
    match.current_blind = "S"
    match.pvp_wins      = 0
    match.pvp_losses    = 0
    match.sabotages_used = 0
    match.won_without_life_loss = true
    match.match_over    = false
    match.match_result  = nil
    match.disconnect_handled = false
    match.profile_sent  = false
    match.server_player_id = nil
    match.opp_blind_finished = false
    match.opp_status = "active"
    match.rematch_voted = false
    match._last_sent_location = nil
    match.my_location = nil
    match.opp_location = nil
    match.roster, match.match_id, match.ranked, match.ruleset = nil, nil, nil, nil
    if bom_ui then bom_ui._locs = {} end
    match.rematch_votes = { false, false }
    match.room_closed_text = nil
    match.opp_blind_col = 1
    match.end_pvp = false
    match.pvp_results_seen = 0
    match.end_reason = nil
    -- FIX P1#37: clear mp_blind_loss_pending flag on reset so a stale Lose-A-Life
    -- button doesn't render for one frame after disconnect / rematch / return-to-lobby.
    pcall(function()
        if G and G.GAME then
            G.GAME.mp_blind_loss_pending = false
        end
    end)
    match.pvp_loss_pending = false
    match.pvp_pending_lives = nil
    -- FIX pixel-perfect: clear the pre-start flag so solo HUD rebuilds don't include
    -- the Lobby Info button row.
    bom_match._starting_mp_run = false
    mp_log.info("BOM_MATCH", "reset complete")
end

-- Called by bom_room.do_mp_start_run() BEFORE G.FUNCS.start_run() so that the
-- HUD builder can check this flag synchronously at construction time.
function bom_match.set_starting_mp_run()
    bom_match._starting_mp_run = true
    if G and G.SETTINGS and not G.SETTINGS.tutorial_complete then
