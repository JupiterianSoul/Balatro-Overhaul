end


function bom_match.on_server_state_update(data)
    if not data then return end

    mp_log.info("BOM_MATCH", "server_state: phase=%s ante=%s blind=%s pvp=%s myLives=%s oppLives=%s event=%s",
        tostring(data.phase), tostring(data.currentAnte), tostring(data.currentBlind),
        tostring(data.isPvpBlind), tostring(data.myLives), tostring(data.oppLives), tostring(data.event))

    if data.playerId ~= nil then
        match.server_player_id = data.playerId
    end
    if data.phase ~= "finished" then
        bom_match.set_final_state(data.finalAnte, data.suddenDeath)
    end

    if data.myLives ~= nil then
        local loss_pending = match.pvp_loss_pending
            or (G and G.GAME and G.GAME.mp_blind_loss_pending)
        if loss_pending and not match.pvp_loss_pending and data.myLives < (match.my_lives or 0) then
            match.server_lives_after_loss = data.myLives
        end
        if not loss_pending or data.phase == "finished" then
            local old_lives = match.my_lives
            match.my_lives = data.myLives
            pcall(function()
                if G and G.GAME then G.GAME.mp_lives = data.myLives end
            end)
            if data.myLives < old_lives then
                pcall(function()
                    if bom_ui and bom_ui.animate_life_loss then
                        bom_ui.animate_life_loss()
                    end
                end)
            end
        end
    end
    if data.oppLives ~= nil then
        match.opp_lives = data.oppLives
        pcall(function()
            if G and G.GAME then
                G.GAME.mp_opponent_lives = data.oppLives
                if G.GAME.mp_opponent_panel then
                    G.GAME.mp_opponent_panel.lives = data.oppLives
                end
            end
        end)
    end

    if data.oppName and data.oppName ~= "" then
        match.opp_name = bom_match.resolve_name(data.oppName, false)
        pcall(function()
            if G and G.GAME and G.GAME.mp_opponent_panel then
                G.GAME.mp_opponent_panel.name = match.opp_name
            end
        end)
    end

    if data.oppStatus then
        match.opp_status = data.oppStatus
        pcall(function()
            if G and G.GAME and G.GAME.mp_opponent_panel then
                G.GAME.mp_opponent_panel.status = data.oppStatus
            end
        end)
    end

    if data.oppBlindFinished ~= nil then
        match.opp_blind_finished = data.oppBlindFinished
        pcall(function()
            if G and G.GAME and G.GAME.mp_opponent_panel then
                G.GAME.mp_opponent_panel.blind_finished = data.oppBlindFinished
            end
        end)
    end

    if data.myBlindFinished ~= nil then
        match.pvp_submitted = match.pvp_submitted or (data.myBlindFinished == true)
    end
    if data.myScore ~= nil and type(data.myScore) == "number" then
        match.my_score = data.myScore
    end
    if data.oppScore ~= nil and type(data.oppScore) == "number" then
        match.opp_score = data.oppScore
        pcall(function()
            if G and G.GAME and G.GAME.mp_opponent_panel then
                G.GAME.mp_opponent_panel.score = data.oppScore
            end
        end)
    end

    if data.isPvpBlind ~= nil then
    end

    if data.phase then
        if data.phase == "finished" and not match.match_over then
            local result = "lose"
            if data.winner == match.server_player_id then result = "win" end
            bom_match.end_match(result, data.winReason or "server", { from_server = true })
        elseif data.phase == "playing" and match.phase == bom_match.PHASE.PVP_RESOLVE then
            bom_match.transition(bom_match.PHASE.PLAYING)
            match.pvp_submitted = false
            match.pvp_received = false
            match.opp_blind_finished = false
            pcall(function()
                if G and G.GAME then
                    G.GAME.mp_in_boss_blind = false
                    G.GAME.mp_boss_result_pending = false
                end
            end)
        end
    end
end


function bom_match.on_pvp_resolved(data)
    if not data then return end
    if match.phase == bom_match.PHASE.NONE then return end
    pcall(function() bom_pvp_hud._pvp_finished_token = nil end)
    pcall(function() bom_spectate.wait_over() end)

    pcall(function()
        if bom_ui and bom_ui.hide_pvp_waiting then
            bom_ui.hide_pvp_waiting()
        end
    end)

    local result = data.result or "draw"
    local my_score = data.myScore or 0
    local opp_score = data.oppScore or 0
    if not data.matchEnded then
        bom_match.set_final_state(data.finalAnte, data.suddenDeath)
    end

    mp_log.info("BOM_MATCH", "pvp_resolved: result=%s me=%s opp=%s myLives=%s oppLives=%s",
        result, tostring(my_score), tostring(opp_score), tostring(data.myLives), tostring(data.oppLives))

    if data.myLives ~= nil then
        local old_lives = match.my_lives
        if result == "lose" then
            local new_lives = tonumber(data.myLives)
            local in_blind = false
            pcall(function()
                in_blind = G and G.GAME and G.GAME.facing_blind and bom_nemesis
                    and bom_nemesis.in_unresolved_pvp_blind() or false
            end)
            if new_lives and new_lives >= 0 and new_lives < 1000 and in_blind then
                match.pvp_loss_pending = true
                match.pvp_pending_lives = new_lives
                match.won_without_life_loss = false
            elseif new_lives and new_lives >= 0 and new_lives < 1000 then
                mp_log.warn("BOM_MATCH", "pvp_resolved lose arrived outside the PvP blind, lives applied now")
                match.pvp_loss_pending = false
                match.pvp_pending_lives = nil
                match.won_without_life_loss = false
                bom_match.set_display_lives(new_lives)
                pcall(function()
                    if bom_ui and bom_ui.animate_life_loss then bom_ui.animate_life_loss() end
                end)
            else
                mp_log.warn("BOM_MATCH", "pvp_resolved: invalid myLives=%s, ignored", tostring(data.myLives))
            end
        else
            local new_lives = tonumber(data.myLives)
            if new_lives and new_lives >= 0 and new_lives < 1000 then
                match.my_lives = new_lives
                pcall(function()
                    if G and G.GAME then G.GAME.mp_lives = new_lives end
                end)
            end
        end
    end
    if data.oppLives ~= nil then
        match.opp_lives = data.oppLives
        pcall(function()
            if G and G.GAME then
                G.GAME.mp_opponent_lives = data.oppLives
                if G.GAME.mp_opponent_panel then
                    G.GAME.mp_opponent_panel.lives = data.oppLives
                end
            end
        end)
    end

    match.pvp_results_seen = (match.pvp_results_seen or 0) + 1
    pcall(function()
        if G and G.GAME then G.GAME.mp_pvp_results_seen = (G.GAME.mp_pvp_results_seen or 0) + 1 end
    end)

    if result == "win" then
        match.pvp_wins = match.pvp_wins + 1
        local bonus = (bom_party and bom_party.active()) and 0 or bom_match.pvp_win_money()
        if bonus > 0 then
            pcall(function() ease_dollars(bonus) end)
            mp_log.info("BOM_MATCH", "pvp win bonus $%d", bonus)
        end
    elseif result == "lose" then
        match.pvp_losses = match.pvp_losses + 1
    end

    pcall(function() if bom_party_run then bom_party_run.apply_rewards(data) end end)

    pcall(function()
        if G.STAGE ~= G.STAGES.RUN then
            return
        elseif data.solo and bom_party then
            bom_party.solo_note()
        elseif bom_party_run and bom_party_run.show_result(data) then
            return
        elseif bom_ui and bom_ui.show_pvp_result then
            bom_ui.show_pvp_result(result, my_score, opp_score)
        end
    end)


    match.pvp_submitted = false
    match.pvp_received = false
    match.opp_blind_finished = false
    match.my_score = 0
    match.opp_score = 0


    match.end_pvp = true

    pcall(bom_match.release_unplayed_pvp_blind)

    pcall(function()
        if G and G.GAME and G.GAME.round_resets then
            G.GAME.round_resets.pvp_blind_choices = nil
        end
        if G and G.GAME and G.GAME.blind and not G.GAME.facing_blind then
            G.GAME.blind.pvp = false
        end
    end)

    if data.matchEnded then
        local end_result = "lose"
        if data.winner == match.server_player_id then end_result = "win" end
        bom_match.end_match(end_result, data.winReason or "elimination")
    else
        bom_match.transition(bom_match.PHASE.PLAYING)
        pcall(function()
            if G and G.GAME then
                G.GAME.mp_in_boss_blind = false
                G.GAME.mp_boss_result_pending = false
            end
        end)
    end
end


function bom_match.on_opponent_blind_finished(data)
    if not data then return end

    mp_log.info("BOM_MATCH", "opponent_blind_finished: lives=%s finished=%s", tostring(data.lives), tostring(data.finished))

    match.opp_blind_finished = true

    if data.lives then
        match.opp_lives = data.lives
    end

    pcall(function()
        if G and G.GAME and G.GAME.mp_opponent_panel then
            G.GAME.mp_opponent_panel.blind_finished = true
            if data.lives then G.GAME.mp_opponent_panel.lives = data.lives end
            if data.score then G.GAME.mp_opponent_panel.score = data.score end
        end
    end)
end


function bom_match.lose_life(reason)
    mp_log.debug("BOM_MATCH", "lose_life() deprecated no-op (server-authoritative). reason=%s", tostring(reason))
end

function bom_match.on_opponent_life_update(_lives)
    mp_log.debug("BOM_MATCH", "on_opponent_life_update() deprecated no-op (server-authoritative)")
end

function bom_match.on_opponent_eliminated(_data)
    mp_log.debug("BOM_MATCH", "on_opponent_eliminated() deprecated no-op (server-authoritative)")
end


function bom_match.request_state_sync()
    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({ type = "request_state" })
            mp_log.debug("BOM_MATCH", "request_state_sync: sent request_state to server")
        end
    end)
end

function bom_match.check_desync(data)
    if not data then return end
    if not bom_match.is_in_match() then return end

    local discrepant = false

    if data.myLives ~= nil and data.myLives ~= match.my_lives then
        mp_log.warn("BOM_MATCH", "DESYNC: my_lives server=%s local=%s",
            tostring(data.myLives), tostring(match.my_lives))
        discrepant = true
    end
    if data.currentAnte ~= nil and data.currentAnte ~= match.current_ante then
        mp_log.warn("BOM_MATCH", "DESYNC: ante server=%s local=%s",
            tostring(data.currentAnte), tostring(match.current_ante))
        discrepant = true
    end
    if data.oppLives ~= nil and data.oppLives ~= match.opp_lives then
        mp_log.warn("BOM_MATCH", "DESYNC: opp_lives server=%s local=%s",
            tostring(data.oppLives), tostring(match.opp_lives))
        discrepant = true
    end

    if discrepant then
        mp_log.warn("BOM_MATCH", "DESYNC detected -- requesting authoritative state from server")
        bom_match.request_state_sync()
    end
end

bom_match.RANDOM_STAKE_MAX = 8

function bom_match.match_stake(s)
    s = s or match.settings or {}
    if s.stake == "random" then
        local r = tonumber(s.rolled_stake)
        if r and r >= 1 and r <= bom_match.RANDOM_STAKE_MAX and r == math.floor(r) then return r end
        return 1
    end
    local n = tonumber(s.stake)
    if n and n >= 1 then return math.floor(n) end
    return 1
end

function bom_match.roll_match_extras(seed)
    local s = match.settings or {}
    if s.stake == "random" then
        s.rolled_stake = math.random(1, bom_match.RANDOM_STAKE_MAX)
    else
        s.rolled_stake = nil
    end
    s.match_roll = tostring(seed or s.match_roll or os.time())
    mp_log.info("BOM_MATCH", "match roll: stake=%s rolled=%s roll=%s", tostring(s.stake), tostring(s.rolled_stake), tostring(s.match_roll))
end

function bom_match.apply_match_roll(d)
    if type(d) ~= "table" then return end
    local s = match.settings or {}
    if d.rolled_stake ~= nil then s.rolled_stake = tonumber(d.rolled_stake) end
    if type(d.match_roll) == "string" then s.match_roll = d.match_roll end
    mp_log.info("BOM_MATCH", "match roll received: stake=%s rolled=%s roll=%s", tostring(s.stake), tostring(s.rolled_stake), tostring(s.match_roll))
end

local PVP_BOSSES = {"bl_hook", "bl_ox", "bl_house", "bl_wheel", "bl_arm", "bl_club", "bl_fish", "bl_psychic", "bl_goad", "bl_water",
    "bl_window", "bl_manacle", "bl_eye", "bl_mouth", "bl_plant", "bl_serpent", "bl_pillar", "bl_needle", "bl_head", "bl_tooth", "bl_flint", "bl_mark"}
local PVP_FINAL_BOSSES = {"bl_final_acorn", "bl_final_leaf", "bl_final_bell", "bl_final_heart"}
bom_match.PVP_BOSSES, bom_match.PVP_FINAL_BOSSES = PVP_BOSSES, PVP_FINAL_BOSSES

local function roll_hash(str)
    local h = 5381
    for i = 1, #str do h = (h * 33 + str:byte(i)) % 2147483647 end
    return h
end

function bom_match.pvp_boss_on(s)
    s = s or match.settings or {}
    if s.pvp_boss_effect ~= true then return false end
    if bom_party and bom_party.active and bom_party.active() then return false end
    local mode = s.mode or match.mode or "nemesis"
    return mode == "nemesis" or mode == "faceoff"
end

function bom_match.pvp_boss_for(ante, s)
    s = s or match.settings or {}
    ante = math.max(1, math.floor(tonumber(ante) or 1))
    local final = bom_match.final_ante_for(s, bom_match.match_stake(s))
    local roll = tostring(s.match_roll or match.seed or "")
    local used, pick = {}, nil
    for a = 1, ante do
        local src = (a >= 2 and a % final == 0) and PVP_FINAL_BOSSES or PVP_BOSSES
        local pool, fresh = {}, {}
        for _, k in ipairs(src) do
            local b = G and G.P_BLINDS and G.P_BLINDS[k]
            if b and b.boss and (src == PVP_FINAL_BOSSES or (b.boss.min or 1) <= a) then
                pool[#pool + 1] = k
                if not used[k] then fresh[#fresh + 1] = k end
            end
        end
        if #fresh == 0 then fresh = pool end
        if #fresh == 0 then return nil end
        pick = fresh[roll_hash(roll .. ":" .. a) % #fresh + 1]
        used[pick] = true
    end
    return pick
end

function bom_match.final_ante_for(s, stake)
    s = s or {}
    local w = tonumber(s.win_ante)
    if w and w >= 1 and w <= 999 and w == math.floor(w) then return w end
    stake = tonumber(stake) or bom_match.match_stake(s)
    if stake >= 9 and stake <= 12 then return stake + 1 end
    return 8
end

function bom_match.final_ante()
    local fa = tonumber(match.server_final_ante)
    if fa and fa >= 1 then return fa end
    local stake = nil
    pcall(function() if G and G.GAME and G.GAME.stake then stake = tonumber(G.GAME.stake) end end)
    return bom_match.final_ante_for(match.settings, stake)
end

function bom_match.server_decides_final()
    if not bom_match.is_in_match() then return false end
    local mode = match.mode or (match.settings and match.settings.mode) or "nemesis"
    if mode == "vanilla" or mode == "ascension" then return false end
    return bom_match.is_blind_pvp(bom_match.final_ante(), "L") == true
end

function bom_match.get_sudden_death()
    return match.sudden_death or 0
end

function bom_match.set_final_state(final_ante, sudden_death)
    local fa = tonumber(final_ante)
    if fa and fa >= 1 then match.server_final_ante = fa end
    local sd = tonumber(sudden_death)
    if sd and sd >= 0 and sd ~= (match.sudden_death or 0) then
        match.sudden_death = sd
        mp_log.info("BOM_MATCH", "sudden death round=%s final_ante=%s", tostring(sd), tostring(match.server_final_ante))
        bom_match.apply_sudden_death_label()
    end
end

function bom_match.apply_sudden_death_label()
    pcall(function()
        local loc = G and G.localization and G.localization.descriptions and G.localization.descriptions.Blind
        local e = loc and loc["bl_mp_nemesis"]
r 13 1300 %20%20%20%20%20%20%20%20 -
l 108
        if (match.sudden_death or 0) > 0 then
            e.name = mod_loc("Sudden Death")
            e.text = { mod_loc("Sudden death: score more"), mod_loc("or lose a life") }
        else
            e.name = mod_loc("The Rival")
            e.text = { "Score more points than", "your opponent to win!" }
        end
        if loc_parse_string then
            e.text_parsed = {}
            for _, line in ipairs(e.text) do e.text_parsed[#e.text_parsed + 1] = loc_parse_string(line) end
            e.name_parsed = { loc_parse_string(e.name) }
        end
    end)
end

function bom_match.apply_sudden_death_blinds()
    if (match.sudden_death or 0) <= 0 or not bom_match.is_in_match() then return end
    pcall(function()
        local rr = G.GAME.round_resets
        rr.blind_states.Small = 'Skipped'
        rr.blind_states.Big = 'Skipped'
        rr.blind_states.Boss = 'Upcoming'
        G.GAME.blind_on_deck = 'Boss'
        mp_log.info("BOM_MATCH", "sudden death: only the Nemesis blind is played at ante %s", tostring(rr.ante))
    end)
end


function bom_match.end_match(result, reason, opts)
    if match.match_over then return end
    if result == "win" and reason == "run_completed" and not (opts and opts.from_server)
        and bom_core and bom_core.is_connected and bom_core.is_connected() and G and G.GAME then
        if not G.GAME.mp_run_claimed then
            G.GAME.mp_run_claimed = true
            if bom_party and bom_party.active() then return end
            mp_log.info("BOM_MATCH", "run completed, asking the server for the verdict")
            pcall(function()
                bom_core.send({ type = "match_finished", result = result, reason = reason, lives = match.my_lives })
            end)
        end
        return
    end
    match.match_over = true
    match.match_result = result
    match.end_reason = reason
    pcall(function()
        if bom_ranked and bom_ranked.session_add and not (bom_party and bom_party.active()) then
            bom_ranked.session_add({
                result = result, reason = reason, opp = match.opp_name, mode = match.mode,
                ante = match.current_ante, pvp_wins = match.pvp_wins, pvp_losses = match.pvp_losses,
            })
        end
    end)
    pcall(function() bom_match.flush_pending_pvp_loss("match_end") end)
    bom_match.transition(bom_match.PHASE.MATCH_END)
    pcall(function() bom_spectate.wait_over() end)
    pcall(function()
        if bom_ui and bom_ui.hide_pvp_waiting then bom_ui.hide_pvp_waiting() end
    end)

    mp_log.info("BOM_MATCH", "end_match: result=%s reason=%s myLives=%s oppLives=%s",
        tostring(result), tostring(reason), tostring(match.my_lives), tostring(match.opp_lives))

    bom_match.restore_fairness()

    pcall(function()
        if bom_core and bom_core.send and not (opts and opts.from_server) and not (bom_party and bom_party.active()) then
            bom_core.send({
                type = "match_finished",
                result = result,
                reason = reason or "normal",
                lives = match.my_lives,
            })
        end
    end)

    pcall(function() if bom_ui and bom_ui.cleanup_end_game_state then bom_ui.cleanup_end_game_state() end end)
    pcall(function()
        if bom_ui and bom_ui.send_end_game_data and result ~= "draw"
            and not (bom_rejoin and bom_rejoin.is_closing_reason and bom_rejoin.is_closing_reason(reason))
            and bom_core and bom_core.is_connected and bom_core.is_connected() then
            bom_ui.send_end_game_data()
        end
    end)

    pcall(function()
        if bom_rewards and bom_rewards.on_match_end then
            bom_rewards.on_match_end({
                result = result,
                reason = reason,
                pvp_wins = match.pvp_wins,
                pvp_losses = match.pvp_losses,
            })
        end
    end)


    if bom_rejoin and bom_rejoin.on_match_end_local and bom_rejoin.on_match_end_local(result, reason) then
        return
    end
    if result == "draw" and bom_rejoin and bom_rejoin.exit_to_menu then
        bom_rejoin.exit_to_menu({ result = result, reason = reason, opp_name = match.opp_name })
        return
    end

    match.rematch_voted = false

    if result == "win" and G and G.GAME and G.GAME.multiplayer then
