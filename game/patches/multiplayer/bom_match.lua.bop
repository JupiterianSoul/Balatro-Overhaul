    end
end

function bom_match.open_pool()
    if bom_playback and bom_playback.active() then return bom_playback.open_pool() end
    return true
end

bom_match.reset()

-- ============================================
-- ACCESSORS
-- ============================================

function bom_match.get_state()     return match end
function bom_match.get_phase()     return match.phase end
function bom_match.get_mode()      return match.mode end
function bom_match.get_settings()  return match.settings end

bom_match.SETTING_ALIASES = {}

local function rule_flag(primary, alias, default)
    local s = match.settings or {}
    if type(s[primary]) == "boolean" then return s[primary] end
    if type(s[alias]) == "boolean" then return s[alias] end
    return default
end

function bom_match.rule_comeback_money()
    return rule_flag("gold_on_life_loss", "comeback_money", true)
end

function bom_match.rule_no_gold_on_round_loss()
    return rule_flag("no_gold_on_round_loss", "no_gold_on_round_loss", false)
end

function bom_match.rule_life_on_round_loss()
    return rule_flag("death_on_round_loss", "non_pvp_life_loss", true)
end

function bom_match.round_loss_costs_life()
    return match.mode == "ascension" or bom_match.rule_life_on_round_loss()
end

function bom_match.comeback_amount()
    local stake = 1
    pcall(function() stake = tonumber(G.GAME.stake) or 1 end)
    return stake >= 6 and 2 or 3
end

function bom_match.round_pay_cap()
    return 10
end

function bom_match.mark_round_lost()
    local costs = bom_match.round_loss_costs_life()
    pcall(function()
        G.GAME.mp_round_lost = true
        G.GAME.mp_blind_loss_pending = costs
        if costs then match.won_without_life_loss = false end
    end)
    match.server_lives_after_loss = nil
    mp_log.info("BOM_MATCH", "round lost: life=%s no_gold=%s comeback=%s", tostring(costs),
        tostring(bom_match.rule_no_gold_on_round_loss()), tostring(bom_match.rule_comeback_money()))
    return costs
end

bom_match.MP_MAX_SPEED = 4

function bom_match.speed_rules_on()
    if not (G and G.SETTINGS and G.STAGES and G.STAGE == G.STAGES.RUN and G.GAME and G.GAME.multiplayer) then return false end
    return true
end

function bom_match.speed_rule(what)
    if not bom_match.speed_rules_on() then return false end
    local fair = rawget(_G, "MPFair")
    if fair and fair.limited then return fair.limited(what) end
    return true
end

function bom_match.enforce_speed()
    local S = G and G.SETTINGS
    if not S then return end
    if bom_playback and bom_playback.active() then return end
    if bom_match.speed_rules_on() then
        if not S.mp_speed_saved then
            S.mp_speed_saved = { speed = S.GAMESPEED, score = S.fast_score_resolve, skip = S.skip_score_animation and true or false }
        end
        if bom_match.speed_rule("speed") and (tonumber(S.GAMESPEED) or 1) > bom_match.MP_MAX_SPEED then S.GAMESPEED = bom_match.MP_MAX_SPEED end
        if bom_match.speed_rule("score") and S.fast_score_resolve ~= 1.0 then S.fast_score_resolve = 1.0 end
        if bom_match.speed_rule("skip") and S.skip_score_animation then S.skip_score_animation = false end
    elseif S.mp_speed_saved and not (G.STAGES and G.STAGE == G.STAGES.RUN and G.GAME and G.GAME.multiplayer) then
        local sv = S.mp_speed_saved
        S.mp_speed_saved = nil
        if tonumber(sv.speed) then S.GAMESPEED = tonumber(sv.speed) end
        if tonumber(sv.score) then S.fast_score_resolve = tonumber(sv.score) end
        S.skip_score_animation = sv.skip == true
        pcall(function() G:save_settings() end)
    end
end

function bom_match.take_server_lives_after_loss()
    local n = match.server_lives_after_loss
    match.server_lives_after_loss = nil
    return n
end
function bom_match.is_active()     return match.phase ~= bom_match.PHASE.NONE end
function bom_match.is_in_match()
    return match.phase == bom_match.PHASE.PLAYING
        or match.phase == bom_match.PHASE.PVP_BLIND
        or match.phase == bom_match.PHASE.PVP_RESOLVE
end
function bom_match.is_pvp_blind()
    return match.phase == bom_match.PHASE.PVP_BLIND
        or match.phase == bom_match.PHASE.PVP_RESOLVE
end
function bom_match.is_host_player() return match.is_host end
function bom_match.is_match_over() return match.match_over end
function bom_match.get_my_lives()  return match.my_lives end
function bom_match.get_opp_lives() return match.opp_lives end

-- ============================================
-- STAGE 2: GUARDED PHASE TRANSITION
-- Returns true on success or same-phase no-op; false on rejected transition.
-- ============================================

function bom_match.transition(new_phase)
    local old = match.phase
    if old == new_phase then return true end
    local allowed = TRANSITIONS[old]
    if not (allowed and allowed[new_phase]) then
        mp_log.warn("BOM_MATCH", "rejected transition: %s -> %s", tostring(old), tostring(new_phase))
        return false
    end
    match.phase = new_phase
    mp_log.debug("BOM_MATCH", "phase: %s -> %s", tostring(old), tostring(new_phase))
    for _, fn in ipairs(phase_change_listeners) do
        pcall(fn, old, new_phase)
    end
    return true
end

-- Stage 2: Subscribe to phase changes. callback receives (old_phase, new_phase).
function bom_match.on_phase_change(fn)
    if type(fn) == "function" then table.insert(phase_change_listeners, fn) end
end

-- Stage 2: Unsubscribe from phase changes.
function bom_match.off_phase_change(fn)
    for i = #phase_change_listeners, 1, -1 do
        if phase_change_listeners[i] == fn then table.remove(phase_change_listeners, i) end
    end
end

-- ============================================
-- LOCAL PVP CHECK — Used for local prediction; server is authoritative
-- ============================================

-- FEATURE: Local PvP check — delegates to gamemode system
function bom_match.is_blind_pvp(ante, blind_type)
    ante = ante or match.current_ante
    blind_type = blind_type or match.current_blind
    local skipped = G and G.GAME and G.GAME.mp_pvp_skipped
    if skipped and skipped[tostring(ante) .. ":" .. tostring(blind_type)] then
        return false
    end
    -- Delegate to gamemode system if available
    if bom_gamemodes and bom_gamemodes.is_blind_pvp then
        return bom_gamemodes.is_blind_pvp(ante, blind_type, match.settings)
    end
    -- Fallback: legacy logic
    if match.mode == "ascension" or match.mode == "survival" or match.mode == "vanilla" then
        return false
    end
    if match.mode == "faceoff" or match.mode == "showdown" then
        local start_ante = match.settings.showdown_starting_antes or 1
        return ante >= start_ante
    end
    -- Nemesis (attrition) default
    local pvp_start = match.settings.pvp_start_round or 2
    return blind_type == "L" and ante >= pvp_start
end

-- ============================================
-- LOBBY
-- ============================================

function bom_match.enter_lobby(is_host, room_code)
    pcall(function()
        local info = love.filesystem.getInfo("mp_match_debug.txt")
        if info and info.size and info.size > 2 * 1024 * 1024 then
            require("functions/fast_fs").write("mp_match_debug.txt", "[LOG RESET] previous log passed 2 MB\n")
        end
    end)
    bom_match.reset()
    bom_match.transition(bom_match.PHASE.LOBBY)
    match.is_host = is_host
    match.room_code = room_code
    mp_log.info("BOM_MATCH", "enter_lobby: host=%s room=%s", tostring(is_host), tostring(room_code))
    pcall(function()
        if G and G.PROFILES and G.SETTINGS then
            local profile = G.PROFILES[G.SETTINGS.profile]
            match.my_name = bom_match.resolve_name(profile and profile.name, true)
        end
    end)    if match.my_name == "Player" then match.my_name = bom_match.resolve_name(nil, true) end
end

function bom_match.my_seat()
    if match.server_player_id ~= nil then return tonumber(match.server_player_id) == 0 and 0 or 1 end
    return match.is_host and 0 or 1
end

function bom_match.resolve_name(raw, mine)
    local seat = bom_match.my_seat()
    if not mine then seat = 1 - seat end
    local n = type(raw) == "string" and raw:match("^%s*(.-)%s*$") or ""
    if n == "" or n == "Player" or n == "Opponent" or n == "You" or n:match("^P%d+$") or n:match("^Player %d+$") then
        return "P" .. tostring(seat + 1)
    end
    return n
end

function bom_match.set_opponent(name, version)
    match.opp_name = bom_match.resolve_name(name, false)
    match.opp_version = version
end

function bom_match.set_opponent_profile(profile)
    if not profile then return end
    match.opp_name = bom_match.resolve_name(profile.name, false)
    match.opp_profile = profile
    -- FEATURE: Store opponent's blind column color for nemesis visual
    if profile.blind_col and tonumber(profile.blind_col) then
        match.opp_blind_col = tonumber(profile.blind_col)
    end
end

-- FEATURE: Send score update to server during PvP blind (called per hand)
function bom_match.send_play_hand(score, hands_left)
    if not bom_core or not bom_core.send then return end
    local score_str = tostring(bom_core.plain_number(score))
    pcall(function()
        local cr = G and G.GAME and G.GAME.current_round
        bom_core.send({
            type = "play_hand",
            score = score_str,
            hands_left = hands_left or 0,
            discards_left = cr and cr.discards_left or nil,
        })
    end)
end

-- FEATURE: end_pvp flag management
function bom_match.set_end_pvp(flag)
    match.end_pvp = flag
end

function bom_match.is_end_pvp()
    return match.end_pvp
end

function bom_match.set_ready(ready)
    match.my_ready = ready
    mp_log.debug("BOM_MATCH", "set_ready=%s", tostring(ready))
    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({ type = "ready_state", ready = ready })
        end
    end)
end

function bom_match.on_opponent_ready(ready)
    match.opp_ready = ready
    mp_log.debug("BOM_MATCH", "on_opponent_ready=%s", tostring(ready))
end

function bom_match.can_start()
    return match.is_host and match.my_ready and match.opp_ready
end

-- ============================================
-- SETTINGS
-- ============================================

function bom_match.update_settings(new_settings)
    if not new_settings then return end
    for k, v in pairs(new_settings) do
        if DEFAULT_SETTINGS[k] ~= nil and not (k == "my_starting_jokers" and not match.is_host) then
            if k == "rules" then
                match.settings.rules = bom_match.clean_rules(v)
            elseif type(DEFAULT_SETTINGS[k]) == "table" then
                match.settings[k] = type(v) == "table" and deep_copy(v) or {}
            elseif k == "mode" and v == "attrition" then
                match.settings[k] = "nemesis"
            else
                match.settings[k] = v
            end
        end
    end
    match.mode = match.settings.mode or "nemesis"
    -- Update lives from gamemode default or settings
    local default_lives = 4
    if bom_gamemodes and bom_gamemodes.get_default_lives then
        default_lives = bom_gamemodes.get_default_lives()
    end
    match.my_lives = match.settings.starting_lives or default_lives
    match.opp_lives = match.settings.starting_lives or default_lives
end

function bom_match.sync_settings()
    if not match.is_host then return end
    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({ type = "match_settings", settings = match.settings })
        end
    end)
end

function bom_match.on_settings_received(settings)
    bom_match.update_settings(settings)
end

-- ============================================
-- MATCH START — Called when host starts the match
-- ============================================

function bom_match.start_match(seed)
    match.opp_location = nil
    mp_log.info("BOM_MATCH", "start_match: seed=%s", tostring(seed))
    bom_match.transition(bom_match.PHASE.PLAYING)
    match.seed = seed
    match.ante_timer = nil
    -- Use gamemode default lives, overridden by settings
    local default_lives = 4
    if bom_gamemodes and bom_gamemodes.get_default_lives then
        default_lives = bom_gamemodes.get_default_lives()
    end
    match.my_lives = match.settings.starting_lives or default_lives
    match.opp_lives = match.settings.starting_lives or default_lives
    match.current_ante = 1
    match.current_blind = "S"
    match.sudden_death = 0
    match.server_final_ante = nil
    if bom_match.apply_sudden_death_label then bom_match.apply_sudden_death_label() end
    pcall(function() if bom_ui and bom_ui.cleanup_end_game_state then bom_ui.cleanup_end_game_state() end end)
    match.pvp_submitted = false
    match.pvp_received = false
    match.match_over = false
    match.match_result = nil
    match.opp_blind_finished = false
    match.rematch_voted = false
    match.rematch_votes = { false, false }
    match.room_closed_text = nil
    match.my_score = 0
    match.opp_score = 0
    match.pvp_wins = 0
    match.pvp_losses = 0
    match.sabotages_used = 0
    match.won_without_life_loss = true
    match.pvp_loss_pending = false
    match.pvp_pending_lives = nil
    match.end_pvp = false
    match.opp_status = "active"
    match.disconnect_handled = false
    match._last_sent_location = nil
    match.pvp_results_seen = 0
    match.end_reason = nil
    match.my_location = nil
end

function bom_match.restore_fairness()
    -- FIX: Restore pre-match feature settings (optimizer, score preview)
    pcall(function()
        if G.SETTINGS and match.pre_match_features then
            local f = match.pre_match_features
            if f.hand_optimizer        ~= nil then G.SETTINGS.hand_optimizer        = f.hand_optimizer        end
            if f.score_preview_enabled ~= nil then G.SETTINGS.score_preview_enabled = f.score_preview_enabled end
            match.pre_match_features = nil
        end
    end)
    -- FIX: Restore G.MOD_SETTINGS cheat states that were disabled for MP fairness
    pcall(function()
        if G.MOD_SETTINGS and match.pre_match_mod_settings then
            local s = match.pre_match_mod_settings
            if s.pre_run_enabled ~= nil and G.MOD_SETTINGS.pre_run  then G.MOD_SETTINGS.pre_run.enabled             = s.pre_run_enabled end
            if s.god_mode        ~= nil and G.MOD_SETTINGS.in_run   then G.MOD_SETTINGS.in_run.god_mode             = s.god_mode        end
            if s.free_rerolls    ~= nil and G.MOD_SETTINGS.runtime  then G.MOD_SETTINGS.runtime.free_rerolls_active = s.free_rerolls    end
            if s.free_shop       ~= nil and G.MOD_SETTINGS.runtime  then G.MOD_SETTINGS.runtime.free_shop_active    = s.free_shop       end
            if s.all_eternal     ~= nil and G.MOD_SETTINGS.runtime  then G.MOD_SETTINGS.runtime.all_eternal_active  = s.all_eternal     end
            match.pre_match_mod_settings = nil
        end
    end)

end

function bom_match.apply_fairness()
    -- FIX: Save G.MOD_SETTINGS cheat states before forcing off for MP fairness.
    -- Restored in end_match so single-player cheat preferences survive the match.
    pcall(function()
        if G.MOD_SETTINGS then
            match.pre_match_mod_settings = {
                pre_run_enabled = G.MOD_SETTINGS.pre_run  and G.MOD_SETTINGS.pre_run.enabled,
                god_mode        = G.MOD_SETTINGS.in_run   and G.MOD_SETTINGS.in_run.god_mode,
                free_rerolls    = G.MOD_SETTINGS.runtime  and G.MOD_SETTINGS.runtime.free_rerolls_active,
                free_shop       = G.MOD_SETTINGS.runtime  and G.MOD_SETTINGS.runtime.free_shop_active,
                all_eternal     = G.MOD_SETTINGS.runtime  and G.MOD_SETTINGS.runtime.all_eternal_active,
            }
        end
    end)
    -- FIX: Multiplayer fairness - force all mod-menu cheats off when a match binds to G.GAME.
    -- (Values already saved to match.pre_match_mod_settings above)
    pcall(function()
        if G.MOD_SETTINGS then
            G.MOD_SETTINGS.pre_run.enabled = false
            G.MOD_SETTINGS.in_run.god_mode = false
            G.MOD_SETTINGS.runtime.free_rerolls_active = false
            G.MOD_SETTINGS.runtime.free_shop_active = false
            G.MOD_SETTINGS.runtime.all_eternal_active = false
        end
        if remove_floating_mod_button then remove_floating_mod_button() end
    end)
    -- FIX: Save pre-match feature states and disable those not allowed by host settings.
    -- Restored in end_match so single-player settings survive the match.
    pcall(function()
        if G.SETTINGS and match.settings then
            match.pre_match_features = {
                hand_optimizer        = G.SETTINGS.hand_optimizer,
                score_preview_enabled = G.SETTINGS.score_preview_enabled,
            }
            if not match.settings.allow_hand_optimizer then G.SETTINGS.hand_optimizer        = false end
            if not bom_match.preview_allowed(match.settings) then G.SETTINGS.score_preview_enabled = false end
        end
    end)
end

-- Apply MP state to G.GAME after G:start_run() creates fresh game object
function bom_match.apply_to_game()
    mp_log.info("BOM_MATCH", "apply_to_game")
    if not G or not G.GAME then
        mp_log.error("BOM_MATCH", "G.GAME missing in apply_to_game")
        return
    end
    G.GAME.multiplayer = true
    G.GAME.mp_lives = match.my_lives
    G.GAME.mp_opponent_lives = match.opp_lives
    G.GAME.mp_mode = match.mode
    G.GAME.mp_settings = match.settings
    G.GAME.mp_in_boss_blind = false
    G.GAME.mp_boss_result_pending = false
    G.GAME.mp_searching = false
    G.GAME.mp_seed = match.seed
    G.GAME.mp_the_order = match.settings.the_order == true
    bom_match.install_the_order()
    G.GAME.bom_sabotages_used = 0
    G.GAME.mp_boss_wins = 0
    G.GAME.mp_won_without_life_loss = true
    G.GAME.mp_won_from_one_life = false
    G.GAME.mp_match_wins = G.GAME.mp_match_wins or 0
    G.GAME.mp_shop_tax = 0
    G.GAME.mp_blind_loss_pending = false  -- FIX: Reset blind-loss flag on new match
    G.GAME.mp_pvp_results_seen = 0

    -- FIX: Reset PvP loss pending state
    match.pvp_loss_pending = false
    match.pvp_pending_lives = nil

    -- Build opponent panel
    G.GAME.mp_opponent_panel = {
        name = match.opp_name or "Opponent",
        title = "",
        rank = 1,
        lives = match.opp_lives or match.settings.starting_lives or 5,
        score = 0,
        score_text = "0",
        hands_left = 0,  -- FIX: Initialize so HUD ref_table works from the start
        status = "active",
        blind_finished = false,
        location = (match.opp_location and bom_match.format_location(match.opp_location)) or "...",  -- FEATURE: Session 56 — enemy location (updated live by set_location events)
    }
    pcall(function()
        if match.opp_profile then
            G.GAME.mp_opponent_panel.name = match.opp_name
            G.GAME.mp_opponent_panel.title = match.opp_profile.equipped_title or ""
            G.GAME.mp_opponent_panel.rank = match.opp_profile.rank or 1
        end
    end)

    -- FIX: Exclude bl_mp_nemesis from random boss pool.
    -- get_new_boss() iterates G.P_BLINDS and adds bosses to eligible_bosses as `true`.
    -- If bl_mp_nemesis is not in G.GAME.bosses_used, the count-replacement loop skips it,
    -- leaving eligible_bosses["bl_mp_nemesis"] = true (boolean). Later code then does
    -- `true <= min_use` → crash: "attempt to compare number with boolean" (common_events.lua:2684).
    -- Adding to banned_keys prevents get_new_boss() from selecting it.
    -- Adding to bosses_used with count 0 is a belt-and-suspenders safeguard.
    pcall(function()
        G.GAME.banned_keys = G.GAME.banned_keys or {}
        G.GAME.banned_keys["bl_mp_nemesis"] = true
        G.GAME.bosses_used = G.GAME.bosses_used or {}
        G.GAME.bosses_used["bl_mp_nemesis"] = G.GAME.bosses_used["bl_mp_nemesis"] or 0
    end)

    bom_match.apply_fairness()
    mp_log.info("BOM_MATCH", "apply_to_game done: panel=%s", tostring(G.GAME.mp_opponent_panel.name))
end

-- FEATURE: Apply gamemode + ruleset bans to the current game
-- Called after G:start_run() creates the fresh G.GAME object
function bom_match.apply_bans()
    if not G or not G.GAME then return end
    G.GAME.banned_keys = G.GAME.banned_keys or {}
    if bom_gamemodes and bom_gamemodes.apply_bans then
        bom_gamemodes.apply_bans()
    end
    mp_log.info("BOM_MATCH", "apply_bans done")
end

-- FEATURE: Return to lobby after match ends (preserves connection)
---@diagnostic disable-next-line: duplicate-set-field
function bom_match.return_to_lobby()
    local room_code = match.room_code
    local is_host = match.is_host
    local opp_name = match.opp_name
    local settings = {}
    for k, v in pairs(match.settings) do settings[k] = v end

    bom_match.reset()
    bom_match.transition(bom_match.PHASE.LOBBY)
    match.room_code = room_code
    match.is_host = is_host
    match.opp_name = opp_name
    match.settings = settings

    mp_log.info("BOM_MATCH", "return_to_lobby: room=%s host=%s", tostring(room_code), tostring(is_host))
end

-- FEATURE: Vote for rematch
---@diagnostic disable-next-line: duplicate-set-field
function bom_match.vote_rematch()
    if match.rematch_voted then return end
    match.rematch_voted = true
    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({ type = "rematch_vote" })
        end
    end)
    mp_log.info("BOM_MATCH", "voted for rematch")
end

---@diagnostic disable-next-line: duplicate-set-field
function bom_match.has_voted_rematch()
    return match.rematch_voted
end

-- ============================================
-- BLIND ENTERED — Notify server, update local state
-- Called from state_events.lua when a new blind starts
-- ============================================

function bom_match.on_blind_entered(ante, blind_type)
    if not bom_match.is_in_match() then return end

    -- FIX de-sync Bug #3: if the phase is stuck in PVP_RESOLVE (missed a state update),
    -- force-recover to PLAYING so the new blind's transitions work correctly.
    -- FIX P2#17: emphasize this is a recovery hack — if it ever fires in production,
    -- a pvp_resolved or match_state_update was lost. Log to disk so the symptom is
    -- diagnosable instead of silently masked.
    if match.phase == bom_match.PHASE.PVP_RESOLVE then
        mp_log.warn("BOM_MATCH", "blind_entered while stuck in PVP_RESOLVE — force-recovering to PLAYING")
        pcall(function()
            require("functions/fast_fs").append("mp_match_debug.txt",
                "\n[PVP_RESOLVE_RECOVERY] ante=" .. tostring(ante)
                .. " blind=" .. tostring(blind_type)
                .. " — server pvp_resolved or state update was likely lost")
        end)
        match.phase = bom_match.PHASE.PLAYING  -- bypass transition table for recovery
        match.end_pvp = false
    end

    match.current_ante = ante or match.current_ante
    match.current_blind = blind_type or match.current_blind
    match.pvp_submitted = false
    match.pvp_received = false
    match.my_score = 0
    match.opp_score = 0
    match.opp_blind_finished = false

    local is_pvp = bom_match.is_blind_pvp(ante, blind_type)

    mp_log.info("BOM_MATCH", "blind_entered: ante=%s blind=%s pvp=%s", tostring(ante), tostring(blind_type), tostring(is_pvp))

    if is_pvp then
        bom_match.transition(bom_match.PHASE.PVP_BLIND)
    else
        bom_match.transition(bom_match.PHASE.PLAYING)
    end

    -- Notify server of blind entry (server tracks authoritative PvP state)
    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({
                type = "blind_entered",
                ante = ante,
                blind = blind_type,
            })
        end
    end)

    -- Sync to G.GAME
    pcall(function()
        if G and G.GAME then
            G.GAME.mp_in_boss_blind = is_pvp
            if G.GAME.mp_opponent_panel then
                G.GAME.mp_opponent_panel.blind_finished = false
            end
        end
    end)
end

-- ============================================
-- BLIND DEFEATED — Submit score to server
-- Called from state_events.lua when player beats a blind
-- ============================================

function bom_match.on_blind_defeated(score)
    if not bom_match.is_in_match() then return end

    score = score or 0
    pcall(function() score = G.GAME.chips or score end)

    local is_pvp = bom_match.is_blind_pvp(match.current_ante, match.current_blind)

    mp_log.info("BOM_MATCH", "blind_defeated: score=%s pvp=%s ante=%s", tostring(score), tostring(is_pvp), tostring(match.current_ante))

    if is_pvp and match.phase ~= bom_match.PHASE.PVP_BLIND then
        mp_log.debug("BOM_MATCH", "blind_defeated: PvP blind already resolved, nothing to submit")
        return
    end

    match.my_score = score
    match.pvp_submitted = true

    if is_pvp then
        bom_match.transition(bom_match.PHASE.PVP_RESOLVE)
    end

    -- Submit score to server (server resolves PvP authoritatively)
    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({
                type = "blind_finished",
                ante = match.current_ante,
                blind = match.current_blind,
                score = score,
                lives = match.my_lives,
            })
        end
    end)

    -- FIX: Bug 2 — Do NOT show "Waiting for opponent to finish..." here.
    -- bom_pvp_hud.update_hand_played already shows "Waiting for opponent..." when hands run out.
    -- This second call can fire AFTER on_pvp_resolved() already dismissed the overlay,
    -- creating a stale popup that never gets removed.
    -- if is_pvp then ... end
end

-- ============================================
-- GAME OVER — Player failed a blind
-- Submit score 0 to server, then notify server of game over
-- ============================================

function bom_match.on_game_over()
    if not bom_match.is_in_match() then return end

    mp_log.info("BOM_MATCH", "game_over: ante=%s blind=%s", tostring(match.current_ante), tostring(match.current_blind))

    -- FEATURE: During PvP blinds, redirect to on_blind_defeated (lose a life, not the match)
    local is_pvp = bom_match.is_blind_pvp(match.current_ante, match.current_blind)
    if is_pvp then
        mp_log.info("BOM_MATCH", "game_over redirected to blind_defeated (PvP — life loss, not match loss)")
        local score = 0
        pcall(function() score = G.GAME.chips or 0 end)
        bom_match.on_blind_defeated(score)
        return
    end

    -- FIX: Non-PvP blind loss — show LOSE A LIFE cashout window ($10 gift) instead of looping.
    -- Previous approach only set blind.chips=-1 in update_new_round hook, which could fail
    -- if to_big() errored, causing end_round → game_over → NEW_ROUND infinite loop.
    -- Fix: set blind.chips=-1 HERE immediately so end_round never re-fires game_over.
    -- Set mp_blind_loss_pending so bom_pvp_hud's add_round_eval_row hook shows LOSE A LIFE.
    bom_match.mark_round_lost()
    pcall(function()
        if G and G.GAME and G.GAME.blind then
            G.GAME.blind.chips = -1
        end
    end)
    -- Notify server of life loss (server deducts life, sends updated lives)
    -- FEATURE: Include score for Ascension tiebreaking
    pcall(function()
        if bom_core and bom_core.send and not match.match_over then
            local score = 0
            pcall(function()
                if G and G.GAME and G.GAME.chips then
                    score = G.GAME.chips
                end
            end)
            bom_core.send({
                type = "game_over",
                ante = match.current_ante,
                blind = match.current_blind,
                score = score,
            })
        end
    end)
    -- Redirect to NEW_ROUND: update_new_round hook runs end_round success path
    -- which properly draws cards, advances blind_state, then sets STATE = ROUND_EVAL.
    -- The LOSE A LIFE button is created by the add_round_eval_row hook in bom_pvp_hud.
    -- FIX: Queue state change via event manager instead of setting G.STATE directly mid-frame
    pcall(function()
        if G and G.STATES and G.E_MANAGER then
r 1 112 %20%20%20%20%20%20%20%20%20%20%20%20 -
r 2 398 %20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20 -
l 2
                blocking = false,
                func = function()
r 2 401 %20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20 -
r 2 402 %20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20 -
l 5
                    return true
                end,
            }))
        elseif G and G.STATES then
            -- Fallback if event manager unavailable
r 2 401 %20%20%20%20%20%20%20%20%20%20%20%20 -
r 2 402 %20%20%20%20%20%20%20%20%20%20%20%20 -
l 446
        end
    end)
end

-- ============================================
-- SERVER STATE UPDATE — Authoritative state push from server
-- This is the primary state synchronization mechanism
-- ============================================

function bom_match.on_server_state_update(data)
    if not data then return end

    mp_log.info("BOM_MATCH", "server_state: phase=%s ante=%s blind=%s pvp=%s myLives=%s oppLives=%s event=%s",
        tostring(data.phase), tostring(data.currentAnte), tostring(data.currentBlind),
        tostring(data.isPvpBlind), tostring(data.myLives), tostring(data.oppLives), tostring(data.event))

    -- Store server-assigned player ID
    if data.playerId ~= nil then
        match.server_player_id = data.playerId
    end
    if data.phase ~= "finished" then
        bom_match.set_final_state(data.finalAnte, data.suddenDeath)
    end

    -- Update lives from server (authoritative)
    if data.myLives ~= nil then
        -- FIX: Don't override local lives if a loss is pending (deferred to button click).
        -- pvp_loss_pending = PvP nemesis loss waiting for button.
        -- mp_blind_loss_pending = non-PvP blind loss waiting for "Lose a Life" button.
        local loss_pending = match.pvp_loss_pending
            or (G and G.GAME and G.GAME.mp_blind_loss_pending)
        if loss_pending and not match.pvp_loss_pending and data.myLives < (match.my_lives or 0) then
            match.server_lives_after_loss = data.myLives
        end
        if not loss_pending or data.phase == "finished" then
            local old_lives = match.my_lives
            match.my_lives = data.myLives
            pcall(function()
                if G and G.GAME then G.GAME.mp_lives = data.myLives end
            end)
            -- Animate life loss
            if data.myLives < old_lives then
                pcall(function()
                    if bom_ui and bom_ui.animate_life_loss then
                        bom_ui.animate_life_loss()
                    end
                end)
            end
        end
    end
    if data.oppLives ~= nil then
        match.opp_lives = data.oppLives
        pcall(function()
            if G and G.GAME then
                G.GAME.mp_opponent_lives = data.oppLives
                if G.GAME.mp_opponent_panel then
                    G.GAME.mp_opponent_panel.lives = data.oppLives
                end
            end
        end)
    end

    -- Update opponent name
    if data.oppName and data.oppName ~= "" then
        match.opp_name = bom_match.resolve_name(data.oppName, false)
        pcall(function()
            if G and G.GAME and G.GAME.mp_opponent_panel then
                G.GAME.mp_opponent_panel.name = match.opp_name
            end
        end)
    end

    -- Update opponent status
    if data.oppStatus then
        match.opp_status = data.oppStatus
        pcall(function()
            if G and G.GAME and G.GAME.mp_opponent_panel then
                G.GAME.mp_opponent_panel.status = data.oppStatus
            end
        end)
    end

    -- Track opponent blind finished state
    if data.oppBlindFinished ~= nil then
        match.opp_blind_finished = data.oppBlindFinished
        pcall(function()
            if G and G.GAME and G.GAME.mp_opponent_panel then
                G.GAME.mp_opponent_panel.blind_finished = data.oppBlindFinished
            end
        end)
    end

    -- FIX P1#5: pick up own per-blind state and opponent score from server broadcast
    -- so a reconnecting client can recover full state (these fields were previously omitted).
    if data.myBlindFinished ~= nil then
        match.pvp_submitted = match.pvp_submitted or (data.myBlindFinished == true)
    end
    if data.myScore ~= nil and type(data.myScore) == "number" then
        match.my_score = data.myScore
    end
    if data.oppScore ~= nil and type(data.oppScore) == "number" then
        match.opp_score = data.oppScore
        pcall(function()
            if G and G.GAME and G.GAME.mp_opponent_panel then
                G.GAME.mp_opponent_panel.score = data.oppScore
            end
        end)
    end

    -- Update PvP blind state from server
    if data.isPvpBlind ~= nil then
        -- FIX: Do NOT set G.GAME.mp_in_boss_blind from server isPvpBlind.
        -- The server broadcasts isPvpBlind=true when ANY player enters a PvP blind.
        -- If Player A enters Boss (PvP) while Player B is at Small (non-PvP),
        -- Player B's mp_in_boss_blind would wrongly become true, causing:
        -- (1) game.lua evaluate_play forces "use all hands" PvP behavior on Small blind
        -- (2) state_events.lua end_round suppresses game_over on Small blind
        -- mp_in_boss_blind is set locally by:
        --   - state_events.lua new_round: blhash == 'L' check
        --   - bom_match.on_blind_entered: is_blind_pvp() check
        -- Phase transition to PVP_BLIND is handled locally in update_draw_to_hand.
    end

    -- Update phase from server
    if data.phase then
        if data.phase == "finished" and not match.match_over then
            -- Server says match is over
            local result = "lose"
            if data.winner == match.server_player_id then result = "win" end
            bom_match.end_match(result, data.winReason or "server", { from_server = true })
        elseif data.phase == "playing" and match.phase == bom_match.PHASE.PVP_RESOLVE then
            -- PvP resolved, back to playing
            bom_match.transition(bom_match.PHASE.PLAYING)
            match.pvp_submitted = false
            match.pvp_received = false
            match.opp_blind_finished = false
            pcall(function()
                if G and G.GAME then
                    G.GAME.mp_in_boss_blind = false
                    G.GAME.mp_boss_result_pending = false
                end
            end)
        end
    end
end

-- ============================================
-- PVP RESOLVED — Server sends authoritative PvP result
-- ============================================

function bom_match.on_pvp_resolved(data)
    if not data then return end
    if match.phase == bom_match.PHASE.NONE then return end
    pcall(function() bom_pvp_hud._pvp_finished_token = nil end)
    pcall(function() bom_spectate.wait_over() end)

    -- FEATURE: Dismiss PvP waiting overlay
    pcall(function()
        if bom_ui and bom_ui.hide_pvp_waiting then
            bom_ui.hide_pvp_waiting()
        end
    end)

    local result = data.result or "draw"
    local my_score = data.myScore or 0
    local opp_score = data.oppScore or 0
    if not data.matchEnded then
        bom_match.set_final_state(data.finalAnte, data.suddenDeath)
    end

    mp_log.info("BOM_MATCH", "pvp_resolved: result=%s me=%s opp=%s myLives=%s oppLives=%s",
        result, tostring(my_score), tostring(opp_score), tostring(data.myLives), tostring(data.oppLives))

    -- Update lives from server (authoritative)
    if data.myLives ~= nil then
        local old_lives = match.my_lives
        if result == "lose" then
            -- FIX: Defer life deduction to "Lose a Life" button click.
            -- Server already deducted in resolvePvp — store the authoritative value
            -- and apply it when the player clicks the button.
            -- FIX P2#48: validate that data.myLives is a non-negative finite number.
            -- A malformed payload (null/string/NaN) would otherwise propagate to
            -- match.my_lives via the button handler and crash render.
            local new_lives = tonumber(data.myLives)
            local in_blind = false
            pcall(function()
                in_blind = G and G.GAME and G.GAME.facing_blind and bom_nemesis
                    and bom_nemesis.in_unresolved_pvp_blind() or false
            end)
            if new_lives and new_lives >= 0 and new_lives < 1000 and in_blind then
                match.pvp_loss_pending = true
                match.pvp_pending_lives = new_lives
                match.won_without_life_loss = false
            elseif new_lives and new_lives >= 0 and new_lives < 1000 then
                mp_log.warn("BOM_MATCH", "pvp_resolved lose arrived outside the PvP blind, lives applied now")
                match.pvp_loss_pending = false
                match.pvp_pending_lives = nil
                match.won_without_life_loss = false
                bom_match.set_display_lives(new_lives)
                pcall(function()
                    if bom_ui and bom_ui.animate_life_loss then bom_ui.animate_life_loss() end
                end)
            else
                mp_log.warn("BOM_MATCH", "pvp_resolved: invalid myLives=%s, ignored", tostring(data.myLives))
            end
        else
            local new_lives = tonumber(data.myLives)
            if new_lives and new_lives >= 0 and new_lives < 1000 then
                match.my_lives = new_lives
                pcall(function()
                    if G and G.GAME then G.GAME.mp_lives = new_lives end
                end)
            end
        end
    end
    if data.oppLives ~= nil then
        match.opp_lives = data.oppLives
        pcall(function()
            if G and G.GAME then
                G.GAME.mp_opponent_lives = data.oppLives
                if G.GAME.mp_opponent_panel then
                    G.GAME.mp_opponent_panel.lives = data.oppLives
                end
            end
        end)
    end

    match.pvp_results_seen = (match.pvp_results_seen or 0) + 1
    pcall(function()
        if G and G.GAME then G.GAME.mp_pvp_results_seen = (G.GAME.mp_pvp_results_seen or 0) + 1 end
    end)

    -- Track stats
    if result == "win" then
        match.pvp_wins = match.pvp_wins + 1
        local bonus = (bom_party and bom_party.active()) and 0 or bom_match.pvp_win_money()
        if bonus > 0 then
            pcall(function() ease_dollars(bonus) end)
            mp_log.info("BOM_MATCH", "pvp win bonus $%d", bonus)
        end
    elseif result == "lose" then
        match.pvp_losses = match.pvp_losses + 1
    end

    pcall(function() if bom_party_run then bom_party_run.apply_rewards(data) end end)

    -- Show PvP result banner
    pcall(function()
        if G.STAGE ~= G.STAGES.RUN then
            return
        elseif data.solo and bom_party then
            bom_party.solo_note()
        elseif bom_party_run and bom_party_run.show_result(data) then
            return
        elseif bom_ui and bom_ui.show_pvp_result then
            bom_ui.show_pvp_result(result, my_score, opp_score)
        end
    end)

    -- Winner picks sabotage (DISABLED — sabotage system removed for now)
    -- if result == "win" then
    --     pcall(function()
    --         if bom_sabotage and bom_sabotage.show_pick_screen then
    --             bom_sabotage.show_pick_screen()
    --         end
    --     end)
    -- end

    -- Reset PvP tracking
    match.pvp_submitted = false
    match.pvp_received = false
    match.opp_blind_finished = false
    match.my_score = 0
    match.opp_score = 0

    -- FIX P3#33: removed early bom_match.transition(PHASE.PLAYING) here -- the
    -- match-ended branch below already handles end_match, and the not-matchEnded
    -- branch transitions to PLAYING. The duplicate call was a same-phase no-op.

    -- FEATURE: Signal end_pvp for the state machine (Game:update_hand_played)
    match.end_pvp = true

    pcall(bom_match.release_unplayed_pvp_blind)

    -- FIX: Bug 3 — Clear pvp_blind_choices so next ante's blind_select re-evaluates fresh
    -- FIX: Also clear blind.pvp immediately — the Blind:set_blind hook for the NEXT blind
    -- must not see stale pvp=true from this Nemesis blind.
    pcall(function()
        if G and G.GAME and G.GAME.round_resets then
            G.GAME.round_resets.pvp_blind_choices = nil
        end
        if G and G.GAME and G.GAME.blind and not G.GAME.facing_blind then
            G.GAME.blind.pvp = false
        end
    end)

    -- Check if match ended
    if data.matchEnded then
        local end_result = "lose"
        if data.winner == match.server_player_id then end_result = "win" end
        bom_match.end_match(end_result, data.winReason or "elimination")
    else
        bom_match.transition(bom_match.PHASE.PLAYING)
        pcall(function()
            if G and G.GAME then
                G.GAME.mp_in_boss_blind = false
                G.GAME.mp_boss_result_pending = false
            end
        end)
    end
end

-- ============================================
-- OPPONENT BLIND FINISHED — Server notifies us opponent completed their blind
-- ============================================

function bom_match.on_opponent_blind_finished(data)
    if not data then return end

    mp_log.info("BOM_MATCH", "opponent_blind_finished: lives=%s finished=%s", tostring(data.lives), tostring(data.finished))

    match.opp_blind_finished = true

    if data.lives then
        match.opp_lives = data.lives
    end

    -- Update opponent panel
    pcall(function()
        if G and G.GAME and G.GAME.mp_opponent_panel then
            G.GAME.mp_opponent_panel.blind_finished = true
            if data.lives then G.GAME.mp_opponent_panel.lives = data.lives end
            if data.score then G.GAME.mp_opponent_panel.score = data.score end
        end
    end)
end

