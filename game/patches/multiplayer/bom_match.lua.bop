function bom_match.get_state()     return match end
function bom_match.get_phase()     return match.phase end
function bom_match.get_mode()      return match.mode end
function bom_match.get_settings()  return match.settings end

bom_match.SETTING_ALIASES = {}

local function rule_flag(primary, alias, default)
    local s = match.settings or {}
    if type(s[primary]) == "boolean" then return s[primary] end
    if type(s[alias]) == "boolean" then return s[alias] end
    return default
end

function bom_match.rule_comeback_money()
    return rule_flag("gold_on_life_loss", "comeback_money", true)
end

function bom_match.rule_no_gold_on_round_loss()
    return rule_flag("no_gold_on_round_loss", "no_gold_on_round_loss", false)
end

function bom_match.rule_life_on_round_loss()
    return rule_flag("death_on_round_loss", "non_pvp_life_loss", true)
end

function bom_match.round_loss_costs_life()
    return match.mode == "ascension" or bom_match.rule_life_on_round_loss()
end

function bom_match.comeback_amount()
    local stake = 1
    pcall(function() stake = tonumber(G.GAME.stake) or 1 end)
    return stake >= 6 and 2 or 3
end

function bom_match.round_pay_cap()
    return 10
end

function bom_match.mark_round_lost()
    local costs = bom_match.round_loss_costs_life()
    pcall(function()
        G.GAME.mp_round_lost = true
        G.GAME.mp_blind_loss_pending = costs
        if costs then match.won_without_life_loss = false end
    end)
    match.server_lives_after_loss = nil
    mp_log.info("BOM_MATCH", "round lost: life=%s no_gold=%s comeback=%s", tostring(costs),
        tostring(bom_match.rule_no_gold_on_round_loss()), tostring(bom_match.rule_comeback_money()))
    return costs
end

bom_match.MP_MAX_SPEED = 4

function bom_match.speed_rules_on()
    if not (G and G.SETTINGS and G.STAGES and G.STAGE == G.STAGES.RUN and G.GAME and G.GAME.multiplayer) then return false end
    return true
end

function bom_match.speed_rule(what)
    if not bom_match.speed_rules_on() then return false end
    local fair = rawget(_G, "MPFair")
    if fair and fair.limited then return fair.limited(what) end
    return true
end

function bom_match.enforce_speed()
    local S = G and G.SETTINGS
    if not S then return end
    if bom_playback and bom_playback.active() then return end
    if bom_match.speed_rules_on() then
        if not S.mp_speed_saved then
            S.mp_speed_saved = { speed = S.GAMESPEED, score = S.fast_score_resolve, skip = S.skip_score_animation and true or false }
        end
        if bom_match.speed_rule("speed") and (tonumber(S.GAMESPEED) or 1) > bom_match.MP_MAX_SPEED then S.GAMESPEED = bom_match.MP_MAX_SPEED end
        if bom_match.speed_rule("score") and S.fast_score_resolve ~= 1.0 then S.fast_score_resolve = 1.0 end
        if bom_match.speed_rule("skip") and S.skip_score_animation then S.skip_score_animation = false end
    elseif S.mp_speed_saved and not (G.STAGES and G.STAGE == G.STAGES.RUN and G.GAME and G.GAME.multiplayer) then
        local sv = S.mp_speed_saved
        S.mp_speed_saved = nil
        if tonumber(sv.speed) then S.GAMESPEED = tonumber(sv.speed) end
        if tonumber(sv.score) then S.fast_score_resolve = tonumber(sv.score) end
        S.skip_score_animation = sv.skip == true
        pcall(function() G:save_settings() end)
    end
end

function bom_match.take_server_lives_after_loss()
    local n = match.server_lives_after_loss
    match.server_lives_after_loss = nil
    return n
end
function bom_match.is_active()     return match.phase ~= bom_match.PHASE.NONE end
function bom_match.is_in_match()
    return match.phase == bom_match.PHASE.PLAYING
        or match.phase == bom_match.PHASE.PVP_BLIND
        or match.phase == bom_match.PHASE.PVP_RESOLVE
end
function bom_match.is_pvp_blind()
    return match.phase == bom_match.PHASE.PVP_BLIND
        or match.phase == bom_match.PHASE.PVP_RESOLVE
end
function bom_match.is_host_player() return match.is_host end
function bom_match.is_match_over() return match.match_over end
function bom_match.get_my_lives()  return match.my_lives end
function bom_match.get_opp_lives() return match.opp_lives end


function bom_match.transition(new_phase)
    local old = match.phase
    if old == new_phase then return true end
    local allowed = TRANSITIONS[old]
    if not (allowed and allowed[new_phase]) then
        mp_log.warn("BOM_MATCH", "rejected transition: %s -> %s", tostring(old), tostring(new_phase))
        return false
    end
    match.phase = new_phase
    mp_log.debug("BOM_MATCH", "phase: %s -> %s", tostring(old), tostring(new_phase))
    for _, fn in ipairs(phase_change_listeners) do
        pcall(fn, old, new_phase)
    end
    return true
end

function bom_match.on_phase_change(fn)
    if type(fn) == "function" then table.insert(phase_change_listeners, fn) end
end

function bom_match.off_phase_change(fn)
    for i = #phase_change_listeners, 1, -1 do
        if phase_change_listeners[i] == fn then table.remove(phase_change_listeners, i) end
    end
end


function bom_match.is_blind_pvp(ante, blind_type)
    ante = ante or match.current_ante
    blind_type = blind_type or match.current_blind
    local skipped = G and G.GAME and G.GAME.mp_pvp_skipped
    if skipped and skipped[tostring(ante) .. ":" .. tostring(blind_type)] then
        return false
    end
    if bom_gamemodes and bom_gamemodes.is_blind_pvp then
        return bom_gamemodes.is_blind_pvp(ante, blind_type, match.settings)
    end
    if match.mode == "ascension" or match.mode == "survival" or match.mode == "vanilla" then
        return false
    end
    if match.mode == "faceoff" or match.mode == "showdown" then
        local start_ante = match.settings.showdown_starting_antes or 1
        return ante >= start_ante
    end
    local pvp_start = match.settings.pvp_start_round or 2
    return blind_type == "L" and ante >= pvp_start
end


function bom_match.enter_lobby(is_host, room_code)
    pcall(function()
        local info = love.filesystem.getInfo("mp_match_debug.txt")
        if info and info.size and info.size > 2 * 1024 * 1024 then
            require("functions/fast_fs").write("mp_match_debug.txt", "[LOG RESET] previous log passed 2 MB\n")
        end
    end)
    bom_match.reset()
    bom_match.transition(bom_match.PHASE.LOBBY)
    match.is_host = is_host
    match.room_code = room_code
    mp_log.info("BOM_MATCH", "enter_lobby: host=%s room=%s", tostring(is_host), tostring(room_code))
    pcall(function()
        if G and G.PROFILES and G.SETTINGS then
            local profile = G.PROFILES[G.SETTINGS.profile]
            match.my_name = bom_match.resolve_name(profile and profile.name, true)
        end
    end)    if match.my_name == "Player" then match.my_name = bom_match.resolve_name(nil, true) end
end

function bom_match.my_seat()
    if match.server_player_id ~= nil then return tonumber(match.server_player_id) == 0 and 0 or 1 end
    return match.is_host and 0 or 1
end

function bom_match.resolve_name(raw, mine)
    local seat = bom_match.my_seat()
    if not mine then seat = 1 - seat end
    local n = type(raw) == "string" and raw:match("^%s*(.-)%s*$") or ""
    if n == "" or n == "Player" or n == "Opponent" or n == "You" or n:match("^P%d+$") or n:match("^Player %d+$") then
        return "P" .. tostring(seat + 1)
    end
    return n
end

function bom_match.set_opponent(name, version)
    match.opp_name = bom_match.resolve_name(name, false)
    match.opp_version = version
end

function bom_match.set_opponent_profile(profile)
    if not profile then return end
    match.opp_name = bom_match.resolve_name(profile.name, false)
    match.opp_profile = profile
    if profile.blind_col and tonumber(profile.blind_col) then
        match.opp_blind_col = tonumber(profile.blind_col)
    end
end

function bom_match.send_play_hand(score, hands_left)
    if not bom_core or not bom_core.send then return end
    local score_str = tostring(bom_core.plain_number(score))
    pcall(function()
        local cr = G and G.GAME and G.GAME.current_round
        bom_core.send({
            type = "play_hand",
            score = score_str,
            hands_left = hands_left or 0,
            discards_left = cr and cr.discards_left or nil,
        })
    end)
end

function bom_match.set_end_pvp(flag)
    match.end_pvp = flag
end

function bom_match.is_end_pvp()
    return match.end_pvp
end

function bom_match.set_ready(ready)
    match.my_ready = ready
    mp_log.debug("BOM_MATCH", "set_ready=%s", tostring(ready))
    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({ type = "ready_state", ready = ready })
        end
    end)
end

function bom_match.on_opponent_ready(ready)
    match.opp_ready = ready
    mp_log.debug("BOM_MATCH", "on_opponent_ready=%s", tostring(ready))
end

function bom_match.can_start()
    return match.is_host and match.my_ready and match.opp_ready
end


function bom_match.update_settings(new_settings)
    if not new_settings then return end
    for k, v in pairs(new_settings) do
        if k == "rolled_stake" or k == "match_roll" then
            match.settings[k] = v
        elseif DEFAULT_SETTINGS[k] ~= nil and not (k == "my_starting_jokers" and not match.is_host) then
            if k == "rules" then
                match.settings.rules = bom_match.clean_rules(v)
            elseif type(DEFAULT_SETTINGS[k]) == "table" then
                match.settings[k] = type(v) == "table" and deep_copy(v) or {}
            elseif k == "mode" and v == "attrition" then
                match.settings[k] = "nemesis"
            else
                match.settings[k] = v
            end
        end
    end
    match.mode = match.settings.mode or "nemesis"
    local default_lives = 4
    if bom_gamemodes and bom_gamemodes.get_default_lives then
        default_lives = bom_gamemodes.get_default_lives()
    end
    match.my_lives = match.settings.starting_lives or default_lives
    match.opp_lives = match.settings.starting_lives or default_lives
end

function bom_match.sync_settings()
    if not match.is_host then return end
    pcall(bom_match.fill_deck_pool)
    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({ type = "match_settings", settings = match.settings })
        end
    end)
end

function bom_match.on_settings_received(settings)
    bom_match.update_settings(settings)
end


function bom_match.start_match(seed)
    match.opp_location = nil
    mp_log.info("BOM_MATCH", "start_match: seed=%s", tostring(seed))
    bom_match.transition(bom_match.PHASE.PLAYING)
    match.seed = seed
    match.ante_timer = nil
    local default_lives = 4
    if bom_gamemodes and bom_gamemodes.get_default_lives then
        default_lives = bom_gamemodes.get_default_lives()
    end
    match.my_lives = match.settings.starting_lives or default_lives
    match.opp_lives = match.settings.starting_lives or default_lives
    match.current_ante = 1
    match.current_blind = "S"
    match.sudden_death = 0
    match.server_final_ante = nil
    if bom_match.apply_sudden_death_label then bom_match.apply_sudden_death_label() end
    pcall(function() if bom_ui and bom_ui.cleanup_end_game_state then bom_ui.cleanup_end_game_state() end end)
    match.pvp_submitted = false
    match.pvp_received = false
    match.match_over = false
    match.match_result = nil
    match.opp_blind_finished = false
    match.rematch_voted = false
    match.rematch_votes = { false, false }
    match.room_closed_text = nil
    match.my_score = 0
    match.opp_score = 0
    match.pvp_wins = 0
    match.pvp_losses = 0
    match.sabotages_used = 0
    match.won_without_life_loss = true
    match.pvp_loss_pending = false
    match.pvp_pending_lives = nil
    match.end_pvp = false
    match.opp_status = "active"
    match.disconnect_handled = false
    match._last_sent_location = nil
    match.pvp_results_seen = 0
    match.end_reason = nil
    match.my_location = nil
end

function bom_match.restore_fairness()
    pcall(function()
        if G.SETTINGS and match.pre_match_features then
            local f = match.pre_match_features
            if f.hand_optimizer        ~= nil then G.SETTINGS.hand_optimizer        = f.hand_optimizer        end
            if f.score_preview_enabled ~= nil then G.SETTINGS.score_preview_enabled = f.score_preview_enabled end
            match.pre_match_features = nil
        end
    end)
    pcall(function()
        if G.MOD_SETTINGS and match.pre_match_mod_settings then
            local s = match.pre_match_mod_settings
            if s.pre_run_enabled ~= nil and G.MOD_SETTINGS.pre_run  then G.MOD_SETTINGS.pre_run.enabled             = s.pre_run_enabled end
            if s.god_mode        ~= nil and G.MOD_SETTINGS.in_run   then G.MOD_SETTINGS.in_run.god_mode             = s.god_mode        end
            if s.free_rerolls    ~= nil and G.MOD_SETTINGS.runtime  then G.MOD_SETTINGS.runtime.free_rerolls_active = s.free_rerolls    end
            if s.free_shop       ~= nil and G.MOD_SETTINGS.runtime  then G.MOD_SETTINGS.runtime.free_shop_active    = s.free_shop       end
            if s.all_eternal     ~= nil and G.MOD_SETTINGS.runtime  then G.MOD_SETTINGS.runtime.all_eternal_active  = s.all_eternal     end
            match.pre_match_mod_settings = nil
        end
    end)

end

function bom_match.apply_fairness()
    pcall(function()
        if G.MOD_SETTINGS then
            match.pre_match_mod_settings = {
                pre_run_enabled = G.MOD_SETTINGS.pre_run  and G.MOD_SETTINGS.pre_run.enabled,
                god_mode        = G.MOD_SETTINGS.in_run   and G.MOD_SETTINGS.in_run.god_mode,
                free_rerolls    = G.MOD_SETTINGS.runtime  and G.MOD_SETTINGS.runtime.free_rerolls_active,
                free_shop       = G.MOD_SETTINGS.runtime  and G.MOD_SETTINGS.runtime.free_shop_active,
                all_eternal     = G.MOD_SETTINGS.runtime  and G.MOD_SETTINGS.runtime.all_eternal_active,
            }
        end
    end)
    pcall(function()
        if G.MOD_SETTINGS then
            G.MOD_SETTINGS.pre_run.enabled = false
            G.MOD_SETTINGS.in_run.god_mode = false
            G.MOD_SETTINGS.runtime.free_rerolls_active = false
            G.MOD_SETTINGS.runtime.free_shop_active = false
            G.MOD_SETTINGS.runtime.all_eternal_active = false
        end
        if remove_floating_mod_button then remove_floating_mod_button() end
    end)
    pcall(function()
        if G.SETTINGS and match.settings then
            match.pre_match_features = {
                hand_optimizer        = G.SETTINGS.hand_optimizer,
                score_preview_enabled = G.SETTINGS.score_preview_enabled,
            }
            if not match.settings.allow_hand_optimizer then G.SETTINGS.hand_optimizer        = false end
            if not bom_match.preview_allowed(match.settings) then G.SETTINGS.score_preview_enabled = false end
        end
    end)
end

function bom_match.apply_to_game()
    mp_log.info("BOM_MATCH", "apply_to_game")
    if not G or not G.GAME then
        mp_log.error("BOM_MATCH", "G.GAME missing in apply_to_game")
        return
    end
    G.GAME.multiplayer = true
    G.GAME.mp_lives = match.my_lives
    G.GAME.mp_opponent_lives = match.opp_lives
    G.GAME.mp_mode = match.mode
    G.GAME.mp_settings = match.settings
    G.GAME.mp_in_boss_blind = false
    G.GAME.mp_boss_result_pending = false
    G.GAME.mp_searching = false
    G.GAME.mp_seed = match.seed
    G.GAME.mp_the_order = match.settings.the_order == true
    bom_match.install_the_order()
    G.GAME.bom_sabotages_used = 0
    G.GAME.mp_boss_wins = 0
    G.GAME.mp_won_without_life_loss = true
    G.GAME.mp_won_from_one_life = false
    G.GAME.mp_match_wins = G.GAME.mp_match_wins or 0
    G.GAME.mp_shop_tax = 0
    G.GAME.mp_blind_loss_pending = false
    G.GAME.mp_pvp_results_seen = 0

    match.pvp_loss_pending = false
    match.pvp_pending_lives = nil

    G.GAME.mp_opponent_panel = {
        name = match.opp_name or "Opponent",
        title = "",
        rank = 1,
        lives = match.opp_lives or match.settings.starting_lives or 5,
        score = 0,
        score_text = "0",
        hands_left = 0,
        status = "active",
        blind_finished = false,
        location = (match.opp_location and bom_match.format_location(match.opp_location)) or "...",
    }
    pcall(function()
        if match.opp_profile then
            G.GAME.mp_opponent_panel.name = match.opp_name
            G.GAME.mp_opponent_panel.title = match.opp_profile.equipped_title or ""
            G.GAME.mp_opponent_panel.rank = match.opp_profile.rank or 1
        end
    end)

    pcall(function()
        G.GAME.banned_keys = G.GAME.banned_keys or {}
        G.GAME.banned_keys["bl_mp_nemesis"] = true
        G.GAME.bosses_used = G.GAME.bosses_used or {}
        G.GAME.bosses_used["bl_mp_nemesis"] = G.GAME.bosses_used["bl_mp_nemesis"] or 0
    end)

    bom_match.apply_fairness()
    mp_log.info("BOM_MATCH", "apply_to_game done: panel=%s", tostring(G.GAME.mp_opponent_panel.name))
end

function bom_match.apply_bans()
    if not G or not G.GAME then return end
    G.GAME.banned_keys = G.GAME.banned_keys or {}
    if bom_gamemodes and bom_gamemodes.apply_bans then
        bom_gamemodes.apply_bans()
    end
    mp_log.info("BOM_MATCH", "apply_bans done")
end

function bom_match.return_to_lobby()
    local room_code = match.room_code
    local is_host = match.is_host
    local opp_name = match.opp_name
    local settings = {}
    for k, v in pairs(match.settings) do settings[k] = v end

    bom_match.reset()
    bom_match.transition(bom_match.PHASE.LOBBY)
    match.room_code = room_code
    match.is_host = is_host
    match.opp_name = opp_name
    match.settings = settings

    mp_log.info("BOM_MATCH", "return_to_lobby: room=%s host=%s", tostring(room_code), tostring(is_host))
end

function bom_match.vote_rematch()
    if match.rematch_voted then return end
    match.rematch_voted = true
    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({ type = "rematch_vote" })
        end
    end)
    mp_log.info("BOM_MATCH", "voted for rematch")
end

function bom_match.has_voted_rematch()
    return match.rematch_voted
end


function bom_match.on_blind_entered(ante, blind_type)
    if not bom_match.is_in_match() then return end

    if match.phase == bom_match.PHASE.PVP_RESOLVE then
        mp_log.warn("BOM_MATCH", "blind_entered while stuck in PVP_RESOLVE - force-recovering to PLAYING")
        pcall(function()
            require("functions/fast_fs").append("mp_match_debug.txt",
                "\n[PVP_RESOLVE_RECOVERY] ante=" .. tostring(ante)
                .. " blind=" .. tostring(blind_type)
                .. " - server pvp_resolved or state update was likely lost")
        end)
        match.phase = bom_match.PHASE.PLAYING
        match.end_pvp = false
    end

    match.current_ante = ante or match.current_ante
    match.current_blind = blind_type or match.current_blind
    match.pvp_submitted = false
    match.pvp_received = false
    match.my_score = 0
    match.opp_score = 0
    match.opp_blind_finished = false

    local is_pvp = bom_match.is_blind_pvp(ante, blind_type)

    mp_log.info("BOM_MATCH", "blind_entered: ante=%s blind=%s pvp=%s", tostring(ante), tostring(blind_type), tostring(is_pvp))

    if is_pvp then
        bom_match.transition(bom_match.PHASE.PVP_BLIND)
    else
        bom_match.transition(bom_match.PHASE.PLAYING)
    end

    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({
                type = "blind_entered",
                ante = ante,
                blind = blind_type,
            })
        end
    end)

    pcall(function()
        if G and G.GAME then
            G.GAME.mp_in_boss_blind = is_pvp
            if G.GAME.mp_opponent_panel then
                G.GAME.mp_opponent_panel.blind_finished = false
            end
        end
    end)
end


function bom_match.on_blind_defeated(score)
    if not bom_match.is_in_match() then return end

    score = score or 0
    pcall(function() score = G.GAME.chips or score end)

    local is_pvp = bom_match.is_blind_pvp(match.current_ante, match.current_blind)

    mp_log.info("BOM_MATCH", "blind_defeated: score=%s pvp=%s ante=%s", tostring(score), tostring(is_pvp), tostring(match.current_ante))

    if is_pvp and match.phase ~= bom_match.PHASE.PVP_BLIND then
        mp_log.debug("BOM_MATCH", "blind_defeated: PvP blind already resolved, nothing to submit")
        return
    end

    match.my_score = score
    match.pvp_submitted = true

    if is_pvp then
        bom_match.transition(bom_match.PHASE.PVP_RESOLVE)
    end

    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({
                type = "blind_finished",
                ante = match.current_ante,
                blind = match.current_blind,
                score = score,
                lives = match.my_lives,
            })
        end
    end)

end


function bom_match.on_game_over()
    if not bom_match.is_in_match() then return end

    mp_log.info("BOM_MATCH", "game_over: ante=%s blind=%s", tostring(match.current_ante), tostring(match.current_blind))

    local is_pvp = bom_match.is_blind_pvp(match.current_ante, match.current_blind)
    if is_pvp then
        mp_log.info("BOM_MATCH", "game_over redirected to blind_defeated (PvP - life loss, not match loss)")
        local score = 0
        pcall(function() score = G.GAME.chips or 0 end)
        bom_match.on_blind_defeated(score)
        return
    end

    bom_match.mark_round_lost()
    pcall(function()
        if G and G.GAME and G.GAME.blind then
            G.GAME.blind.chips = -1
        end
    end)
    pcall(function()
        if bom_core and bom_core.send and not match.match_over then
            local score = 0
            pcall(function()
                if G and G.GAME and G.GAME.chips then
                    score = G.GAME.chips
                end
            end)
            bom_core.send({
                type = "game_over",
                ante = match.current_ante,
                blind = match.current_blind,
                score = score,
            })
        end
    end)
    pcall(function()
        if G and G.STATES and G.E_MANAGER then
