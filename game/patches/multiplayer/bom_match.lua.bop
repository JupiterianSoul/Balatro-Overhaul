-- DEPRECATED LEGACY STUBS-- These functions existed for the old peer-to-peer server path.
-- Life/match-end management is now fully server-authoritative.
-- Kept as no-op stubs so bom_sync/bom_rewards/bom_events callers don't error.
-- ============================================

-- FIX P3#46: downgraded warn -> debug to reduce log spam from legacy callers
-- that haven't been removed yet (bom_sync.resolve_boss_blind, bom_events legacy paths).
-- These no-ops are safe; the warning was alarming readers without indicating a real bug.
function bom_match.lose_life(reason)
    mp_log.debug("BOM_MATCH", "lose_life() deprecated no-op (server-authoritative). reason=%s", tostring(reason))
end

function bom_match.on_opponent_life_update(_lives)
    mp_log.debug("BOM_MATCH", "on_opponent_life_update() deprecated no-op (server-authoritative)")
end

function bom_match.on_opponent_eliminated(_data)
    mp_log.debug("BOM_MATCH", "on_opponent_eliminated() deprecated no-op (server-authoritative)")
end

-- ============================================
-- STAGE 4: STATE RESYNC + DESYNC DETECTION
-- ============================================

-- Request authoritative state push from server (e.g. after reconnect or desync).
function bom_match.request_state_sync()
    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({ type = "request_state" })
            mp_log.debug("BOM_MATCH", "request_state_sync: sent request_state to server")
        end
    end)
end

-- Called when server sends a desync_check message.
-- Compares server-reported lives and ante against local state;
-- requests an authoritative resync if any value is discrepant.
function bom_match.check_desync(data)
    if not data then return end
    if not bom_match.is_in_match() then return end

    local discrepant = false

    if data.myLives ~= nil and data.myLives ~= match.my_lives then
        mp_log.warn("BOM_MATCH", "DESYNC: my_lives server=%s local=%s",
            tostring(data.myLives), tostring(match.my_lives))
        discrepant = true
    end
    if data.currentAnte ~= nil and data.currentAnte ~= match.current_ante then
        mp_log.warn("BOM_MATCH", "DESYNC: ante server=%s local=%s",
            tostring(data.currentAnte), tostring(match.current_ante))
        discrepant = true
    end
    if data.oppLives ~= nil and data.oppLives ~= match.opp_lives then
        mp_log.warn("BOM_MATCH", "DESYNC: opp_lives server=%s local=%s",
            tostring(data.oppLives), tostring(match.opp_lives))
        discrepant = true
    end

    if discrepant then
        mp_log.warn("BOM_MATCH", "DESYNC detected -- requesting authoritative state from server")
        bom_match.request_state_sync()
    end
end

function bom_match.final_ante_for(s, stake)
    s = s or {}
    local w = tonumber(s.win_ante)
    if w and w >= 1 and w <= 999 and w == math.floor(w) then return w end
    stake = tonumber(stake) or tonumber(s.stake) or 1
    if stake >= 9 and stake <= 12 then return stake + 1 end
    return 8
end

function bom_match.final_ante()
    local fa = tonumber(match.server_final_ante)
    if fa and fa >= 1 then return fa end
    local stake = nil
    pcall(function() if G and G.GAME and G.GAME.stake then stake = tonumber(G.GAME.stake) end end)
    return bom_match.final_ante_for(match.settings, stake)
end

function bom_match.server_decides_final()
    if not bom_match.is_in_match() then return false end
    local mode = match.mode or (match.settings and match.settings.mode) or "nemesis"
    if mode == "vanilla" or mode == "ascension" then return false end
    return bom_match.is_blind_pvp(bom_match.final_ante(), "L") == true
end

function bom_match.get_sudden_death()
    return match.sudden_death or 0
end

function bom_match.set_final_state(final_ante, sudden_death)
    local fa = tonumber(final_ante)
    if fa and fa >= 1 then match.server_final_ante = fa end
    local sd = tonumber(sudden_death)
    if sd and sd >= 0 and sd ~= (match.sudden_death or 0) then
        match.sudden_death = sd
        mp_log.info("BOM_MATCH", "sudden death round=%s final_ante=%s", tostring(sd), tostring(match.server_final_ante))
        bom_match.apply_sudden_death_label()
    end
end

function bom_match.apply_sudden_death_label()
    pcall(function()
        local loc = G and G.localization and G.localization.descriptions and G.localization.descriptions.Blind
        local e = loc and loc["bl_mp_nemesis"]
r 4 1300 %20%20%20%20%20%20%20%20 -
l 118
        if (match.sudden_death or 0) > 0 then
            e.name = mod_loc("Sudden Death")
            e.text = { mod_loc("Sudden death: score more"), mod_loc("or lose a life") }
        else
            e.name = mod_loc("The Rival")
            e.text = { "Score more points than", "your opponent to win!" }
        end
        if loc_parse_string then
            e.text_parsed = {}
            for _, line in ipairs(e.text) do e.text_parsed[#e.text_parsed + 1] = loc_parse_string(line) end
            e.name_parsed = { loc_parse_string(e.name) }
        end
    end)
end

function bom_match.apply_sudden_death_blinds()
    if (match.sudden_death or 0) <= 0 or not bom_match.is_in_match() then return end
    pcall(function()
        local rr = G.GAME.round_resets
        rr.blind_states.Small = 'Skipped'
        rr.blind_states.Big = 'Skipped'
        rr.blind_states.Boss = 'Upcoming'
        G.GAME.blind_on_deck = 'Boss'
        mp_log.info("BOM_MATCH", "sudden death: only the Nemesis blind is played at ante %s", tostring(rr.ante))
    end)
end

-- ============================================
-- MATCH END
-- ============================================

function bom_match.end_match(result, reason, opts)
    if match.match_over then return end
    if result == "win" and reason == "run_completed" and not (opts and opts.from_server)
        and bom_core and bom_core.is_connected and bom_core.is_connected() and G and G.GAME then
        if not G.GAME.mp_run_claimed then
            G.GAME.mp_run_claimed = true
            if bom_party and bom_party.active() then return end
            mp_log.info("BOM_MATCH", "run completed, asking the server for the verdict")
            pcall(function()
                bom_core.send({ type = "match_finished", result = result, reason = reason, lives = match.my_lives })
            end)
        end
        return
    end
    match.match_over = true
    match.match_result = result
    match.end_reason = reason
    pcall(function()
        if bom_ranked and bom_ranked.session_add and not (bom_party and bom_party.active()) then
            bom_ranked.session_add({
                result = result, reason = reason, opp = match.opp_name, mode = match.mode,
                ante = match.current_ante, pvp_wins = match.pvp_wins, pvp_losses = match.pvp_losses,
            })
        end
    end)
    pcall(function() bom_match.flush_pending_pvp_loss("match_end") end)
    bom_match.transition(bom_match.PHASE.MATCH_END)
    pcall(function() bom_spectate.wait_over() end)
    pcall(function()
        if bom_ui and bom_ui.hide_pvp_waiting then bom_ui.hide_pvp_waiting() end
    end)

    mp_log.info("BOM_MATCH", "end_match: result=%s reason=%s myLives=%s oppLives=%s",
        tostring(result), tostring(reason), tostring(match.my_lives), tostring(match.opp_lives))

    bom_match.restore_fairness()

    -- Notify server
    pcall(function()
        if bom_core and bom_core.send and not (opts and opts.from_server) and not (bom_party and bom_party.active()) then
            bom_core.send({
                type = "match_finished",
                result = result,
                reason = reason or "normal",
                lives = match.my_lives,
            })
        end
    end)

    pcall(function() if bom_ui and bom_ui.cleanup_end_game_state then bom_ui.cleanup_end_game_state() end end)
    pcall(function()
        if bom_ui and bom_ui.send_end_game_data and result ~= "draw"
            and not (bom_rejoin and bom_rejoin.is_closing_reason and bom_rejoin.is_closing_reason(reason))
            and bom_core and bom_core.is_connected and bom_core.is_connected() then
            bom_ui.send_end_game_data()
        end
    end)

    -- FIX: Award rewards BEFORE disconnect early-return so all paths get them
    pcall(function()
        if bom_rewards and bom_rewards.on_match_end then
            bom_rewards.on_match_end({
                result = result,
                reason = reason,
                pvp_wins = match.pvp_wins,
                pvp_losses = match.pvp_losses,
            })
        end
    end)

    -- REMOVED: store_match_debrief and record_game_history (MATCH RESULTS feature gutted)

    if bom_rejoin and bom_rejoin.on_match_end_local and bom_rejoin.on_match_end_local(result, reason) then
        return
    end
    if result == "draw" and bom_rejoin and bom_rejoin.exit_to_menu then
        bom_rejoin.exit_to_menu({ result = result, reason = reason, opp_name = match.opp_name })
        return
    end

    -- Mark that we can rematch (reset vote state)
    match.rematch_voted = false

    -- If we WON (opponent eliminated/quit), force the win screen overlay
    -- The loser's game already naturally enters GAME_OVER state, but a winner
    -- in the middle of their run never gets a screen without this.
    if result == "win" and G and G.GAME and G.GAME.multiplayer then
