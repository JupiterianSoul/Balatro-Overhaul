local M = {}

function M.init(bom_ui)
    local function _show_mp_overlay(ref_name, definition)
        if not G or not G.FUNCS or not G.FUNCS.overlay_menu then return end
        bom_ui.overlay({definition = definition})
        G[ref_name] = G.OVERLAY_MENU
    end

    local function _hide_mp_overlay(ref_name)
        if not G then return end
        local overlay = G[ref_name]
        if overlay then
            if G.OVERLAY_MENU == overlay and G.FUNCS and G.FUNCS.exit_overlay_menu then
                pcall(function() G.FUNCS.exit_overlay_menu() end)
            else
                pcall(function() overlay:remove() end)
            end
            G[ref_name] = nil
        end
    end

    bom_ui._pending_debrief = nil
    bom_ui._game_history = {}
    bom_ui._end_joker_data = nil
    bom_ui._end_joker_area = nil
    bom_ui._my_joker_keys = {}
    bom_ui._showing_enemy_jokers = true
    bom_ui._end_joker_label = "Enemy Jokers"
    bom_ui._nemesis_deck_data = nil


    function bom_ui.show_pvp_result(result, my_score, opp_score)
        local st = {}
        pcall(function() st = bom_match.get_state() or {} end)
        local list = {}
        pcall(function() list = bom_ui.roster() end)
        local me, opp = list[1] or {}, list[2] or {}
        local before = bom_ui._lives_before
        local after = (st.pvp_loss_pending and st.pvp_pending_lives) or (G and G.GAME and G.GAME.mp_lives)
        if before == nil then before = after end
        bom_ui._lives_before = nil
        return bom_ui.pvp_result_popup({
            result = result, my_score = my_score, opp_score = opp_score,
            my_name = me.name, opp_name = opp.name,
            lives_before = tonumber(before), lives_after = tonumber(after),
        })
    end


