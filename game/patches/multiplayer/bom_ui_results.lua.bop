    function bom_ui.create_mp_game_over(opts)
        return results_def("over", opts)
    end

    function bom_ui.create_mp_win(opts)
        return results_def("win", opts)
    end

    function bom_ui.create_mp_lose(opts)
        return results_def("lose", opts)
    end
