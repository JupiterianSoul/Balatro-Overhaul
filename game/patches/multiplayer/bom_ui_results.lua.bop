    function bom_ui.opp_deck_tab()
        local d = bom_ui._nemesis_deck_data
        local saved_cards, saved_back = G.playing_cards, G.GAME.selected_back
        local temp = {}
        local ok, def = pcall(function()
            for _, c in ipairs(d.cards or {}) do
                local front = c.f and G.P_CARDS[c.f]
                if front then
                    local center = (c.e and G.P_CENTERS[c.e]) or G.P_CENTERS.c_base
                    local card = Card(0, 0, G.CARD_W, G.CARD_H, front, center)
                    if c.ed and G.P_CENTERS["e_" .. c.ed] then card:set_edition({ [c.ed] = true }, true, true) end
                    if c.s and G.P_SEALS and G.P_SEALS[c.s] then card:set_seal(c.s, true, true) end
                    temp[#temp + 1] = card
                end
            end
            G.playing_cards = temp
            if d.back and G.P_CENTERS[d.back] then G.GAME.selected_back = Back(G.P_CENTERS[d.back]) end
            return G.UIDEF.view_deck(false)
        end)
        G.playing_cards = saved_cards
        G.GAME.selected_back = saved_back
        for _, card in ipairs(temp) do pcall(function() card:remove() end) end
        if ok then return def end
        pcall(function() mp_log.error("BOM_UI", "opponent deck view failed: %s", tostring(def)) end)
        return {n=G.UIT.ROOT, config={align = "cm", colour = G.C.CLEAR, minw = 6, minh = 3}, nodes={
            {n=G.UIT.T, config={text = mod_loc("Deck data not available"), scale = 0.4, colour = G.C.UI.TEXT_INACTIVE, shadow = true}},
        }}
    end

