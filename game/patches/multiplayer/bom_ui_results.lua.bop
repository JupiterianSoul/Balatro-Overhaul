    function bom_ui.reopen_results()
        pcall(function()
            local st = bom_match.get_state()
            local def
            if st.match_result == "win" then
                def = bom_ui.create_mp_win()
            elseif G.STATE == G.STATES.GAME_OVER then
                def = bom_ui.create_mp_game_over()
            else
                def = bom_ui.create_mp_lose()
            end
            bom_ui._end_joker_area = nil
            bom_ui.overlay({ definition = def, config = { no_esc = true } })
        end)
    end

    function bom_ui.show_end_jokers_overlay(enemy)
        if not G or not G.FUNCS then return end
        bom_ui.register_funcs()
        bom_ui._showing_enemy_jokers = enemy and true or false
