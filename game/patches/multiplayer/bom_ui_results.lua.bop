    function bom_ui.request_end_game_jokers()
        pcall(function()
            if bom_core and bom_core.send then
                bom_core.send({ type = "get_end_game_jokers" })
            end
        end)
    end

    local END_KEY_PATTERN = "^[%w_%.:%-]+$"

    local function end_key(v)
        if type(v) == "string" and #v > 0 and #v <= 64 and v:match(END_KEY_PATTERN) then return v end
        return nil
    end

    function bom_ui.collect_end_game_data()
        local data = { jokers = {}, deck = { cards = {} } }
        pcall(function()
            for _, c in ipairs((G.jokers and G.jokers.cards) or {}) do
                if #data.jokers >= 100 then break end
                local k = end_key(c.config and c.config.center and c.config.center.key)
                if k then
                    local j = { k = k }
                    j.ed = end_key(c.edition and c.edition.type)
                    local st = {}
                    if c.ability and c.ability.eternal then st[#st + 1] = "eternal" end
                    if c.ability and c.ability.perishable then st[#st + 1] = "perishable" end
                    if c.ability and c.ability.rental then st[#st + 1] = "rental" end
                    if #st > 0 then j.st = st end
                    data.jokers[#data.jokers + 1] = j
                end
            end
        end)
        pcall(function()
            data.deck.back = end_key(G.GAME.selected_back.effect.center.key)
        end)
        pcall(function()
            for _, c in ipairs(G.playing_cards or {}) do
                if #data.deck.cards >= 1000 then break end
                local f = end_key(c.config and c.config.card_key)
                if f then
                    local card = { f = f }
                    local e = c.config.center and c.config.center.key
                    if e and e ~= "c_base" then card.e = end_key(e) end
                    card.ed = end_key(c.edition and c.edition.type)
                    card.s = end_key(c.seal)
                    data.deck.cards[#data.deck.cards + 1] = card
                end
            end
        end)
        return data
    end

    function bom_ui.send_end_game_data()
        local data = bom_ui.collect_end_game_data()
        bom_ui._my_end_data = data
        bom_ui._my_joker_keys = data.jokers
        pcall(function()
            if bom_core and bom_core.send then
                bom_core.send({ type = "end_game_data", jokers = data.jokers, deck = data.deck })
            end
        end)
        pcall(function() mp_log.info("BOM_UI", "end game data sent: %d jokers, %d cards", #data.jokers, #data.deck.cards) end)
    end

    local function make_end_joker(j, x, y)
        local center = G.P_CENTERS[j.k]
        if not center then return nil end
        local card = Card(x, y, G.CARD_W, G.CARD_H, G.P_CARDS.empty, center, { bypass_discovery_center = true, bypass_discovery_ui = true })
        if j.ed and G.P_CENTERS["e_" .. j.ed] then card:set_edition({ [j.ed] = true }, true, true) end
        for _, s in ipairs(j.st or {}) do
            if s == "eternal" then card.ability.eternal = true end
            if s == "perishable" then
                card.ability.perishable = true
                card.ability.perish_tally = card.ability.perish_tally or (G.GAME and G.GAME.perishable_rounds) or 5
            end
            if s == "rental" then card.ability.rental = true end
        end
        return card
    end

    function bom_ui.populate_joker_area(area, jokers)
        if not area or not G or not G.P_CENTERS then return end
        for i = #area.cards, 1, -1 do
            pcall(function() area.cards[i]:remove() end)
        end
        area.cards = {}
        for _, j in ipairs(jokers or {}) do
            pcall(function()
                if type(j) == "string" then j = { k = j } end
                local card = make_end_joker(j, area.T.x + area.T.w / 2, area.T.y)
                if card then
                    card:start_materialize(nil, true)
                    area:emplace(card)
                end
            end)
        end
    end

    function bom_ui.load_end_game_jokers(data)
        if not data then return end
        if data.available == false and bom_ui._end_joker_data then return end
        bom_ui._end_joker_data = data.available ~= false and data or nil
        if data.available ~= false and G and G.OVERLAY_MENU and G.OVERLAY_MENU.config
            and G.OVERLAY_MENU:get_UIE_by_ID("mp_end_jokers_UI") and bom_ui._showing_enemy_jokers then
            bom_ui.show_end_jokers_overlay(true)
        end
    end

