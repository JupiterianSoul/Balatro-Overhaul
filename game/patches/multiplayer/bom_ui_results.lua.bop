    function bom_ui.on_nemesis_deck_data(d)
        if type(d) ~= "table" then return end
        bom_ui._nemesis_deck_data = d
        if G and G.OVERLAY_MENU and G.OVERLAY_MENU:get_UIE_by_ID("mp_end_deck_UI")
            and not G.OVERLAY_MENU:get_UIE_by_ID("tab_contents") then
            bom_ui.show_nemesis_deck_overlay()
        end
    end

    function bom_ui.cleanup_end_game_state()
        if bom_ui._end_joker_area then
            pcall(function()
                for i = #bom_ui._end_joker_area.cards, 1, -1 do
                    pcall(function() bom_ui._end_joker_area.cards[i]:remove() end)
                end
                bom_ui._end_joker_area.cards = {}
            end)
            bom_ui._end_joker_area = nil
        end
        bom_ui._end_joker_data = nil
        bom_ui._my_end_data = nil
        bom_ui._my_joker_keys = {}
        bom_ui._nemesis_deck_data = nil
        bom_ui._showing_enemy_jokers = true
        bom_ui._end_joker_label = "Enemy Jokers"
    end


    do
        local _orig_register = bom_ui.register_funcs
        bom_ui.register_funcs = function()
            _orig_register()
            if not G or not G.FUNCS then return end
            G.FUNCS.mp_vote_rematch_from_screen = function(e)
                pcall(function()
                    local st = bom_match.get_state()
                    if st.rematch_voted or st.room_closed_text then return end
                    st.rematch_votes = st.rematch_votes or { false, false }
                    st.rematch_votes[bom_match.my_seat() + 1] = true
                    bom_match.vote_rematch()
                end)
                bom_ui.refresh_rematch_status()
            end
            G.FUNCS.mp_return_to_lobby = function(e)
                pcall(function()
                    if not (bom_match and bom_match.my_seat and bom_match.my_seat() == 0) then return end
                    if bom_ui._lobby_return_sent or bom_match.get_state().room_closed_text then return end
                    bom_ui._lobby_return_sent = true
                    bom_core.send({ type = "return_to_lobby" })
                    local box = G.OVERLAY_MENU
                    local btn = box and box:get_UIE_by_ID('mp_return_lobby_btn')
                    if btn then
                        btn.config.button = nil
                        btn.config.colour = G.C.UI.BACKGROUND_INACTIVE
                    end
                end)
            end
            G.FUNCS.toggle_players_jokers = function(e)
                pcall(function() bom_ui.show_end_jokers_overlay(not bom_ui._showing_enemy_jokers) end)
            end
            G.FUNCS.mp_view_opp_jokers = function(e)
                pcall(function() bom_ui.show_end_jokers_overlay(true) end)
            end
            G.FUNCS.view_nemesis_deck = function(e)
                pcall(function() bom_ui.show_nemesis_deck_overlay() end)
            end
            G.FUNCS.mp_end_view_back = function(e)
                bom_ui.reopen_results()
            end
            G.FUNCS.mp_request_end_game_jokers = function(e)
                pcall(function() bom_ui.request_end_game_jokers() end)
            end
        end
    end


    bom_ui._rematch_ui = bom_ui._rematch_ui or { text = "" }

    function bom_ui.rematch_status_text()
        local st = bom_match and bom_match.get_state and bom_match.get_state() or {}
        local votes = st.rematch_votes or { false, false }
        local me = (bom_match and bom_match.my_seat and bom_match.my_seat()) or 0
        local mine = votes[me + 1] == true or st.rematch_voted == true
        local theirs = votes[2 - me] == true
        local opp = tostring(st.opp_name or "P2")
        if st.room_closed_text then return mod_loc(st.room_closed_text) end
        if mine and theirs then return mod_loc("Starting rematch...") end
        if mine then return string.format(mod_loc("Waiting for %s..."), opp) end
        if theirs then return string.format(mod_loc("%s wants a rematch"), opp) end
        return ""
    end

    function bom_ui.refresh_rematch_status()
        pcall(function()
            local text = bom_ui.rematch_status_text()
            bom_ui._rematch_ui.text = text
            local box = G.OVERLAY_MENU
            local el = box and box.get_UIE_by_ID and box:get_UIE_by_ID('mp_rematch_status')
            if el and el.config then
                el.config.text = text
                el.config.prev_value = text
                if el.config.text_drawable then el.config.text_drawable:set(text) end
                box:recalculate()
            end
            local st = bom_match and bom_match.get_state and bom_match.get_state() or {}
            local me = (bom_match and bom_match.my_seat and bom_match.my_seat()) or 0
            local voted = (st.rematch_votes and st.rematch_votes[me + 1]) or st.rematch_voted
            local btn = box and box.get_UIE_by_ID and box:get_UIE_by_ID('mp_rematch_btn')
            if btn and (voted or st.room_closed_text) then
                btn.config.button = nil
                btn.config.colour = G.C.UI.BACKGROUND_INACTIVE
            end
            local lobby = st.room_closed_text and box and box.get_UIE_by_ID and box:get_UIE_by_ID('mp_return_lobby_btn')
            if lobby then
                lobby.config.button = nil
                lobby.config.colour = G.C.UI.BACKGROUND_INACTIVE
            end
        end)
    end

    function bom_ui.results_room_closed(reason)
        local st = bom_match.get_state()
        st.room_closed_text = reason == "room_expired" and "Room closed" or "Opponent left"
        bom_ui.refresh_rematch_status()
    end

    function bom_ui.mp_results_buttons()
        if bom_party and bom_party.active() then
            local list = bom_party.results_buttons()
            local contest = bom_ui.contest_button_node and bom_ui.contest_button_node(3.4) or nil
            if contest and type(list) == "table" then
                list[#list + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.2, minw = 0.1}, nodes={}}
                list[#list + 1] = contest
            end
            local rp = rawget(_G, "bom_replay")
            local watch = rp and rp.results_button_node and rp.results_button_node(3.4) or nil
            if watch and type(list) == "table" then
                list[#list + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.2, minw = 0.1}, nodes={}}
                list[#list + 1] = watch
            end
            return list
        end
        local is_host = false
        pcall(function() is_host = bom_match.my_seat() == 0 end)
        bom_ui._lobby_return_sent = nil
        bom_ui._rematch_ui.text = bom_ui.rematch_status_text()
        local nodes = {}
        nodes[#nodes + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.4, minw = 3.4}, nodes={
            {n=G.UIT.T, config={id = 'mp_rematch_status', ref_table = bom_ui._rematch_ui, ref_value = 'text', scale = 0.3, colour = G.C.GOLD, shadow = true, maxw = 3.4}},
        }}
        nodes[#nodes + 1] = UIBox_button({id = 'mp_rematch_btn', button = 'mp_vote_rematch_from_screen', label = {mod_loc('Rematch')}, colour = G.C.GREEN, minw = 3.4, maxw = 3.4, minh = 1, focus_args = {nav = 'wide', snap_to = true}})
        if is_host then
            nodes[#nodes + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.2, minw = 0.1}, nodes={}}
            nodes[#nodes + 1] = UIBox_button({id = 'mp_return_lobby_btn', button = 'mp_return_to_lobby', label = {mod_loc('Return to Lobby')}, colour = G.C.BLUE, minw = 3.4, maxw = 3.4, minh = 1, focus_args = {nav = 'wide'}})
        end
        nodes[#nodes + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.2, minw = 0.1}, nodes={}}
        nodes[#nodes + 1] = {n=G.UIT.R, config={align = "cm"}, nodes={
            UIBox_button({id = 'mp_opp_jokers_btn', button = 'mp_view_opp_jokers', label = {mod_loc('Their Jokers')}, colour = G.C.ORANGE, minw = 1.65, maxw = 1.45, minh = _G._IS_DESKTOP and 0.7 or 0.85, scale = 0.4, col = true, focus_args = {nav = 'wide'}}),
r 13 1864 %20%20%20%20%20%20%20%20%20%20%20%20 -
l 130
            UIBox_button({id = 'mp_opp_deck_btn', button = 'view_nemesis_deck', label = {mod_loc('Their Deck')}, colour = G.C.ORANGE, minw = 1.65, maxw = 1.45, minh = _G._IS_DESKTOP and 0.7 or 0.85, scale = 0.4, col = true, focus_args = {nav = 'wide'}}),
        }}
        nodes[#nodes + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.2, minw = 0.1}, nodes={}}
        local contest = bom_ui.contest_button_node and bom_ui.contest_button_node(3.4) or nil
        if contest then
            nodes[#nodes + 1] = contest
            nodes[#nodes + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.2, minw = 0.1}, nodes={}}
        end
        local rp = rawget(_G, "bom_replay")
        local watch = rp and rp.results_button_node and rp.results_button_node(3.4) or nil
        if watch then
            nodes[#nodes + 1] = watch
            nodes[#nodes + 1] = {n=G.UIT.R, config={align = "cm", minh = 0.2, minw = 0.1}, nodes={}}
        end
        nodes[#nodes + 1] = UIBox_button({id = 'mp_leave_lobby_btn', button = 'mp_leave_lobby', label = {mod_loc('Quit')}, colour = G.C.RED, minw = 3.4, maxw = 3.4, minh = 1, focus_args = {nav = 'wide'}})
        local voted, gone = false, false
        pcall(function()
            local st = bom_match.get_state()
            voted = st.rematch_voted or (st.rematch_votes and st.rematch_votes[bom_match.my_seat() + 1])
            gone = st.room_closed_text ~= nil
        end)
        if voted or gone then
            nodes[2].nodes[1].config.button = nil
            nodes[2].nodes[1].config.colour = G.C.UI.BACKGROUND_INACTIVE
        end
        if gone and is_host then
            nodes[4].nodes[1].config.button = nil
            nodes[4].nodes[1].config.colour = G.C.UI.BACKGROUND_INACTIVE
        end
        return nodes
    end

    local RESULT_GROUPS = {
        mp_rematch_btn = 1, party_standings_btn = 1, mp_return_lobby_btn = 1,
        mp_opp_jokers_btn = 2, mp_opp_deck_btn = 2,
        mp_watch_replay_btn = 3, match_recap_btn = 3,
        mp_contest_btn = 4,
        mp_leave_lobby_btn = 6,
    }

    local function result_button(node)
        local inner = type(node) == "table" and type(node.nodes) == "table" and #node.nodes == 1 and node.nodes[1] or nil
        if inner and inner.n == G.UIT.C and inner.config and inner.config.hover then return inner end
    end

    local function result_size(node, w, h, scale)
        local inner = result_button(node)
        node.n = G.UIT.C
        inner.config.minw, inner.config.minh = w, h
        for _, row in ipairs(inner.nodes or {}) do
            if row.config then row.config.minw, row.config.maxw = w, w - 0.2 end
            for _, t in ipairs(row.nodes or {}) do
                if t.n == G.UIT.T and t.config then t.config.scale = scale end
            end
        end
        return node
    end

    function bom_ui.results_panel(list)
        local touch = UIK and UIK.touch and UIK.touch()
        local w, h, gap, pad = 2.8, touch and 0.9 or 0.78, 0.12, 0.05
        local full = 2 * w + gap + 2 * pad
        local scale = touch and 0.45 or 0.42
        local status, groups = nil, {}
        local function add(node)
            local inner = result_button(node)
            if not inner then return false end
            local g = RESULT_GROUPS[inner.config.id] or 5
            groups[g] = groups[g] or {}
            groups[g][#groups[g] + 1] = node
            return true
        end
        for _, node in ipairs(list or {}) do
            if not add(node) then
                local kids = type(node) == "table" and node.nodes or {}
                if not status and kids[1] and kids[1].n == G.UIT.T then
                    status = node
                else
                    for _, k in ipairs(kids) do add(k) end
                end
            end
        end
        local rows = {}
        for g = 1, 6 do
            local items = groups[g] or {}
            local i = 1
            while i <= #items do
                local a, b = items[i], g ~= 6 and items[i + 1] or nil
                local cells
                if b then
                    cells = {result_size(a, w, h, scale), {n = G.UIT.C, config = {minw = gap}, nodes = {}}, result_size(b, w, h, scale)}
                    i = i + 2
                else
                    cells = {result_size(a, full, h, scale)}
                    i = i + 1
                end
                rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = pad}, nodes = cells}
            end
        end
        if status then
            status.config.minw = full
            if status.nodes[1].config then status.nodes[1].config.maxw = full end
            rows[#rows + 1] = status
        end
        return rows
    end

