    function bom_ui.send_taunt()
        if not G then return end
        if not G.GAME then return end
        if not G.GAME.multiplayer then return end

        local title = ""
        pcall(function()
            if CosmeticsManager and CosmeticsManager.get_equipped then
                title = CosmeticsManager.get_equipped("title") or ""
            end
        end)

        bom_core.send({ type = "taunt", title = title, timestamp = os.time() })
    end

    function bom_ui.receive_taunt(data)
        if not G then return end
        if not data then return end

        local title = data.title or ""
        local opponent_name = "Opponent"
