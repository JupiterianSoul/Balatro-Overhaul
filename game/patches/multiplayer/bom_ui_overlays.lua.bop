    -- ============================================
    -- CLEANUP — Remove all MP overlays
    -- ============================================

    function bom_ui.cleanup()
        bom_ui.hide_searching_screen()
        bom_ui.hide_room_code()
        pcall(function() bom_ui.hide_waiting_screen() end)
        bom_ui.hide_sabotage_picker()
        bom_ui.hide_error()
        bom_ui.hide_match_results()
        bom_ui.hide_lobby()
        bom_ui.destroy_match_hud()
        _hide_mp_overlay("BOM_LOBBY_SETTINGS_OVERLAY")
        _hide_mp_overlay("BOM_REMATCH_OVERLAY")
        _hide_mp_overlay("BOM_SABOTAGE_OVERLAY")
        _hide_mp_overlay("MP_DEBRIEF_OVERLAY")
        _hide_mp_overlay("MP_WAITING_OVERLAY")
        if G.MP_MATCH_START_OVERLAY then
            pcall(function() G.MP_MATCH_START_OVERLAY:remove() end)
            G.MP_MATCH_START_OVERLAY = nil
        end
        if G.MP_DISCONNECT_WIN_OVERLAY then
            pcall(function() G.MP_DISCONNECT_WIN_OVERLAY:remove() end)
            G.MP_DISCONNECT_WIN_OVERLAY = nil
        end
    end

