local M = {}

function M.init(bom_ui)
    local function _show_mp_overlay(ref_name, definition)
        if not G or not G.FUNCS or not G.FUNCS.overlay_menu then return end
        G.SETTINGS = G.SETTINGS or {}
r 4 1381 %20%20%20%20%20%20%20%20 -
l 34
        bom_ui.overlay({definition = definition})
        G[ref_name] = G.OVERLAY_MENU
    end

    local function _hide_mp_overlay(ref_name)
        if not G then return end
        local overlay = G[ref_name]
        if overlay then
            if G.OVERLAY_MENU == overlay and G.FUNCS and G.FUNCS.exit_overlay_menu then
                pcall(function() G.FUNCS.exit_overlay_menu() end)
            else
                pcall(function() overlay:remove() end)
            end
            G[ref_name] = nil
        end
    end

    -- ============================================
    -- SABOTAGE PICKER SCREEN
    -- FEATURE: Redesigned — card-style bordered columns, name + description + PICK button
    -- ============================================

    function bom_ui.show_sabotage_picker(picks, on_chosen)
        if not G then return end
        if not picks or #picks < 1 then return end

        for i, pick in ipairs(picks) do
            local pick_id = pick.id
            G.FUNCS["mp_pick_sabotage_" .. i] = function()
                bom_ui.hide_sabotage_picker()
                if on_chosen then on_chosen(pick_id) end
            end
        end

