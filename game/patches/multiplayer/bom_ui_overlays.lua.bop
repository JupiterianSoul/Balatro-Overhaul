            if G.GAME and G.GAME.mp_opponent and G.GAME.mp_opponent.name then
                opponent_name = G.GAME.mp_opponent.name
            end
        end)

        local taunt_text = opponent_name
        if title and title ~= "" then
            taunt_text = title .. " " .. opponent_name
        end

