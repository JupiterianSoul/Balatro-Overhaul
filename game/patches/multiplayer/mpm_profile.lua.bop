                ["Matches"] = "Matchs", ["Level"] = "Niveau", ["Experience"] = "Expérience", ["XP"] = "XP", ["Ranked Packs"] = "Paquets classés", ["Packs to open"] = "Paquets à ouvrir",
                ["Every match gives XP. Each level gives a Ranked Pack."] = "Chaque match donne de l'XP. Chaque niveau donne un paquet classé.",
                ["Packs hold cosmetics for your loadout."] = "Les paquets contiennent des cosmétiques.", ["OPEN PACK"] = "OUVRIR",
                ["Your name"] = "Votre nom", ["Current name"] = "Nom actuel", ["New name"] = "Nouveau nom", ["Enter a name"] = "Entrez un nom", ["SAVE NAME"] = "ENREGISTRER",
                ["The server checks that nobody online uses it"] = "Le serveur vérifie que personne en ligne ne l'utilise", ["Checking the name..."] = "Vérification du nom...",
                ["Name saved"] = "Nom enregistré", ["Pick your own name"] = "Choisissez votre nom", ["That name is too long."] = "Ce nom est trop long.",
                ["Type a name first."] = "Écrivez d'abord un nom.", ["That name has characters we can't show."] = "Ce nom contient des caractères non affichables.",
                ["That name can't be used."] = "Ce nom ne peut pas être utilisé.", ["That name is already used by another online player."] = "Ce nom est déjà utilisé par un autre joueur en ligne.",
                ["Recovery code"] = "Code de récupération", ["Your code"] = "Votre code", ["Hidden"] = "Caché", ["Keep it safe, it restores your rank"] = "Gardez-le bien, il restaure votre rang",
