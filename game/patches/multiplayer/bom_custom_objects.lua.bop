local function mp_joker_calc(self, key, context)
    local e = self.ability.extra or {}
    local main = context.cardarea == G.jokers and context.joker_main
    if key == 'j_mp_truce' and main then
        if is_pvp_blind() then
            local m = e.mult or 8
            return { message = msg_mult(m), mult_mod = m }
        end
        local x = e.x_mult or 8
        return { message = msg_x(x), Xmult_mod = x }
    elseif key == 'j_mp_bulwark' and main then
        local c = bulwark_chips(self)
        if c > 0 then return { message = msg_chips(c), chip_mod = c } end
    elseif key == 'j_mp_mirror_match' and main then
        if is_pvp_blind() and not self.ability.mp_phantom and mp_jokers_on() then
            local x = mirror_x(self)
            if x > 1 then return { message = msg_x(x), Xmult_mod = x } end
        end
    elseif key == 'j_mp_tariff' then
        if main and (e.mult or 0) > 0 then
            return { message = msg_mult(e.mult), mult_mod = e.mult }
        end
        if context.setting_blind and not context.blueprint and is_pvp_setting(context) and mp_jokers_on() then
            local total = opp_sells_total()
            local gain = math.max(0, total - (tonumber(e.mark) or 0)) * (e.gain or 3)
            e.mark = total
            if gain > 0 then
                e.mult = (e.mult or 0) + gain
                return { message = L('Filed!'), colour = G.C.MULT }
            end
        end
        if context.selling_card and not context.blueprint and context.card ~= self then
            e.mult = (e.mult or 0) + (e.self_gain or 1)
            return { message = localize('k_upgrade_ex'), colour = G.C.MULT }
        end
    elseif key == 'j_mp_grudge' and main then
        local x = e.x_mult or 1
        if x > 1 then return { message = msg_x(x), Xmult_mod = x } end
    elseif key == 'j_mp_high_roller' and main and not self.ability.mp_phantom then
        local ret = nil
        if odds_hit('mp_high_roller', e.odds or 4) then
            local dollars = e.dollars or 4
            if not in_sandbox() then
                G.GAME.dollar_buffer = (G.GAME.dollar_buffer or 0) + dollars
                ease_dollars(dollars)
                G.E_MANAGER:add_event(Event({ func = function() G.GAME.dollar_buffer = 0 return true end }))
            end
            ret = { message = msg_x(e.x_mult or 4), Xmult_mod = e.x_mult or 4 }
        end
        if is_pvp_blind() and mp_jokers_on() and odds_hit('mp_high_roller_misfire', e.misfire_odds or 4) and not in_sandbox() then
            pcall(function()
                if bom_core and bom_core.send then
                    bom_core.send({ type = 'sabotage', sabotage_id = 'mpj_high_roller', key = 'mpj_high_roller', amount = e.misfire_dollars or 3 })
                end
                card_eval_status_text(self, 'extra', nil, nil, nil, { message = L('Oops!'), colour = G.C.MONEY })
            end)
        end
        return ret
    elseif key == 'j_mp_shortcut' then
        if context.setting_blind and not context.blueprint and mp_jokers_on() then
            local h, d = shortcut_status(self)
            if h > 0 or d > 0 then
r 1 112 %20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20 -
l 161
                    func = function()
                        if h > 0 then ease_hands_played(h) end
                        if d > 0 then ease_discard(d, nil, true) end
                        return true
                    end,
                }))
                return { message = localize('k_upgrade_ex'), colour = G.C.BLUE }
            end
        end
    elseif key == 'j_mp_photo_finish' then
        if context.setting_blind and is_pvp_setting(context) and mp_jokers_on() and pvp_first() then
            if create_spectral(self) then
                return { message = localize('k_plus_spectral'), colour = G.C.SECONDARY_SET.Spectral }
            end
        end
    elseif key == 'j_mp_leftovers' then
        if context.end_of_round and not context.individual and not context.repetition and not context.blueprint
            and not self.getting_sliced and pvp_ended() then
            local n = leftovers_amount(self)
            local ante = (G.GAME.round_resets and G.GAME.round_resets.ante) or 1
            G.GAME.round_resets.discards = (G.GAME.round_resets.discards or 0) + n
            G.GAME.mp_leftovers = G.GAME.mp_leftovers or {}
            table.insert(G.GAME.mp_leftovers, { until_ante = ante + 1, n = n })
            eat_card(self)
            return { message = localize('k_eaten_ex'), colour = G.C.RED }
        end
    end
    return nil
end

local function update_leftovers()
    local list = G.GAME and G.GAME.mp_leftovers
    if type(list) ~= 'table' or not G.GAME.round_resets then return end
    local ante = G.GAME.round_resets.ante or 1
    for i = #list, 1, -1 do
        local it = list[i]
        if type(it) ~= 'table' or ante > (tonumber(it.until_ante) or 0) then
            if type(it) == 'table' then
                G.GAME.round_resets.discards = math.max(0, (G.GAME.round_resets.discards or 0) - (tonumber(it.n) or 0))
            end
            table.remove(list, i)
        end
    end
    if #list == 0 then G.GAME.mp_leftovers = nil end
end

local function stats_tick()
    if not G.GAME or not G.GAME.multiplayer or not mp_jokers_on() or party_active() or in_sandbox() then return end
    if not bom_core or not bom_core.send then return end
    local stats = G.GAME.mp_custom_stats or {}
    local skips = G.GAME.skips or 0
    local sells = stats.sells_total or 0
    local dollars = math.floor(tonumber(G.GAME.dollars) or 0)
    local bucket = math.max(0, math.min(math.floor(dollars / 8), 10))
    local last = O.stats_last
    if last and last[1] == skips and last[2] == sells and last[3] == bucket then return end
    local now = (love and love.timer and love.timer.getTime and love.timer.getTime()) or os.clock()
    if O.stats_at and now - O.stats_at < 2 then return end
    O.stats_last, O.stats_at = {skips, sells, bucket}, now
    bom_core.send({ type = 'sabotage', sabotage_id = 'mpj_stats', key = 'mpj_stats', skips = skips, sells_total = sells, dollars = dollars })
end

local function update_grudge()
    if not G.GAME or not G.GAME.multiplayer then return end
    local lives = tonumber(G.GAME.mp_lives)
    if not lives then return end
    local last = tonumber(G.GAME.mp_grudge_lives)
    G.GAME.mp_grudge_lives = lives
    if not last or lives >= last or not G.jokers or not G.jokers.cards then return end
    local lost = last - lives
    for _, c in ipairs(G.jokers.cards) do
        if key_of(c) == 'j_mp_grudge' and not c.debuff then
            local e = c.ability.extra or {}
            c.ability.extra = e
            e.x_mult = (e.x_mult or 1) + lost * (e.gain or 0.5)
            pcall(function()
                card_eval_status_text(c, 'extra', nil, nil, nil, { message = L('Grudge!'), colour = G.C.RED })
            end)
        end
    end
end

local function fresh_ability(old_ability, center)
    local ab = type(old_ability) == 'table' and old_ability or {}
    ab.name = center.name
    ab.effect = center.effect
    ab.set = center.set
    ab.extra = clone_table(center.config.extra)
    ab.mult = center.config.mult or 0
    ab.x_mult = center.config.Xmult or 1
    ab.t_mult = center.config.t_mult or 0
    ab.t_chips = center.config.t_chips or 0
    ab.h_size = center.config.h_size or 0
    ab.d_size = center.config.d_size or 0
    ab.mp_life_chips = nil
    ab.mp_cur_chips = nil
    ab.mp_cur_x = nil
    return ab
end

