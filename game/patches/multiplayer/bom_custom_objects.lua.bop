    initialized = false,
    centers_registered = false,
    patches_applied = false,
    pools_on = nil,
}

O.REMOVED = {
    j_mp_pacifist = 'j_mp_truce',
    j_mp_defensive_joker = 'j_mp_bulwark',
    j_mp_skip_off = 'j_mp_shortcut',
    j_mp_taxes = 'j_mp_tariff',
    j_mp_conjoined_joker = 'j_mp_mirror_match',
    j_mp_heckler = 'j_mp_envy',
    j_mp_pickpocket = 'j_mp_shortcut',
    j_mp_lightning_rod = 'j_mp_bulwark',
    j_mp_bloodhound = 'j_mp_grudge',
    j_mp_getaway = 'j_mp_shortcut',
}

O.JOKER_KEYS = {
    'j_mp_truce', 'j_mp_bulwark', 'j_mp_shortcut', 'j_mp_tariff', 'j_mp_mirror_match',
    'j_mp_envy', 'j_mp_leftovers', 'j_mp_photo_finish', 'j_mp_high_roller', 'j_mp_grudge',
}

local PVP_BLINDS = { bl_mp_nemesis = true, bl_mp_royale = true, bl_mp_clash = true, bl_mp_raid = true }

local MSG_FR = {
    ["Oops!"] = "Oups !", ["Filed!"] = "Taxé !", ["Grudge!"] = "Rancune !",
    ["High Roller misfire: +$"] = "Raté du Flambeur : +$",
}
local MSG_ES = {
    ["Oops!"] = "¡Ups!", ["Filed!"] = "¡Gravado!", ["Grudge!"] = "¡Rencor!",
    ["High Roller misfire: +$"] = "Fallo del Apostador: +$",
}

local function clone_table(value)
    if type(value) ~= 'table' then return value end
    local out = {}
    for k, v in pairs(value) do out[k] = clone_table(v) end
    return out
end
O.clone_table = clone_table

local function L(s)
    if mod_loc then
        local ok, r = pcall(mod_loc, s)
        if ok and r then return r end
    end
    return s
end

function O.lang()
    local l = G and G.SETTINGS and G.SETTINGS.language or 'en-us'
    if l == 'fr' then return 'fr' end
    if type(l) == 'string' and l:sub(1, 2) == 'es' then return 'es' end
    return 'en'
end

function O.pick(tr)
    if type(tr) ~= 'table' then return nil end
    return tr[O.lang()] or tr.en
end

function O.parsed(entry)
    local e = { name = entry.name, text = clone_table(entry.text or {}) }
    if loc_parse_string then
        e.text_parsed = {}
        for _, line in ipairs(e.text) do e.text_parsed[#e.text_parsed + 1] = loc_parse_string(line) end
        e.name_parsed = {}
        for _, line in ipairs(type(e.name) == 'table' and e.name or { e.name }) do
            e.name_parsed[#e.name_parsed + 1] = loc_parse_string(line)
        end
    end
    return e
end

local LOC = {}
local LOC_ORDER = {}
local LANG_HOOKS = {}

function O.register_loc(set, key, tr)
    local id = set .. '|' .. key
    if not LOC[id] then LOC_ORDER[#LOC_ORDER + 1] = id end
    LOC[id] = { set = set, key = key, tr = tr }
end

function O.inject_loc()
    if not G or not G.localization or not G.localization.descriptions then return end
    local d = G.localization.descriptions
    for _, id in ipairs(LOC_ORDER) do
        local e = LOC[id]
        local entry = O.pick(e.tr)
        if entry then
            d[e.set] = d[e.set] or {}
            d[e.set][e.key] = O.parsed(entry)
        end
    end
end

function O.on_language(fn)
    LANG_HOOKS[#LANG_HOOKS + 1] = fn
end

local function run_lang_hooks()
    O.inject_loc()
    for _, fn in ipairs(LANG_HOOKS) do pcall(fn) end
end

local function party_active()
    if not (bom_party and bom_party.active) then return false end
    local ok, r = pcall(bom_party.active)
    return ok and r or false
end

local function mp_jokers_on()
    if not G or not G.GAME or not G.GAME.multiplayer then return false end
    if not (bom_match and bom_match.get_state) then return false end
    local ok, state = pcall(bom_match.get_state)
    if not ok or not state then return false end
    if not state.settings then return true end
    return state.settings.multiplayer_jokers ~= false
end
O.enabled = mp_jokers_on

local function in_sandbox()
    local P = rawget(_G, 'PREVIEW')
    return type(P) == 'table' and P._in_sandbox == true
end

local function is_pvp_blind()
    local r = false
    pcall(function() r = bom_nemesis and bom_nemesis.is_pvp_boss and bom_nemesis.is_pvp_boss() or false end)
    return r and true or false
end

local function pvp_ended()
    if is_pvp_blind() then return true end
    local b = G and G.GAME and G.GAME.blind
    if not b then return false end
    if b.mp_pvp_over then return true end
    local key = b.config and b.config.blind and b.config.blind.key
    return key and PVP_BLINDS[key] and true or false
end

local function is_pvp_setting(context)
    if context and context.blind and context.blind.key and PVP_BLINDS[context.blind.key] then return true end
    return is_pvp_blind()
end

local function panel()
    return G and G.GAME and G.GAME.mp_opponent_panel or nil
end

local function my_lives()
    return tonumber(G and G.GAME and G.GAME.mp_lives) or 0
end

local function opp_lives()
    local p = panel()
    return tonumber(G and G.GAME and G.GAME.mp_opponent_lives) or tonumber(p and p.lives) or 0
end

local function opp_hands_left()
    local p = panel()
    return tonumber(p and p.hands_left) or 0
end

local function opp_stats()
    return G and G.GAME and type(G.GAME.mp_opp_stats) == 'table' and G.GAME.mp_opp_stats or nil
end

local function opp_skips()
    local st = opp_stats()
    if st and st.skips ~= nil then return tonumber(st.skips) end
    local p = panel()
    if not p or p.skips == nil then return nil end
    return tonumber(p.skips)
end

local function opp_sells_total()
    local st = opp_stats()
    if st and st.sells_total ~= nil then return tonumber(st.sells_total) or 0 end
    local p = panel()
    return tonumber(p and p.sells_total) or 0
end

local function opp_already_at_pvp()
    local loc = nil
    pcall(function()
        local st = bom_match and bom_match.get_state and bom_match.get_state()
        loc = st and st.opp_location
    end)
    if type(loc) ~= 'string' then return false end
    if loc:find('^loc_ready') or loc:find('^loc_wait') then return true end
    if loc:find('^loc_playing%-bl_mp_') then return true end
    return false
end

local function pvp_first()
    local f = G and G.GAME and G.GAME.mp_pvp_first
    if f ~= nil then return f end
    return not opp_already_at_pvp()
end

local function odds_hit(seed, odds)
    local normal = (G.GAME.probabilities and G.GAME.probabilities.normal) or 1
    return pseudorandom(seed) < normal / odds
end

local function msg_x(x) return localize { type = 'variable', key = 'a_xmult', vars = { x } } end
local function msg_mult(m) return localize { type = 'variable', key = 'a_mult', vars = { m } } end
local function msg_chips(c) return localize { type = 'variable', key = 'a_chips', vars = { c } } end

local function bulwark_per_life(card)
    local cfg = card.ability.extra or {}
    if (G.GAME.stake or 1) >= 6 then return cfg.high or 60 end
    return cfg.chips or 100
end

local function bulwark_chips(card)
    if not mp_jokers_on() then return 0 end
    local gap = math.max(opp_lives() - my_lives(), 0)
    local v = gap * bulwark_per_life(card)
    if is_pvp_blind() then v = v * 2 end
    return v
end

local function mirror_x(card)
    local cfg = card.ability.extra or {}
    local cap = (my_lives() < opp_lives()) and (cfg.cap_behind or 4) or (cfg.cap or 3)
    return math.max(1, math.min(1 + opp_hands_left() * (cfg.per or 0.5), cap))
end

local function shortcut_status(card)
    local mine, theirs = G.GAME.skips or 0, opp_skips()
    if theirs == nil then return 0, 0 end
    local cfg = card.ability.extra or {}
    local diff = mine - theirs
    return math.max(diff, 0) * (cfg.hands or 1), math.max(-diff, 0) * (cfg.discards or 1)
end

local function envy_dollars(card)
    local cfg = card.ability.extra or {}
    local st = opp_stats()
    local d = tonumber(st and st.dollars) or 0
    return math.max(0, math.min(math.floor(d / (cfg.per or 8)), cfg.max or 5))
end

local function leftovers_amount(card)
    local cfg = card.ability.extra or {}
    local n = cfg.discards or 2
    if my_lives() < opp_lives() then n = n + (cfg.behind or 1) end
    return n
end

local function nemesis_word()
    return ({ en = 'The Rival', fr = 'Le Rival', es = 'El Rival' })[O.lang()] or 'The Rival'
end

