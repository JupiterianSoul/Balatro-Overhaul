    pcall(function()
        if Game and Game.init_item_prototypes then
            local original_init_item_prototypes = Game.init_item_prototypes
            Game.init_item_prototypes = function(self, ...)
                local r = original_init_item_prototypes(self, ...)
                pcall(sync_pools, mp_jokers_on() and true or false, true)
                return r
            end
        end
    end)

    pcall(function()
        if type(get_current_pool) == 'function' then
            local original_get_current_pool = get_current_pool
            get_current_pool = function(_type, _rarity, _legendary, _append)
                set_pool_flag()
                return original_get_current_pool(_type, _rarity, _legendary, _append)
            end
        end
    end)

