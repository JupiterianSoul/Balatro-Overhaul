        if bom_events and bom_events.register then
            bom_events.register('sabotage', function(d)
                local id = d and d.sabotage_id
                if type(id) ~= 'string' or id:sub(1, 4) ~= 'mpj_' then return nil end
                if id == 'mpj_stats' and G and G.GAME and G.GAME.multiplayer then
                    G.GAME.mp_opp_stats = {
                        skips = tonumber(d.skips) or 0, sells_total = tonumber(d.sells_total) or 0,
                        dollars = tonumber(d.dollars) or 0,
                    }
                    local p = G.GAME.mp_opponent_panel
                    if p then p.skips = G.GAME.mp_opp_stats.skips; p.sells_total = G.GAME.mp_opp_stats.sells_total end
                    return true
                end
                if id == 'mpj_high_roller' and G and G.GAME and G.GAME.multiplayer then
                    local n = math.max(0, math.min(tonumber(d.amount) or 5, 10))
                    if n > 0 then
                        ease_dollars(n)
                        pcall(function()
                            attention_text({
                                text = L('High Roller misfire: +$') .. tostring(n), scale = 0.6, hold = 1.6,
