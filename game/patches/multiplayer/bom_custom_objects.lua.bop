function O.nemesis_word() return nemesis_word() end
O.is_pvp = is_pvp_blind
O.leftovers_amount = leftovers_amount

local function apply_art()
    if bom_joker_art and bom_joker_art.apply then pcall(bom_joker_art.apply) end
end

function O.ensure_registered()
    register_centers()
    apply_art()
    if bom_decks and bom_decks.ensure_registered then pcall(bom_decks.ensure_registered) end
end

function O.update(dt)
    set_pool_flag()
    pcall(get_or_create_round_stats)
    pcall(update_grudge)
    pcall(update_leftovers)
    pcall(stats_tick)
end

function O.init()
    if O.initialized then
        set_pool_flag()
        pcall(get_or_create_round_stats)
        return
    end
    register_centers()
    apply_art()
    register_loc()
    O.inject_loc()
    patch_card_behavior()
    set_pool_flag()
    pcall(get_or_create_round_stats)
    O.initialized = true
    if mp_log then mp_log.info('BOM_OBJECTS', 'MP2 custom objects initialized') end
end

return O
end
