        local original_set_cost = Card.set_cost
        Card.set_cost = function(self)
            original_set_cost(self)
            if self and self.ability and self.ability.mp_sticker_persistent then
                self.ability.mp_sell_price = (self.sell_cost or 0) + (self.ability.mp_extra_sell_price or 0)
                self.sell_cost_label = self.facing == 'back' and '?' or self.ability.mp_sell_price
            end
        end
    end)

    pcall(function()
        local original_sell_card = Card.sell_card
        Card.sell_card = function(self)
            local is_persistent = self and self.ability and self.ability.mp_sticker_persistent
            local persistent_price = is_persistent and (self.ability.mp_sell_price or self.sell_cost or 0) or 0
            if is_persistent and G and G.GAME and (G.GAME.dollars or 0) < persistent_price then return nil end
            local sell_cost = self and self.sell_cost or 0
            local ret = original_sell_card(self)
            pcall(function()
                local stats = get_or_create_round_stats()
                if stats then
                    stats.sells_this_ante = (stats.sells_this_ante or 0) + 1
                    stats.sells_total = (stats.sells_total or 0) + 1
                end
            end)
            if is_persistent and persistent_price > 0 then
                pcall(function() ease_dollars(-(sell_cost + persistent_price)) end)
            end
            return ret
        end
    end)

    pcall(function()
        if bom_ui and bom_ui.update_opponent_panel then
            local original_update_panel = bom_ui.update_opponent_panel
            bom_ui.update_opponent_panel = function(data)
                local ret = original_update_panel(data)
                if data and G and G.GAME and G.GAME.mp_opponent_panel then
                    local p = G.GAME.mp_opponent_panel
                    if data.skips ~= nil then p.skips = data.skips end
                    if data.sells_this_ante ~= nil then p.sells_this_ante = data.sells_this_ante end
                    if data.sells_total ~= nil then p.sells_total = data.sells_total end
                    if data.ante ~= nil then p.ante = data.ante end
                end
                return ret
            end
        end
    end)

