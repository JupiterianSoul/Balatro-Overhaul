    return O.REMOVED[key] or key
end

function O.list()
    local out = {}
    if not G or not G.P_CENTERS then return out end
    for _, k in ipairs(O.JOKER_KEYS) do
        if G.P_CENTERS[k] then out[#out + 1] = G.P_CENTERS[k] end
    end
    return out
end

local function sort_pool(pool)
    table.sort(pool, function(a, b)
        local oa, ob = a.order or 9999, b.order or 9999
        if oa ~= ob then return oa < ob end
        return tostring(a.key) < tostring(b.key)
    end)
end
O.sort_pool = sort_pool

local function pool_index(pool, center)
    for i, v in ipairs(pool) do if v == center then return i end end
    return nil
end
O.pool_index = pool_index

local function sync_pools(on, force)
    if O.pools_on == on and not force then return end
    if not G or not G.P_CENTERS or not G.P_JOKER_RARITY_POOLS or not G.P_CENTER_POOLS then return end
    local pools = { G.P_CENTER_POOLS.Joker }
    for _, pool in pairs(G.P_JOKER_RARITY_POOLS) do pools[#pools + 1] = pool end
    for _, pool in ipairs(pools) do
        for i = #pool, 1, -1 do
            if type(pool[i]) == 'table' and pool[i].mp_joker then table.remove(pool, i) end
        end
    end
    if on then
        local touched = {}
        for _, k in ipairs(O.JOKER_KEYS) do
            local c = G.P_CENTERS[k]
            if c then
                for _, pool in ipairs({ G.P_JOKER_RARITY_POOLS[c.rarity], G.P_CENTER_POOLS.Joker }) do
                    if pool then
                        pool[#pool + 1] = c
                        touched[pool] = true
                    end
                end
            end
        end
        for pool in pairs(touched) do sort_pool(pool) end
    end
    O.pools_on = on
end
O.sync_pools = sync_pools

local function set_pool_flag()
    if not G or not G.GAME then return end
    G.GAME.pool_flags = G.GAME.pool_flags or {}
    local on = mp_jokers_on()
    G.GAME.pool_flags.mp_custom_objects = on or nil
    G.GAME.pool_flags.mp_duel_jokers = (on and not party_active()) or nil
    G.GAME.pool_flags.mp_heckle_jokers = nil
    sync_pools(on and true or false)
end
O.set_pool_flag = set_pool_flag

local function get_or_create_round_stats()
    if not G or not G.GAME then return nil end
    G.GAME.mp_custom_stats = G.GAME.mp_custom_stats or { last_ante = nil, sells_this_ante = 0, sells_total = 0 }
    local stats = G.GAME.mp_custom_stats
    local ante = (G.GAME.round_resets and G.GAME.round_resets.ante) or 1
    if stats.last_ante ~= ante then
        stats.last_ante = ante
        stats.sells_this_ante = 0
    end
    return stats
end

local function build_custom_badges(card)
    if not card or not card.ability then return nil end
    local badges = {}
    if card.edition and card.edition.type == 'mp_phantom' then badges[#badges + 1] = 'mp_phantom' end
    if card.ability.mp_sticker_persistent then badges[#badges + 1] = 'mp_sticker_persistent' end
    if card.ability.mp_sticker_unreliable then badges[#badges + 1] = 'mp_sticker_unreliable' end
    if card.ability.mp_sticker_draining then badges[#badges + 1] = 'mp_sticker_draining' end
    if card.ability.mp_sticker_balanced then badges[#badges + 1] = 'mp_sticker_balanced' end
    return (#badges > 0) and badges or nil
end

local function register_centers()
    if not G or not G.P_CENTERS then return end
    if O.centers_registered and G.P_CENTERS.j_mp_truce then return end
    if not G.P_CENTERS.j_mp_truce then O.pools_on = nil end
    for _, key in ipairs(O.JOKER_KEYS) do
        local d = DEFS[key]
        if not G.P_CENTERS[key] then
            G.P_CENTERS[key] = {
                key = key, order = d.order, unlocked = true, discovered = true, omit = true,
                blueprint_compat = d.blueprint_compat, perishable_compat = d.perishable_compat,
                eternal_compat = d.eternal_compat, rarity = d.rarity, cost = d.cost, name = d.name,
                pos = clone_table(d.pos), atlas = d.atlas, set = 'Joker', effect = '', cost_mult = 1.0,
                config = clone_table(d.config), mp_joker = true, mp_duel = d.duel or nil,
                yes_pool_flag = d.duel and 'mp_duel_jokers' or 'mp_custom_objects',
            }
        end
    end
    for old, new in pairs(O.REMOVED) do
        if G.P_CENTERS[new] and (not G.P_CENTERS[old] or G.P_CENTERS[old].key == old) then
            G.P_CENTERS[old] = G.P_CENTERS[new]
        end
    end
    if not G.P_CENTERS.e_mp_phantom then
        G.P_CENTERS.e_mp_phantom = {
            key = 'e_mp_phantom', order = 1001, discovered = true, unlocked = true, omit = true,
            name = 'Phantom', set = 'Edition', pos = { x = 4, y = 0 }, config = { extra = 0 },
            badge_colour = (G.C and (G.C.PURPLE or G.C.MULT or G.C.BLUE)) or { 0.6, 0.2, 0.9, 1 },
        }
    end
    O.centers_registered = true
    if mp_log then mp_log.info('BOM_OBJECTS', 'registered MP2 jokers') end
end

local function register_loc()
    for _, key in ipairs(O.JOKER_KEYS) do O.register_loc('Joker', key, DEFS[key].loc) end
    O.register_loc('Edition', 'e_mp_phantom', PHANTOM_LOC)
    if mod_loc_register then pcall(mod_loc_register, { fr = MSG_FR, es = MSG_ES }) end
end

function O.apply_phantom(card)
    if not card or not card.ability then return end
    card.edition = card.edition or {}
    card.edition.type = 'mp_phantom'
    card.edition.phantom = true
    card.ability.eternal = true
    card.ability.mp_phantom = true
    card.ability.mp_sticker_nemesis = true
    pcall(function() if card.set_cost then card:set_cost() end end)
end

function O.remove_phantom(card)
    if not card or not card.ability then return end
    if card.edition and card.edition.type == 'mp_phantom' then card.edition = nil end
    card.ability.mp_phantom = nil
    card.ability.mp_sticker_nemesis = nil
    if not card.ability.perishable and not card.ability.mp_sticker_persistent then card.ability.eternal = false end
    pcall(function() if card.set_cost then card:set_cost() end end)
end

function O.apply_sticker(card, sticker_key, enabled)
    if not card or not card.ability then return end
    if sticker_key == 'persistent' then
        card.ability.mp_sticker_persistent = enabled and true or nil
        if enabled then
            card.ability.mp_extra_sell_price = card.ability.mp_extra_sell_price or 0
            card.ability.eternal = true
        else
            card.ability.mp_extra_sell_price = nil
            card.ability.mp_sell_price = nil
            if not card.ability.mp_phantom then card.ability.eternal = nil end
        end
    elseif sticker_key == 'unreliable' then
        card.ability.mp_sticker_unreliable = enabled and true or nil
    elseif sticker_key == 'draining' then
        card.ability.mp_sticker_draining = enabled and true or nil
    elseif sticker_key == 'balanced' then
        card.ability.mp_sticker_balanced = enabled and true or nil
    elseif sticker_key == 'nemesis' then
        card.ability.mp_sticker_nemesis = enabled and true or nil
    end
    pcall(function() if card.set_cost then card:set_cost() end end)
end

local function key_of(card)
    return card and card.config and card.config.center and card.config.center.key
end

