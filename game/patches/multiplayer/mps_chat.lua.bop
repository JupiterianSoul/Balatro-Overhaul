local function optin_body()
    local w = UIK.dlg_w((touch() and 8.6 or 7.6) + 0.2) - 0.2
    local c = S.chat
    local rows = {}
    local function line(str, colour, scale)
        local sc = scale or bom_kit.dims().small
        for _, part in ipairs(UIK.wrap(str, sc, w - 0.2)) do
            rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", minw = w, minh = 0.4, padding = 0.02}, nodes = {
                bom_kit.text(bom_kit.fit(part, w - 0.2, sc), {scale = sc, colour = colour}),
            }}
        end
    end
    if c.allowed == false then
        line(L("Chat is not available for your account."), G.C.UI.TEXT_LIGHT, bom_kit.dims().scale)
        line(L("You can still play, add friends and send emotes."), bom_kit.colour("muted"))
    else
        line(L("Chat lets you talk with friends and players in your lobby."), G.C.UI.TEXT_LIGHT)
        line(L("Messages are filtered. You can mute and report players."), bom_kit.colour("muted"))
        if c.allowed == nil then
            line(L("Enter your birth year once to turn it on."), bom_kit.colour("muted"))
            line(L("We only keep whether chat is allowed, never the year."), bom_kit.colour("muted"))
            rows[#rows + 1] = UIK.stepper{label = L("Birth year"), ref_table = c, ref_value = "year", min = 1900, max = tonumber(os.date("%Y")) or 2026,
                step = 1, big_step = 10, w = w, wrap = false}
        end
    end
    if S.note then line(S.note, S.note_bad and G.C.RED or G.C.GREEN) end
    return UIK.stack(rows, {w = w})
end

function C.open_optin(back, keep_note)
    S.chat_return = back or S.chat_return
    if not keep_note then S.note = nil end
