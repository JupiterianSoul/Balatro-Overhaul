    }}
end

local SIDE_W = 4.6
local GAP_W = 0.3
local function port() return UIK.portrait and UIK.portrait() end
local function lines_w() return port() and UIK.W - 0.1 or UIK.W - SIDE_W - GAP_W - 0.1 end
local function side_w() return port() and UIK.W - 0.1 or SIDE_W end

local function note_h() return 0.45 end
local function input_h() return touch() and 0.86 or 0.74 end
local function all_h() return UIK.H - UIK.TOP - note_h() - 0.1 end
local function side_h() return port() and math.floor(all_h() * 0.36 * 10) / 10 or all_h() end
local function col_h() return port() and all_h() - side_h() - GAP_W or all_h() end
local function lines_h() return col_h() - input_h() - 0.1 end

local function is_me(line)
    return tostring(line.name or "") == tostring(T.my_name() or "")
end

local function bubble_colour(mine)
    if mine then return {0.13, 0.4, 0.62, 1} end
    return {0.25, 0.29, 0.33, 1}
end

function C.log(items, w, h, o)
    o = o or {}
    local d = bom_kit.dims()
    local scale = d.scale
    local lh = scale * 1.3
    local bpad = 0.08
    local gap = 0.07
    local head_h = lh + 0.03
    local inner = w - 0.24
    local maxb = math.max(1.5, inner * 0.72)
    local avail = h - 0.3 - (o.typing and lh or 0)
    local SE = rawget(_G, "social_chat_emotes")
    local DC = rawget(_G, "social_dm_cards")
    local blocks, used = {}, 0
    for i = #items, 1, -1 do
        local it = items[i]
        local prev = items[i - 1]
        local head = not it.mine and (not prev or prev.mine or prev.who ~= it.who)
        local emote = SE and SE.parse(it.text)
        local card = not emote and DC and DC.parse(it.text) or nil
        local lines = (emote or card) and {} or T.wrap(it.text, maxb - 2 * bpad, scale)
        local need = (emote and SE.size() or card and DC.height(scale) or #lines * lh) + 2 * bpad + gap + (head and head_h or 0)
        if used + need > avail then break end
        used = used + need
        table.insert(blocks, 1, {it = it, head = head, lines = lines, emote = emote, card = card})
    end
    if blocks[1] and not blocks[1].it.mine and not blocks[1].head then
        if used + head_h > avail then table.remove(blocks, 1) else blocks[1].head = true end
    end
    local rows = {}
    if #blocks == 0 then
        rows[1] = {n = G.UIT.R, config = {align = "cm", minw = inner, minh = 0.5, padding = 0}, nodes = {
            bom_kit.text(o.empty or L("No messages yet. Say hi!"), {scale = scale, colour = bom_kit.colour("muted")}),
        }}
    end
    for _, b in ipairs(blocks) do
        local it = b.it
        local side = it.mine and "cr" or "cl"
        if b.head then
            local who = bom_kit.fit(it.who or "?", maxb, scale * 0.92)
            rows[#rows + 1] = {n = G.UIT.R, config = {align = "cl", minw = inner, minh = head_h, padding = 0}, nodes = {
                {n = G.UIT.C, config = {minw = 0.08, minh = 0.01, padding = 0}, nodes = {}},
                bom_kit.text(who, {scale = scale * 0.92, colour = G.C.GOLD}),
            }}
        end
        local lnodes = {b.emote and SE.chip(b.emote, scale) or b.card and DC.node(b.card, scale, math.min(maxb - 2 * bpad, 4.4)) or nil}
        for _, str in ipairs(b.lines) do
            lnodes[#lnodes + 1] = {n = G.UIT.R, config = {align = "cl", minh = lh, padding = 0}, nodes = {bom_kit.text(str, {scale = scale})}}
        end
        rows[#rows + 1] = {n = G.UIT.R, config = {align = side, minw = inner, padding = 0}, nodes = {
            {n = G.UIT.C, config = {align = "cl", padding = bpad, r = 0.12, colour = bubble_colour(it.mine), emboss = 0.03}, nodes = lnodes},
        }}
        rows[#rows + 1] = {n = G.UIT.R, config = {minw = inner, minh = gap, padding = 0}, nodes = {}}
    end
    if o.typing then
        rows[#rows + 1] = {n = G.UIT.R, config = {align = "cl", minw = inner, minh = lh, padding = 0}, nodes = {
            {n = G.UIT.C, config = {minw = 0.08, minh = 0.01, padding = 0}, nodes = {}},
            bom_kit.text(bom_kit.fit(o.typing, inner - 0.2, scale * 0.9), {scale = scale * 0.9, colour = bom_kit.colour("muted")}),
        }}
    end
    return {n = G.UIT.R, config = {align = #blocks == 0 and "cm" or "bm", minw = w, maxw = w, minh = h, r = 0.12, colour = {0, 0, 0, 0.2}, padding = 0.12}, nodes = {
        {n = G.UIT.C, config = {align = #blocks == 0 and "cm" or "bm", minw = inner, padding = 0}, nodes = rows},
    }}
end

local function lobby_items()
    local out = {}
    for _, ln in ipairs(S.lobby.lines) do
        if not S.lobby.mutes[ln.pid] then
            out[#out + 1] = {who = ln.name ~= "" and ln.name or "?", text = ln.text, mine = is_me(ln)}
        end
    end
    return out
end

local function lines_def()
    return C.log(lobby_items(), lines_w(), lines_h())
end

local function senders()
    local seen, out = {}, {}
    for i = #S.lobby.lines, 1, -1 do
        local ln = S.lobby.lines[i]
        if ln.pid ~= nil and not seen[ln.pid] and not is_me(ln) then
            seen[ln.pid] = true
            out[#out + 1] = {pid = ln.pid, name = ln.name, last = ln.id}
        end
    end
    table.sort(out, function(a, b) return (tonumber(a.pid) or 0) < (tonumber(b.pid) or 0) end)
    return out
end

local function side_def()
    local d = bom_kit.dims()
    local inner = side_w() - 0.24
    local hb = bh()
    local off_h = touch() and 0.8 or 0.66
    local head_h = touch() and 0.66 or 0.58
    local list_h = side_h() - head_h - off_h - 0.5
    local nodes = {UIK.header(L("Players"), {w = inner})}
    local rows = {}
    local list = senders()
    if #list == 0 then
        local lines = T.wrap(L("Players who talk show up here."), inner - 0.3, d.small)
        rows[1] = UIK.note(lines, {w = inner, scale = d.small})
    end
    local block_h = rh() + hb + 0.22
    local max = math.max(1, math.floor(list_h / block_h))
    local half = (math.min(inner, SIDE_W - 0.24) - 0.3) / 2
    for i = 1, math.min(#list, max) do
        local p = list[i]
        local muted = S.lobby.mutes[p.pid] == true
        rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", minw = inner, padding = 0.05, r = 0.1, colour = {0, 0, 0, 0.15}}, nodes = {
            {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = {
                {n = G.UIT.R, config = {align = "cm", padding = 0.03}, nodes = {
                    bom_kit.name_bar(p.name ~= "" and p.name or "?", {w = math.min(inner, SIDE_W - 0.24) - 0.2, h = rh(), colour = bom_kit.colour("name_light"), text_colour = bom_kit.colour("dark_text"), shadow = false}),
                }},
                {n = G.UIT.R, config = {align = "cm", padding = 0.03}, nodes = {
                    T.btn{label = muted and L("Unmute") or L("Mute"), button = "mps_chat_mute", ref_table = {pid = p.pid}, colour = muted and G.C.GREEN or G.C.ORANGE, w = half, h = hb},
                    {n = G.UIT.C, config = {minw = 0.1}, nodes = {}},
                    T.btn{label = L("Report"), button = "mps_chat_report", ref_table = {pid = p.pid, id = p.last, name = p.name}, colour = G.C.RED, w = half, h = hb},
                }},
            }},
        }}
        rows[#rows + 1] = {n = G.UIT.R, config = {minh = 0.08, padding = 0}, nodes = {}}
    end
    nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "tm", minw = inner, minh = list_h, padding = 0}, nodes = {
        {n = G.UIT.C, config = {align = "tm", minw = inner, padding = 0}, nodes = rows},
    }}
    nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", minw = inner, padding = 0.04}, nodes = {
        UIK.button{label = L("Turn chat off"), button = "mps_chat_off", colour = UIK.C.warn, id = "mps_chat_off", w = inner - 0.1, h = off_h, scale = touch() and 0.42 or 0.38, col = true},
    }}
    return {n = G.UIT.R, config = {align = "tm", minw = side_w(), minh = side_h(), r = 0.12, colour = UIK.C.section, padding = 0.12}, nodes = {
        {n = G.UIT.C, config = {align = "tm", minw = inner, padding = 0}, nodes = nodes},
    }}
end

local function panel_body()
    local W = port() and UIK.W - 0.1 or lines_w() + GAP_W + SIDE_W
    local text, bad = S.note, S.note_bad
    return {n = G.UIT.R, config = {align = "tm", minw = UIK.W, padding = 0}, nodes = {{n = G.UIT.C, config = {align = "tm", minw = W, padding = 0}, nodes = {
        {n = G.UIT.R, config = {align = "tm", padding = 0}, nodes = {
            {n = port() and G.UIT.R or G.UIT.C, config = {align = "tm", minw = lines_w(), padding = 0}, nodes = {
                {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = {T.slot("mps_lobby_lines", lines_def)}},
                {n = G.UIT.R, config = {minh = 0.1, padding = 0}, nodes = {}},
                require("multiplayer.mps_friends").input_row(S.lobby.input, "text", lines_w(), "mps_chat_send", 60, L("Write a message"), function() C.send() end, "social_chat_emote_lobby"),
            }},
            {n = port() and G.UIT.R or G.UIT.C, config = {minw = GAP_W, minh = GAP_W, padding = 0}, nodes = {}},
            {n = port() and G.UIT.R or G.UIT.C, config = {align = "tm", minw = side_w(), padding = 0}, nodes = {T.slot("mps_lobby_side", side_def)}},
        }},
        {n = G.UIT.R, config = {align = "cm", minw = W, minh = note_h(), padding = 0}, nodes = {
            text and bom_kit.text(bom_kit.fit(text, W - 0.2, bom_kit.dims().small), {scale = bom_kit.dims().small, colour = bad and G.C.RED or G.C.GREEN}) or nil,
        }},
    }}}}
end

function C.open_panel(from)
    from = from or S.chat_from or "lobby"
    if not S.chat.enabled then return C.open_optin(from) end
    S.chat_from = from
    S.chat_return = from
    S.note = nil
    S.lobby_open = true
    S.lobby.unread = 0
    T.lobby_label()
