        ["Something else"] = "Autre chose", ["Chat is not available for your account."] = "Le chat n'est pas disponible pour votre compte.",
        ["You can still play, add friends and send emotes."] = "Vous pouvez toujours jouer, ajouter des amis et envoyer des émotes.",
        ["Chat lets you talk with friends and players in your lobby."] = "Le chat permet de parler avec vos amis et les joueurs de votre salon.",
        ["Messages are filtered. You can mute and report players."] = "Les messages sont filtrés. Vous pouvez mettre des joueurs en sourdine et les signaler.",
