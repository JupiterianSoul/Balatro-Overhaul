local T = require("multiplayer.mps_state")
local C = {}

local L = T.L
local S = T.S

local function touch() return UIK.touch() end
local function bh() return touch() and 0.62 or 0.5 end
local function rh() return touch() and 0.72 or 0.6 end

C.REPORT_REASONS = {
    {key = "insults", label = "Insults or hate"},
    {key = "spam", label = "Spam"},
    {key = "cheating", label = "Cheating"},
    {key = "name", label = "Bad name"},
    {key = "other", label = "Something else"},
}

local function win_id()
    return G.OVERLAY_MENU and UIK and UIK._win and G.OVERLAY_MENU:get_UIE_by_ID("uik_body") and UIK._win.id or nil
end

function C.is_open() return win_id() == "mps_chat" end
local function optin_open() return win_id() == "mps_optin" end

local function patch_label(node, ref_table, ref_value)
    if type(node) ~= "table" then return false end
    if node.n == G.UIT.T and node.config and node.config.text then
        node.config.text = nil
        node.config.ref_table = ref_table
        node.config.ref_value = ref_value
        return true
    end
    for _, child in ipairs(node.nodes or {}) do
        if patch_label(child, ref_table, ref_value) then return true end
    end
    return false
end

function C.live_button(node)
    T.lobby_label()
    patch_label(node, S.lobby, "label")
    return node
end

function C.back_to(target)
    target = target or S.chat_return
    if target == "friends" then
        local F = require("multiplayer.mps_friends")
        return F.open("messages")
    end
    if target == "lobby" or target == "party" or target == "run" then
        if S.chat.enabled then return C.open_panel(target) end
    end
    local B = T.social()
    if B and B.back_to_origin then return B.back_to_origin() end
