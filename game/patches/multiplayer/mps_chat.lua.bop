l 120
    G.FUNCS.overlay_menu{definition = UIK.window{
        id = "mps_chat",
        title = L("LOBBY CHAT"),
        tabs = {{key = "main", label = L("Chat"), build = panel_body}},
        back_func = "mps_chat_back",
    }}
end

function C.send()
    local text = tostring(S.lobby.input.text or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if text == "" then return end
    S.note = nil
    if T.send({type = "chat_lobby_send", text = text}) then S.lobby.input.text = "" end
    T.later("chat_panel")
end

local function report_body()
    local w = touch() and 7.4 or 6.4
    local rows = {}
    local who = S.report and S.report.name or "?"
    rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", minw = w, minh = 0.45}, nodes = {
        bom_kit.text(bom_kit.fit(T.fill("Why are you reporting {name}?", {name = who}), w - 0.2, bom_kit.dims().small), {scale = bom_kit.dims().small}),
    }}
    for _, r in ipairs(C.REPORT_REASONS) do
        rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.05}, nodes = {
            T.btn{label = L(r.label), button = "mps_chat_report_go", ref_table = {key = r.key}, colour = G.C.RED, w = w - 0.6, h = touch() and 0.78 or 0.64},
        }}
    end
    return UIK.stack(rows, {w = w})
end

local function open_report(p)
    S.report = p
    G.FUNCS.overlay_menu{definition = UIK.window{
        id = "mps_report", compact = true, w = touch() and 7.6 or 6.6,
        title = L("REPORT PLAYER"),
        tabs = {{key = "main", label = L("Report"), build = report_body}},
        back_func = "mps_chat_report_back",
    }}
end

local function on_change(what)
    local id = win_id()
    if id == "mps_optin" then
        if what == "chat" and S.chat.enabled then
            S.note = nil
            return C.back_to(S.chat_return)
        end
        if what == "chat" or what == "chat_result" then
            if T.typing() then return end
            C.open_optin(nil, true)
        end
        return
    end
    if id ~= "mps_chat" then return end
    if what == "lobby" then
        T.swap("mps_lobby_lines", lines_def)
        T.swap("mps_lobby_side", side_def)
        S.lobby.unread = 0
        T.lobby_label()
        return
    end
    if what == "chat" and not S.chat.enabled then return leave_panel() end
    if what == "chat_panel" or what == "chat_result" or what == "mutes" then
        if T.typing() then
            T.swap("mps_lobby_side", side_def)
            return
        end
        UIK.refresh()
    end
end

local function in_match_run()
    if bom_playback and bom_playback.active() then return false end
    return G and G.STAGES and G.STAGE == G.STAGES.RUN and bom_match and bom_match.is_in_match and bom_match.is_in_match()
end

function C.tick()
    local want = in_match_run()
    if C.run_button and C.run_button.REMOVED then C.run_button = nil end
    if want and not C.run_button then
        local t = UIK and UIK.touch and UIK.touch()
        local node = UIBox_button({button = "mps_chat_open_run", label = {L("Chat")}, colour = G.C.ORANGE,
            minw = 1.5, minh = t and 0.8 or 0.6, scale = t and 0.4 or 0.34})
        C.live_button(node)
        C.run_button = UIBox{
            definition = {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR}, nodes = {node}},
            config = {align = "cri", offset = {x = -1.8, y = -0.4}, major = G.ROOM_ATTACH},
        }
    elseif not want and C.run_button then
        pcall(function() C.run_button:remove() end)
        C.run_button = nil
    end
    if S.lobby_open and not C.is_open() and not (win_id() == "mps_report") then S.lobby_open = false end
end

local function ref(e) return e and e.config and e.config.ref_table or {} end

local function register_funcs()
    G.FUNCS.mps_chat_open_lobby = function() C.open_panel("lobby") end
    G.FUNCS.mps_chat_open_party = function() C.open_panel("party") end
    G.FUNCS.mps_chat_open_run = function()
        if G.OVERLAY_MENU then return end
        C.open_panel("run")
    end
    G.FUNCS.mps_chat_optin_friends = function() C.open_optin("friends") end
    G.FUNCS.mps_chat_optin_go = function()
        S.note = nil
        local msg = {type = "chat_optin", enabled = true}
        if S.chat.allowed == nil then msg.birth_year = math.floor(tonumber(S.chat.year) or 0) end
        local B = T.social()
        if B and B.ensure_online then B.ensure_online() end
        if not T.send(msg) then C.open_optin(nil, true) end
    end
    G.FUNCS.mps_chat_optin_back = function()
        S.note = nil
        local target = S.chat_return
        if target == "friends" then return C.back_to("friends") end
        if target == "lobby" and bom_ui and bom_ui.show_lobby then return bom_ui.show_lobby() end
        if target == "party" and bom_party and bom_party.show_lobby then return bom_party.show_lobby() end
r 13 1375 %20%20%20%20%20%20%20%20 -
l 86
    end
    G.FUNCS.mps_chat_back = function() leave_panel() end
    G.FUNCS.mps_chat_send = function()
        if G.CONTROLLER then G.CONTROLLER.text_input_hook = nil end
        C.send()
    end
    G.FUNCS.mps_chat_off = function()
        T.send({type = "chat_optin", enabled = false})
        S.chat.enabled = false
        leave_panel()
    end
    G.FUNCS.mps_chat_mute = function(e)
        local pid = ref(e).pid
        if pid == nil then return end
        local on = not S.lobby.mutes[pid]
        S.lobby.mutes[pid] = on or nil
        T.send({type = on and "chat_mute" or "chat_unmute", pid = pid})
        if T.typing() then
            T.swap("mps_lobby_lines", lines_def)
            T.swap("mps_lobby_side", side_def)
        else
            UIK.refresh()
        end
    end
    G.FUNCS.mps_chat_report = function(e)
        local r = ref(e)
        if not r.id then return end
        if G.CONTROLLER then G.CONTROLLER.text_input_hook = nil end
        open_report({id = r.id, pid = r.pid, name = r.name})
    end
    G.FUNCS.mps_chat_report_go = function(e)
        local key = ref(e).key
        if S.report and key then T.send({type = "chat_report", msg_id = S.report.id, reason = key}) end
        S.report = nil
        C.open_panel(S.chat_from)
        T.note(L("Report sent. Thank you."), false)
        T.later("chat_panel")
    end
    G.FUNCS.mps_chat_report_back = function()
        S.report = nil
        C.open_panel(S.chat_from)
    end
end

