    local footer = {}
    if S.chat.allowed ~= false then
        footer[#footer + 1] = UIK.button{label = L("Turn on chat"), button = "mps_chat_optin_go", colour = G.C.GREEN, id = "mps_optin_go", w = 3.2}
    end
    G.FUNCS.overlay_menu{definition = UIK.window{
        id = "mps_optin", compact = true, w = touch() and 8.8 or 7.8,
        title = L("TEXT CHAT"),
        tabs = {{key = "main", label = L("Chat"), build = optin_body}},
        footer = footer,
        back_func = "mps_chat_optin_back",
