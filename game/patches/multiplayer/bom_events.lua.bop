function bom_events.apply_lobby_seat(d)
    if not (d and type(d.host) == "boolean" and bom_match and bom_match.get_state) then return end
    pcall(function() bom_room.on_seat(d) end)
    local st = bom_match.get_state()
    st.is_host = d.host
    if d.playerId ~= nil then st.server_player_id = d.playerId end
    pcall(function() bom_rejoin.on_room_seat(d) end)
    mp_log.info("BOM_EVENTS", "lobby seat from server: host=%s pid=%s", tostring(d.host), tostring(d.playerId))
end

function bom_events.back_to_lobby_after_results(d)
    pcall(function()
        mp_log.info("BOM_EVENTS", "Opponent returned to lobby")
        if d and d.gameHistory and bom_ui and bom_ui.update_game_history then
            bom_ui.update_game_history(d.gameHistory)
        end
        local in_lobby = bom_match and bom_match.get_phase and bom_match.get_phase() == bom_match.PHASE.LOBBY
        if in_lobby then
            local st = bom_match.get_state()
            local changed = d and type(d.host) == "boolean" and st.is_host ~= d.host
            bom_events.apply_lobby_seat(d)
            if changed and G.GAME and G.GAME.bom_quick_match and bom_ui and bom_ui.show_quick_match_lobby then
                bom_ui.show_quick_match_lobby()
            end
        end
        if bom_match and bom_match.get_phase and bom_match.get_phase() ~= bom_match.PHASE.LOBBY then
            local quick = G.GAME and G.GAME.bom_quick_match
            local code = G.GAME and G.GAME.bom_room_code
            if bom_ui then bom_ui.destroy_match_hud() end
            G.GAME.multiplayer = nil
            if bom_match and bom_match.return_to_lobby then
                bom_match.return_to_lobby()
            elseif bom_match and bom_match.reset then
                bom_match.reset()
            end
            bom_events.apply_lobby_seat(d)
            pcall(function()
r 4 1825 %20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20 -
l 176
            end)
            bom_rejoin.exit_to_menu({ keep_match = true, silent = true, after = function()
                pcall(function()
                    G.GAME.bom_quick_match = quick
                    G.GAME.bom_room_code = G.GAME.bom_room_code or code
                end)
                if quick and bom_ui.show_quick_match_lobby then
                    bom_ui.show_quick_match_lobby()
                else
                    bom_ui.show_lobby()
                end
            end })
        end
    end)
    pcall(function()
        if d and type(d.settings) == "table" and bom_match and bom_match.update_settings then
            bom_match.update_settings(d.settings)
        end
    end)
end

local LISTENERS = {}

function bom_events.register(msg_type, fn)
    if type(msg_type) ~= "string" or type(fn) ~= "function" then return false end
    local list = LISTENERS[msg_type]
    if not list then
        list = {}
        LISTENERS[msg_type] = list
    end
    for _, f in ipairs(list) do
        if f == fn then return true end
    end
    list[#list + 1] = fn
    return true
end

function bom_events.unregister(msg_type, fn)
    local list = LISTENERS[msg_type]
    if not list then return false end
    for i = #list, 1, -1 do
        if list[i] == fn then
            table.remove(list, i)
            return true
        end
    end
    return false
end

local function run_listeners(data)
    local list = LISTENERS[data.type]
    if not list or #list == 0 then return false end
    local consumed = false
    for _, fn in ipairs({ unpack(list) }) do
        local ok, res = pcall(fn, data)
        if not ok then
            mp_log.error("BOM_EVENTS", "ERROR in registered handler for %s: %s", tostring(data.type), tostring(res))
        elseif res == true then
            consumed = true
        end
    end
    return consumed
end

function bom_events.dispatch(data)
    if not data or not data.type then return end
    if PERF_MON and PERF_MON.enabled then PERF_MON.note_mp_message(data.type) end
    if mp_log.enabled and mp_log.enabled("DEBUG") then pcall(function()
        require("functions/fast_fs").append("mp_match_debug.txt",
            "\n[DISPATCH] type=" .. tostring(data.type)
            .. " phase=" .. tostring(data.phase)
            .. " reason=" .. tostring(data.reason)
            .. " event=" .. tostring(data.event))
    end) end
    mp_log.debug("BOM_EVENTS", "dispatch: type=%s", tostring(data.type))
    if run_listeners(data) then return end
    if bom_ranked and type(data.type) == "string" then
        if data.type:sub(1, 7) == "ranked_" then
            pcall(bom_ranked.on_message, data)
            return
        end
        pcall(bom_ranked.peek_names, data)
    end
    if bom_social and type(data.type) == "string" and data.type:sub(1, 7) == "social_" then
        pcall(bom_social.on_message, data)
        return
    end
    if bom_spectate and (data.type == "spec_board" or data.type == "spec_avail") then
        pcall(bom_spectate.on_message, data)
        return
    end
    if bom_party_run and bom_party_run.on_message then
        local ok_run, used = pcall(bom_party_run.on_message, data)
        if not ok_run then
            mp_log.error("BOM_EVENTS", "ERROR in party run handler for %s: %s", tostring(data.type), tostring(used))
        elseif used then
            return
        end
    end
    if bom_party and bom_party.on_message then
        local ok_party, consumed = pcall(bom_party.on_message, data)
        if not ok_party then
            mp_log.error("BOM_EVENTS", "ERROR in party handler for %s: %s", tostring(data.type), tostring(consumed))
        elseif consumed then
            return
        end
    end
    local handler = HANDLERS[data.type]
    if handler then
        local ok, err = pcall(handler, data)
        if not ok then
            mp_log.error("BOM_EVENTS", "ERROR handling %s: %s", tostring(data.type), tostring(err))
            pcall(function()
                local msg = string.format("[DISPATCH ERROR] type=%s err=%s", tostring(data.type), tostring(err))
                print("[MP_DBG] " .. msg)
                require("functions/fast_fs").append("mp_match_debug.txt", "\n" .. msg)
            end)
            if data.type == "match_start" then
                error("MATCH_START DISPATCH ERROR: " .. tostring(err))
            end
        end
    else
        mp_log.debug("BOM_EVENTS", "No handler for: %s", tostring(data.type))
    end
end


function bom_events.on_game_event(event, data)
    if not G then return end
    if not G.GAME then return end
    if not G.GAME.multiplayer then return end

    if event == "boss_defeated" then
        G.GAME.mp_boss_wins = (G.GAME.mp_boss_wins or 0) + 1
        pcall(function()
            if bom_match and bom_match.on_blind_defeated then
                bom_match.on_blind_defeated(G.GAME.chips or 0)
            end
        end)

    elseif event == "game_over" then
        local is_pvp = false
        pcall(function()
            if bom_match and bom_match.is_pvp_blind then
                is_pvp = bom_match.is_pvp_blind()
            end
        end)
        if is_pvp then
            pcall(function()
                if bom_match and bom_match.on_blind_defeated then
                    local score = 0
                    pcall(function() score = G.GAME.chips or 0 end)
                    bom_match.on_blind_defeated(score)
                end
            end)
        else
            pcall(function()
                if bom_match and bom_match.on_game_over then
                    bom_match.on_game_over()
                end
            end)
        end

    elseif event == "blind_entered" then
        pcall(function()
            if bom_match and bom_match.on_blind_entered then
                local ante = data and data.ante or 1
                local blind_type = data and data.blind_type or "S"
                bom_match.on_blind_entered(ante, blind_type)
            end
        end)
    end
end

mp_log.info("BOM_EVENTS", "Multiplayer events module loaded")
return bom_events
end
