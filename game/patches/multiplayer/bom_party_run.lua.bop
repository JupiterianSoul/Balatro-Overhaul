local R = {}

local function L(s) return mod_loc and mod_loc(s) or s end

R.KEY = {raid = "bl_mp_raid", br = "bl_mp_royale", teams = "bl_mp_clash"}
R.ART = {raid = "bl_final_vessel", br = "bl_final_bell", teams = "bl_final_leaf"}
R.NAME = {raid = "Raid Boss", br = "Royale Blind", teams = "Team Clash"}
R.DESC = {
    raid = {"Beat the raid boss", "together: the team total", "must reach the target"},
    br = {"Don't finish last:", "the lowest score", "loses a life"},
    teams = {"Your team total", "must beat the best", "enemy team"},
}
R.HUD_DESC = {
    raid = {"Beat the boss together:", "team total must reach target"},
    br = {"Don't finish last: the", "lowest score loses a life"},
    teams = {"Your team total must", "beat the best enemy team"},
}
R.EXTRAS = {
    raid = {"ALL", "for", "ONE"},
    br = {"DON'T", "finish", "LAST"},
    teams = {"TEAM", "versus", "TEAM"},
}
R.TOP = {raid = "Raid target", br = "Score to beat", teams = "Enemy team"}
R.TOP_LEAD = "Closest rival"
R.BOTTOM = {raid = "Team total", br = "Your rank", teams = "Your team"}

local V = {view = nil}
R.V = V

local BASE_CHIPS = {300, 800, 2000, 5000, 11000, 20000, 35000, 50000}

function R.boss_chips(ante)
    local a = math.max(1, math.floor(tonumber(ante) or 1))
    if a <= 8 then return BASE_CHIPS[a] * 2 end
    return math.floor(BASE_CHIPS[8] * 2 * (1.6 ^ (a - 8)) + 0.5)
end

local function clamp(v, lo, hi, d)
    v = tonumber(v)
    if not v then return d end
    return math.min(hi, math.max(lo, math.floor(v + 0.5)))
end

R.CURVE = {3.0, 2.8, 2.3, 1.65, 1.25, 1.05, 1.0, 1.0}

function R.raid_curve(settings, ante)
    if tonumber(settings and settings.raid_curve) ~= 2 then return 1 end
    local a = math.min(#R.CURVE, math.max(1, math.floor(tonumber(ante) or 1)))
    return R.CURVE[a]
end

function R.raid_target(settings, players, ante, blind)
    settings = settings or {}
    local curve2 = tonumber(settings.raid_curve) == 2
    local n = math.max(1, tonumber(players) or 1)
    local per = clamp(settings.raid_per_player, 50, 800, curve2 and 100 or 250)
    local scaling = clamp(settings.raid_scaling, 0, 100, curve2 and 0 or 25)
    local part = blind == "S" and 0.5 or (blind == "B" and 0.75 or 1)
    local a = math.max(1, math.floor(tonumber(ante) or 1))
    local scale = 1 + (scaling / 100) * math.max(0, a - 1)
    return math.max(1, math.floor(R.boss_chips(a) * part * n * (per / 100) * scale * R.raid_curve(settings, a) + 0.5))
end

local function settings()
    local s = {}
    pcall(function() s = bom_match.get_settings() or {} end)
    return s
end

local function ps()
    return bom_party and bom_party.S and bom_party.S.ps or nil
end

function R.kind()
    if not (bom_party and bom_party.active and bom_party.active()) then return nil end
    local k = bom_party.kind()
    if R.KEY[k] then return k end
    return nil
end

function R.view()
    local p = ps()
    return V.view or (p and p.view) or {}
end

function R.name(k)
    k = k or R.kind()
    return L(R.NAME[k] or "Rivals")
end

function R.desc(k)
    k = k or R.kind()
    local out = {}
    for i, line in ipairs(R.DESC[k] or {}) do out[i] = L(line) end
    return out
end

function R.hud_desc(k)
    k = k or R.kind()
    local out = {}
    for i, line in ipairs(R.HUD_DESC[k] or {}) do out[i] = L(line) end
    return out
end

function R.extras(k)
    k = k or R.kind()
    local e = R.EXTRAS[k]
    if not e then return nil end
    return L(e[1]), L(e[2]), L(e[3])
end

function R.blind_key(k)
    k = k or R.kind()
    return R.KEY[k]
end

function R.own_art(key)
    local kit = rawget(_G, "bom_kit")
    local art = kit and kit.BLIND_ART and kit.BLIND_ART[key]
    if art and G and G.ANIMATION_ATLAS and G.ANIMATION_ATLAS[art.atlas] then return art end
    return nil
end

function R.art_key(k)
    k = k or R.kind()
    local own = R.KEY[k]
    if own and R.own_art(own) and G and G.P_BLINDS and G.P_BLINDS[own] then return own end
    local key = R.ART[k]
    if key and G and G.P_BLINDS and G.P_BLINDS[key] then return key end
    return nil
end

local function fmt(v)
    local n = tonumber(v)
    if not n then return v ~= nil and tostring(v) or "-" end
    local ok, out = pcall(number_format, n)
    return ok and out or tostring(n)
end
R.fmt = fmt

local function team_name(t)
    if t == nil or tonumber(t) == nil or tonumber(t) < 0 then return "-" end
    if bom_party and bom_party.team_name then return bom_party.team_name(t) end
    return "Team " .. string.char(65 + tonumber(t))
end

function R.top_label(k)
    k = k or R.kind()
    if k == "teams" then
        local v = R.view()
        if v.enemyTeam ~= nil and tonumber(v.enemyTeam) and tonumber(v.enemyTeam) >= 0 then return team_name(v.enemyTeam) end
    end
    if k == "br" and R.view().leader == true then return L(R.TOP_LEAD) end
    return L(R.TOP[k] or "Enemy Score")
end

function R.bottom_label(k)
    k = k or R.kind()
    if k == "teams" then
        local v = R.view()
        if v.team ~= nil then return team_name(v.team) .. " (" .. L("you") .. ")" end
    end
    return L(R.BOTTOM[k] or "Enemy Hands")
end

function R.bottom_colour(k)
    k = k or R.kind()
    if k == "teams" then
        local v = R.view()
        if v.team ~= nil and bom_party and bom_party.team_colour then return bom_party.team_colour(v.team) end
    end
    return nil
end

function R.top_value(k)
    k = k or R.kind()
    local v = R.view()
    if k == "raid" then return tonumber(v.target) or 0 end
    if k == "teams" then return tonumber(v.enemyTotal) or 0 end
    return tonumber(v.best) or tonumber(v.value) or 0
end

function R.bottom_text(k)
    k = k or R.kind()
    local v = R.view()
    if k == "raid" then return fmt(v.total or 0) end
    if k == "teams" then return fmt(v.teamTotal or 0) end
    local alive = tonumber(v.ranked) or tonumber(v.alive) or 0
    if v.rank == nil then return "- / " .. tostring(alive) end
    return tostring(v.rank) .. " / " .. tostring(alive)
end

local function slot_code(slot)
    return (slot == "Small" and "S") or (slot == "Big" and "B") or "L"
end

function R.select_amount(slot, ante)
    local k = R.kind()
    if k ~= "raid" then return nil end
    local code = slot_code(slot)
    local p = ps() or {}
    local v = R.view()
    if p.pvpAnte ~= nil and tonumber(p.pvpAnte) == tonumber(ante) and p.pvpBlind == code and tonumber(v.target) then
        return tonumber(v.target)
    end
    local n = tonumber(v.n)
    if not n then
        n = 0
        for _, pl in ipairs(p.players or {}) do if pl.alive ~= false then n = n + 1 end end
        if n == 0 then n = 1 end
    end
    return R.raid_target(settings(), n, ante, code)
end

function R.apply_panel()
    local k = R.kind()
    if not k or not G or not G.GAME then return end
    local panel = G.GAME.mp_opponent_panel
    if not panel then return end
    panel.score = R.top_value(k)
    panel.hands_left = R.bottom_text(k)
    panel.name = R.name(k)
    local node = bom_pvp_hud and bom_pvp_hud.state and bom_pvp_hud.state.top_label_node
    if node and node.config then
        local label = R.top_label(k)
        if node.config.text ~= label then
            node.config.text = label
            pcall(function() G.HUD_blind:recalculate() end)
        end
    end
    if G.GAME.blind and G.GAME.blind.pvp and bom_nemesis and bom_nemesis.fill_debuff_lines then
        pcall(bom_nemesis.fill_debuff_lines, G.GAME.blind)
    end
end

function R.waiting_text()
    local k = R.kind()
    local v = R.view()
    local n = tonumber(v.waiting) or 0
    local wait
    if n <= 0 then wait = L("Resolving the blind...")
    elseif n == 1 then wait = L("Waiting for 1 player")
    else wait = string.format(L("Waiting for %d players"), n) end
    if k == "raid" then
        return L("Your part") .. ": " .. fmt(v.mine or 0) .. "   " .. L("Team") .. ": " .. fmt(v.total or 0) .. " / " .. fmt(v.target or 0) .. "\n" .. wait
    end
    if k == "teams" then
        return team_name(v.team) .. ": " .. fmt(v.teamTotal or 0) .. "   " .. team_name(v.enemyTeam) .. ": " .. fmt(v.enemyTotal or 0) .. "\n" .. wait
    end
    if k == "br" then
        return L("Your rank") .. ": " .. R.bottom_text(k) .. "\n" .. wait
    end
    return wait
end

function R.refresh_waiting()
    if not (G and G.BOM_PVP_WAITING_OVERLAY and R.kind()) then return end
    pcall(function() bom_ui.show_pvp_waiting(R.waiting_text()) end)
end

local function hlog(fmt_s, ...)
    if mp_log and mp_log.info then pcall(mp_log.info, "PARTY_RUN", fmt_s, ...) end
end

R.NOTICE = {left = "%s left the party", dropped = "%s lost connection", menu = "%s went back to the menu", rejoined = "%s is back"}

function R.notice_text(d)
    local f = R.NOTICE[d.event or ""]
    if not f then return nil end
    return string.format(L(f), tostring(d.name or "?"))
end

function R.toast(text)
    if not (G and G.ROOM_ATTACH and text) then return end
    pcall(function()
        attention_text({text = text, scale = 0.55, hold = 3.5, major = G.ROOM_ATTACH, align = "cm", offset = {x = 0, y = -3.2},
            backdrop_colour = G.C.BLACK, silent = true})
    end)
    pcall(function() play_sound("cancel", 0.8, 0.6) end)
end

function R.on_message(d)
    if not d or not d.type then return false end
    if d.type == "party_notice" then
        local text = R.notice_text(d)
        hlog("notice %s", tostring(text))
        R.toast(text)
        pcall(function() bom_party.refresh_standings() end)
        return true
    end
    if d.type == "party_state" then
        V.view = type(d.view) == "table" and d.view or nil
        R.apply_panel()
        R.refresh_waiting()
        return false
    end
    if d.type == "match_start" and d.party then
        V.view = nil
        R._last_rank = nil
        return false
    end
    if d.type == "enemy_info" and d.party then
        if type(d.view) == "table" then V.view = d.view end
        if not R.kind() then return false end
        R.apply_panel()
        pcall(function() bom_pvp_hud.juice_up_pvp_hud() end)
        R.refresh_waiting()
        local v = R.view()
        hlog("view kind=%s value=%s total=%s target=%s rank=%s team=%s/%s waiting=%s",
            tostring(v.kind), tostring(v.value), tostring(v.total), tostring(v.target), tostring(v.rank),
            tostring(v.teamTotal), tostring(v.enemyTotal), tostring(v.waiting))
        return true
    end
    return false
end

