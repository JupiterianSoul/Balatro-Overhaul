local WIN = {0.0, 0.3, 0.0, 0.9}
local LOSE = {0.35, 0.0, 0.0, 0.9}
local DRAW = {0.25, 0.25, 0.1, 0.9}

function R.result_lines(d)
    local k = d.kind or R.kind()
    local res = d.result or "draw"
    if k == "raid" then
        local cleared = res == "win"
        return {
            cleared and L("RAID CLEARED") or L("RAID FAILED"),
            L("Team total") .. ": " .. fmt(d.raidTotal or 0) .. " / " .. fmt(d.raidTarget or 0),
            L("Your part") .. ": " .. fmt(d.myScore or 0)
                .. ((d.mvpName and (tonumber(d.mvpBonus) or 0) > 0) and ("   " .. L("Top damage") .. ": " .. tostring(d.mvpName) .. " +$" .. tostring(d.mvpBonus)) or ""),
            cleared and (L("Raid lives") .. ": " .. tostring(d.raidLives or d.myLives or 0))
                or (L("The raid loses a shared life") .. ", " .. L("Raid lives") .. ": " .. tostring(d.raidLives or d.myLives or 0)),
        }, cleared and WIN or LOSE, cleared and G.C.GOLD or G.C.RED
    end
    if k == "teams" then
        local mine = d.myTeam
        local scores = d.teamScores or {}
        local my_total = scores[tostring(mine)] or scores[mine] or 0
        local best_t, best = nil, nil
        for t, sc in pairs(scores) do
            if tonumber(t) ~= tonumber(mine) and (best == nil or sc > best) then best_t, best = t, sc end
        end
        local head = res == "win" and L("YOUR TEAM WON THE CLASH") or (res == "lose" and L("YOUR TEAM LOST THE CLASH") or L("THE CLASH IS A DRAW"))
        local lives = d.teamLives and (d.teamLives[tostring(mine)] or d.teamLives[mine]) or d.myLives
        return {
            head,
            team_name(mine) .. " " .. fmt(my_total) .. "   " .. L("vs") .. "   " .. team_name(best_t) .. " " .. fmt(best or 0),
            res == "lose" and (L("Your team loses a life") .. ", " .. L("Team lives") .. ": " .. tostring(lives or 0))
                or (L("Team lives") .. ": " .. tostring(lives or 0)),
        }, res == "win" and WIN or (res == "lose" and LOSE or DRAW), res == "win" and G.C.GOLD or (res == "lose" and G.C.RED or G.C.UI.TEXT_LIGHT)
    end
    local head, line
    if res == "lose" then
        head = L("YOU WERE LOWEST")
        line = L("-1 life") .. ", " .. L("Lives") .. ": " .. tostring(d.myLives or 0)
    elseif res == "win" then
        head = L("SAFE")
        line = L("Lives") .. ": " .. tostring(d.myLives or 0)
    else
        head = L("NO ONE LOSES")
        line = L("Lives") .. ": " .. tostring(d.myLives or 0)
    end
    local rank = d.rank and (L("Your rank") .. ": " .. tostring(d.rank) .. " / " .. tostring(d.ranked or "?")) or nil
    local low = d.lowestName and (L("Lowest") .. ": " .. tostring(d.lowestName) .. " " .. fmt(d.lowestScore or 0)) or nil
    local out = {head, L("Your score") .. ": " .. fmt(d.myScore or 0) .. (rank and ("   " .. rank) or "")}
    if low then out[#out + 1] = low end
    out[#out + 1] = line
    return out, res == "win" and WIN or (res == "lose" and LOSE or DRAW), res == "win" and G.C.GOLD or (res == "lose" and G.C.RED or G.C.UI.TEXT_LIGHT)
end

function R.apply_rewards(d)
    if not (d and d.party and d.kind == "raid" and d.mvp == true and not d.solo) then return false end
    local bonus = math.max(0, math.min(10, math.floor(tonumber(d.mvpBonus) or 0)))
    if bonus <= 0 then return false end
    pcall(ease_dollars, bonus)
    hlog("mvp bonus $%d", bonus)
    return true
end

function R.show_result(d)
    if not d or not d.party or d.solo or not R.KEY[d.kind or R.kind() or ""] then return false end
    local lines, panel_col, head_col, outcome = R.result_lines(d)
    hlog("result kind=%s result=%s my=%s total=%s target=%s rank=%s lives=%s", tostring(d.kind), tostring(d.result),
        tostring(d.myScore), tostring(d.raidTotal), tostring(d.raidTarget), tostring(d.rank), tostring(d.myLives))
    local prev = R._last_rank
    if d.rank ~= nil then R._last_rank = tonumber(d.rank) end
    if bom_ui and bom_ui.pvp_result_popup then
        local rest = {}
        for i = 2, #lines do rest[#rest + 1] = lines[i] end
        local ok, box = pcall(bom_ui.pvp_result_popup, {result = outcome or d.result, title = lines[1], lines = rest, place_before = prev, place_after = tonumber(d.rank)})
        if ok and box then return true end
    end
    banner(lines, panel_col, head_col)
    return true
end

function R.rules_lines(s)
    s = s or settings()
    local k = s.party_kind or (R.kind()) or "br"
    local out = {}
    local function add(a) out[#out + 1] = a end
    local every = s.party_every_blind == true or (k == "raid" and s.raid_every_blind == true)
    add(L("Party fights") .. ": " .. (every and L("every blind") or L("boss blinds")) .. ", " .. L("from ante") .. " " .. tostring(s.pvp_start_round or 1))
    if k == "raid" then
        add(L("Raid lives") .. ": " .. tostring(clamp(s.raid_lives, 1, 20, 3)) .. " (" .. L("shared") .. ")")
        local curve2 = tonumber(s.raid_curve) == 2
        add(L("Target") .. " = " .. L("boss chips") .. " x " .. L("players") .. " x " .. tostring(clamp(s.raid_per_player, 50, 800, curve2 and 100 or 250)) .. "%")
        local sc = clamp(s.raid_scaling, 0, 100, curve2 and 0 or 25)
        if sc > 0 then add("+" .. tostring(sc) .. "% " .. L("per ante after the first")) end
        if curve2 then add(L("Early antes: x3 at ante 1, down to x1 at ante 7")) end
        add(L("Small blind 50%, Big blind 75% of the boss target"))
        add(L("Team total below the target: the raid loses a life"))
        add(L("Top damage bonus") .. ": $" .. tostring(clamp(s.raid_mvp_bonus, 0, 10, 3)))
    elseif k == "teams" then
        add(L("Team size") .. ": " .. tostring(clamp(s.team_size, 2, 4, 2)))
        add(L("Team lives") .. ": " .. tostring(clamp(s.starting_lives, 1, 20, 4)) .. " (" .. L("shared") .. ")")
        add(L("Teammate share") .. ": " .. tostring(clamp(s.team_share, 0, 100, 100)) .. "%")
        add(L("Lowest team total loses a team life"))
    else
        add(L("Lives each") .. ": " .. tostring(clamp(s.starting_lives, 1, 20, 4)))
        add(L("Players hit per blind") .. ": " .. tostring(clamp(s.br_losers, 1, 3, 1)))
        add(L("Ties for lowest") .. ": " .. (s.br_ties == "spare" and L("Ties are spared") or L("Everyone tied loses")))
        if s.br_sudden_death == true then add(L("Final two sudden death")) end
        if s.party_swap == true then add(L("Switcheroo") .. ": " .. L("Runs pass to the next player after each boss")) end
    end
    add(L("AFK limit") .. ": " .. tostring(clamp(s.party_blind_seconds, 60, 600, 180)) .. "s")
    return out
end

local function loc_entry(name, text)
    local e = {name = name, text = text}
    if loc_parse_string then
        e.text_parsed = {}
        for _, line in ipairs(text) do e.text_parsed[#e.text_parsed + 1] = loc_parse_string(line) end
        e.name_parsed = {loc_parse_string(name)}
    end
    return e
end

function R.ensure_registered()
    if not (G and G.P_BLINDS) then return end
    for k, key in pairs(R.KEY) do
        if not G.P_BLINDS[key] then
            local art = G.P_BLINDS[R.ART[k]] or G.P_BLINDS.bl_big or {}
            local own = R.own_art(key)
            G.P_BLINDS[key] = {
                key = key, name = key, loc_name = R.NAME[k], dollars = 5, mult = 1, boss = {min = 1, max = 10}, blind_types = {"boss"},
                boss_colour = own and own.colour and HEX(own.colour) or art.boss_colour or G.C.RED, atlas = own and own.atlas or art.atlas or "blind_chips", pos = own and own.pos or art.pos or {x = 0, y = 0},
                discovered = true, order = 1001, no_collection = true, debuff = {}, loc_debuff_text = R.HUD_DESC[k], in_pool = function() return false end,
            }
        end
        pcall(function()
            local d = G.localization and G.localization.descriptions and G.localization.descriptions.Blind
            if d then d[key] = loc_entry(R.name(k), R.desc(k)) end
        end)
        if G.GAME then
            G.GAME.banned_keys = G.GAME.banned_keys or {}
            G.GAME.banned_keys[key] = true
            G.GAME.bosses_used = G.GAME.bosses_used or {}
            G.GAME.bosses_used[key] = G.GAME.bosses_used[key] or 0
        end
    end
end

