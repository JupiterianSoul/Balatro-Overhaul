    G.FUNCS.overlay_menu{definition = UIK.window{zoom = false, id = "mpm_daily", compact = true, w = DAILY_W,
        title = kind == "weekly" and L("WEEKLY") or L("DAILY"),
        tabs = {{key = kind, label = "", build = function() return M.daily_body(kind) end}},
        back_func = "mpm_open_play", footer = footer}}
end

function M.on_daily(d)
    if type(d) ~= "table" or (d.kind ~= "daily" and d.kind ~= "weekly") then return end
    M.daily[d.kind] = d
    M.daily_status[d.kind] = "ok"
    M.refresh_if("mpm_play")
    if M.daily_open == d.kind and UIK and UIK._win and UIK._win.id == "mpm_daily" then
        M.open_daily(d.kind)
    end
end

function M.on_menu_info(d)
    if type(d) ~= "table" then return end
    M.info = d
    M.info.at = love and love.timer and love.timer.getTime() or 0
    local RU = rawget(_G, "bom_ranked_ui")
    if RU and RU.on_menu_info then pcall(RU.on_menu_info, d) end
end

function M.request_info()
    M.with_connection(function() M.send({type = "menu_info"}) end)
end

local function open_or(name, fallback, e)
    local f = G.FUNCS[name]
    if f then return f(e) end
    if fallback and G.FUNCS[fallback] then return G.FUNCS[fallback](e) end
end

function M.register()
    if not (G and G.FUNCS) then return end
    if not M.legacy_open and G.FUNCS.open_multiplayer_menu then M.legacy_open = G.FUNCS.open_multiplayer_menu end
    G.FUNCS.mpm_enter = function()
        if not M.enter() and M.legacy_open then M.legacy_open() end
    end
    G.FUNCS.open_multiplayer_menu = function(e)
        if not on_menu() then
            if M.legacy_open then return M.legacy_open(e) end
            return
        end
        local was = M.active
        M.active = true
        if not was then M.rebuild_soon() end
        M.open_play()
        if not was then after_enter() end
    end
    G.FUNCS.mpm_exit = function() M.exit() end
    G.FUNCS.mpm_open_play = function() M.open_play() end
    G.FUNCS.mpm_browse = function()
        if bom_browse and bom_browse.show then bom_browse.show() end
    end
    G.FUNCS.mpm_create = function()
        if bom_browse and bom_browse.show_create then bom_browse.show_create() end
    end
    G.FUNCS.mpm_join = function()
r 13 1381 %20%20%20%20%20%20%20%20 -
l 71
        G.FUNCS.overlay_menu{definition = create_UIBox_join_room_input({title = L("JOIN WITH CODE"), back = "mpm_open_play"})}
    end
    G.FUNCS.mpm_daily = function(e)
        local kind = e and e.config and e.config.ref_table and e.config.ref_table.kind or "daily"
        local D = rawget(_G, "bom_daily")
        if D and type(D.open) == "function" then return D.open(kind) end
        M.open_daily(kind)
        if not M.daily[kind] then M.request_daily(true) end
    end
    G.FUNCS.mpm_daily_start = function(e)
        local kind = e and e.config and e.config.ref_table and e.config.ref_table.kind or "daily"
        local start = daily_start_fn()
        if start then start(kind, M.daily[kind]) end
    end
    G.FUNCS.mpm_open_friends = function(e)
        if G.FUNCS.mps_open_friends then return G.FUNCS.mps_open_friends(e) end
        return open_or("mp_open_friends", nil, e)
    end
    G.FUNCS.mpm_open_inbox = function(e)
        if G.FUNCS.mps_open_inbox then return G.FUNCS.mps_open_inbox(e) end
    end
    G.FUNCS.mpm_open_profile = function(e)
        local P = rawget(_G, "mpm_profile")
        if P and P.open then P.open() end
    end
    G.FUNCS.mpm_open_collection = function(e)
        local C = rawget(_G, "mpm_collection")
        if C and C.open then C.open() end
    end
    G.FUNCS.mpm_open_mods = function(e)
        local MM = rawget(_G, "mpm_mods")
        if MM and MM.open then return MM.open() end
        return open_or("mods_button", nil, e)
    end
end

function M.init()
    M.register()
    if bom_events and bom_events.register then
        bom_events.register("daily_ruleset", function(d) M.on_daily(d); return true end)
        bom_events.register("menu_info", function(d) M.on_menu_info(d); return true end)
    end
    if mod_loc_register then
