local M = {}

M.active = M.active or false
M.unread = M.unread or 0
M.bell = M.bell or {text = "0"}
M.bell_colour = M.bell_colour or {0, 0, 0, 0.3}
M.info = M.info or {}
M.daily = M.daily or {}
M.daily_status = M.daily_status or {}

local PLAY_W = 6.8
local DAILY_W = 10.4

local function L(s) return mod_loc and mod_loc(s) or s end
local function touch() return UIK and UIK.touch and UIK.touch() end
local function kit() return rawget(_G, "bom_kit") end

local function on_menu()
    return G and G.STAGES and G.STAGE == G.STAGES.MAIN_MENU
end

local function connected()
    return bom_core and bom_core.is_connected and bom_core.is_connected()
end

local function in_room()
    local ok, phase = pcall(function() return bom_match.get_phase() end)
    return ok and phase ~= nil and bom_match.PHASE and phase ~= bom_match.PHASE.NONE
end

function M.is_active() return M.active == true end

function M.send(msg)
    if not connected() then return false end
    return bom_core.send(msg)
end

function M.with_connection(fn, on_fail)
    if connected() then return fn() end
    if not (bom_core and bom_core.connect) then
        if on_fail then on_fail() end
        return
    end
    bom_core.connect(fn, {silent = true, on_fail = function() if on_fail then on_fail() end end})
end

function M.tagline_text()
    return L("MULTIPLAYER")
end

function M.left_specs()
    return {
        {id = "mpm_profile_button", button = "mpm_open_profile", colour = G.C.PALE_GREEN, label = L("PROFILE")},
        {id = "collection_button", button = "mpm_open_collection", colour = G.C.ORANGE, label = L("COLLECTION")},
        {id = "mpm_friends_button", button = "mpm_open_friends", colour = G.C.GREEN, label = L("FRIENDS")},
    }
end

function M.right_specs(quit_func)
    local out = {
        {id = "mpm_single_button", button = "mpm_exit", colour = G.C.GREEN, label = L("SINGLEPLAYER")},
        {button = "options", colour = G.C.ORANGE, label = localize("b_options_cap")},
    }
    if G.F_QUIT_BUTTON then out[3] = {button = quit_func or "quit", colour = G.C.RED, label = localize("b_quit_cap")} end
    return out
end

function M.tile_button(o)
    local w, h = o.w, o.h
    local inner = math.max(0.4, w - 0.2)
    local rows = {
        {n = G.UIT.R, config = {align = "cm", padding = 0, minw = w, maxw = inner}, nodes = {
            {n = G.UIT.T, config = {text = o.label, scale = o.scale or 0.5, colour = o.text_colour or G.C.UI.TEXT_LIGHT, shadow = true}},
        }},
    }
    if o.sub or o.sub_ref then
        local sc = o.sub_scale or 0.3
        local tcfg = {scale = sc, colour = o.sub_colour or G.C.UI.TEXT_LIGHT, shadow = true}
        if o.sub_ref then tcfg.ref_table = o.sub_ref; tcfg.ref_value = "text" else tcfg.text = o.sub end
        rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0, minh = sc * 1.4, maxw = inner}, nodes = {{n = G.UIT.T, config = tcfg}}}
    end
    if o.band then
        local sc = o.band_scale or 0.28
        local bh = sc * 1.35
        rows[1].config.minh = math.max(0, h - 2 * bh)
        table.insert(rows, 1, {n = G.UIT.R, config = {align = "cr", minw = w, minh = bh, padding = 0}, nodes = {
            {n = G.UIT.C, config = {align = "cm", minw = o.band_w or 1.0, minh = bh, r = 0.1, colour = G.C.GOLD}, nodes = {
                {n = G.UIT.T, config = {text = o.band, scale = sc, colour = G.C.UI.TEXT_DARK}},
            }},
        }})
        rows[#rows + 1] = {n = G.UIT.R, config = {minw = w, minh = bh, padding = 0}}
    end
    if o.sticker then
        local sc = o.sticker_scale or 0.28
        rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.04}, nodes = {
            {n = G.UIT.C, config = {align = "cm", minw = o.sticker_w or 1.0, minh = sc * 1.35, r = 0.06, colour = G.C.GOLD, emboss = 0.03}, nodes = {
                {n = G.UIT.T, config = {text = o.sticker, scale = sc, colour = G.C.UI.TEXT_DARK}},
            }},
        }}
    end
    return {n = o.row and G.UIT.R or G.UIT.C, config = {align = "cm"}, nodes = {
        {n = G.UIT.C, config = {align = "cm", padding = 0, r = 0.1, hover = true, shadow = true, colour = o.colour or G.C.BLUE,
            button = (not o.disabled) and o.button or nil, ref_table = o.ref_table, minw = w, minh = h, id = o.id, focus_args = o.focus_args, mid = o.mid}, nodes = rows},
    }}
end

function M.mods_button(minw, minh, scale)
    return M.tile_button{id = "mods_button", button = "mpm_open_mods", colour = G.C.BLUE, w = minw, h = minh, label = L("MODS"), scale = scale,
        band = L("BETA"), band_scale = math.max(0.26, scale * 0.36), band_w = math.max(1.0, scale * 1.4)}
end

