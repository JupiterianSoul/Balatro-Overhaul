local function deck_name(name)
    if type(name) ~= "string" or name == "" then return L("Red Deck") end
    if bom_match and name == bom_match.RANDOM_DECK then return L("Random pick") end
    local out = name
    pcall(function()
        for _, v in ipairs(G.P_CENTER_POOLS.Back or {}) do
            if v.name == name or v.key == name then
                local n = localize{type = "name_text", set = "Back", key = v.key}
                if n and n ~= "ERROR" then out = n end
                break
            end
        end
    end)
    return out
end

local function stake_name(n)
    n = tonumber(n) or 1
    local out = tostring(n)
    pcall(function()
        local c = G.P_CENTER_POOLS.Stake[n]
        local name = c and localize{type = "name_text", key = c.key, set = "Stake"}
        if name and name ~= "ERROR" then out = name end
    end)
    return out
end

local function on_off(v) return v and L("On") or L("Off") end

local function layer_text(ids)
    if type(ids) ~= "table" or #ids == 0 then return L("None") end
    local names = {}
    local layers = rawget(_G, "bom_layers")
    for _, id in ipairs(ids) do
        local name = nil
        if layers and layers.name then pcall(function() name = layers.name(id) end) end
        if name then names[#names + 1] = name end
    end
    if #names == 0 then return tostring(#ids) end
    return table.concat(names, ", ")
end

local function mode_text(mode)
    mode = mode or "nemesis"
    local out = mode
    pcall(function() out = bom_browse.mode_name(mode) end)
    return L(out)
end

function M.rule_pairs(rs)
    rs = type(rs) == "table" and rs or {}
    local s = type(rs.settings) == "table" and rs.settings or {}
    local mode = rs.mode or s.mode or "nemesis"
    local pvp = mode == "faceoff" and s.showdown_starting_antes or s.pvp_start_round
    local bans = 0
    for _, list in pairs(type(rs.bans) == "table" and rs.bans or {}) do
        if type(list) == "table" then bans = bans + #list end
    end
    local mp_stake, mp_base = nil, nil
    pcall(function()
        if bom_stakes.valid(s.mp_stake) then mp_stake, mp_base = bom_stakes.name(s.mp_stake), bom_stakes.base(s.mp_stake) end
    end)
    local out = {
        {L("Mode"), mode_text(mode)},
        {L("Lives"), tostring(s.starting_lives or 4)},
        {L("PvP from ante"), pvp and tostring(pvp) or "-"},
        {L("Final ante"), tostring(tonumber(s.win_ante) or 8)},
        {L("Ready timer"), s.timer and (tostring(s.timer_base_seconds or 120) .. " s") or L("Off")},
        {L("Deck"), deck_name(s.deck)},
        {L("Stake"), stake_name(mp_base or (bom_match and bom_match.match_stake and bom_match.match_stake(s)) or s.stake)},
        {L("Shared queue"), on_off(s.the_order)},
        {L("MP cards"), on_off(s.multiplayer_jokers ~= false)},
        {L("Hide opponent score"), on_off(s.hide_opp_score)},
        {L("Score preview"), on_off(s.allow_score_preview ~= false)},
        {L("Layers"), layer_text(rs.layers or s.layers)},
        {L("Banned cards"), tostring(bans)},
    }
    if mp_stake then table.insert(out, 8, {L("MP stake"), mp_stake}) end
    return out
end

local function rule_cell(label, value, w)
    local k = kit()
    local d = k.dims()
    local h = d.row_h + 0.04
    local vw = math.min(3.2, w * 0.46)
    local lw = w - vw - 0.3
    local ls, lsc = k.fit(label, lw, d.scale)
    local vs, vsc = k.fit(value, vw - 0.2, d.scale)
    return {n = G.UIT.C, config = {align = "cm", minw = w, maxw = w, minh = h + 0.08, r = 0.1, colour = {0, 0, 0, 0.15}, padding = 0.04}, nodes = {
        {n = G.UIT.C, config = {align = "cl", minw = lw, maxw = lw, minh = h}, nodes = {k.text(ls, {scale = lsc, colour = G.C.UI.TEXT_LIGHT})}},
        {n = G.UIT.C, config = {minw = 0.1}},
        k.pill(vs, {w = vw, h = h, colour = G.C.BLACK, scale = vsc}),
    }}
end

function M.rule_grid(pairs_list, w)
    local gap = 0.16
    local cw = (w - gap) / 2
    local rows = {}
    for i = 1, #pairs_list, 2 do
        local a, b = pairs_list[i], pairs_list[i + 1]
        if #rows > 0 then rows[#rows + 1] = {n = G.UIT.R, config = {minh = 0.08}} end
        rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm"}, nodes = {
            rule_cell(a[1], a[2], cw),
            {n = G.UIT.C, config = {minw = gap}},
            b and rule_cell(b[1], b[2], cw) or {n = G.UIT.C, config = {minw = cw}},
        }}
    end
    return rows
end

function M.ruleset_view(rs, w, extra)
    local k = kit()
    local d = k.dims()
    local nodes = {}
    if rs and rs.name then
        nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.02}, nodes = {k.text(L(rs.name), {scale = d.scale + 0.14, colour = G.C.GOLD})}}
        if rs.desc then nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", maxw = w}, nodes = {k.text(L(rs.desc), {scale = d.small, colour = UIK.C.muted, shadow = false})}} end
    end
    for _, line in ipairs(extra or {}) do
        nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", maxw = w}, nodes = {k.text(line, {scale = d.small, colour = G.C.UI.TEXT_LIGHT})}}
    end
    nodes[#nodes + 1] = {n = G.UIT.R, config = {minh = 0.14}}
    for _, r in ipairs(M.rule_grid(M.rule_pairs(rs), w)) do nodes[#nodes + 1] = r end
    return {n = G.UIT.R, config = {align = "tm", minw = w, padding = 0.04}, nodes = {{n = G.UIT.C, config = {align = "tm"}, nodes = nodes}}}
end

function M.message(text, colour, w, h)
    return {n = G.UIT.R, config = {align = "cm", minw = w or UIK.W, minh = h or 2}, nodes = {UIK.text(text, {colour = colour or G.C.UI.TEXT_LIGHT})}}
end

local function daily_start_fn()
    local D = rawget(_G, "bom_daily")
    return D and type(D.start) == "function" and D.start or nil
end

function M.daily_body(kind)
    local w = DAILY_W - 0.6
    local d = M.daily[kind]
    if not d then
        local st = M.daily_status[kind]
        return M.message(st == "offline" and L("Could not reach the server.") or L("Loading..."), st == "offline" and G.C.RED or nil, w, 3)
    end
    local left = M.daily_left(kind)
    local extra = {}
    if left then extra[#extra + 1] = L("Ends in") .. " " .. fmt_left(left) end
    return M.ruleset_view(d.ruleset or {}, w, extra)
end

function M.open_daily(kind)
    kind = kind == "weekly" and "weekly" or "daily"
    M.daily_open = kind
    local footer = nil
    if daily_start_fn() and M.daily[kind] then
        footer = {UIK.button{label = L("PLAY"), button = "mpm_daily_start", ref_table = {kind = kind}, colour = G.C.GREEN, id = "mpm_daily_start"}}
    end
