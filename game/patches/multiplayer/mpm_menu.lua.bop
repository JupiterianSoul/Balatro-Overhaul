local function after_enter()
    pcall(function()
        if bom_rejoin and bom_rejoin.has_match_session() and not bom_rejoin.prompt and not bom_rejoin.checking then
            bom_rejoin.check_rejoin()
        end
    end)
    pcall(function()
        if G.FUNCS.trigger_sub_showcase_multiplayer then G.FUNCS.trigger_sub_showcase_multiplayer() end
    end)
    pcall(function()
        local hook = rawget(_G, "mps_on_menu")
        if type(hook) == "function" then hook(true) end
    end)
end

function M.enter()
    if not on_menu() then return false end
    local was = M.active
    M.active = true
    if not was then M.rebuild_soon() end
    play_sound("cardSlide1", 1.1, 0.5)
    after_enter()
    return true
end

function M.exit()
    pcall(function() if bom_ranked_ui and bom_ranked_ui.queue_cancel then bom_ranked_ui.queue_cancel(true) end end)
    local so = rawget(_G, "social_online")
    if not in_room() and not (so and so.keep and so.keep()) then pcall(function() bom_core.disconnect() end) end
    pcall(function()
        local hook = rawget(_G, "mps_on_menu")
        if type(hook) == "function" then hook(false) end
    end)
    M.active = false
