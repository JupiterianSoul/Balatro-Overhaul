function M.bell_row(panel_w)
    local t = touch()
    local h = t and 0.62 or 0.5
    local cw = t and 0.62 or 0.5
    local lw = t and 2.0 or 1.7
    M.set_unread(M.unread)
    local node = {n = G.UIT.C, config = {align = "cm", r = 0.1, hover = true, shadow = true, colour = G.C.L_BLACK, button = "mpm_open_inbox", id = "mpm_bell", minh = h, padding = 0}, nodes = {
        {n = G.UIT.C, config = {align = "cm", minw = lw, maxw = lw, minh = h}, nodes = {
            {n = G.UIT.T, config = {text = L("ALERTS"), scale = t and 0.36 or 0.32, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
        }},
        {n = G.UIT.C, config = {align = "cm", minw = cw, minh = h - 0.12, r = 0.08, colour = M.bell_colour}, nodes = {
            {n = G.UIT.T, config = {ref_table = M.bell, ref_value = "text", scale = t and 0.34 or 0.3, colour = G.C.UI.TEXT_LIGHT, shadow = true}},
        }},
        {n = G.UIT.C, config = {minw = 0.06}},
    }}
    return {n = G.UIT.R, config = {align = "cr", minw = panel_w, padding = 0.06}, nodes = {node}}
end

function M.set_unread(n)
    n = math.max(0, math.floor(tonumber(n) or 0))
    M.unread = n
    M.bell.text = n > 9 and "9+" or tostring(n)
    local src = n > 0 and (G and G.C and G.C.RED) or {0, 0, 0, 0.3}
    for i = 1, 4 do M.bell_colour[i] = src[i] or 1 end
end

