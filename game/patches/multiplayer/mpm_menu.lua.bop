local function fmt_left(sec)
    sec = math.max(0, math.floor(tonumber(sec) or 0))
    local d = math.floor(sec / 86400)
    local h = math.floor((sec % 86400) / 3600)
    local m = math.floor((sec % 3600) / 60)
    if d > 0 then return tostring(d) .. L("d") .. " " .. tostring(h) .. L("h") end
    if h > 0 then return tostring(h) .. L("h") .. " " .. tostring(m) .. L("m") end
    return tostring(math.max(1, m)) .. L("m")
end
M.fmt_left = fmt_left

function M.daily_left(kind)
    local d = M.daily[kind]
    if not (d and tonumber(d.ends_at)) then return nil end
    return tonumber(d.ends_at) / 1000 - os.time()
end

function M.daily_sub(kind)
    local d = M.daily[kind]
    local st = M.daily_status[kind]
    if not d then
        if st == "offline" then return L("Offline") end
        return L("Loading...")
    end
    local name = d.ruleset and d.ruleset.name and L(d.ruleset.name) or ""
    local left = M.daily_left(kind)
    local tail = left and (fmt_left(left) .. " " .. L("left")) or ""
    if name ~= "" and tail ~= "" then return name .. ", " .. tail end
    return name ~= "" and name or tail
end

function M.request_daily(force)
    for _, kind in ipairs({"daily", "weekly"}) do
        local d = M.daily[kind]
        local left = M.daily_left(kind)
        if force or not d or not left or left <= 0 then
            M.daily_status[kind] = "loading"
        end
    end
    M.with_connection(function()
        for _, kind in ipairs({"daily", "weekly"}) do
            if M.daily_status[kind] == "loading" then M.send({type = "daily_get", kind = kind}) end
        end
    end, function()
        for _, kind in ipairs({"daily", "weekly"}) do
            if M.daily_status[kind] == "loading" then M.daily_status[kind] = "offline" end
        end
        M.refresh_if("mpm_play")
    end)
end

function M.refresh_if(id)
    if UIK and UIK._win and UIK._win.id == id and G.OVERLAY_MENU and G.OVERLAY_MENU:get_UIE_by_ID("uik_body") then UIK.refresh() end
end

local function column(rows, w)
    local nodes = {}
    for _, r in ipairs(rows) do
        if r then nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.06}, nodes = {r}} end
    end
    return {n = G.UIT.R, config = {align = "tm", minw = w, padding = 0.04}, nodes = {{n = G.UIT.C, config = {align = "tm"}, nodes = nodes}}}
end
M.column = column

function M.play_body()
    local t = touch()
    local w = PLAY_W - 0.6
    local bh = t and 1.0 or 0.86
    local function full(label, button, colour, id)
        return UIK.button{label = label, button = button, colour = colour, w = w, h = bh, id = id, col = true}
    end
    local gap = 0.2
    local hw = (w - gap) / 2
    local th = t and 1.3 or 1.15
    local dailies = {n = G.UIT.C, config = {align = "cm"}, nodes = {
        M.tile_button{id = "mpm_daily", button = "mpm_daily", ref_table = {kind = "daily"}, colour = G.C.PURPLE, w = hw, h = th, label = L("DAILY"),
            scale = t and 0.5 or 0.45, sub = M.daily_sub("daily"), sub_scale = t and 0.3 or 0.27},
        {n = G.UIT.C, config = {minw = gap}},
        M.tile_button{id = "mpm_weekly", button = "mpm_daily", ref_table = {kind = "weekly"}, colour = G.C.PURPLE, w = hw, h = th, label = L("WEEKLY"),
            scale = t and 0.5 or 0.45, sub = M.daily_sub("weekly"), sub_scale = t and 0.3 or 0.27},
    }}
    return column({
        full(L("BROWSE ROOMS"), "mpm_browse", G.C.BLUE, "mpm_browse"),
        full(L("CREATE ROOM"), "mpm_create", G.C.ORANGE, "mpm_create"),
        full(L("JOIN WITH CODE"), "mpm_join", G.C.GREEN, "mpm_join"),
        {n = G.UIT.C, config = {minh = 0.06, minw = w, colour = {1, 1, 1, 0.1}}},
        dailies,
    }, w)
end

