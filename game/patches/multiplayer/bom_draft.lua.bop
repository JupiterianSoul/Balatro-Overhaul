local D = {}

local function L(s)
    if mod_loc then
        local ok, r = pcall(mod_loc, s)
        if ok and r then return r end
    end
    return s
end

local S = {state = nil, result = nil, open = false, at = 0, view = {timer = "", status = ""}, starting = false}
D.S = S

