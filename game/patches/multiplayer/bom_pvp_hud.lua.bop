function bom_pvp_hud.ensure_for_current_blind()
    if not G or not G.GAME or not G.GAME.multiplayer then return end
    if not bom_match or not bom_match.is_pvp_blind then return end
    if bom_match.update_location then pcall(bom_match.update_location) end

    if bom_match.is_pvp_blind() then
        if not bom_pvp_hud.state.blind_hud_active then
            bom_pvp_hud.update_blind_hud()
        end
        pcall(bom_pvp_hud.send_start_hands)

        local token = get_blind_token()
        if token ~= bom_pvp_hud.state.last_blind_token then
            bom_pvp_hud.state.last_blind_token = token
        end
    else
        if bom_pvp_hud.state.blind_hud_active then
            bom_pvp_hud.reset_blind_hud()
        end
        bom_pvp_hud.state.last_blind_token = nil
    end
end


