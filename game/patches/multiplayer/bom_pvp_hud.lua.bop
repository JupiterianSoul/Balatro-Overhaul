        G.FUNCS.evaluate_round = function(...)
            pcall(function()
                if bom_match and bom_match.is_in_match() and G.GAME then
                    local lost = G.GAME.mp_round_lost or G.GAME.mp_blind_loss_pending
                    G.GAME.mp_round_lost = nil
                    local b = G.GAME.blind
                    local versus = b and (b.pvp or b.mp_pvp_over)
                    G.GAME.mp_pay_cap = (lost or versus) and {max = bom_match.round_pay_cap(), paid = 0} or nil
                    if lost and bom_match.rule_no_gold_on_round_loss() and G.GAME.blind then
                        G.GAME.blind.dollars = 0
                        mp_log.info("BOM_PVP_HUD", "no gold on round loss: blind reward withheld")
