function bom_pvp_hud.init()
    G.FUNCS = G.FUNCS or {}

    G.FUNCS.bom_multiplayer_blind_chip_UI_scale = function(e)
        local panel = get_enemy_panel()
        if not panel or not bom_insane_int then return end
        if bom_ui and bom_ui.opp_score_hidden and bom_ui.opp_score_hidden() then
            panel.score_text = "???"
            return
        end
        local display = bom_insane_int.to_string(panel.score or 0)
        if panel.score_text ~= display then
            panel.score_text = display
            local safe_score = bom_insane_int.to_number_if_safe(panel.score or 0)
            if safe_score and scale_number then
                e.config.scale = scale_number(safe_score, 0.7, 100000)
            end
        end
    end

    G.GAME.mp_blind_ready = false
    G.GAME.mp_blind_ready_text = mod_loc("Ready")
    G.GAME.mp_opponent_blind_ready = false

