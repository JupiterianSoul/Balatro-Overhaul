local bom_pvp_hud = {
    state = {
        countdown = 0,
        countdown_active = false,
        last_blind_token = nil,
        blind_hud_active = false,
        enemy_location_shown = false,
    },
}

local function get_settings()
    local settings = {}
    pcall(function() settings = bom_match.get_settings() or {} end)
    return settings
end

local function get_enemy_panel()
    if not G or not G.GAME then return nil end
    return G.GAME.mp_opponent_panel
end

local function get_enemy_hands_text()
    local panel = get_enemy_panel() or {}
    if panel.hands_left ~= nil then return tostring(panel.hands_left) end
    if panel.hands_used ~= nil then return tostring(panel.hands_used) end
    return "?"
end

local TOKEN = {ante = nil, blind = nil, s = "?:?"}

local function get_blind_token()
    if not (bom_match and bom_match.get_state) then return "?:?" end
    local ok, state = pcall(bom_match.get_state)
    if not ok or type(state) ~= "table" then return "?:?" end
    local a, b = state.current_ante, state.current_blind
    if a ~= TOKEN.ante or b ~= TOKEN.blind then
        TOKEN.ante, TOKEN.blind = a, b
        TOKEN.s = tostring(a or "?") .. ":" .. tostring(b or "?")
    end
    return TOKEN.s
end

bom_pvp_hud.blind_token = get_blind_token

function bom_pvp_hud.get_countdown()
    return bom_pvp_hud.state.countdown or 0
end

function bom_pvp_hud.is_countdown_active()
    return bom_pvp_hud.state.countdown_active or false
end

function bom_pvp_hud.start_pvp_countdown(callback)
    local settings = get_settings()
    local seconds = settings.pvp_countdown_seconds or 0
    if seconds <= 0 then
        if callback then pcall(callback) end
        return
    end

    bom_pvp_hud.state.countdown = seconds
    bom_pvp_hud.state.countdown_active = true

    pcall(function()
        if G and G.CONTROLLER and G.CONTROLLER.locks then
            G.CONTROLLER.locks.enter_pvp = true
        end
    end)

    local function show_next()
        if bom_pvp_hud.state.countdown <= 0 then
            bom_pvp_hud.state.countdown_active = false
            if callback then pcall(callback) end
            pcall(function()
                if G and G.CONTROLLER and G.CONTROLLER.locks then
                    G.CONTROLLER.locks.enter_pvp = nil
                end
            end)
            return true
        end

        pcall(function()
            attention_text({
                text = tostring(bom_pvp_hud.state.countdown),
                scale = 5,
                hold = 0.85,
                align = "cm",
                major = G.play,
            })
            if play_sound then play_sound("tarot2", 1, 0.4) end
        end)

        bom_pvp_hud.state.countdown = bom_pvp_hud.state.countdown - 1

