    G.FUNCS.bom_toggle_ready_blind = function(e)
        if not bom_match or not bom_match.is_in_match() then return end

        local on_deck = G.GAME.blind_on_deck or "Boss"
        local rr = G.GAME.round_resets
        local pvp_slot = rr and rr.pvp_blind_choices and rr.pvp_blind_choices[on_deck]
        if not pvp_slot and rr and bom_match.is_blind_pvp then
            local btype = on_deck == "Boss" and "L" or on_deck == "Big" and "B" or "S"
            pvp_slot = bom_match.is_blind_pvp(rr.ante or 1, btype)
        end
        if G.STATE ~= G.STATES.BLIND_SELECT or not pvp_slot then
            mp_log.debug("BOM_PVP_HUD", "ready toggle ignored -- not on a PvP blind select")
            return
        end

        local now = love.timer.getTime()
        if bom_pvp_hud._last_ready_toggle and (now - bom_pvp_hud._last_ready_toggle) < 0.8 then
            return
        end

        if G.GAME.mp_blind_ready and bom_pvp_hud._ready_lock_until and now < bom_pvp_hud._ready_lock_until then
            return
        end

        bom_pvp_hud._last_ready_toggle = now

        G.GAME.mp_blind_ready = not G.GAME.mp_blind_ready
        G.GAME.mp_blind_ready_text = G.GAME.mp_blind_ready and mod_loc("Unready") or mod_loc("Ready")

        if G.GAME.mp_blind_ready then
            bom_pvp_hud._ready_lock_until = now + 1.25
        else
            bom_pvp_hud._ready_lock_until = nil
        end

        pcall(function()
            if G.GAME.mp_blind_ready and e then
                bom_pvp_hud._pending_blind_context = e
            end
        end)

        if G.GAME.mp_blind_ready then
            bom_match.send_location("loc_ready")
            pcall(function()
                local deck = G.GAME and G.GAME.blind_on_deck
                bom_core.send({ type = "ready_blind", ante = G.GAME and G.GAME.round_resets and G.GAME.round_resets.ante,
                    blind = deck == "Small" and "S" or deck == "Big" and "B" or "L" })
            end)
        else
            bom_match.send_location("loc_selecting")
            pcall(function()
                bom_core.send({ type = "unready_blind" })
            end)
        end
    end


    local _hud_mp_patched_ref = nil
    function bom_pvp_hud.patch_run_hud_for_mp()
        if not G or not G.GAME or not G.HUD then return end
        if not bom_match or not bom_match.is_in_match() then return end
        pcall(function()
            local ante_elem = G.HUD:get_UIE_by_ID("ante_UI_count")
            if ante_elem and ante_elem.config and ante_elem.config.object then
                local dyna = ante_elem.config.object
                if dyna.config and dyna.config.string and dyna.config.string[1]
                    and type(dyna.config.string[1]) == "table"
                    and dyna.config.string[1].ref_value ~= "mp_lives" then
                    dyna.config.string[1].ref_table = G.GAME
                    dyna.config.string[1].ref_value = "mp_lives"
                end
            end
        end)
        if _hud_mp_patched_ref == G.GAME then return end
        _hud_mp_patched_ref = G.GAME
        pcall(function()
            local hud_ante = G.HUD:get_UIE_by_ID("hud_ante")
            if hud_ante and hud_ante.children then
                local label_row = hud_ante.children[1]
                if label_row and label_row.children and label_row.children[1] then
                    local label = label_row.children[1]
                    if label.config and label.config.text then
                        label.config.text = mod_loc("Lives")
                        if label.config.text_drawable then
                            label.config.text_drawable:set(mod_loc("Lives"))
                        end
                    end
                end
            end
        end)
        pcall(function()
            local ante_elem = G.HUD:get_UIE_by_ID("ante_UI_count")
            if ante_elem and ante_elem.parent and ante_elem.parent.children then
                local found_ante = false
                for _, sibling in ipairs(ante_elem.parent.children) do
                    if found_ante and sibling.config then
                        sibling.config.ref_table = nil
                        sibling.config.ref_value = nil
                        sibling.config.text = ""
                        sibling.config.colour = {0,0,0,0}
                        if sibling.config.text_drawable then
                            sibling.config.text_drawable:set("")
                        end
                    end
                    if sibling == ante_elem then
                        found_ante = true
                    end
                end
            end
        end)
    end

