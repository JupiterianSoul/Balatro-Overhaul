function bom_pvp_hud.on_start_blind()
    bom_pvp_hud._pvp_finished_token = nil
    pcall(function()
        if G and G.GAME then
            G.GAME.mp_blind_ready = false
            G.GAME.mp_blind_ready_text = mod_loc("Ready")
            G.GAME.mp_opponent_blind_ready = false
        end
        bom_pvp_hud._ready_lock_until = nil
        bom_pvp_hud._last_ready_toggle = nil
    end)

    local function begin_pvp_blind()
        bom_pvp_hud._pvp_blind_starting = true
        pcall(function()
            local ctx = bom_pvp_hud._pending_blind_context
            if not ctx and G and G.STATE == G.STATES.BLIND_SELECT and G.blind_select_opts and G.GAME.blind_on_deck then
                local opt = G.blind_select_opts[string.lower(G.GAME.blind_on_deck)]
                ctx = opt and opt:get_UIE_by_ID("select_blind_button") or nil
            end
            if ctx and G and G.FUNCS and G.FUNCS.select_blind then
                G.FUNCS.select_blind(ctx)
            end
            bom_pvp_hud._pending_blind_context = nil
        end)
        if G and G.E_MANAGER then
