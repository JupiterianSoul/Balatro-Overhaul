function bom_pvp_hud.reset_blind_hud()
    if not G or not G.GAME or not G.HUD_blind then return end

    pcall(function()
        local blind_name = G.HUD_blind:get_UIE_by_ID("HUD_blind_name")
        if blind_name and blind_name.config and blind_name.config.object and G.GAME.blind then
            blind_name.config.object.config.string = { { ref_table = G.GAME.blind, ref_value = "loc_name" } }
            blind_name.config.object:update_text()
        end

        local blind_count = G.HUD_blind:get_UIE_by_ID("HUD_blind_count")
        if blind_count and G.GAME.blind then
            blind_count.config.ref_table = G.GAME.blind
            blind_count.config.ref_value = "chip_text"
            blind_count.config.func = nil
        end

        local blind_root = G.HUD_blind:get_UIE_by_ID("HUD_blind")
        if blind_root
            and blind_root.children and blind_root.children[2]
            and blind_root.children[2].children and blind_root.children[2].children[2]
            and blind_root.children[2].children[2].children and blind_root.children[2].children[2].children[2] then
            local content = blind_root.children[2].children[2].children[2].children
            if content[1] and content[1].children and content[1].children[1] then
                content[1].children[1].config.text = mod_loc("Score at least")
            end
            if content[3] and content[3].children and content[3].children[1] then
                content[3].children[1].config.text = mod_loc("Reward")
                if bom_pvp_hud.state.bottom_label_node == content[3].children[1] then
                    content[3].children[1].config.colour = G.C.WHITE
                end
            end
            if bom_pvp_hud.state.bottom_label_node then pcall(function() G.HUD_blind:recalculate() end) end
            bom_pvp_hud.state.bottom_label_node = nil
        end

        local dollars = G.HUD_blind:get_UIE_by_ID("dollars_to_be_earned")
        if dollars and dollars.config and dollars.config.object and G.GAME.current_round then
            dollars.config.object.config.string = { { ref_table = G.GAME.current_round, ref_value = "dollars_to_be_earned" } }
            dollars.config.object:update_text()
        end
    end)

    bom_pvp_hud.state.blind_hud_active = false
    if bom_ui and bom_ui.board_hide then pcall(bom_ui.board_hide) end
end

function bom_pvp_hud.send_start_hands()
    if not (G and G.GAME and G.STATES) then return end
    if bom_party and bom_party.active and bom_party.active() then return end
    local cr = G.GAME.current_round
    if not cr or (tonumber(cr.hands_played) or 0) > 0 then return end
    local st = bom_pvp_hud.state
    local token = get_blind_token()
    local final = G.STATE == G.STATES.SELECTING_HAND
    if st.start_hands_token == token and (st.start_hands_final or not final) then return end
    local hands
    if final then
        hands = tonumber(cr.hands_left)
    else
        local rr = G.GAME.round_resets or {}
        local bonus = G.GAME.round_bonus and tonumber(G.GAME.round_bonus.next_hands) or 0
        hands = math.max(1, (tonumber(rr.hands) or 4) + bonus)
    end
    if not hands then return end
    local same = st.start_hands_token == token and st.start_hands_sent == hands
    st.start_hands_token, st.start_hands_final = token, final
    if same then return end
    st.start_hands_sent = hands
    bom_match.send_play_hand(0, hands)
end

function bom_pvp_hud.juice_up_pvp_hud()
    pcall(function()
        if bom_match and bom_match.is_pvp_blind and bom_match.is_pvp_blind() and G and G.HUD_blind then
            local blind_count = G.HUD_blind:get_UIE_by_ID("HUD_blind_count")
            local dollars = G.HUD_blind:get_UIE_by_ID("dollars_to_be_earned")
            if blind_count and blind_count.juice_up then blind_count:juice_up() end
            if dollars and dollars.juice_up then dollars:juice_up() end
        end
    end)
end

