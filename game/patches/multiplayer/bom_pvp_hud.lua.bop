                    if (state.mode == "ascension" or state.mode == "race") and not state.match_over and bom_ui and bom_ui.show_ascension_wait then
                        bom_ui.show_ascension_wait()
                    elseif bom_match.end_match then
                        bom_match.end_match("lose", was_pvp and "pvp_loss" or "blind_loss")
                    end
                    _eliminated = true
                end
            end
        end)

        if _eliminated then
            pcall(function()
                if G and G.GAME then G.GAME.mp_blind_loss_pending = false end
            end)
            return
        end

        pcall(function()
            local pay = tonumber(G.GAME.current_round.dollars) or 0
            if pay ~= 0 then ease_dollars(pay) end
            mp_log.info("BOM_PVP_HUD", "lose_life cash out: $%s", tostring(pay))
        end)

