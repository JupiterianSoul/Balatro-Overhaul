    end


    function bom_ui.update_lobby_ready()
        pcall(function()
            if G and G.OVERLAY_MENU and G.OVERLAY_MENU ~= G.BOM_LOBBY_OVERLAY then return end
            if not (G.STAGE == G.STAGES.MAIN_MENU and bom_match.get_phase() == bom_match.PHASE.LOBBY) then return end
            if G and G.GAME and G.GAME.bom_quick_match then
                bom_ui.show_quick_match_lobby()
            else
                bom_ui.show_lobby()
            end
        end)
    end

    function bom_ui.update_lobby_settings()
        pcall(function()
            if G and G.GAME and G.GAME.bom_quick_match then return end
            local box = G.BOM_LOBBY_OVERLAY
            if not box or G.OVERLAY_MENU ~= box then return end
            local state = bom_match and bom_match.get_state and bom_match.get_state() or {}
            local s = state.settings or {}
            if (bom_match.joker_picks and bom_match.joker_picks(s) or 0) ~= (bom_ui._lobby_per_player or 0) then
                bom_ui.show_lobby()
                return
            end
            if (bom_match.different_decks(s) and true or false) ~= (bom_ui._lobby_diff_decks and true or false) then
                bom_ui.show_lobby()
                return
            end
            local rl = box:get_UIE_by_ID('bom_lobby_rules')
            local rl2 = box:get_UIE_by_ID('bom_lobby_rules2')
            local want, want2
            if rl2 and bom_ui._lobby_rules_halves then
                want, want2 = bom_ui._lobby_rules_halves(s)
            else
                want = bom_ui._lobby_rules_line and bom_ui._lobby_rules_line(s)
            end
            if rl and want and rl.config.text ~= want then
                rl.config.text = want
                if rl.config.text_drawable then rl.config.text_drawable:set(want) end
                box:recalculate()
            end
            if rl2 and want2 and rl2.config.text ~= want2 then
                rl2.config.text = want2
                if rl2.config.text_drawable then rl2.config.text_drawable:set(want2) end
                box:recalculate()
            end
            local mode_name = "Rivals"
            pcall(function()
                local gm = bom_gamemodes.get(s.mode or "nemesis")
                if gm and gm.display_name then mode_name = gm.display_name end
            end)
            mode_name = mod_loc(mode_name)
            local el = box:get_UIE_by_ID('bom_lobby_mode')
            if el and el.config and el.config.text ~= mode_name then
                el.config.text = mode_name
                if el.config.text_drawable then el.config.text_drawable:set(mode_name) end
                box:recalculate()
            end
        end)
    end
end

return M
end
