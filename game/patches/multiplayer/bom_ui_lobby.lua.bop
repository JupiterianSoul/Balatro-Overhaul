                pcall(function()
                    if bom_match and bom_match.get_state then
                        state = bom_match.get_state()
                    end
                end)
                state.settings = state.settings or {}
                local ph = state.phase
                if G.STAGE == G.STAGES.RUN and (ph == "starting" or ph == "playing" or ph == "pvp_blind" or ph == "pvp_resolve") then return true end

                local is_host = state.is_host

                local LS = 1.4

