    end

    local function _forget_mp_overlay(ref_name)
        local overlay = G and G[ref_name]
        if not overlay then return end
        if G.OVERLAY_MENU ~= overlay then pcall(function() overlay:remove() end) end
        G[ref_name] = nil
    end

    local function _hide_mp_overlay(ref_name)
        if not G then return end
        local overlay = G[ref_name]
        if overlay then
            if G.OVERLAY_MENU == overlay and G.FUNCS and G.FUNCS.exit_overlay_menu then
                pcall(function() G.FUNCS.exit_overlay_menu() end)
            else
                pcall(function() overlay:remove() end)
            end
            G[ref_name] = nil
        end
    end


    local function _sep()
        return { n = G.UIT.R, config = { align = "cm", minh = 0.02,
            minw = (rawget(_G, "UIK") and UIK.portrait() and 7.6 or 9.8), colour = G.C.L_BLACK, padding = 0.02 }, nodes = {} }
    end


    local function _is_host()
        local ok, result = pcall(function()
            return bom_match and bom_match.is_host_player()
        end)
        return ok and result
    end


    local function disableable_option_cycle(args)
        local enabled = _is_host()
        local raw_options = args.options or {}
        local options = {}
        for i, v in ipairs(raw_options) do
            options[i] = type(v) == "string" and v or tostring(v)
        end

        local function _normalize_cycle_value(value)
            if value == nil then return nil end
            local s = tostring(value):lower()
            s = s:gsub("[%s_%-%./]+", "")
            s = s:gsub("^gamemode", "")
            s = s:gsub("^mp", "")
            s = s:gsub("deck$", "")
            s = s:gsub("stake$", "")
            s = s:gsub("lives$", "")
            return s
        end

        local current_option = args.current_option or 1

        local numeric_index = tonumber(current_option)
        if numeric_index and options[numeric_index] ~= nil then
            current_option = numeric_index
        else
            local wanted = _normalize_cycle_value(current_option)
            local matched_index = nil
            for i, v in ipairs(options) do
                local candidate = _normalize_cycle_value(v)
                if tostring(v) == tostring(current_option)
                    or tostring(i) == tostring(current_option)
                    or (wanted and candidate == wanted) then
                    matched_index = i
                    break
                end
            end
            current_option = matched_index or 1
        end

        current_option = tonumber(current_option) or 1
        if current_option < 1 then current_option = 1 end
        if #options > 0 and current_option > #options then current_option = 1 end

        return create_option_cycle({
            id = args.id,
            label = args.label,
            scale = args.scale or 0.8,
            options = options,
            current_option = current_option,
            opt_callback = enabled and args.opt_callback or nil,
            colour = enabled and (args.colour or G.C.RED) or G.C.BLACK,
            no_pips = args.no_pips,
            w = args.w or 4,
            info = args.info,
        })
    end



    local function update_setting(key, value)
        pcall(function()
            if bom_room and bom_room.update_setting then
                bom_room.update_setting(key, value)
            end
        end)
    end


