local bom_nemesis = {
    initialized = false,
}


local BLIND_COL_KEYS = {
    "tooth", "small", "big", "hook", "ox",
    "house", "wall", "wheel", "arm", "club",
    "fish", "psychic", "goad", "water", "window",
    "manacle", "eye", "mouth", "plant", "serpent",
    "pillar", "needle", "head", "flint", "mark",
}

function bom_nemesis.blind_col_numtokey(num)
    num = tonumber(num) or 1
    if num < 1 or num > #BLIND_COL_KEYS then num = 1 end
    return "bl_" .. BLIND_COL_KEYS[num]
end

local function party_kind()
    local k = nil
    pcall(function() k = bom_party_run and bom_party_run.kind() end)
    return k
end
bom_nemesis.party_kind = party_kind

function bom_nemesis.debuff_lines()
    if party_kind() then return bom_party_run.hud_desc() end
    return { "Score more points than", "your opponent to win!" }
end

function bom_nemesis.fill_debuff_lines(b)
    if not (b and party_kind()) then return end
    local lines = bom_party_run.hud_desc()
    if type(b.loc_debuff_lines) ~= "table" then b.loc_debuff_lines = {"", ""} end
    b.loc_debuff_lines[1] = lines[1] or ""
    b.loc_debuff_lines[2] = lines[2] or ""
end

function bom_nemesis.chip_atlas(key)
    local b = key and G.P_BLINDS and G.P_BLINDS[key]
    return G.ANIMATION_ATLAS and (G.ANIMATION_ATLAS[b and b.atlas or "blind_chips"] or G.ANIMATION_ATLAS.blind_chips)
end

function bom_nemesis.get_nemesis_key()
    if party_kind() then
        local art = bom_party_run.art_key()
        if art then return art end
    end
    local opp_col = 1
    pcall(function()
        local state = bom_match and bom_match.get_state()
        if state and state.opp_blind_col then
            opp_col = state.opp_blind_col
        end
    end)

    local ret = (G.P_BLINDS and G.P_BLINDS.bl_mp_nemesis) and "bl_mp_nemesis" or bom_nemesis.blind_col_numtokey(opp_col)

    pcall(function()
        local my_lives = bom_match and bom_match.get_my_lives() or 99
        local opp_lives = bom_match and bom_match.get_opp_lives() or 99
        if my_lives <= 1 and opp_lives <= 1 then
            if G.STATE ~= G.STATES.ROUND_EVAL then
                if G.P_BLINDS and G.P_BLINDS["bl_final_heart"] then
                    ret = "bl_final_heart"
                end
            end
        end
    end)

    return ret
end

function bom_nemesis.get_opponent_username()
    if party_kind() then return bom_party_run.name() end
    local name = "Opponent"
    pcall(function()
        local state = bom_match and bom_match.get_state()
        if state and state.opp_name then name = state.opp_name end
    end)
    return name
end


local function ensure_blind_registered()
    if not G or not G.P_BLINDS then return end
    if G.P_BLINDS["bl_mp_nemesis"] then return end

    local base = G.P_BLINDS["bl_big"] or G.P_BLINDS["bl_small"] or {}
    if G.ANIMATION_ATLAS and G.ANIMATION_ATLAS.mp_nemesis_chip then base = { atlas = "mp_nemesis_chip", pos = { x = 0, y = 0 } } end
    G.P_BLINDS["bl_mp_nemesis"] = {
        key = "bl_mp_nemesis",
        name = "bl_mp_nemesis",
        loc_name = "Rival Blind",
        dollars = 5,
        mult = 1,
        boss = { min = 1, max = 10 },
        blind_types = { "boss" },
        boss_colour = (G.C and (G.C.MULT or G.C.RED)) or { 1, 0, 0, 1 },
        atlas = base.atlas or "blind_chips",
        pos = base.pos or { x = 0, y = 0 },
        discovered = true,
        order = 1000,
        no_collection = true,
        debuff = {},
        loc_debuff_text = {
            "Score more points than",
            "your opponent to win!",
        },
        in_pool = function() return false end,
    }

    pcall(function()
        if G.localization and G.localization.descriptions and G.localization.descriptions.Blind then
            local entry = {
                name = "The Rival",
                text = {"Score more points than", "your opponent to win!"},
            }
            if loc_parse_string then
                entry.text_parsed = {}
                for _, line in ipairs(entry.text) do
                    entry.text_parsed[#entry.text_parsed+1] = loc_parse_string(line)
                end
                entry.name_parsed = {}
                entry.name_parsed[1] = loc_parse_string(entry.name)
            end
            G.localization.descriptions.Blind["bl_mp_nemesis"] = entry
        end
    end)

    mp_log.info("BOM_NEMESIS", "registered bl_mp_nemesis")

    if G.GAME then
        G.GAME.banned_keys = G.GAME.banned_keys or {}
        G.GAME.banned_keys["bl_mp_nemesis"] = true
        G.GAME.bosses_used = G.GAME.bosses_used or {}
        G.GAME.bosses_used["bl_mp_nemesis"] = G.GAME.bosses_used["bl_mp_nemesis"] or 0
    end
end

function bom_nemesis.ensure_registered()
    ensure_blind_registered()
end


function bom_nemesis.in_unresolved_pvp_blind()
    if not G or not G.GAME or not G.GAME.multiplayer or not G.GAME.blind then return false end
    local b = G.GAME.blind
    if b.mp_pvp_over then return false end
    if b.pvp then return true end
    if not G.GAME.facing_blind then return false end
    if not (bom_match and bom_match.is_in_match and bom_match.is_in_match()) then return false end
    local key = b.config and b.config.blind and b.config.blind.key
    if key ~= "bl_mp_nemesis" then return false end
    local slot = G.GAME.blind_on_deck or "Boss"
    local code = (slot == "Small" and "S") or (slot == "Big" and "B") or "L"
    local ante = (G.GAME.round_resets and G.GAME.round_resets.ante) or 1
    if not bom_match.is_blind_pvp(ante, code) then return false end
    b.pvp = true
    mp_log.warn("BOM_NEMESIS", "pvp flag was lost during the PvP blind (ante %s %s), restored", tostring(ante), code)
    return true
end

function bom_nemesis.is_pvp_boss()
    if not G or not G.GAME or not G.GAME.multiplayer then return false end
    return G.GAME.blind and G.GAME.blind["pvp"] or false
end


function bom_nemesis.boss_effect_key()
    local g = G and G.GAME and G.GAME.mp_pvp_boss
    local ante = G and G.GAME and G.GAME.round_resets and G.GAME.round_resets.ante
    if type(g) == "table" and g.ante == ante and G.P_BLINDS and G.P_BLINDS[g.key] then return g.key end
    return nil
end

function bom_nemesis.boss_effect_lines(key)
    local bb = G.P_BLINDS[key]
    local name, lines = bb.name, {}
    pcall(function()
        local n = localize{type = 'name_text', key = key, set = 'Blind'}
        if n and n ~= "ERROR" then name = n end
        local vars = bb.vars
        if bb.name == 'The Ox' then vars = {localize(G.GAME.current_round.most_played_poker_hand, 'poker_hands')} end
        lines = localize{type = 'raw_descriptions', key = key, set = 'Blind', vars = vars} or {}
    end)
    local l1 = lines[1] or ''
    if bb.name ~= 'The Wheel' then l1 = name .. ": " .. l1 end
    return l1, lines[2] or '', name, lines[1] or ''
end

function bom_nemesis.keep_boss_effect(b, key)
    local bb = key and G.P_BLINDS[key]
    if not (b and bb) then return end
    b.name = bb.name
    b.disabled = false
    b.mp_pvp_boss = key
    if type(b.debuff) ~= "table" or next(b.debuff) == nil then
        b.debuff = {}
        for k, v in pairs(bb.debuff or {}) do b.debuff[k] = v end
    end
    local l1, l2, bname, r1 = bom_nemesis.boss_effect_lines(key)
    b.loc_name = bname
    if type(b.loc_debuff_lines) ~= "table" then b.loc_debuff_lines = {"", ""} end
    b.loc_debuff_lines[1], b.loc_debuff_lines[2] = l1, l2
    b.loc_debuff_text = r1 .. (l2 ~= "" and (" " .. l2) or "")
end

function bom_nemesis.apply_current_blind(blind_obj)
    if not G or not G.GAME or not G.GAME.multiplayer then return end
    if not bom_nemesis.is_pvp_boss() then return end

    blind_obj = blind_obj or G.GAME.blind
    if not blind_obj or not blind_obj.config then return end

    ensure_blind_registered()

    local nemesis_blind = G.P_BLINDS and G.P_BLINDS["bl_mp_nemesis"]
    if nemesis_blind then
        blind_obj.config.blind = nemesis_blind
    end

    blind_obj.pvp = true
    blind_obj.boss = true
    blind_obj.name = "bl_mp_nemesis"
    blind_obj.loc_name = bom_nemesis.get_opponent_username()
    blind_obj.disabled = true
    blind_obj.debuff = {}
    blind_obj.loc_debuff_text = bom_nemesis.debuff_lines()
    bom_nemesis.fill_debuff_lines(blind_obj)
    local bk = bom_nemesis.boss_effect_key()
    if bk then bom_nemesis.keep_boss_effect(blind_obj, bk) end
end


