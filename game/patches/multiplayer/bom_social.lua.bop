        {n = G.UIT.R, config = {align = "cm", padding = 0.1}, nodes = {txt(L("LOBBY INVITE"), 0.6, G.C.GOLD)}},
        {n = G.UIT.R, config = {align = "cm", padding = 0.1}, nodes = {
            {n = G.UIT.T, config = {text = msg, scale = 0.42, colour = G.C.UI.TEXT_LIGHT, shadow = true, maxw = 9}},
        }},
