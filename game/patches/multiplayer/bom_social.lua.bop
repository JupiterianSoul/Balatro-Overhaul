local B = {}

local MPS = require("multiplayer.mps_state")
local MPS_F = require("multiplayer.mps_friends")
local MPS_N = require("multiplayer.mps_notify")
local MPS_C = require("multiplayer.mps_chat")

local function L(s) return mod_loc and mod_loc(s) or s end

local POLL_SECS = 15
local INVITE_SECS = 120
local BUBBLE_SECS = 3
local MAX_BUBBLES = 4
local HELLO_RETRY_SECS = 30

B.S = {
    code = nil, friends = {}, requests = {}, sent = {}, note = nil, note_bad = false,
    input = {code = ""}, page = 1, from = "mp", hello = false, poll = 0, invite = nil, bubbles = {},
}
local S = B.S

local REASON_TEXT = {
    bad_code = "Player not found.", not_found = "Player not found.", self = "That is you.",
    already = "You are already friends.", already_sent = "Request already sent.", full = "Your friends list is full.",
    their_list_full = "Their friends list is full.", slow_down = "Too fast, try again in a moment.",
    offline = "Friend is offline.", busy = "Friend is in a match.", no_room = "Open a lobby first.",
    not_friend = "Not on your friends list.", no_key = "Could not connect.",
}

local function profile_name()
    local p = G.PROFILES and G.SETTINGS and G.PROFILES[G.SETTINGS.profile]
    return p and p.name or nil
end

local function connected()
    return bom_core and bom_core.is_connected and bom_core.is_connected()
end

local function window_open()
    return G.OVERLAY_MENU and UIK and UIK._win and UIK._win.id == "social" and G.OVERLAY_MENU:get_UIE_by_ID("uik_body")
end

local function send(msg)
    if not connected() then
        S.note, S.note_bad = L("Could not connect."), true
        return false
    end
    return bom_core.send(msg)
end

local function refresh()
    if not window_open() then return end
    MPS_F.refresh()
end

local function say_hello()
    S.hello = true
    bom_core.send({type = "social_hello", pkey = bom_core.player_key(), name = profile_name(), hidden = G.SETTINGS and G.SETTINGS.social_hidden == true})
end

local function ensure_connected()
    if connected() then
        if not S.hello then say_hello() end
        return
    end
    bom_core.connect(function() say_hello() end, {silent = true, on_fail = function()
        S.note, S.note_bad = L("Could not connect."), true
        refresh()
    end})
end

local function txt(str, scale, colour)
    return {n = G.UIT.T, config = {text = tostring(str), scale = scale, colour = colour or G.C.WHITE, shadow = true}}
end

function B.open(from, tab)
    S.from = from or "mp"
    S.note = nil
    S.poll = 0
    MPS_F.open(tab)
    ensure_connected()
    if connected() and S.hello then send({type = "social_list"}) end
end

B.ensure_online = function() ensure_connected() end

function B.bell_count()
    return tonumber(MPS.S.notify.unread) or 0
end

local function back_to_origin()
    if S.from == "lobby" and bom_ui and bom_ui.show_lobby then return bom_ui.show_lobby() end
    if S.from == "party" and bom_party and bom_party.show_lobby then return bom_party.show_lobby() end
    if S.from == "run" then
        local again = S.run_back
        S.run_back = nil
        if again then return again() end
        return G.FUNCS.exit_overlay_menu()
    end
    local menu = rawget(_G, "mpm_menu")
    if menu and menu.active and G.OVERLAY_MENU then return G.FUNCS.exit_overlay_menu() end
    G.FUNCS.open_multiplayer_menu()
end
B.back_to_origin = function() back_to_origin() end

local function open_emotes(from)
    S.from = from
    if bom_emotes and bom_emotes.open_picker then
        bom_emotes.open_picker({back = "social_back", after = back_to_origin})
    end
end

local function remove_bubble(entry)
    pcall(function() entry.box:remove() end)
end

local function layout_bubbles()
    for i, entry in ipairs(S.bubbles) do
        entry.box.alignment.offset.y = 0.4 + (i - 1) * 1.05
        entry.box:align_to_major()
    end
end

function B.show_bubble(name, label)
    if not (G and G.ROOM_ATTACH) then return end
    if #S.bubbles >= MAX_BUBBLES then
        remove_bubble(table.remove(S.bubbles, 1))
    end
    local inner = {
        {n = G.UIT.R, config = {align = "cm"}, nodes = {
            {n = G.UIT.T, config = {text = tostring(name ~= "" and name or L("Player")), scale = 0.3, colour = G.C.ORANGE}},
        }},
        {n = G.UIT.R, config = {align = "cm"}, nodes = {
            {n = G.UIT.T, config = {text = label, scale = 0.42, colour = G.C.BLACK}},
        }},
    }
    local box = UIBox{
        definition = {n = G.UIT.ROOT, config = {align = "cm", minh = 0.8, r = 0.2, padding = 0.05, colour = G.C.JOKER_GREY, shadow = true}, nodes = {
            {n = G.UIT.C, config = {align = "cm", minh = 0.7, minw = 2.4, r = 0.16, padding = 0.08, colour = G.C.WHITE}, nodes = inner},
        }},
        config = {align = "tm", offset = {x = 0, y = 0.4}, major = G.ROOM_ATTACH, instance_type = "ALERT"},
    }
    box.states.collide.can = false
    S.bubbles[#S.bubbles + 1] = {box = box, until_t = love.timer.getTime() + BUBBLE_SECS}
    layout_bubbles()
    if play_sound then pcall(play_sound, "card1", 1.2, 0.5) end
end

local function show_invite()
    local inv = S.invite
    S.invite_open = inv
    S.invite = nil
    local msg = L("{name} invites you to their lobby."):gsub("{name}", function() return tostring(inv.name ~= "" and inv.name or inv.from or "?") end)
