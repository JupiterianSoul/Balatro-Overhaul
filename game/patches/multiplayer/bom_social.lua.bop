            UIBox_button({button = "social_invite_join", label = {L("Join")}, colour = G.C.GREEN, minw = 3, minh = 0.9, scale = 0.45, col = true}),
            {n = G.UIT.C, config = {align = "cm", minw = 0.25}, nodes = {}},
            UIBox_button({button = "social_invite_later", label = {L("Later")}, colour = G.C.RED, minw = 3, minh = 0.9, scale = 0.45, col = true}),
        }},
    }})}
end

local function can_show_invite()
    if not (G and G.STAGES and G.STAGE == G.STAGES.MAIN_MENU) then return false end
    return not (bom_match and bom_match.get_phase and bom_match.get_phase() ~= bom_match.PHASE.NONE)
end

local function apply_list(d)
    S.friends = type(d.friends) == "table" and d.friends or {}
    S.requests = type(d.requests) == "table" and d.requests or {}
    S.sent = type(d.sent) == "table" and d.sent or {}
end

function B.on_message(d)
    local t = d.type
    local so, st = rawget(_G, "social_online"), rawget(_G, "social_toasts")
    if t == "social_me" and so and so.on_hello then pcall(so.on_hello) end
    if st and st.on_message then pcall(st.on_message, d) end
    if t == "social_me" then
        S.code = d.code
        MPS.on_hello()
    elseif t == "social_list" then
        apply_list(d)
    elseif t == "social_result" then
        if d.ok then
            S.note_bad = false
            if d.action == "social_add" then
                S.input.code = ""
                S.note = L("Request sent.")
            elseif d.action == "social_invite" then
                S.note = L("Invite sent.")
            else
                S.note = nil
            end
        else
            S.note_bad = true
            if d.action == "social_hello" then
                S.hello = false
                S.hello_at = love.timer.getTime() + HELLO_RETRY_SECS
            end
            if d.reason == "offline" and d.action ~= "social_invite" then
                S.note = L("Could not connect.")
            else
                S.note = L(REASON_TEXT[d.reason] or "Could not connect.")
            end
        end
    elseif t == "social_invite" then
        if type(d.room) == "string" then
            local inv = {name = tostring(d.name or ""), from = d.from, room = d.room, party = d.party == true, until_t = love.timer.getTime() + INVITE_SECS}
            if not (st and st.invite and st.invite(inv)) then S.invite = inv end
        end
    elseif t == "social_emote" then
        if bom_emotes and bom_emotes.on_message then bom_emotes.on_message(d) end
        return
    end
    MPS.on_social(d)
end

local function in_match_run()
    if bom_playback and bom_playback.active() then return false end
    return G and G.STAGES and G.STAGE == G.STAGES.RUN and bom_match and bom_match.is_in_match and bom_match.is_in_match()
end

local function update_match_button()
    local want = in_match_run()
    if S.match_button and S.match_button.REMOVED then S.match_button = nil end
    if want and not S.match_button then
        S.match_button = UIBox{
            definition = {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR}, nodes = {
                UIBox_button({button = "social_emote_open_run", label = {L("Emote")}, colour = G.C.BLUE,
                    minw = 1.5, minh = UIK and UIK.touch() and 0.8 or 0.6, scale = UIK and UIK.touch() and 0.4 or 0.34}),
            }},
            config = {align = "cri", offset = {x = -0.15, y = -0.4}, major = G.ROOM_ATTACH},
        }
    elseif not want and S.match_button then
        pcall(function() S.match_button:remove() end)
        S.match_button = nil
    end
end

function B.update()
    local now = love.timer.getTime()
    if not connected() then
        S.hello = false
    elseif not S.hello and now >= (S.hello_at or 0) then
        say_hello()
    end
    if connected() and window_open() and now >= S.poll then
        S.poll = now + POLL_SECS
        if S.hello then send({type = "social_list"}) end
    end
    for i = #S.bubbles, 1, -1 do
        if now >= S.bubbles[i].until_t then
            remove_bubble(table.remove(S.bubbles, i))
            layout_bubbles()
        end
    end
    if S.invite then
        if now >= S.invite.until_t then
            S.invite = nil
        elseif can_show_invite() then
            show_invite()
        end
    end
    update_match_button()
    local so, st = rawget(_G, "social_online"), rawget(_G, "social_toasts")
    local sm = rawget(_G, "social_mg")
    local sx = rawget(_G, "social_more")
    if sx and sx.update then pcall(sx.update) end
    if so and so.update then pcall(so.update) end
    if st and st.update then pcall(st.update) end
    if sm and sm.update then pcall(sm.update) end
    MPS.tick()
    MPS_F.tick()
    MPS_C.tick()
end

function B.lobby_buttons(scale, from, grid)
    if grid then
        return {
            UIBox_button({label = {L("Friends")}, button = from == "party" and "social_open_party" or "social_open_lobby",
                minw = grid.w, minh = grid.h, maxw = grid.w - 0.3, colour = G.C.GREEN, scale = grid.scale, col = true}),
            UIBox_button({label = {L("Emote")}, button = from == "party" and "social_emote_open_party" or "social_emote_open_lobby",
                minw = grid.w, minh = grid.h, maxw = grid.w - 0.3, colour = G.C.BLUE, scale = grid.scale, col = true}),
            MPS_C.live_button(UIBox_button({label = {L("Chat")}, button = from == "party" and "mps_chat_open_party" or "mps_chat_open_lobby",
                minw = grid.w, minh = grid.h, maxw = grid.w - 0.3, colour = G.C.ORANGE, scale = grid.scale, col = true})),
        }
    end
    return {
        {n = G.UIT.C, config = {minw = 0.2}},
        UIBox_button({label = {L("Friends")}, button = from == "party" and "social_open_party" or "social_open_lobby",
            minw = 2.4*scale, minh = 0.7*scale, colour = G.C.GREEN, scale = 0.45*scale, col = true}),
        {n = G.UIT.C, config = {minw = 0.2}},
        UIBox_button({label = {L("Emote")}, button = from == "party" and "social_emote_open_party" or "social_emote_open_lobby",
            minw = 2.4*scale, minh = 0.7*scale, colour = G.C.BLUE, scale = 0.45*scale, col = true}),
        {n = G.UIT.C, config = {minw = 0.2}},
        MPS_C.live_button(UIBox_button({label = {L("Chat")}, button = from == "party" and "mps_chat_open_party" or "mps_chat_open_lobby",
            minw = 2.4*scale, minh = 0.7*scale, colour = G.C.ORANGE, scale = 0.45*scale, col = true})),
    }
end

function B.lobby_button_count() return 3 end

function B.chat_button(from, w)
    return MPS_C.live_button(UIK.button{label = L("Chat"), button = from == "party" and "mps_chat_open_party" or "mps_chat_open_lobby",
        colour = G.C.ORANGE, w = w or 2, id = from == "party" and "party_chat" or "lobby_chat"})
end

