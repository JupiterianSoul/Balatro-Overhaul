function R.on_pack(d)
    S.pack_wait = false
    local items = d.items or {}
    local nodes = {}
    local keep = {}
    for i, it in ipairs(items) do
        local c = R.RARITY_COLOUR[it.rarity] or G.C.BLUE
        local card = col({
            row({txt(L(it.type == "back" and "Sleeve" or (R.SLOT_NAMES[it.type] or it.type)), 0.3, G.C.UI.TEXT_LIGHT)}, {padding = 0.05}),
            row({txt(L(it.name or it.id), 0.38, G.C.WHITE)}, {w = 2.9, padding = 0.08}),
            row({txt(L((it.rarity or ""):gsub("^%l", string.upper)), 0.3, c)}),
            row({txt(it.dupe and ("+" .. tostring(it.xp or 0) .. " " .. L("XP")) or L("NEW"), 0.34, it.dupe and G.C.BLUE or G.C.GOLD)}, {padding = 0.06}),
        }, {w = 3.1, h = 2.2, r = 0.12, colour = G.C.BLACK, emboss = 0.06, padding = 0.08})
        keep[i] = "rk_pack_" .. i
        nodes[#nodes + 1] = {n = G.UIT.C, config = {align = "cm", id = keep[i], padding = 0.06}, nodes = {{n = G.UIT.R, config = {align = "cm", colour = c, r = 0.14, padding = 0.05}, nodes = {card}}}}
    end
    G.FUNCS.mp_ranked_pack_done = function()
        local P = rawget(_G, "mpm_profile")
        if P and P.open then return P.open("progression") end
        G.FUNCS.mp_open_ranked()
    end
    G.FUNCS.mp_ranked_pack_again = function() U.open_pack_flow() end
    local left = S.profile and (S.profile.packs or 0) or 0
    local footer = {UIK.button{label = L("CONTINUE"), button = "mp_ranked_pack_done", colour = G.C.GREEN}}
    if left > 1 then footer[#footer + 1] = UIK.button{label = L("OPEN ANOTHER") .. " (" .. tostring(left - 1) .. ")", button = "mp_ranked_pack_again", colour = G.C.PURPLE} end
    local contents = {
        row({txt(L("RANKED PACK"), 0.8, G.C.PURPLE)}, {padding = 0.1}),
        row({{n = G.UIT.C, config = {align = "cm"}, nodes = nodes}}, {padding = 0.15}),
        row({txt((d.levelUps or 0) > 0 and (L("LEVEL UP!") .. "  " .. L("Ranked Pack") .. " +" .. tostring(d.levelUps)) or " ", 0.36, G.C.GOLD)}),
        UIK.button_bar(footer),
    }
    local art = pack_art()
    if art then table.insert(contents, 1, row({art}, {padding = 0.05})) end
    G.FUNCS.overlay_menu{definition = create_UIBox_generic_options({no_back = true, contents = contents})}
    play_sound("cardFan2", 1, 0.6)
    for i, id in ipairs(keep) do
        ev(0.25 + i * 0.3, function()
            local e = G.OVERLAY_MENU and G.OVERLAY_MENU:get_UIE_by_ID(id)
            if e then e:juice_up(0.4, 0.4) end
            play_sound("card1", 0.9 + i * 0.08, 0.7)
            local it = items[i]
            if it and (it.rarity == "rare" or it.rarity == "legendary") then play_sound(it.rarity == "legendary" and "polychrome1" or "foil1", 1, 0.6) end
        end)
    end
    if G.OVERLAY_MENU then R.fx(G.OVERLAY_MENU, {G.C.WHITE, lighten(G.C.PURPLE, 0.4), lighten(G.C.GOLD, 0.2)}, 1.0, 0.25) end
end

local function listen(t, fn)
    if bom_events and bom_events.register then bom_events.register(t, fn) end
end

local function events()
    if U._listening then return end
    U._listening = true
    listen("searching", function(d)
        if type(d) == "table" and d.ranked and searching() then
            if Q.status ~= "searching" then Q.since = now() end
            Q.status = "searching"
            update_view()
            R.ui_refresh()
            return true
        end
    end)
    listen("ranked_error", function(d)
        if type(d) == "table" and d["for"] == "find_match" then
            Q.status, Q.error, Q.mods = "error", d.code or d.reason, d.mods
            if G.GAME then G.GAME.mp_searching = false end
            update_view()
            R.ui_refresh()
            return true
        end
    end)
    listen("name_refused", function(d)
        if type(d) == "table" and d["for"] == "find_match" and Q.status == "joining" then
            Q.status, Q.error = "error", d.reason == "default" and "name" or d.reason == "bad_name" and "bad_name" or "taken"
            if G.GAME then G.GAME.mp_searching = false end
            update_view()
            R.ui_refresh()
            return true
        end
    end)
    listen("room_ready", function(d)
        if type(d) == "table" and d.ranked and searching() then Q.status = nil end
    end)
end

