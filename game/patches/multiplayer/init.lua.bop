﻿local MP = {}
local function try_require(path)
    local ok, result = pcall(require, path)
    if not ok then
        error("FAILED TO LOAD: " .. path .. "\nReason: " .. tostring(result))
    end
    if type(result) ~= "table" then
        error("BAD RETURN from: " .. path .. "\nGot type: " .. type(result))
    end
    return result
end

