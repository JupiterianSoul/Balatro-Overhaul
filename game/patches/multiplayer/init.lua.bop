function MP.init()
    if MP.daily and MP.daily.load then MP.daily.load() end


    if MP.nemesis and MP.nemesis.init then MP.nemesis.init() end
    if MP.pvp_hud and MP.pvp_hud.init then MP.pvp_hud.init() end
