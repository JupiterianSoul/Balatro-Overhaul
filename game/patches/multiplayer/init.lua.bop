function MP.update(dt)
    if AndroidWS then AndroidWS.poll() end
    if MP.core and MP.core.update then MP.core.update(dt) end
    if MP.ranked and MP.ranked.update then pcall(MP.ranked.update, dt) end
    if MP.social and MP.social.update then pcall(MP.social.update) end
    if MP.emotes and MP.emotes.update then pcall(MP.emotes.update) end
    if MP.ui and MP.ui.pvp_result_tick then pcall(MP.ui.pvp_result_tick) end
    if MP.rejoin and MP.rejoin.update then MP.rejoin.update(dt) end
    if MP.sync and MP.sync.update then MP.sync.update(dt) end
    if MP.custom_objects and MP.custom_objects.update then MP.custom_objects.update(dt) end
    if MP.mode_content and MP.mode_content.update then pcall(MP.mode_content.update) end
    if MP.swap_mode and MP.swap_mode.update then pcall(MP.swap_mode.update) end
    if MP.spectate and MP.spectate.update then pcall(MP.spectate.update) end
    if MP.decks and MP.decks.update then MP.decks.update(dt) end
    if MP.pvp_hud and MP.pvp_hud.ensure_for_current_blind then MP.pvp_hud.ensure_for_current_blind() end
    if MP.party and MP.party.update then pcall(MP.party.update) end
    if MP.replay and MP.replay.update then pcall(MP.replay.update) end
    if MP.replay and MP.replay.tick_after_leave then pcall(MP.replay.tick_after_leave) end
    if MP.playback and MP.playback.update then pcall(MP.playback.update, dt) end
    if MP.match and MP.match.enforce_speed then pcall(MP.match.enforce_speed) end
    if MP.fair and MP.fair.update then pcall(MP.fair.update) end
    if MP.traps and MP.traps.update then pcall(MP.traps.update) end
    if MP.draft and MP.draft.update then pcall(MP.draft.update) end
    if MP.race and MP.race.update then pcall(MP.race.update) end
end
function MP.draw()
    if MP.ui and MP.ui.draw then MP.ui.draw() end
end
function MP.shutdown()
    if MP.rejoin and MP.rejoin.on_shutdown then MP.rejoin.on_shutdown() end
    if MP.core and MP.core.disconnect then MP.core.disconnect() end
    if AndroidWS then AndroidWS.shutdown() end
end
return MP
end
