local R = {}

local function L(s) return mod_loc and mod_loc(s) or s end

R.S = {
    profile = nil, season = nil, catalog = {}, unlocks = {}, equipped = {}, store = nil,
    board = nil, history = nil, pending = nil, seen = {}, badges = {}, asked = {}, want = {},
    error = nil, recovery = nil, restore = {code = ""}, pack = nil, loading = false, last_badge_send = 0,
}
local S = R.S

R.RANKS = {
    {name = "Stone", flavour = "Heavy, plain, and it still counts.", colour = {0.62, 0.62, 0.66, 1}},
    {name = "Bronze", flavour = "Dull until it rings true.", colour = {0.72, 0.47, 0.29, 1}},
    {name = "Silver", flavour = "Smooth talker, smoother hands.", colour = {0.77, 0.80, 0.84, 1}, shader = "voucher"},
    {name = "Gold", flavour = "Pays out at the end of every round.", colour = {0.92, 0.72, 0.25, 1}, shader = "booster"},
    {name = "Platinum", flavour = "Rarer than gold, and it knows it.", colour = {0.85, 0.90, 0.93, 1}, shader = "voucher"},
    {name = "Foiled", flavour = "+50 Chips of pure shine.", colour = {0.60, 0.76, 0.96, 1}, shader = "foil"},
    {name = "Holographic", flavour = "+10 Mult and a soft glow.", colour = {0.94, 0.56, 0.82, 1}, shader = "holo"},
    {name = "Polychromed", flavour = "X1.5 Mult in every colour.", colour = {0.78, 0.62, 1.00, 1}, shader = "polychrome"},
    {name = "Negative", flavour = "+1 slot in the hall of fame.", colour = {0.55, 0.42, 0.75, 1}, shader = "negative"},
    {name = "TRUE JIMBO", flavour = "Jimbo tips his hat. You earned it.", colour = {0.99, 0.64, 0.00, 1}, shader = "jimbo", soul = true},
}
R.TIERS = {"I", "II", "III"}
R.SLOTS = {"badge", "title", "back", "cframe", "jframe", "flame", "burst", "celebration"}
R.SLOT_NAMES = {badge = "Badge", title = "Title", back = "Sleeve", cframe = "Card frame", jframe = "Joker frame", flame = "Scoring flame", burst = "PvP win burst", celebration = "Results celebration"}
R.RARITY_COLOUR = {common = G and G.C and G.C.BLUE or {0, 0.6, 1, 1}, uncommon = G and G.C and G.C.GREEN or {0.3, 0.7, 0.4, 1},
    rare = G and G.C and G.C.RED or {1, 0.3, 0.3, 1}, legendary = G and G.C and G.C.PURPLE or {0.5, 0.4, 0.7, 1}}

function R.rank_name(r, tier)
    local rk = R.RANKS[(tonumber(r) or 0) + 1] or R.RANKS[1]
    local n = L(rk.name)
    if tier and tier > 0 then n = n .. " " .. (R.TIERS[tier] or "") end
    return n
end

function R.rank_colour(r) return (R.RANKS[(tonumber(r) or 0) + 1] or R.RANKS[1]).colour end

local function key()
    return bom_core and bom_core.player_key and bom_core.player_key() or nil
end

function R.send(msg)
    if not (bom_core and bom_core.is_connected and bom_core.is_connected()) then return false end
    msg.pkey = msg.pkey or key()
    return bom_core.send(msg)
end

function R.item(id)
    if not id then return nil end
    return S.catalog[id]
end

local function hex_colour(h)
    if type(h) ~= "string" or #h ~= 6 then return nil end
    local r, g, b = tonumber(h:sub(1, 2), 16), tonumber(h:sub(3, 4), 16), tonumber(h:sub(5, 6), 16)
    if not (r and g and b) then return nil end
    return {r / 255, g / 255, b / 255, 1}
end
R.hex_colour = hex_colour

local function equipped_value(slot)
    local it = R.item(S.equipped and S.equipped[slot])
    return it and it.value or nil
end

local function badge_rank_of(id, fallback)
    if type(id) ~= "string" then return fallback, false end
    local r = id:match("^rb_(%d)$")
    if r then return tonumber(r), false end
    r = id:match("^s%d%d%d%d%-%d%d_b_(%d)$")
    if r then return tonumber(r), true end
    return fallback, false
end
R.badge_rank_of = badge_rank_of

