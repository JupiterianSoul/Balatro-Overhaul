local function alive_first(list)
    local out = {}
    for _, p in ipairs(list or {}) do out[#out + 1] = p end
    table.sort(out, function(a, b)
        if (a.alive ~= false) ~= (b.alive ~= false) then return a.alive ~= false end
        if a.alive == false then return (tonumber(a.placement) or 99) < (tonumber(b.placement) or 99) end
        if (tonumber(a.lives) or 0) ~= (tonumber(b.lives) or 0) then return (tonumber(a.lives) or 0) > (tonumber(b.lives) or 0) end
        return (tonumber(a.score) or -1) > (tonumber(b.score) or -1)
    end)
    return out
end

local function raid_bar(w, total, target)
    local t, g = tonumber(total) or 0, tonumber(target) or 0
    local frac = g > 0 and math.max(0, math.min(1, t / g)) or 0
    local fill = math.max(0.01, w * frac)
    return {n = G.UIT.R, config = {align = "cl", minw = w, minh = 0.2, r = 0.06, colour = G.C.UI.BACKGROUND_INACTIVE}, nodes = {
        {n = G.UIT.C, config = {align = "cm", minw = fill, maxw = fill, minh = 0.2, r = 0.06, colour = frac >= 1 and G.C.GREEN or G.C.ORANGE}, nodes = {}},
    }}
end

local HUD_W = 3.6

local function hud_line(left, right, lcol, rcol, scale, bg, w, badge)
    scale = scale or 0.3
    w = w or (HUD_W - 0.2)
    local lw = w * 0.58
    local rw = w - lw
    return {n = G.UIT.R, config = {align = "cm", minw = w, minh = scale + 0.06, r = 0.06, colour = bg or G.C.CLEAR}, nodes = {
        {n = G.UIT.C, config = {align = "cl", minw = lw, maxw = lw}, nodes = badge and {badge, {n = G.UIT.C, config = {minw = 0.04}}, txt(left, scale, lcol)} or {txt(left, scale, lcol)}},
        {n = G.UIT.C, config = {align = "cr", minw = rw, maxw = rw}, nodes = {txt(right, scale, rcol)}},
    }}
end

local function lives_text(n)
    return tostring(tonumber(n) or 0) .. " " .. L("lives")
end

local MINE_BG = {1, 0.85, 0.3, 0.16}
P.MINE_BG = MINE_BG

function P.my_team()
    for _, p in ipairs(S.ps and S.ps.players or {}) do
        if p.pid == S.me then return p.team end
    end
    return nil
end

FUNCS.party_hud_toggle = function()
    S.hud_collapsed = not S.hud_collapsed
    S.hud_forced = nil
    P.rebuild_hud()
end

function P.hud_def(collapsed)
    local ps = S.ps or {}
    local kind = ps.kind or P.kind()
    local iw = HUD_W - 0.2
    local rows = {}
    rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", minw = iw, minh = 0.42, button = "party_hud_toggle", hover = true, r = 0.06}, nodes = {
        txt(P.kind_name(kind) .. (collapsed and "  +" or "  -"), 0.36, G.C.GOLD)}}
    local mine = P.my_team()
    if kind == "br" then
        local lo, hi = ps.lowest, ps.highest
        rows[#rows + 1] = hud_line(L("Lowest") .. ": " .. (lo and lo.name or "-"), lo and fmt_score(lo.score) or "-", G.C.RED, G.C.RED)
        rows[#rows + 1] = hud_line(L("Highest") .. ": " .. (hi and hi.name or "-"), hi and fmt_score(hi.score) or "-", G.C.GREEN, G.C.GREEN)
    elseif kind == "teams" then
        for _, t in ipairs(ps.teams or {}) do
            local col = t.alive == false and G.C.UI.TEXT_INACTIVE or P.team_colour(t.team)
            rows[#rows + 1] = hud_line(P.team_name(t.team) .. "  " .. lives_text(t.lives), fmt_score(t.score), col, G.C.WHITE, nil, t.team == mine and MINE_BG or nil)
        end
    elseif kind == "raid" then
        local r = ps.raid or {}
        rows[#rows + 1] = hud_line(L("Raid lives") .. ": " .. tostring(r.lives or 0), fmt_score(r.total) .. " / " .. fmt_score(r.target), G.C.WHITE, G.C.WHITE)
        rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", minw = iw, padding = 0.04}, nodes = {raid_bar(iw, r.total, r.target)}}
    end
    if not collapsed then
        rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", minw = iw, minh = 0.02, colour = {1, 1, 1, 0.12}}, nodes = {}}
        local list = alive_first(ps.players)
        local two = #list > 4 or UIK.touch()
        local cells = {}
        for _, p in ipairs(list) do
            local out = p.alive == false
            local col = out and G.C.UI.TEXT_INACTIVE or (p.pid == S.me and G.C.GOLD or G.C.WHITE)
            if kind == "teams" and not out and p.pid ~= S.me then col = P.team_colour(p.team) end
            local right
            if out then
                right = L("Out")
            elseif two then
                right = kind == "raid" and (p.finished and L("Done") or fmt_score(p.score)) or tostring(tonumber(p.lives) or 0)
            elseif kind == "raid" then
                right = p.score ~= nil and fmt_score(p.score) or (p.finished and L("Done") or "-")
            else
                right = (p.score ~= nil and (fmt_score(p.score) .. "  ") or "") .. lives_text(p.lives)
            end
            local name = p.name or "?"
            if p.connected == false and not out then name = name .. " (" .. L("away") .. ")" end
            local bg = (kind == "teams" and mine ~= nil and p.team == mine) and MINE_BG or nil
            cells[#cells + 1] = hud_line(name, right, col, out and G.C.UI.TEXT_INACTIVE or G.C.WHITE, two and 0.26 or 0.28, bg, two and (iw - 0.1) / 2 or iw,
                bom_badges.name_badge(p, two and 0.26 or 0.3, bom_badges.any_dev(list)))
        end
        if two then
            for i = 1, #cells, 2 do
                local a, b = cells[i], cells[i + 1]
                a.n = G.UIT.C
                local pair = {a, {n = G.UIT.C, config = {minw = 0.1}}}
                if b then b.n = G.UIT.C; pair[3] = b else pair[3] = {n = G.UIT.C, config = {minw = (iw - 0.1) / 2}} end
                rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", minw = iw}, nodes = pair}
            end
        else
            for _, c in ipairs(cells) do rows[#rows + 1] = c end
        end
    end
    return {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR}, nodes = {
        {n = G.UIT.C, config = {align = "tm", minw = HUD_W, r = 0.12, padding = 0.08, colour = {0, 0, 0, 0.45}, emboss = 0.05}, nodes = rows},
    }}
end

local function in_run()
    return G and G.STAGE == G.STAGES.RUN and G.GAME and G.GAME.multiplayer and G.consumeables ~= nil
end

function P.remove_hud()
    if P.hud then
        pcall(function() P.hud:remove() end)
        P.hud = nil
    end
end

local function free_height()
    local top = G.consumeables.T.y + G.consumeables.T.h + 0.35
    local bottom = G.deck and G.deck.T and G.deck.T.y or (G.ROOM and G.ROOM.T.h) or 12
    return bottom - top - 0.15
end

local function build(collapsed)
    local ok, box = pcall(function()
        return UIBox{definition = P.hud_def(collapsed), config = {align = "bm", offset = {x = 0, y = 0.35}, major = G.consumeables, bond = "Weak"}}
    end)
    return ok and box or nil
end

function P.rebuild_hud()
    P.remove_hud()
    if not (S.ps and in_run()) then return end
    do return end
    if S.hud_collapsed == nil then S.hud_collapsed = UIK.touch() and true or false end
    local box = build(S.hud_collapsed)
    if box and not S.hud_collapsed then
        local ok, room = pcall(free_height)
        if ok and box.T and box.T.h > room then
            pcall(function() box:remove() end)
            box = build(true)
        end
    end
    P.hud = box
end

local LIVE_BLIND = {Small = "S", Big = "B", Boss = "L"}

local function live_stat()
    local g = G.GAME
    local where
    if G.STATE == G.STATES.SHOP then where = "shop"
    elseif G.STATE == G.STATES.BLIND_SELECT then where = g.mp_blind_ready and "ready" or "select"
    elseif g.facing_blind then where = "blind"
    else return nil end
    local cr = g.current_round or {}
    local score = 0
    if where == "blind" then
        local ok, v = pcall(function() return bom_core.plain_number(g.chips) end)
        score = ok and tonumber(v) or tonumber(g.chips) or 0
    end
    return {
        type = "live_stat", where = where, ante = g.round_resets and g.round_resets.ante or 1,
        blind = where ~= "shop" and LIVE_BLIND[g.blind_on_deck or ""] or nil,
        hands = where == "blind" and (cr.hands_left or 0) or 0, discards = where == "blind" and (cr.discards_left or 0) or 0,
        score = math.floor(score or 0),
    }
end

local function live_tick()
    local now = love.timer.getTime()
    if S.live_at and now - S.live_at < 0.25 then return end
    S.live_at = now
    local ok, st = pcall(live_stat)
    if not ok or not st then return end
    local key = table.concat({st.where, st.ante, st.blind or "", st.hands, st.discards, st.score}, "|")
    if key == S.live_key then return end
    S.live_key = key
    send(st)
end

function P.update()
    if S.flag and S.ps and in_run() and S.ps.phase == "playing" then
        live_tick()
        if bom_spectate then pcall(bom_spectate.tick) end
    end
    if P.hud then
        if not (S.flag and in_run()) then P.remove_hud() end
    elseif S.flag and S.ps and in_run() then
        P.rebuild_hud()
    elseif S.flag and not S.ps and in_run() and not S.state_asked then
        S.state_asked = true
        send({type = "request_state"})
    end
end

local function placement_text(n)
    n = tonumber(n)
    return n and ("#" .. n) or "-"
end
P.placement_text = placement_text

local function standings_open()
    return UIK and UIK._win and UIK._win.id == "party_st" and G.OVERLAY_MENU ~= nil and G.OVERLAY_MENU == P._st_box
end

function P.refresh_standings()
    if standings_open() then UIK.refresh() end
end

local LIVE_BLIND_NAME = {S = "Small Blind", B = "Big Blind", L = "Boss Blind"}

local function live_text(live)
    if type(live) ~= "table" then return nil end
    local parts = {string.format(L("Ante %d"), tonumber(live.ante) or 1)}
    if live.where == "shop" then
        parts[#parts + 1] = L("Shop")
    elseif live.where == "select" then
        parts[#parts + 1] = L("Choosing blind")
    elseif live.where == "ready" then
        if LIVE_BLIND_NAME[live.blind or ""] then parts[#parts + 1] = L(LIVE_BLIND_NAME[live.blind]) end
        parts[#parts + 1] = L("ready")
    else
        if LIVE_BLIND_NAME[live.blind or ""] then parts[#parts + 1] = L(LIVE_BLIND_NAME[live.blind]) end
        local h, d = tonumber(live.hands) or 0, tonumber(live.discards) or 0
        parts[#parts + 1] = string.format(L(h == 1 and "%d hand" or "%d hands"), h) .. " " .. string.format(L(d == 1 and "%d discard" or "%d discards"), d)
    end
    return table.concat(parts, ", ")
end
P.live_text = live_text

local function standings_body()
    if bom_standings and bom_standings.tab and bom_ui and bom_ui.in_party_run and bom_ui.in_party_run() then
        local ok, node = pcall(bom_standings.tab)
        if ok and node then return node end
    end
    local ps = S.ps or {}
    local kind = ps.kind or P.kind()
    local w = UIK.W - 2 * UIK.PAD
    local teams = kind == "teams"
    local cols = {{key = "place", w = 1.0}, {key = "name"}, teams and {key = "team", w = 1.8} or nil, {key = "lives", w = 1.2}, {key = "status", w = 5.2}, {key = "score", w = 2.2}}
    local list = {}
    for i = 1, 6 do if cols[i] then list[#list + 1] = cols[i] end end
    local fixed = 0
    for _, c in ipairs(list) do fixed = fixed + (c.w or 0) end
    for _, c in ipairs(list) do if c.key == "name" then c.w = w - fixed - 0.2 end end
    local function line(values, colours, scale, bg, badge)
        local nodes = {}
        for i, c in ipairs(list) do
            local v = values[c.key] or ""
            local sc = scale
            local room = c.w - 0.15 - ((badge and c.key == "name") and 0.46 or 0)
            local tw = UIK.text_w(v, scale)
            if tw > room and tw > 0 then sc = scale * room / tw end
            local t = txt(v, sc, colours and colours[c.key] or G.C.WHITE)
            nodes[#nodes + 1] = cell((badge and c.key == "name") and {badge, {n = G.UIT.C, config = {minw = 0.06}}, t} or {t}, c.w, c.key == "name" and "cl" or "cm")
        end
        return {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.02}, nodes = {
            {n = G.UIT.C, config = {align = "cl", minw = w, minh = UIK.touch() and 0.6 or 0.48, r = 0.1, colour = bg or G.C.BLACK, emboss = bg == G.C.CLEAR and 0 or 0.04, padding = 0.03}, nodes = nodes},
        }}
    end
    local items = {}
    local title
    if kind == "br" then
        local lo, hi = ps.lowest, ps.highest
        title = L("Lowest") .. ": " .. (lo and (lo.name .. " " .. fmt_score(lo.score)) or "-") .. "    " .. L("Highest") .. ": " .. (hi and (hi.name .. " " .. fmt_score(hi.score)) or "-")
    elseif kind == "teams" then
        local parts = {}
        for _, t in ipairs(ps.teams or {}) do parts[#parts + 1] = P.team_name(t.team) .. " " .. fmt_score(t.score) end
        title = #parts > 0 and table.concat(parts, "    ") or P.kind_name(kind)
    else
        local r = ps.raid or {}
        title = L("Raid") .. ": " .. fmt_score(r.total) .. " / " .. fmt_score(r.target) .. "    " .. L("Raid lives") .. ": " .. tostring(r.lives or 0)
    end
    items[#items + 1] = UIK.header(title, {w = w})
    if kind == "raid" then
        local r = ps.raid or {}
        items[#items + 1] = {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.04}, nodes = {raid_bar(w - 0.2, r.total, r.target)}}
    end
    local head = {place = L("Place"), name = L("Player"), team = L("Team"), lives = L("Lives"), status = L("Status"), score = L("Score")}
    local ts = UIK.touch() and 0.42 or 0.32
    items[#items + 1] = line(head, nil, ts, G.C.CLEAR)
    for _, p in ipairs(alive_first(ps.players)) do
        local out = p.alive == false
        local status = out and L("Out") or (p.connected == false and L("Away") or (p.finished and L("Done") or (live_text(p.live) or L("Playing"))))
        local me = p.pid == S.me
        local values = {place = placement_text(p.placement), name = p.name or "?", team = teams and P.team_name(p.team) or "",
            lives = tostring(p.lives or 0), status = status,
            score = fmt_score(p.score ~= nil and p.score or (not out and type(p.live) == "table" and p.live.where == "blind" and p.live.score or nil))}
        local base = out and G.C.UI.TEXT_INACTIVE or G.C.WHITE
        local colours = {place = base, name = me and G.C.GOLD or base, team = teams and P.team_colour(p.team) or base, lives = base,
            status = out and G.C.RED or (p.connected == false and G.C.ORANGE or base), score = base}
        local mine = (teams and P.my_team() ~= nil and p.team == P.my_team()) or (not teams and me)
        items[#items + 1] = line(values, colours, ts, mine and {0.3, 0.25, 0.08, 1} or nil, bom_badges.name_badge(p, 0.4, bom_badges.any_dev(ps.players)))
    end
    local node = {n = G.UIT.R, config = {align = "tm", minw = UIK.W, minh = UIK.H, padding = 0}, nodes = {
        {n = G.UIT.C, config = {align = "tm", minw = w}, nodes = items},
    }}
    return node
end

function P.standings_root()
    P.ensure()
    local ok, body = pcall(standings_body)
    return {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR}, nodes = {ok and body or {n = G.UIT.R, config = {}}}}
end

function P.in_party()
    return S.flag == true and S.ps ~= nil
end

function P.show_standings(from_results)
    P.ensure()
    local finished = (S.ps and S.ps.phase == "finished") or (S.result ~= nil and bom_match.is_match_over() and S.ps and S.ps.phase ~= "playing")
    local footer = {}
    if from_results and finished and P.is_host() then
        footer[#footer + 1] = UIK.button{label = L("Return to Lobby"), button = "mp_return_to_lobby", colour = UIK.C.accent, id = "party_st_lobby"}
    end
    if not finished and bom_spectate and bom_spectate.allowed() then
        footer[#footer + 1] = UIK.button{label = L("Spectate"), button = "party_spectate", colour = UIK.C.accent, id = "party_st_spec"}
    end
    footer[#footer + 1] = UIK.button{label = L("Quit"), button = "mp_leave_lobby", colour = UIK.C.danger, id = "party_st_quit"}
    G.FUNCS.overlay_menu{definition = UIK.window{zoom = false,
        id = "party_st",
        title = finished and L("PARTY RESULTS") or L("STANDINGS"),
        tabs = {{key = "s", label = L("Standings"), build = standings_body}},
        back_func = from_results and "party_back_to_results" or "exit_overlay_menu",
        footer = footer,
    }}
    P._st_box = G.OVERLAY_MENU
end

function P.solo_note()
    pcall(function()
        attention_text({text = L("No fight this blind"), scale = 0.7, hold = 2.5, major = G.play, align = "cm", offset = {x = 0, y = -1},
            backdrop_colour = G.C.BLACK, silent = true})
    end)
end

function P.result_line()
    local r = S.result
    local n = 0
    for _ in ipairs(S.ps and S.ps.players or {}) do n = n + 1 end
    if r and r.placement then
        return L("Place") .. " " .. placement_text(r.placement) .. (n > 0 and (" " .. L("of") .. " " .. n) or "")
    end
    return L("Watching the others play")
end

local END_LINE = {
    team_won = "Your team won", team_eliminated = "Your team lost",
    raid_cleared = "Raid cleared", raid_failed = "Raid failed", last_standing = "Last one standing",
}

function P.end_line()
    local r = S.result or {}
    local head = END_LINE[r.reason or ""]
    if not head then
        local kind = P.kind()
        local won = bom_match.get_state().match_result == "win"
        if kind == "teams" then head = won and END_LINE.team_won or END_LINE.team_eliminated
        elseif kind == "raid" then head = won and END_LINE.raid_cleared or END_LINE.raid_failed end
    end
    local place = r.placement and P.result_line() or nil
    if head and place then return L(head) .. ", " .. place end
    return head and L(head) or P.result_line()
end

function P.results_buttons()
    local nodes = {}
    nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", minh = 0.4, minw = 3.4}, nodes = {
        {n = G.UIT.T, config = {text = P.result_line(), scale = 0.32, colour = G.C.GOLD, shadow = true, maxw = 3.4}},
    }}
    local over = S.ps and S.ps.phase == "finished"
    nodes[#nodes + 1] = UIBox_button({id = "party_standings_btn", button = "party_standings", label = {over and L("Results") or L("Standings")},
        colour = G.C.GREEN, minw = 3.4, maxw = 3.4, minh = 1, focus_args = {nav = "wide", snap_to = true}})
    if P.is_host() then
        nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", minh = 0.2, minw = 0.1}, nodes = {}}
        nodes[#nodes + 1] = UIBox_button({id = "mp_return_lobby_btn", button = over and "mp_return_to_lobby" or "nil", label = {L("Return to Lobby")},
            colour = over and G.C.BLUE or G.C.UI.BACKGROUND_INACTIVE, minw = 3.4, maxw = 3.4, minh = 1, focus_args = {nav = "wide"}})
    end
    nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", minh = 0.2, minw = 0.1}, nodes = {}}
    nodes[#nodes + 1] = UIBox_button({id = "mp_leave_lobby_btn", button = "mp_leave_lobby", label = {L("Quit")}, colour = G.C.RED,
        minw = 3.4, maxw = 3.4, minh = 1, focus_args = {nav = "wide"}})
    return nodes
end

