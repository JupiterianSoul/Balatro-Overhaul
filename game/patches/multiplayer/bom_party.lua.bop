local P = {}

local function L(s) return mod_loc and mod_loc(s) or s end

P.MAX = 8
P.PORT_WIDE = 1.12
P.KINDS = {"br", "teams", "raid"}
P.KIND_NAME = {br = "Battle Royale", teams = "Teams", raid = "Co-op Raid"}
P.KIND_INFO = {
    br = "Lowest score each PvP blind loses a life",
    teams = "Team scores add up, teams share lives",
    raid = "Everyone beats one shared boss target",
}
P.TEAM_NAME = {"Team A", "Team B", "Team C", "Team D"}

local S = {room = nil, ps = nil, code = nil, id = nil, visibility = "private", me = nil, flag = false, result = nil}
P.S = S

function P.kind_name(k) return L(P.KIND_NAME[k or "br"] or P.KIND_NAME.br) end
function P.team_name(t) return L(P.TEAM_NAME[(tonumber(t) or 0) + 1] or "Team") end

function P.team_colour(t)
    local list = {G.C.RED, G.C.BLUE, G.C.GREEN, G.C.ORANGE}
    return list[(tonumber(t) or 0) + 1] or G.C.UI.BACKGROUND_INACTIVE
end

function P.active()
    if not S.flag then return false end
    return bom_match ~= nil and bom_match.get_phase() ~= bom_match.PHASE.NONE
end

function P.clear()
    P.remove_hud()
    S.room, S.ps, S.code, S.id, S.me, S.flag, S.result, S.last_join = nil, nil, nil, nil, nil, false, nil, nil
    S.visibility = "private"
end

local function settings()
    return bom_match and bom_match.get_settings and bom_match.get_settings() or {}
end

function P.kind()
    if S.ps and S.ps.kind then return S.ps.kind end
    if S.room and S.room.kind then return S.room.kind end
    return settings().party_kind or "br"
end

function P.is_host()
    if S.room and S.room.hostId ~= nil and S.me ~= nil then return S.room.hostId == S.me end
    return bom_match and bom_match.is_host_player() or false
end

local function fmt_score(v)
    if v == nil then return "-" end
    local n = tonumber(v)
    if not n then return tostring(v) end
    local ok, out = pcall(number_format, n)
    return ok and out or tostring(n)
end
P.fmt_score = fmt_score

local function name_check(retry)
    local name = bom_room.my_profile_name()
    if not bom_room.is_default_name(name) then return name end
    pcall(function() bom_ui.hide_connecting_screen() end)
    bom_room.show_name_prompt("default", name, retry)
    return nil
end

function P.create(visibility, kind)
    visibility = visibility == "public" and "public" or "private"
    if bom_core.mods_refused(visibility == "public") then return end
    if not name_check(function() P.create(visibility, kind) end) then return end
    pcall(function() if G and G.GAME then G.GAME.bom_quick_match = false end end)
    pcall(function() bom_ui.show_connecting_screen() end)
    bom_room.retry = function() P.create(visibility, kind) end
    S.last_join = nil
    bom_core.connect(function()
        bom_core.send({type = "party_create", kind = kind or "br", visibility = visibility, raid_curve = 2,
            name = bom_room.my_profile_name(), mods = bom_core.mods_field(visibility == "public"), version = bom_room.game_version()})
    end)
end

local function my_entry()
    if not (S.room and S.room.players) then return nil end
    for _, p in ipairs(S.room.players) do
        if p.pid == S.me then return p end
    end
    return nil
end

function P.team_counts()
    local n = math.max(2, tonumber(S.room and S.room.teams) or 2)
    local counts = {}
    for t = 1, n do counts[t] = 0 end
    for _, p in ipairs(S.room and S.room.players or {}) do
        if p.connected ~= false then
            local t = (tonumber(p.team) or 0) + 1
            counts[t] = (counts[t] or 0) + 1
        end
    end
    return counts, n
end

function P.start_block()
    if not (S.room and S.room.players) then return "not_enough_players" end
    local n, waiting = 0, 0
    for _, p in ipairs(S.room.players) do
        if p.connected ~= false then
            n = n + 1
            if p.pid ~= S.room.hostId and not p.ready then waiting = waiting + 1 end
        end
    end
    if n < 2 then return "not_enough_players" end
    if waiting > 0 then return "not_ready", waiting end
    local s = settings()
    if (s.party_kind or P.kind()) == "teams" and s.team_auto == false then
        local counts, tc = P.team_counts()
        local size = tonumber(s.team_size) or 2
        local used, lo, hi = 0, math.huge, 0
        for t, c in ipairs(counts) do
            if t > tc and c > 0 then return "teams_uneven" end
            if t <= tc then
                if c > 0 then used = used + 1 end
                lo, hi = math.min(lo, c), math.max(hi, c)
            end
        end
        if used < 2 then return "need_two_teams" end
        if hi > size then return "team_too_big" end
        if lo ~= hi then return "teams_uneven" end
    end
    return nil
end

function P.can_start()
    if not P.is_host() then return false end
    return P.start_block() == nil
end

local ERRORS = {
    already_in_room = "You are already in a room.",
    mods_private_only = "Mods only work in private rooms. Create a private room, or switch to the normal game.",
    room_gone = "This room is gone.",
    invalid_code = "Invalid room code. Check and try again.",
    in_match = "This room is already playing a match.",
    room_full = "This party is full.",
    not_enough_players = "A party needs at least 2 players.",
    not_ready = "Every player must be ready.",
    need_two_teams = "Teams needs at least two teams with players.",
    teams_uneven = "Teams must have the same number of players.",
    team_too_big = "A team has more players than the team size.",
    host_only = "Only the host can do that.",
    bad_kick = "You can't remove that player.",
    no_such_player = "That player is not in the party any more.",
}

local function on_error(d)
    local reason = d.reason
    pcall(function() bom_ui.hide_connecting_screen() end)
    if reason == "mods_mismatch" or reason == "code_required" or reason == "version_mismatch" then
        pcall(function() bom_browse.on_join_refused(d, bom_room.last_join) end)
        return
    end
    local text = L(ERRORS[reason or ""] or "Could not join the party.")
    if reason == "host_only" or reason == "bad_kick" or reason == "no_such_player" then
        P._kick = {}
        pcall(function() bom_ui.show_error(text) end)
        pcall(P.refresh_lobby)
        return
    end
    if reason == "not_enough_players" or reason == "not_ready" or reason == "need_two_teams" or reason == "teams_uneven" or reason == "team_too_big" then
        pcall(function() bom_ui.show_error(text) end)
        return
    end
    local from_browse = bom_room.last_join and bom_room.last_join.from_browse
    local in_lobby = S.code ~= nil and bom_match.get_phase() == bom_match.PHASE.LOBBY
    if in_lobby then
        pcall(function() bom_ui.show_error(text) end)
        return
    end
    S.flag = false
    pcall(function() bom_match.reset() end)
    if from_browse and bom_browse then
        pcall(function() bom_browse.show() end)
    else
        pcall(function() bom_core.disconnect() end)
    end
    pcall(function() bom_ui.show_error(text) end)
end

local function on_joined(d)
    S.flag = true
    S.code, S.id, S.me = d.code, d.id, d.playerId
    S.visibility = d.visibility or "private"
    S.ps, S.result = nil, nil
    pcall(function() if G and G.GAME then G.GAME.bom_room_code = d.code; G.GAME.bom_quick_match = false end end)
    bom_match.enter_lobby(d.host == true, d.code)
    local st = bom_match.get_state()
    st.server_player_id = d.playerId
    st.visibility = S.visibility
    if d.settings then bom_match.on_settings_received(d.settings) end
    pcall(function() bom_room.on_seat({code = d.code, id = d.id, token = d.token, host = d.host, playerId = d.playerId}) end)
    pcall(function() bom_rejoin.on_room_seat(d) end)
    pcall(function() if bom_browse then bom_browse.close_state() end end)
    pcall(function() bom_ui.hide_connecting_screen() end)
    P.show_lobby()
end

local function lobby_open()
    return UIK and UIK._win and UIK._win.id == "party" and G.OVERLAY_MENU ~= nil and G.OVERLAY_MENU == P._box
end

local function footer_sig()
    local me = my_entry()
    local n = #(S.room and S.room.players or {})
    return tostring(P.is_host()) .. tostring(me and me.ready) .. tostring(P.can_start()) .. tostring(n >= P.MAX)
end

function P.refresh_lobby()
    if not lobby_open() then return end
    if footer_sig() ~= P._sig then return P.show_lobby() end
    UIK.refresh()
end

local function on_room(d)
    S.flag = true
    local was_host = P.is_host()
    S.room = d
    if d.code then S.code = d.code end
    if d.visibility then S.visibility = d.visibility end
    local st = bom_match.get_state()
    if S.me ~= nil and d.hostId ~= nil then st.is_host = d.hostId == S.me end
    if d.phase == "lobby" then
        if was_host ~= P.is_host() and bom_lobby_settings and bom_lobby_settings.is_open() then
            bom_lobby_settings.show()
        else
            P.refresh_lobby()
        end
        return
    end
    if S.ps and S.ps.players then
        local by = {}
        for _, p in ipairs(d.players or {}) do by[p.pid] = p end
        for _, p in ipairs(S.ps.players) do
            local r = by[p.pid]
            if r then
                p.connected = r.connected
                if r.name then p.name = r.name end
            end
        end
    end
    P.rebuild_hud()
    P.refresh_standings()
end

local function on_state(d)
    S.flag = true
    S.ps = d
    if d.myId ~= nil then S.me = d.myId end
    P.rebuild_hud()
    P.refresh_standings()
end

function P.return_to_lobby(d)
    S.result = nil
    S.ps = nil
    local in_lobby = bom_match.get_phase() == bom_match.PHASE.LOBBY
    local function seat()
        pcall(function() bom_events.apply_lobby_seat(d) end)
        if d.settings then pcall(bom_match.on_settings_received, d.settings) end
        if d.playerId ~= nil then S.me = d.playerId end
    end
    P.remove_hud()
    if in_lobby then
        seat()
        G.E_MANAGER:add_event(Event({trigger = "after", delay = 0.8, blocking = false, blockable = false, no_delete = true,
            func = function() P.show_lobby(); return true end}))
        return
    end
    pcall(function() bom_ui.destroy_match_hud() end)
    if G.GAME then G.GAME.multiplayer = nil end
    bom_match.return_to_lobby()
    seat()
    pcall(function() if G.OVERLAY_MENU then G.FUNCS.exit_overlay_menu() end end)
    bom_rejoin.exit_to_menu({keep_match = true, silent = true, after = function() P.show_lobby() end})
end

function P.on_message(d)
    local t = d.type
    if t == "room_created" or t == "room_ready" then
        P.clear()
        return false
    end
    if t == "party_joined" then on_joined(d) return true end
    if t == "party_room" then on_room(d) return true end
    if t == "party_state" then on_state(d) return true end
    if t == "party_error" then on_error(d) return true end
    if t == "match_settings" and S.flag and S.code and type(d.settings) == "table" then
        pcall(bom_match.on_settings_received, d.settings)
        P.refresh_lobby()
        return false
    end
    if not d.party then return false end
    S.flag = true
    if t == "rejoin_ok" then
        S.code = d.code or S.code
        if d.playerId ~= nil then S.me = d.playerId end
        S.ps, S.state_asked, S.live_key = nil, nil, nil
        return false
    end
    if t == "lobby_returned" then
        P.return_to_lobby(d)
        return true
    elseif t == "match_start" then
        S.result, S.ps = nil, nil
    elseif t == "pvp_resolved" then
        S.last_pvp = d
    elseif t == "match_ended" then
        S.result = {placement = d.placement, reason = d.reason, result = d.result}
    elseif t == "room_closed" then
        P.remove_hud()
    end
    return false
end

local function send(msg)
    pcall(function() bom_core.send(msg) end)
end

local FUNCS = {}

FUNCS.party_ready = function()
    local me = my_entry()
    send({type = "party_ready", ready = not (me and me.ready)})
end

FUNCS.party_start = function()
    if not P.can_start() then return end
    local seed = bom_match.new_match_seed and bom_match.new_match_seed() or nil
    send({type = "party_start", seed = seed})
end

FUNCS.party_balance = function()
    if P.is_host() then send({type = "party_balance"}) end
end

FUNCS.party_settings = function()
    pcall(function() bom_lobby_settings.show() end)
end

FUNCS.party_copy_code = function()
    pcall(function() love.system.setClipboardText(tostring(S.code or "")) end)
    play_sound("card1")
    P._copied = S.code
    P.refresh_lobby()
end

FUNCS.party_team_auto = function(v)
    if not P.is_host() then return end
    bom_room.update_setting("team_auto", v == true)
    P.refresh_lobby()
end

FUNCS.party_leave = function()
    send({type = "party_leave"})
    pcall(function() bom_match.reset() end)
    pcall(function() bom_core.disconnect() end)
    P.clear()
    G.FUNCS.open_multiplayer_menu()
end

FUNCS.party_back_to_results = function()
    if bom_ui and bom_ui.reopen_results then bom_ui.reopen_results() else G.FUNCS.exit_overlay_menu() end
end

FUNCS.party_standings = function()
    P.show_standings(true)
end

P.BOT_LEVELS = {"easy", "medium", "hard"}
P.BOT_NAMES = {"Easy", "Medium", "Hard"}
P._bot_level = P._bot_level or 2

FUNCS.party_add_bot = function()
    if not P.is_host() then return end
    send({type = "add_bot", level = P.BOT_LEVELS[P._bot_level] or "medium"})
end

for pid = 0, P.MAX - 1 do
    FUNCS["party_bot_remove_" .. pid] = function()
        if not P.is_host() then return end
        for _, p in ipairs(S.room and S.room.players or {}) do
            if p.pid == pid and p.bot then send({type = "remove_bot", name = p.name}) end
        end
    end
end

P._kick = P._kick or {}

function P.kick_armed(pid)
    local k = P._kick
    return pid ~= nil and k.pid == pid and love.timer.getTime() - (k.t or 0) < 3 or false
end

function P.can_kick(p)
    return type(p) == "table" and p.pid ~= nil and p.pid ~= S.me and p.left ~= true and P.is_host() and S.code ~= nil
end

function P.kick(pid, name, bot)
    if not P.is_host() or pid == nil or pid == S.me then return false end
    if not P.kick_armed(pid) then
        P._kick = {pid = pid, t = love.timer.getTime()}
        pcall(play_sound, "cancel", 1.1, 0.5)
        G.E_MANAGER:add_event(Event({trigger = "after", delay = 3.05, timer = "REAL", blocking = false, blockable = false, func = function()
            pcall(P.refresh_lobby)
            return true
        end}))
        pcall(P.refresh_lobby)
        return false
    end
    P._kick = {}
    if bot then send({type = "remove_bot", name = name}) else send({type = "party_kick", pid = pid}) end
    pcall(P.refresh_lobby)
    return true
end

function P.on_kicked(d)
    if type(d) ~= "table" then return true end
    local msg = L("The host removed you from the party")
    S.flag = false
    P.clear()
    local function to_menu()
        pcall(function() if G.OVERLAY_MENU then G.FUNCS.exit_overlay_menu() end end)
        G.FUNCS.open_multiplayer_menu()
        pcall(function() bom_ui.show_error(msg) end)
    end
    if bom_rejoin and bom_rejoin.exit_to_menu and G.STAGE == G.STAGES.RUN then
        bom_rejoin.exit_to_menu({silent = true, reason = "kicked", after = to_menu})
    else
        pcall(function() bom_match.reset() end)
        pcall(function() bom_core.disconnect() end)
        to_menu()
    end
    return true
end

for pid = 0, P.MAX - 1 do
    FUNCS["party_kick_" .. pid] = function()
        for _, p in ipairs(S.room and S.room.players or {}) do
            if p.pid == pid and P.can_kick(p) then P.kick(pid, p.name, p.bot) return end
        end
    end
end

for pid = 0, P.MAX - 1 do
    FUNCS["party_team_" .. pid] = function()
        if not S.room or settings().team_auto ~= false then return end
        if not (P.is_host() or pid == S.me) then return end
        local n = math.max(2, tonumber(S.room.teams) or 2)
        for _, p in ipairs(S.room.players or {}) do
            if p.pid == pid then
                send({type = "party_team", pid = pid, team = ((tonumber(p.team) or 0) + 1) % n})
                return
            end
        end
    end
end

local function row_h() return UIK.touch() and 0.64 or 0.6 end

local function chip(label, colour, w, h)
    return {n = G.UIT.C, config = {align = "cm", minw = w, maxw = w, minh = h, r = 0.08, colour = colour, padding = 0.02}, nodes = {
        {n = G.UIT.T, config = {text = label, scale = UIK.touch() and 0.4 or 0.3, colour = G.C.WHITE, shadow = true}},
    }}
end

local function cell(nodes, w, align)
    return {n = G.UIT.C, config = {align = align or "cm", minw = w, maxw = w, padding = 0}, nodes = nodes}
end

local function txt(str, scale, colour)
    return {n = G.UIT.T, config = {text = tostring(str), scale = scale, colour = colour or G.C.WHITE, shadow = true}}
end

local function player_row(p, i, w, teams)
    local h = row_h()
    local seat_w, team_w, status_w, gap = 0.6, teams and 1.5 or 0, 1.7, 0.1
    local kick_w = P.is_host() and 1.2 or 0
    local name_w = w - seat_w - team_w - status_w - gap * 4 - (teams and gap or 0) - (kick_w > 0 and kick_w + gap or 0)
    local ts = UIK.touch() and (UIK.portrait() and 0.42 or 0.45) or 0.34
    local nodes = {cell({txt(tostring(i), ts, UIK.C.muted)}, seat_w)}
    local function add(n)
        nodes[#nodes + 1] = {n = G.UIT.C, config = {minw = gap}}
        nodes[#nodes + 1] = n
    end
    if not p then
        add(cell({txt(L("Open seat"), ts, UIK.C.muted)}, name_w, "cl"))
        if teams then add(cell({}, team_w)) end
        if kick_w > 0 then add(cell({}, kick_w)) end
        add(cell({}, status_w))
    else
        local me = p.pid == S.me
        local badge = not p.bot and bom_badges.name_badge(p, 0.4, bom_badges.any_dev(S.room and S.room.players))
        add(cell(badge and {badge, {n = G.UIT.C, config = {minw = 0.06}}, txt(p.name or "?", ts + 0.02, me and G.C.GOLD or G.C.WHITE)} or {txt(p.name or "?", ts + 0.02, me and G.C.GOLD or G.C.WHITE)}, name_w, "cl"))
        if teams then
            local s = settings()
            local col = P.team_colour(p.team)
            if s.team_auto ~= false then
                add(cell({chip(L("Auto"), G.C.UI.BACKGROUND_INACTIVE, team_w, h - 0.12)}, team_w))
            elseif P.is_host() or me then
                add(cell({UIBox_button({button = "party_team_" .. p.pid, label = {P.team_name(p.team)}, colour = col,
                    minw = team_w, maxw = team_w, minh = h - 0.12, scale = UIK.touch() and 0.38 or 0.32, col = true})}, team_w))
            else
                add(cell({chip(P.team_name(p.team), col, team_w, h - 0.12)}, team_w))
            end
        end
        if kick_w > 0 then
            if not p.bot and P.can_kick(p) then
                local armed = P.kick_armed(p.pid)
                add(cell({UIBox_button({button = "party_kick_" .. p.pid, label = {armed and L("Sure?") or L("Kick")}, colour = armed and G.C.GOLD or G.C.RED,
                    minw = kick_w, maxw = kick_w, minh = h - 0.12, scale = UIK.touch() and 0.38 or 0.32, col = true})}, kick_w))
            else
                add(cell({}, kick_w))
            end
        end
        local label, col
        if p.bot and P.is_host() then
            add(cell({UIBox_button({button = "party_bot_remove_" .. p.pid, label = {L("Remove")}, colour = G.C.RED,
                minw = status_w, maxw = status_w, minh = h - 0.12, scale = UIK.touch() and 0.38 or 0.32, col = true})}, status_w))
        elseif p.connected == false then
            label, col = L("Away"), G.C.ORANGE
        elseif S.room and p.pid == S.room.hostId then
            label, col = L("Host"), G.C.GOLD
        elseif p.ready then
            label, col = L("Ready"), G.C.GREEN
        else
            label, col = L("Not ready"), G.C.UI.BACKGROUND_INACTIVE
        end
        if label then add(cell({chip(label, col, status_w, h - 0.12)}, status_w)) end
    end
    return {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.03}, nodes = {
        {n = G.UIT.C, config = {align = "cl", minw = w, minh = h, r = 0.1, colour = G.C.BLACK, emboss = 0.04, id = p and p.pid ~= nil and ("bom_emote_pid_" .. tostring(p.pid)) or nil}, nodes = nodes},
    }}
end

local function sorted_players()
    local out = {}
    for _, p in ipairs(S.room and S.room.players or {}) do out[#out + 1] = p end
    table.sort(out, function(a, b) return (a.pid or 0) < (b.pid or 0) end)
    return out
end

local function summary_lines(s)
    local k = s.party_kind or "br"
    local lines = {}
    if k == "br" then
        lines[1] = L("Lives each") .. ": " .. tostring(s.starting_lives or 4)
        lines[2] = L("Players hit per blind") .. ": " .. tostring(s.br_losers or 1)
    elseif k == "teams" then
        lines[1] = L("Team size") .. ": " .. tostring(s.team_size or 2)
        lines[2] = L("Team lives") .. ": " .. tostring(s.starting_lives or 4)
    elseif k == "race" then
        lines[1] = L("Target ante") .. ": " .. tostring(s.race_target or 4)
        return lines
    else
        lines[1] = L("Raid lives") .. ": " .. tostring(s.raid_lives or 3)
        lines[2] = L("Target per player") .. ": " .. tostring(s.raid_per_player or 100) .. "%"
    end
    if UIK.touch() then return lines end
    lines[3] = L("PvP from ante") .. " " .. tostring(s.pvp_start_round or 2) .. ", " .. tostring(s.party_blind_seconds or 180) .. "s"
    return lines
end

local function code_block(w)
    local touch = UIK.touch()
    local bw, gap, h = touch and 2.0 or 1.8, 0.12, touch and 1.0 or 0.9
    local box_w = w - bw - gap
    local copied = P._copied ~= nil and P._copied == S.code
    local code = {n = G.UIT.C, config = {align = "cm", minw = box_w, maxw = box_w, minh = h, r = 0.1, colour = G.C.BLACK, emboss = 0.05}, nodes = {
        {n = G.UIT.T, config = {text = tostring(S.code or "????"), scale = touch and 0.95 or 0.85, colour = G.C.GOLD, shadow = true}},
    }}
    local copy = UIK.button{label = copied and L("Copied") or L("Copy"), button = "party_copy_code", colour = copied and UIK.C.ok or UIK.C.accent,
        w = bw, h = h, col = true, id = "party_copy_code"}
    local info = S.visibility == "public" and L("Public: listed in Browse Rooms, or join with this code")
        or L("Private: only players with this code can join")
    local nodes = {
        {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0}, nodes = {code, {n = G.UIT.C, config = {minw = gap}}, copy}},
    }
    local note = UIK.note({info}, {w = w, scale = UIK.portrait() and 0.4 or nil})
    local row = {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0}, nodes = {
        {n = G.UIT.C, config = {align = "cm", minw = w, padding = 0}, nodes = {nodes[1], note}},
    }}
    row.uik_h = h + note.uik_h
    return row
end

local function team_counts_row(w, s)
    local counts, n = P.team_counts()
    local size = tonumber(s.team_size) or 2
    local gap = 0.1
    local cw = (w - gap * (n - 1)) / n
    local h = row_h() - 0.08
    local nodes = {}
    for t = 1, n do
        if t > 1 then nodes[#nodes + 1] = {n = G.UIT.C, config = {minw = gap}} end
        local c = counts[t] or 0
        local col = s.team_auto ~= false and G.C.UI.BACKGROUND_INACTIVE or P.team_colour(t - 1)
        nodes[#nodes + 1] = chip(P.team_name(t - 1) .. "  " .. c .. "/" .. size, col, cw, h)
    end
    local row = {n = G.UIT.R, config = {align = "cm", minw = w, minh = h + 0.08, padding = 0}, nodes = nodes}
    row.uik_h = h + 0.08
    return row
end

local function start_status()
    local host = P.is_host()
    local me = my_entry()
    if not host then
        if me and me.ready then return L("Waiting for the host to start"), UIK.C.muted end
        return L("Press Ready when you are set"), G.C.ORANGE
    end
    local why, n = P.start_block()
    if not why then return L("Everyone is ready, you can start"), G.C.GREEN end
    local s = settings()
    local text
    if why == "not_enough_players" then
        text = L("Start needs at least 2 players")
    elseif why == "not_ready" then
        text = L("Waiting for {n} player(s) to be ready"):gsub("{n}", tostring(n or 1))
    elseif why == "need_two_teams" then
        text = L("Put players in at least two teams")
    elseif why == "team_too_big" then
        text = L("A team has more than {n} players"):gsub("{n}", tostring(s.team_size or 2))
    else
        text = L("Teams are uneven, make them {n}v{n}"):gsub("{n}", tostring(s.team_size or 2))
    end
    return text, G.C.ORANGE
end

local function lobby_body()
    local s = settings()
    local port = UIK.portrait()
    local inner = port and UIK.W * P.PORT_WIDE - 2 * UIK.PAD or UIK.col_w(2) - 2 * UIK.PAD
    local kind = s.party_kind or "br"
    local teams = kind == "teams"
    local host = P.is_host()
    local list = sorted_players()
    local left = {UIK.header(L("Players") .. "  " .. #list .. "/" .. P.MAX, {w = inner})}
    for i = 1, P.MAX do left[#left + 1] = player_row(list[i], i, inner, teams) end

    local right = {UIK.header(L("Party code"), {w = inner}), code_block(inner)}
    if host then
        local labels, cur = {}, 1
        for i, k in ipairs(P.KINDS) do
            labels[i] = P.kind_name(k)
            if k == kind then cur = i end
        end
        right[#right + 1] = UIK.cycle{w = inner, label = L("Party mode"), options = labels, current = cur, info = not UIK.portrait() and L(P.KIND_INFO[kind]) or nil, id = "party_kind",
            callback = function(i)
                bom_room.update_setting("party_kind", P.KINDS[i])
                UIK.refresh()
            end}
        if UIK.portrait() then right[#right + 1] = UIK.note({L(P.KIND_INFO[kind])}, {w = inner, scale = 0.4}) end
    else
        right[#right + 1] = UIK.value{w = inner, vw = 3.2, label = L("Party mode"), value = P.kind_name(kind), info = L(P.KIND_INFO[kind])}
    end
    if teams then
        local auto = s.team_auto ~= false
        if host then
            P._tog = {team_auto = auto}
            right[#right + 1] = UIK.toggle{w = inner, label = L("Auto-balance teams"), ref_table = P._tog, ref_value = "team_auto", id = "party_team_auto",
                info = not UIK.touch() and (auto and L("Teams are mixed at start") or L("Tap a team to move a player")) or nil, callback = FUNCS.party_team_auto}
        else
            right[#right + 1] = UIK.note({auto and L("The host mixes teams at start") or L("Tap your team to switch")}, {w = inner})
        end
        right[#right + 1] = team_counts_row(inner, s)
    else
        local sl = summary_lines(s)
        if UIK.touch() and #sl > 1 then sl = {table.concat(sl, ",  ")} end
        right[#right + 1] = UIK.note(sl, {w = inner, scale = UIK.portrait() and 0.4 or nil})
    end
    if host then
        local names = {}
        for i, n in ipairs(P.BOT_NAMES) do names[i] = L(n) end
        right[#right + 1] = UIK.cycle{w = inner, label = L("Bot difficulty"), options = names, current = P._bot_level, id = "party_bot_level",
            info = not (teams and UIK.touch()) and not UIK.portrait() and L("Bot-latro players run on the server and play like real players") or nil,
            callback = function(i) P._bot_level = i end}
        if UIK.portrait() and not teams then right[#right + 1] = UIK.note({L("Bot-latro players run on the server and play like real players")}, {w = inner, scale = 0.4}) end
    end
    local text, col = start_status()
    right[#right + 1] = UIK.note({text}, {w = inner, colour = col, scale = UIK.touch() and 0.42 or 0.32})
    local mg = rawget(_G, "Minigames")
    if mg and mg.lobby_wait and mg.lobby_wait(true) then
        local wb = UIK.button{label = L("Play while you wait"), button = "mg_wait_play", colour = G.C.PURPLE, id = "mg_wait_row", col = true, w = UIK.touch() and math.min(inner, 4.8) or nil}
        left[#left + 1] = {n = G.UIT.R, config = {align = "cm", minw = inner, padding = 0.1}, nodes = {wb}}
    end
    if port then
        for _, it in ipairs(right) do left[#left + 1] = it end
        return UIK.columns({left})
    end
    return UIK.columns({left, right})
end

function P.show_lobby()
    if not (G and G.FUNCS and UIK) then return end
    P.ensure()
    pcall(function() bom_ui.release_connecting_screen() end)
    pcall(function() require("multiplayer.bom_lobby_leave").register() end)
    local host = P.is_host()
    local me = my_entry()
    local footer = {}
    local fw = bom_social and (UIK.touch() and 2.15 or 2.05) or nil
    if not host then
        footer[#footer + 1] = UIK.button{label = me and me.ready and L("Unready") or L("Ready"), button = "party_ready",
            colour = me and me.ready and UIK.C.danger or UIK.C.ok, id = "party_ready", w = fw}
    end
    footer[#footer + 1] = UIK.button{label = host and L("Settings") or L("View settings"), button = "party_settings", colour = UIK.C.accent, id = "party_settings", w = fw}
    if host then
        footer[#footer + 1] = UIK.button{label = L("Add Bot"), button = "party_add_bot", colour = G.C.PURPLE,
            disabled = #(S.room and S.room.players or {}) >= P.MAX, id = "party_add_bot", w = fw}
        footer[#footer + 1] = UIK.button{label = L("Start"), button = "party_start", colour = UIK.C.ok, disabled = not P.can_start(), id = "party_start", w = fw}
    end
    if bom_social then
        footer[#footer + 1] = UIK.button{label = L("Friends"), button = "social_open_party", colour = UIK.C.ok, w = fw, id = "party_friends"}
        footer[#footer + 1] = UIK.button{label = L("Emote"), button = "social_emote_open_party", colour = G.C.BLUE, w = fw, id = "party_emote"}
        if bom_social.chat_button then footer[#footer + 1] = bom_social.chat_button("party", fw) end
    end
    P._sig = footer_sig()
    if UIK.portrait() and #footer > 3 then
        local rows, cur = {}, {}
        local per = math.ceil(#footer / math.ceil(#footer / 3))
        for i, b in ipairs(footer) do
            if b.n == G.UIT.R then b.n = G.UIT.C end
            cur[#cur + 1] = b
            if #cur == per or i == #footer then
                rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.06}, nodes = cur}
                cur = {}
            end
        end
        footer = {{n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = rows}}
    end
