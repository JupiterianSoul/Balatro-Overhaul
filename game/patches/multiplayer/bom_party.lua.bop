local ready = false
function P.ensure()
    if ready or not (G and G.FUNCS) then return ready end
    ready = true
    if mod_loc_register then pcall(register_strings) end
    for k, f in pairs(FUNCS) do G.FUNCS[k] = f end
    return true
end

function P.init()
    P.ensure()
    if bom_events and bom_events.register then bom_events.register("party_kicked", P.on_kicked) end
end

return P
end
