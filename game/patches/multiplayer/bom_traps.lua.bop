local function in_mp()
    return G and G.GAME and G.GAME.multiplayer and bom_match and bom_match.is_in_match and bom_match.is_in_match()
end

local function vs_bot()
    local ok, r = pcall(function() return bom_match.get_state().opp_bot == true end)
    return ok and r or false
end

local function settings()
    local s = (G and G.GAME and G.GAME.mp_settings) or (bom_match and bom_match.get_settings and bom_match.get_settings()) or {}
    return s
end

local function party_on()
    local ok, r = pcall(function() return bom_party and bom_party.active and bom_party.active() end)
    return ok and r or false
end

function T.enabled()
    if not (in_mp() and settings().traps == true) then return false end
    if party_on() then return T.leader() ~= nil end
    return not vs_bot()
end

local function lang_of(t, lang)
    if lang == "fr" then return t.fr_name or t.name, t.fr end
    if lang == "es" then return t.es_name or t.name, t.es end
    return t.name, t.en
end

function T.name(key)
    local t = T.BY_KEY[key]
    if not t then return L("Trap") end
    local lang = bom_custom_objects and bom_custom_objects.lang and bom_custom_objects.lang() or "en"
    return (lang_of(t, lang))
end

local function register_loc()
    local O = bom_custom_objects
    if not (O and O.register_loc) then return end
    for _, t in ipairs(TRAPS) do
        local tr = {}
        for _, lang in ipairs({"en", "fr", "es"}) do
            local n, txt = lang_of(t, lang)
            local lines = {}
            for i, line in ipairs(txt) do lines[i] = line end
            lines[#lines + 1] = LASTS[lang]
            tr[lang] = {name = n, text = lines}
        end
        O.register_loc("Other", t.key, tr)
    end
    O.register_loc("Other", T.PACK, PACK_LOC)
    if O.on_language then O.on_language(T.inject_misc) end
    if mod_loc_register then pcall(mod_loc_register, {fr = MSG_FR, es = MSG_ES}) end
end

function T.inject_misc()
    if not (G and G.localization and G.localization.misc and G.localization.misc.dictionary) then return end
    G.localization.misc.dictionary.k_trap = L("Trap")
    G.localization.misc.dictionary.k_trap_pack = PACK_LOC.en.name
    pcall(function()
        local lang = bom_custom_objects.lang()
        G.localization.misc.dictionary.k_trap_pack = (PACK_LOC[lang] or PACK_LOC.en).name
    end)
end

local function register_centers()
    if not (G and G.P_CENTERS) then return end
    for i, t in ipairs(TRAPS) do
        if not G.P_CENTERS[t.key] then
            G.P_CENTERS[t.key] = {
                key = t.key, set = "Trap", name = t.name, order = t.order, discovered = true, unlocked = true, omit = true,
                cost = 0, consumeable = true, config = {trap = t.trigger}, pos = {x = i - 1, y = 0}, atlas = "mp_traps",
                mp_trap = true, trigger = t.trigger, effect = "",
            }
        end
    end
    local labelled = trap_pack_label_ready and trap_pack_label_ready()
    if not G.P_CENTERS[T.PACK] then
        G.P_CENTERS[T.PACK] = {
            key = T.PACK, set = "Booster", name = "Trap Pack", order = 1300, discovered = true, unlocked = true, omit = true,
            cost = 4, weight = 0, kind = "MPTrap", atlas = labelled and "mp_trap_pack" or "mp_traps", pos = {x = labelled and 0 or #TRAPS, y = 0},
            config = {extra = 2, choose = 1}, mp_trap_pack = true,
        }
    end
    if G.C then
        local col = G.C.RED or {0.9, 0.3, 0.3, 1}
        G.C.SET = G.C.SET or {}
        G.C.SECONDARY_SET = G.C.SECONDARY_SET or {}
        G.C.SET.Trap = G.C.SET.Trap or G.C.BLACK or col
        G.C.SECONDARY_SET.Trap = G.C.SECONDARY_SET.Trap or col
    end
end

function T.list()
    local out = {}
    for _, t in ipairs(TRAPS) do if G and G.P_CENTERS and G.P_CENTERS[t.key] then out[#out + 1] = G.P_CENTERS[t.key] end end
    return out
end

local function msg(text, colour)
    pcall(function()
        local in_shop = G.shop and not G.shop.REMOVED and G.jokers
        local major = in_shop and G.jokers or G.play
        local oy = in_shop and 0 or -2.7
        local P = rawget(_G, "PORTRAIT")
        if not in_shop and P and P.on and P.on() and P.shelf_bottom and G.hand and G.hand.T and major and major.T then
            oy = (P.shelf_bottom() + 0.35 + G.hand.T.y) / 2 - (major.T.y + major.T.h / 2)
        end
        attention_text({
            text = text, scale = 0.6, hold = 2.2, major = major, align = "cm",
            maxw = major and major.T and major.T.w and major.T.w * 0.95 or nil,
            offset = {x = 0, y = oy},
            colour = colour or G.C.RED, silent = true,
        })
        play_sound("cancel", 0.8, 0.6)
    end)
    pcall(function() haptic_buzz(2) end)
end

local function opp_name(d)
    if d and type(d.from_name) == "string" and d.from_name ~= "" then return d.from_name end
    local ok, n = pcall(function() return bom_match.get_state().opp_name end)
    if ok and type(n) == "string" and n ~= "" and n ~= "Opponent" then return n end
    return L("Your Rival")
end

local function pid_name(pid)
    local ok, n = pcall(function()
        for _, p in ipairs((bom_party.S.ps or {}).players or {}) do if p.pid == pid then return p.name end end
    end)
    return ok and n or nil
end

function T.leader()
    if not party_on() then return nil end
    local ps = bom_party and bom_party.S and bom_party.S.ps
    local me = ps and ps.myId
    local best
    for _, p in ipairs((ps and ps.players) or {}) do
        if p.pid ~= me and p.alive ~= false and not p.bot then
            local lv, sc = tonumber(p.lives) or 0, tonumber(p.live and p.live.score) or 0
            if not best or lv > best.lv or (lv == best.lv and sc > best.sc) then best = {pid = p.pid, lv = lv, sc = sc, name = p.name} end
        end
    end
    return best
end

local uid = 0
local function new_id()
    uid = uid + 1
    return tostring(os.time()) .. "-" .. tostring(uid)
end

function T.arm(key)
    if not (bom_core and bom_core.send and T.BY_KEY[key]) then return end
    local m = {type = "sabotage", sabotage_id = "trap_set", key = key, id = new_id(), r = T.RULES}
    local target = T.leader()
    if target then m.to = target.pid end
    bom_core.send(m)
    if G and G.GAME then G.GAME.bom_sabotages_used = (G.GAME.bom_sabotages_used or 0) + 1 end
    local who = target and target.name or opp_name(nil)
    msg(string.format(L("Trap set on %s!"), who), G.C.GREEN)
end

local function armed()
    G.GAME.mp_traps = G.GAME.mp_traps or {}
    return G.GAME.mp_traps
end

local function ante() return (G.GAME.round_resets and G.GAME.round_resets.ante) or 1 end

local function gone(a)
    if a and (a.r or 1) >= T.RULES and bom_core and bom_core.send then
        bom_core.send({type = "sabotage", sabotage_id = "trap_gone", key = a.key, id = a.id, to = a.from})
    end
end

function T.on_set(d)
    if not (G and G.GAME and G.GAME.multiplayer) then return end
    local key = d.key
    if not T.BY_KEY[key] then return end
    local list = armed()
    list[#list + 1] = {key = key, id = d.id, from = d.from, from_name = d.from_name, ante = ante(), r = tonumber(d.r) or 1}
    while #list > T.MAX_ARMED do gone(table.remove(list, 1)) end
    if d.from_name then msg(string.format(L("%s set a trap on you!"), d.from_name)) else msg(L("Your Rival set a trap!")) end
end

function T.waiting()
    if not (G and G.GAME and G.GAME.mp_traps) then return 0 end
    return #G.GAME.mp_traps
end

local function free_slot()
    return G.consumeables and #G.consumeables.cards + (G.GAME.consumeable_buffer or 0) < G.consumeables.config.card_limit
end

