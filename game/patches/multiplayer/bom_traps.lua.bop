local SUITS = {"Spades", "Hearts", "Clubs", "Diamonds"}

local EFFECT = {}
function EFFECT.discard()
    if (G.GAME.current_round.discards_left or 0) > 0 then ease_discard(-1) else ease_dollars(-math.min(2, math.max(0, G.GAME.dollars or 0))) end
end
function EFFECT.reroll()
    local n = math.min(3, math.max(0, G.GAME.dollars or 0))
    if n > 0 then ease_dollars(-n) end
    return {amount = n}
end
function EFFECT.buy(data)
    local card = data and data.card
    if card and card.set_rental and not card.ability.eternal and not card.ability.rental then
r 13 2145 %20%20%20%20%20%20%20%20 -
l 5
        card.ability.mp_trap_rental = (G.GAME.round or 0) + T.RENTAL_ROUNDS
    end
end
function EFFECT.boss()
    if G.hand and G.hand.change_size then
r 2 188 %20%20%20%20%20%20%20%20 -
l 256
        G.GAME.mp_trap_handsize = (G.GAME.mp_trap_handsize or 0) + 1
    end
end
function EFFECT.pack(data)
    local card = data and data.card
    if card and card.ability then
        local floor = math.max(1, (card.config.center.config and card.config.center.config.choose) or 1)
        card.ability.extra = math.max(floor, (card.ability.extra or 2) - 1)
    end
end
function EFFECT.big_hand(data)
    local h = data and data.hand
    if h and G.GAME.hands[h] and (G.GAME.hands[h].level or 1) > 1 then level_up_hand(nil, h, true, -1) end
end
function EFFECT.flush()
    local count = {}
    for _, c in ipairs(G.playing_cards or {}) do
        local s = c.base and c.base.suit
        if s then count[s] = (count[s] or 0) + 1 end
    end
    local top, n = nil, -1
    for _, s in ipairs(SUITS) do if (count[s] or 0) > n then top, n = s, count[s] or 0 end end
    if not top then return end
    local pool = {}
    for _, c in ipairs(G.playing_cards) do if c.base and c.base.suit == top then pool[#pool + 1] = c end end
    for i = 1, math.min(2, #pool) do
        local j = math.floor(pseudorandom("mp_trap_smudge" .. i) * #pool) + 1
        local c = table.remove(pool, j)
        local others = {}
        for _, s in ipairs(SUITS) do if s ~= top then others[#others + 1] = s end end
        local to = others[math.floor(pseudorandom("mp_trap_smudge_s" .. i) * #others) + 1]
        if c and to and c.change_suit then c:change_suit(to) end
    end
end

local CAN = {}
function CAN.buy(data)
    local card = data and data.card
    return card and card.set_rental and card.ability and not card.ability.eternal and not card.ability.rental and true or false
end
function CAN.pack(data)
    local card = data and data.card
    if not (card and card.ability) then return false end
    local floor = math.max(1, (card.config.center.config and card.config.center.config.choose) or 1)
    return (card.ability.extra or 2) - 1 >= floor
end
function CAN.big_hand(data)
    local h = data and data.hand
    return h and G.GAME.hands[h] and (G.GAME.hands[h].level or 1) > 1 or false
end

local LATE = {discard = true, reroll = true}

local function new_rules(a) return (a.r or 1) >= T.RULES end
local function old_rules(a) return not new_rules(a) end

local REWARD = {}
function REWARD.skip(d) if d.tag and G.P_TAGS and G.P_TAGS[d.tag] then add_tag(Tag(d.tag)) end end
function REWARD.reroll(d) local n = math.max(0, math.min(3, tonumber(d.amount) or 3)); if n > 0 then ease_dollars(n) end end
function REWARD.planet(d) if d.hand and G.GAME.hands[d.hand] then level_up_hand(nil, d.hand, true, 1) end end
function REWARD.tarot(d) if d.card and G.P_CENTERS[d.card] then give_consumable("Tarot", d.card) end end
function REWARD.sell(d) local n = math.max(0, math.min(8, tonumber(d.amount) or 0)); if n > 0 then ease_dollars(n) end end
function REWARD.spectral() give_consumable("Tarot", nil) end

function T.fire(trigger, data, pick)
    if not T.enabled() or not G.GAME.mp_traps then return false end
    local list = G.GAME.mp_traps
    for i, a in ipairs(list) do
        local t = T.BY_KEY[a.key]
        if t and t.trigger == trigger and (not pick or pick(a)) and (old_rules(a) or not CAN[trigger] or CAN[trigger](data)) then
            table.remove(list, i)
            local function go()
                local extra
                if EFFECT[trigger] then
                    local ok, r = pcall(EFFECT[trigger], data)
                    if ok then extra = r end
                end
                local out = {type = "sabotage", sabotage_id = "trap_fire", key = a.key, id = a.id, to = a.from}
                for k, v in pairs(extra or {}) do out[k] = v end
                for k, v in pairs((data and data.send) or {}) do out[k] = v end
                if bom_core and bom_core.send then bom_core.send(out) end
            end
            if LATE[trigger] and new_rules(a) and G.E_MANAGER then
                G.E_MANAGER:add_event(Event({func = function() go() return true end}))
            else
                go()
            end
            local owner = a.from_name or opp_name(nil)
            msg(string.format(L("%s's %s went off!"), owner, T.name(a.key)))
            return true
        end
    end
    return false
end

function T.on_fire(d)
    if not (G and G.GAME and G.GAME.multiplayer) then return end
    local t = T.BY_KEY[d.key]
    if not t then return end
    if REWARD[t.trigger] then pcall(REWARD[t.trigger], d) end
    local who = d.from_name or pid_name(d.from) or opp_name(nil)
    msg(string.format(L("Your %s went off on %s!"), T.name(d.key), who), G.C.GREEN)
end

function T.on_gone(d)
    if not (G and G.GAME and G.GAME.multiplayer) then return end
    if not T.BY_KEY[d.key] then return end
    local who = d.from_name or pid_name(d.from) or opp_name(nil)
    msg(string.format(L("Your %s on %s ran out"), T.name(d.key), who), G.C.ORANGE)
end

function T.receive(d)
    if type(d) ~= "table" then return nil end
    local id = d.sabotage_id
    if type(id) ~= "string" then return true end
    if id:sub(1, 4) == "mpj_" then return nil end
    if id == "trap_set" then pcall(T.on_set, d) return true end
    if id == "trap_fire" then pcall(T.on_fire, d) return true end
    if id == "trap_gone" then pcall(T.on_gone, d) return true end
    return true
end

function T.receive_heckle() end
function T.show_pick_screen() end
function T.send() end
function T.get_all() return {} end

local BIG = {["Full House"] = true, ["Four of a Kind"] = true, ["Straight Flush"] = true, ["Five of a Kind"] = true, ["Flush House"] = true, ["Flush Five"] = true}
local FLUSH = {["Flush"] = true, ["Straight Flush"] = true, ["Flush House"] = true, ["Flush Five"] = true}

local played = nil
local boss_seen = nil

local function watch_hands()
    local hands = G.GAME.hands
    if not hands then return end
    if not played then
        played = {}
        for k, v in pairs(hands) do played[k] = v.played or 0 end
        return
    end
    for k, v in pairs(hands) do
        local n = v.played or 0
        if n > (played[k] or 0) then
            played[k] = n
            if FLUSH[k] then T.fire("flush", {hand = k}) end
            if BIG[k] then T.fire("big_hand", {hand = k}) end
        elseif n < (played[k] or 0) then
            played[k] = n
        end
    end
end

function T.update()
    if not (G and G.GAME) then return end
    if T._game ~= G.GAME then
        T._game = G.GAME
        played, boss_seen = nil, nil
    end
    if G.GAME.mp_trap_pack and G.STATE ~= G.STATES.PLANET_PACK and not (G.pack_cards and G.pack_cards.cards and #G.pack_cards.cards > 0) then
        G.GAME.mp_trap_pack = nil
    end
    if G.STATE == G.STATES.SHOP and G.jokers and G.jokers.cards then
        for _, c in ipairs(G.jokers.cards) do
            local until_round = c.ability and c.ability.mp_trap_rental
            if until_round and (G.GAME.round or 0) >= until_round then
                c.ability.mp_trap_rental = nil
                if c.ability.rental and c.set_rental then c:set_rental(false) end
            end
        end
    end
    if (G.GAME.mp_trap_handsize or 0) > 0 and G.STATE == G.STATES.SHOP and G.hand and G.hand.change_size then
        G.hand:change_size(G.GAME.mp_trap_handsize)
        G.GAME.mp_trap_handsize = 0
    end
    if not T.enabled() then played = nil return end
    if G.GAME.mp_traps then
        local a = ante()
        for i = #G.GAME.mp_traps, 1, -1 do
            if a > (G.GAME.mp_traps[i].ante or a) + T.LIFETIME then gone(table.remove(G.GAME.mp_traps, i)) end
        end
    end
    pcall(watch_hands)
    local blind = G.GAME.blind
    local key = blind and blind.boss and G.STATE == G.STATES.SELECTING_HAND and (tostring(ante()) .. ":" .. tostring(blind.config and blind.config.blind and blind.config.blind.key))
    if key and boss_seen ~= key then
        boss_seen = key
        T.fire("boss", nil, old_rules)
    end
end

local function pick_keys(n)
    local pool = {}
    for _, t in ipairs(TRAPS) do pool[#pool + 1] = t.key end
    local out = {}
    for i = 1, math.min(n, #pool) do
        local j = math.floor(pseudorandom(pseudoseed("mp_trap" .. ante() .. i)) * #pool) + 1
        out[#out + 1] = table.remove(pool, j)
    end
    return out
end

local function install()
    if T.installed then return end
    T.installed = true

    local orig_create_card = create_card
    create_card = function(_type, area, legendary, _rarity, skip_materialize, soulable, forced_key, key_append)
        if G and G.GAME and G.GAME.mp_trap_pack and _type == "Planet" and area == G.pack_cards then
            G.GAME.mp_trap_queue = G.GAME.mp_trap_queue or {}
            if #G.GAME.mp_trap_queue == 0 then G.GAME.mp_trap_queue = pick_keys(4) end
            local k = table.remove(G.GAME.mp_trap_queue, 1)
            return orig_create_card("Trap", area, nil, nil, skip_materialize, nil, k, "mptrap")
        end
        return orig_create_card(_type, area, legendary, _rarity, skip_materialize, soulable, forced_key, key_append)
    end

    local orig_get_pack = get_pack
    get_pack = function(_key, _type)
        if _key == "shop_pack" and not _type and G.GAME.first_shop_buffoon and T.enabled() and G.P_CENTERS[T.PACK]
            and not (G.GAME.banned_keys and G.GAME.banned_keys[T.PACK])
            and pseudorandom(pseudoseed("mp_trap_pack" .. ante())) < T.PACK_CHANCE then
            return G.P_CENTERS[T.PACK]
        end
        return orig_get_pack(_key, _type)
    end

    local orig_open = Card.open
    function Card:open()
        if self.ability and self.ability.set == "Booster" then
            if self.config.center and self.config.center.mp_trap_pack then
                G.GAME.mp_trap_pack = true
                G.GAME.mp_trap_queue = pick_keys(math.max(2, self.ability.extra or 2))
                self.ability.name = "Celestial Trap Pack"
            else
                T.fire("pack", {card = self})
            end
        end
        return orig_open(self)
    end

    local orig_celestial_ui = create_UIBox_celestial_pack
    if orig_celestial_ui then
        create_UIBox_celestial_pack = function(...)
            local dict = G.localization and G.localization.misc and G.localization.misc.dictionary
            if not (G.GAME and G.GAME.mp_trap_pack and dict and dict.k_trap_pack) then return orig_celestial_ui(...) end
            local title = dict.k_celestial_pack
            dict.k_celestial_pack = dict.k_trap_pack
            local ok, ui = pcall(orig_celestial_ui, ...)
            dict.k_celestial_pack = title
            if not ok then error(ui) end
            return ui
        end
    end

    local orig_can_use = Card.can_use_consumeable
r 3 1523 %20%20%20%20 -
l 8
        if self.ability and self.ability.set == "Trap" then
            if not skip_check and ((G.play and #G.play.cards > 0) or G.CONTROLLER.locked or (G.GAME.STOP_USE and G.GAME.STOP_USE > 0)) then return false end
            return true
        end
        return orig_can_use(self, any_state, skip_check)
    end

    local orig_use = Card.use_consumeable
r 3 1091 %20%20%20%20 -
l 16
        local set = self.ability and self.ability.set
        if set == "Trap" then
            T.arm(self.config.center.key)
            return
        end
        if set == "Planet" then
            T.fire("planet", {send = {hand = self.ability.consumeable and self.ability.consumeable.hand_type}})
        elseif set == "Tarot" then
            T.fire("tarot", {send = {card = self.config.center.key}})
        elseif set == "Spectral" then
            T.fire("spectral")
        end
        return orig_use(self, area, copier)
    end

    local orig_sell = Card.sell_card
r 3 1590 %20%20%20%20 -
l 6
        if self.ability and self.ability.set == "Joker" then T.fire("sell", {send = {amount = math.min(8, self.sell_cost or 0)}}) end
        return orig_sell(self)
    end

    if Blind and Blind.set_blind then
        local orig_set_blind = Blind.set_blind
r 2 78 %20%20%20%20%20%20%20%20 -
l 57
            local r = orig_set_blind(self, blind, reset, silent)
            if blind and not reset and self.boss and G.GAME and self == G.GAME.blind then T.fire("boss", nil, new_rules) end
            return r
        end
    end

    local orig_gen = generate_card_ui
    generate_card_ui = function(_c, full_UI_table, specific_vars, card_type, badges, hide_desc, main_start, main_end, ...)
        if type(_c) == "table" and (_c.mp_trap or _c.mp_trap_pack) then
            local proxy = setmetatable({set = "Other"}, {__index = _c})
            local r = orig_gen(proxy, full_UI_table, specific_vars, card_type, badges, hide_desc, main_start, main_end, ...)
            if _c.mp_trap_pack and type(r) == "table" and (not r.name or (type(r.name) == "table" and next(r.name) == nil)) then
                r.name = localize{type = "name", set = "Other", key = _c.key}
            end
            return r
        end
        return orig_gen(_c, full_UI_table, specific_vars, card_type, badges, hide_desc, main_start, main_end, ...)
    end

    T.wrap_funcs()
end

function T.wrap_funcs()
    if not G or not G.FUNCS or T.funcs_wrapped then return end
    T.funcs_wrapped = true
    local orig_discard = G.FUNCS.discard_cards_from_highlighted
    if orig_discard then
        G.FUNCS.discard_cards_from_highlighted = function(e, hook, ...)
            local r = orig_discard(e, hook, ...)
            if not hook then T.fire("discard") end
            return r
        end
    end
    local orig_skip = G.FUNCS.skip_blind
    if orig_skip then
        G.FUNCS.skip_blind = function(e, ...)
            local tag
            pcall(function() tag = G.GAME.round_resets.blind_tags[G.GAME.blind_on_deck] end)
            local r = orig_skip(e, ...)
            T.fire("skip", {send = {tag = tag}})
            return r
        end
    end
    local orig_reroll = G.FUNCS.reroll_shop
    if orig_reroll then
        G.FUNCS.reroll_shop = function(e, ...)
            local r = orig_reroll(e, ...)
            T.fire("reroll")
            return r
        end
    end
    local orig_buy = G.FUNCS.buy_from_shop
    if orig_buy then
        G.FUNCS.buy_from_shop = function(e, ...)
            local card = e and e.config and e.config.ref_table
            local r = orig_buy(e, ...)
            if card and card.ability and card.ability.set == "Joker" then
r 3 617 %20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20 -
l 27
                    if card.area == G.jokers then T.fire("buy", {card = card}) end
                    return true
                end}))
            end
            return r
        end
    end
end

function T.init()
    if T.initialized then
        register_centers()
        return
    end
    register_centers()
    register_loc()
    pcall(function() bom_custom_objects.inject_loc() end)
    T.inject_misc()
    pcall(install)
    pcall(function()
        if bom_events and bom_events.register then bom_events.register("sabotage", T.receive) end
    end)
    T.initialized = true
end

if mp_log then mp_log.info("BOM_TRAPS", "trap cards module loaded") end
return T
end
