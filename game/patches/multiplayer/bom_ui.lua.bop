-- Deferred: G may be nil at require() time; register callback once G.FUNCS exists
function bom_ui.register_funcs()
    if not G or not G.FUNCS then return end
    G.ESC_BACK_FUNCS = G.ESC_BACK_FUNCS or {}
    for _, name in ipairs({"bom_back_to_lobby", "bom_contest_cancel", "mp_browse_back", "mp_browse_reopen", "mp_cancel_connecting", "mp_cancel_room",
        "mp_cancel_search", "mp_cancel_waiting", "mp_decline_rematch", "mp_lobby_leave", "mpm_coll_back", "mpm_mods_back", "mp_mods_no", "mpm_open_play",
        "mpm_profile_back", "mp_name_cancel", "mp_ranked_back", "mp_ranked_coll_return", "mps_chat_back", "mps_chat_optin_back",
        "mps_chat_report_back", "mp_version_ok", "open_multiplayer_menu", "party_leave", "party_back_to_results", "social_back",
        "social_invite_later", "spec_close"}) do
        G.ESC_BACK_FUNCS[name] = true
    end
    if G.FUNCS.open_multiplayer_menu and G.FUNCS.mp_return_to_lobby and G.FUNCS.mp_leave_lobby then return end

    -- FEATURE: Main menu Multiplayer button — opens create/join lobby flow
