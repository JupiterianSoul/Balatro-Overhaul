-- ============================================
-- DRAW — Online status indicator + HUD refresh
-- ============================================
-- ============================================
-- FEATURE: PVP WAITING OVERLAY — "Waiting for opponent..." during PvP resolve
-- Shown after player finishes all hands; dismissed when server sends pvp_resolved
-- ============================================

function bom_ui.show_pvp_waiting(message)
    if not G or not G.ROOM_ATTACH then return end
    bom_ui.hide_pvp_waiting() -- remove any existing one first
    local pb = rawget(_G, "bom_playback")
    if pb and pb.active and pb.active() then return end

    message = message or mod_loc("Waiting for opponent to finish...")
    bom_ui._pvp_wait_msg = message
    if bom_spectate and bom_spectate.defer_wait and bom_spectate.defer_wait() then return end

    pcall(function()
        -- FIX: Simple centered panel — draws on top via attention_text flag
        local lines = {}
        for line in (tostring(message) .. "\n"):gmatch("(.-)\n") do
            if line ~= "" then lines[#lines + 1] = line end
        end
        local scale = 0.5
        local widest = 0
        for _, line in ipairs(lines) do
            local w = UIK and UIK.text_w and UIK.text_w(line, scale) or #line * scale * 0.3
            if w > widest then widest = w end
        end
        local room_w = (G.ROOM and G.ROOM.T and G.ROOM.T.w or 20) * 0.9 - 0.8
        if widest > room_w and widest > 0 then
            scale = scale * room_w / widest
            widest = room_w
        end
        local rows = {}
        local spec = bom_spectate and bom_spectate.wait_allowed and G.FUNCS.spec_wait and bom_spectate.wait_allowed()
        for i, line in ipairs(lines) do
            rows[#rows + 1] = { n = G.UIT.R, config = { align = "cm", padding = 0.03 }, nodes = {
                { n = G.UIT.T, config = { text = line, scale = i == 1 and scale or scale * 0.8, colour = i == 1 and G.C.UI.TEXT_LIGHT or G.C.UI.TEXT_INACTIVE, shadow = true } },
            }}
        end
        local mg = rawget(_G, "Minigames") and Minigames.wait_row and Minigames.wait_row()
        if spec then
            local touch = UIK.touch()
            local sc = touch and 0.42 or 0.36
            local bh = touch and 0.8 or 0.62
            local label = mod_loc("Spectate")
            local sw = math.max(touch and 2.2 or 1.9, UIK.text_w(label, sc) + 0.5)
            local play = mod_loc("Play while you wait")
            local mw = math.max(touch and 3.3 or 2.9, UIK.text_w(play, sc) + 0.5)
            local side = mg and sw + mw + 0.5 <= room_w
            local btn = UIK.button{ label = label, button = "spec_wait", colour = UIK.C.accent, w = (mg and not side) and mw or sw, h = bh, scale = sc, id = "spec_wait", col = side or nil }
            if side then
                rows[#rows + 1] = { n = G.UIT.R, config = { align = "cm", padding = 0.08 }, nodes = {
                    btn, { n = G.UIT.C, config = { minw = 0.04 } }, { n = G.UIT.C, config = { align = "cm" }, nodes = mg.nodes },
                }}
                mg = nil
            else
                rows[#rows + 1] = { n = G.UIT.R, config = { align = "cm", padding = 0.08 }, nodes = { btn } }
            end
        end
        if mg then rows[#rows + 1] = mg end
        G.BOM_PVP_WAITING_OVERLAY = UIBox({
            definition = {
                n = G.UIT.ROOT,
                config = { align = "cm", colour = G.C.CLEAR, padding = 0 },
                nodes = {
                    { n = G.UIT.C, config = { align = "cm", colour = G.C.BLACK, r = 0.15, padding = 0.3, emboss = 0.08, minw = math.min(widest + 0.6, 4) }, nodes = rows },
                },
            },
            config = { align = "cm", offset = { x = 0, y = 0.2 }, major = G.ROOM_ATTACH },
        })
        -- Flag so game.lua draws this above all normal UI (attention_text layer)
        G.BOM_PVP_WAITING_OVERLAY.attention_text = true
    end)
end

function bom_ui.hide_pvp_waiting()
    if not G then return end
    if G.BOM_PVP_WAITING_OVERLAY then
        pcall(function() G.BOM_PVP_WAITING_OVERLAY:remove() end)
        G.BOM_PVP_WAITING_OVERLAY = nil
    end
end

function bom_ui.draw()
    pcall(function() bom_ui.register_funcs() end)
    local connected = AndroidWS and AndroidWS.isConnected and AndroidWS.isConnected()

    -- FIX: Show OFFLINE on the main menu even when WS is connected.
    -- Status should only display ONLINE while inside a lobby or match.
    -- This is purely cosmetic; the WS stays alive in the background.
    local in_mp_context = false
    pcall(function()
        local phase = bom_match and bom_match.get_phase and bom_match.get_phase()
        if phase and phase ~= "" and phase ~= "idle" and phase ~= "none" then
            in_mp_context = true
        end
    end)
    if bom_rejoin and bom_rejoin.prompt then in_mp_context = true end
    if not in_mp_context then connected = false end
    -- ARCH: Online status position from mp_config
    local x, y = mp_config and mp_config.STATUS_INDICATOR_X or 18, mp_config and mp_config.STATUS_INDICATOR_Y or 18
    local status_text = mod_loc and mod_loc(connected and "ONLINE" or "OFFLINE") or (connected and "ONLINE" or "OFFLINE")
    local show_status = not (G and G.SETTINGS and G.SETTINGS.GRAPHICS and G.SETTINGS.GRAPHICS.show_online_status == false)
    if CORNER_LABELS then CORNER_LABELS.status_box = nil end
    if show_status and CORNER_LABELS then
        local bw, bh, bx, by = CORNER_LABELS.draw(status_text, x, y, {scale = CORNER_LABELS.scale(),
            colour = connected and {0.2, 0.95, 0.35, 1} or {1, 0.25, 0.25, 1}})
        CORNER_LABELS.status_box = {x = bx, y = by, w = bw, h = bh}
        show_status = false
    end
    local font = show_status and love.graphics.getFont()
    local text_w = font and font:getWidth(status_text) or 60
    local text_h = font and font:getHeight() or 14
    local pad_x, pad_y = 6, 4

    if show_status then
    love.graphics.setColor(0, 0, 0, 0.75)
    love.graphics.rectangle("fill", x, y, text_w + pad_x*2, text_h + pad_y*2, 4, 4)

    if connected then
        love.graphics.setColor(0.2, 0.95, 0.35, 1)
    else
        love.graphics.setColor(1, 0.25, 0.25, 1)
    end
    love.graphics.print(status_text, x + pad_x, y + pad_y)

    love.graphics.setColor(1, 1, 1, 1)
    end

    -- Refresh the Balatro UIBox HUD (no-op stub via bom_ui_hud sub-module)
    pcall(function() bom_ui.refresh_match_hud() end)
end

-- ============================================
-- SUB-MODULE OVERRIDE — Load after legacy bodies so sub-module versions win
-- FEATURE: Stage 3 split — bom_ui_lobby, bom_ui_hud, bom_ui_results, bom_ui_overlays
-- ============================================
require("multiplayer.bom_ui_lobby").init(bom_ui)
require("multiplayer.bom_ui_hud").init(bom_ui)
require("multiplayer.bom_ui_results").init(bom_ui)
require("multiplayer.bom_ui_overlays").init(bom_ui)

mp_log.info("BOM_UI", "Multiplayer UI module loaded")
return bom_ui
end
