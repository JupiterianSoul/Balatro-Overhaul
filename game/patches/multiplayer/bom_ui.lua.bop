-- ============================================
-- JOIN ROOM — Text input overlay for entering room code
-- FIX: Rebuilt to use the same UI style as Profile name change (main menu):
--      clean create_text_input with keyboard_offset=2, w=4, minimal wrapper.
-- ============================================

function create_UIBox_join_room_input(opts)
    opts = opts or {}
    _mp_join_input.room_code = ""

    G.FUNCS.mp_confirm_join_room = function(e)
        local code = _mp_join_input.room_code or ""
        code = code:upper():match("^%s*(.-)%s*$") or ""
        if code == "" then return end
        if bom_ui and bom_ui.show_connecting_screen then
            bom_ui.show_connecting_screen()
        end
        if bom_room and bom_room.join then
            bom_room.join(code, { id = opts.id, from_browse = opts.id ~= nil })
        end
    end

    local contents = {
        -- Same minh/padding pattern as profile_option name row
        {n = G.UIT.R, config = {align = "cm", minh = 0.8, padding = 0.1}, nodes = {
            create_text_input({
                w = 4, max_length = 4,
                prompt_text = mod_loc("Room Code"),
                ref_table = _mp_join_input, ref_value = "room_code",
                extended_corpus = true, strict_corpus = true,
                keyboard_offset = 2,
            }),
        }},
        {n = G.UIT.R, config = {align = "cm", padding = 0.1}, nodes = {
            UIBox_button({
                button = "mp_confirm_join_room",
                label = {mod_loc("JOIN")},
                minw = 4, minh = 0.8,
                colour = G.C.GREEN,
                scale = 0.5,
            }),
        }},
    }
    if opts.title then
        table.insert(contents, 1, {n = G.UIT.R, config = {align = "cm", padding = 0.1}, nodes = {
            {n = G.UIT.T, config = {text = opts.title, scale = 0.5, colour = G.C.GOLD, shadow = true}},
        }})
    end
    return create_UIBox_generic_options({ back_func = opts.back or "open_multiplayer_menu", contents = contents })
end

