function bom_ui.show_pvp_waiting(message)
    if not G or not G.ROOM_ATTACH then return end
    bom_ui.hide_pvp_waiting()
    local pb = rawget(_G, "bom_playback")
    if pb and pb.active and pb.active() then return end

    message = message or mod_loc("Waiting for opponent to finish...")
    bom_ui._pvp_wait_msg = message
    if bom_spectate and bom_spectate.defer_wait and bom_spectate.defer_wait() then return end

    pcall(function()
        local lines = {}
        for line in (tostring(message) .. "\n"):gmatch("(.-)\n") do
            if line ~= "" then lines[#lines + 1] = line end
        end
        local scale = 0.5
        local widest = 0
        for _, line in ipairs(lines) do
            local w = UIK and UIK.text_w and UIK.text_w(line, scale) or #line * scale * 0.3
            if w > widest then widest = w end
        end
        local room_w = (G.ROOM and G.ROOM.T and G.ROOM.T.w or 20) * 0.9 - 0.8
        if widest > room_w and widest > 0 then
            scale = scale * room_w / widest
            widest = room_w
        end
        local rows = {}
        local spec = bom_spectate and bom_spectate.wait_allowed and G.FUNCS.spec_wait and bom_spectate.wait_allowed()
        for i, line in ipairs(lines) do
            rows[#rows + 1] = { n = G.UIT.R, config = { align = "cm", padding = 0.03 }, nodes = {
                { n = G.UIT.T, config = { text = line, scale = i == 1 and scale or scale * 0.8, colour = i == 1 and G.C.UI.TEXT_LIGHT or G.C.UI.TEXT_INACTIVE, shadow = true } },
            }}
        end
        local mg = rawget(_G, "Minigames") and Minigames.wait_row and Minigames.wait_row()
        if spec then
            local touch = UIK.touch()
            local sc = touch and 0.42 or 0.36
            local bh = touch and 0.8 or 0.62
            local label = mod_loc("Spectate")
            local sw = math.max(touch and 2.2 or 1.9, UIK.text_w(label, sc) + 0.5)
            local play = mod_loc("Play while you wait")
            local mw = math.max(touch and 3.3 or 2.9, UIK.text_w(play, sc) + 0.5)
            local side = mg and sw + mw + 0.5 <= room_w
            local btn = UIK.button{ label = label, button = "spec_wait", colour = UIK.C.accent, w = (mg and not side) and mw or sw, h = bh, scale = sc, id = "spec_wait", col = side or nil }
            if side then
                rows[#rows + 1] = { n = G.UIT.R, config = { align = "cm", padding = 0.08 }, nodes = {
                    btn, { n = G.UIT.C, config = { minw = 0.04 } }, { n = G.UIT.C, config = { align = "cm" }, nodes = mg.nodes },
                }}
                mg = nil
            else
                rows[#rows + 1] = { n = G.UIT.R, config = { align = "cm", padding = 0.08 }, nodes = { btn } }
            end
        end
        if mg then rows[#rows + 1] = mg end
        G.BOM_PVP_WAITING_OVERLAY = UIBox({
            definition = {
                n = G.UIT.ROOT,
                config = { align = "cm", colour = G.C.CLEAR, padding = 0 },
                nodes = {
                    { n = G.UIT.C, config = { align = "cm", colour = G.C.BLACK, r = 0.15, padding = 0.3, emboss = 0.08, minw = math.min(widest + 0.6, 4) }, nodes = rows },
                },
            },
            config = { align = "cm", offset = { x = 0, y = 0.2 }, major = G.ROOM_ATTACH },
        })
        G.BOM_PVP_WAITING_OVERLAY.attention_text = true
    end)
end

function bom_ui.hide_pvp_waiting()
    if not G then return end
    if G.BOM_PVP_WAITING_OVERLAY then
        pcall(function() G.BOM_PVP_WAITING_OVERLAY:remove() end)
        G.BOM_PVP_WAITING_OVERLAY = nil
    end
end

local reach = {ok = nil, at = -1e9, busy = false}

local function ping_server()
    if not (ModWorkshop and ModWorkshop.request) then return end
    local now = love.timer.getTime()
    if reach.busy and now - reach.at < 60 then return end
    if now - reach.at < (reach.ok and 120 or 20) then return end
    reach.busy = true
    reach.at = now
    local cfg = rawget(_G, "mp_config")
    local ws = tostring(cfg and cfg.SERVER_URL or "")
    local url = ws:gsub("^wss://", "https://"):gsub("^ws://", "http://"):gsub("/ws/?$", "") .. "/ping"
    local ok = pcall(ModWorkshop.request, "get", {lane = "update", url = url}, function(res)
        reach.busy = false
        reach.ok = type(res) == "table" and res.ok == true
    end)
    if not ok then reach.busy = false end
end

local STATUS_ONLINE, STATUS_OFFLINE, STATUS_OPTS, status_box = {0.2, 0.95, 0.35, 1}, {1, 0.25, 0.25, 1}, {}, {}
local register_next = 0

local function mp_phase_active()
    local phase = bom_match and bom_match.get_phase and bom_match.get_phase()
    return phase and phase ~= "" and phase ~= "idle" and phase ~= "none"
end

function bom_ui.draw()
    local now = love.timer.getTime()
    if now >= register_next or not (G and G.FUNCS and G.FUNCS.open_multiplayer_menu) then
        register_next = now + 1
        pcall(bom_ui.register_funcs)
    end
    local connected = AndroidWS and AndroidWS.isConnected and AndroidWS.isConnected()

    local in_mp_context = false
    local okp, active = pcall(mp_phase_active)
    if okp and active then in_mp_context = true end
    if bom_rejoin and bom_rejoin.prompt then in_mp_context = true end
    if not in_mp_context then
        pcall(ping_server)
        connected = reach.ok == true
    end
    local x, y = mp_config and mp_config.STATUS_INDICATOR_X or 18, mp_config and mp_config.STATUS_INDICATOR_Y or 18
    local status_text = mod_loc and mod_loc(connected and "ONLINE" or "OFFLINE") or (connected and "ONLINE" or "OFFLINE")
    local show_status = not (G and G.SETTINGS and G.SETTINGS.GRAPHICS and G.SETTINGS.GRAPHICS.show_online_status == false)
    if CORNER_LABELS then CORNER_LABELS.status_box = nil end
    if show_status and CORNER_LABELS then
        STATUS_OPTS.scale, STATUS_OPTS.colour = CORNER_LABELS.scale(), connected and STATUS_ONLINE or STATUS_OFFLINE
        local bw, bh, bx, by = CORNER_LABELS.draw(status_text, x, y, STATUS_OPTS)
        status_box.x, status_box.y, status_box.w, status_box.h = bx, by, bw, bh
        CORNER_LABELS.status_box = status_box
        show_status = false
    end
    local font = show_status and love.graphics.getFont()
    local text_w = font and font:getWidth(status_text) or 60
    local text_h = font and font:getHeight() or 14
    local pad_x, pad_y = 6, 4

    if show_status then
    love.graphics.setColor(0, 0, 0, 0.75)
    love.graphics.rectangle("fill", x, y, text_w + pad_x*2, text_h + pad_y*2, 4, 4)

    if connected then
        love.graphics.setColor(0.2, 0.95, 0.35, 1)
    else
        love.graphics.setColor(1, 0.25, 0.25, 1)
    end
    love.graphics.print(status_text, x + pad_x, y + pad_y)

    love.graphics.setColor(1, 1, 1, 1)
    end

    pcall(function() bom_ui.refresh_match_hud() end)
end

require("multiplayer.bom_ui_lobby").init(bom_ui)
require("multiplayer.bom_ui_hud").init(bom_ui)
require("multiplayer.bom_ui_results").init(bom_ui)
function bom_ui.on_top(box)
    if type(box) == "table" then
        box.attention_text = true
        box.over_overlay = true
    end
    return box
end

bom_ui.TOP_TEXT_WAIT = 30
bom_ui.TOP_TEXT_GAP = 0.08
local top_live = {}

local function top_rgba(c)
    return {c[1], c[2], c[3], c[4] or 1}
end

function bom_ui.top_text_y(h, want, mid, lo, hi, ov, keep)
    if not ov then return want end
    local gap = bom_ui.TOP_TEXT_GAP
    local function free(y)
        local top, bot = mid + y - h / 2, mid + y + h / 2
        if top < lo or bot > hi then return false end
        return bot + gap <= ov.y or top - gap >= ov.y + ov.h
    end
    if free(want) then return want end
    if keep and free(keep) then return keep end
    local above = (lo + ov.y) / 2 - mid
    if free(above) then return above end
    local below = (ov.y + ov.h + hi) / 2 - mid
    if free(below) then return below end
    return nil
end

local function top_band(room)
    local lo, hi = room.y, room.y + room.h
    pcall(function()
        local unit = G.TILESIZE * G.TILESCALE
        local sh = love.graphics.getHeight() / unit
        if G.ROOM and G.ROOM.T and sh > 0 then
            lo = room.y - G.ROOM.T.y
            hi = lo + sh
        end
    end)
    return room.y + room.h / 2, lo, hi
end

local function top_panel(node, room, acc, depth)
    local t = node and node.T
    if not t or depth > 12 then return acc end
    if node.states and node.states.visible == false then return acc end
    local c = node.config or {}
    local drawn = c.button or c.object or (type(c.colour) == "table" and (c.colour[4] or 1) > 0.01)
    if not drawn or t.w > room.w * 1.2 or t.h > room.h * 1.2 then
        for _, ch in pairs(node.children or {}) do
            if type(ch) == "table" then acc = top_panel(ch, room, acc, depth + 1) end
        end
        return acc
    end
    if t.w <= 0 or t.h <= 0 then return acc end
    if not acc then return {x = t.x, y = t.y, w = t.w, h = t.h} end
    local y0, y1 = math.min(acc.y, t.y), math.max(acc.y + acc.h, t.y + t.h)
    local x0, x1 = math.min(acc.x, t.x), math.max(acc.x + acc.w, t.x + t.w)
    return {x = x0, y = y0, w = x1 - x0, h = y1 - y0}
end

function bom_ui.overlay_rect()
    local ov, ra = G and G.OVERLAY_MENU, G and G.ROOM_ATTACH
    if not (ov and not ov.REMOVED and ov.UIRoot and ra and ra.T) then return nil end
    return top_panel(ov.UIRoot, ra.T, nil, 0) or ov.T
end

local function top_finish(e)
    e.done = true
    if e.key and top_live[e.key] == e then top_live[e.key] = nil end
    if e.particle and not e.particle.REMOVED then pcall(function() e.particle:remove() end) end
    e.particle = nil
    if e.box and not e.box.REMOVED then pcall(function() e.box:remove() end) end
end

function bom_ui.top_text_clear(key)
    local e = key and top_live[key]
    if e then top_finish(e) end
end

local function top_build(e, y)
    local a = e.args
    local items = {}
    e.texts = {}
    for i, line in ipairs(e.lines) do
        local dt = DynaText({scale = a.scale, string = line, maxw = a.maxw, colours = {e.colour}, float = true, shadow = true,
            silent = not a.noisy, pop_in = 0, pop_in_rate = 6, rotate = a.rotate or nil})
        e.texts[i] = dt
        items[i] = {n = G.UIT.O, config = {draw_layer = 1, object = dt}}
    end
    if #items > 1 then
        local rows = {}
        for i, it in ipairs(items) do rows[i] = {n = G.UIT.R, config = {align = "cm"}, nodes = {it}} end
        items = {{n = G.UIT.C, config = {align = "cm"}, nodes = rows}}
    end
    local box = UIBox{
        T = {0, 0, 0, 0},
        definition = {n = G.UIT.ROOT, config = {align = "cm", minw = 0.001, minh = 0.001, padding = 0.14, r = 0.1, emboss = a.emboss, colour = e.cover}, nodes = items},
        config = {align = a.align or "cm", offset = {x = e.x, y = y}, major = e.major},
    }
    box.attention_text = true
    box.over_overlay = true
    e.box, e.y = box, y
    a.AT = box
    for _, dt in ipairs(e.texts) do dt:pulse(0.5) end
    return box
end

local function top_backdrop(e)
    local P = rawget(_G, "Particles")
    if e.particle or not e.backdrop or not e.box or not P then return end
    e.particle = P(0, 0, 0, 0, {timer_type = "REAL", timer = 5, scale = 2.4 * (e.args.backdrop_scale or 1), lifespan = 5, speed = 0, attach = e.box, colours = {e.backdrop}})
    e.particle.created_on_pause = true
end

local function top_step(e)
    if e.done then return true end
    if e.box and e.box.REMOVED then top_finish(e) return true end
    local t = love.timer.getTime()
    local ra = G.ROOM_ATTACH
    if not (ra and ra.T) then top_finish(e) return true end
    local mid, lo, hi = top_band(ra.T)
    local ovt = bom_ui.overlay_rect()
    local function place(h, keep) return bom_ui.top_text_y(h, e.want, mid, lo, hi, ovt, keep) end
    if not e.shown_at then
        if t - e.born > bom_ui.TOP_TEXT_WAIT then top_finish(e) return true end
        local y = e.h and place(e.h)
        if e.h and not y then return false end
        local box = top_build(e, y or e.want)
        if not e.h then
            e.h = box.T.h
            y = place(e.h)
            if not y then
                box:remove()
                e.box = nil
                return false
            end
            if y ~= e.y then
                box:remove()
                top_build(e, y)
            end
        end
        if not ovt then top_backdrop(e) end
        e.shown_at = t
        return false
    end
    local y = place(e.h, e.y)
    if y and y ~= e.y then
        if e.particle and not e.particle.REMOVED then e.particle:remove() end
        e.particle = nil
        e.box:remove()
        top_build(e, y)
        if e.out_at then
            for _, dt in ipairs(e.texts) do dt:pop_out(3) end
        elseif not ovt then
            top_backdrop(e)
        end
    end
    e.box.states.visible = y ~= nil
    if ovt and e.particle then
        if not e.particle.REMOVED then e.particle:remove() end
        e.particle = nil
    end
    if not e.out_at then
        if t - e.shown_at >= e.hold then
            e.out_at = t
            for _, dt in ipairs(e.texts) do dt:pop_out(3) end
        end
        return false
    end
    local fade = math.max(0, 1 - 3 * (t - e.out_at))
    e.cover[4] = math.min(e.cover[4], 2 * fade)
    if e.backdrop then e.backdrop[4] = math.min(e.backdrop[4], fade) end
    e.colour[4] = math.min(e.colour[4], fade)
    if fade <= 0 then top_finish(e) return true end
    return false
end

function bom_ui.top_text(args)
    if not (G and G.E_MANAGER and G.ROOM_ATTACH and UIBox and DynaText) then return end
    args = args or {}
    local lines = type(args.lines) == "table" and #args.lines > 0 and args.lines or {tostring(args.text or "")}
    local offset = args.offset or {}
    local e = {
        args = args,
        key = args.key,
        lines = lines,
        colour = top_rgba(args.colour or G.C.WHITE),
        cover = top_rgba(args.box_colour or {0.08, 0.08, 0.1, 0.92}),
        backdrop = args.backdrop_colour and top_rgba(args.backdrop_colour) or nil,
        major = args.major or G.ROOM_ATTACH,
        x = offset.x or 0,
        want = offset.y or 0,
        hold = (args.hold or 0) + 0.1,
        born = love.timer.getTime(),
    }
    if e.key then
        bom_ui.top_text_clear(e.key)
        top_live[e.key] = e
    end
    G.E_MANAGER:add_event(Event({trigger = "immediate", blocking = false, blockable = false, pause_force = true, no_delete = true, func = function()
        local ok, done = pcall(top_step, e)
        if not ok then
            top_finish(e)
            return true
        end
        return done
    end}))
    return e
end

require("multiplayer.bom_ui_overlays").init(bom_ui)

mp_log.info("BOM_UI", "Multiplayer UI module loaded")
return bom_ui
end
