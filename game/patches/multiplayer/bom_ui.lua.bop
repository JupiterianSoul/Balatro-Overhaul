-- Shared table for join room text input
local _mp_join_input = { room_code = "" }

function create_UIBox_multiplayer_lobby()
    -- Register lobby callbacks — show connecting screen immediately, then connect
    G.FUNCS.mp_lobby_quick_match = function(e)
        -- FEATURE: Quick Match flag — skips settings, shows simple ready screen
        if G and G.GAME then G.GAME.bom_quick_match = true end
        if bom_ui and bom_ui.show_connecting_screen then
            bom_ui.show_connecting_screen()
        end
        if bom_room and bom_room.find_match then
            bom_room.find_match()
        end
    end

    G.FUNCS.mp_lobby_create_room = function(e)
        if bom_browse and bom_browse.show_create then
            bom_browse.show_create()
        end
    end

    G.FUNCS.mp_lobby_browse = function(e)
        if bom_browse and bom_browse.show then
            bom_browse.show()
        end
    end

    G.FUNCS.mp_lobby_join_room = function(e)
        bom_ui.overlay{
            definition = create_UIBox_join_room_input()
        }
    end

    -- Thin separator
    local function sep()
        return { n = G.UIT.R, config = { align = "cm", minh = 0.02, minw = 7.18,
            colour = { 1, 1, 1, 0.1 }, padding = 0.034 }, nodes = {} }
    end

