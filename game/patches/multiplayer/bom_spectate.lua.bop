SP.live = { status = "idle", matches = {}, page = 1, at = nil }

local function pbk() return rawget(_G, "bom_playback") end

local function live_send(msg, on_fail)
    local M = rawget(_G, "mpm_menu") or (MP and MP.menu)
    if M and M.with_connection then
        M.with_connection(function() send(msg) end, on_fail)
    elseif bom_core and bom_core.is_connected and bom_core.is_connected() then
        send(msg)
    elseif on_fail then
        on_fail()
    end
end

local function live_open()
    return UIK and UIK._win and UIK._win.id == "mp_browse" and UIK._win._cur == "live"
end

local function live_refresh_ui()
    if live_open() then pcall(UIK.refresh) end
end

local function popup(msg)
    local R = rawget(_G, "bom_replay")
    if R and R.popup then R.popup(msg) end
end

function SP.browse_refresh()
    SP.live.status = "loading"
    live_refresh_ui()
    live_send({ type = "spectate_list" }, function()
        SP.live.status = "error"
        live_refresh_ui()
    end)
end

local function mode_label(mode)
    local RS = rawget(_G, "bom_rulesets")
    if RS and RS.mode_name then
        local ok, n = pcall(RS.mode_name, mode)
        if ok and type(n) == "string" and n ~= "" then return n end
    end
    return tostring(mode or "")
end

local function txt(str, scale, colour, maxw)
    return { n = G.UIT.T, config = { text = str, scale = scale, colour = colour or G.C.UI.TEXT_LIGHT, shadow = true, maxw = maxw } }
end

local function cell(nodes, w, align)
    return { n = G.UIT.C, config = { align = align or "cm", minw = w, maxw = w, minh = 0.7 }, nodes = nodes }
end

local LIVE_W = { players = 6.6, mode = 2.6, ante = 1.3, tag = 1.4, action = 1.8 }

local function short_name(name, n)
    local out, count = {}, 0
    for ch in tostring(name):gmatch("[%z\1-\127\194-\244][\128-\191]*") do
        count = count + 1
        if count > n then return (table.concat(out):gsub("%s+$", "")) .. "..." end
        out[#out + 1] = ch
    end
    return table.concat(out)
end

local function names_cell(m)
    local items = {}
    for i, p in ipairs(m.players or {}) do
        if i > 4 then break end
        local badge = nil
        pcall(function() if rawget(_G, "bom_badges") then badge = bom_badges.for_player(p, { h = 0.28 }) end end)
        local nodes = {}
        if badge then
            nodes[#nodes + 1] = badge
            nodes[#nodes + 1] = { n = G.UIT.C, config = { minw = 0.08 } }
        end
        nodes[#nodes + 1] = txt(short_name(p.name or "?", 12), 0.34, G.C.WHITE, 2.4)
        items[#items + 1] = { n = G.UIT.C, config = { align = "cl", minw = 3.2, maxw = 3.2 }, nodes = nodes }
    end
    local lines, cur = {}, nil
    for i, r in ipairs(items) do
        if i % 2 == 1 then
            cur = { n = G.UIT.R, config = { align = "cl" }, nodes = {} }
            lines[#lines + 1] = cur
        end
        cur.nodes[#cur.nodes + 1] = r
    end
    return cell({ { n = G.UIT.C, config = { align = "cl" }, nodes = lines } }, LIVE_W.players, "cl")
end

local function tag_of(m)
    local label, colour = nil, nil
    if m.friend then label, colour = L("FRIEND"), G.C.GREEN
    elseif m.ranked then label, colour = L("RANKED"), G.C.GOLD end
    if not label then return nil end
    return { n = G.UIT.C, config = { align = "cm", r = 0.08, colour = colour, padding = 0.05, minw = 1.2, maxw = 1.2 }, nodes = { txt(label, 0.3, G.C.WHITE, 1.1) } }
end

local function live_row(i, m)
    G.FUNCS["spec_live_watch_" .. i] = function() SP.watch_match(m.id) end
    local touch = UIK and UIK.touch and UIK.touch()
    return { n = G.UIT.R, config = { align = "cm", padding = 0.05, r = 0.1, colour = { 0, 0, 0, 0.15 } }, nodes = {
        names_cell(m),
        cell({ txt(mode_label(m.mode), 0.34, G.C.GOLD, LIVE_W.mode - 0.1) }, LIVE_W.mode),
        cell({ txt(L("Ante") .. " " .. tostring(m.ante or 1), 0.34, G.C.WHITE) }, LIVE_W.ante),
        cell({ tag_of(m) }, LIVE_W.tag),
        cell({ UIBox_button({ button = "spec_live_watch_" .. i, label = { L("WATCH") }, colour = G.C.BLUE, minw = LIVE_W.action - 0.1, minh = touch and 0.85 or 0.6, scale = 0.4, col = true }) }, LIVE_W.action),
    } }
end

function SP.browse_tab()
    local st = SP.live
    if st.status == "idle" then SP.browse_refresh() end
    local per = (_G._IS_DESKTOP == false) and 3 or 4
    local list = st.matches or {}
    local pages = math.max(1, math.ceil(#list / per))
    st.page = math.min(math.max(1, st.page or 1), pages)
    local body = {}
    if st.status == "ok" and #list > 0 then
        for i = (st.page - 1) * per + 1, math.min(#list, st.page * per) do body[#body + 1] = live_row(i, list[i]) end
    else
        local msg = st.status == "error" and L("Could not reach the server.") or st.status == "ok" and L("No live match to watch right now.") or L("Loading...")
        body[#body + 1] = { n = G.UIT.R, config = { align = "cm", padding = 0.3 }, nodes = { txt(msg, 0.42, st.status == "error" and G.C.RED or G.C.UI.TEXT_LIGHT) } }
    end
    local contents = {
        { n = G.UIT.R, config = { align = "cm", padding = 0.05 }, nodes = { txt(L("Live public matches and your friends' matches"), 0.34, G.C.UI.TEXT_LIGHT) } },
        { n = G.UIT.R, config = { align = "tm", minh = per * 0.95 }, nodes = { { n = G.UIT.C, config = { align = "tm" }, nodes = body } } },
    }
    if pages > 1 then
        contents[#contents + 1] = UIK.pager{ prev = "spec_live_prev", next = "spec_live_next", text = tostring(st.page) .. " / " .. tostring(pages),
            prev_disabled = st.page <= 1, next_disabled = st.page >= pages }
    end
    return { n = G.UIT.R, config = { align = "tm", minw = UIK.W }, nodes = { { n = G.UIT.C, config = { align = "tm" }, nodes = contents } } }
end

local function watch_msg(msg)
    local P = pbk()
    if P and P.active() then return end
    SP.live.want = msg
    live_send(msg, function() popup(L("Could not reach the server.")) end)
end

function SP.watch_match(id, pid)
    if type(id) ~= "string" then return end
    watch_msg({ type = "spectate_watch", id = id, pid = pid })
end

function SP.watch(room_code)
    if type(room_code) ~= "string" or room_code == "" then return end
    watch_msg({ type = "spectate_watch", room = room_code })
end

function SP.watch_friend(code)
    if type(code) ~= "string" or code == "" then return end
    watch_msg({ type = "spectate_watch", code = code })
end

SP.LIVE_ERRORS = {
    not_found = "This match is over or could not be found.",
    private = "This match does not allow spectators.",
    full = "Too many spectators in this match.",
    in_match = "You are playing in this match.",
    not_friend = "You can only watch friends this way.",
    ranked_live = "Ranked matches can be watched once they end.",
}

local function on_live(d)
    local t = d.type
    local P = pbk()
    if t == "spectate_list" then
        if d.slow_down then return true end
        SP.live.matches = type(d.matches) == "table" and d.matches or {}
        SP.live.status = "ok"
        live_refresh_ui()
    elseif t == "spectate_start" then
        if not SP.live.want or not P then
            send({ type = "spectate_leave" })
            return true
        end
        SP.live.want = nil
        pcall(function() if G.OVERLAY_MENU then G.FUNCS.exit_overlay_menu() end end)
        pcall(function()
            local M = rawget(_G, "mpm_menu")
            if M and M.exit then M.exit() end
        end)
        local ok = P.start({ mode = "live", id = d.id, header = d.header or {}, streams = d.streams or {}, seqs = d.seqs,
            pid = tonumber(d.pid) or 0, see_jokers = d.see_jokers ~= false })
        if ok then send({ type = "social_status", where = "spectating" }) else send({ type = "spectate_leave" }) end
    elseif t == "spectate_act" then
        if P and P.active() then P.feed(d.pid, d.seq, d.a) end
    elseif t == "spectate_end" then
        if P and P.active() then P.live_ended(d.reason) end
    elseif t == "spectate_error" then
        SP.live.want = nil
        popup(L(SP.LIVE_ERRORS[d.reason] or SP.LIVE_ERRORS.not_found))
    end
    return true
end

function SP.live_init()
    G.FUNCS.spec_live_prev = function() SP.live.page = (SP.live.page or 1) - 1; live_refresh_ui() end
    G.FUNCS.spec_live_next = function() SP.live.page = (SP.live.page or 1) + 1; live_refresh_ui() end
    if bom_events and bom_events.register then
        for _, t in ipairs({ "spectate_list", "spectate_start", "spectate_act", "spectate_end", "spectate_error" }) do
            bom_events.register(t, on_live)
        end
    end
end

local function register_strings_2()
    mod_loc_register{
        fr = {
            ["FRIEND"] = "AMI", ["RANKED"] = "CLASSÉ", ["WATCH"] = "REGARDER", ["Loading..."] = "Chargement...", ["Ante"] = "Mise",
            ["Could not reach the server."] = "Impossible de joindre le serveur.",
            ["No live match to watch right now."] = "Aucun match en direct à regarder pour le moment.",
            ["Live public matches and your friends' matches"] = "Matchs publics en direct et matchs de vos amis",
            ["This match is over or could not be found."] = "Ce match est terminé ou introuvable.",
            ["This match does not allow spectators."] = "Ce match n'accepte pas de spectateurs.",
            ["Ranked matches can be watched once they end."] = "Les matchs classés se regardent une fois terminés.",
            ["Too many spectators in this match."] = "Trop de spectateurs dans ce match.",
            ["You are playing in this match."] = "Vous jouez dans ce match.",
            ["You can only watch friends this way."] = "Vous ne pouvez regarder que vos amis ainsi.",
        },
        es = {
            ["FRIEND"] = "AMIGO", ["RANKED"] = "CLASIFICATORIA", ["WATCH"] = "MIRAR", ["Loading..."] = "Cargando...", ["Ante"] = "Apuesta",
            ["Could not reach the server."] = "No se pudo conectar con el servidor.",
            ["No live match to watch right now."] = "No hay partidas en directo para mirar ahora.",
            ["Live public matches and your friends' matches"] = "Partidas públicas en directo y partidas de tus amigos",
            ["This match is over or could not be found."] = "Esta partida terminó o no se encontró.",
            ["This match does not allow spectators."] = "Esta partida no admite espectadores.",
            ["Ranked matches can be watched once they end."] = "Las partidas clasificatorias se pueden ver cuando terminan.",
            ["Too many spectators in this match."] = "Demasiados espectadores en esta partida.",
            ["You are playing in this match."] = "Estás jugando en esta partida.",
            ["You can only watch friends this way."] = "Solo puedes mirar a amigos de esta forma.",
        },
    }
end

function SP.register_strings()
    if not mod_loc_register then return end
    register_strings_1()
    register_strings_2()
end

return SP
end
