local SP = {}

local function L(s) return mod_loc and mod_loc(s) or s end

local CHIP = 0.85

local V = {target = nil, board = nil, name = nil, alive = true, open = false, sig = nil, at = nil,
    cards = {}, areas = {}, leaving = {}, txt = {}, shown = 0, goal = 0, fresh = true, juice_i = 0}
SP.V = V
local build

local function send(msg)
    pcall(function() bom_core.send(msg) end)
end

local function extras(name, value)
    local X = rawget(_G, "Extras")
    if X and X.hook then return X.hook(name, value) end
    return value
end

local function ed_of(card)
    local e = card.edition
    if type(e) == "table" and e.type then return "e_" .. e.type end
    return nil
end

local function entry(card)
    local c = card.config or {}
    local center = c.center or {}
    if c.card_key and (center.set == "Default" or center.set == "Enhanced") then
        return {i = card.sort_id, k = c.card_key, e = center.key ~= "c_base" and center.key or nil, d = ed_of(card), s = card.seal}
    end
    return {i = card.sort_id, c = center.key, d = ed_of(card)}
end

local function list(area, hl)
    local out = {}
    if area and area.cards then
        for i, card in ipairs(area.cards) do
            out[i] = entry(card)
            if hl and card.highlighted then out[i].hl = true end
        end
    end
    return out
end

local function plain(v)
    local n = 0
    pcall(function() n = tonumber(bom_core.plain_number(v)) or 0 end)
    return n
end

function SP.my_board()
    local g = G.GAME
    if not g then return nil end
    local where
    if G.STATE == G.STATES.SHOP then where = "shop"
    elseif G.STATE == G.STATES.BLIND_SELECT then where = "select"
    elseif G.STATE == G.STATES.ROUND_EVAL then where = "eval"
    elseif g.facing_blind then where = "blind"
    else return nil end
    local cr = g.current_round or {}
    local rr = g.round_resets or {}
    local in_blind = where == "blind"
    local b = {
        where = where, ante = rr.ante or 1, round = tonumber(g.round) or 0, win_ante = tonumber(g.win_ante),
        chips = math.floor(plain(g.chips)), target = in_blind and math.floor(plain(g.blind and g.blind.chips)) or 0,
        hands = (in_blind and cr.hands_left or rr.hands) or 0, discards = (in_blind and cr.discards_left or rr.discards) or 0,
        money = math.floor(tonumber(g.dollars) or 0),
        deck = G.deck and G.deck.cards and #G.deck.cards or 0, deck_total = G.playing_cards and #G.playing_cards or nil,
        jl = G.jokers and G.jokers.config and tonumber(G.jokers.config.card_limit) or nil,
        cl = G.consumeables and G.consumeables.config and tonumber(G.consumeables.config.card_limit) or nil,
        blind = in_blind and g.blind.config and g.blind.config.blind and g.blind.config.blind.key or nil,
        jokers = list(G.jokers), cons = list(G.consumeables), hand = in_blind and list(G.hand, true) or {},
    }
    if where == "select" then
        b.blind = g.blind_on_deck and rr.blind_choices and rr.blind_choices[g.blind_on_deck] or nil
        pcall(function()
            local bl = G.P_BLINDS[b.blind]
            b.target = math.floor(plain(get_blind_amount(b.ante) * bl.mult * ((g.starting_params and g.starting_params.ante_scaling) or 1)))
        end)
    end
    if in_blind then
        b.played = list(G.play)
        local ch = cr.current_hand
        if ch and ch.handname and ch.handname ~= "" then
            b.hand_name = ch.handname
            local h = g.hands and g.hands[ch.handname]
            if h then b.hand_level = tonumber(h.level) end
        end
        if ch then
            b.hand_chips = plain(ch.chips)
            b.hand_mult = plain(ch.mult)
        end
    end
    if where == "shop" then
        local shop = {}
        for _, a in ipairs({G.shop_jokers, G.shop_vouchers, G.shop_booster}) do
            for _, e in ipairs(list(a)) do shop[#shop + 1] = e end
        end
        b.shop = shop
    end
    return b
end

local function sig(b)
    local parts = {b.where, b.ante, b.round or "", b.chips, b.target or "", b.hands, b.discards, b.money, b.deck, b.deck_total or "", b.jl or "", b.cl or "", b.blind or "", b.hand_name or "", b.hand_level or "", b.hand_chips or "", b.hand_mult or ""}
    for _, k in ipairs({"jokers", "cons", "hand", "shop", "played"}) do
        for _, e in ipairs(b[k] or {}) do parts[#parts + 1] = (e.i or "") .. (e.k or e.c or "?") .. (e.e or "") .. (e.d or "") .. (e.s or "") .. (e.hl and "^" or "") end
        parts[#parts + 1] = "/"
    end
    return table.concat(parts, "|")
end

local function holder()
    return G.OVERLAY_MENU and G.OVERLAY_MENU:get_UIE_by_ID("spec_body")
end

function SP.tick()
    if V.open and not holder() then SP.close() end
    local now = love.timer.getTime()
    local gap = G.STATE == G.STATES.HAND_PLAYED and 0.15 or 0.25
    if V.at and now - V.at < gap then return end
    V.at = now
    local ok, b = pcall(SP.my_board)
    if not ok or not b then return end
    local s = sig(b)
    if s == V.sig then return end
    V.sig = s
    send({type = "spec_board", board = b})
end

local function party_on()
    return bom_party and bom_party.active and bom_party.active() or false
end

local function others()
    local out = {}
    if not party_on() then
        if V.duel then out[1] = V.duel end
        return out
    end
    local ps = bom_party and bom_party.S and bom_party.S.ps
    local me = bom_party and bom_party.S and bom_party.S.me
    for _, p in ipairs(ps and ps.players or {}) do
        if p.pid ~= me then out[#out + 1] = p end
    end
    table.sort(out, function(a, b)
        if (a.alive ~= false) ~= (b.alive ~= false) then return a.alive ~= false end
        return (a.pid or 0) < (b.pid or 0)
    end)
    return out
end

local function fmt(v)
    local ok, out = pcall(number_format, tonumber(v) or 0)
    return ok and out or tostring(v or 0)
end

local function esig(e)
    return (e.k or e.c or "?") .. "|" .. (e.e or "") .. "|" .. (e.d or "") .. "|" .. (e.s or "")
end

local function later(obj, delay)
    V.leaving[#V.leaving + 1] = {obj = obj, at = G.TIMERS.REAL + delay}
end

local function clear_cards()
    for _, card in pairs(V.cards) do pcall(function() card:remove() end) end
    for _, l in ipairs(V.leaving) do pcall(function() l.obj:remove() end) end
    V.cards = {}
    V.leaving = {}
end

local function set_chip(key)
    if key == V.chip_key and V.chip then return end
    V.chip_key = key
    local old = V.chip
    local bl = key and G.P_BLINDS and G.P_BLINDS[key]
    local atlas = bl and G.ANIMATION_ATLAS and (G.ANIMATION_ATLAS[bl.atlas or "blind_chips"] or G.ANIMATION_ATLAS.blind_chips)
    local spr
    if atlas then
        pcall(function()
            spr = AnimatedSprite(0, 0, V.chip_size or CHIP, V.chip_size or CHIP, atlas, bl.pos)
            spr:define_draw_steps({{shader = "dissolve", shadow_height = 0.05}, {shader = "dissolve"}})
        end)
    end
    V.chip = spr or Moveable(0, 0, V.chip_size or CHIP, V.chip_size or CHIP)
    if old then later(old, 0.2) end
end

local function current()
    for _, p in ipairs(others()) do if p.pid == V.target then return p end end
end

local score_text

local function kit() return rawget(_G, "bom_kit") end

local function vloc(key, fallback)
    local ok, out = pcall(localize, key)
    if ok and type(out) == "string" and out ~= "ERROR" and out ~= "" then return out end
    return L(fallback)
end

V.fits = V.fits or {}

local function put(key, str)
    str = tostring(str or "")
    local f = V.fits[key]
    local k = kit()
    if f and k and k.fit then
        local sc
        str, sc = k.fit(str, f.w, f.s, f.min or f.s)
        local e = V.box and not V.box.REMOVED and V.box:get_UIE_by_ID("spec_t_" .. key)
        if e and e.config and sc and math.abs((e.config.scale or sc) - sc) > 0.001 then
            e.config.scale = sc
            V.relayout = true
        end
    end
    V.txt[key] = str
end

local function relayout()
    if not V.relayout then return end
    V.relayout = false
    pcall(function() V.box:recalculate() end)
end

score_text = function()
    put("score", fmt(math.floor(V.shown)))
    relayout()
end

local function blind_name(key)
    local bl = key and G.P_BLINDS and G.P_BLINDS[key]
    local ok, nm = pcall(localize, {type = "name_text", key = key, set = "Blind"})
    return (ok and nm and nm ~= "ERROR" and nm) or (bl and bl.name) or L("Blind")
end

local function set_texts(b)
    local cur = current()
    put("name", cur and ((cur.name or V.name or "?") .. (cur.alive == false and (" (" .. L("Out") .. ")") or "")) or L("No player to watch"))
    put("jokers_title", L("Jokers"))
    put("cons_title", L("Consumables"))
    put("hand_title", L("Hand"))
    if not b then
        put("place", cur and L("Waiting for their next move...") or "")
        put("blind_name", "")
        for _, k in ipairs({"hands", "discards", "money", "deck", "ante", "round"}) do put(k, "-") end
        put("target_label", "")
        put("target", "")
        for _, k in ipairs({"hand_name", "level", "jokers_n", "cons_n", "mid_title"}) do put(k, "") end
        put("chips", "0")
        put("mult", "0")
        V.goal, V.shown = 0, 0
        score_text()
        set_chip(nil)
        return
    end
    local where = b.where
    local place
    if where == "shop" then place = L("Shop")
    elseif where == "eval" then place = L("Cashing out")
    elseif where == "select" then place = L("Choosing blind")
    else place = blind_name(b.blind) end
    put("place", string.format(L("Ante %d"), tonumber(b.ante) or 1) .. ", " .. place)
    put("blind_name", (where == "blind" or where == "select") and blind_name(b.blind) or place)
    local aim = (where == "blind" or where == "select") and (tonumber(b.target) or 0) > 0
    put("target_label", aim and vloc("ph_blind_score_at_least", "Score at least") or "")
    put("target", aim and fmt(b.target) or "")
    put("hands", tostring(b.hands or 0))
    put("discards", tostring(b.discards or 0))
    put("money", "$" .. tostring(b.money or 0))
    put("deck", tostring(b.deck or 0) .. (tonumber(b.deck_total) and ("/" .. tostring(b.deck_total)) or ""))
    put("ante", tostring(tonumber(b.ante) or 1) .. (tonumber(b.win_ante) and ("/" .. tostring(b.win_ante)) or ""))
    put("round", tostring(tonumber(b.round) or "-"))
    put("jokers_n", tostring(#(b.jokers or {})) .. (tonumber(b.jl) and ("/" .. tostring(b.jl)) or ""))
    put("cons_n", tostring(#(b.cons or {})) .. (tonumber(b.cl) and ("/" .. tostring(b.cl)) or ""))
    local hn = ""
    if where == "blind" and b.hand_name and b.hand_name ~= "" then
        local ok, hs = pcall(localize, b.hand_name, "poker_hands")
        hn = (ok and hs and hs ~= "ERROR") and hs or b.hand_name
    end
    put("hand_name", hn)
    local lv = ""
    if hn ~= "" and tonumber(b.hand_level) then
        local ok, ls = pcall(localize, "k_lvl")
        lv = ((ok and ls and ls ~= "ERROR") and ls or "lvl.") .. tostring(b.hand_level)
    end
    put("level", lv)
    put("chips", where == "blind" and fmt(b.hand_chips or 0) or "0")
    put("mult", where == "blind" and fmt(b.hand_mult or 0) or "0")
    if where == "shop" then put("mid_title", L("Shop"))
    elseif where == "select" then put("mid_title", L("Choosing blind"))
    elseif where == "eval" then put("mid_title", L("Cashing out"))
    else put("mid_title", L("Played hand")) end
    if b.jokers_hidden then put("jokers_title", L("Jokers") .. ": " .. L("Hidden by the lobby settings")) end
    V.goal = tonumber(b.chips) or 0
    if V.fresh or V.goal ~= V.goal or math.abs(V.goal) == math.huge then V.shown = V.goal end
    score_text()
    set_chip((where == "blind" or where == "select") and b.blind or nil)
    relayout()
end

local function update_card(card, e)
    pcall(function()
        if e.k then
            if G.P_CARDS[e.k] and card.config.card_key ~= e.k then card:set_base(G.P_CARDS[e.k]) end
            local c = G.P_CENTERS[e.e or "c_base"] or G.P_CENTERS.c_base
            if card.config.center ~= c then card:set_ability(c) end
            if card.seal ~= e.s then card:set_seal(e.s, true, true) end
        end
        if ed_of(card) ~= e.d then card:set_edition(e.d and {[e.d:sub(3)] = true} or nil, true, true) end
        card:juice_up(0.3, 0.3)
    end)
    card.spec_sig = esig(e)
end

local function new_card(e, area, fresh)
    local w, h = area.card_w, area.card_w * G.CARD_H / G.CARD_W
    local x, y = area.T.x + area.T.w / 2 - w / 2, area.T.y
    local disc = V.areas.discard
    if e.k and not fresh and disc and disc.T then x, y = disc.T.x, disc.T.y end
    local card
    if e.k then
        if not G.P_CARDS[e.k] then return end
        card = Card(x, y, w, h, G.P_CARDS[e.k], G.P_CENTERS[e.e or "c_base"] or G.P_CENTERS.c_base)
        if e.s then pcall(function() card:set_seal(e.s, true, true) end) end
    else
        local center = G.P_CENTERS[e.c or ""]
        if not center then return end
        card = Card(x, y, w, h, G.P_CARDS.empty, center, {bypass_discovery_center = true, bypass_discovery_ui = true})
    end
    if e.d and type(e.d) == "string" then
        pcall(function() card:set_edition({[e.d:sub(3)] = true}, true, true) end)
    end
r 7 219 %20%20%20%20 -
r 15 4154 %20%20%20%20 -
l 462
    card.spec_k = e.k ~= nil
    card.spec_sig = esig(e)
    if not fresh and not e.k then pcall(function() card:start_materialize(nil, true) end) end
    return card
end

local function sync(name, entries, fresh, seen)
    local area = V.areas[name]
    if not (area and area.cards) then return end
    local counts, order, inorder = {}, {}, {}
    for _, e in ipairs(entries) do
        local id
        if e.i then id = "#" .. tostring(e.i)
        else
            local base = name .. ":" .. tostring(e.k or e.c)
            counts[base] = (counts[base] or 0) + 1
            id = base .. ":" .. counts[base]
        end
        if not seen[id] then
            seen[id] = true
            local card = V.cards[id]
            if card and card.removed then card = nil end
            if card and card.spec_sig ~= esig(e) then update_card(card, e) end
            if not card then
                card = new_card(e, area, fresh)
                V.cards[id] = card
            end
            if card then
                if card.area ~= area then
                    if card.area and card.area.cards then card.area:remove_card(card) end
                    card.T.w, card.T.h = area.card_w, area.card_w * G.CARD_H / G.CARD_W
                    area:emplace(card)
                end
                card.highlighted = (name == "hand" and e.hl) and true or false
                order[#order + 1] = card
                inorder[card] = true
            end
        end
    end
    for _, c in ipairs(area.cards) do if not inorder[c] then order[#order + 1] = c end end
    area.cards = order
    area.highlighted = {}
    for _, c in ipairs(order) do if c.highlighted then area.highlighted[#area.highlighted + 1] = c end end
    pcall(function() area:set_ranks() end)
    pcall(function() area:align_cards() end)
end

local function leave(card, fresh)
    if fresh or not (card.area and card.area.cards) then
        pcall(function() card:remove() end)
        return
    end
    local disc = V.areas.discard
    if card.spec_k and disc and disc.cards then
        card.area:remove_card(card)
        card.highlighted = false
        disc:emplace(card)
        later(card, 0.9)
    else
        pcall(function() card:start_dissolve(nil, true) end)
    end
end

local function juice(id)
    local box = V.box
    local e = box and box.get_UIE_by_ID and box:get_UIE_by_ID(id)
    if e then pcall(function() e:juice_up(0.3, 0.2) end) end
end

local function apply(b)
    local fresh = V.fresh
    set_texts(b)
    V.fresh = false
    if not V.areas.hand then return end
    local where = b and b.where
    local seen = {}
    sync("jokers", b and b.jokers or {}, fresh, seen)
    sync("cons", b and b.cons or {}, fresh, seen)
    sync("mid", (where == "shop" and b.shop) or (where == "blind" and b.played) or {}, fresh, seen)
    sync("hand", where == "blind" and b.hand or {}, fresh, seen)
    for id, card in pairs(V.cards) do
        if not seen[id] then
            V.cards[id] = nil
            leave(card, fresh)
        end
    end
    if fresh or not b then
        V.prev = b
        return
    end
    local p = V.prev or {}
    local played = V.areas.mid.cards or {}
    local psig = ""
    for _, c in ipairs(played) do psig = psig .. tostring(c.sort_id) .. "," end
    if psig ~= V.played_sig then V.played_sig, V.juice_i = psig, 0 end
    if where == "blind" and (b.hand_chips ~= p.hand_chips or b.hand_mult ~= p.hand_mult) and (tonumber(b.hand_chips) or 0) > 0 then
        if b.hand_chips ~= p.hand_chips then juice("spec_chips") end
        if b.hand_mult ~= p.hand_mult then juice("spec_mult") end
        if #played > 0 and #(b.played or {}) > 0 then
            V.juice_i = V.juice_i % #played + 1
            pcall(function() played[V.juice_i]:juice_up(0.4, 0.3) end)
        end
    end
    if (tonumber(b.chips) or 0) ~= (tonumber(p.chips) or 0) and p.where == where then juice("spec_score") end
    if b.money ~= p.money and p.money then juice("spec_money") end
    if b.hand_name ~= p.hand_name and (b.hand_name or "") ~= "" then juice("spec_hand") end
    V.prev = b
end

local function watch(pid)
    V.target = pid
    V.board = nil
    V.name = nil
    V.prev = nil
    V.fresh = true
    clear_cards()
    send({type = "spectate", pid = pid})
end

local function step(dir)
    local o = others()
    if #o == 0 then return end
    local idx = 1
    for i, p in ipairs(o) do if p.pid == V.target then idx = i end end
    idx = ((idx - 1 + dir) % #o) + 1
    extras("spectate_manual", dir)
    watch(o[idx].pid)
    if SP.is_open() then build() else apply(nil) end
end

SP.others = others
SP.current = current

function SP.watch_pid(pid)
    if pid == nil or pid == V.target then return end
    watch(pid)
    if SP.is_open() then build() else apply(nil) end
end

local function ts(s)
    return UIK.touch() and s * 1.15 or s
end

local NUMERIC = {score = true, target = true, chips = true, mult = true, money = true, deck = true, ante = true, round = true, hands = true, discards = true}

local function ref(key, scale, colour, w)
    V.fits[key] = {w = w, s = scale, min = NUMERIC[key] and scale * 0.55 or nil}
    return {n = G.UIT.T, config = {ref_table = V.txt, ref_value = key, text = tostring(V.txt[key] or ""), scale = scale, colour = colour or G.C.WHITE, shadow = true, id = "spec_t_" .. key}}
end

local function box(nodes, o)
    o = o or {}
    return {n = o.row and G.UIT.R or G.UIT.C, config = {align = o.align or "cm", minw = o.w, minh = o.h, padding = o.padding or 0,
        r = o.r or 0.1, colour = o.colour or G.C.CLEAR, emboss = o.emboss, id = o.id, outline = o.outline, outline_colour = o.outline_colour, func = o.func}, nodes = nodes}
end

local function gap(w, h)
    return {n = G.UIT.C, config = {minw = w or 0.1, minh = h or 0.01}, nodes = {}}
end

local function vgap(h)
    return {n = G.UIT.R, config = {minh = h or 0.1, minw = 0.01}, nodes = {}}
end

local function make_area(name, w, limit, kind, extra)
    local sc = V.sc[name] or 0.6
    local cfg = {card_limit = limit, type = kind, highlight_limit = 99, card_w = G.CARD_W * sc}
    for k, v in pairs(extra or {}) do cfg[k] = v end
    local area = CardArea(0, 0, w, G.CARD_H * sc, cfg)
    V.areas[name] = area
    return {n = G.UIT.O, config = {object = area}}
end

local DARK = {0, 0, 0, 0.25}

local function stat(label, key, colour, w, h, id)
    return box({
        box({UIK.text(label, {scale = ts(0.27), colour = kit().colour("muted")})}, {row = true, w = w - 0.08, h = 0.3}),
        box({box({ref(key, ts(0.42), colour, w - 0.3)}, {w = w - 0.16, h = h - 0.4, colour = kit().colour("score"), emboss = 0.03})}, {row = true, w = w - 0.08, h = h - 0.38}),
    }, {w = w, h = h, colour = DARK, padding = 0.04, id = id})
end

local function section(title_key, count_key, w, area_node, h)
    local head = {ref(title_key, ts(0.3), kit().colour("muted"), count_key and (w - 1.2) or (w - 0.3))}
    if count_key then
        head[#head + 1] = gap(0.15)
        head[#head + 1] = ref(count_key, ts(0.3), G.C.WHITE, 0.9)
    end
    return box({
        box(head, {row = true, w = w - 0.1, h = 0.34}),
        box({area_node}, {row = true, w = w - 0.1, h = h - 0.42}),
    }, {w = w, h = h, colour = DARK, padding = 0.04})
end

local function info_column(w, h)
    local half = (w - 0.1) / 2
    local blind = box({
        box({{n = G.UIT.O, config = {ref_table = V, ref_value = "chip", object = V.chip}}}, {w = V.chip_size + 0.1, h = V.chip_size + 0.1}),
        gap(0.08),
        box({
            box({ref("blind_name", ts(0.4), G.C.WHITE, w - V.chip_size - 0.45)}, {row = true, align = "cl", w = w - V.chip_size - 0.4, h = 0.42}),
            box({ref("target_label", ts(0.27), kit().colour("muted"), w - V.chip_size - 0.45)}, {row = true, align = "cl", w = w - V.chip_size - 0.4, h = 0.3}),
            box({ref("target", ts(0.4), G.C.RED, w - V.chip_size - 0.45)}, {row = true, align = "cl", w = w - V.chip_size - 0.4, h = 0.42}),
        }, {w = w - V.chip_size - 0.35, align = "cl"}),
    }, {row = true, w = w, h = V.chip_size + 0.3, colour = DARK, padding = 0.06})
    local score = box({
        box({UIK.text(kit().fit(L("Round score"), 1.7, ts(0.3), ts(0.22)), {scale = select(2, kit().fit(L("Round score"), 1.7, ts(0.3), ts(0.22))), colour = G.C.WHITE})}, {w = 1.8, h = 0.6}),
        box({ref("score", ts(0.48), G.C.WHITE, w - 2.3)}, {w = w - 2.05, h = 0.58, colour = kit().colour("score"), emboss = 0.03, id = "spec_score"}),
    }, {row = true, w = w, h = 0.78, colour = DARK, padding = 0.06})
    local cw = (w - 0.95) / 2
    local hand = box({
        box({ref("hand_name", ts(0.36), G.C.WHITE, w - 1.3), gap(0.1), ref("level", ts(0.3), kit().colour("muted"), 0.8)}, {row = true, w = w - 0.12, h = 0.42}),
        box({
            box({ref("chips", ts(0.42), G.C.WHITE, cw - 0.2)}, {w = cw, h = 0.56, colour = G.C.UI_CHIPS or G.C.BLUE, emboss = 0.04, align = "cr", padding = 0.06, id = "spec_chips"}),
            box({UIK.text("X", {scale = ts(0.42), colour = G.C.UI_MULT or G.C.RED})}, {w = 0.6, h = 0.56}),
            box({ref("mult", ts(0.42), G.C.WHITE, cw - 0.2)}, {w = cw, h = 0.56, colour = G.C.UI_MULT or G.C.RED, emboss = 0.04, align = "cl", padding = 0.06, id = "spec_mult"}),
        }, {row = true, w = w - 0.12, h = 0.62}),
    }, {row = true, w = w, h = 1.16, colour = DARK, padding = 0.06, id = "spec_hand"})
    local sh = (h - (V.chip_size + 0.3) - 0.78 - 1.16 - 0.5) / 3
    local function two(a, b) return box({a, gap(0.1), b}, {row = true, w = w, h = sh}) end
    return box({
        blind, vgap(0.1), score, vgap(0.1), hand, vgap(0.1),
        two(stat(vloc("k_hud_hands", "Hands"), "hands", G.C.BLUE, half, sh), stat(vloc("k_hud_discards", "Discards"), "discards", G.C.RED, half, sh)),
        vgap(0.1),
        two(stat(L("Money"), "money", G.C.MONEY or G.C.GOLD, half, sh, "spec_money"), stat(L("Deck"), "deck", G.C.WHITE, half, sh)),
        vgap(0.1),
        two(stat(vloc("k_ante", "Ante"), "ante", G.C.ORANGE, half, sh), stat(vloc("k_round", "Round"), "round", G.C.ORANGE, half, sh)),
    }, {w = w, h = h, align = "tm", r = 0})
end

local function cards_column(w, h)
    local cons_w = 3.4
    local jok_w = w - cons_w - 0.1
    local rj = G.CARD_H * V.sc.jokers + 0.6
    local rm = G.CARD_H * V.sc.mid + 0.8
    local rh = h - 0.2 - rj - rm
    return box({
        box({
            section("jokers_title", "jokers_n", jok_w, make_area("jokers", jok_w - 0.4, 5, "title_2"), rj),
            gap(0.1),
            section("cons_title", "cons_n", cons_w, make_area("cons", cons_w - 0.4, 2, "title_2"), rj),
        }, {row = true, w = w, h = rj}),
        vgap(0.1),
        box({section("mid_title", nil, w, make_area("mid", w - 1.6, 5, "title"), rm)}, {row = true, w = w, h = rm}),
        vgap(0.1),
        box({box({
            box({ref("hand_title", ts(0.3), kit().colour("muted"), w - 0.3)}, {row = true, w = w - 0.1, h = 0.34}),
            box({
                box({make_area("hand", w - 2.4, 8, "title")}, {w = w - 2.2, h = rh - 0.42}),
                box({make_area("discard", G.CARD_W * V.sc.hand, 999, "discard")}, {w = 1.9, h = rh - 0.42}),
            }, {row = true, w = w - 0.1, h = rh - 0.42}),
        }, {w = w, h = rh, colour = DARK, padding = 0.04})}, {row = true, w = w, h = rh}),
    }, {w = w, h = h, align = "tm", r = 0})
end

local function screen()
    local touch = UIK.touch()
    local W = V.W
    if V.tall then
        return box({
            box({info_column(W, V.info_h)}, {row = true, w = W, h = V.info_h}),
            vgap(0.2),
            box({cards_column(W, V.H - V.info_h - 0.2)}, {row = true, w = W, h = V.H - V.info_h - 0.2}),
        }, {w = W, h = V.H, align = "tm", func = "spec_frame"})
    end
    local lw = touch and 4.9 or 4.5
    return box({info_column(lw, V.H), gap(0.2), cards_column(W - lw - 0.2, V.H)}, {w = W, h = V.H, align = "tm", func = "spec_frame"})
end

local function top_bar()
    local k = kit()
    local d = k.dims()
    local h = d.row_h + 0.12
    local arrow = function(label, button) return k.icon_button({label = label, button = button, w = 0.7, h = h, colour = G.C.RED, scale = ts(0.4)}) end
    local cur = current()
    local out = cur and cur.alive == false
    local solo = #others() <= 1
    local rest = V.W - (solo and 0.12 or (1.4 + (UIK.touch() and 2.7 or 2.5) + 0.48))
    local name_w = math.min(4.6, rest * 0.42)
    local place_w = math.min(6.2, rest - name_w)
    local cells = {
        arrow("<", "spec_prev"),
        box({ref("name", ts(0.38), k.colour("light_text"), name_w - 0.3)}, {w = name_w, h = h,
            colour = out and k.colour("out") or k.colour("name"), emboss = 0.03, id = cur and cur.pid ~= nil and ("bom_emote_pid_" .. tostring(cur.pid)) or nil}),
        box({ref("place", ts(0.34), k.colour("light_text"), place_w - 0.3)}, {w = place_w, h = h, colour = k.colour("status"), emboss = 0.03}),
        arrow(">", "spec_next"),
    }
    if solo then
        table.remove(cells, 4)
        table.remove(cells, 1)
    else
        cells = extras("spectate_top_bar", cells) or cells
    end
    return k.row(cells, {plain = true, gap = 0.12})
end

build = function()
    local node = holder()
    if not node then return end
    if node.config.object then pcall(function() node.config.object:remove() end) end
    clear_cards()
    V.areas = {}
    V.fresh = true
    V.prev = nil
    set_texts(V.board)
    local ok, def = pcall(function()
        return {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR}, nodes = {
            {n = G.UIT.R, config = {align = "cm", padding = 0.04}, nodes = {top_bar()}},
            {n = G.UIT.R, config = {align = "cm", padding = 0.04}, nodes = {screen()}},
        }}
    end)
    if not ok then
        pcall(function() print("[SPECTATE] screen failed: " .. tostring(def)) end)
        def = {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR, minw = V.W, minh = V.H}, nodes = {UIK.text(L("Waiting for their next move..."), {scale = 0.4})}}
    end
    V.box = UIBox{definition = def, config = {offset = {x = 0, y = 0}, parent = node, type = "cm"}}
    node.config.object = V.box
    pcall(function() G.OVERLAY_MENU:recalculate() end)
    pcall(apply, V.board)
end
SP.rebuild = build

local function frame()
    if V.goal ~= V.shown then
        local dlt = V.goal - V.shown
        local mv = math.max(math.abs(dlt) * math.min(1, (G.real_dt or 0.016) * 7), 1)
        if math.abs(dlt) <= mv or dlt ~= dlt then V.shown = V.goal else V.shown = V.shown + (dlt > 0 and mv or -mv) end
        score_text()
    end
    local now = G.TIMERS.REAL
    for i = #V.leaving, 1, -1 do
        local l = V.leaving[i]
        if now >= l.at then
            pcall(function() l.obj:remove() end)
            table.remove(V.leaving, i)
        end
    end
    extras("spectate_tick")
end

function SP.allowed()
    local pb = rawget(_G, "bom_playback")
    if pb and pb.active and pb.active() then return false end
    local st = {}
    pcall(function() st = bom_match.get_settings() or {} end)
    if st.spectate ~= false then return true end
    local S = bom_party and bom_party.S
    for _, p in ipairs(S and S.ps and S.ps.players or {}) do
        if p.pid == S.me then return p.alive == false end
    end
    return false
end

function SP.is_open()
    return V.open and holder() ~= nil
end

local function sizes()
    local touch = UIK.touch()
    V.sc = touch and {jokers = 0.56, cons = 0.56, mid = 0.52, hand = 0.62} or {jokers = 0.54, cons = 0.54, mid = 0.52, hand = 0.6}
    V.chip_size = touch and 0.95 or 0.85
    local room_w = (G.ROOM and G.ROOM.T and G.ROOM.T.w) or 20
    V.W = math.min(touch and 19.2 or 17.6, room_w - 1.2)
    V.H = touch and 7.2 or 7.0
    V.tall = UIK.portrait and UIK.portrait() or false
    if V.tall then
        V.W = math.min(10.4, room_w - 1.2)
        V.info_h = 6.6
        V.H = V.info_h + 0.2 + 7.4
    end
end

function SP.open()
    V.open = true
    sizes()
    pcall(function() bom_ui.hide_pvp_waiting() end)
    extras("spectate_open")
    if not current() then
        local o = others()
        if o[1] then
            V.target = o[1].pid
            V.board, V.name, V.prev, V.fresh = nil, nil, nil, true
        end
    end
    if V.target then send({type = "spectate", pid = V.target}) end
    local title = {n = G.UIT.R, config = {align = "cm", padding = 0.05}, nodes = {
        {n = G.UIT.T, config = {text = L("SPECTATING"), scale = UIK.touch() and 0.5 or 0.45, colour = UIK.C and UIK.C.title or G.C.GOLD, shadow = true}},
    }}
    local body = {n = G.UIT.R, config = {align = "cm"}, nodes = {{n = G.UIT.O, config = {id = "spec_body", object = Moveable(0, 0, V.W, V.H + 0.8)}}}}
    G.FUNCS.overlay_menu{definition = create_UIBox_generic_options({back_func = "spec_close", contents = {title, body}})}
    build()
end

local function settings()
    local st = {}
    pcall(function() st = bom_match.get_settings() or {} end)
    return st
end

local function replaying()
    local P = rawget(_G, "bom_playback")
    return P and P.active and P.active() or false
end

local function party_waiting()
    local ok, yes = pcall(function()
        local v = bom_party_run.view()
        return bom_party_run.kind() and v.finished and (tonumber(v.waiting) or 0) > 0
    end)
    return ok and yes or false
end

local function still_waiting()
    if party_on() then return party_waiting() end
    return V.duel ~= nil
end

function SP.wait_allowed()
    if replaying() or settings().spectate_wait ~= true then return false end
    if party_on() then return party_waiting() and #others() > 0 end
    return V.duel ~= nil and bom_match and bom_match.is_in_match and bom_match.is_in_match() or false
end

function SP.defer_wait()
    if not SP.is_open() then return false end
    V.wait_back = true
    return true
end

function SP.open_wait()
    if not SP.wait_allowed() then return end
    V.wait_mode = true
    SP.open()
end

function SP.wait_over()
    if not party_on() then V.board, V.name = nil, nil end
    V.duel = nil
    if V.open and V.wait_mode then
        V.wait_mode = nil
        pcall(G.FUNCS.spec_close)
    end
    V.wait_mode = nil
    V.wait_back = nil
    V.last_wait = nil
end

function SP.close()
    if not V.open then return end
    V.open = false
    clear_cards()
    V.areas = {}
    V.box = nil
    send({type = "spectate", pid = nil})
    if V.wait_mode or party_waiting() then V.wait_back = true end
    V.last_wait = V.wait_mode
    V.wait_mode = nil
end

function SP.reopen()
    if V.last_wait and SP.wait_allowed() then return SP.open_wait() end
    if SP.allowed() then return SP.open() end
r 4 1375 %20%20%20%20 -
l 47
end

local function duel_board_due()
    if party_on() or replaying() or settings().spectate_wait ~= true then return false end
    if not (bom_match and bom_match.is_in_match and bom_match.is_in_match()) then return false end
    return bom_nemesis and bom_nemesis.in_unresolved_pvp_blind and bom_nemesis.in_unresolved_pvp_blind() or false
end

function SP.update()
    if duel_board_due() then SP.tick() end
    if V.wait_back and not V.open and not G.OVERLAY_MENU then
        V.wait_back = nil
        if still_waiting() and not (G.BOM_PVP_WAITING_OVERLAY and not G.BOM_PVP_WAITING_OVERLAY.REMOVED) then
            local msg = party_on() and bom_party_run.waiting_text() or bom_ui._pvp_wait_msg
            pcall(bom_ui.show_pvp_waiting, msg)
        end
    end
end

function SP.on_message(d)
    if d.type == "spec_avail" then
        if party_on() or replaying() or d.pid == nil then return true end
        if V.duel and V.duel.pid == d.pid then return true end
        V.duel = {pid = d.pid, name = d.name, alive = true}
        local o = G.BOM_PVP_WAITING_OVERLAY
        if o and not o.REMOVED then pcall(bom_ui.show_pvp_waiting, bom_ui._pvp_wait_msg) end
        return true
    end
    if d.type ~= "spec_board" then return false end
    if d.pid ~= V.target then return true end
    V.board = type(d.board) == "table" and d.board or nil
    if d.denied then
        if SP.is_open() then G.FUNCS.spec_close() end
        return true
    end
    V.name = d.name
    if SP.is_open() then pcall(apply, V.board) end
    return true
end

function SP.register_funcs()
    G.FUNCS.party_spectate = function() if SP.allowed() then SP.open() end end
    G.FUNCS.spec_wait = function() SP.open_wait() end
    G.FUNCS.spec_prev = function() step(-1) end
    G.FUNCS.spec_next = function() step(1) end
    G.FUNCS.spec_close = function()
        SP.close()
r 4 1375 %20%20%20%20%20%20%20%20 -
l 272
    end
    G.FUNCS.spec_frame = function() if V.open then pcall(frame) end end
    if not SP.exit_wrapped then
        SP.exit_wrapped = true
        local exit = G.FUNCS.exit_overlay_menu
        G.FUNCS.exit_overlay_menu = function(...)
            if V.open then SP.close() end
            return exit(...)
        end
    end
end

