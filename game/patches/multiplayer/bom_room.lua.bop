local bom_room = {}

local function _mp_dbg(msg)
    if mp_log and mp_log.info then
        mp_log.info("BOM_ROOM_DBG", msg)
    end
end


local function my_profile_name()
    local name = nil
    pcall(function()
        local profile = G.PROFILES[G.SETTINGS.profile]
        name = profile and profile.name
    end)
    name = type(name) == "string" and name:gsub("%c", ""):gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
    return name:sub(1, 32)
end
bom_room.my_profile_name = my_profile_name

function bom_room.game_version()
    return tostring(OVERHAUL_VERSION or "?")
end

function bom_room.is_default_name(name)
    local PN = rawget(_G, "PlayerName")
    if PN and PN.is_default then
        local ok, r = pcall(PN.is_default, name)
        if ok and r then return true end
    end
    local n = type(name) == "string" and name:lower():match("^%s*(.-)%s*$") or ""
    if n == "" or n == "opponent" or n == "you" then return true end
    if n:match("^p%d*$") or n:match("^player%s*%d*$") or n:match("^m%d$") then return true end
    return false
end

local function name_ready(retry)
    local name = my_profile_name()
    if not bom_room.is_default_name(name) then return name end
    pcall(function() bom_ui.hide_connecting_screen() end)
    bom_room.show_name_prompt("default", name, retry)
    return nil
end

function bom_room.create(visibility)
    if not bom_core then return end
    visibility = visibility == "public" and "public" or "private"
    if bom_core.mods_refused(visibility == "public") then return end
    if not name_ready(function() bom_room.create(visibility) end) then return end
    pcall(function()
        if G and G.GAME then G.GAME.bom_quick_match = false end
    end)
    bom_room.retry = function() bom_room.create(visibility) end
    bom_core.connect(function()
        bom_core.send({ type = "create_room", visibility = visibility, mods = bom_core.mods_field(visibility == "public"),
            version = bom_room.game_version(), name = my_profile_name() })
    end)
end

function bom_room.list_rooms()
    if not bom_core then return end
    local over = bom_core.mods_overflow and bom_core.mods_overflow(false)
    if over then
        pcall(function() if bom_browse then bom_browse.on_list_failed("mods", over) end end)
        return
    end
    bom_room.list_sent_at = love.timer.getTime()
    bom_core.connect(function()
        bom_room.list_sent_at = love.timer.getTime()
        bom_core.send({ type = "list_rooms", mods = bom_core.mods_field(), version = bom_room.game_version() })
    end, { silent = true, on_fail = function(msg)
        pcall(function() if bom_browse then bom_browse.on_list_failed(msg) end end)
    end })
end

function bom_room.on_room_list(data)
    local rtt = nil
    if bom_room.list_sent_at then
        rtt = math.floor((love.timer.getTime() - bom_room.list_sent_at) * 1000 + 0.5)
        bom_room.list_sent_at = nil
    end
    pcall(function() if bom_browse then bom_browse.on_list(data, rtt) end end)
end


function bom_room.join(code, opts)
    if not bom_core then return end
    opts = opts or {}
    if (not code or code == "") and not opts.id then
        pcall(function() bom_ui.show_error(mod_loc("Please enter a room code.")) end)
        return
    end
    pcall(function()
        if G and G.GAME then G.GAME.bom_quick_match = false end
    end)
    if code and code ~= "" and not code:match("^%w%w%w%w$") then
        pcall(function() bom_ui.hide_connecting_screen() end)
        pcall(function() bom_ui.show_error(mod_loc("Invalid room code. Check and try again.")) end)
        return
    end
    if code and code ~= "" and bom_core.mods_refused(false) then return end
    if not name_ready(function() bom_room.join(code, opts) end) then return end
    bom_room.last_join = { code = code and code ~= "" and code:upper() or nil, id = opts.id, from_browse = opts.from_browse }
    bom_room.retry = function() bom_room.join(code, opts) end
    local token = bom_room.held_token(bom_room.last_join.code, opts.id)
    bom_core.connect(function()
        bom_core.send({ type = "join_room", code = bom_room.last_join.code, id = opts.id, mods = bom_core.mods_field(),
            version = bom_room.game_version(), name = my_profile_name(), token = token })
    end)
end

local HELD_MAX_AGE = 900

function bom_room.on_seat(d)
    if type(d) ~= "table" or type(d.code) ~= "string" then return end
    local prev = bom_room.seat
    local id = d.id or (prev and prev.code == d.code and prev.id) or nil
    bom_room.seat = { code = d.code, id = id, token = d.token, host = d.host == true or d.playerId == 0 }
    if bom_room.held_seat and bom_room.held_seat.code == d.code then bom_room.held_seat = nil end
end

function bom_room.remember_held_seat()
    local seat = bom_room.seat
    if not seat or seat.host or type(seat.token) ~= "string" then return end
    if not bom_match or bom_match.get_phase() ~= bom_match.PHASE.LOBBY then return end
    bom_room.held_seat = { code = seat.code, id = seat.id, token = seat.token, at = os.time() }
end

function bom_room.held_for(code, id)
    local h = bom_room.held_seat
    if not h then return nil end
    if os.time() - (h.at or 0) > HELD_MAX_AGE then
        bom_room.held_seat = nil
        return nil
    end
    if (code and h.code == code) or (id and h.id == id) then return h end
    return nil
end

function bom_room.held_token(code, id)
    local h = bom_room.held_for(code, id)
    return h and h.token or nil
end

