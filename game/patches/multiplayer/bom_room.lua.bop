end

bom_room.do_mp_start_run = do_mp_start_run

function bom_room.rolled_deck_text()
    local name = bom_match and bom_match.rolled_deck and bom_match.rolled_deck()
    if not name then return nil end
    local shown = name
    pcall(function()
        local c = get_deck_from_name(name)
        local n = c and localize{type = 'name_text', set = 'Back', key = c.key}
        if n and n ~= "ERROR" then shown = n end
    end)
    return mod_loc("Random pick") .. ": " .. shown, name
end

function bom_room.rolled_stake_text(stake)
    local s = bom_match and bom_match.get_settings and bom_match.get_settings() or {}
    if s.stake ~= "random" then return nil end
    pcall(function() bom_lobby_settings.register_match_strings() end)
    local bs = rawget(_G, "bom_stakes")
    if bs and bs.valid and bs.valid(s.mp_stake) then return nil end
    local name = "Stake " .. tostring(stake)
    pcall(function()
        local c = G.P_CENTER_POOLS.Stake[stake]
        local n = c and localize{type = "name_text", key = c.key, set = "Stake"}
        if n and n ~= "ERROR" then name = n end
    end)
    return (mod_loc and mod_loc("Random stake: ") or "Random stake: ") .. name
end

function bom_room.announce_start_rolls(stake, with_deck)
    local deck_text, deck_name
    if with_deck then deck_text, deck_name = bom_room.rolled_deck_text() end
    local stake_text = bom_room.rolled_stake_text(stake)
    if not deck_text and not stake_text then return end
    if deck_text then mp_log.info("BOM_ROOM", "random pick shown: %s", deck_name) end
    if stake_text then mp_log.info("BOM_ROOM", "rolled stake shown: %s", stake_text) end
