            if not (G.play and G.STAGE == G.STAGES.RUN) then
                mp_log.info("BOM_ROOM", "start roll banner skipped: stage=%s", tostring(G.STAGE))
                return true
            end
            local both = deck_text and stake_text
            if deck_text then
