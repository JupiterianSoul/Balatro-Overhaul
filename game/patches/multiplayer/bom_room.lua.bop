                        play_sound('chips1', 1.1, 0.5)
                    end
                end)
            end
            return true
        end
    }))
end

function bom_room.start_match()
    _mp_dbg("start_match CALLED")
    mp_log.info("BOM_ROOM", "start_match() called")
    if not G then _mp_dbg("start_match: G is nil!"); mp_log.error("BOM_ROOM", "G is nil"); return end

    local seed = bom_match.new_match_seed and bom_match.new_match_seed() or tostring(os.time())
    mp_log.info("BOM_ROOM", "seed=%s", tostring(seed))
    pcall(function() if bom_match.roll_host_deck then bom_match.roll_host_deck() end end)
    pcall(function() bom_match.roll_match_extras(seed) end)

    local my_name = "Player"
    pcall(function()
        if bom_match and bom_match.get_state then
            my_name = bom_match.get_state().my_name or "Player"
        end
    end)
    pcall(function()
        if bom_core and bom_core.send then
            bom_core.send({
                type = "match_start",
                seed = seed,
                settings = bom_match and bom_match.get_settings() or {},
                player_name = my_name,
            })
        end
    end)

    pcall(function()
        if bom_match and bom_match.start_match then
            bom_match.start_match(seed)
        end
    end)

    pcall(function()
        if bom_daily and bom_daily.fetch then bom_daily.fetch() end
    end)


    _mp_dbg("start_match: calling do_mp_start_run(host)")
    do_mp_start_run(seed, "host")
    _mp_dbg("start_match: do_mp_start_run returned OK")
end


function bom_room.on_match_start(data)
    _mp_dbg("on_match_start CALLED")
    mp_log.info("BOM_ROOM", "on_match_start received")
    if not G then _mp_dbg("on_match_start: G is nil!"); mp_log.error("BOM_ROOM", "G is nil in on_match_start"); return end
    if not data then _mp_dbg("on_match_start: data is nil!"); mp_log.error("BOM_ROOM", "data is nil in on_match_start"); return end
    local _phase = bom_match and bom_match.get_phase and bom_match.get_phase()
    if _phase and _phase ~= bom_match.PHASE.LOBBY then
        mp_log.warn("BOM_ROOM", "on_match_start: ignoring duplicate - phase=%s", tostring(_phase))
        return
    end

    local seed = data.seed or tostring(os.time())
    mp_log.info("BOM_ROOM", "match_start seed=%s", tostring(seed))

    if data.settings then
        pcall(function()
            if bom_match and bom_match.on_settings_received then
                bom_match.on_settings_received(data.settings)
            end
        end)
    end

    pcall(function()
        if bom_match and bom_match.start_match then
            bom_match.start_match(seed)
        end
    end)

    pcall(function()
        if bom_daily and bom_daily.fetch then bom_daily.fetch() end
    end)


    _mp_dbg("on_match_start: calling do_mp_start_run(joiner)")
    do_mp_start_run(seed, "joiner")
    _mp_dbg("on_match_start: do_mp_start_run returned OK")
end

mp_log.info("BOM_ROOM", "Multiplayer room module loaded")
return bom_room
end
