local function install_hooks()
    if R.hooked then return end
    R.hooked = true

    local orig_calc = Card.calculate_joker
    Card.calculate_joker = function(self, context)
        if self and self.ability and context and not self.debuff then
            local name = self.ability.name
            if name == 'Hanging Chad' and ACTIVE.j_hanging_chad and context.repetition and context.cardarea == G.play then
                local sh = context.scoring_hand or {}
                if context.other_card and (context.other_card == sh[1] or context.other_card == sh[2]) then
                    return { message = localize('k_again_ex'), repetitions = 1, card = self }
                end
                return nil
            elseif name == 'Bloodstone' and ACTIVE.j_bloodstone and is_pvp() then
                if context.before and not context.blueprint then R.bs_index = 0 end
                if context.individual and context.cardarea == G.play and context.other_card then
                    if context.other_card:is_suit('Hearts') then
                        local e = self.ability.extra or {}
                        local normal = (G.GAME.probabilities and G.GAME.probabilities.normal) or 1
                        if bloodstone_roll() < normal / (e.odds or 2) then
                            return { x_mult = e.Xmult or 1.5, card = self }
                        end
                    end
                    return nil
                end
            elseif name == 'To Do List' and ACTIVE.j_todo_list and context.end_of_round and not context.individual
                and not context.repetition and not context.blueprint then
                todo_pick(self)
                return { message = localize('k_reset') }
            end
        end
        return orig_calc(self, context)
    end

    local orig_set_ability = Card.set_ability
    Card.set_ability = function(self, center, initial, delay_sprites)
        local r = orig_set_ability(self, center, initial, delay_sprites)
        if ACTIVE.j_todo_list and self.ability and self.ability.name == 'To Do List' and G.GAME and G.GAME.hands then
            pcall(todo_pick, self)
        end
        return r
    end

    local orig_eor = Card.get_end_of_round_effect
    Card.get_end_of_round_effect = function(self, context)
        if ACTIVE.Blue and self.seal == 'Blue' and not self.debuff then
            self.seal = nil
            local ok, ret = pcall(orig_eor, self, context)
            self.seal = 'Blue'
            if not ok then error(ret, 0) end
            ret = ret or {}
            if blue_seal_planet(self) then ret.effect = true end
            return ret
        end
        return orig_eor(self, context)
    end

    local orig_use = Card.use_consumeable
    Card.use_consumeable = function(self, area, copier)
        local name = self.ability and self.ability.name
        if (name == 'Ouija' and ACTIVE.c_ouija) or (name == 'Wraith' and ACTIVE.c_wraith) then
            stop_use()
r 3 1093 %20%20%20%20%20%20%20%20%20%20%20%20 -
r 3 1094 %20%20%20%20%20%20%20%20%20%20%20%20 -
l 98
            local used = copier or self
            if name == 'Ouija' then use_ouija(self, used) else use_wraith(used) end
            return nil
        end
        return orig_use(self, area, copier)
    end

    local orig_can_use = Card.can_use_consumeable
    Card.can_use_consumeable = function(self, any_state, skip_check)
        local r = orig_can_use(self, any_state, skip_check)
        if r and ACTIVE.c_ouija and self.ability and self.ability.name == 'Ouija' then
            return G.hand and G.hand.cards and #G.hand.cards >= 3 or false
        end
        return r
    end

    local orig_set_cost = Card.set_cost
    Card.set_cost = function(self)
        if self and self.ability and self.ability.mp_full_price then self.ability.couponed = nil end
        return orig_set_cost(self)
    end

    local orig_gen_ui = Card.generate_UIBox_ability_table
    Card.generate_UIBox_ability_table = function(self, vars_only, ...)
        local pk = self and self.mp_rw_preview
        if pk and not ACTIVE[pk] and DEFS[pk] then
            local n, args = select('#', ...), { ... }
            return R.preview(pk, function() return Card.generate_UIBox_ability_table(self, vars_only, unpack(args, 1, n)) end)
        end
        local ui = orig_gen_ui(self, vars_only, ...)
        if not vars_only and ui and self and self.config and self.config.center then
            local key = self.config.center.key
            if ACTIVE[key] and DEFS[key] and DEFS[key].note then
                pcall(generate_card_ui, { key = 'mp_rw_' .. key, set = 'Other' }, ui)
            end
        end
        return ui
    end

    if Tag and Tag.apply_to_run then
        local orig_tag = Tag.apply_to_run
        Tag.apply_to_run = function(self, _context)
            local ret = orig_tag(self, _context)
            if ret and _context and self and FULL_PRICE_TAGS[self.key] and ACTIVE[self.key] then
                local card = nil
                if _context.type == 'store_joker_create' and type(ret) == 'table' then card = ret end
                if _context.type == 'store_joker_modify' then card = _context.card end
                if card and card.ability then card.ability.mp_full_price = true end
            end
            return ret
        end
    end

    if Game and Game.start_run then
        local orig_start = Game.start_run
        Game.start_run = function(self, args)
            local a = args or {}
            local save = type(a.savetext) == 'table' and a.savetext or nil
            local keys = save and save.GAME and save.GAME.mp_reworks
            local from_save = type(keys) == 'table'
            if from_save then
                pcall(apply_keys, keys)
            elseif not a.mp_start then
                pcall(R.clear)
            end
            local r = orig_start(self, args)
            if (from_save or a.mp_start) and next(ACTIVE) then pcall(write_game_list) end
            return r
        end
    end

    if Game and Game.main_menu then
        local orig_menu = Game.main_menu
        Game.main_menu = function(self, ...)
            pcall(R.clear)
            return orig_menu(self, ...)
        end
    end
end

local function register_loc()
    if not O() or not O().register_loc then return end
    for _, k in ipairs(ORDER) do
        if DEFS[k].note then O().register_loc('Other', 'mp_rw_' .. k, DEFS[k].note) end
    end
end

function R.init()
    if R.initialized then return end
    register_loc()
    if O() and O().inject_loc then O().inject_loc() end
    if O() and O().on_language then O().on_language(refresh_texts) end
    local ok, err = pcall(install_hooks)
    if not ok and mp_log then mp_log.warn('BOM_REWORKS', 'hook install failed: %s', tostring(err)) end
    R.initialized = true
end

return R
end
