local function O() return bom_custom_objects end

local function clone(v)
    if O() and O().clone_table then return O().clone_table(v) end
    if type(v) ~= 'table' then return v end
    local out = {}
    for k, x in pairs(v) do out[k] = clone(x) end
    return out
end

local function pick(tr)
    if O() and O().pick then return O().pick(tr) end
    return tr and tr.en
end

local function target(key)
    local d = DEFS[key]
    if not d or not G then return nil end
    local t = G[d.tbl]
    return t and t[key]
end

local function in_sandbox()
    local P = rawget(_G, 'PREVIEW')
    return type(P) == 'table' and P._in_sandbox == true
end

function R.is_active(key) return ACTIVE[key] == true end

function R.available()
    local out = {}
    for _, k in ipairs(ORDER) do out[#out + 1] = k end
    return out
end

function R.active()
    local out = {}
    for _, k in ipairs(ORDER) do if ACTIVE[k] then out[#out + 1] = k end end
    return out
end

local function move_rarity(center, from, to)
    if not G.P_JOKER_RARITY_POOLS or from == to then return end
    local src, dst = G.P_JOKER_RARITY_POOLS[from], G.P_JOKER_RARITY_POOLS[to]
    if src then
        for i = #src, 1, -1 do if src[i] == center then table.remove(src, i) end end
    end
    if dst then
        local found = false
        for _, v in ipairs(dst) do if v == center then found = true end end
        if not found then
            dst[#dst + 1] = center
            if O() and O().sort_pool then O().sort_pool(dst) end
        end
    end
end

local function desc_set(key)
    local d = DEFS[key]
    local loc = G and G.localization and G.localization.descriptions
    return loc and loc[d.set], d.loc_key or key
end

local function swap_text(key)
    local d = DEFS[key]
    if not d.text or TEXT_SAVED[key] then return end
    local set, lk = desc_set(key)
    if not set then return end
    local orig = set[lk]
    TEXT_SAVED[key] = { ref = orig }
    local name = orig and orig.name or key
    local lines = pick(d.text)
    if O() and O().parsed then
        set[lk] = O().parsed({ name = name, text = lines })
    else
        set[lk] = { name = name, text = lines }
    end
end

local function restore_text(key)
    local saved = TEXT_SAVED[key]
    if not saved then return end
    local set, lk = desc_set(key)
    if set then set[lk] = saved.ref end
    TEXT_SAVED[key] = nil
end

local function apply_one(key)
    if ACTIVE[key] or not DEFS[key] then return end
    local d = DEFS[key]
    local c = target(key)
    if not c then return end
    SAVED[key] = {}
    for field, value in pairs(d.changes or {}) do
        local old = c[field]
        SAVED[key][field] = (old == nil) and NONE or clone(old)
        if field == 'config' then
            local cfg = clone(old or {})
            for k, v in pairs(value) do cfg[k] = clone(v) end
            c.config = cfg
        elseif value == NONE then
            c[field] = nil
        else
            c[field] = clone(value)
        end
    end
    if d.changes and d.changes.rarity and d.kind == 'joker' then
        local old = SAVED[key].rarity
        if old ~= NONE then move_rarity(c, old, c.rarity) end
    end
    swap_text(key)
    ACTIVE[key] = true
end

local function clear_one(key)
    if not ACTIVE[key] then return end
    local d = DEFS[key]
    local c = target(key)
    local saved = SAVED[key] or {}
    if c then
        local cur_rarity = c.rarity
        for field, old in pairs(saved) do
            if old == NONE then c[field] = nil else c[field] = old end
        end
        if d.changes and d.changes.rarity and d.kind == 'joker' and c.rarity then
            move_rarity(c, cur_rarity, c.rarity)
        end
    end
    restore_text(key)
    SAVED[key] = nil
    ACTIVE[key] = nil
end

function R.clear()
    for i = #ORDER, 1, -1 do pcall(clear_one, ORDER[i]) end
    R.bs_index = 0
end

local function write_game_list()
    if G and G.GAME then
        local list = R.active()
        G.GAME.mp_reworks = (#list > 0) and list or nil
    end
end

local function apply_keys(keys)
    R.clear()
    if type(keys) ~= 'table' then return end
    local want = {}
    for _, k in pairs(keys) do if type(k) == 'string' then want[k] = true end end
    for _, k in ipairs(ORDER) do
        if want[k] then
            local ok, err = pcall(apply_one, k)
            if not ok and mp_log then mp_log.warn('BOM_REWORKS', 'apply %s failed: %s', k, tostring(err)) end
        end
    end
end

function R.apply(keys)
    apply_keys(keys)
    write_game_list()
    if mp_log then mp_log.info('BOM_REWORKS', 'active reworks: %s', table.concat(R.active(), ',')) end
end

local function refresh_texts()
    for k in pairs(TEXT_SAVED) do TEXT_SAVED[k] = nil end
    for _, k in ipairs(ORDER) do if ACTIVE[k] then pcall(swap_text, k) end end
end

function R.info(key)
    local d = DEFS[key]
    if not d then return nil end
    local set, lk = desc_set(key)
    local name, text = key, nil
    local entry = set and set[lk]
    local orig = TEXT_SAVED[key] and TEXT_SAVED[key].ref or entry
    if orig and orig.name then name = orig.name end
    if d.text then text = clone(pick(d.text)) elseif orig and orig.text then text = clone(orig.text) end
    local n = d.note and pick(d.note)
    return { key = key, kind = d.kind, set = d.set, name = name, text = text or {}, note = n and clone(n.text) or {} }
end

function R.collection_text(key)
    local info = R.info(key)
    if not info then return nil end
    local src = (#info.note > 0) and info.note or info.text
    local lines = {}
    for _, l in ipairs(src) do lines[#lines + 1] = (tostring(l):gsub('{[^}]*}', '')) end
    return { lines = lines }
end

function R.preview(key, fn)
    if ACTIVE[key] or not DEFS[key] then return fn() end
    local applied = pcall(apply_one, key)
    local ok, res = pcall(fn)
    if applied then pcall(clear_one, key) end
    if ok then return res end
end

local function hand_names()
    local out = {}
    if G.handlist then
        for _, h in ipairs(G.handlist) do if G.GAME.hands[h] then out[#out + 1] = h end end
    end
    if #out == 0 then
        for h in pairs(G.GAME.hands or {}) do out[#out + 1] = h end
        table.sort(out)
    end
    return out
end

local function todo_pick(card)
    local list = {}
    for _, h in ipairs(hand_names()) do
        if h ~= card.ability.to_do_poker_hand then list[#list + 1] = h end
    end
    if #list > 0 then card.ability.to_do_poker_hand = pseudorandom_element(list, pseudoseed('mp_to_do')) end
end

local function is_pvp()
    local r = false
    pcall(function() r = bom_nemesis and bom_nemesis.is_pvp_boss and bom_nemesis.is_pvp_boss() or false end)
    return r and true or false
end

local function bloodstone_roll()
    R.bs_index = (R.bs_index or 0) + 1
    local ante = tostring((G.GAME.round_resets and G.GAME.round_resets.ante) or 1)
    local store = G.GAME.mp_bs_rolls
    local seq = type(store) == 'table' and store[ante] or nil
    if seq and seq[R.bs_index] then return seq[R.bs_index] end
    local roll = pseudorandom('mp_bloodstone' .. ante)
    if not in_sandbox() then
        G.GAME.mp_bs_rolls = (type(store) == 'table' and store) or {}
        G.GAME.mp_bs_rolls[ante] = G.GAME.mp_bs_rolls[ante] or {}
        G.GAME.mp_bs_rolls[ante][R.bs_index] = roll
    end
    return roll
end

