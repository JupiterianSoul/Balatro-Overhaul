local function use_ouija(self, used)
    local temp = {}
    for _, c in ipairs(G.hand.cards) do temp[#temp + 1] = c end
    table.sort(temp, function(a, b) return (a.playing_card or 0) < (b.playing_card or 0) end)
    pseudoshuffle(temp, pseudoseed('mp_ouija_destroy'))
    local doomed, keep = {}, {}
    for i, c in ipairs(temp) do
        if i <= 3 then doomed[#doomed + 1] = c else keep[#keep + 1] = c end
    end
    table.sort(keep, function(a, b)
        local ia, ib = 0, 0
        for i, c in ipairs(G.hand.cards) do
            if c == a then ia = i end
            if c == b then ib = i end
        end
        return ia < ib
    end)
    G.E_MANAGER:add_event(Event({ trigger = 'after', delay = 0.4, func = function()
        play_sound('tarot1')
        used:juice_up(0.3, 0.5)
        return true
    end }))
    for i, c in ipairs(keep) do
        local percent = 1.15 - (i - 0.999) / (#keep - 0.998) * 0.3
        G.E_MANAGER:add_event(Event({ trigger = 'after', delay = 0.15, func = function()
            c:flip(); play_sound('card1', percent); c:juice_up(0.3, 0.3)
            return true
        end }))
    end
    destroy_cards(doomed)
    delay(0.3)
    local rank = pseudorandom_element({ '2', '3', '4', '5', '6', '7', '8', '9', 'T', 'J', 'Q', 'K', 'A' }, pseudoseed('ouija'))
    for _, c in ipairs(keep) do
