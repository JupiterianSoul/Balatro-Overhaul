local NOTE_NAME = { en = 'MP rework', fr = 'Refonte JcJ', es = 'Ajuste JcJ' }

local function note(en, fr, es)
    return {
        en = { name = NOTE_NAME.en, text = en },
        fr = { name = NOTE_NAME.fr, text = fr },
        es = { name = NOTE_NAME.es, text = es },
    }
end

local function edition_tag_text(en_ed, fr_ed, es_ed)
    return {
        en = { 'Next base edition shop', 'Joker becomes {C:dark_edition}' .. en_ed },
        fr = { 'Le prochain Joker de base', 'de la boutique devient {C:dark_edition}' .. fr_ed },
        es = { 'El siguiente comodín base', 'de la tienda se vuelve {C:dark_edition}' .. es_ed },
    }
end

