end

local function lose_life_btn()
    if not G.round_eval then return nil end
    local hit = find_btn(G.round_eval, "bom_lose_life_button")
    if hit then return hit end
    for _, box in ipairs(G.I and G.I.UIBOX or {}) do
        if not box.REMOVED then
            hit = find_btn(box, "bom_lose_life_button")
            if hit then return hit end
        end
    end
    return nil
end
PB.lose_life_btn = lose_life_btn

local function lose_life_due()
    return G.STATE == G.STATES.ROUND_EVAL and G.round_eval ~= nil and G.GAME and G.GAME.mp_blind_loss_pending and lose_life_btn() ~= nil
end

DO.co = function(e)
    local bad = orders(e)
    if bad then return bad end
    local life = lose_life_btn()
    if (e.l or G.GAME.mp_blind_loss_pending) and life and G.FUNCS.bom_lose_life_button then
        G.FUNCS.bom_lose_life_button(life)
        return
    end
    if e.l then return "lose_life" end
    G.FUNCS.cash_out(find_btn(G.round_eval, "cash_out") or { config = {} })
end

local function eval_orders(e)
    ensure_order(G.jokers, e.jo)
    ensure_order(G.hand, e.o)
end

function PB.eval_index(entries, from, done)
    for j = from, #entries do
        local x = entries[j]
        if x.k == "eo" then
            if not done[j] then return j end
        elseif x.k ~= "in" and x.k ~= "ck" and x.k ~= "rn" then
            return nil
        end
    end
    return nil
end

function PB.before_eval()
    if not (S and S.eval_wait and S.eo_done) then return end
    S.eval_wait = nil
    local j = PB.eval_index(S.entries, S.i, S.eo_done)
    if not j then return end
    S.eo_done[j] = true
    eval_orders(S.entries[j])
end

local LIFE_SKIP = { co = true, ck = true, hk = true, rn = true, ["in"] = true, ["end"] = true, rj = true, start = true, rs = true, rl = true, eo = true }
PB.LIFE_SKIP = LIFE_SKIP

DO.ns = function(e)
    local bad = orders(e)
    if bad then return bad end
    G.FUNCS.toggle_shop(find_btn(G.shop, "toggle_shop") or { config = {} })
end

local function note_resync(fixed)
    local line = string.format("hand=%d i=%d ante=%s fix=%s", S.hk_n or 0, S.i, tostring(ante_now()), table.concat(fixed, ","))
    S.resyncs = S.resyncs or {}
    if #S.resyncs < 40 then S.resyncs[#S.resyncs + 1] = line end
    S.resync_n = (S.resync_n or 0) + 1
    S.first_diff = S.first_diff or line
    pcall(mp_log.info, "REPLAY", "resync %s", line)
end

DO.hk = function(e)
    S.hk_n = (S.hk_n or 0) + 1
    local exp = S.hk_exp or { hl = {}, ja = {} }
    S.hk_exp = exp
    for k, v in pairs(type(e.hl) == "table" and e.hl or {}) do exp.hl[k] = v end
    for k, v in pairs(type(e.ja) == "table" and e.ja or {}) do exp.ja[k] = v end
    exp.rg = exp.rg or {}
    for _, k in ipairs(type(e.rx) == "table" and e.rx or {}) do exp.rg[k] = nil end
    for k, v in pairs(type(e.rg) == "table" and e.rg or {}) do exp.rg[k] = v end
    local fixed = RP().resync(e, exp)
    if #fixed == 0 then return end
    note_resync(fixed)
end

DO.rn = NOOP

function PB.recorded_pick(seed_s)
    if not (S and S.entries) then return nil end
    S.rn_map = S.rn_map or {}
    S.rn_scan = S.rn_scan or 1
    while S.rn_scan <= #S.entries do
        local e = S.entries[S.rn_scan]
        if type(e) == "table" and e.k == "rn" and type(e.r) == "table" then
            for _, x in ipairs(e.r) do
                if type(x) == "table" and x[1] ~= nil and x[2] ~= nil then S.rn_map[tostring(x[1])] = tostring(x[2]) end
            end
        end
        S.rn_scan = S.rn_scan + 1
    end
    return S.rn_map[seed_s]
end

function PB.note_pick(want)
    if not S then return end
    S.pick_n = (S.pick_n or 0) + 1
    if (S.pick_n or 0) <= 20 then pcall(mp_log.info, "REPLAY", "recorded pick %s i=%s", tostring(want), tostring(S.i)) end
end

DO.ck = function(e)
    local cur = RP().snapshot()
    local f = RP().compare(e, cur)
    if f == "a" or f == "r" then
        S.ck_detail = f .. "=" .. tostring(e[f]) .. "/" .. tostring(cur[f])
        return "checksum_" .. f
    end
    if f then
        local fixed = {}
        if tonumber(e.m) and tostring(e.m) ~= tostring(cur.m) then
            G.GAME.dollars = tonumber(e.m)
            fixed[#fixed + 1] = "ck_m"
        end
        if e.s ~= nil and tostring(e.s) ~= tostring(cur.s) and tonumber(e.s) and type(G.GAME.chips) == "number" then
            G.GAME.chips = tonumber(e.s)
            fixed[#fixed + 1] = "ck_s"
        end
        for _, k in ipairs({ "h", "j", "d" }) do
            if e[k] ~= nil and cur[k] ~= nil and tostring(e[k]) ~= tostring(cur[k]) then fixed[#fixed + 1] = "ck_" .. k .. "!" end
        end
        note_resync(fixed)
    end
    S.ante = tonumber(e.a) or S.ante
end

local function rebase(e)
    if tonumber(e.g) then S.ge0 = RP().ge - tonumber(e.g) end
    if tonumber(e.ev) then S.ev0 = RP().evs - tonumber(e.ev) end
end

DO.rj = function(e)
    rebase(e)
    if type(e.ck) == "table" then
        local f = RP().compare(e.ck, RP().snapshot())
        if f then return "rejoin_" .. f end
    end
end

local function is_start_blind(e)
    return e ~= nil and e.k == "in" and type(e.m) == "table" and e.m.type == "start_blind"
end

local function starts_blind(e)
    if not is_start_blind(e) then return false end
    return e.s == nil or e.s == G.STATES.BLIND_SELECT
end

local function start_ready()
    if G.STATE ~= G.STATES.BLIND_SELECT then return true end
    return (G.blind_select ~= nil) ~= ((G.GAME and G.GAME.facing_blind) and true or false)
end

DO["in"] = function(e)
    if type(e.m) ~= "table" or not bom_events then return end
    local facing = G.GAME and G.GAME.facing_blind
    local ok, m = pcall(function() return bom_core.json.decode(bom_core.json.encode(e.m)) end)
    S.injecting = true
    pcall(bom_events.dispatch, ok and m or e.m)
    S.injecting = false
    if starts_blind(e) then S.blind_started = (not facing and G.GAME and G.GAME.facing_blind) and true or nil end
end

DO["end"] = function() S.finished_stream = true end

local function keep_match_fields()
    pcall(function()
        local st = bmatch().get_state()
        st.match_id = S.id
        st.server_player_id = S.pid
        st.ranked = S.header.ranked and true or nil
        st.roster = S.header.players
    end)
end

DO.rs = function(e)
    local d = e.m
    local Rj = rawget(_G, "bom_rejoin")
    if type(d) ~= "table" or d.big or not (Rj and Rj.restore_run) then return "rejoin" end
    S.note = S.note or note_for(e)
    rebase(e)
    S.restore_wait = true
    Rj.restore_run(d)
    keep_match_fields()
end

DO.rl = function(e)
    local Rj = rawget(_G, "bom_rejoin")
    if type(e.m) ~= "table" or not (Rj and Rj.resync_live) then return end
    rebase(e)
    Rj.resync_live(e.m)
    keep_match_fields()
end

local function dispatch(e)
    local fn = DO[e.k]
    if not fn then return nil end
    S.driving = true
    local ok, res = pcall(fn, e)
    S.driving = false
    if not ok then
        S.ck_detail = "err=" .. tostring(res):sub(1, 300)
        return "error_" .. tostring(e.k)
    end
    if e.a and (e.k == "bs" or e.k == "sk") then S.ante = tonumber(e.a) or S.ante end
    return res
end

function PB.set_text(t)
    if S then S.ui.text = t end
end

local function title_text()
    if not S then return "" end
    return S.mode == "live" and L("LIVE") or L("REPLAY")
end

function PB.version_note()
    if not S or S.mode == "live" or S.script then return nil end
    local st = type(S.start) == "table" and S.start or nil
    if not st then return nil end
    local cur = rawget(_G, "OVERHAUL_VERSION")
    if st.gv == nil then return L("Older version") end
    if cur ~= nil and tostring(st.gv) ~= tostring(cur) then
        if type(st.gn) == "string" and st.gn ~= "" then return string.format(L("Version %s"), st.gn) end
        return L("Older version")
    end
    return nil
end

local function name_text()
    if not S then return "" end
    for _, p in ipairs(S.header.players or {}) do
        if tonumber(p.pid) == S.pid then return tostring(p.name or "") end
    end
    return ""
end

local function seat_entries(pid)
    if S.mode == "live" then return S.live[pid] and S.live[pid].entries or {} end
    return RP().clean(stream_of(S.streams, pid))
end

function PB.seat_names()
    if not S then return {} end
    local out, pids = {}, {}
    for _, p in ipairs(S.header.players or {}) do
        local pid = type(p) == "table" and tonumber(p.pid)
        if pid and not out[pid] then
            out[pid] = { cur = p.name ~= nil and tostring(p.name) or nil, rec = type(p.rec) == "string" and p.rec or nil }
            pids[#pids + 1] = pid
        end
    end
    local entries = {}
    for _, pid in ipairs(pids) do
        entries[pid] = seat_entries(pid)
        local st = start_entry(entries[pid])
        if st and type(st.nm) == "string" and st.nm ~= "" then out[pid].rec = st.nm end
    end
    if #pids == 2 then
        for i, pid in ipairs(pids) do
            local n = out[pid]
            if not (n.rec and n.rec ~= n.cur) then
                for _, e in ipairs(entries[pids[3 - i]]) do
                    if type(e) == "table" and e.k == "sw" and type(e.from) == "string" and e.from ~= "" then n.rec = n.rec or e.from break end
                end
            end
        end
    end
    for _, n in pairs(out) do n.rec = n.rec or n.cur end
    return out
end

function PB.shown_name(name)
    if not S or name == nil then return name end
    local names = PB.seat_names()
    local mine = names[S.pid]
    if mine and (mine.rec == name or mine.cur == name) then return mine.cur or name end
    for _, n in pairs(names) do
        if n.rec == name or n.cur == name then return n.cur or name end
    end
    return name
end

function PB.is_me(name)
    if not S or name == nil then return false end
    local mine = PB.seat_names()[S.pid]
    return mine ~= nil and (mine.rec == name or mine.cur == name)
end

local function hold_pattern()
    local f = L("You now hold %s's run")
    local a, b = f:find("%s", 1, true)
    if not a then return nil end
    local esc = function(t) return (t:gsub("[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%0")) end
    return "^" .. esc(f:sub(1, a - 1)) .. "(.+)" .. esc(f:sub(b + 1)) .. "$"
end

function PB.swap_text(text)
    if not (S and G.GAME and type(text) == "string") then return text end
    local own = L("Your own run is back")
    local pat = hold_pattern()
    if text ~= own and not (pat and text:match(pat)) then return text end
    local owner = G.GAME.bom_sw_owner
    if owner == nil and text ~= own then owner = text:match(pat) end
    if owner == nil then return text end
    if PB.is_me(owner) then return own end
    return string.format(L("You now hold %s's run"), tostring(PB.shown_name(owner)))
end

PB.BANNER_H = 1.5

function PB.banner_dy()
    local bar, ra = G.PB_BAR, G.ROOM_ATTACH
    if not (S and bar and bar.T and ra and ra.T and UIK and UIK.portrait and UIK.portrait()) then return nil end
    local cy = ra.T.y + ra.T.h / 2
    if cy - 0.6 + PB.BANNER_H / 2 < bar.T.y then return nil end
    return bar.T.y - 0.15 - PB.BANNER_H / 2 - cy
end

function PB.hook_swap()
    local W = package.loaded["functions.modes.swap_mode"]
    if PB._swap_wrapped or type(W) ~= "table" or type(W.banner) ~= "function" then return end
    PB._swap_wrapped = true
    W.banner_dy = function()
        local ok, dy = pcall(PB.banner_dy)
        return ok and dy or nil
    end
    local banner = W.banner
    W.banner = function(text, ...)
        if S then
            local ok, t = pcall(PB.swap_text, text)
            if ok then text = t end
        end
        return banner(text, ...)
    end
end

local function base_text()
    if not S then return "" end
    local speed = S.ff and ">>" or ("x" .. tostring(PB.SPEEDS[S.speed_i] or 1))
    if S.paused and not S.ff_to and not S.step_to then speed = L("Paused") end
    return L("Ante") .. " " .. tostring(S.ante or ante_now()) .. "  " .. speed
end

function PB.apply_speed()
    if not S then return end
    S.base_speed = S.base_speed or G.SETTINGS.GAMESPEED or 1
    local mult = S.ff and PB.FF_SPEED or (PB.SPEEDS[S.speed_i] or 1)
    G.SETTINGS.GAMESPEED = S.base_speed * mult
end

function PB.restore_speed()
    if S and S.base_speed then G.SETTINGS.GAMESPEED = S.base_speed end
end

local function apply_boot(m, boot)
    if type(boot) ~= "table" then return end
    local sett = m.get_settings and m.get_settings()
    if type(boot.set) == "table" and type(sett) == "table" then
        for k in pairs(sett) do sett[k] = nil end
        for k, v in pairs(boot.set) do sett[k] = v end
    end
    pcall(function()
        local st = m.get_state()
        st.is_host = boot.host == true
        if boot.mode then st.mode = boot.mode end
    end)
end

local function setup_party(boot)
    local P = rawget(_G, "bom_party")
    if not (P and P.S) then return end
    local party = type(boot) == "table" and boot.party or nil
    if not party and S.header.kind ~= "party" then return end
    S.party = true
    P.S.flag = true
    P.S.me = tonumber(party and party.me) or S.pid
    P.S.room = type(party and party.room) == "table" and party.room or { kind = S.header.mode, players = S.header.players }
    P.S.code = P.S.room.code
    P.S.ps, P.S.result = nil, nil
    local PR = rawget(_G, "bom_party_run")
    if PR and PR.on_message then pcall(PR.on_message, { type = "match_start", party = true }) end
end

function PB.apply_tag_needs(start)
    if (tonumber(start and start.v) or 1) < 4 or not (G and G.P_CENTERS) then return nil end
    local miss = {}
    for _, k in ipairs(type(start.nd) == "table" and start.nd or {}) do miss[k] = true end
    local saved = {}
    for _, list in ipairs({ G.P_CENTER_POOLS and G.P_CENTER_POOLS.Tag or {}, G.P_TAGS or {} }) do
        for _, t in pairs(list) do
            local r = type(t) == "table" and t.requires or nil
            local c = type(r) == "string" and G.P_CENTERS[r] or nil
            if c and saved[r] == nil then
                saved[r] = c.discovered and true or false
                c.discovered = not miss[r]
            end
        end
    end
    return saved
end

function PB.restore_tag_needs(saved)
    for k, v in pairs(saved or {}) do
        local c = G and G.P_CENTERS and G.P_CENTERS[k]
        if c then c.discovered = v end
    end
end

local function clear_waiting()
    pcall(function()
        local mg = rawget(_G, "Minigames")
        if mg and mg.end_wait then mg.end_wait() end
    end)
    pcall(function() if bom_ui and bom_ui.hide_pvp_waiting then bom_ui.hide_pvp_waiting() end end)
end

local function launch()
    local h = S.header
    clear_waiting()
    local start = S.start or {}
    local seed = start.seed or (type(h.seeds) == "table" and h.seeds[1]) or "REPLAY"
    S.ante, S.loading, S.load_t = 1, true, 0
    S.i, S.wait, S.watch = 1, 0, 0
    S.eo_done, S.eval_wait = {}, nil
    S.hk_n, S.hk_exp = 0, nil
    S.note = not S.script and note_for(S.start) or nil
    S.full_orders = (tonumber(S.start and S.start.v) or 1) >= 2
    PB.restore_tag_needs(S.tag_saved)
    S.tag_saved = nil
    pcall(function() S.tag_saved = PB.apply_tag_needs(S.start) end)
    pcall(function()
r 13 1825 %20%20%20%20%20%20%20%20 -
l 293
    end)
    if start.deck_name and get_deck_from_name then
        pcall(function() G.GAME.viewed_back = Back(get_deck_from_name(start.deck_name)) end)
    end
    if h.kind == "local" or not (bmatch() and bom_room and bom_room.do_mp_start_run) then
        G.FUNCS.start_run(nil, { seed = seed, stake = tonumber(start.stake) or 1, mp_stake = start.mp_stake })
        return
    end
    local m = bmatch()
    pcall(m.reset)
    pcall(function() m.get_state().phase = m.PHASE.LOBBY end)
    local RS = rawget(_G, "bom_rulesets")
    if type(h.ruleset) == "table" and (h.ranked or h.ruleset.locked) and RS and RS.apply_server then
        pcall(RS.apply_server, h.ruleset, h.ranked and "ranked" or "daily")
    elseif type(h.settings) == "table" and m.on_settings_received then
        pcall(m.on_settings_received, h.settings)
    end
    apply_boot(m, start.boot)
    setup_party(start.boot)
    pcall(function()
        local st = m.get_state()
        st.server_player_id = S.pid
        if type(start.boot) ~= "table" then st.is_host = S.pid == 0 end
        st.match_id = S.id
        st.ranked = h.ranked and true or nil
        st.roster = h.players
        for _, p in ipairs(h.players or {}) do
            if tonumber(p.pid) == S.pid then st.my_name = p.name else st.opp_name, st.opp_bot = p.name, p.is_bot end
        end
    end)
    pcall(m.start_match, seed)
    local orig_deck = m.get_my_deck
    local sett = m.get_settings and m.get_settings() or {}
    if start.deck_name then m.get_my_deck = function() return start.deck_name end end
    if type(start.boot) ~= "table" then
        if tonumber(start.stake) then sett.stake = tonumber(start.stake) end
        if start.mp_stake then sett.mp_stake = start.mp_stake end
    end
    local ok, err = pcall(bom_room.do_mp_start_run, seed, "replay")
    m.get_my_deck = orig_deck
    if not ok then
        drift("start " .. tostring(err))
        return
    end
    G.E_MANAGER:add_event(Event({ trigger = "immediate", no_delete = true, func = function()
        local rw = rawget(_G, "bom_reworks")
        if rw and rw.apply and type(h.ruleset) == "table" and type(h.ruleset.reworks) == "table" then pcall(rw.apply, h.ruleset.reworks) end
        return true
    end }))
end

local function entries_for(pid)
    if S.mode == "live" then
        S.live[pid] = S.live[pid] or { seq = 0, pending = {}, entries = {} }
        return S.live[pid].entries
    end
    return RP().clean(stream_of(S.streams, pid))
end

function PB.start(o)
    if S then PB.stop(true) end
    local R = RP()
    if not R or type(o) ~= "table" then return false end
    S = {
        mode = o.mode or "replay", id = o.id, header = o.header or {}, streams = o.streams or {},
        pid = o.pid or 0, speed_i = 1, ff = false, paused = false, driving = false, ui = { text = "" },
        see_jokers = o.see_jokers ~= false, live = {}, script = o.script, max_ante = o.max_ante,
    }
    if S.mode == "live" then
        for k, st in pairs(o.streams or {}) do
            local pid = tonumber(k)
            if pid then
                S.live[pid] = { seq = tonumber(o.seqs and (o.seqs[k] or o.seqs[pid])) or 0, pending = {}, entries = R.clean(st) }
            end
        end
    end
    S.entries = S.script and {} or entries_for(S.pid)
    S.start = S.script and (o.start or {}) or start_entry(S.entries)
    if not S.start and S.mode ~= "live" then
        S = nil
        R.popup(L("No replay for this match"))
        return false
    end
    if S.start then S.guards = install_guards() end
    pcall(PB.guard_input)
    pcall(PB.hook_swap)
    S.base_speed = G.SETTINGS.GAMESPEED
    clear_waiting()
    if S.mode == "live" then S.ff_to = #S.entries end
    if not S.start then
        S.waiting_start = true
        PB.set_text(L("Waiting for the match to start..."))
        PB.build_bar()
        return true
    end
    S.launch_wait, S.loading = true, true
    return true
end

function PB.restart(pid, ante)
    if not S then return end
    S.pid = pid or S.pid
    S.entries = entries_for(S.pid)
    S.start = start_entry(S.entries) or S.start
    S.done, S.drifted, S.finished_stream = nil, nil, nil
    S.step_to, S.back_to = nil, nil
    S.ff_to = ante and ante > 1 and RP().index_of_ante(S.entries, ante) or nil
    if S.mode == "live" and not S.ff_to then S.ff_to = #S.entries end
    PB.remove_bar()
    launch()
end

function PB.feed(pid, seq, entries)
    if not (S and S.mode == "live") then return end
    pid = tonumber(pid)
    if not pid then return end
    S.live[pid] = S.live[pid] or { seq = 0, pending = {}, entries = {} }
    RP().merge_live(S.live[pid], seq, entries)
    if S.waiting_start and pid == S.pid then
        S.start = start_entry(S.entries)
        if S.start then
            S.waiting_start = nil
            S.guards = S.guards or install_guards()
            launch()
        end
    end
end

function PB.live_ended()
    if not S then return end
    S.live_over = true
end

function PB.stop(quiet)
    if not S then return end
    local was = S
    PB.remove_bar()
    G.PB_END = nil
    if was.end_menu and G.OVERLAY_MENU == was.end_menu then pcall(G.FUNCS.exit_overlay_menu) end
    PB.restore_speed()
    pcall(PB.restore_tag_needs, was.tag_saved)
    remove_guards(was.guards)
    clear_waiting()
    PB._last = { done = was.done, drifted = was.drifted, drift_why = was.drift_why, drift_info = was.drift_info, i = was.i, n = #(was.entries or {}), mode = was.mode, pid = was.pid, id = was.id }
    S = nil
    pcall(function()
        local rw = rawget(_G, "bom_reworks")
        if rw and rw.clear then rw.clear() end
    end)
    pcall(function()
        local RS = rawget(_G, "bom_rulesets")
        if RS and RS.clear then RS.clear() end
    end)
    pcall(function() if bom_ui and bom_ui.destroy_match_hud then bom_ui.destroy_match_hud() end end)
    if was.party then
        pcall(function()
            local P = rawget(_G, "bom_party")
            if P and P.clear then P.clear() end
        end)
    end
    if G.GAME then G.GAME.multiplayer = nil end
    pcall(function()
        local m = bmatch()
        if not (m and m.reset) then return end
        local rs = rawget(_G, "remove_save")
        if type(rs) == "function" then _G.remove_save = NOOP end
        pcall(m.reset)
        _G.remove_save = rs
    end)
    if was.mode == "live" and not quiet and bom_core and bom_core.send then
        pcall(bom_core.send, { type = "spectate_leave" })
    end
    if bom_core and bom_core.send and was.mode == "live" then pcall(bom_core.send, { type = "social_status", where = "menu" }) end
end

function PB.leave()
    if not S then return end
    PB.stop(false)
    PB.back_to_mp = true
    if G.FUNCS.go_to_menu then G.FUNCS.go_to_menu({ config = {} }) end
end

local INSTANT = { ck = true, hk = true, rn = true, start = true, ["end"] = true, rj = true, ["in"] = true, eo = true }

local function info_in(e)
    return e ~= nil and e.k == "in" and type(e.m) == "table" and PB.INFO_IN[e.m.type] == true
end

local function score_reached(cur, want)
    if cur == want then return true end
    local a, b = tonumber(cur), tonumber(want)
    return a ~= nil and b ~= nil and a == a and b == b and a >= b
end

local function in_sync(e)
    if e.s ~= nil and G.STATE ~= e.s and not (S.seen and S.seen[e.s]) then return false end
    if tonumber(e.g) and S.ge0 and RP().ge - S.ge0 < tonumber(e.g) then return false end
    if tonumber(e.ev) and S.ev0 and RP().evs - S.ev0 < tonumber(e.ev) then return false end
    if not G.GAME then return true end
    if e.sc ~= nil and not score_reached(RP().score_str(G.GAME.chips), e.sc) then return false end
    if e.dl ~= nil and math.floor((tonumber(G.GAME.dollars) or 0) + 0.5) ~= e.dl then return false end
    return true
end

local function hold_in(dt)
    if idle() then S.state_hold = (S.state_hold or 0) + dt else S.busy_hold = (S.busy_hold or 0) + dt end
    return (S.state_hold or 0) < PB.IN_STATE_S and (S.busy_hold or 0) < PB.WATCHDOG_S
end

local function lives_early(e)
    if not (e and e.k == "in" and e.s == nil and type(e.m) == "table" and tonumber(e.m.myLives)) then return false end
    local m = bmatch()
    local st = m and m.get_state and m.get_state() or {}
    local cur = tonumber(st.my_lives) or tonumber(G.GAME and G.GAME.mp_lives)
    if not cur or tonumber(e.m.myLives) >= cur or e.m.phase == "finished" then return false end
    return not (st.pvp_loss_pending or (G.GAME and G.GAME.mp_blind_loss_pending))
end

local function actions_left()
    for j = S.i, #S.entries do
        local x = S.entries[j]
        if x.k ~= "in" and x.k ~= "ck" and x.k ~= "hk" and x.k ~= "rn" and x.k ~= "end" and x.k ~= "start" and x.k ~= "eo" then return true end
    end
    return false
end

local function gap_before(e)
    if S.ff or not e or INSTANT[e.k] then return 0 end
    return PB.STEP_GAP / (PB.SPEEDS[S.speed_i] or 1)
end

local function next_script_entry()
    local R = RP()
    if S.max_ante and ante_now() > S.max_ante then return nil end
    local st = G.STATE
    local s = G.STATES
    if st == s.GAME_OVER then return nil end
    if st == s.BLIND_SELECT and G.blind_select then
        local od = G.GAME.blind_on_deck
        return { k = "bs", b = od and G.GAME.round_resets.blind_choices[od], a = ante_now() }
    elseif st == s.SELECTING_HAND and G.hand and #G.hand.cards > 0 then
        local c = {}
        for i = 1, math.min(5, #G.hand.cards) do c[i] = i end
        return { k = "pl", c = c }
    elseif st == s.ROUND_EVAL and G.round_eval then
        return { k = "co" }
    elseif st == s.SHOP and G.shop then
        return { k = "ns" }
    elseif pack_state() and G.pack_cards then
        return { k = "sp" }
    end
    return false
end

local function hide_jokers()
    if S.see_jokers or S.mode ~= "live" or not (G.jokers and G.jokers.cards) then return end
    for _, c in ipairs(G.jokers.cards) do
        if c.facing ~= "back" then c.facing, c.sprite_facing = "back", "back" end
    end
end

function PB.holding()
    return S ~= nil and S.paused and not S.ff_to and not S.step_to
end

function PB.update(dt)
    if not S then
        if PB.back_to_mp and G and G.STATE == G.STATES.MENU and not G.screenwipe then
            local back = PB.back_to
            if back and PB._last and back.id == PB._last.id then
                if not G.MAIN_MENU_UI then return end
                PB.back_to_mp, PB.back_to = nil, nil
                pcall(back.fn)
                return
            end
            PB.back_to_mp, PB.back_to = nil, nil
            pcall(function()
                local M = rawget(_G, "mpm_menu") or (MP and MP.menu)
                if M and M.enter then M.enter() end
            end)
        end
        return
    end
    dt = dt or 0
    if S.waiting_start then
        if S.live_over then
            S.waiting_start, S.done = nil, true
            PB.set_text(L("The match is over"))
            PB.build_bar()
        end
        return
    end
    if S.launch_wait then
