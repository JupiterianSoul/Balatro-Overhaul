            ["Replay finished"] = "Replay terminé", ["The match is over"] = "Le match est terminé",
            ["Watch again"] = "Revoir", ["Replay stopped"] = "Replay interrompu", ["Stopped at Ante %d"] = "Arrêté à la mise initiale %d",
            ["Run won"] = "Partie gagnée", ["Game over at Ante %d"] = "Perdu à la mise initiale %d", ["Ended at Ante %d, round %d"] = "Fin à la mise initiale %d, manche %d",
            ["Goal reached: %s"] = "Objectif atteint : %s", ["Final time"] = "Temps final",
            ["Waiting for the match to start..."] = "En attente du début du match...",
            ["Recorded with an older version"] = "Enregistré avec une ancienne version", ["Older version"] = "Ancienne version", ["Version %s"] = "Version %s",
            ["Recorded with other mods"] = "Enregistré avec d'autres mods",
            ["It may not play back exactly"] = "Il peut différer du match",
        },
        es = {
            ["This replay drifted at Ante %d"] = "Esta repetición se desvió en la apuesta inicial %d",
            ["Drifted at Ante %d"] = "Desviada en la apuesta inicial %d",
            ["LIVE"] = "EN DIRECTO", ["REPLAY"] = "REPETICIÓN", ["Paused"] = "En pausa", ["Ante"] = "Apuesta",
            ["Play"] = "Reproducir", ["Pause"] = "Pausa", ["Switch"] = "Cambiar", ["Leave"] = "Salir", ["Restart"] = "Reiniciar",
            ["Replay finished"] = "Repetición terminada", ["The match is over"] = "La partida terminó",
            ["Watch again"] = "Ver otra vez", ["Replay stopped"] = "Repetición detenida", ["Stopped at Ante %d"] = "Detenida en la apuesta inicial %d",
            ["Run won"] = "Partida ganada", ["Game over at Ante %d"] = "Derrota en la apuesta inicial %d", ["Ended at Ante %d, round %d"] = "Fin en la apuesta inicial %d, ronda %d",
            ["Goal reached: %s"] = "Objetivo cumplido: %s", ["Final time"] = "Tiempo final",
