local PB = {}

local function L(s) return mod_loc and mod_loc(s) or s end
local function NOOP() end

PB.SPEEDS = { 1, 2, 4 }
PB.FF_SPEED = 16
PB.WATCHDOG_S = 25
PB.IN_HOLD_S = 3
PB.IN_STATE_S = 1.5
PB.STEP_GAP = 0.6
PB.LIVES_HOLD_S = 20
PB.PAUSED_S = 8
PB.LOAD_S = 60
PB.INFO_IN = {
    match_state_update = true, set_location = true, enemy_info = true, ante_timer = true, pvp_timer_paused = true,
    pvp_timer_resumed = true, opponent_deck = true, party_location = true, party_notice = true,
    opponent_ready_blind = true, opponent_unready_blind = true,
}

local S = nil
PB._last = nil

function PB.active() return S ~= nil end
function PB.state() return S or PB._last end
function PB.open_pool() return S ~= nil and type(S.start) == "table" and S.start.op ~= nil end

local function RP() return rawget(_G, "bom_replay") end
local function bmatch() return rawget(_G, "bom_match") end

PB.ACTION_BUTTONS = {
    play_cards_from_highlighted = true, discard_cards_from_highlighted = true, select_blind = true, skip_blind = true,
    buy_from_shop = true, sell_card = true, use_card = true, reroll_shop = true, skip_booster = true, cash_out = true,
    toggle_shop = true, reroll_boss = true, bom_lose_life_button = true, bom_toggle_ready_blind = true,
    options = true, mps_chat_open_run = true, social_emote_open_run = true,
}

function PB.blocks_button(name)
    return S ~= nil and not S.waiting_start and not S.driving and PB.ACTION_BUTTONS[name] == true
end

local IN_PREFIX = { "spectate_", "social_", "chat_", "notify_", "ranked_", "replay_" }
local IN_ALLOW = { match_history = true, menu_info = true, name_check = true, pong = true, daily_ruleset = true, room_list = true, spec_board = false }

local function allowed(t, extra)
    if type(t) ~= "string" then return false end
    if IN_ALLOW[t] or (extra and extra[t]) then return true end
    for _, p in ipairs(IN_PREFIX) do
        if t:sub(1, #p) == p then return true end
    end
    return false
end
PB.allowed_type = allowed

function PB.filter_in(data)
    if not S or S.waiting_start or S.injecting or type(data) ~= "table" then return false end
    return not allowed(data.type)
end

local OUT_ALLOW = { ping = true, spectate_list = true, spectate_watch = true, spectate_leave = true, social_status = true }

local STUB_GLOBALS = {
    "save_run", "check_for_unlock", "unlock_card", "unlock_achievement", "discover_card",
    "set_joker_usage", "set_joker_win", "set_joker_loss", "set_deck_usage", "set_deck_win", "set_deck_loss",
    "set_voucher_usage", "inc_career_stat", "save_with_action",
    "progression_on_hand_played", "progression_on_ante_cleared", "progression_on_boss_defeated", "progression_on_run_win",
    "award_xp", "mp_award_xp", "mp_record_match", "notify_alert", "remove_save", "unlock_notify",
}
local RUN_ONLY_GLOBALS = { "set_consumeable_usage", "set_hand_usage", "check_and_set_high_score" }
local NIL_GLOBALS = { "AchievementManager", "QuestManager" }

local function run_only(fn)
    return function(...)
        local key = G.SETTINGS and G.SETTINGS.profile
        local real = key and G.PROFILES and G.PROFILES[key]
        local comp = G.SETTINGS and G.SETTINGS.COMP
        if real then
            G.PROFILES[key] = setmetatable({ consumeable_usage = {}, hand_usage = {}, high_scores = {}, voucher_usage = {}, joker_usage = {} }, { __index = real })
        end
        if comp then G.SETTINGS.COMP = nil end
        local res = { pcall(fn, ...) }
        if real then G.PROFILES[key] = real end
        if comp then G.SETTINGS.COMP = comp end
        if not res[1] then error(res[2], 0) end
        return unpack(res, 2)
    end
end
local G_STUBS = { "save_progress", "save_settings", "save_notify" }
local MODULE_STUBS = {
    bom_rejoin = { "on_save", "upload_pending", "poll_pack", "on_connection_lost", "begin_reconnect", "store_session", "show_menu_popup" },
    bom_rewards = { "grant", "award", "on_match_end", "add_xp" },
}

local function install_guards()
    local saved = { globals = {}, g = {}, mods = {} }
    for _, k in ipairs(STUB_GLOBALS) do
        local v = rawget(_G, k)
        saved.globals[k] = { v = v }
        if type(v) == "function" then _G[k] = NOOP end
    end
    for _, k in ipairs(RUN_ONLY_GLOBALS) do
        local v = rawget(_G, k)
        saved.globals[k] = { v = v }
        if type(v) == "function" then _G[k] = run_only(v) end
    end
    for _, k in ipairs(NIL_GLOBALS) do
        saved.globals[k] = { v = rawget(_G, k) }
        _G[k] = nil
    end
    for _, k in ipairs(G_STUBS) do
        saved.g[k] = { v = rawget(G, k) }
        G[k] = NOOP
    end
    for mod, list in pairs(MODULE_STUBS) do
        local m = rawget(_G, mod)
        if type(m) == "table" then
            saved.mods[mod] = {}
            for _, k in ipairs(list) do
                if type(m[k]) == "function" then
                    saved.mods[mod][k] = m[k]
                    m[k] = NOOP
                end
            end
        end
    end
    return saved
end

local function remove_guards(saved)
    if not saved then return end
    for k, s in pairs(saved.globals) do _G[k] = s.v end
    for k, s in pairs(saved.g) do G[k] = s.v end
    for mod, list in pairs(saved.mods) do
        local m = rawget(_G, mod)
        if type(m) == "table" then
            for k, fn in pairs(list) do m[k] = fn end
        end
    end
end

local function stream_of(streams, pid)
    if type(streams) ~= "table" then return nil end
    return streams[pid] or streams[tostring(pid)]
end

local function start_entry(entries)
    for _, e in ipairs(entries) do
        if e.k == "start" then return e end
    end
    return nil
end

local function find_btn(node, name, depth)
    depth = depth or 0
    if type(node) ~= "table" or depth > 40 then return nil end
    if node.config and node.config.button == name then return node end
    local root = node.UIRoot
    if root then
        local hit = find_btn(root, name, depth + 1)
        if hit then return hit end
    end
    if type(node.children) == "table" then
        for _, c in pairs(node.children) do
            local hit = find_btn(c, name, depth + 1)
            if hit then return hit end
        end
    end
    return nil
end

local function ensure_order(area, ranks)
    if not ranks then
        if not (S and S.full_orders and area and area.cards and #area.cards > 1) then return true end
        ranks = {}
        for i = 1, #area.cards do ranks[i] = i end
    end
    if not (area and area.cards) then return false end
    local R = RP()
    local out = R.apply_ranks(area.cards, ranks, function(c) return tonumber(c.sort_id) or 0 end)
    if not out then return false end
    for i, c in ipairs(out) do area.cards[i] = c end
    if area.set_ranks then pcall(area.set_ranks, area) end
    if area.align_cards then pcall(area.align_cards, area) end
    return true
end

local function highlight(area, idxs)
    if not (area and area.cards) then return false end
    area:unhighlight_all()
    for _, i in ipairs(idxs or {}) do
        local c = area.cards[i]
        if not c then return false end
        area:add_to_highlighted(c, true)
        if not c.highlighted then return false end
    end
    return true
end

local function screen_order(area, idxs)
    if type(idxs) ~= "table" then return true end
    if not (area and area.cards) then return false end
    local cards, xs = {}, {}
    for k, i in ipairs(idxs) do
        local c = area.cards[i]
        if not (c and c.T and c.highlighted) then return false end
        cards[k], xs[k] = c, c.T.x
    end
    table.sort(xs)
    for k, c in ipairs(cards) do c.T.x = xs[k] end
    return true
end
PB.screen_order = screen_order

local function pack_state()
    local st = G.STATE
    local s = G.STATES
    return st == s.TAROT_PACK or st == s.PLANET_PACK or st == s.SPECTRAL_PACK or st == s.STANDARD_PACK
        or st == s.BUFFOON_PACK or (s.SMODS_BOOSTER_OPENED and st == s.SMODS_BOOSTER_OPENED)
end

local function in_run_state()
    local s = G.STATES
    return G.STATE == s.SHOP or G.STATE == s.SELECTING_HAND or G.STATE == s.BLIND_SELECT or pack_state()
end

local READY = {
    bs = function() return G.STATE == G.STATES.BLIND_SELECT and G.blind_select ~= nil end,
    sk = function() return G.STATE == G.STATES.BLIND_SELECT and G.blind_select ~= nil end,
    rb = function() return G.STATE == G.STATES.BLIND_SELECT and G.blind_select ~= nil end,
    pl = function() return G.STATE == G.STATES.SELECTING_HAND and G.hand and #G.hand.cards > 0 end,
    di = function() return G.STATE == G.STATES.SELECTING_HAND and G.hand and #G.hand.cards > 0 end,
    by = function() return G.STATE == G.STATES.SHOP and G.shop ~= nil end,
    rr = function() return G.STATE == G.STATES.SHOP and G.shop ~= nil end,
    ns = function() return G.STATE == G.STATES.SHOP and G.shop ~= nil end,
    se = in_run_state,
    us = in_run_state,
    pk = function() return pack_state() and G.pack_cards ~= nil and #G.pack_cards.cards > 0 end,
    sp = function() return pack_state() and G.pack_cards ~= nil end,
    co = function(e)
        if not (G.STATE == G.STATES.ROUND_EVAL and G.round_eval ~= nil) then return false end
        return not (e and e.l) or PB.lose_life_btn() ~= nil
    end,
    ck = function() return G.STATE == G.STATES.ROUND_EVAL end,
    hk = function() return G.STATE == G.STATES.SELECTING_HAND and G.hand and #G.hand.cards > 0 end,
}

local function idle()
    if G.screenwipe then return false end
    if G.CONTROLLER and G.CONTROLLER.locks then
        for k, v in pairs(G.CONTROLLER.locks) do
            if v and k ~= "frame" and k ~= "frame_set" and k ~= "wipe" then return false end
        end
    end
    if G.E_MANAGER and G.E_MANAGER.queues then
        for _, q in pairs(G.E_MANAGER.queues) do
            for _, ev in ipairs(q) do
                if ev.blocking and not ev.complete then return false end
            end
        end
    end
    return true
end

local function ante_now()
    return G.GAME and G.GAME.round_resets and tonumber(G.GAME.round_resets.ante) or 1
end

PB.NOTES = {
    old = { "Recorded with an older version", "It may not play back exactly" },
    mods = { "Recorded with other mods", "It may not play back exactly" },
}

local function note_for(e)
    local R = RP()
    if type(e) ~= "table" or not R then return nil end
    if e.k == "start" and (tonumber(e.v) or 1) < (R.EXACT_V or 3) then return "old" end
    if e.k == "start" and e.gv ~= nil and tostring(e.gv) ~= tostring(rawget(_G, "OVERHAUL_VERSION")) then return "old" end
    if e.mf ~= nil and R.mods_fp and tostring(e.mf) ~= R.mods_fp() then return "mods" end
    if e.ff ~= nil and R.forge_fp and tostring(e.ff) ~= tostring(R.forge_fp()) then return "mods" end
    return nil
end
PB.note_for = note_for

local function drift(why)
    if not S or S.done then return end
    S.drifted = S.ante or ante_now()
    S.drift_why = why
    pcall(function()
        local st = bmatch() and bmatch().get_state() or {}
        local name = "?"
        for k, v in pairs(G.STATES) do if v == G.STATE then name = k end end
        S.drift_info = (S.ck_detail and (S.ck_detail .. " ") or "") .. string.format("state=%s eval=%s loss=%s end_pvp=%s pvp_loss=%s hands=%s", name, tostring(G.round_eval ~= nil),
            tostring(G.GAME.mp_blind_loss_pending), tostring(st.end_pvp), tostring(st.pvp_loss_pending), tostring(G.GAME.current_round.hands_left))
    end)
    S.done = true
    local note = S.note and PB.NOTES[S.note]
    PB.set_text(note and L(note[1]) or string.format(L("Drifted at Ante %d"), S.drifted))
    PB.restore_speed()
    PB.build_bar()
end

local function card_at(code, i)
    local area = RP().area_of(code)
    return area and area.cards and area.cards[i] or nil, area
end

local DO = {}
PB.DO = DO

local function orders(e)
    if not ensure_order(G.jokers, e.jo) then return "jokers" end
    if not ensure_order(G.consumeables, e.ca) then return "consumables" end
end

DO.bs = function(e)
    local bad = orders(e)
    if bad then return bad end
    local on_deck = G.GAME.blind_on_deck
    local key = on_deck and G.GAME.round_resets.blind_choices and G.GAME.round_resets.blind_choices[on_deck]
    if e.b and key and e.b ~= key then return "blind" end
    local box = G.blind_select_opts and on_deck and G.blind_select_opts[string.lower(on_deck)]
    local btn = box and find_btn(box, "select_blind")
    local hud = rawget(_G, "bom_pvp_hud")
    local was = hud and hud._pvp_blind_starting
    if hud then hud._pvp_blind_starting = true end
    local ok, err = pcall(G.FUNCS.select_blind, btn or { config = { ref_table = G.P_BLINDS[key or e.b] }, UIBox = box })
    if hud then hud._pvp_blind_starting = was end
    if not ok then error(err, 0) end
end

DO.sk = function(e)
    local bad = orders(e)
    if bad then return bad end
    local on_deck = G.GAME.blind_on_deck
    local box = G.blind_select_opts and on_deck and G.blind_select_opts[string.lower(on_deck)]
    local btn = box and find_btn(box, "skip_blind")
    if not btn then return "skip" end
    G.FUNCS.skip_blind(btn)
end

DO.rb = function(e)
    local bad = orders(e)
    if bad then return bad end
    G.FUNCS.reroll_boss(find_btn(G.blind_select, "reroll_boss") or { config = {} })
end

local function play_or_discard(e, fn)
    local bad = orders(e)
    if bad then return bad end
    if not ensure_order(G.hand, e.o) then return "hand" end
    if not highlight(G.hand, e.c) then return "cards" end
    if not screen_order(G.hand, e.x) then return "cards" end
    fn()
end

DO.pl = function(e) return play_or_discard(e, function() G.FUNCS.play_cards_from_highlighted() end) end
DO.di = function(e) return play_or_discard(e, function() G.FUNCS.discard_cards_from_highlighted(nil, false) end) end

DO.by = function(e)
    local bad = orders(e)
    if bad then return bad end
    local card = card_at(e.w, e.i)
    if not card then return "buy" end
    if e.w == "sb" or e.w == "sv" then
        G.FUNCS.use_card({ config = { ref_table = card } })
        return
    end
    G.FUNCS.buy_from_shop({ config = { ref_table = card, id = e.u and "buy_and_use" or nil } })
end

DO.se = function(e)
    local bad = orders(e)
    if bad then return bad end
    local card = card_at(e.w, e.i)
    if not card then return "sell" end
    G.FUNCS.sell_card({ config = { ref_table = card } })
end

DO.rr = function(e)
    local bad = orders(e)
    if bad then return bad end
    G.FUNCS.reroll_shop(find_btn(G.shop, "reroll_shop") or { config = {} })
end

