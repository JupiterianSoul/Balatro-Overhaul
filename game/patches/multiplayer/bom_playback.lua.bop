l 887
        S.launch_wait = nil
        launch()
        return
    end
    if S.restore_wait then
        if G.STAGE == G.STAGES.RUN and G.GAME and not G.screenwipe and idle() and (in_run_state() or (G.STATE == G.STATES.ROUND_EVAL and G.round_eval)) then
            S.restore_wait = nil
            S.watch = 0
            PB.apply_speed()
            PB.build_bar()
        end
        return
    end
    if S.loading then
        S.load_t = (S.load_t or 0) + dt
        if S.load_t > PB.LOAD_S and not G.screenwipe then
            S.loading, S.load_t = false, 0
            drift("stuck_load")
            return
        end
        if G.STAGE == G.STAGES.RUN and G.GAME and G.STATE == G.STATES.BLIND_SELECT and G.blind_select and idle() then
            S.loading, S.load_t = false, 0
            S.ge0, S.ev0 = RP().ge, RP().evs
            PB.apply_speed()
            PB.build_bar()
            if S.script and RP()._test then RP()._test.begin_entry() end
        end
        return
    end
    hide_jokers()
    if PB.bar_stale() and (S.bar_fix_t or 0) <= 0 then
        S.bar_fix_t = 0.5
        PB.build_bar()
    end
    S.bar_fix_t = math.max(0, (S.bar_fix_t or 0) - (dt or 0))
    PB.end_tick()
    if S.viewer_menu and G.OVERLAY_MENU ~= S.viewer_menu then S.viewer_menu = nil end
    if G.SETTINGS.paused and not S.done and not S.paused and not S.script and not S.viewer_menu then
        S.paused_t = (S.paused_t or 0) + dt
        if S.paused_t > PB.PAUSED_S then
            if actions_left() then
                drift("paused")
            else
                S.done = true
                PB.set_text(S.mode == "live" and L("The match is over") or L("Replay finished"))
                PB.restore_speed()
                PB.build_bar()
            end
        end
    else
        S.paused_t = 0
    end
    if S.done or PB.holding() or G.SETTINGS.paused then
        if S.ui then S.ui.text = S.done and S.ui.text or base_text() end
        return
    end
    S.ui.text = base_text()
    for _ = 1, 40 do
        if not PB.step(dt) or not S or S.done or PB.holding() then break end
        dt = 0
    end
end

function PB.step(dt)
    S.seen = S.seen or {}
    if G.STATE ~= nil then S.seen[G.STATE] = true end
    local e = S.entries[S.i]
    if not e and S.script then
        local nxt = next_script_entry()
        if nxt == nil then
            S.done = true
            PB.set_text(L("Replay finished"))
            PB.build_bar()
            return false
        end
        if nxt == false then return false end
        if idle() then S.entries[#S.entries + 1] = nxt end
        e = S.entries[S.i]
        if not e then return false end
    end
    if not e then
        if S.mode == "live" and not S.live_over and not S.finished_stream then
            if S.ff then S.ff = false; PB.apply_speed() end
            return false
        end
        S.done = true
        PB.set_text(S.mode == "live" and L("The match is over") or L("Replay finished"))
        PB.restore_speed()
        PB.build_bar()
        return false
    end
    local want_ff = (S.ff_to ~= nil and S.i < S.ff_to) or false
    if S.mode == "live" and S.ff_to and S.i >= #S.entries - 1 then want_ff = false end
    if want_ff ~= (S.ff_fwd or false) then
        S.ff_fwd = want_ff
        S.ff = want_ff or S.ff_user or false
        PB.apply_speed()
        PB.build_bar()
    end
    if not want_ff and S.ff_to then
        S.ff_to = nil
        if S.paused then return false end
    end
    if S.step_to and S.i >= S.step_to then
        S.step_to, S.step_kind = nil, nil
        PB.build_bar()
        if S.paused then return false end
    end
    if e.k == "rn" then
        S.i = S.i + 1
        S.wait = gap_before(S.entries[S.i])
        return true
    end
    if e.k == "eo" then
        if not S.eo_done[S.i] and S.eval_wait then
            S.eo_done[S.i], S.eval_wait = true, nil
            eval_orders(e)
        end
        S.i = S.i + 1
        S.wait = gap_before(S.entries[S.i])
        return true
    end
    if e.k == "bs" and S.blind_started and idle() and G.STATE ~= G.STATES.BLIND_SELECT then
        S.blind_started = nil
        S.ante = tonumber(e.a) or S.ante
        S.watch = 0
        S.i = S.i + 1
        S.wait = gap_before(S.entries[S.i])
        return false
    end
    if not LIFE_SKIP[e.k] and idle() and lose_life_due() then
        S.driving = true
        local ok = pcall(G.FUNCS.bom_lose_life_button, lose_life_btn())
        S.driving = false
        if not ok then drift("lose_life") end
        S.watch = 0
        return false
    end
    if lives_early(e) and (S.lives_wait or 0) < PB.LIVES_HOLD_S then
        S.lives_wait = (S.lives_wait or 0) + dt
        return false
    end
    local synced = e.k == "in" and e.s ~= nil and in_sync(e)
    local counted = e.k == "in" and tonumber(e.g) ~= nil
    if e.k == "in" and e.s ~= nil and not synced and (counted or not starts_blind(e)) and hold_in(dt) then
        return false
    end
    if is_start_blind(e) and not start_ready() then
        S.watch = S.watch + dt
        if S.watch > PB.WATCHDOG_S then drift("stuck_in") end
        return false
    end
    if e.k == "in" and e.s ~= nil and (synced or counted or not starts_blind(e)) then
        S.in_hold = 0
        S.blind_started = nil
    elseif info_in(e) then
        S.blind_started = nil
    elseif (e.k ~= "in" or starts_blind(e)) and e.k ~= "start" and e.k ~= "end" then
        if not idle() then
            S.watch = S.watch + dt
            if S.watch > PB.WATCHDOG_S then drift("busy_" .. e.k) end
            return false
        end
        S.wait = (S.wait or 0) - dt
        if S.wait > 0 and not S.ff then return false end
        local ready = starts_blind(e) and READY.bs or READY[e.k]
        if ready and not ready(e) then
            S.watch = S.watch + dt
            if S.watch > PB.WATCHDOG_S then drift("stuck_" .. e.k) end
            return false
        end
    elseif e.k == "in" then
        if not idle() and (S.in_hold or 0) < PB.IN_HOLD_S then
            S.in_hold = (S.in_hold or 0) + dt
            return false
        end
        S.in_hold = 0
        S.blind_started = nil
    end
    local res = dispatch(e)
    if res then drift(res) return false end
    S.watch, S.lives_wait, S.state_hold, S.busy_hold = 0, 0, 0, 0
    if RP().ACTION_KINDS[e.k] then
        S.seen = { [G.STATE or -1] = true }
        S.eval_wait = e.k == "pl" or nil
    end
    S.i = S.i + 1
    S.wait = gap_before(S.entries[S.i])
    local nxt = S.entries[S.i]
    if nxt ~= nil and nxt.k == "in" and nxt.s ~= nil then return in_sync(nxt) end
    return info_in(nxt) or (nxt ~= nil and (nxt.k == "start" or nxt.k == "end"))
end

function PB.toggle_pause()
    if not S or S.done then return end
    S.paused = not S.paused
    if not S.paused then S.step_to, S.back_to = nil, nil end
    PB.build_bar()
end

local function action_after(from, kind)
    local A = RP().ACTION_KINDS
    for j = math.max(1, from), #S.entries do
        local e = S.entries[j]
        if type(e) == "table" and (kind and e.k == kind or not kind and A[e.k]) then return j end
    end
end

local function action_before(to)
    local A = RP().ACTION_KINDS
    for j = math.min(to - 1, #S.entries), 1, -1 do
        local e = S.entries[j]
        if type(e) == "table" and A[e.k] then return j end
    end
end

function PB.step_target(dir, kind)
    if not S or S.done or S.script or not S.entries then return nil end
    local back = S.back_to ~= nil and S.ff_to == S.back_to
    local base = back and S.back_to or S.step_to or S.i or 1
    if dir > 0 then
        local j = action_after(base, kind)
        return j and j + 1, back
    end
    return action_before(base), back
end

function PB.step_action(dir, kind)
    local to, back = PB.step_target(dir, kind)
    if not to then
        pcall(play_sound, "cancel")
        return false
    end
    S.paused = true
    if dir > 0 and back then
        S.ff_to, S.back_to = to, nil
    elseif dir > 0 then
        S.ff_to, S.back_to, S.step_to, S.step_kind = nil, nil, to, kind
    else
        if not (S.loading or S.launch_wait) then PB.restart(S.pid) end
        S.step_to, S.back_to, S.ff_to = nil, to, to
    end
    PB.build_bar()
    return true
end

function PB.cycle_speed()
    if not S then return end
    S.ff_user = false
    S.ff = S.ff_fwd or false
    S.speed_i = (S.speed_i % #PB.SPEEDS) + 1
    PB.apply_speed()
    PB.build_bar()
end

function PB.toggle_ff()
    if not S then return end
    S.ff_user = not S.ff_user
    S.ff = S.ff_user or S.ff_fwd or false
    PB.apply_speed()
    PB.build_bar()
end

function PB.jump(delta)
    if not S or S.script then return end
    local cur = S.ante or ante_now()
    local target = math.max(1, cur + delta)
    if target == cur and delta ~= 0 then return end
    if target > cur then
        local idx = RP().index_of_ante(S.entries, target)
        if idx then S.ff_to, S.step_to, S.back_to = idx, nil, nil end
        return
    end
    PB.restart(S.pid, target)
end

function PB.switch_player()
    if not S or S.script then return end
    local pids = {}
    if S.mode == "live" then
        for pid, st in pairs(S.live) do
            if start_entry(st.entries) then pids[#pids + 1] = pid end
        end
        table.sort(pids)
    else
        pids = RP().pids(S.streams)
    end
    if #pids < 2 then return end
    local nxt = pids[1]
    for i, p in ipairs(pids) do
        if p == S.pid then nxt = pids[i % #pids + 1] end
    end
    PB.restart(nxt, S.ante or ante_now())
end

function PB.can_switch()
    if not S or S.script then return false end
    if S.mode == "live" then
        local n = 0
        for _, st in pairs(S.live) do if start_entry(st.entries) then n = n + 1 end end
        return n > 1
    end
    return #RP().pids(S.streams) > 1
end

function PB.remove_bar()
    if G.PB_BAR then
        pcall(function() G.PB_BAR:remove() end)
        G.PB_BAR = nil
    end
end

local BTN_PAD = 0.04
PB.SIDE_MIN_W = 2.1
PB.SIDE_MAX_W = 3.0
PB.GAP_W = 2.7
PB.END_DELAY = 1.2
PB.END_MAX_WAIT = 6

local function port_now()
    return (UIK and UIK.portrait and UIK.portrait()) and true or false
end

local function touch_now()
    return (UIK and UIK.touch and UIK.touch()) and true or false
end

local function live_T(a)
    return type(a) == "table" and not a.REMOVED and a.T or nil
end

local function screen_rect()
    local s = (G.TILESIZE or 20) * (G.TILESCALE or 1)
    local R = G.ROOM_ORIG or (G.ROOM and G.ROOM.T) or { x = 0, y = 0 }
    local W, H = love.graphics.getDimensions()
    return -R.x, -R.y, W / s - R.x, H / s - R.y
end

function PB.slot()
    local c, d, j = live_T(G.consumeables), live_T(G.deck), live_T(G.jokers)
    if not (c and d) then return nil end
    local sx0, sy0, sx1, sy1 = screen_rect()
    if port_now() then
        local P = rawget(_G, "PORTRAIT")
        local top = j and (j.y + j.h + 0.1) or (c.y - 0.1)
        local bottom = (P and P.stage_top and P.stage_top() or (c.y + c.h + 0.45)) - 0.1
        local x0, x1 = c.x + c.w + 0.08, d.x - 0.08
        return { kind = "shelf", x = x0, y = top, w = x1 - x0, h = bottom - top }
    end
    local x0, x1 = math.max(c.x + c.w, d.x + d.w) + 0.1, sx1 - 0.15
    if x1 - x0 >= PB.SIDE_MIN_W then
        local top = math.max(sy0 + 0.15, j and j.y or c.y)
        local w = math.min(x1 - x0, PB.SIDE_MAX_W)
        return { kind = "side", x = x0 + (x1 - x0 - w) / 2, y = top, w = w, h = sy1 - 0.15 - top }
    end
    local w = math.min(PB.GAP_W, c.w)
    local top = c.y + c.h + 0.42
    return { kind = "gap", x = c.x + c.w - w, y = top, w = w, h = d.y - 0.1 - top }
end

local function slot_key(slot)
    if not slot then return "none" end
    local function r(v) return math.floor(v * 20 + 0.5) end
    return string.format("%s:%d:%d:%d:%d", slot.kind, r(slot.x), r(slot.y), r(slot.w), r(slot.h))
end

local function speedrun_view()
    local W, SRm = rawget(_G, "SpeedrunWatch"), rawget(_G, "Speedrun")
    if S and not S.script and W and W.cur and SRm and type(SRm.view) == "table" then return SRm.view end
end

local function sizes(slot)
    local touch, port = touch_now(), port_now()
    local kind = slot and slot.kind or (port and "shelf" or "gap")
    local w = slot and slot.w or (port and 3.2 or 2.6)
    local scale = touch and 0.38 or 0.34
    if not touch and kind == "side" then scale = 0.36 end
    local cpad = kind == "shelf" and 0.05 or 0.08
    return {
        kind = kind, port = kind == "shelf", touch = touch, w = w - 2 * cpad, cpad = cpad, pad = kind == "shelf" and 0.03 or BTN_PAD, avail = slot and slot.h or 5,
        scale = scale, line = scale * 1.1, h = touch and 1.0 or 0.6, hmin = touch and 0.62 or 0.46, side = kind == "gap" and 0.55 or 0.42,
    }
end
PB.sizes = function() return sizes(PB.slot()) end

local function btn(label, func, colour, w, z, disabled)
    return { n = G.UIT.C, config = { align = "cm", padding = z.pad or BTN_PAD }, nodes = {
        UIK.button{ label = label, button = func, colour = colour, w = w, h = z.h, scale = z.scale, disabled = disabled, id = func },
    } }
end

local function text_row(z, node, minh)
    return { n = G.UIT.R, config = { align = "cm", minw = z.w, maxw = z.w, minh = minh or z.line }, nodes = { node } }
end

local function text_w(t, scale)
    local f = G.LANG and G.LANG.font
    if not (f and f.FONT and G.TILESIZE) then return #t * 0.12 * scale end
    return f.FONT:getWidth(t) * (f.squish or 1) * scale * (f.FONTSCALE or 0.1) / G.TILESIZE
end

local function wrap(text, scale, maxw)
    local lines, cur = {}, ""
    for word in tostring(text):gmatch("%S+") do
        local try = cur == "" and word or (cur .. " " .. word)
        if cur ~= "" and text_w(try, scale) > maxw then
            lines[#lines + 1] = cur
            cur = word
        else
            cur = try
        end
    end
    if cur ~= "" then lines[#lines + 1] = cur end
    return lines
end
PB.wrap = wrap

local function natural(z, list)
    local ws, sum = {}, 0
    for i, b in ipairs(list) do
        ws[i] = math.max(z.side, text_w(b[1], z.scale) + 0.18)
        sum = sum + ws[i]
    end
    return ws, sum, z.w - #list * 2 * (z.pad or BTN_PAD)
end

local function split_rows(z, rows)
    if z.kind == "shelf" then return rows end
    local out = {}
    for _, list in ipairs(rows) do
        local _, sum, avail = natural(z, list)
        if #list > 1 and sum > avail * (z.kind == "side" and 1.0 or 1.1) then
            for _, b in ipairs(list) do out[#out + 1] = { b } end
        else
            out[#out + 1] = list
        end
    end
    return out
end

local function button_row(z, list)
    local n = #list
    local ws, sum, avail = natural(z, list)
    local k = sum > avail and avail / sum or 1
    local extra = k < 1 and 0 or (avail - sum) / n
    local zz = k < 1 and setmetatable({ scale = z.scale * math.max(k, 0.8) }, { __index = z }) or z
    local nodes = {}
    for i, b in ipairs(list) do nodes[i] = btn(b[1], b[2], b[3], ws[i] * k + extra, zz, b[4]) end
    return { n = G.UIT.R, config = { align = "cm" }, nodes = nodes }
end

local function fit_line(t, scale, maxw)
    t = tostring(t or "")
    if text_w(t, scale) <= maxw then return t end
    while #t > 0 and text_w(t .. "...", scale) > maxw do
        t = t:gsub("[%z\1-\127\194-\244][\128-\191]*$", "")
    end
    return t .. "..."
end
PB.fit_line = fit_line

local function T(text, scale, colour, extra)
    local cfg = { text = text, scale = scale, colour = colour, shadow = true }
    for k, v in pairs(extra or {}) do cfg[k] = v end
    return { n = G.UIT.T, config = cfg }
end

local function timer_rows(z, v)
    local en = G.LANGUAGES and G.LANGUAGES["en-us"]
    local big = z.scale * 1.55
    local time = { n = G.UIT.T, config = { ref_table = v, ref_value = "time", scale = big, colour = v.col, shadow = true, lang = en } }
    local line = { n = G.UIT.T, config = { ref_table = v, ref_value = "line", scale = z.scale, colour = v.line_col, shadow = true } }
    local inner = {
        { n = G.UIT.R, config = { align = "cm", minh = big * 1.05 }, nodes = { time } },
        { n = G.UIT.R, config = { align = "cm", minh = z.line, maxw = z.w - 0.2 }, nodes = { line } },
    }
    local h = big * 1.05 + z.line + 0.1
    return { n = G.UIT.R, config = { align = "cm", padding = 0.04 }, nodes = {
        { n = G.UIT.C, config = { id = "sr_hud_box", align = "cm", padding = 0.03, minw = z.w, colour = G.C.DYN_UI.BOSS_DARK, r = 0.1 }, nodes = inner },
    } }, h + 0.08
end

function PB.bar_buttons(z)
    local blue, red, gold = G.C.BLUE, G.C.RED, G.C.GOLD
    if S and S.done then
        if S.mode == "live" or S.script then return { { { L("Leave"), "pb_leave", red } } } end
        local again, leave = { S.drifted and L("Restart") or L("Watch again"), "pb_again", blue }, { L("Leave"), "pb_leave", red }
        if z.port then return { { again, leave } } end
        return { { again }, { leave } }
    end
    if not S or S.script then return { { { L("Leave"), "pb_leave", red } } } end
    local pause = { S.paused and L("Play") or L("Pause"), "pb_pause", blue }
    local prev, nxt = { "<", "pb_prev_action", blue }, { ">", "pb_next_action", blue }
    local speed, ff = { "x" .. tostring(PB.SPEEDS[S.speed_i] or 1), "pb_speed", blue }, { ">>", "pb_ff", S.ff_user and gold or blue }
    local leave = { L("Leave"), "pb_leave", red }
    local switch = PB.can_switch() and { L("Switch"), "pb_switch", G.C.ORANGE } or nil
    local extras = PB.bar_extras and PB.bar_extras(S) or {}
    if z.port then
        local r2 = {}
        for _, b in ipairs(extras) do r2[#r2 + 1] = b end
        local rows = { { prev, pause, nxt, speed, ff }, r2 }
        if switch or #extras > 1 then
            rows[3] = switch and { switch, leave } or { leave }
        else
            r2[#r2 + 1] = leave
        end
        return rows
    end
    local rows = { { prev, pause, nxt } }
    if #extras > 0 then rows[#rows + 1] = extras end
    if z.kind == "side" then
        rows[#rows + 1] = { speed, ff }
        rows[#rows + 1] = switch and { switch, leave } or { leave }
    else
        rows[#rows + 1] = { speed, ff, leave }
        if switch then rows[#rows + 1] = { switch } end
    end
    return rows
end

function PB.bar_definition(slot)
    local z = sizes(slot)
    local rows, used = {}, 0.16
    local function add(r, h) rows[#rows + 1] = r used = used + h end
    local title, ver, name = title_text(), PB.version_note(), name_text()
    local status = { n = G.UIT.T, config = { ref_table = S and S.ui or { text = "" }, ref_value = "text", scale = z.scale, colour = S and S.drifted and G.C.RED or G.C.UI.TEXT_LIGHT, shadow = true } }
    local note = S and S.drifted and S.note and PB.NOTES[S.note]
    local view = speedrun_view()
    local btn_rows = split_rows(z, PB.bar_buttons(z))
    if z.kind ~= "side" then
        local head = title .. "  "
        local room = z.w - 0.12 - text_w(head, z.scale)
        add(text_row(z, { n = G.UIT.C, config = { align = "cm" }, nodes = { T(head, z.scale, G.C.GOLD), T(fit_line(name, z.scale, room), z.scale, G.C.UI.TEXT_LIGHT) } }), z.line)
        if ver and text_w(ver, z.scale) <= z.w - 0.12 and z.avail - used - 2 * z.line > #btn_rows * (z.hmin + 2 * z.pad) + (view and 1.2 or 0) then
            add(text_row(z, T(ver, z.scale, G.C.ORANGE)), z.line)
        end
    else
        add(text_row(z, T(title, z.scale, G.C.GOLD)), z.line)
        if ver then add(text_row(z, T(fit_line(ver, z.scale, z.w - 0.12), z.scale, G.C.ORANGE)), z.line) end
        add(text_row(z, T(fit_line(name, z.scale, z.w - 0.12), z.scale, G.C.UI.TEXT_LIGHT)), z.line)
    end
    if note then
        for _, part in ipairs(note) do
            for _, line in ipairs(wrap(L(part), z.scale, z.w - 0.12)) do add(text_row(z, T(line, z.scale, G.C.RED)), z.line) end
        end
    elseif not (z.kind ~= "side" and view and S and not S.done) then
        add(text_row(z, status), z.line)
    end
    if view then
        local r, h = timer_rows(z, view)
        add(r, h)
    end
    used = used - 0.16 + 2 * z.cpad
    local per = (z.avail - used) / #btn_rows - 2 * z.pad - 0.01
    z.h = math.max(z.hmin, math.min(z.h, per))
    for _, list in ipairs(btn_rows) do rows[#rows + 1] = button_row(z, list) end
    return { n = G.UIT.ROOT, config = { align = "cm", colour = G.C.CLEAR, padding = 0 }, nodes = {
        { n = G.UIT.R, config = { align = "cm", colour = { 0, 0, 0, 0.72 }, r = 0.12, padding = z.cpad, emboss = 0.04 }, nodes = {
            { n = G.UIT.C, config = { align = "cm" }, nodes = rows },
        } },
    } }
end

local function viewing()
    return S ~= nil and not S.driving and not S.waiting_start
end

function PB.guard_input()
    if Controller and Controller.L_cursor_press and not PB._press_wrapped then
        PB._press_wrapped = true
        local press = Controller.L_cursor_press
        Controller.L_cursor_press = function(self, ...)
            local res = press(self, ...)
            local t = self.cursor_down and self.cursor_down.target
            if viewing() and t and t ~= G.ROOM and Card and type(t.is) == "function" and t:is(Card) then self.cursor_down.target = G.ROOM end
            return res
        end
    end
    if Controller and Controller.queue_R_cursor_press and not PB._rclick_wrapped then
        PB._rclick_wrapped = true
        local rclick = Controller.queue_R_cursor_press
        Controller.queue_R_cursor_press = function(self, ...)
            if viewing() then return end
            return rclick(self, ...)
        end
    end
    local DS = rawget(_G, "DRAG_SELECT")
    if type(DS) == "table" and type(DS.update) == "function" and not PB._ds_wrapped then
        PB._ds_wrapped = true
        local up = DS.update
        DS.update = function(...)
            if viewing() then
                if (DS.pending or DS.active) and DS.reset then pcall(DS.reset) end
                return
            end
            return up(...)
        end
    end
end

local function place_bar(box, slot)
    local ra = live_T(G.ROOM_ATTACH)
    if not (slot and ra and box.T) then return false end
    local x = slot.x + math.max(0, (slot.w - box.T.w) / 2)
    local y = slot.y
    if slot.kind == "shelf" then y = slot.y + math.max(0, (slot.h - box.T.h) / 2) end
    return pcall(function() box:set_alignment({ type = "tli", offset = { x = x - ra.x, y = y - ra.y } }) end)
end

function PB.build_bar()
    if not S or S.loading then return end
    PB.remove_bar()
    if G.MOD_FLOATING_BUTTON and type(rawget(_G, "remove_floating_mod_button")) == "function" then pcall(remove_floating_mod_button) end
    local slot = PB.slot()
    local ok, box = pcall(function()
        if slot then
            return UIBox{ definition = PB.bar_definition(slot), config = { align = "tli", offset = { x = 0, y = 0 }, major = G.ROOM_ATTACH, bond = "Weak" } }
        end
        local major = G.consumeables or G.ROOM_ATTACH
        local below = G.consumeables and G.consumeables.T and (G.consumeables.T.h + 0.45) or 0.7
        return UIBox{ definition = PB.bar_definition(nil), config = { align = "tri", offset = { x = 0, y = below }, major = major, bond = "Weak" } }
    end)
    if not (ok and box) then return end
    G.PB_BAR = box
    box.pb_key, box.pb_port = slot_key(slot), port_now()
    box.pb_timer = speedrun_view() ~= nil
    box.pb_placed = slot ~= nil and place_bar(box, slot)
end

function PB.bar_stale()
    local b = G.PB_BAR
    if not b then return false end
    if b.REMOVED then return true end
    if b.pb_port ~= port_now() or b.pb_timer ~= (speedrun_view() ~= nil) then return true end
    return b.pb_key ~= slot_key(PB.slot())
end

local function ending_text()
    if not S then return "" end
    if S.drifted then return string.format(L("Stopped at Ante %d"), tonumber(S.drifted) or ante_now()) end
    local g = G.GAME or {}
    if g.won then return L("Run won") end
    if G.STATE == G.STATES.GAME_OVER then return string.format(L("Game over at Ante %d"), ante_now()) end
    return string.format(L("Ended at Ante %d, round %d"), ante_now(), tonumber(g.round) or 1)
end

function PB.end_info()
    if not S then return nil end
    local info = { name = name_text(), result = ending_text(), good = false, bad = S.drifted ~= nil or G.STATE == G.STATES.GAME_OVER }
    info.good = not info.bad and G.GAME and G.GAME.won and true or false
    local SRm, W = rawget(_G, "Speedrun"), rawget(_G, "SpeedrunWatch")
    local fmt = SRm and SRm.fmt or function(t) return string.format("%.1f", t) end
    local w = W and W.cur
    if w and w.c and not S.drifted then
        local cat = SRm.cat and SRm.cat(w.c.cat)
        if w.c.done then
            info.result = string.format(L("Goal reached: %s"), cat and L(cat.label) or "")
            info.good, info.bad = true, false
        end
        info.time_label = L("Final time")
        info.time = fmt(w.c.done and (w.final or w.c.t) or w.c.t)
        return info
    end
    if not (type(S.header) == "table" and S.header.kind == "local") then return info end
    local last = 0
    for i = #(S.entries or {}), math.max(1, #(S.entries or {}) - 40), -1 do
        local t = type(S.entries[i]) == "table" and tonumber(S.entries[i].t)
        if t and t > last then last = t end
    end
    if last > 0 then
        info.time_label = L("Run time")
        info.time = fmt(last / 1000)
    end
    return info
end

function PB.end_definition()
    local info = PB.end_info() or {}
    local touch, port = touch_now(), port_now()
    local s = touch and 1.12 or 1
    local wide = port and 5.4 or 7
    local title = S and S.drifted and L("Replay stopped") or L("Replay finished")
    local rows = {
        { n = G.UIT.R, config = { align = "cm", padding = 0.06 }, nodes = { T(title, math.min(0.9 * s, (wide * s - 0.3) / math.max(text_w(title, 1), 0.1)), S and S.drifted and G.C.RED or G.C.GOLD, { id = "pb_end_title" }) } },
    }
    if info.name and info.name ~= "" then
        rows[#rows + 1] = { n = G.UIT.R, config = { align = "cm", padding = 0.03 }, nodes = { T(fit_line(info.name, 0.5 * s, wide), 0.5 * s, G.C.UI.TEXT_LIGHT) } }
    end
    rows[#rows + 1] = { n = G.UIT.R, config = { align = "cm", padding = 0.05 }, nodes = { T(info.result or "", math.min(0.55 * s, (wide * s - 0.3) / math.max(text_w(info.result or "", 1), 0.1)), info.good and G.C.GREEN or info.bad and G.C.RED or G.C.UI.TEXT_LIGHT) } }
    if info.time then
        rows[#rows + 1] = { n = G.UIT.R, config = { align = "cm", padding = 0.1, r = 0.1, colour = G.C.DYN_UI.BOSS_DARK, minw = (wide - 2.4) * s }, nodes = {
            { n = G.UIT.C, config = { align = "cm" }, nodes = {
                { n = G.UIT.R, config = { align = "cm" }, nodes = { T(info.time_label or "", 0.45 * s, G.C.UI.TEXT_LIGHT) } },
                { n = G.UIT.R, config = { align = "cm" }, nodes = { T(info.time, 1.0 * s, info.good and G.C.GREEN or G.C.GOLD, { lang = G.LANGUAGES and G.LANGUAGES["en-us"] }) } },
            } },
        } }
    end
    local note = S and S.drifted and S.note and PB.NOTES[S.note]
    for _, part in ipairs(note or {}) do
        rows[#rows + 1] = { n = G.UIT.R, config = { align = "cm" }, nodes = { T(L(part), 0.42 * s, G.C.RED) } }
    end
    local bw, bh = (port and 2.6 or 3.2) * s, touch and 1.0 or 0.8
    rows[#rows + 1] = { n = G.UIT.R, config = { align = "cm", padding = 0.12 }, nodes = {
        { n = G.UIT.C, config = { align = "cm", padding = 0.06 }, nodes = { UIK.button{ label = S and S.drifted and L("Restart") or L("Watch again"), button = "pb_again", colour = G.C.BLUE, w = bw, h = bh, scale = 0.5 * s, id = "pb_again" } } },
        { n = G.UIT.C, config = { align = "cm", padding = 0.06 }, nodes = { UIK.button{ label = L("Leave"), button = "pb_leave", colour = G.C.RED, w = bw, h = bh, scale = 0.5 * s, id = "pb_end_leave" } } },
    } }
    return create_UIBox_generic_options({ no_back = true, contents = { { n = G.UIT.R, config = { align = "cm", padding = 0.15, minw = wide * s }, nodes = { { n = G.UIT.C, config = { align = "cm" }, nodes = rows } } } } })
end

function PB.show_end()
    if not S or S.end_menu then return end
    local ok, def = pcall(PB.end_definition)
    if not ok then return end
    G.FUNCS.overlay_menu({ definition = def, config = { no_esc = false } })
    S.end_menu, S.end_port = G.OVERLAY_MENU, port_now()
    G.PB_END = G.OVERLAY_MENU
end

function PB.end_tick()
    if S and S.end_menu and G.OVERLAY_MENU == S.end_menu and S.end_port ~= port_now() then
        pcall(G.FUNCS.exit_overlay_menu)
        S.end_menu = nil
        PB.show_end()
        return
    end
    if not S or not S.done or S.mode == "live" or S.script or S.end_menu or S.end_closed then return end
    local dt = love.timer.getDelta()
    S.end_wait = (S.end_wait or 0) + dt
    if G.screenwipe or (G.OVERLAY_MENU and G.OVERLAY_MENU ~= S.end_menu) then return end
    if idle() then S.end_t = (S.end_t or 0) + dt end
    if (S.end_t or 0) >= PB.END_DELAY or S.end_wait >= PB.END_MAX_WAIT then PB.show_end() end
end

function PB.again()
    if not S then return end
    local menu = S.end_menu
    S.end_menu, S.end_t, S.end_wait, S.end_closed = nil, nil, nil, nil
    G.PB_END = nil
    if menu and G.OVERLAY_MENU == menu then pcall(G.FUNCS.exit_overlay_menu) end
    PB.restart(S.pid, 1)
end

PB.is_replay_running = PB.active

function PB.init()
    pcall(PB.guard_input)
    pcall(PB.hook_swap)
    G.FUNCS.pb_pause = function() PB.toggle_pause() end
    G.FUNCS.pb_speed = function() PB.cycle_speed() end
    G.FUNCS.pb_ff = function() PB.toggle_ff() end
    G.FUNCS.pb_prev_ante = function() PB.jump(-1) end
    G.FUNCS.pb_next_ante = function() PB.jump(1) end
    G.FUNCS.pb_prev_action = function() PB.step_action(-1) end
    G.FUNCS.pb_next_action = function() PB.step_action(1) end
    G.FUNCS.pb_switch = function() PB.switch_player() end
    G.FUNCS.pb_leave = function()
        if S and S.end_menu and G.OVERLAY_MENU == S.end_menu then pcall(G.FUNCS.exit_overlay_menu) end
        PB.leave()
    end
    G.FUNCS.pb_restart = function() PB.again() end
    G.FUNCS.pb_again = function() PB.again() end
    if Card and Card.click and not PB._click_wrapped then
        PB._click_wrapped = true
        local click = Card.click
        Card.click = function(self, ...)
            if S and not S.driving and not S.waiting_start then return end
            return click(self, ...)
        end
        local can_drag = Card.can_drag or Node.can_drag
        Card.can_drag = function(self, ...)
            if S and not S.driving and not S.waiting_start then return nil end
            return can_drag(self, ...)
        end
    end
    if UIElement and UIElement.click and not PB._ui_wrapped then
        PB._ui_wrapped = true
        local uiclick = UIElement.click
        UIElement.click = function(self, ...)
            if self.config and PB.blocks_button(self.config.button) then return end
            if not S or S.driving then return uiclick(self, ...) end
            local before = G.OVERLAY_MENU
            uiclick(self, ...)
            if S and G.OVERLAY_MENU and G.OVERLAY_MENU ~= before then S.viewer_menu = G.OVERLAY_MENU end
        end
    end
    for _, name in ipairs({ "run_info", "deck_info" }) do
        local f = G.FUNCS[name]
        if type(f) == "function" and not PB["_" .. name .. "_wrapped"] then
            PB["_" .. name .. "_wrapped"] = true
            G.FUNCS[name] = function(...)
                f(...)
                if S and not S.driving and G.OVERLAY_MENU then S.viewer_menu = G.OVERLAY_MENU end
            end
        end
    end
    if Controller and Controller.get_cursor_collision and not PB._collide_wrapped then
        PB._collide_wrapped = true
        local collide = Controller.get_cursor_collision
        Controller.get_cursor_collision = function(self, ...)
            local r = collide(self, ...)
            local bar, list = G.PB_BAR, self.collision_list
            if bar and list and list[2] and list[1].UIBox ~= bar then
                local front, rest = {}, {}
                for _, v in ipairs(list) do
                    if v.UIBox == bar then front[#front + 1] = v else rest[#rest + 1] = v end
                end
                if front[1] then
                    for i, v in ipairs(front) do list[i] = v end
                    for i, v in ipairs(rest) do list[#front + i] = v end
                end
            end
            return r
        end
    end
    if G.FUNCS.options and not PB._options_wrapped then
        PB._options_wrapped = true
        local options = G.FUNCS.options
        G.FUNCS.options = function(...)
            if S and not S.driving then return end
            return options(...)
        end
    end
    if G.FUNCS.go_to_menu and not PB._menu_wrapped then
        PB._menu_wrapped = true
        local go = G.FUNCS.go_to_menu
        G.FUNCS.go_to_menu = function(...)
            if S then PB.stop(false) end
            return go(...)
        end
    end
    if G.FUNCS.start_run and not PB._start_wrapped then
        PB._start_wrapped = true
        local start_run = G.FUNCS.start_run
        G.FUNCS.start_run = function(...)
            if S and S.waiting_start then PB.stop(false) end
            return start_run(...)
        end
    end
    if bom_core and bom_core.send and not PB._send_wrapped then
        PB._send_wrapped = true
        local send = bom_core.send
        bom_core.send = function(data, opts)
            if S and not S.waiting_start and type(data) == "table" and not OUT_ALLOW[data.type] and not allowed(data.type) then return true end
            return send(data, opts)
        end
    end
end

