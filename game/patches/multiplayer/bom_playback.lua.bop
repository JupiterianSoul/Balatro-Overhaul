l 459
    end
    if e.tj and not highlight(G.jokers, e.tj) then return "targets" end
    local card = card_at(code, e.i)
    if not card then return "use" end
    G.FUNCS.use_card({ config = { ref_table = card } })
end

DO.us = function(e) return use(e, "c") end
DO.pk = function(e) return use(e, "p") end
DO.sp = function(e)
    local bad = orders(e)
    if bad then return bad end
