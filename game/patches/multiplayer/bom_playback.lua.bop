    if bad then return bad end
    local targets = type(e.ht) == "table" and e.ht or (type(e.t) == "table" and e.t or nil)
    if targets or e.o then
        if not ensure_order(G.hand, e.o) then return "hand" end
        if not highlight(G.hand, targets) then return "targets" end
        if not screen_order(G.hand, e.x) then return "targets" end
    elseif G.hand and G.hand.unhighlight_all then
