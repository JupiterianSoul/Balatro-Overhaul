                if not ok then dbg("finish_restore failed: " .. tostring(err)) end
                return true
            end,
        }))
    end
end

R.restore_run = restore_run

function R.on_rejoin_ok(d)
    if type(d) ~= "table" then return end
    R.checking = false
    R.end_rejoin_wait()
    R.prompt = nil
    R.store_session(d.code, d.token, d.playerId, true, d.id)
    R.seq = math.max(R.seq, tonumber(d.snapshot and d.snapshot.seq) or 0)
    local st = bom_match.get_state()
    local live = G.STAGE == G.STAGES.RUN and G.GAME and G.GAME.multiplayer
        and in_live_match() and st.room_code == d.code
    if live then
        resync_live(d)
    else
        restore_run(d)
    end
    pcall(function() bom_match.set_final_state(d.finalAnte, d.suddenDeath) end)
end

function R.on_match_session(d)
    if type(d) ~= "table" then return end
    local id = d.id
    if type(id) ~= "string" and bom_room and bom_room.seat and bom_room.seat.code == d.code then id = bom_room.seat.id end
    R.store_session(d.code, d.token, d.playerId, true, id)
    R.seq = 0
    R.last_table = nil
    R.holdSeconds = tonumber(d.holdSeconds) or R.holdSeconds
    local t = G and G.culled_table
    local tg, g = type(t) == "table" and t.GAME, G and G.GAME
    if type(tg) == "table" and g and g.multiplayer and tg.round == g.round
        and tg.round_resets and g.round_resets and tg.round_resets.ante == g.round_resets.ante
        and tg.pseudorandom and g.pseudorandom and tg.pseudorandom.seed == g.pseudorandom.seed then
        pcall(R.on_save)
    end
end

function R.on_room_seat(d)
    if type(d) ~= "table" or type(d.token) ~= "string" then return end
    R.store_session(d.code, d.token, d.playerId, false)
end

function R.on_opponent_disconnected(d)
    if not in_live_match() then return end
    dbg("opponent away reason=" .. tostring(d.reason) .. " secondsLeft=" .. tostring(d.secondsLeft))
    R.set_opp_away(d.secondsLeft, d.reason, true)
end

function R.on_opponent_reconnected(d)
    dbg("opponent reconnected")
    R.clear_opp_away(true)
end

function R.on_state_update(d)
    if type(d) ~= "table" or not in_live_match() then return end
    if d.oppConnected == false and d.oppSecondsLeft ~= nil then
        if not R.opp_away then
            R.set_opp_away(d.oppSecondsLeft, nil, true)
        else
            R.opp_away.deadline = now() + (tonumber(d.oppSecondsLeft) or 0)
        end
    elseif d.oppConnected == true and R.opp_away then
        R.clear_opp_away(true)
    end
end

function R.on_match_ended(d)
    if type(d) ~= "table" then return end
    dbg("match_ended result=" .. tostring(d.result) .. " reason=" .. tostring(d.reason))
    R.clear_session()
    R.stop_reconnect()
    R.hide_box("away")
    R.opp_away = nil
    if bom_match.is_match_over() then return end
    if not bom_match.is_active() then
        R.add_ended_game(d)
        return
    end
    bom_match.end_match(d.result or "draw", d.reason, { from_server = true })
end

function R.on_room_closed(d)
    dbg("room_closed reason=" .. tostring(d and d.reason) .. " post=" .. tostring(d and d.post_match))
    R.clear_session()
    R.stop_reconnect()
    if R.exit_pending or R.exiting or R.restoring then return end
    local phase = bom_match.get_phase()
    local P = bom_match.PHASE
    local opp_name = bom_match.get_state().opp_name
    if phase == P.LOBBY or phase == P.STARTING then
        R.exit_to_menu({ reason = d and d.reason, title = mod_loc("Room closed"), context = "lobby" })
    elseif phase == P.MATCH_END or bom_match.is_match_over() then
        if G.STAGE ~= G.STAGES.RUN or G.screenwipe then
            pcall(bom_match.restore_fairness)
            pcall(bom_match.reset)
            return
        end
        if not (d and d.party) and bom_ui and bom_ui.results_room_closed then
            pcall(bom_ui.results_room_closed, d and d.reason)
            return
        end
        R.exit_to_menu({ reason = d and d.reason, title = mod_loc("Room closed"), context = "post", opp_name = opp_name })
    elseif bom_match.is_in_match() then
        R.exit_to_menu({ reason = d and d.reason, title = mod_loc("Room closed"), opp_name = opp_name })
    end
end

function R.on_session_replaced()
    dbg("session_replaced")
    R.session = nil
    R.stop_reconnect()
    if bom_match.is_active() then
        R.exit_to_menu({ reason = "session_replaced", title = mod_loc("Connection lost") })
    end
end

function R.on_match_end_local(result, reason)
    R.clear_session()
    R.stop_reconnect()
    R.hide_box("away")
    R.opp_away = nil
    if R.is_closing_reason(reason) then
        local info = { result = result, reason = reason }
        pcall(function() info.opp_name = bom_match.get_state().opp_name end)
        R.exit_to_menu(info)
        return true
    end
    return false
end

function R.on_quit_to_menu()
    if not in_live_match() or not R.has_match_session() then
        if bom_match and bom_match.is_match_over and bom_match.is_match_over() then R.clear_session() end
        return false
    end
    dbg("player went to the menu mid-match, match is held")
    R.upload_pending(true)
    if not R.rc.active then bom_core.send({ type = "return_to_menu" }) end
    R.stop_reconnect()
    R.outbox = {}
    R.opp_away = nil
    R.hide_all_boxes()
    pcall(function() if bom_ui and bom_ui.hide_pvp_waiting then bom_ui.hide_pvp_waiting() end end)
    pcall(function() if bom_ui then bom_ui.destroy_match_hud() end end)
    if G.GAME then G.GAME.multiplayer = nil end
    pcall(bom_core.disconnect)
    pcall(bom_match.restore_fairness)
    pcall(bom_match.reset)
    return true
end

function R.on_shutdown()
    pcall(function()
        if R.pending_table then R.upload_pending(true) end
    end)
end

local function pvp_watchdog(t)
    local hud = bom_pvp_hud
    if not hud or not in_live_match() or R.rc.active or not bom_core.is_connected() then
        R.pvp_resend_at, R.end_pvp_at = nil, nil
        return
    end
    if bom_match.is_end_pvp() then
        R.end_pvp_at = R.end_pvp_at or t + 3
        if t >= R.end_pvp_at and G.GAME and (G.GAME.STOP_USE or 0) > 0 then
            dbg("PvP result was waiting on STOP_USE, cleared")
            G.GAME.STOP_USE = 0
        end
    else
        R.end_pvp_at = nil
    end
    local finished = hud._pvp_finished_token and hud._pvp_finished_token == hud.blind_token()
        and not bom_match.is_end_pvp() and bom_nemesis and bom_nemesis.in_unresolved_pvp_blind()
    if not finished then
        R.pvp_resend_at = nil
        return
    end
    R.pvp_resend_at = R.pvp_resend_at or t + 4
    if t < R.pvp_resend_at then return end
    R.pvp_resend_at = t + 4
    local st = bom_match.get_state()
    bom_core.send({ type = "blind_finished", ante = st.current_ante, blind = st.current_blind, score = G.GAME.chips or 0 })
end

function R.update(dt)
    local t = now()
    pcall(pvp_watchdog, t)
    if R.exit_pending then
        local ok, err = pcall(R.do_exit)
        if not ok then dbg("do_exit failed: " .. tostring(err)) R.exiting = false end
    end

    if R.rc.active then
        if not R.rc.in_flight and t >= R.rc.next_at then
            try_reconnect()
        elseif R.rc.in_flight and R.rc.sent_at and t - R.rc.sent_at > REJOIN_REPLY_TIMEOUT then
            dbg("no reply to rejoin_match, retrying")
            pcall(bom_core.disconnect)
            schedule_retry()
        elseif R.rc.in_flight and not R.rc.sent_at and t - (R.rc.started_at or t) > ATTEMPT_TIMEOUT then
            dbg("reconnect attempt " .. R.rc.attempts .. " never connected, retrying")
            pcall(bom_core.disconnect)
            schedule_retry()
        end
    elseif not (R.exit_pending or R.exiting or R.restoring) and R.has_match_session() and in_live_match()
        and G.STAGE == G.STAGES.RUN and not bom_core.is_connected() then
        R.offline_since = R.offline_since or t
        if t - R.offline_since > OFFLINE_GRACE then
            R.offline_since = nil
            dbg("in a live match without a connection, reconnecting")
            pcall(bom_core.disconnect)
            R.begin_reconnect()
        end
    else
        R.offline_since = nil
    end

    if R.opp_away then
        local left = math.max(0, R.opp_away.deadline - t)
        R.ui.away_time = mod_loc("Time left") .. ": " .. fmt_time(left)
        pcall(function()
            if R.opp_away.dismissed and G.GAME and G.GAME.mp_blind_ready and not R.opp_away.ready_shown then
                R.opp_away.ready_shown = true
                R.opp_away.dismissed = false
                R.show_away_popup()
            elseif G.GAME and not G.GAME.mp_blind_ready then
                R.opp_away.ready_shown = false
            end
        end)
    end

    if R.prompt then
        R.ui.prompt_time = mod_loc("Time left") .. ": " .. fmt_time(R.prompt.deadline - t)
        if not R.is_overlay_shown("prompt") then R.prompt = nil end
    end

    for id, b in pairs(R.boxes) do
        if b.until_t and t >= b.until_t then R.hide_box(id) end
    end

    if R.pack.job then R.poll_pack() end
    if R.pending_table then R.upload_pending(false) end

    if R.menu_check_at and t >= R.menu_check_at then
        R.menu_check_at = nil
        if G.STAGE == G.STAGES.MAIN_MENU and (not G.OVERLAY_MENU or (R.menu_check_tries or 0) >= 4) then
            R.menu_check_tries = 0
            R.check_rejoin()
        elseif G.STAGE == G.STAGES.MAIN_MENU then
            R.menu_check_tries = (R.menu_check_tries or 0) + 1
            R.menu_check_at = t + 1
        elseif R.has_match_session() and bom_match.get_phase() == bom_match.PHASE.NONE then
            R.menu_check_at = t + 1
        end
    end

    if R.rejoin_wait then
        if t >= R.rejoin_wait.until_t then
            dbg("no reply to rejoin_match from the menu")
            R.end_rejoin_wait()
            pcall(bom_core.disconnect)
            R.show_menu_popup_now({ reason = "no_reply", title = mod_loc("Could not rejoin") })
        end
    end

    if R.menu_popup_at and t >= R.menu_popup_at then
        R.menu_popup_at = nil
        local rk = bom_ranked
        if rk and rk.results_pending and rk.results_pending() and rk.maybe_show_results then pcall(rk.maybe_show_results) end
        if rk and rk.S and rk.S.showing then
            R.menu_popup = nil
        else
            R.show_menu_popup()
        end
    end
end

function R.init()
    if mod_loc_register then
        mod_loc_register({ fr = { ["The other players are still playing."] = "Les autres joueurs jouent encore.",
                ["Your seat is held while the others keep playing."] = "Votre place est gardée pendant que les autres continuent.",
                ["Could not rejoin"] = "Impossible de revenir",
                ["The server did not answer. Open Multiplayer to try again."] = "Le serveur n'a pas répondu. Ouvrez Multijoueur pour réessayer.",
                ["Leave the room you are in first, then try again."] = "Quittez d'abord le salon où vous êtes, puis réessayez." },
            es = { ["The other players are still playing."] = "Los otros jugadores siguen jugando.",
                ["Your seat is held while the others keep playing."] = "Tu plaza se guarda mientras los demás siguen jugando.",
                ["Could not rejoin"] = "No se pudo volver",
                ["The server did not answer. Open Multiplayer to try again."] = "El servidor no respondió. Abre Multijugador para intentarlo de nuevo.",
                ["Leave the room you are in first, then try again."] = "Sal primero de la sala en la que estás y vuelve a intentarlo." } })
    end
    R.load_session()
    if R.session and not R.session.in_match then R.clear_session() end

    if save_run and not R._save_hooked then
        R._save_hooked = true
        local save_run_ref = save_run
        save_run = function(...)
            local r = save_run_ref(...)
            pcall(R.on_save)
            return r
        end
    end

    if Game and Game.main_menu and not R._menu_hooked then
        R._menu_hooked = true
        local main_menu_ref = Game.main_menu
        Game.main_menu = function(self, ...)
            local r = main_menu_ref(self, ...)
            R.exiting = false
            R.restoring = false
            if R.menu_popup then
                R.menu_popup_at = now() + 0.8
            elseif R.after_menu then
                local fn = R.after_menu
                R.after_menu = nil
                G.E_MANAGER:add_event(Event({ trigger = "after", delay = 0.6, blocking = false, blockable = false,
                    func = function() pcall(fn) return true end }))
            end
            if R.has_match_session() then R.menu_check_at = now() + 1.5 end
            return r
        end
    end
    dbg("rejoin module ready, stored session=" .. tostring(R.session and R.session.code))
end

return R
end
