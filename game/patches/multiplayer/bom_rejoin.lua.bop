function R.finish_restore(d, from_save)
    if not G or not G.GAME then return end
    dbg("finish_restore from_save=" .. tostring(from_save) .. " state=" .. tostring(G.STATE))
    bom_match.apply_restored_game(d)
    sync_ready(d, false)
    apply_opp_location(d)
    if from_save then pcall(fix_pvp_state, d) end
    pcall(function() if bom_pvp_hud and bom_pvp_hud.patch_run_hud_for_mp then bom_pvp_hud.patch_run_hud_for_mp() end end)
    sync_opp_presence(d)
    if from_save and G.STATE ~= G.STATES.SHOP and G.STATE ~= G.STATES.BLIND_SELECT then
        resend_location()
    end
    R.restoring = false
end

local function restore_run(d)
    dbg("rejoin_ok full restore, snapshot=" .. tostring(d.snapshot and d.snapshot.bytes))
    R.stop_reconnect()
    R.hide_all_boxes()
    R.restoring = true
    local save = decode_snapshot(d.snapshot)
    pcall(function() if G.OVERLAY_MENU then G.FUNCS.exit_overlay_menu() end end)
    pcall(function() if bom_ui and bom_ui.hide_lobby then bom_ui.hide_lobby() end end)
    bom_match.restore_from_rejoin(d)
    R.pending_table = nil
    if save then
        bom_match.set_starting_mp_run()
        G.FUNCS.start_run(nil, { savetext = save, mp_start = true })
