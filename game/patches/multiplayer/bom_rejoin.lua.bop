local CLOSING_REASONS = {
    opponent_forfeited = true, forfeited = true, opponent_disconnected = true, disconnected = true,
    opponent_left = true, opponent_timed_out = true, rejoin_expired = true, opponent_abandoned = true,
    abandoned = true, room_expired = true, opponent_quit = true, quit = true, connection_lost = true,
    left_opponent_stopped_waiting = true, dropped_opponent_stopped_waiting = true,
    stopped_waiting_opponent_left = true, stopped_waiting_opponent_dropped = true,
}

function R.reason_text(reason, context)
    if context == "lobby" and (reason == "opponent_left" or reason == "opponent_disconnected") then
        return mod_loc("Your opponent left the lobby.")
    end
    return mod_loc(REASON_TEXT[reason or ""] or "The match has ended.")
end

function R.is_closing_reason(reason)
    return CLOSING_REASONS[reason or ""] == true
end

local function result_title(result)
    if result == "win" then return mod_loc("Victory"), G.C.GOLD end
    if result == "lose" then return mod_loc("Defeat"), G.C.RED end
    if result == "draw" then return mod_loc("Draw"), G.C.UI.TEXT_LIGHT end
    return mod_loc("Match over"), G.C.UI.TEXT_LIGHT
end

local function text_node(line, scale, colour)
    if type(line) == "table" then
        return { n = G.UIT.T, config = { ref_table = line.ref_table, ref_value = line.ref_value, scale = scale, colour = colour, shadow = true } }
    end
    return { n = G.UIT.T, config = { text = tostring(line), scale = scale, colour = colour, shadow = true } }
end

local function popup_rows(spec, on_button)
    local rows = {}
    rows[#rows + 1] = { n = G.UIT.R, config = { align = "cm", padding = 0.06 }, nodes = {
        text_node(spec.title, 0.55, spec.title_colour or G.C.GOLD),
    } }
    for _, line in ipairs(spec.lines or {}) do
        rows[#rows + 1] = { n = G.UIT.R, config = { align = "cm", padding = 0.03 }, nodes = {
            text_node(line, 0.4, G.C.UI.TEXT_LIGHT),
        } }
    end
    if spec.buttons and #spec.buttons > 0 then
        local cols = {}
        for i, b in ipairs(spec.buttons) do
            local fname = "mp_rejoin_" .. spec.id .. "_" .. i
            G.FUNCS[fname] = function()
                on_button()
                local ok, err = pcall(b.fn)
                if not ok then dbg("button " .. fname .. " failed: " .. tostring(err)) end
            end
            cols[#cols + 1] = { n = G.UIT.C, config = { align = "cm", padding = 0.08 }, nodes = {
                UIBox_button({ label = { b.label }, button = fname, minw = 2.6, minh = 0.75, colour = b.colour or G.C.BLUE, scale = 0.45 }),
            } }
        end
        rows[#rows + 1] = { n = G.UIT.R, config = { align = "cm", padding = 0.12 }, nodes = cols }
    end
    return rows
end

R.boxes = {}

function R.hide_box(id)
    local b = R.boxes[id]
    if b then
        pcall(function() b.box:remove() end)
        R.boxes[id] = nil
    end
end

function R.hide_all_boxes()
    for id in pairs(R.boxes) do R.hide_box(id) end
end

function R.show_box(spec)
    if not G or not G.ROOM_ATTACH then return end
    R.hide_box(spec.id)
    local ok, err = pcall(function()
        local box = UIBox({
            definition = {
                n = G.UIT.ROOT,
                config = { align = "cm", colour = G.C.CLEAR, padding = 0.1 },
                nodes = {
                    { n = G.UIT.C, config = { align = "cm", colour = G.C.BLACK, r = 0.15, padding = 0.3, emboss = 0.08, minw = 6 },
                        nodes = popup_rows(spec, function() R.hide_box(spec.id) end) },
                },
            },
            config = { align = "cm", offset = { x = 0, y = spec.y or 0 }, major = G.ROOM_ATTACH },
        })
        box.attention_text = true
        R.boxes[spec.id] = { box = box, until_t = spec.timeout and (now() + spec.timeout) or nil }
    end)
    if not ok then dbg("show_box " .. tostring(spec.id) .. " failed: " .. tostring(err)) end
end

