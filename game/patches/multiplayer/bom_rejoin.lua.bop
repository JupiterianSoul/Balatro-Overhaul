local R = {}

local SESSION_FILE = "mp_session.json"
local SNAP_B64_MAX = 699048
local RECONNECT_DELAYS = { 1, 2, 3, 5 }
local REJOIN_REPLY_TIMEOUT = 15
local ATTEMPT_TIMEOUT = 25
local OFFLINE_GRACE = 2
local OUTBOX_MAX = 64
local OUTBOX_TYPES = {
    blind_entered = true, blind_finished = true, play_hand = true, game_over = true,
    set_location = true, ready_blind = true, unready_blind = true, match_finished = true,
    player_name = true,
}

R.session = nil
R.seq = 0
R.last_upload = -100
R.pending_table = nil
R.last_table = nil
R.outbox = {}
R.rc = { active = false, attempts = 0, next_at = 0, in_flight = false, sent_at = nil, started_at = nil }
R.opp_away = nil
R.ui = { away_time = "", prompt_time = "" }
R.exit_pending = nil
R.menu_popup = nil
R.menu_check_at = nil
R.prompt = nil

local function now()
    return love.timer.getTime()
end

local function json()
    return bom_core and bom_core.json
end

local function dbg(msg)
    pcall(function()
        require("functions/fast_fs").append("mp_match_debug.txt", "\n[REJOIN] " .. tostring(msg))
    end)
    if mp_log then mp_log.info("BOM_REJOIN", "%s", tostring(msg)) end
end

local function blind_letter(key)
    if key == "Boss" then return "L" end
    if key == "Big" then return "B" end
    return "S"
end
R.blind_letter = blind_letter

local function fmt_time(sec)
    sec = math.max(0, math.floor(sec or 0))
    return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

local function in_live_match()
    return bom_match and bom_match.is_in_match and bom_match.is_in_match()
        and not bom_match.is_match_over()
end

function R.load_session()
    local ok, s = pcall(love.filesystem.read, SESSION_FILE)
    if not ok or type(s) ~= "string" or s == "" then return end
    local d = json() and json().decode(s)
    if type(d) == "table" and type(d.code) == "string" and type(d.token) == "string" then
        R.session = d
    end
end

local function loader()
    return rawget(_G, "MODLOADER")
end

local function session_modded()
    local L = loader()
    return L and L.modded == true or false
end

local function write_session()
    if R.session then pcall(require("functions/fast_fs").write, SESSION_FILE, json().encode(R.session)) end
end

function R.store_session(code, token, pid, in_match, id)
    if type(code) ~= "string" or type(token) ~= "string" then return end
    local same = R.session and R.session.code == code and R.session.token == token
    local keep = same and R.session.in_match
    local modded = session_modded()
    if same and R.session.in_match and type(R.session.modded) == "boolean" then modded = R.session.modded end
    if type(id) ~= "string" then id = same and R.session.id or nil end
    R.session = {
        code = code,
        token = token,
        id = id,
        playerId = pid,
        in_match = in_match or keep or false,
        modded = modded,
    }
    write_session()
end

local function needs_session_switch()
    local s = R.session
    local L = loader()
    return s and type(s.modded) == "boolean" and L and L.switch and s.modded ~= session_modded() or false
end

local function switch_for_rejoin()
    local want = R.session.modded
    dbg("rejoin needs a " .. (want and "MODDED" or "NORMAL") .. " session, switching first")
    R.session.auto_rejoin = true
    write_session()
    pcall(bom_core.disconnect)
    if not want and G.FUNCS.mods_normal_game then return G.FUNCS.mods_normal_game({ config = {} }) end
    return loader().switch(want)
end

local function send_rejoin()
    bom_core.connect(function()
        if R.session then
            bom_core.send({ type = "rejoin_match", code = R.session.code, token = R.session.token })
        end
    end, { silent = true, on_fail = function()
        R.end_rejoin_wait()
        R.menu_popup = { reason = "connection_lost", title = mod_loc("Connection lost") }
        R.menu_popup_at = now() + 0.2
    end })
end

function R.rejoin_now()
    if not R.session then
        dbg("Rejoin without a stored session")
        R.show_menu_popup_now({ reason = "not_found", title = mod_loc("Could not rejoin") })
        return
    end
    if needs_session_switch() then return switch_for_rejoin() end
    R.begin_rejoin_wait()
    send_rejoin()
end

function R.held_match_for(id)
    local s = R.session
    if not (s and s.in_match and type(id) == "string" and s.id == id) then return nil end
    if bom_match and bom_match.get_phase() ~= bom_match.PHASE.NONE then return nil end
    return s
end

function R.begin_rejoin_wait()
    R.rejoin_wait = { until_t = now() + REJOIN_REPLY_TIMEOUT }
    pcall(function()
        if not (bom_ui and bom_ui.show_connecting_screen) then return end
        bom_ui.show_connecting_screen()
        local cancel = G.FUNCS.mp_cancel_connecting
        G.FUNCS.mp_cancel_connecting = function(...)
            if R.rejoin_wait then dbg("rejoin cancelled by the player") end
            R.rejoin_wait = nil
            if cancel then return cancel(...) end
        end
    end)
end

function R.end_rejoin_wait()
    if not R.rejoin_wait then return end
    R.rejoin_wait = nil
    pcall(function() if bom_ui and bom_ui.hide_connecting_screen then bom_ui.hide_connecting_screen() end end)
end

function R.clear_session()
    if R.session then dbg("session cleared " .. tostring(R.session.code)) end
    R.session = nil
    pcall(love.filesystem.remove, SESSION_FILE)
end

function R.has_match_session()
    return R.session ~= nil and R.session.in_match == true
end

