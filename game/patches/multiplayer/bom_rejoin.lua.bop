local KEY_STATES = nil
local function is_key_state(st)
    if not KEY_STATES and G and G.STATES then
        KEY_STATES = {
            [G.STATES.BLIND_SELECT] = true, [G.STATES.SHOP] = true,
            [G.STATES.ROUND_EVAL] = true, [G.STATES.HAND_PLAYED] = true,
        }
    end
    return KEY_STATES and KEY_STATES[st] or false
end

function R.on_save()
    if not (G and G.GAME and G.GAME.multiplayer) then return end
    if not R.has_match_session() or not in_live_match() then return end
    local t = G.culled_table
    if type(t) ~= "table" or t == R.last_table or t == R.pending_table then return end
    R.pending_table = t
    R.pending_key = is_key_state(G.STATE)
    R.pending_ante = G.GAME.round_resets and G.GAME.round_resets.ante
    R.pending_blind = G.GAME.blind_on_deck
end

local PACK_IN = "bo_rejoin_pack_in"
local PACK_OUT = "bo_rejoin_pack_out"
local PACK_SRC = [[
if jit.arch == "arm64" or jit.arch == "arm" then jit.off() end
r 26 1 - -
l 1
require "love.data"
r 14 6 - -
l 603
require("love.filesystem")
local ok_req = pcall(require, "engine/string_packer")
local cin = love.thread.getChannel("bo_rejoin_pack_in")
local cout = love.thread.getChannel("bo_rejoin_pack_out")
while true do
    local job = cin:demand(2)
    if job == nil or job == "quit" then return end
    local ok, data = false, "string_packer missing"
    if ok_req then
        ok, data = pcall(function()
            local packed = STR_PACK(job.t)
            local comp = love.data.compress("string", "deflate", packed, 1)
            return love.data.encode("string", "base64", comp)
        end)
    end
    cout:push({ id = job.id, ok = ok, data = data })
end
]]
R.pack = { thread = nil, broken = false, job = nil, next_id = 0 }

local function pack_sync(t)
    return pcall(function()
        local packed = STR_PACK(t)
        local comp = love.data.compress("string", "deflate", packed, 1)
        return love.data.encode("string", "base64", comp)
    end)
end

local function send_snapshot(data, ante, blind)
    if #data > SNAP_B64_MAX then
        dbg("snapshot too large: " .. #data)
        return false
    end
    R.seq = R.seq + 1
    R.last_upload = now()
    ante = tonumber(ante)
    if ante then ante = math.max(0, math.min(999, math.floor(ante))) end
    return bom_core.send({
        type = "save_snapshot",
        data = data,
        seq = R.seq,
        ante = ante,
        blind = type(blind) == "string" and blind:sub(1, 32) or nil,
    }, { raw = true })
end

local function pack_start(t)
    local P = R.pack
    if P.broken or not (love.thread and love.thread.newThread) then return false end
    local ok = pcall(function()
        if not P.thread then P.thread = love.thread.newThread(PACK_SRC) end
        if not P.thread:isRunning() then
            love.thread.getChannel(PACK_OUT):clear()
            P.thread:start()
        end
        P.next_id = P.next_id + 1
        love.thread.getChannel(PACK_IN):push({ id = P.next_id, t = t })
    end)
    if not ok then
        P.broken = true
        return false
    end
    P.job = { id = P.next_id, t = t, ante = R.pending_ante, blind = R.pending_blind, started = now() }
    return true
end

function R.poll_pack()
    local P = R.pack
    if not P.job then return end
    local res = love.thread.getChannel(PACK_OUT):pop()
    while res and res.id ~= P.job.id do res = love.thread.getChannel(PACK_OUT):pop() end
    if not res then
        local err = P.thread and P.thread:getError()
        if err or now() - P.job.started > 10 then
            dbg("snapshot pack thread failed: " .. tostring(err or "timeout"))
            P.broken = true
            local job = P.job
            P.job = nil
            if not R.pending_table then R.pending_table = job.t end
        end
        return
    end
    local job = P.job
    P.job = nil
    if job.cancelled then return end
    if not res.ok then
        dbg("snapshot pack thread error: " .. tostring(res.data))
        P.broken = true
        if not R.pending_table then R.pending_table = job.t end
        return
    end
    if not bom_core or not bom_core.is_connected() or R.rc.active then
        if not R.pending_table then R.pending_table = job.t end
        return
    end
    if not R.has_match_session() or not in_live_match() then return end
    if type(res.data) ~= "string" then return end
    send_snapshot(res.data, job.ante, job.blind)
end

function R.upload_pending(force)
    if force and R.pack.job then
        if not R.pending_table then R.pending_table = R.pack.job.t end
        R.pack.job.cancelled = true
    end
    if not R.pending_table then return false end
    if not bom_core or not bom_core.is_connected() or R.rc.active then return false end
    if not R.has_match_session() or not in_live_match() then
        R.pending_table = nil
        return false
    end
    if not force then
        if R.pack.job then return false end
        local gap = R.pending_key and 0.5 or 3
        if now() - R.last_upload < gap then return false end
    end
    local t = R.pending_table
    R.pending_table = nil
    R.last_table = t
    if not force and pack_start(t) then return false end
    local ok, data = pack_sync(t)
    if not ok then
        dbg("snapshot encode failed: " .. tostring(data))
        return false
    end
    return send_snapshot(data, R.pending_ante, R.pending_blind)
end

local function decode_snapshot(snap)
    if type(snap) ~= "table" or type(snap.data) ~= "string" or snap.data == "" then return nil end
    local ok, tbl = pcall(function()
        local raw = love.data.decode("string", "base64", snap.data)
        local str = raw
        if raw:sub(1, 6) ~= "return" then
            str = love.data.decompress("string", "deflate", raw)
        end
        return STR_UNPACK(str)
    end)
    if ok and type(tbl) == "table" and type(tbl.GAME) == "table" and tbl.BLIND and tbl.BACK then
        return tbl
    end
    dbg("snapshot decode failed: " .. tostring(tbl))
    return nil
end

function R.queue_offline(data)
    if not R.rc.active or type(data) ~= "table" or not OUTBOX_TYPES[data.type] then return end
    if data.type == "set_location" then
        for i = #R.outbox, 1, -1 do
            if R.outbox[i].type == "set_location" then table.remove(R.outbox, i) end
        end
    end
    if #R.outbox >= OUTBOX_MAX then table.remove(R.outbox, 1) end
    R.outbox[#R.outbox + 1] = data
end

local function outbox_has(ty)
    for _, m in ipairs(R.outbox) do
        if m.type == ty then return true end
    end
    return false
end

function R.show_away_popup()
    local away = R.opp_away
    if not away then return end
    local line = away.reason == "left_to_menu"
        and mod_loc("Your opponent went back to the menu and may come back.")
        or mod_loc("Your opponent disconnected and may come back.")
    R.show_box({
        id = "away",
        title = mod_loc("Opponent disconnected"),
        title_colour = G.C.RED,
        lines = { line, { ref_table = R.ui, ref_value = "away_time" } },
        buttons = {
            { label = mod_loc("Wait"), colour = G.C.GREEN, fn = function()
                if R.opp_away then R.opp_away.dismissed = true end
            end },
            { label = mod_loc("Leave"), colour = G.C.RED, fn = function()
                dbg("waiter chose Leave")
                if R.opp_away then R.opp_away.leaving = true end
                bom_core.send({ type = "leave_match" })
            end },
        },
    })
end

function R.set_opp_away(seconds_left, reason, show)
    local fresh = R.opp_away == nil
    R.opp_away = R.opp_away or {}
    R.opp_away.deadline = now() + (tonumber(seconds_left) or 900)
    R.opp_away.reason = reason or R.opp_away.reason
    R.ui.away_time = mod_loc("Time left") .. ": " .. fmt_time(tonumber(seconds_left) or 900)
    pcall(function()
        if G.GAME and G.GAME.mp_opponent_panel then
            if fresh then R.opp_away.prev_location = G.GAME.mp_opponent_panel.location end
            G.GAME.mp_opponent_panel.location = mod_loc("Opponent disconnected")
        end
    end)
    if show and (fresh or not R.boxes.away) and not R.opp_away.dismissed then
        R.show_away_popup()
    end
end

function R.clear_opp_away(notify)
    local was = R.opp_away
    R.opp_away = nil
    R.hide_box("away")
    if was and notify then
        pcall(function()
            if G.GAME and G.GAME.mp_opponent_panel and was.prev_location then
                G.GAME.mp_opponent_panel.location = was.prev_location
            end
        end)
        R.show_box({
            id = "back",
            title = mod_loc("Opponent reconnected"),
            title_colour = G.C.GREEN,
            lines = { mod_loc("The match continues.") },
            timeout = 3,
        })
    end
end

function R.begin_reconnect()
    if R.rc.active then return end
    dbg("connection lost mid-match, auto-reconnect starts")
    R.rc.active = true
    R.rc.attempts = 0
    R.rc.in_flight = false
    R.rc.sent_at = nil
    R.rc.next_at = now() + RECONNECT_DELAYS[1]
    R.outbox = {}
    R.show_box({
        id = "reconnect",
        title = mod_loc("Connection lost"),
        title_colour = G.C.RED,
        lines = { mod_loc("Reconnecting to the server...") },
        y = -1.5,
    })
end

function R.stop_reconnect()
    R.rc.active = false
    R.rc.in_flight = false
    R.rc.sent_at = nil
    R.hide_box("reconnect")
end

local function schedule_retry()
    R.rc.in_flight = false
    R.rc.sent_at = nil
    local d = RECONNECT_DELAYS[math.min(R.rc.attempts + 1, #RECONNECT_DELAYS)]
    R.rc.next_at = now() + d
end

local function try_reconnect()
    if not R.session then R.stop_reconnect() return end
    R.rc.attempts = R.rc.attempts + 1
    R.rc.in_flight = true
    R.rc.started_at = now()
    dbg("reconnect attempt " .. R.rc.attempts)
    bom_core.connect(function()
        if not R.rc.active or not R.session then return end
        R.rc.sent_at = now()
        bom_core.send({ type = "rejoin_match", code = R.session.code, token = R.session.token })
    end, { silent = true, on_fail = function()
        if R.rc.active then schedule_retry() end
    end })
end

function R.on_connection_lost()
    if R.exit_pending or R.exiting then return end
    if R.rc.active then
        schedule_retry()
        return
    end
    if R.checking then
        R.checking = false
        return
    end
    local phase = bom_match and bom_match.get_phase and bom_match.get_phase()
    if in_live_match() then
        if R.has_match_session() then
            R.begin_reconnect()
        else
            bom_match.end_match("lose", "connection_lost")
        end
    elseif phase == bom_match.PHASE.LOBBY or phase == bom_match.PHASE.STARTING then
        R.exit_to_menu({ reason = "connection_lost", title = mod_loc("Connection lost"), context = "lobby" })
    elseif phase == bom_match.PHASE.MATCH_END then
        R.exit_to_menu({ reason = "connection_lost", title = mod_loc("Connection lost"), context = "post" })
    end
end

function R.exit_to_menu(info)
    if R.exit_pending then return end
    R.exit_pending = info or {}
    dbg("exit to menu queued: " .. tostring(R.exit_pending.reason))
end

function R.do_exit()
    local info = R.exit_pending
    R.exit_pending = nil
    R.exiting = true
    R.stop_reconnect()
    R.outbox = {}
    R.opp_away = nil
    R.hide_all_boxes()
    R.pending_table = nil
    pcall(function() if bom_ui and bom_ui.hide_pvp_waiting then bom_ui.hide_pvp_waiting() end end)
    pcall(function() if bom_ui and bom_ui.destroy_match_hud then bom_ui.destroy_match_hud() end end)
    if not info.keep_match then
        pcall(function() if bom_core then bom_core.disconnect() end end)
        pcall(function() if bom_match then bom_match.restore_fairness() end end)
        pcall(function() if bom_match then bom_match.reset() end end)
    end
    if not info.silent then R.menu_popup = info end
    R.after_menu = info.after
    local in_run = G.STAGE == G.STAGES.RUN
    pcall(function() if G.GAME then G.GAME.multiplayer = nil end end)
    pcall(function() if G.OVERLAY_MENU then G.FUNCS.exit_overlay_menu() end end)
    if in_run then
        G.FUNCS.go_to_menu()
    else
        R.exiting = false
        pcall(function() if bom_ui and bom_ui.hide_lobby then bom_ui.hide_lobby() end end)
        R.menu_popup_at = now() + 0.3
    end
end

function R.show_menu_popup()
    local info = R.menu_popup
    R.menu_popup = nil
    if not info then return end
    local title, colour = info.title, G.C.RED
    if not title then title, colour = result_title(info.result) end
    local lines = {}
    if info.opp_name and info.opp_name ~= "" then lines[#lines + 1] = mod_loc("vs ") .. info.opp_name end
    lines[#lines + 1] = R.reason_text(info.reason, info.context)
    if info.context == "post" then lines[#lines + 1] = mod_loc("The room is closed.") end
    R.show_overlay({
        id = "info",
        title = title,
        title_colour = info.title_colour or colour,
        lines = lines,
        buttons = { { label = mod_loc("OK"), colour = G.C.BLUE, fn = function() end } },
    })
end

function R.check_rejoin()
    if not R.has_match_session() then return end
    if bom_match.get_phase() ~= bom_match.PHASE.NONE then return end
    if R.rc.active or R.exit_pending then return end
    R.checking = true
    dbg("check_rejoin " .. R.session.code)
    bom_core.connect(function()
        if not R.session then return end
        bom_core.send({ type = "check_rejoin", code = R.session.code, token = R.session.token })
    end, { silent = true, on_fail = function()
        R.checking = false
        dbg("check_rejoin: server unreachable")
        R.menu_check_at = now() + 5
    end })
end

local function show_prompt(d)
    R.prompt = { deadline = now() + (tonumber(d.secondsLeft) or 900), status = d }
    R.prompt_status = d
    R.ui.prompt_time = mod_loc("Time left") .. ": " .. fmt_time(tonumber(d.secondsLeft) or 900)
    local lines = {}
    local kinds = { teams = "Teams", br = "Battle Royale", raid = "Co-op Raid", race = "Race" }
    if d.party and kinds[d.kind] then lines[#lines + 1] = mod_loc(kinds[d.kind]) end
    if d.opponentName and d.opponentName ~= "" and d.kind ~= "raid" then lines[#lines + 1] = mod_loc("vs ") .. tostring(d.opponentName) end
    if d.party then
        lines[#lines + 1] = mod_loc("Your seat is held while the others keep playing.")
    else
        lines[#lines + 1] = d.opponentWaiting and mod_loc("Your opponent is waiting for you.") or mod_loc("Your opponent is not connected.")
    end
    lines[#lines + 1] = { ref_table = R.ui, ref_value = "prompt_time" }
    R.show_overlay({
        id = "prompt",
        title = mod_loc("Match in progress"),
        lines = lines,
        buttons = {
            { label = mod_loc("Rejoin"), colour = G.C.GREEN, fn = function()
                R.prompt = nil
                dbg("prompt: Rejoin")
                R.rejoin_now()
            end },
            { label = mod_loc("Leave match"), colour = G.C.RED, fn = function()
                R.prompt = nil
                if not R.session then return end
                dbg("prompt: Leave match")
                R.giving_up = true
                bom_core.send({ type = "leave_match", code = R.session.code, token = R.session.token })
            end },
            { label = mod_loc("Later"), colour = G.C.UI.BACKGROUND_INACTIVE, fn = function()
                R.prompt = nil
                R.checking = false
                pcall(bom_core.disconnect)
            end },
        },
    })
end

function R.on_rejoin_status(d)
    R.checking = false
    R.end_rejoin_wait()
    if type(d) ~= "table" then return end
    if R.session and d.code and d.code ~= R.session.code then return end
    if d.rejoinable then
        if bom_match.get_phase() ~= bom_match.PHASE.NONE then return end
        if G.STAGE ~= G.STAGES.MAIN_MENU then
            R.menu_check_at = now() + 1
            return
        end
        if R.session and R.session.auto_rejoin and not needs_session_switch() then
            R.session.auto_rejoin = nil
            write_session()
            dbg("auto rejoin after the session switch")
            return send_rejoin()
        end
        show_prompt(d)
        return
    end
    R.clear_session()
    pcall(bom_core.disconnect)
    if d.reason == "no_match" then return end
    R.add_ended_game(d)
    if R.giving_up then
        R.giving_up = false
        R.show_menu_popup_now({ result = d.result, reason = d.reason or "abandoned" })
        return
    end
    R.show_menu_popup_now({ result = d.result, reason = d.reason })
end

function R.add_ended_game(d)
    if not (d and d.result and bom_ranked and bom_ranked.session_add) then return end
    local st = R.prompt_status or {}
    R.prompt_status = nil
    pcall(bom_ranked.session_add, { result = d.result, reason = d.reason, opp = st.opponentName, mode = st.mode, ante = st.ante })
end

function R.show_menu_popup_now(info)
    R.menu_popup = info
    R.menu_popup_at = now() + 0.1
end

function R.on_rejoin_failed(d)
    dbg("rejoin_failed reason=" .. tostring(d and d.reason))
    R.checking = false
    local waited = R.rejoin_wait ~= nil
    R.end_rejoin_wait()
    if d and d.reason == "already_in_room" then
        R.stop_reconnect()
        if waited then R.show_menu_popup_now({ reason = "already_in_room", title = mod_loc("Could not rejoin") }) end
        return
    end
    R.clear_session()
    if R.rc.active or in_live_match() then
        R.stop_reconnect()
        local info = { result = d and d.result, reason = d and d.reason or "not_found" }
        if bom_match and bom_match.get_state then info.opp_name = bom_match.get_state().opp_name end
        R.exit_to_menu(info)
        return
    end
    R.add_ended_game(d)
    pcall(bom_core.disconnect)
    R.show_menu_popup_now({ result = d and d.result, reason = d and d.reason or "not_found" })
end

local function current_location()
    local loc = nil
    pcall(function()
        if G.STATE == G.STATES.SHOP then
            loc = "loc_shop"
        elseif G.STATE == G.STATES.BLIND_SELECT then
            loc = G.GAME.mp_blind_ready and "loc_ready" or "loc_selecting"
        elseif G.GAME.facing_blind then
            local key = G.GAME.round_resets.blind_choices[G.GAME.blind_on_deck] or "unknown"
            loc = "loc_playing-" .. key
        end
    end)
    return loc
end

local function resend_location()
    local loc = current_location()
    if not loc then return end
    pcall(function() bom_match.get_state()._last_sent_location = nil end)
    bom_match.send_location(loc)
end

local function apply_opp_location(d)
    if d.opp and type(d.opp.location) == "string" and d.opp.location ~= "" then
        pcall(function()
            if bom_events and bom_events.dispatch then
                bom_events.dispatch({ type = "set_location", location = d.opp.location })
            end
        end)
    end
end

local function missed_result(d, seen)
    local list = type(d.pvpResults) == "table" and d.pvpResults or {}
    if #list <= (seen or 0) then return nil end
    local r = list[#list]
    if type(r) ~= "table" then return nil end
    local pid = d.playerId
    local my = pid == 0 and r.p0Score or r.p1Score
    local op = pid == 0 and r.p1Score or r.p0Score
    local result = "draw"
    if r.winner ~= nil then result = (r.winner == pid) and "win" or "lose" end
    return {
        type = "pvp_resolved", result = result, myScore = my or 0, oppScore = op or 0,
        myLives = d.me and d.me.lives, oppLives = d.opp and d.opp.lives,
        matchEnded = false, ante = r.ante, blind = r.blind,
    }
end

local function sync_ready(d, live)
    pcall(function()
        local pvp = d.pvp or {}
        G.GAME.mp_opponent_blind_ready = pvp.oppReady == true
        if live and G.GAME.mp_blind_ready and not pvp.myReady and G.STATE == G.STATES.BLIND_SELECT then
            if not outbox_has("ready_blind") then
                local deck = G.GAME.blind_on_deck
                bom_core.send({ type = "ready_blind", ante = G.GAME.round_resets and G.GAME.round_resets.ante,
                    blind = deck == "Small" and "S" or deck == "Big" and "B" or "L" })
            end
        elseif not live then
            G.GAME.mp_blind_ready = false
            G.GAME.mp_blind_ready_text = mod_loc("Ready")
        end
    end)
end

local function sync_opp_presence(d)
    if d.opp and d.opp.connected == false then
        R.set_opp_away(d.opp.secondsLeft, nil, true)
    elseif R.opp_away then
        R.clear_opp_away(false)
    end
end

local function resync_live(d)
    dbg("rejoin_ok live resync")
    R.stop_reconnect()
    bom_match.apply_live_rejoin(d)
    local missed = missed_result(d, bom_match.get_state().pvp_results_seen)
    if missed then
        dbg("applying PvP result missed while away")
        bom_match.on_pvp_resolved(missed)
    end
    sync_ready(d, true)
    apply_opp_location(d)
    local box = R.outbox
    R.outbox = {}
    for _, m in ipairs(box) do bom_core.send(m) end
    resend_location()
    sync_opp_presence(d)
    if G.culled_table and G.culled_table ~= R.last_table then
        R.pending_table = G.culled_table
        R.pending_key = true
    end
    R.upload_pending(true)
end
R.resync_live = resync_live

local function fix_pvp_state(d)
    local rr = G.GAME.round_resets
    if not rr then return end
    local key = G.GAME.blind_on_deck or "Small"
    local in_round = G.GAME.facing_blind and (G.STATE == G.STATES.SELECTING_HAND
        or G.STATE == G.STATES.HAND_PLAYED or G.STATE == G.STATES.DRAW_TO_HAND)
    if not in_round then
        if G.STATE == G.STATES.ROUND_EVAL and G.GAME.mp_blind_loss_pending then
            bom_match.restore_pending_loss(d.me and d.me.lives)
        end
        return
    end
    bom_match.set_current_blind(rr.ante, blind_letter(key))
    local pvp_slot = rr.pvp_blind_choices and rr.pvp_blind_choices[key]
    if pvp_slot == nil then pvp_slot = bom_match.is_blind_pvp(rr.ante, blind_letter(key)) end
    if not pvp_slot then return end
    G.GAME.blind.pvp = true
    G.GAME.mp_in_boss_blind = true
    bom_match.transition(bom_match.PHASE.PVP_BLIND)
    local pvp = d.pvp or {}
    pcall(function()
        if G.GAME.mp_opponent_panel and pvp.oppScore ~= nil then
            G.GAME.mp_opponent_panel.score = pvp.oppScore
        end
    end)
    local missed = missed_result(d, G.GAME.mp_pvp_results_seen or 0)
    if missed and not pvp.started and (missed.ante == nil or missed.ante == rr.ante) then
        dbg("restore: PvP blind resolved while away, closing it")
        if missed.result == "lose" then bom_match.set_display_lives((tonumber(missed.myLives) or 0) + 1) end
        bom_match.on_pvp_resolved(missed)
        bom_match.restore_counts(d)
        G.GAME.blind.pvp = true
