l 22
            if depth then
                while love.graphics.getStackDepth() > depth do love.graphics.pop() end
            end
        end
        love.graphics.setColor(1, 1, 1, 1)
    end

    function Fx:remove()
        if self.removed_fx then return end
        self.removed_fx = true
        for _, group in ipairs({self.sprites, self.texts, self.emitters}) do
            for _, obj in pairs(group) do
                if obj then pcall(function() obj:remove() end) end
            end
        end
        self.sprites, self.texts, self.emitters = {}, {}, {}
        local alerts = G.I and G.I.ALERT
        if alerts then
            for i = #alerts, 1, -1 do
                if alerts[i] == self then table.remove(alerts, i) end
            end
        end
