    end

    return Fx
end

E.fx_class = fx_class

local function kill(fx)
    if fx then pcall(function() fx:remove() end) end
end

function E.sweep()
    for i = #E.live, 1, -1 do
        local fx = E.live[i]
        if fx:expired() then
            table.remove(E.live, i)
            kill(fx)
        end
    end
end

function E.clear()
    for i = #E.live, 1, -1 do kill(E.live[i]) end
    E.live = {}
end

local function who_key(who)
    if who.fixed then return nil end
    if who.mine then return "me" end
    if who.pid ~= nil then return "p" .. tostring(who.pid) end
    return "n" .. tostring(who.name or "?")
end

function E.play(id, who, o)
    id = E.resolve(id)
    if not id then return nil end
    if not (G and G.I and G.I.ALERT and G.TIMERS and Moveable and Sprite) then return nil end
    who = who or {}
    o = o or {}
    local key = who_key(who)
    if key then
        for _, fx in ipairs(E.live) do
            if fx.who_key == key then fx.dead = true end
        end
    end
    E.sweep()
    while #E.live >= E.MAX_LIVE and not o.many do kill(table.remove(E.live, 1)) end
    local ok, fx = pcall(fx_class(), {id = id, mode = "pop", size = o.size or pop_size(), who = who, freeze = o.freeze, silent = o.silent})
    if not ok or not fx then return nil end
    fx.who_key = key
    table.insert(G.I.ALERT, fx)
    E.live[#E.live + 1] = fx
    E._layout_t = 0
    pcall(function() fx:resolve() end)
    return fx
end

local function profile_name()
    local p = G and G.PROFILES and G.SETTINGS and G.PROFILES[G.SETTINGS.profile]
    return p and p.name or nil
end

local function party_on()
    return bom_party ~= nil and bom_party.S ~= nil and bom_party.active ~= nil and bom_party.active()
end

local function my_pid()
    if party_on() then return bom_party.S.me end
    local st = bom_match and bom_match.get_state and bom_match.get_state()
    return st and st.server_player_id or nil
end

local function pid_by_name(name)
    if type(name) ~= "string" or name == "" then return nil end
    local lists = {}
    if party_on() then
        local S = bom_party.S
        lists[#lists + 1] = S.room and S.room.players
        lists[#lists + 1] = S.ps and S.ps.players
    end
    local st = bom_match and bom_match.get_state and bom_match.get_state()
    lists[#lists + 1] = st and st.roster
    for _, list in ipairs(lists) do
        if type(list) == "table" then
            for _, p in ipairs(list) do
                if type(p) == "table" and p.name == name and p.pid ~= nil then return p.pid end
            end
        end
    end
    return nil
end

function E.on_message(d)
    if type(d) ~= "table" then return true end
    local id = E.resolve(d.id) or E.resolve(d.e)
    if not id then return true end
    local pid = tonumber(d.pid)
    local name = d.name ~= nil and tostring(d.name) or ""
    if pid == nil then pid = pid_by_name(name) end
    E.play(id, {pid = pid, name = name, mine = false})
    return true
end

function E.can_send()
    return clock() >= (E._next_send or 0)
end

function E.send(id)
    id = E.resolve(id)
    if not id then return false end
    if not E.can_send() then
        if play_sound then pcall(play_sound, "cancel", 1, 0.5) end
        return false
    end
    E._next_send = clock() + E.SEND_GAP
    if bom_core and bom_core.is_connected and bom_core.is_connected() then
        pcall(bom_core.send, {type = "social_emote", id = id, e = E.TO_LEGACY[id]})
    end
    local who = {mine = true, pid = my_pid(), name = profile_name()}
    if G.E_MANAGER and Event then
        G.E_MANAGER:add_event(Event({trigger = "after", delay = 0.05, timer = "REAL", blocking = false, blockable = false, pause_force = true,
            func = function() E.play(id, who) return true end}))
    else
        E.play(id, who)
    end
    return true
end

local function tile_dims()
    local touch = UIK and UIK.touch and UIK.touch()
    if touch then return 2.35, 2.35, 1.6, 0.4 end
    return 2.05, 2.05, 1.4, 0.36
end

function E.picker_cols()
    if UIK and UIK.portrait and UIK.portrait() then return 3 end
    return 6
end

function E.picker_w()
    local tw = tile_dims()
    return E.picker_cols() * (tw + 0.16) + 0.2
end

function E.picker_grid()
    local tw, th, ps, ls = tile_dims()
    local items = {}
    local F = fx_class()
    for i, def in ipairs(E.LIST) do
        local fx = F({id = def.id, mode = "preview", size = ps, offset = (i - 1) * 0.37})
        items[#items + 1] = {n = G.UIT.C, config = {align = "cm", minw = tw, maxw = tw, minh = th, r = 0.12, padding = 0.04,
            colour = {0, 0, 0, 0.22}, emboss = 0.05, hover = true, shadow = true, button = "bom_emote_pick_" .. i, id = "bom_emote_tile_" .. def.id}, nodes = {
            {n = G.UIT.R, config = {align = "cm", minw = tw - 0.1, minh = ps}, nodes = {
                {n = G.UIT.O, config = {object = fx, can_collide = false}},
            }},
            {n = G.UIT.R, config = {align = "cm", minw = tw - 0.1, minh = ls + 0.08}, nodes = {
                {n = G.UIT.T, config = {text = L(def.label), scale = ls, colour = G.C.WHITE, shadow = true, maxw = tw - 0.2}},
            }},
        }}
    end
    return UIK.grid(items, E.picker_cols(), {w = E.picker_w(), padding = 0.08})
end

function E.open_picker(o)
    o = o or {}
    if not (G and G.FUNCS and UIK and UIK.window) then return end
    E._picker = {after = o.after, pick = o.pick}
r 13 1381 %20%20%20%20 -
l 55
    G.FUNCS.overlay_menu{definition = UIK.window{
        id = "emotes", title = L("EMOTES"), compact = true, w = E.picker_w() + 0.4,
        tabs = {{key = "all", label = L("Emotes"), build = E.picker_grid}},
        back_func = o.back or "exit_overlay_menu",
    }}
    E._picker.box = G.OVERLAY_MENU
end

function E.picker_open()
    return E._picker ~= nil and E._picker.box ~= nil and E._picker.box == G.OVERLAY_MENU
end

function E.debug_strip(ids, o)
    o = o or {}
    E.clear()
    local frames = o.frames or {0.1, 0.3, 0.5, 0.7, 0.9, 1.1, 1.3, 1.42}
    local S = o.size or 1.5
    local room_w = (G.ROOM and G.ROOM.T.w) or 20
    local gap_x = (room_w - 0.6) / #frames
    local gap_y = o.row_h or 3.1
    for r, id in ipairs(ids) do
        for c, ft in ipairs(frames) do
            E.play(id, {fixed = {x = 0.3 + gap_x * (c - 0.5), y = (o.top or 1.7) + (r - 1) * gap_y}}, {freeze = ft, silent = true, size = S, many = true})
        end
    end
end

function E.update()
    if #E.live == 0 then return end
    E.sweep()
end

local function register_funcs()
    for i, def in ipairs(E.LIST) do
        G.FUNCS["bom_emote_pick_" .. i] = function()
            local pick = E._picker and E._picker.pick
            if pick then
                if pick(def.id) then E._picker = nil end
                return
            end
            if not E.send(def.id) then return end
            local after = E._picker and E._picker.after
            E._picker = nil
            if after then after() elseif G.FUNCS.exit_overlay_menu then G.FUNCS.exit_overlay_menu() end
        end
    end
end

function E.init()
    if G and G.FUNCS then register_funcs() end
    if mod_loc_register then mod_loc_register(E.LOC) end
    if bom_events and bom_events.register then bom_events.register("social_emote", E.on_message) end
end

return E
end
