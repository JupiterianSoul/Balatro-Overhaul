local SPECIAL = {TEAR = {0.55, 0.8, 1, 1}, GLASS = {1, 1, 1, 0.8}}

local function colour(name)
    if type(name) == "table" then return name end
    if SPECIAL[name] then return SPECIAL[name] end
    return (G and G.C and G.C[name]) or {1, 1, 1, 1}
end

local function sprite_info(name)
    local s = E.SPRITES[name]
    if not (s and G and G.ASSET_ATLAS) then return nil end
    if s.center then
        local c = G.P_CENTERS and G.P_CENTERS[s.center]
        if not (c and c.pos) then return nil end
        if c.set == "Joker" or c.consumeable or c.set == "Voucher" then
            return G.ASSET_ATLAS[c.atlas or c.set] or G.ASSET_ATLAS[c.set] or G.ASSET_ATLAS.Tarot, c.pos
        end
        return G.ASSET_ATLAS[c.atlas or "centers"] or G.ASSET_ATLAS.centers, c.pos
    end
    if s.front then
        local f = G.P_CARDS and G.P_CARDS[s.front]
        if not f then return nil end
        if get_front_spriteinfo then
            local ok, atlas, pos = pcall(get_front_spriteinfo, f)
            if ok and atlas then return atlas, pos end
        end
        return G.ASSET_ATLAS.cards_1, f.pos
    end
    if s.stake then
        local st = G.P_STAKES and G.P_STAKES[s.stake]
        return G.ASSET_ATLAS.chips, st and st.pos or {x = 0, y = 0}
    end
    return G.ASSET_ATLAS[s.atlas], s.pos
end

local function place(obj, x, y, w, h, r, scale)
    local T, V = obj.T, obj.VT
    T.x, T.y, T.w, T.h, T.r, T.scale = x - w / 2, y - h / 2, w, h, r or 0, scale or 1
    V.x, V.y, V.w, V.h, V.r, V.scale = T.x, T.y, w, h, T.r, T.scale
end

local function quiet(obj)
    if not obj then return end
    obj.states.collide.can = false
    obj.states.hover.can = false
    obj.states.click.can = false
    obj.states.drag.can = false
    obj.created_on_pause = true
end

local function pop_size()
    return (UIK and UIK.touch and UIK.touch()) and 1.6 or 1.35
end

local function lick(c)
    local y = (G and G.C and G.C.YELLOW) or {1, 0.8, 0, 1}
    local out = {1, 1, 1, 1}
    for i = 1, 3 do out[i] = min(max(((c[i] * 0.5 + y[i] * 0.5) + 0.1) ^ 2, 0.1), 1) end
    return out
end

local function play(s)
    if not play_sound then return end
    local code = s[2]
    if code == "glass" then code = "glass" .. math.random(1, 6) end
    pcall(play_sound, code, s[3] + (math.random() - 0.5) * 0.04, s[4])
end

E.live = E.live or {}

local function walk(node, id, depth, budget)
    if not node or budget[1] <= 0 then return nil end
    budget[1] = budget[1] - 1
    local cfg = node.config
    if cfg and cfg.id == id and not node.REMOVED and node.VT then return node end
    local obj = cfg and cfg.object
    if obj and depth > 0 and obj.UIRoot and not obj.REMOVED then
        local e = walk(obj.UIRoot, id, depth - 1, budget)
        if e then return e end
    end
    if type(node.children) == "table" then
        for _, ch in ipairs(node.children) do
            local e = walk(ch, id, depth, budget)
            if e then return e end
        end
    end
    return nil
end

local function find_in(box, ids)
    if not (box and not box.REMOVED and box.get_UIE_by_ID) then return nil end
    local inner
    local body = box:get_UIE_by_ID("uik_body")
    if body and body.config and body.config.object and body.config.object.get_UIE_by_ID then inner = body.config.object end
    for _, id in ipairs(ids) do
        local e = box:get_UIE_by_ID(id) or (inner and inner:get_UIE_by_ID(id))
        if e and not e.REMOVED and e.VT then return e, id end
    end
    if box.UIRoot then
        for _, id in ipairs(ids) do
            local e = walk(box.UIRoot, id, 4, {2000})
            if e then return e, id end
        end
    end
    return nil
end

local function ids_for(who)
    local ids = {}
    if who.pid ~= nil then ids[#ids + 1] = "bom_emote_pid_" .. tostring(who.pid) end
    ids[#ids + 1] = who.mine and "bom_emote_you" or "bom_emote_opp"
    return ids
end

E.GAP = 0.15
E.PAD = 0.25
E.RUN_SIZE = 1.25
E.QUEUE_MAX = 3
E.LAYOUT_EVERY = 0.2
E.TAG_SCALE = 0.32
E.SHRINK = {1, 0.85, 0.72}

local function screen_box()
    local s = (G.TILESIZE or 20) * (G.TILESCALE or 1)
    local o = G.ROOM_ORIG or (G.ROOM and G.ROOM.T) or {x = 0, y = 0}
    local w, h = 0, 0
    if love.graphics and love.graphics.getDimensions then w, h = love.graphics.getDimensions() end
    if not (w > 0 and h > 0 and s > 0) then
        local R = G.ROOM and G.ROOM.T or {w = 20, h = 11.5}
        return 0, 0, R.w, R.h
    end
    return -(o.x or 0), -(o.y or 0), w / s, h / s
end
E.screen_box = screen_box

local function solid(node)
    local c = node.config and node.config.colour
    return type(c) == "table" and (c[4] or 1) > 0.3
end

local function frame_of(box)
    local root = box.UIRoot
    local room_w = (G.ROOM and G.ROOM.T.w) or 20
    if root then
        local queue, qi = {root}, 1
        while queue[qi] and qi <= 80 do
            local node = queue[qi]
            qi = qi + 1
            local V = node.VT
            if node ~= root and V and V.w >= 2 and V.h >= 1.5 and V.w <= room_w * 1.5 and solid(node) then return node end
            if type(node.children) == "table" then
                for _, ch in ipairs(node.children) do queue[#queue + 1] = ch end
            end
        end
        if root.VT and root.VT.w > 0 and root.VT.w <= room_w * 1.5 then return root end
    end
    if box.VT and box.VT.w > 0 and box.VT.w <= room_w * 1.5 then return box end
    return nil
end

local function context()
    local o = G.OVERLAY_MENU
    if o and not o.REMOVED then
        local f = frame_of(o)
        if f then return "window", o, f end
    end
    if G.STAGES and G.STAGE == G.STAGES.RUN and G.deck and G.deck.T and G.consumeables and G.consumeables.T then return "run", nil, nil end
    return "screen", nil, nil
end
E.context = context

local function settled(f)
    local T, V = f.T, f.VT
    if not (T and V) then return true end
    return abs(T.x - V.x) < 0.05 and abs(T.y - V.y) < 0.05
end

local function hits(x, y, w, h, blocks, n)
    for i = 1, n do
        local r = blocks[i]
        if x < r[1] + r[3] and r[1] < x + w and y < r[2] + r[4] and r[2] < y + h then return true end
    end
    return false
end

local function search(lo, hi, want, ok)
    if hi < lo - 1e-6 then return nil end
    if want < lo then want = lo elseif want > hi then want = hi end
    local step = 0.05
    local n = floor((hi - lo) / step) + 1
    for d = 0, n do
        local a = want + d * step
        if a <= hi + 1e-6 and ok(a) then return a end
        local b = want - d * step
        if d > 0 and b >= lo - 1e-6 and ok(b) then return b end
    end
    if ok(hi) then return hi end
    if ok(lo) then return lo end
    return nil
end

local function add_block(blocks, n, x, y, w, h, grow)
    n = n + 1
    local r = blocks[n]
    if not r then r = {} blocks[n] = r end
    grow = grow or 0
    r[1], r[2], r[3], r[4] = x - grow, y - grow, w + 2 * grow, h + 2 * grow
    return n
end

local function ui_blocks(blocks, n, x0, y0, x1, y1, sw, sh)
    local list = G.I and G.I.UIBOX
    if type(list) ~= "table" then return n end
    for _, u in ipairs(list) do
        local V = u.VT
        if V and not u.REMOVED and u ~= G.OVERLAY_MENU and (not u.states or u.states.visible ~= false)
            and V.w > 0.05 and V.h > 0.05 and V.w < sw * 0.6 and V.h < sh * 0.6
            and V.x < x1 and x0 < V.x + V.w and V.y < y1 and y0 < V.y + V.h then
            n = add_block(blocks, n, V.x, V.y, V.w, V.h, E.GAP * 0.4)
        end
    end
    return n
end

local function px_block(blocks, n, b, s, sx, sy)
    if not (b and b.w and b.h and b.w > 0 and b.h > 0) then return n end
    return add_block(blocks, n, sx + b.x / s, sy + b.y / s, b.w / s, b.h / s, E.GAP)
end

local function corner_blocks(blocks, n)
    local CL = CORNER_LABELS
    if not CL then return n end
    local s = (G.TILESIZE or 20) * (G.TILESCALE or 1)
    if not (s > 0) then return n end
    local sx, sy = screen_box()
    n = px_block(blocks, n, CL.status_box, s, sx, sy)
    n = px_block(blocks, n, CL.mode_rect, s, sx, sy)
    local GR = G.SETTINGS and G.SETTINGS.GRAPHICS
    if GR and GR.show_fps then n = px_block(blocks, n, CL.fps_box, s, sx, sy) end
    local MGH = rawget(_G, "Minigames") and Minigames.host
    local b = MGH and MGH.btn
    if b and not b.REMOVED and b.VT then n = add_block(blocks, n, b.VT.x, b.VT.y, b.VT.w, b.VT.h, E.GAP) end
    return n
end

local function area_right(a)
    if not (a and a.T and not a.REMOVED) then return nil end
    return a.T.x + a.T.w
end

local function run_dock(sx, sy, sw, sh)
    local x0 = sx + sw * 0.5
    for _, a in ipairs({G.hand, G.play}) do
        local r = area_right(a)
        if r and r > x0 then x0 = r end
    end
    x0 = x0 + E.GAP
    local C, D = G.consumeables.T, G.deck.T
    return x0, C.y + C.h + E.GAP * 0.5, sx + sw - 0.35, D.y - E.GAP * 0.5
end

function E.tag_of(fx)
    local name = fx.who and fx.who.name
    if not name or name == "" or fx.who.fixed then return nil end
    local d = fx.texts.__tag
    if d == nil then
        local S = fx.size
        local ok, made = pcall(DynaText, {string = {tostring(name)}, colours = {G.C.WHITE}, scale = E.TAG_SCALE, shadow = true, silent = true, maxw = S * 1.3})
        d = ok and made or false
        if d then quiet(d) d.parent = fx end
        fx.texts.__tag = d
    end
    return d or nil
end

local function slot_dims(fx)
    local S = fx.size
    local b = S * 1.06
    local d = E.tag_of(fx)
    local tw, th = 0, 0
    if d then tw, th = d.T.w, d.T.h + 0.04 end
    return max(b, tw), S * 1.11 + th, S * 0.53
end

local function side_for(fx, id)
    if id == "bom_emote_you" then return "left" end
    if id == "bom_emote_opp" then return "right" end
    if id then return "left" end
    return fx.who.mine and "left" or "right"
end

local function place_window(fx, box, f, blocks, n)
    local F = f.VT
    local sx, sy, sw, sh = screen_box()
    local w, h, top = slot_dims(fx)
    local e, id = find_in(box, ids_for(fx.who))
    local want = e and (e.VT.y + e.VT.h / 2) or (F.y + top + 0.3)
    local first = side_for(fx, id)
    local stay = (id == nil or id == "bom_emote_you" or id == "bom_emote_opp") and 2.5 or 0.3
    local best, best_d
    for _, side in ipairs({"left", "right"}) do
        local x = side == "left" and (F.x - E.GAP - w) or (F.x + F.w + E.GAP)
        if x >= sx + E.PAD - 1e-6 and x + w <= sx + sw - E.PAD + 1e-6 then
            local lo, hi = max(sy + E.PAD, F.y), min(sy + sh - E.PAD, F.y + F.h) - h
            local y = search(lo, hi, want - top, function(yy) return not hits(x, yy, w, h, blocks, n) end)
            if y then
                local d = abs(y + top - want) + (side == first and 0 or stay)
                if not best_d or d < best_d then best, best_d = {x + w / 2, y + top}, d end
            end
        end
    end
    if not best then
        for _, side in ipairs({"top", "bottom"}) do
            local y = side == "top" and (F.y - E.GAP - h) or (F.y + F.h + E.GAP)
            if not best and y >= sy + E.PAD - 1e-6 and y + h <= sy + sh - E.PAD + 1e-6 then
                local lo, hi = max(sx + E.PAD, F.x), min(sx + sw - E.PAD, F.x + F.w) - w
                local x = search(lo, hi, first == "left" and lo or hi, function(xx) return not hits(xx, y, w, h, blocks, n) end)
                if x then best = {x + w / 2, y + top} end
            end
        end
    end
    if not best then return nil end
    return {kind = "window", box = box, rel = f, dx = best[1] - F.x, dy = best[2] - F.y, w = w, h = h, top = top}
end

local function place_free(fx, kind, blocks, n)
    local sx, sy, sw, sh = screen_box()
    local w, h, top = slot_dims(fx)
    local x0, y0, x1, y1
    if kind == "run" then
        x0, y0, x1, y1 = run_dock(sx, sy, sw, sh)
    else
        x0, y0, x1, y1 = sx + sw * 0.2, sy + E.PAD + 0.2, sx + sw * 0.8, sy + sh * 0.45
    end
    local cols = min(kind == "run" and 2 or 4, floor((x1 - x0 + E.GAP) / (w + E.GAP)))
    if cols < 1 then return nil end
    local best_x, best_y
    local span = cols * w + (cols - 1) * E.GAP
    local mid = (x0 + x1) / 2
    if kind == "run" and G.deck and G.deck.T then mid = G.deck.T.x + G.deck.T.w / 2 end
    local left = clamp(mid - span / 2, x0, x1 - span)
    for c = 1, cols do
        local x = left + (c - 1) * (w + E.GAP)
        local y = search(y0, y1 - h, y0, function(yy) return not hits(x, yy, w, h, blocks, n) end)
        if y and (not best_y or y < best_y - 0.25) then best_x, best_y = x, y end
    end
    if not best_y then return nil end
    return {kind = kind, dx = best_x + w / 2, dy = best_y + top, w = w, h = h, top = top}
end

local function place_any(fx, kind, box, blocks, n)
    local sx, sy, sw, sh = screen_box()
    local w, h, top = slot_dims(fx)
    local m = ui_blocks(blocks, n, sx, sy, sx + sw, sy + sh, sw, sh)
    for _, a in ipairs({G.hand, G.deck, G.HUD, G.HUD_blind, G.buttons}) do
        if type(a) == "table" and a.T and not a.REMOVED and a.T.w > 0 then m = add_block(blocks, m, a.T.x, a.T.y, a.T.w, a.T.h, E.GAP * 0.3) end
    end
    local x0, x1 = sx + E.PAD, sx + sw - E.PAD - w
    local y0, y1 = sy + E.PAD, sy + sh - E.PAD - h
    if x1 < x0 or y1 < y0 then return nil end
    local mid = clamp(sx + (sw - w) / 2, x0, x1)
    local want = sy + sh * (kind == "run" and 0.42 or 0.3)
    local best_x, best_y, best_d
    local steps = floor((x1 - x0) / (w * 0.5))
    for i = 0, steps do
        for _, sgn in ipairs(i == 0 and {1} or {1, -1}) do
            local x = mid + sgn * i * w * 0.5
            if x >= x0 - 1e-6 and x <= x1 + 1e-6 then
                local y = search(y0, y1, want, function(yy) return not hits(x, yy, w, h, blocks, m) end)
                if y then
                    local d = abs(y - want) + abs(x - mid) * 0.5
                    if not best_d or d < best_d then best_x, best_y, best_d = x, y, d end
                end
            end
        end
    end
    if not best_x then
        local y = search(y0, y1, want, function(yy) return not hits(mid, yy, w, h, blocks, n) end)
        best_x, best_y = mid, y or clamp(want, y0, y1)
    end
    return {kind = kind, box = box, dx = best_x + w / 2, dy = best_y + top, w = w, h = h, top = top}
end

local function block_of(p, blocks, n)
    local bx, by = 0, 0
    if p.rel then bx, by = p.rel.VT.x, p.rel.VT.y end
    return add_block(blocks, n, bx + p.dx - p.w / 2, by + p.dy - p.top, p.w, p.h, E.GAP * 0.3)
end

E._blocks = {}

function E.layout(force)
    local now = clock()
    if not force and now < (E._layout_t or 0) then return end
    E._layout_t = now + E.LAYOUT_EVERY
    local kind, box, f = context()
    local blocks, n = E._blocks, 0
    n = corner_blocks(blocks, n)
    if kind == "run" then
        local sx, sy, sw, sh = screen_box()
        local x0, y0, x1, y1 = run_dock(sx, sy, sw, sh)
        n = ui_blocks(blocks, n, x0, y0, x1, y1, sw, sh)
    end
    for _, fx in ipairs(E.live) do
        local p = not (fx.who and fx.who.fixed) and fx.place or nil
        if p and (p.kind ~= kind or p.box ~= box or (p.rel and p.rel.REMOVED)) then fx.place, fx.tried, p = nil, nil, nil end
        if p and not fx.dead then n = block_of(p, blocks, n) end
    end
    for _, fx in ipairs(E.live) do
        if not fx.place and not fx.dead and fx.mode == "pop" and not (fx.who and fx.who.fixed) then
            local p
            if kind == "window" then
                if settled(f) then
                    for _, k in ipairs(E.SHRINK) do
                        local S = fx.base_size * k
                        if S <= (fx.tried or 1e9) + 1e-6 then
                            fx.tried = S
                            if fx.size ~= S then fx:resize(S) end
                            p = place_window(fx, box, f, blocks, n)
                            if p then break end
                        end
                    end
                end
            else
                local S = min(E.RUN_SIZE, fx.base_size)
                if kind ~= "run" then S = fx.base_size end
                if PORTRAIT and PORTRAIT.on and PORTRAIT.on() then S = S * 2 end
                if fx.size ~= S then fx:resize(S) end
                p = place_free(fx, kind, blocks, n)
            end
            if not p and (kind ~= "window" or settled(f)) then p = place_any(fx, kind, box, blocks, n) end
            if p then
                fx.place = p
                n = block_of(p, blocks, n)
            end
        end
    end
end

local Fx

local function fx_class()
    if Fx then return Fx end
    Fx = Moveable:extend()

    function Fx:init(o)
        Moveable.init(self, 0, 0, o.size, o.size)
        self.id = o.id
        self.mode = o.mode or "pop"
        self.size = o.size
        self.base_size = o.size
        self.who = o.who or {}
        self.silent = o.silent or self.mode ~= "pop"
        self.freeze = o.freeze
        self.born = clock()
        if self.mode ~= "pop" then self.start = clock() - (o.offset or 0) end
        self.sprites, self.texts, self.emitters = {}, {}, {}
        self.next_sound = 1
r 17 21 %20%20%20%20%20%20%20%20 -
l 199
        quiet(self)
    end

    function Fx:time()
        if self.freeze then return self.freeze end
        if self.mode == "pop" and E.freeze then return E.freeze end
        if not self.start then return 0 end
        local t = (clock() - self.start) * E.SPEED
        if self.mode == "preview" then t = min(t % (E.DURATION + E.LOOP_GAP), E.HOLD) end
        return t
    end

    function Fx:expired()
        if self.dead then return true end
        if self.mode ~= "pop" or self.freeze or E.freeze then return false end
        return self.start ~= nil and (clock() - self.start) * E.SPEED > E.DURATION + 0.05
    end

    function Fx:resolve()
        if self.who.fixed then
            self.place = self.place or {kind = "fixed", dx = self.who.fixed.x, dy = self.who.fixed.y, w = 0, h = 0, top = 0}
        else
            E.layout()
        end
        if self.place and not self.start then self.start = clock() end
        if not self.place and not self.start and clock() - self.born > E.QUEUE_MAX then self.dead = true end
    end

    function Fx:resize(S)
        self.size = S
        self.T.w, self.T.h = S, S
        for _, obj in pairs(self.texts) do
            if obj then pcall(function() obj:remove() end) end
        end
        self.texts = {}
    end

    function Fx:spot()
        if self.mode ~= "pop" then
            local V = self.VT
            return V.x + V.w / 2, V.y + V.h / 2
        end
        local p = self.place
        if not p then return nil end
        if p.rel then return p.rel.VT.x + p.dx, p.rel.VT.y + p.dy end
        return p.dx, p.dy
    end

    function Fx:update(dt)
        if self.dead or self.mode ~= "pop" then return end
        local ok = pcall(function()
            self:resolve()
            if self.silent or not self.start then return end
            local list = E.SOUNDS[self.id]
            local t = self:time()
            while list and list[self.next_sound] and list[self.next_sound][1] <= t do
                local s = list[self.next_sound]
                self.next_sound = self.next_sound + 1
                if t - s[1] < 0.25 then play(s) end
            end
        end)
        if not ok then self.dead = true end
    end

    function Fx:sprite(name)
        local cached = self.sprites[name]
        if cached ~= nil then return cached or nil end
        local atlas, pos = sprite_info(name)
        if not (atlas and pos) then self.sprites[name] = false return nil end
        local ok, s = pcall(Sprite, 0, 0, 1, 1, atlas, pos)
        if not ok or not s then self.sprites[name] = false return nil end
        quiet(s)
        s.parent = self
        self.sprites[name] = s
        return s
    end

    function Fx:text(p, S)
        local cached = self.texts[p.key]
        if cached ~= nil then return cached or nil end
        local str = E.TEXTS[p.text] and E.TEXTS[p.text]() or tostring(p.text)
        local ok, d = pcall(DynaText, {string = {str}, colours = {colour(p.colour)}, scale = p.s * S * 0.9, shadow = true, bump = p.bump, silent = true})
        if not ok or not d then self.texts[p.key] = false return nil end
        quiet(d)
        d.parent = self
        self.texts[p.key] = d
        return d
    end

    function Fx:emitter(p)
        local cached = self.emitters[p.key]
        if cached ~= nil then return cached or nil end
        local cfg = p.cfg or {}
        local cols = {}
        for i, c in ipairs(cfg.colours or {"WHITE"}) do cols[i] = colour(c) end
        local ok, em = pcall(Particles, 0, 0, p.w or 0, p.h or 0, {timer = cfg.timer, scale = cfg.scale, speed = cfg.speed,
            lifespan = cfg.lifespan, colours = cols, max = cfg.max, fill = cfg.fill, timer_type = "REAL"})
        if not ok or not em then self.emitters[p.key] = false return nil end
        quiet(em)
        em.parent = self
        em.full_max = cfg.max or 10
        self.emitters[p.key] = em
        return em
    end

    function Fx:draw_part(p, cx, cy, S, k, alpha)
        local X, Y = cx + p.x * S * k, cy + p.y * S * k
        if p.k == "spr" then
            local s = self:sprite(p.spr)
            if not s then return end
            local w, h = p.w * S * k, p.h * S * k
            if w <= 0.001 or h <= 0.001 then return end
            place(s, X, Y, w, h, p.r, 1)
            s.dissolve = p.dis or 0
            s.dissolve_colours = p.dis_col and {colour(p.dis_col), colour(p.dis_col)} or nil
            local a = alpha * (p.a or 1)
            G.BRUTE_OVERLAY = a < 0.999 and {1, 1, 1, a} or self.overlay_keep
            s:draw_shader("dissolve")
            G.BRUTE_OVERLAY = self.overlay_keep
        elseif p.k == "txt" then
            local d = self:text(p, S)
            if not d then return end
            local kk = (p.kk or 1) * k
            if kk <= 0.001 then return end
            place(d, X, Y, d.T.w, d.T.h, p.r, kk)
            d:draw()
        elseif p.k == "rect" then
            local w, h = p.w * S * k, p.h * S * k
            local c = colour(p.colour)
            local rr = (p.round or 0.06) * S * k
            love.graphics.push()
            love.graphics.scale(G.TILESCALE * G.TILESIZE)
            love.graphics.translate(X, Y)
            love.graphics.setColor(0, 0, 0, 0.3 * alpha)
            love.graphics.rectangle("fill", -w / 2, -h / 2 + 0.04 * S * k, w, h, rr, rr, 6)
            love.graphics.setColor(c[1], c[2], c[3], (c[4] or 1) * alpha)
            love.graphics.rectangle("fill", -w / 2, -h / 2, w, h, rr, rr, 6)
            love.graphics.pop()
        elseif p.k == "flame" then
            if not (G.SHADERS and G.SHADERS.flame) or (p.amount or 0) <= 0.01 then return end
            local s = self:sprite("flame")
            if not s then return end
            place(s, X, Y, p.w * S * k, p.h * S * k, 0, 1)
            local c1 = (G.C and (G.C.UI_MULT or G.C.RED)) or {1, 0.3, 0.3, 1}
            self.lick = self.lick or lick(c1)
            s:get_pos_pixel()
            s:draw_shader("flame", nil, {
                {name = "time", val = clock() - (self.start or self.born) + 1},
                {name = "amount", val = p.amount},
                {name = "image_details", val = s.image_dims},
                {name = "texture_details", val = s.RETS.get_pos_pixel},
                {name = "colour_1", val = c1},
                {name = "colour_2", val = self.lick},
                {name = "id", val = s.ID},
            }, nil, nil, nil, nil, nil, nil, true)
        elseif p.k == "fx" then
            local em = self:emitter(p)
            if not em then return end
            em.max = p.on == false and 0 or em.full_max
            place(em, X, Y, p.w or 0, p.h or 0, 0, S * k)
            em:draw(alpha)
        end
    end

    function Fx:draw_tag(cx, cy, S, k)
        local d = E.tag_of(self)
        if not d then return end
        place(d, cx, cy + S * 0.58 * k + d.T.h / 2, d.T.w, d.T.h, 0, k)
        d:draw()
    end

    function Fx:draw_body()
        local t = self:time()
        local k = E.envelope(t)
        if k <= 0.001 then return end
        local cx, cy = self:spot()
        if not cx then return end
        local S = self.size
        local alpha = min(1, k * 1.5)
        self.overlay_keep = G.BRUTE_OVERLAY
        if self.mode == "pop" then
            local b = S * 1.06 * k
            love.graphics.push()
            love.graphics.scale(G.TILESCALE * G.TILESIZE)
            love.graphics.setColor(0, 0, 0, 0.42 * alpha)
            love.graphics.rectangle("fill", cx - b / 2, cy - b / 2, b, b, 0.16 * S * k, 0.16 * S * k, 8)
            love.graphics.pop()
        end
        for _, p in ipairs(E.pose(self.id, t)) do self:draw_part(p, cx, cy, S, k, alpha) end
        if self.mode == "pop" and self.place and self.place.kind ~= "fixed" then self:draw_tag(cx, cy, S, k) end
    end

    function Fx:draw()
        if self.dead or not self.states.visible then return end
        local depth = love.graphics.getStackDepth and love.graphics.getStackDepth() or nil
        local ok = pcall(self.draw_body, self)
        G.BRUTE_OVERLAY = self.overlay_keep
        if not ok then
            self.dead = true
