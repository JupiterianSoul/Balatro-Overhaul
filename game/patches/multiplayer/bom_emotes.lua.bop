local E = {}

local function L(s) return mod_loc and mod_loc(s) or s end

local pi, sin, cos, abs, exp, min, max, floor = math.pi, math.sin, math.cos, math.abs, math.exp, math.min, math.max, math.floor

local function clock() return love.timer.getTime() end
E.clock = clock

E.DURATION = 1.5
E.SPEED = 0.7
E.LOOP_GAP = 0.6
E.HOLD = E.DURATION - 0.24
E.SEND_GAP = 2.2
E.MAX_LIVE = 6
E.WAIT_ANCHOR = 0.2

E.LIST = {
    {id = "hi", label = "Hi!"},
    {id = "laugh", label = "Haha!"},
    {id = "cry", label = "Noo..."},
    {id = "nope", label = "Nope!"},
    {id = "chips", label = "Chips!"},
    {id = "fire", label = "On fire!"},
    {id = "money", label = "Cash!"},
    {id = "gg", label = "GG"},
    {id = "think", label = "Hmm..."},
    {id = "lucky", label = "Lucky!"},
    {id = "oops", label = "Oops!"},
    {id = "hurry", label = "Hurry!"},
}
E.BY_ID = {}
for i, def in ipairs(E.LIST) do
    def.index = i
    E.BY_ID[def.id] = def
end

E.FROM_LEGACY = {"lucky", "gg", "fire", "oops", "gg", "hurry"}
E.TO_LEGACY = {hi = 1, lucky = 1, gg = 2, laugh = 3, chips = 3, fire = 3, money = 3, cry = 4, oops = 4, hurry = 6}
E.LEGACY_TEXT = {
    ["good luck!"] = "lucky", ["well played!"] = "gg", ["nice!"] = "fire",
    ["oops!"] = "oops", ["thanks!"] = "gg", ["hurry up!"] = "hurry",
}

function E.resolve(v, depth)
    depth = depth or 0
    if depth > 2 then return nil end
    local tv = type(v)
    if tv == "table" then
        return E.resolve(v.id, depth + 1) or E.resolve(v.e, depth + 1)
    elseif tv == "number" then
        if v ~= v or v ~= floor(v) then return nil end
        return E.FROM_LEGACY[v]
    elseif tv == "string" then
        if E.BY_ID[v] then return v end
        local low = v:lower()
        if E.BY_ID[low] then return low end
        if E.LEGACY_TEXT[low] then return E.LEGACY_TEXT[low] end
        local n = tonumber(v)
        if n then return E.resolve(n, depth + 1) end
    end
    return nil
end

local function clamp(x, a, b)
    if x < a then return a end
    if x > b then return b end
    return x
end
local function seg(t, a, b) return clamp((t - a) / (b - a), 0, 1) end
local function out_back(u) local c1 = 1.70158 local c3 = c1 + 1 return 1 + c3 * (u - 1) ^ 3 + c1 * (u - 1) ^ 2 end
local function out_cubic(u) return 1 - (1 - u) ^ 3 end
local function in_cubic(u) return u * u * u end
local function sine_io(u) return (1 - cos(pi * u)) / 2 end
local function bell(u) return sin(pi * u) end
local function wave(t, hz) return sin(2 * pi * hz * t) end


local function soft_out(u) local c1 = 1.2 local c3 = c1 + 1 return 1 + c3 * (u - 1) ^ 3 + c1 * (u - 1) ^ 2 end
local function soft_in(u) local c1 = 1.2 local c3 = c1 + 1 return c3 * u * u * u - c1 * u * u end

function E.envelope(t)
    local D = E.DURATION
    if t <= 0 or t >= D then return 0 end
    if t < 0.24 then return max(0, soft_out(t / 0.24)) end
    if t > D - 0.24 then return max(0, 1 - soft_in(seg(t, D - 0.24, D))) end
    return 1
end

local CH = 0.72
local CW = CH * 71 / 95

local function spr(out, key, name, x, y, w, h, r, extra)
    local p = {k = "spr", key = key, spr = name, x = x, y = y, w = w, h = h, r = r or 0}
    if extra then for kk, vv in pairs(extra) do p[kk] = vv end end
    out[#out + 1] = p
    return p
end

local function card(out, key, base, front, x, y, w, h, r, extra)
    spr(out, key, base, x, y, w, h, r, extra)
    if front then spr(out, key .. "_f", front, x, y, w, h, r, extra) end
end

local function txt(out, key, text, x, y, s, colour, extra)
    local p = {k = "txt", key = key, text = text, x = x, y = y, s = s, r = 0, kk = 1, colour = colour}
    if extra then for kk, vv in pairs(extra) do p[kk] = vv end end
    out[#out + 1] = p
    return p
end

local function emit(out, key, x, y, cfg, extra)
    local p = {k = "fx", key = key, x = x, y = y, w = 0, h = 0, cfg = cfg, on = true}
    if extra then for kk, vv in pairs(extra) do p[kk] = vv end end
    out[#out + 1] = p
    return p
end

local function pivot(px, py, h, r) return px + sin(r) * h / 2, py - cos(r) * h / 2 end

E.FX = {
    tear = {timer = 0.02, scale = 0.075, speed = 0.12, lifespan = 0.3, colours = {"BLUE", "TEAR"}, max = 8},
    spark = {timer = 0.006, scale = 0.08, speed = 1.6, lifespan = 0.45, colours = {"CHIPS", "BLUE", "WHITE"}, max = 24},
    glint = {timer = 0.035, scale = 0.07, speed = 0.5, lifespan = 0.45, colours = {"GOLD", "GREEN", "WHITE"}, max = 14, fill = true},
    shards = {timer = 0.005, scale = 0.08, speed = 1.05, lifespan = 0.35, colours = {"GLASS"}, max = 40, fill = true},
}

local CHIP_STACK = {"chip_white", "chip_red", "chip_blue"}
local CHIP_BURST = {"chip_white", "chip_red", "chip_blue", "chip_green", "chip_gold", "chip_red", "chip_blue", "chip_white"}
local CASH_X = {-0.36, 0.3, -0.12, 0.4, -0.42, 0.12, -0.26}

local P = {}

P.hi = function(t, o)
    local a = seg(t, 0.12, 0.3) * (1 - seg(t, 1.15, 1.4))
    local r = 0.3 * a * wave(t - 0.12, 2.2)
    local bob = -0.03 * a * abs(wave(t - 0.12, 2.2))
    local x, y = pivot(0, 0.02 + CH / 2 + bob, CH, r)
    spr(o, "jimbo", "jimbo", x, y, CW, CH, r)
end

P.laugh = function(t, o)
    local a = bell(seg(t, 0.1, 1.35))
    local shake = wave(t, 7)
    local r = 0.13 * a * shake - 0.08 * a
    local hop = -0.05 * a * abs(wave(t, 3.5))
    local sq = 0.07 * a * shake * shake
    local sx, sy = 1 + sq, 1 - sq
    spr(o, "jimbo", "jimbo", 0, 0.02 + hop + CH * (1 - sy) / 2, CW * sx, CH * sy, r)
    local HA = {{0.22, 0.34, -0.3, 0.2}, {0.55, -0.36, -0.22, -0.2}, {0.85, 0.3, -0.12, 0.15}}
    for i, h in ipairs(HA) do
        local u = seg(t, h[1], h[1] + 0.45)
        if t >= h[1] and u < 1 then
            local k = max(0, out_back(seg(t, h[1], h[1] + 0.14))) * (1 - seg(u, 0.75, 1))
            txt(o, "ha" .. i, "ha", h[2], h[3] - 0.12 * u, 0.42, "GOLD", {kk = k, r = h[4]})
        end
    end
end

P.cry = function(t, o)
    local a = seg(t, 0.1, 0.45)
    local sway = 0.07 * wave(t, 0.9) * a
    local sy = 1 - 0.05 * a
    local jy = 0.02 + 0.035 * a + CH * (1 - sy) / 2
    spr(o, "jimbo", "jimbo", 0, jy, CW * (1 + 0.03 * a), CH * sy, sway)
    for i = 1, 7 do
        local u = t - (0.22 + (i - 1) * 0.15)
        if u >= 0 and u <= 0.65 then
            local side = (i % 2 == 1) and -1 or 1
            emit(o, "tear" .. i, side * (0.07 + 0.08 * u), jy - 0.07 + 1.1 * u * u + 0.05 * u, E.FX.tear, {on = u < 0.32})
        end
    end
end

P.nope = function(t, o)
    local sx = 1
    local flipped = t >= 0.54
    if t >= 0.42 and t < 0.54 then
        sx = cos(pi / 2 * seg(t, 0.42, 0.54))
    elseif flipped then
        sx = out_back(seg(t, 0.54, 0.74))
    end
    sx = max(0.02, sx)
    local shake = 0
    if t > 0.74 then shake = wave(t - 0.74, 4) * exp(-3 * (t - 0.74)) end
    local x, r = 0.07 * shake, -0.12 * shake
    card(o, "card", "base", "ace", x, 0, CW * sx, CH, r)
    if flipped then spr(o, "x", "debuff", x, 0, CW * sx, CH, r) end
    if t >= 0.62 then
        txt(o, "nope", "nope", x * 0.5, 0.27, 0.6, "RED", {kk = max(0, out_back(seg(t, 0.62, 0.76))), bump = true})
    end
end

P.chips = function(t, o)
    local B = 0.38
    if t < B then
        local a = seg(t, 0.16, B)
        local sq = 0.22 * in_cubic(a)
        local jig = 0.05 * a * wave(t, 9)
        for i = 1, 3 do
            spr(o, "stack" .. i, CHIP_STACK[i], jig, 0.12 - (i - 1) * 0.07 * (1 - sq), 0.34 * (1 + sq), 0.34 * (1 - 0.8 * sq), 0)
        end
        return
    end
    local u = t - B
    for i = 1, 8 do
        local ang = -pi / 2 + (i - 1) * 2 * pi / 8 + 0.2
        local v = 1.05 + 0.22 * (i % 3)
        local size = 0.28 * (1 - 0.45 * seg(u, 0.55, 1.1))
        spr(o, "chip" .. i, CHIP_BURST[i], cos(ang) * v * u, 0.05 + sin(ang) * v * u + 1.3 * u * u, size, size, ((i % 2 == 0) and 7 or -7) * u)
    end
    emit(o, "spark", 0, 0.05, E.FX.spark, {on = u < 0.12})
end

P.fire = function(t, o)
    local a = out_cubic(seg(t, 0.12, 0.5)) * (1 - seg(t, 1.2, 1.45))
    local boom = bell(seg(t, 0.45, 0.62))
    local pulse = 1 + 0.05 * a * wave(t, 3) + 0.12 * boom
    local x = 0.012 * a * wave(t, 13)
    local w, h = 0.8 * pulse, 0.4 * (1 + 0.06 * a * wave(t, 3) - 0.05 * boom)
    local y = 0.16
    o[#o + 1] = {k = "flame", key = "flame", x = x, y = y + h / 2 - 0.55, w = 1.1, h = 1.1, r = 0, amount = max(0, 4 * a + 0.35 * a * wave(t, 2.3))}
    o[#o + 1] = {k = "rect", key = "pill", x = x, y = y, w = w, h = h, r = 0, colour = "MULT", round = 0.07}
    txt(o, "mult", "mult", x, y, 0.5, "WHITE", {kk = pulse})
end

P.money = function(t, o)
    local a = seg(t, 0.1, 0.3) * (1 - seg(t, 1.2, 1.4))
    local tt = t - 0.1
    local hop = -0.07 * a * abs(wave(tt, 2.4))
    local sq = 0.05 * a * cos(2 * pi * 4.8 * tt)
    local sx, sy = 1 + sq, 1 - sq
    local gh = CH * 0.9
    spr(o, "golden", "golden", 0, 0.04 + hop + gh * (1 - sy) / 2, CW * 0.9 * sx, gh * sy, 0.05 * a * wave(t, 1.2))
    for i = 1, 7 do
        local u = t - (0.12 + (i - 1) * 0.11)
        if u >= 0 then
            local y = -0.6 + 1.7 * u * u + 0.2 * u
            if y < 0.55 then
                local k = max(0, out_back(seg(u, 0, 0.12))) * (1 - seg(y, 0.35, 0.55))
                txt(o, "cash" .. i, "$", CASH_X[i], y, 0.5, "MONEY", {kk = k, r = 0.5 * wave(u + i * 0.13, 1.1)})
            end
        end
    end
end

P.gg = function(t, o)
    local cw, ch = CW, CH
    local enter = out_back(seg(t, 0, 0.34))
    local b = bell(seg(t, 0.34, 0.74)) + 0.6 * bell(seg(t, 0.82, 1.12))
    for i, s in ipairs({-1, 1}) do
        local bx = s * (0.24 + 0.3 * (1 - enter))
        local r = -s * 0.42 * b
        local sy = 1 - 0.1 * b
        local x, y = pivot(bx, 0.06 + ch / 2, ch * sy, r)
        card(o, "c" .. i, "base", i == 1 and "king" or "queen", x, y, cw, ch * sy, r)
    end
    if t >= 0.44 then txt(o, "gg", "GG", 0, -0.34, 0.62, "GOLD", {kk = max(0, out_back(seg(t, 0.44, 0.6))), bump = true}) end
end

P.think = function(t, o)
    local th = 4 * pi * sine_io(seg(t, 0.15, 1.25))
    local c = cos(th)
    spr(o, "card", c >= 0 and "hermit" or "back", 0, 0.03 * wave(t, 1.2), CW * max(0.02, abs(c)), CH, 0)
    if t > 0.3 then
        local u = seg(t, 0.3, 1.4)
        txt(o, "q", "?", 0.36, -0.28 - 0.08 * u, 0.55, "WHITE", {kk = max(0, out_back(seg(t, 0.3, 0.45))), r = 0.25 * wave(t, 1.5)})
    end
end

P.lucky = function(t, o)
    local j = seg(t, 0.25, 0.75)
    local hop = -0.14 * bell(j)
    local r = 2 * pi * sine_io(j)
    local land = bell(seg(t, 0.75, 0.9))
    local sx, sy = 1 + 0.12 * land, 1 - 0.12 * land
    local y = 0.03 + hop + CH * (1 - sy) / 2
    card(o, "card", "lucky_base", "seven", 0, y, CW * sx, CH * sy, r)
    emit(o, "glint", 0, y, E.FX.glint, {w = CW, h = CH, on = t > 0.72 and t < 1.2})
    if t >= 0.78 then txt(o, "lucky", "lucky", 0, 0.36, 0.42, "GREEN", {kk = max(0, out_back(seg(t, 0.78, 0.94))), bump = true}) end
end

P.oops = function(t, o)
    local nerv = seg(t, 0.12, 0.62)
    local r = (0.03 + 0.11 * nerv) * wave(t, 6) * (1 - seg(t, 0.66, 0.9))
    local y = 0.02 + 0.08 * in_cubic(seg(t, 0.5, 0.66))
    local dis = seg(t, 0.66, 1.0)
    if dis < 1 then card(o, "card", "glass", "ten", 0, y, CW, CH, r, {dis = dis, dis_col = "GLASS"}) end
    emit(o, "shards", 0, y, E.FX.shards, {w = CW, h = CH, on = t >= 0.66 and t < 0.92})
    if t >= 0.88 then txt(o, "oops", "oops", 0, 0, 0.48, "FILTER", {kk = max(0, out_back(seg(t, 0.88, 1.02))), bump = true}) end
end

local function hurry_x(t)
    local a = seg(t, 0.15, 0.4) * (1 - seg(t, 1.05, 1.35))
    return 0.3 * a * wave(t - 0.15, 1.8)
end

P.hurry = function(t, o)
    local x = hurry_x(t)
    local v = (hurry_x(t + 0.008) - hurry_x(t - 0.008)) / 0.016
    local st = min(0.32, abs(v) * 0.12)
    local r = clamp(v * 0.09, -0.3, 0.3)
    for g = 2, 1, -1 do
        local gx = hurry_x(t - 0.05 * g)
        if abs(gx - x) > 0.02 then spr(o, "ghost" .. g, "mercury", gx, 0, CW * (1 + st), CH * (1 - 0.4 * st), r, {a = 0.3 / g}) end
    end
    spr(o, "card", "mercury", x, 0, CW * (1 + st), CH * (1 - 0.4 * st), r)
end

E.POSES = P

function E.pose(id, t)
    local f = P[id]
    local out = {}
    if f then f(t, out) end
    return out
end

