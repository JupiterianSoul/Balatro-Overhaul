S.DEFS = DEFS

local NONE_LABEL = { en = 'None', fr = 'Aucune', es = 'Ninguna' }

local function O() return bom_custom_objects end

local function pick(tr)
    if O() and O().pick then return O().pick(tr) end
    return tr and tr.en
end

function S.valid(key)
    return type(key) == 'string' and DEFS[key] ~= nil
end

function S.base(key)
    return DEFS[key] and DEFS[key].base or nil
end

function S.name(key)
    local d = DEFS[key]
    if not d then return nil end
    local e = pick(d.loc)
    return e and e.name or d.name
end

function S.describe(key)
    local d = DEFS[key]
    if not d then return {} end
    local e = pick(d.loc)
    local out = {}
    for _, l in ipairs(e and e.text or {}) do out[#out + 1] = l end
    return out
end

function S.colour(key)
    local d = DEFS[key]
    if not d or not d.colour then return nil end
    local h = d.colour
    return { tonumber(h:sub(1, 2), 16) / 255, tonumber(h:sub(3, 4), 16) / 255, tonumber(h:sub(5, 6), 16) / 255, 1 }
end

