}

function S.build_art(scale)
    local s = scale or 1
    local ok, src = pcall(love.image.newImageData, "resources/textures/" .. s .. "x/chips.png")
    if not ok or not src then return nil end
    local cw = S.CHIP * s
    local out = love.image.newImageData(cw * #S.KEYS, cw)
    for i, k in ipairs(S.KEYS) do
        local a = S.ART[k]
        local sx, sy, ox = a.src[1] * cw, a.src[2] * cw, (i - 1) * cw
        for y = 0, cw - 1 do
            for x = 0, cw - 1 do
                local r, g, b, al = src:getPixel(sx + x, sy + y)
                if al > 0 then
                    local h, l, sat = C().hls(r, g, b)
                    if pmath.max(r, g, b) - pmath.min(r, g, b) > 0.25 then r, g, b = a.accent(h, l, sat)
                    elseif l < 0.4 then r, g, b = a.dark(l)
                    else r, g, b = a.light(l) end
                end
                out:setPixel(ox + x, y, r, g, b, al)
            end
        end
    end
    src:release()
    return out
end

function S.register_art()
    if not (G and G.ASSET_ATLAS and G.SETTINGS and love and love.graphics and C() and C().hls) then return end
    local s = (G.SETTINGS.GRAPHICS and G.SETTINGS.GRAPHICS.texture_scaling) or 2
    local ok, data = pcall(S.build_art, s)
    if not ok or not data then
        if mp_log then mp_log.warn('BOM_STAKES', 'stake art failed: %s', tostring(data)) end
        return
    end
    G.ASSET_ATLAS[S.ART_ATLAS] = {
        name = S.ART_ATLAS, image = love.graphics.newImage(data, { mipmaps = true, dpiscale = s }),
        type = 'asset_atli', px = S.CHIP, py = S.CHIP,
    }
end

function S.sprite(key, scale)
