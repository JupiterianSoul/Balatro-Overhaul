    if not d or not G or not G.ASSET_ATLAS then return nil end
    if not G.ASSET_ATLAS[S.ART_ATLAS] then pcall(S.register_art) end
    local atlas = G.ASSET_ATLAS[S.ART_ATLAS]
    if not atlas then return nil end
    local sc = scale or 1
    local spr = Sprite(0, 0, sc, sc, atlas, { x = d.pos.x, y = d.pos.y })
    spr.states.drag.can = false
    if d.shine then
        spr.draw = function(_sprite)
