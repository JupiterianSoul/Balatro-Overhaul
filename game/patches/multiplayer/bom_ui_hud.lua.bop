-- ============================================
-- BOM_UI_HUD — Opponent panel, lives/score rendering, in-game HUD, drag handlers
-- FEATURE: Split from bom_ui.lua for maintainability
-- ============================================

local M = {}

function M.init(bom_ui)

    -- ============================================
    -- OPPONENT PANEL (persistent HUD during match)
    -- ============================================

    function bom_ui.build_opponent_panel(opponent_data)
        if not G then return end
        if not G.GAME then return end
        if not opponent_data then return end

        local starting_lives = 4
        pcall(function()
            if bom_match and bom_match.get_settings then
                starting_lives = bom_match.get_settings().starting_lives or 4
            end
        end)

        G.GAME.mp_opponent_panel = {
            name = opponent_data.name or "Opponent",
            title = opponent_data.equipped_title or "",
            rank = opponent_data.rank or 1,
            lives = starting_lives,
            score = 0,
            score_text = "0",
            highest_score = bom_insane_int and bom_insane_int.empty and bom_insane_int.empty() or 0,
            hands_used = 0,
            hands_left = 0,
            location = "...",  -- FEATURE: Session 56 — enemy location (updated live)
        }
    end

    function bom_ui.update_opponent_score(score)
        if not G then return end
        if not G.GAME then return end
        if not G.GAME.mp_opponent_panel then return end

        local panel = G.GAME.mp_opponent_panel
        panel.score = score or 0

        if bom_insane_int and bom_insane_int.to_string then
            panel.score_text = bom_insane_int.to_string(score or 0)
            panel.highest_score = panel.highest_score or bom_insane_int.empty()
            if bom_insane_int.greater_than(panel.score, panel.highest_score) then
                panel.highest_score = bom_insane_int.from_string(panel.score)
            end
        else
            panel.score_text = tostring(score or 0)
        end

        pcall(function()
            if bom_pvp_hud and bom_pvp_hud.juice_up_pvp_hud then
                bom_pvp_hud.juice_up_pvp_hud()
            end
        end)
    end

    function bom_ui.update_opponent_panel(data)
        if not G then return end
        if not G.GAME then return end
        if not data then return end

        local panel = G.GAME.mp_opponent_panel
        if not panel then return end

        if data.score ~= nil then bom_ui.update_opponent_score(data.score) end
        if data.lives ~= nil then panel.lives = data.lives end
        if data.status ~= nil then panel.status = data.status end
        if data.blind_finished ~= nil then panel.blind_finished = data.blind_finished end
        if data.hands_used ~= nil then
            panel.hands_used = data.hands_used
            local total_hands = nil
            pcall(function()
                if G.GAME.current_round then
                    total_hands = (G.GAME.current_round.hands_left or 0) + (G.GAME.current_round.hands_played or 0)
                end
            end)
            if total_hands then
                panel.hands_left = math.max(0, total_hands - data.hands_used)
            end
        end
    end

    -- ============================================
    -- LIFE LOSS ANIMATION
    -- ============================================

