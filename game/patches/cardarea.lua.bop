local function cardarea_sort_value(v)
    if type(v) ~= 'number' then
        local conv = rawget(_G, 'to_number')
        v = (type(conv) == 'function' and tonumber(conv(v))) or tonumber(v) or 0
    end
    if v ~= v then return 0 end
    return v
end

local cardarea_sort_raw = CardArea.sort
r 6 577 - -
l 26
    local ok, err = pcall(cardarea_sort_raw, self, method)
    if ok then return end
    if not tostring(err):find('invalid order function', 1, true) then error(err, 0) end
    local sort = self.config.sort
    local key
    if sort == 'desc' or sort == 'asc' then key = function(c) return c:get_nominal() end
    elseif sort == 'suit desc' or sort == 'suit asc' then key = function(c) return c:get_nominal('suit') end
    elseif sort == 'order' then key = function(c) return (c.config.card and c.config.card.order) or (c.config.center and c.config.center.order) end
    else return end
    local desc = sort == 'desc' or sort == 'suit desc'
    local keys = {}
    for i, c in ipairs(self.cards) do
        if not keys[c] then
            local got, v = pcall(key, c)
            keys[c] = {cardarea_sort_value(got and v or 0), i}
        end
    end
    print('[CardArea] sort fallback ('..tostring(sort)..'): '..tostring(err))
    table.sort(self.cards, function(a, b)
        local ka, kb = keys[a], keys[b]
        if ka[1] ~= kb[1] then
            if desc then return ka[1] > kb[1] end
            return ka[1] < kb[1]
        end
        return ka[2] < kb[2]
    end)
