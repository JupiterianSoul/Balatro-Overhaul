        local function chosen(n, d)
            if d > 6 then return end
            for _, c in pairs(n.children or {}) do
                if type(c) == 'table' and c.config then
                    if c.config.chosen and c.config.button then return c end
                    local f = chosen(c, d + 1)
                    if f then return f end
                end
            end
        end
        local c = chosen(self, 0)
        if c then return c:put_focused_cursor() end
