local function ui_set_recursive(node, recursive, apply)
  apply(node)
  if recursive and type(node.children) == 'table' then
    for _, child in pairs(node.children) do
      if type(child) == 'table' and child.is and child:is(UIElement) then ui_set_recursive(child, true, apply) end
    end
  end
end

function UIElement:set_zoom(zoom, recursive)
  ui_set_recursive(self, recursive, function(n) n.zoom = zoom end)
end

function UIElement:set_hover_state(state, recursive)
  ui_set_recursive(self, recursive, function(n) if n.states and n.states.hover then n.states.hover.is = state end end)
end

function UIElement:set_drag_state(state, recursive)
  ui_set_recursive(self, recursive, function(n) if n.states and n.states.drag then n.states.drag.is = state end end)
end

function UIElement:set_created_on_pause(state, recursive)
  ui_set_recursive(self, recursive, function(n) n.created_on_pause = state end)
end
end
