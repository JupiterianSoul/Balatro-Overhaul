c 26
l 19
function release_tutorial_buttons()
    rawset(G, 'DISABLED_BUTTONS', nil)
end

local function sync_tutorial_lock(e)
    local locked = G.DISABLED_BUTTONS
    if locked and e.config.button and not e.tutorial_disabled then
        local readable = G.OVERLAY_TUTORIAL and G.OVERLAY_TUTORIAL.overhaul
        for _, name in ipairs(locked) do
            if e.config.button == name then
                e.tutorial_disabled, e.disable_button = name, true
                if not readable then e.config.button = nil end
            end
        end
    elseif not locked and e.tutorial_disabled then
        e.config.button, e.tutorial_disabled, e.disable_button = e.config.button or e.tutorial_disabled, nil, nil
    end
end

