local function held_time(c)
    return c.cursor_up.time - c.cursor_down.time
end

local function mark_release_target(c)
    local dropped = c.dragging.prev_target
    for _, node in ipairs(c.collision_list) do
        if node.states.hover.can and not node.states.drag.is and node ~= dropped then
            if node.states.release_on.can then
                c.released_on.target, c.released_on.handled = node, false
            end
            return
        end
    end
end

local function touch_press(c)
    local over = c.cursor_hover.target
    if over and over.states.hover.can then c.finger_focus = over end
    local open = over and over == c.hovering.target and over.children and over.children.h_popup
    c.touch_control.tip_open = open and not (over.can_long_press and over:can_long_press()) and over or nil
    c.touch_control.clear_touch = true
end

local function touch_release(c)
    local down = c.cursor_down
    if not down.target then return end
    local tc = c.touch_control
    if down.distance < G.MIN_CLICK_DIST and down.duration < 0.2 then
        if down.target.states.click.can and not tc.l_press.target then
            tc.s_tap.target, tc.s_tap.time, tc.s_tap.handled = down.target, held_time(c), false
        end
    elseif c.dragging.prev_target then
        mark_release_target(c)
    end
end

local function touch_track_focus(c)
    local tc = c.touch_control
    c.finger_cursor = c.finger_cursor or G.ROOM
    local focus = c.finger_focus
    if focus and (focus == G.ROOM or (not c.is_cursor_down and focus ~= c.finger_cursor)) then
        c.finger_focus, focus = nil, nil
    end
    if focus and c.is_cursor_down and focus:can_long_press() and c.cursor_down.duration > 0.2
        and not tc.l_press.target and not tc.l_pressed then
        tc.l_press.target, tc.l_press.handled = focus, false
    end
end

local function touch_dispatch(c)
    local tc, hover = c.touch_control, c.hovering
    local focus = c.finger_focus
    local holds_still = focus and not focus:can_long_press()
    if holds_still and focus ~= hover.target and focus:can_hover_on_drag() then
        hover.target, hover.handled = focus, false
    end
    if not tc.s_tap.handled then
        local tapped = tc.s_tap.target
        if tapped.single_tap then
            tapped:single_tap()
            if c.finger_focus and not c.finger_focus:can_long_press() and tc.tip_open ~= tapped then
                hover.target, hover.handled = tapped, false
            end
        else
            tapped:click()
        end
        tc.s_tap.handled, tc.clear_touch, tc.tip_open = true, nil, nil
    end
    if not tc.l_press.handled then
        hover.target, hover.handled = tc.l_press.target, false
        tc.l_pressed, tc.l_press.handled = c.finger_focus, true
    end
    if tc.clear_touch or not c.finger_focus then
        tc.l_press.target, tc.l_pressed, tc.s_tap.target = nil, nil, nil
        hover.target, hover.handled = nil, false
        tc.clear_touch = nil
    end
    if tc.l_pressed then hover.target = c.finger_focus end
    local drag = c.dragging
    if not drag.handled and c.cursor_down.duration and c.cursor_down.duration > 0.1 then
        create_drag_target_from_card(drag.target)
        drag.handled = true
    end
end

function Controller:drop_touch()
    rawset(self.touch_control, 'clear_touch', true)
end

