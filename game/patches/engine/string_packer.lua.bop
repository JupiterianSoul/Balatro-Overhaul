function keep_bad_copy(_file, _raw)
    if _raw and _raw ~= '' and not love.mod_filesystem.getInfo(_file .. '.bad') then
        pcall(love.mod_filesystem.write, _file .. '.bad', _raw)
    end
end

load_local_file = function(_file)
    if string.find(_file, 'unlock_notify', 1, true) or not love.mod_filesystem.getInfo(_file) then return end
    local raw = love.mod_filesystem.read(_file)
    local t = get_table_from_string(raw)
    if t == nil then keep_bad_copy(_file, raw) end
    return t
end

get_table_from_string = function(file_string)
    if not file_string or file_string == '' then return end
    local text = file_string
    if string.sub(text, 1, 6) ~= 'return' then
        local inflated, out = pcall(love.data.decompress, 'string', 'deflate', text)
        if not inflated then return end
        text = out
    end
    local ok, t = pcall(STR_UNPACK, text)
    if ok and type(t) == 'table' then return t end
    print('[SAVE] unreadable file skipped: ' .. tostring(t))
end

compress_table_to_string = function(_table)
    local packed = type(_table) == 'table' and STR_PACK(_table) or _table
    if NO_COMPRESS then return packed end
    return love.data.compress('string', 'deflate', packed, 1)
end

