if not love.mod_filesystem then
    love.mod_filesystem = {}
    for _, name in ipairs({'getDirectoryItems', 'getInfo', 'read', 'remove', 'getSourceBaseDirectory', 'createDirectory', 'write'}) do
        love.mod_filesystem[name] = love.filesystem[name]
    end
end

