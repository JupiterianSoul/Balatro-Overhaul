local DATA_WORDS = {["return"] = true, ["true"] = true, ["false"] = true, ["nil"] = true, inf = true, nan = true}

function STR_IS_PLAIN_DATA(str)
  if type(str) ~= "string" or str:byte(1) == 27 then return false end
  local i = 1
  while true do
    local q = str:find('"', i, true)
    local rest = str:sub(i, q and q - 1 or -1)
    if rest:find("[^%w%s{}%[%]=,.+%-_]") then return false end
    if rest:find("--", 1, true) or rest:find("[[", 1, true) or rest:find("[=", 1, true) then return false end
    for word in rest:gmatch("%f[%w_][%a_][%w_]*") do
      if not DATA_WORDS[word] then return false end
    end
    if not q then return true end
    local j = q + 1
    while true do
      local k = str:find('["\\]', j)
      if not k then return false end
      if str:byte(k) == 92 then j = k + 2 else j = k + 1 break end
    end
    i = j
  end
end

function STR_UNPACK_PEER(str)
  if rawget(_G, "SMODS") then return STR_UNPACK(str) end
  if not STR_IS_PLAIN_DATA(str) then error("peer data is not plain data") end
  return STR_UNPACK(str)
end


function keep_bad_copy(_file, _raw)
    if _raw and _raw ~= '' and not love.mod_filesystem.getInfo(_file .. '.bad') then
        pcall(love.mod_filesystem.write, _file .. '.bad', _raw)
    end
end

load_local_file = function(_file)
    if string.find(_file, 'unlock_notify', 1, true) or not love.mod_filesystem.getInfo(_file) then return end
    local raw = love.mod_filesystem.read(_file)
    local t = get_table_from_string(raw)
    if t == nil then
        keep_bad_copy(_file, raw)
        if love.mod_filesystem.getInfo(_file .. '.prev') then
            t = get_table_from_string(love.mod_filesystem.read(_file .. '.prev'))
            if t ~= nil then print('[SAVE] ' .. _file .. ' was cut short, using the copy written with it') end
        end
    end
    return t
end

get_table_from_string = function(file_string)
    if not file_string or file_string == '' then return end
    local text = file_string
    if string.sub(text, 1, 6) ~= 'return' then
        local inflated, out = pcall(love.data.decompress, 'string', 'deflate', text .. '\0\0\0\0\0\0\0\0')
        if not inflated then return end
        text = out
    end
    local ok, t = pcall(STR_UNPACK, text)
    if ok and type(t) == 'table' then return t end
    print('[SAVE] unreadable file skipped: ' .. tostring(t))
end

compress_table_to_string = function(_table)
    local packed = type(_table) == 'table' and STR_PACK(_table) or _table
    if NO_COMPRESS then return packed end
    return love.data.compress('string', 'deflate', packed, 1)
end

