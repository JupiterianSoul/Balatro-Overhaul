local text_utf8_ok, text_utf8 = pcall(require, 'utf8')
local letter_cache = setmetatable({}, {__mode = 'k'})
local function dynatext_letter(font, c)
    local by_char = letter_cache[font]
    if not by_char then
        by_char = {}
        letter_cache[font] = by_char
    end
    local t = by_char[c]
    if not t then
        t = love.graphics.newText(font, c)
        by_char[c] = t
    end
    return t
end
